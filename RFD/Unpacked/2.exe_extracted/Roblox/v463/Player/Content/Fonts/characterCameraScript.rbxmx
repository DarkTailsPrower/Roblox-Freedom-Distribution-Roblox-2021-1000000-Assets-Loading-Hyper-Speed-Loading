&#9;&#9;&#9;&#9;
&#9;&#9;&#9;&#9;GestureArea = Instance.new(&quot;Frame&quot;)
&#9;&#9;&#9;&#9;GestureArea.BackgroundTransparency = 1.0
&#9;&#9;&#9;&#9;GestureArea.Visible = true
