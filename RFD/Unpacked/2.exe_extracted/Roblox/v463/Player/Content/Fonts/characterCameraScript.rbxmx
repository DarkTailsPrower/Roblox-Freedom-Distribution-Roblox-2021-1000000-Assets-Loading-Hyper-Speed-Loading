&#9;&#9;&#9;&#9;&#9;IsAToolEquipped = false
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end)
&#9;&#9;end
&#9;end
&#9;
&#9;if LocalPlayer then
&#9;&#9;if LocalPlayer.Character ~= nil then
&#9;&#9;&#9;OnCharacterAdded(LocalPlayer.Character)
&#9;&#9;end
&#9;&#9;LocalPlayer.CharacterAdded:connect(function(character)
