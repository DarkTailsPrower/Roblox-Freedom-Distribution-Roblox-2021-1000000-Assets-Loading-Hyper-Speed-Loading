local function CreateCamera()
&#9;local this = {}
&#9;local R15HeadHeight = R15_HEAD_OFFSET
&#9;function this:GetActivateValue()
&#9;&#9;return 0.7
&#9;end
&#9;
&#9;function this:IsPortraitMode()
