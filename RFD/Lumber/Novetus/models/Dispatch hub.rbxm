						<Item class="Script" referent="RBX5232">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<ProtectedString name="Source">function open()
	if script.Parent.Parent.Active.Value == true then
		for i = 1, script.Parent.Size.x * script.Parent.Parent.Sep.Value do
			script.Parent.CFrame = script.Parent.CFrame * CFrame.new(0, -10 / script.Parent.Parent.Sep.Value, 0)
			wait(script.Parent.Parent.MiniWait.Value)
		end
		wait(script.Parent.Parent.OpenTime.Value)
		for i = 1, script.Parent.Size.x * script.Parent.Parent.Sep.Value do
			script.Parent.CFrame = script.Parent.CFrame * CFrame.new(0, 10 / script.Parent.Parent.Sep.Value, 0)
			wait(script.Parent.Parent.MiniWait.Value)
		end
	end
	script.Parent.Parent.Active.Value = false
end

script.Parent.Parent.Active.Changed:connect(open)</ProtectedString>
