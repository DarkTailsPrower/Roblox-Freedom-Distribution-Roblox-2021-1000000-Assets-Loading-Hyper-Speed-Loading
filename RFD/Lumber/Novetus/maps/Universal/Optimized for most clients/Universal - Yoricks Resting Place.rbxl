						<string name="Name">MessageBox</string>
						<string name="Source">print("Mattcena's message box")

local debounce = false


function onHit(hit)
	local human = hit.Parent:findFirstChild("Humanoid")
	if (human ~= nil) and debounce == false then

                debounce = true

local message = Instance.new("Message")
message.Parent = game.Players:playerFromCharacter(hit.Parent)
message.Text = "This thing all things devours: Birds, beasts, trees, flowers;"
wait(5)
message.Text = "Gnaws iron, bites steel; Grinds hard stones to meal;"
wait(5)
message.Text = "Slays king, ruins town, And beats high mountain down"
wait(5)
message.Text = "Speak your answer aloud to continue..."
wait(5)

message:Remove ()

                debounce = false
	end
end

script.Parent.Touched:connect(onHit)



