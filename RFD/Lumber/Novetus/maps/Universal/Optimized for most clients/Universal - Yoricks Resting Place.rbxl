				<Item class="Script" referent="RBX11">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">MessageBox</string>
						<string name="Source">print("Mattcena's message box")

local debounce = false


function onHit(hit)
	local human = hit.Parent:findFirstChild("Humanoid")
	if (human ~= nil) and debounce == false then

                debounce = true

local message = Instance.new("Message")
message.Parent = game.Players:playerFromCharacter(hit.Parent)
message.Text = "Alive without breath, As cold as death;"
wait(5)
message.Text = "Never thirsty, ever drinking,"
wait(5)
message.Text = "All in mail never clinking."
wait(5)
message.Text = "Speak your answer aloud to continue..."
wait(5)

message:Remove ()

                debounce = false
	end
end

script.Parent.Touched:connect(onHit)</string>
