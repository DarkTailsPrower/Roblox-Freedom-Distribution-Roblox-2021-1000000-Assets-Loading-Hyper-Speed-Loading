						<string name="Source">print("Mattcena's message box")

local debounce = false


function onHit(hit)
	local human = hit.Parent:findFirstChild("Humanoid")
	if (human ~= nil) and debounce == false then

                debounce = true

local message = Instance.new("Message")
message.Parent = game.Players:playerFromCharacter(hit.Parent)
message.Text = "You've found your way here,"
wait(5)
message.Text = "But can you continue?"
wait(5)
message.Text = "Will you find my precious?"
wait(5)
message.Text = "Only time will tell..."
wait(5)

message:Remove ()

                debounce = false
	end
end

