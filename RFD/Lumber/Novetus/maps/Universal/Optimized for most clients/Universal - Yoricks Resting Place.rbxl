local debounce = false


function onHit(hit)
	local human = hit.Parent:findFirstChild("Humanoid")
	if (human ~= nil) and debounce == false then

                debounce = true

local message = Instance.new("Message")
message.Parent = game.Players:playerFromCharacter(hit.Parent)
message.Text = "It cannot be seen, cannot be felt," 
wait(5)
message.Text =  "Cannot be heard, cannot be smelt."
wait(5)
message.Text = "It lies behind stars and under hills, And empty holes it fills."
wait(5)
message.Text = "It comes first and follows after, Ends life, kills laughter."
wait(5)
message.Text = "Speak your answer aloud to continue..."
wait(5)

message:Remove ()

                debounce = false
	end
end

