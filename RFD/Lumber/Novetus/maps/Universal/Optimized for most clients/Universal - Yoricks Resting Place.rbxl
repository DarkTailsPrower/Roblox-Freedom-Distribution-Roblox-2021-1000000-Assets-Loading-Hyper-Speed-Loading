function getPlayer(h)
	local p = game.Players:playerFromCharacter(h.Parent)
	return p
end

function say(text, p)
	local m = Instance.new("Message")
	m.Text = text
	m.Parent = p
	game.Debris:AddItem(m, 4)
end

function onTouched(part)
	if debounce == true then return end
	local h = part.Parent:findFirstChild("Humanoid")
	if h~=nil then
		

		local p = getPlayer(h)
		local id = p.userId
		
		local marker = p:findFirstChild("winner")
		if (marker == nil) then
			marker = Instance.new("IntValue")
			marker.Name = "winner"
			marker.Parent = p
		else
			-- dude has already won
			say("One is enough I think", p)
			wait(6)
			h.Health = 0
			return
		end

		debounce = true

		if (id &gt; 0) then
			script.Parent.Sound.SoundId = "http://app2.roblox.com/Game/TreasureHunt.ashx?userid=" .. id .. "&amp;assetnumber=1&amp;key=Beeblebrox"
			script.Parent.Sound:Play()
			say("We're sorry!", p)
			wait(5)
			say("Your princess is in another castle!", p)
			wait(5)
			say("Nah just kidding", p)
			wait(5)
			say("YOU FOUND IT!", p)
			wait(5)
			say("The Riddling Skull is yours!", p)
			wait(5)
			h.Health = 0
		else
			-- a guest
			say("We're sorry!", p)
			wait(5)
			say("Guests can't win this game", p)
			wait(5)
			say("If you were a member", p)
			wait(5)
			say("You would have gotten a cool prize" , p)
			wait(5)
			say("LOL!", p)
			wait(5)
			h.Health = 0
		end

		wait(3)
		debounce = false
	end
end

script.Parent.Touched:connect(onTouched)</string>
