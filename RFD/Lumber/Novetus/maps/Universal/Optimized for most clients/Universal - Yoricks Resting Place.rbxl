				<Item class="Script" referent="RBX3385">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Telephonics</string>
						<string name="Source">local debounce = false


function onTouched(part)
	if debounce == true then return end
	local h = part.Parent:findFirstChild("Humanoid")
	if h~=nil then
		debounce = true
		script.Parent.Ring:Stop()
		script.Parent.Darkness:Play()
		wait(19)
		debounce = false
	end
end



script.Parent.Touched:connect(onTouched)

while true do
	if (debounce == false) then	script.Parent.Ring:Play() end
	wait(60)
	

end</string>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
