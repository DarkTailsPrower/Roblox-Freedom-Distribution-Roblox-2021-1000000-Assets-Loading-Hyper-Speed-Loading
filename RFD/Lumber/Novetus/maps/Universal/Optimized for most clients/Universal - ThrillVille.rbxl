          <Item class="Script" referent="RBX3931">
            <Properties>
              <bool name="Disabled">false</bool>
              <Content name="LinkedSource">
                <null></null>
              </Content>
              <string name="Name">Script</string>
              <string name="Source">humanoid = nil

function onTouched(part)
	if part.Parent ~= nil then
	local h = part.Parent:findFirstChild("Humanoid")
		if h~=nil then
			if remoteisenabled~=0 then
				if h==humanoid then
				return
				end
				local tv=script.Parent.Parent:findFirstChild("TV")
				if tv~=nil then
				local channelno = tv.channelno.Value
				tv.channelno.Value=channelno+1
				remoteisenabled=0
				wait(2)
				remoteisenabled=1
				else
				print("could not find TV!")
				end
			end
		end
	end
end

script.Parent.Touched:connect(onTouched)</string>
