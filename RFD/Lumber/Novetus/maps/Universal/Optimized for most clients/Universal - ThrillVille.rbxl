        <Item class="Script" referent="RBX514">
          <Properties>
            <bool name="Disabled">false</bool>
            <Content name="LinkedSource">
              <null></null>
            </Content>
            <string name="Name">Script</string>
            <string name="Source">function showgui(part)
	local player = game.Players:playerFromCharacter(part.Parent)
	if part.Parent:findFirstChild("Humanoid") and player then
		if not player.PlayerGui:findFirstChild("PopUpMsg") then
			local screengui = Instance.new("ScreenGui")
			screengui.Name = "PopUpMsg"
			screengui.Parent = player.PlayerGui
			local frame = Instance.new("Frame")
			frame.Name = "Window"
			frame.BackgroundTransparency = 0.4
			frame.Size = UDim2.new(0,300,0,200)
			frame.Position = UDim2.new(0,35,0,30)
			frame.BorderSizePixel = 0
			frame.Parent = screengui
			local bodytext1 = Instance.new("TextLabel")
			bodytext1.Name = "BodyText"
			bodytext1.Text = "yeap you guessed it...."
			bodytext1.BackgroundTransparency = 1
			bodytext1.TextStrokeTransparency = 0
			bodytext1.TextColor3 = Color3.new(1,1,1)
			bodytext1.Position = UDim2.new(0,150,0,100)
			bodytext1.Size = UDim2.new(0,0,0,0)
			bodytext1.FontSize = "Size12"
			bodytext1.Parent = frame
			wait(3)
			bodytext1.Text = "this is thrillville :P"
			wait(3)
			bodytext1.Text = "before starting a ride read the text near it --"
			wait(3)
			bodytext1.Text = "-- for info how to start and ride it"
			wait(3)
			bodytext1.Text = "remember to have fun and enjoy yourself ^^"
			wait(3)
			bodytext1.Text = "Creator:JJ5x5 (im sure you heard of him :P)"
			wait(3)
			bodytext1.Text = "oh and we have 4 helpers in the park ---"
			wait(3)
			bodytext1.Text = "-- look for restricted77, BenjyMan----"
			wait(3)
			bodytext1.Text = "Woopedt and gtalvs414"
			wait(3)
			bodytext1.Text = "they will be happy to help if ----"
			wait(3)
			bodytext1.Text = "im not around (JJ5x5), now have fun!"
			wait(3)
			screengui:remove()
		end
	end
end

script.Parent.Touched:connect(showgui)</string>
            <bool name="archivable">true</bool>
