      <Item class="Script" referent="RBX735">
        <Properties>
          <bool name="Disabled">false</bool>
          <Content name="LinkedSource">
            <null></null>
          </Content>
          <string name="Name">Script</string>
          <string name="Source">function onTouched(part)
	if part.Parent ~= nil then
		local h = part.Parent:findFirstChild("Humanoid")
			if h~=nil then
				if cantouch~=0 then
					--if h.Parent.Name=="miked" then
						cantouch=0
						local lleg=h.Parent:findFirstChild("Left Leg")
						local rleg=h.Parent:findFirstChild("Right Leg")
						local larm=h.Parent:findFirstChild("Left Arm")
						local rarm=h.Parent:findFirstChild("Right Arm")
--[[
						h.Parent.Torso.Anchored=true
						h.Parent.Head.Anchored=true
						lleg.CanCollide=true
						rleg.CanCollide=true
						larm.Anchored=true
						rarm.Anchored=true
--]]
						h.Parent.Torso.Size=Vector3.new(20,20,10)
						--h.Parent.Torso.Velocity=Vector3.new(0,0,0)
						h.Parent.Torso.CFrame=CFrame.new(41.5, 30.4, 169,-1,0,0,0,1,0,0,0,-1)
						h.Parent.Head.Size=Vector3.new(10,10,10)
						--h.Parent.Head.Velocity=Vector3.new(0,0,0)
						h.Parent.Head.CFrame=CFrame.new(41.5, 45.4, 169,-1,0,0,0,1,0,0,0,-1)
						h.Parent.Head:makeJoints(); h.Parent.Torso:makeJoints()
						lleg.Size=Vector3.new(10, 20, 10)
						--lleg.Velocity=Vector3.new(0,0,0)
						lleg.CFrame=CFrame.new(46.5, 10.4, 169,-1,0,0,0,1,0,0,0,-1)
						lleg:makeJoints(); h.Parent.Torso:makeJoints()
						rleg.Size=Vector3.new(10, 20, 10)
						--rleg.Velocity=Vector3.new(0,0,0)
						rleg.CFrame=CFrame.new(36.5, 10.4, 169,-1,0,0,0,1,0,0,0,-1)
						rleg:makeJoints(); h.Parent.Torso:makeJoints()
						larm.Size=Vector3.new(10, 20, 10)
						--larm.Velocity=Vector3.new(0,0,0)
						larm.CFrame=CFrame.new(56.5, 30.4, 169,-1,0,0,0,1,0,0,0,-1)
						larm:makeJoints(); h.Parent.Torso:makeJoints()
						rarm.Size=Vector3.new(10, 20, 10)
						--rarm.Velocity=Vector3.new(0,0,0)
						rarm.CFrame=CFrame.new(26.5, 30.4, 169,-1,0,0,0,1,0,0,0,-1)
						rarm:makeJoints(); h.Parent.Torso:makeJoints()						

					--lleg:makeJoints()
				--rleg:makeJoints()
			--larm:makeJoints()
		--rarm:makeJoints()
						h.Parent.Humanoid.MaxHealth=5000
						h.Parent.Humanoid.Health=5000
						wait(5)
						cantouch=1
					--end
				end
			end
	end
end

script.Parent.Touched:connect(onTouched)
</string>
          <bool name="archivable">true</bool>
        </Properties>
      </Item>
