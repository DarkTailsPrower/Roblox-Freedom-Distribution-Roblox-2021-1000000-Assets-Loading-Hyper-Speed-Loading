      <Item class="Script" referent="RBX6588">
        <Properties>
          <bool name="Disabled">false</bool>
          <Content name="LinkedSource">
            <null></null>
          </Content>
          <string name="Name">CarTool</string>
          <string name="Source">print("RobloxPolice's Drive Action Tool!")

shooting = false
reloadtime = 0
time = 0
dir=1
turning=false
lastPiece=nil
bin=script.Parent

function CheckDistance(part1,part2)
	if (part1~=nil and part2~=nil) then
		local x1=part1.Position.x
		local y1=part1.Position.y
		local z1=part1.Position.z
		local x2=part2.Position.x
		local y2=part2.Position.y
		local z2=part2.Position.z
		local dist=(math.abs(x1-x2)+math.abs(y1-y2)+math.abs(z1-z2))/3 --Average Position?
		if (dist&lt;=8) then
			return true
		else
			return false
		end
	else
		return false
	end
end

function SetSpeed(car,spd,spd2)
	car.FL.RightParamA = -spd
	car.FL.RightParamB = spd
	car.BL.RightParamA = -spd
	car.BL.RightParamB = spd
	car.FR.LeftParamA = spd2
	car.FR.LeftParamB = -spd2
	car.BR.LeftParamA = spd2
	car.BR.LeftParamB = -spd2
end

function Execute(piece, com)
	com = com:lower()
	if (com=="go") then
		local car = piece.Parent
		local gear = car.Gear
		if (car~=nil and gear~=nil) then
			dir=1
			if (gear.Value==true) then
				dir=-0.5
			end
			SetSpeed(car,0.5*dir,0.5*dir)
		end
		time=4
	end
	if (com=="stop") then
		local car = piece.Parent
		if (car~=nil) then
			SetSpeed(car,0,0)
		end
		time=4
	end
	if (com=="left") then
		local car = piece.Parent
		local gear = car.Gear
		if (car~=nil and gear~=nil) then
			dir=1
			if (gear.Value==true) then
				dir=-0.5
			end
			SetSpeed(car,0,0.5*dir)
			turning=true
		end
	end
	if (com=="right") then
		local car = piece.Parent
		local gear = car.Gear
		if (car~=nil and gear~=nil) then
			dir=1
			if (gear.Value==true) then
				dir=-0.5
			end
			SetSpeed(car,0.5*dir,0)
			turning=true
		end
	end
	if (com=="shift") then
		local car = piece.Parent
		if (car.Gear~=nil) then
			if (car.Gear.Value==false) then
				car.Gear.Value=true
			else
				car.Gear.Value=false
			end
		end
		time=4
	end
end

function onButton1Down(mouse)
	if reloadtime &gt; 0 then return end
	if shooting == true then return end
	reloadtime = 1.0
	shooting = true

	time = 0
	while shooting == true do
		--FIRE MECHANISM
		local part = mouse.Target
		local act = part:findFirstChild("Action")
		if (act~=nil) then
			lastPiece=part
			local body = bin.Parent.Parent.Character.Torso
			if (CheckDistance(part,body)==true) then
				local val = act.Value
				if (val~=nil) then
					Execute(part, val)
				end
			end
		end

		wait(.03)
		time = time + .1
		if time &gt; 3.5 then shooting = false end
	end
	mouse.Icon = "rbxasset://textures\\GunWaitCursor.png"
	wait(0.5)
	reloadtime = 0
	mouse.Icon = "rbxasset://textures\\GunCursor.png"
end

function onButton1Up(mouse)
	shooting = false
	if (turning==true) then
		turning=false
		local car = lastPiece.Parent
		if (car~=nil) then
			SetSpeed(car,0.5*dir,0.5*dir)
		end
	end
end

function onSelected(mouse)
	if reloadtime &gt; 0 then
		mouse.Icon = "rbxasset://textures\\GunWaitCursor.png"
	else
		mouse.Icon = "rbxasset://textures\\GunCursor.png"
	end
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
	mouse.Button1Up:connect(function() onButton1Up(mouse) end)
end

bin.Selected:connect(onSelected)
