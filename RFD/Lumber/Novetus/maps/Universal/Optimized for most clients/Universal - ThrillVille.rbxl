            <string name="Source">function getPlayer(humanoid)
	local players = game.Players:children()
	for i = 1, #players do
		if players[i].Character.Humanoid == humanoid then return players[i] end
	end
	return nil
end

function onTouch(part)

        print("Take Tool")

	local human = part.Parent:findFirstChild("Humanoid")
	if (human == nil) then return end

	local player = getPlayer(human)

	if (player == nil) then return end

        if player.Backpack:findFirstChild("Suicide") ~= nil then -- Replace Reset To What Tool U Want It To Remove

	local PlrWep = player.Backpack:findFirstChild("Suicide") -- Replace Reset To What Tool U Want It To Remove
        PlrWep:remove()
        end
end

