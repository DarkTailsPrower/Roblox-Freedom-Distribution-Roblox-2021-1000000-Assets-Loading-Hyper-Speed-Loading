      <Item class="Script" referent="RBX453">
        <Properties>
          <bool name="Disabled">false</bool>
          <Content name="LinkedSource">
            <null></null>
          </Content>
          <string name="Name">Script</string>
          <string name="Source">name="legokid"

wait(1)
robo=game.Workspace:findFirstChild(name):clone()

while true do
	wait(5)
	if game.Workspace:findFirstChild(name)==nil then
		robot=robo:clone()
		robot.Parent=game.Workspace
	end
	if game.Workspace:findFirstChild(name):findFirstChild("Humanoid")==nil then
		game.Workspace:findFirstChild(name):remove()
		robot=robo:clone()
		robot.Parent=game.Workspace
	end
	if game.Workspace:findFirstChild(name).Humanoid.Health&lt;1 then
		game.Workspace:findFirstChild(name):remove()
		robot=robo:clone()
		robot.Parent=game.Workspace
	end
end
		


