      <Item class="Script" referent="RBX208">
        <Properties>
          <bool name="Disabled">false</bool>
          <Content name="LinkedSource">
            <null></null>
          </Content>
          <string name="Name">Script</string>
          <string name="Source">-- declarations

local head = script.Parent
local sound = head:findFirstChild("Victory")

function onTouched(part)
	local h = part.Parent:findFirstChild("Humanoid")
	if h~=nil then
sound:play()
if part.Parent:findFirstChild("Head"):findFirstChild("face").Texture == nil then return end
part.Parent:findFirstChild("Head"):findFirstChild("face").Texture="rbxasset://../../../shareddata/assets/1095696"
	end
end

script.Parent.Touched:connect(onTouched)</string>
          <bool name="archivable">true</bool>
