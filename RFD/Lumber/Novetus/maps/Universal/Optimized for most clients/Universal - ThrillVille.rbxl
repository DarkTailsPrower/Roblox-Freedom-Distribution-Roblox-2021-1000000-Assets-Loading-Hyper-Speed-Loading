              <string name="Name">DoorScript</string>
              <string name="Source">print("Simple Secret Door Script Loaded")

Door = script.Parent

function onTouched(hit)
	
		print("Door Hit")
		Door.Transparency = .5
	        Door.CanCollide = false
		wait(7)
		Door.CanCollide = true
		Door.Transparency = 0

end

connection = Door.Touched:connect(onTouched)

