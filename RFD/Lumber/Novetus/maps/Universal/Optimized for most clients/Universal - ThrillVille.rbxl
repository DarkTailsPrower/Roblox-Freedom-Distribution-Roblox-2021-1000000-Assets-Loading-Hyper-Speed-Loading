    <Item class="Tool" referent="RBX6625">
      <Properties>
        <int name="ActivationState">0</int>
        <int name="BackendToolState">1</int>
        <bool name="Enabled">true</bool>
        <CoordinateFrame name="Grip">
          <X>-1</X>
