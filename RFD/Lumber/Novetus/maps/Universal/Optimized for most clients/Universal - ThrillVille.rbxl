          <R22>-0</R22>
        </CoordinateFrame>
        <string name="Name">RocketLauncher</string>
        <Content name="TextureId">
          <url>rbxasset://Textures/Rocket.png</url>
        </Content>
        <bool name="archivable">true</bool>
