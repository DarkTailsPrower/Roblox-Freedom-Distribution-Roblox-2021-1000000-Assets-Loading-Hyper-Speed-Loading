          <string name="Name">PelletScript</string>
          <string name="Source">local debris = game:service(&quot;Debris&quot;)#13;#10;pellet = script.Parent#13;#10;damage = 8#13;#10;#13;#10;function onTouched(hit)#13;#10;#9;humanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;)#13;#10;#9;if humanoid~=nil then#13;#10;#9;#9;tagHumanoid(humanoid)#13;#10;#9;#9;humanoid.Health = humanoid.Health - damage#13;#10;#9;else#13;#10;#9;#9;damage = damage / 2#13;#10;#9;#9;if damage &lt; 1 then#13;#10;#9;#9;#9;connection:disconnect()#13;#10;#9;#9;#9;pellet.Parent = nil#13;#10;#9;#9;end#13;#10;#9;end#13;#10;end#13;#10;#13;#10;function tagHumanoid(humanoid)#13;#10;#9;-- todo: make tag expire#13;#10;#9;local tag = pellet:findFirstChild(&quot;creator&quot;)#13;#10;#9;if tag ~= nil then#13;#10;#9;#9;-- kill all other tags#13;#10;#9;#9;while(humanoid:findFirstChild(&quot;creator&quot;) ~= nil) do#13;#10;#9;#9;#9;humanoid:findFirstChild(&quot;creator&quot;).Parent = nil#13;#10;#9;#9;end#13;#10;#13;#10;#9;#9;local new_tag = tag:clone()#13;#10;#9;#9;new_tag.Parent = humanoid#13;#10;#9;#9;debris:AddItem(new_tag, 1)#13;#10;#9;end#13;#10;end#13;#10;#13;#10;connection = pellet.Touched:connect(onTouched)#13;#10;#13;#10;r = game:service(&quot;RunService&quot;)#13;#10;t, s = r.Stepped:wait()#13;#10;d = t + 2.0 - s#13;#10;while t &lt; d do#13;#10;#9;t = r.Stepped:wait()#13;#10;end#13;#10;#13;#10;pellet.Parent = nil#13;#10;</string>
