        <Item class="Script" referent="RBX1809">
          <Properties>
            <bool name="Disabled">false</bool>
            <Content name="LinkedSource">
              <null></null>
            </Content>
            <string name="Name">LeaderBoard</string>
            <string name="Source">print(&quot;Leaderboard script loaded&quot;)#13;#10;#13;#10;#13;#10;function onPlayerEntered(newPlayer)#13;#10;#13;#10;#13;#10;#9;local stats = Instance.new(&quot;IntValue&quot;)#13;#10;#9;stats.Name = &quot;leaderstats&quot;#13;#10;#13;#10;#9;local kills = Instance.new(&quot;IntValue&quot;)#13;#10;#9;kills.Name = &quot;Kills&quot;#13;#10;#9;kills.Value = 0#13;#10;#13;#10;#9;local deaths = Instance.new(&quot;IntValue&quot;)#13;#10;#9;deaths.Name = &quot;Deaths&quot;#13;#10;#9;deaths.Value = 0#13;#10;#13;#10;#9;kills.Parent = stats#13;#10;#9;deaths.Parent = stats#13;#10;#13;#10;#9;local humanoid = newPlayer.Character.Humanoid#13;#10;#9;humanoid.Died:connect(function() onHumanoidDied(humanoid, newPlayer) end )#13;#10;#13;#10;#9;-- start to listen for new humanoid#13;#10;#9;newPlayer.Changed:connect(function(property) onPlayerRespawn(property, newPlayer) end )#13;#10;#13;#10;#13;#10;#9;stats.Parent = newPlayer#13;#10;#13;#10;end#13;#10;#13;#10;function onHumanoidDied(humanoid, player)#13;#10;#9;local stats = player:findFirstChild(&quot;leaderstats&quot;)#13;#10;#9;if stats ~= nil then#13;#10;#9;#9;local deaths = stats:findFirstChild(&quot;Deaths&quot;)#13;#10;#9;#9;deaths.Value = deaths.Value + 1#13;#10;#9;#9;handleKillCount(humanoid, player)#13;#10;#9;end#13;#10;end#13;#10;#13;#10;function onPlayerRespawn(property, player)#13;#10;#9;-- need to connect to new humanoid#13;#10;#9;#13;#10;#9;if property == &quot;Character&quot; then#13;#10;#9;#9;local humanoid = player.Character.Humanoid#13;#10;#9;#9;#9;local p = player#13;#10;#9;#9;#9;local h = humanoid#13;#10;#9;#9;#9;humanoid.Died:connect(function() onHumanoidDied(h, p) end )#13;#10;#9;end#13;#10;end#13;#10;#13;#10;#13;#10;function handleKillCount(humanoid, player)#13;#10;#9;-- todo, killing self results in negative points.#13;#10;#9;#13;#10;#9;-- check for kill tag on humanoid - may be more than one - todo: deal with this#13;#10;#9;local tag = humanoid:findFirstChild(&quot;creator&quot;)#13;#10;#13;#10;#9;-- find player with name on tag#13;#10;#9;if tag ~= nil then#13;#10;#9;#9;#13;#10;#9;#9;local killer = tag.Value#13;#10;#9;#9;if killer.Parent ~= nil then#13;#10;#9;#9;#9;#13;#10;#9;#9;#9;-- test if killer still in game, maybe not a big deal#13;#10;#9;#9;#9;local stats = killer:findFirstChild(&quot;leaderstats&quot;)#13;#10;#9;#9;#9;if stats ~= nil then#13;#10;#9;#9;#9;#9;local kills = stats:findFirstChild(&quot;Kills&quot;)#13;#10;#9;#9;#9;#9;if killer ~= player then#13;#10;#9;#9;#9;#9;#9;kills.Value = kills.Value + 1#13;#10;#9;#9;#9;#9;#9;#13;#10;#9;#9;#9;#9;else#13;#10;#9;#9;#9;#9;#9;kills.Value = kills.Value - 1#13;#10;#9;#9;#9;#9;#9;#13;#10;#9;#9;#9;#9;end#13;#10;#9;#9;#9;end#13;#10;#9;#9;end#13;#10;#9;end #13;#10;#9;#13;#10;end#13;#10;#13;#10;game.Players.ChildAdded:connect(onPlayerEntered)</string>
            <bool name="archivable">true</bool>
          </Properties>
        </Item>
      </Item>
    </Item>
