          <string name="Name">Paintball</string>
          <string name="Source">ball = script.Parent#13;#10;damage = 2#13;#10;#13;#10;function onTouched(hit)#13;#10;#9;local humanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;)#13;#10;#9;#13;#10;#9;#9;#13;#10;#9;if hit:getMass() &lt; 1.2 * 200 then#13;#10;#9;#9;hit.BrickColor = ball.BrickColor#13;#10;#9;end#13;#10;#9;-- make a splat#13;#10;#9;for i=1,3 do#13;#10;#9;#9;local s = Instance.new(&quot;Part&quot;)#13;#10;#9;#9;s.Shape = 1 -- block#13;#10;#9;#9;s.formFactor = 2 -- plate#13;#10;#9;#9;s.Size = Vector3.new(1,.4,1)#13;#10;#9;#9;s.BrickColor = ball.BrickColor#13;#10;#9;#9;local v = Vector3.new(math.random(-1,1), math.random(0,1), math.random(-1,1))#13;#10;#9;#9;s.Velocity = 15 * v#13;#10;#9;#9;s.CFrame = CFrame.new(ball.Position + v, v)#13;#10;#9;#9;ball.BrickCleanup:clone().Parent = s#13;#10;#9;#9;s.BrickCleanup.Disabled = false#13;#10;#9;#9;s.Parent = game.Workspace#13;#10;#9;#9;#13;#10;#9;end#13;#10;#9;#13;#10;#13;#10;#9;if humanoid ~= nil then#13;#10;#9;#9;tagHumanoid(humanoid)#13;#10;#9;#9;humanoid.Health = humanoid.Health - damage#13;#10;#9;#9;wait(2)#13;#10;#9;#9;untagHumanoid(humanoid)#13;#10;#9;end#13;#10;#13;#10;#9;connection:disconnect()#13;#10;#9;ball.Parent = nil#13;#10;end#13;#10;#13;#10;function tagHumanoid(humanoid)#13;#10;#9;-- todo: make tag expire#13;#10;#9;local tag = ball:findFirstChild(&quot;creator&quot;)#13;#10;#9;if tag ~= nil then#13;#10;#9;#9;local new_tag = tag:clone()#13;#10;#9;#9;new_tag.Parent = humanoid#13;#10;#9;end#13;#10;end#13;#10;#13;#10;#13;#10;function untagHumanoid(humanoid)#13;#10;#9;if humanoid ~= nil then#13;#10;#9;#9;local tag = humanoid:findFirstChild(&quot;creator&quot;)#13;#10;#9;#9;if tag ~= nil then#13;#10;#9;#9;#9;tag.Parent = nil#13;#10;#9;#9;end#13;#10;#9;end#13;#10;end#13;#10;#13;#10;connection = ball.Touched:connect(onTouched)#13;#10;#13;#10;wait(8)#13;#10;ball.Parent = nil#13;#10;</string>
