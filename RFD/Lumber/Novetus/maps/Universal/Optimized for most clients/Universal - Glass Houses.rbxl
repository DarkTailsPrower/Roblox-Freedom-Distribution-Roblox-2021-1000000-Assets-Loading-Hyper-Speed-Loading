              <Item class="Script" referent="RBX2844">
                <Properties>
                  <bool name="Disabled">false</bool>
                  <Content name="LinkedSource">
                    <null></null>
                  </Content>
                  <string name="Name">SummonKillbot</string>
                  <ProtectedString name="Source">-- Touching this Battle Armor doubles you MaxHealth and heals you to full power

local debounce = false
local killbot = game.Workspace.Killbot:clone()


function getPlayer(humanoid)
#9;-- find the owning player of a humanoid.
#9;local players = game.Players:children()
#9;for i = 1, #players do
#9;#9;if players[i].Character ~= nil then
#9;#9;#9;if players[i].Character.Humanoid == humanoid then return players[i] end
#9;#9;end
#9;end
#9;return nil
end


function summonKillbot(humanoid)
#9;local player = getPlayer(humanoid)

#9;local x = math.random(-60,60)
#9;local y = math.random(40,60)
#9;local z = math.random(-60,60)

#9;local newbot = killbot:clone()

#9;newbot.OwningTeam.Value = &quot;Blue Falcons&quot;
#9;newbot.Parent = game.Workspace
#9;newbot.Sphere.BodyPosition.position = Vector3.new(x,y,z) -- little hack a little necessary
#9;newbot:move(Vector3.new(x,y,z))
#9;
#9;
#9;if player ~= nil then
#9;#9;local message = Instance.new(&quot;Message&quot;)
#9;#9;message.Text = &quot;The sphere hums...&quot;
#9;#9;message.Parent = player
#9;#9;wait(5)
#9;#9;message.Text = &quot;You have summoned a Blue killbot!&quot;
#9;#9;wait(5)
#9;#9;message.Parent = nil
#9;end


end


function onTouched(hit)
#9;local humanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
#9;if humanoid~=nil and debounce == false then
#9;#9;debounce = true
#9;#9;script.Parent.BrickColor = BrickColor.new(26)
#9;#9;summonKillbot(humanoid)
#9;#9;wait(3)
#9;#9;script.Parent.BrickColor = BrickColor.new(23)
#9;#9;debounce = false
#9;end
end


script.Parent.Touched:connect(onTouched)</ProtectedString>
                </Properties>
              </Item>
