          <null></null>
        </Content>
        <string name="Name">HackedUpTeamLeaderboard</string>
        <ProtectedString name="Source">-- This is a custom leaderboard for this level

print(&quot;Leaderboard script version 4.00 loaded&quot;)



function onPlayerEntered(newPlayer)

#9;local TKs = Instance.new(&quot;IntValue&quot;)
#9;TKs.Name = &quot;TeamKills&quot;
#9;TKs.Value = 0
#9;TKs.Parent = newPlayer

#9;local stats = Instance.new(&quot;IntValue&quot;)
#9;stats.Name = &quot;leaderstats&quot;

#9;local kills = Instance.new(&quot;IntValue&quot;)
#9;kills.Name = &quot;KOs&quot;
#9;kills.Value = 0

#9;local deaths = Instance.new(&quot;IntValue&quot;)
#9;deaths.Name = &quot;Wipeouts&quot;
#9;deaths.Value = 0

#9;kills.Parent = stats
#9;deaths.Parent = stats

#9;-- VERY UGLY HACK
#9;-- Will this leak threads?
#9;-- Is the problem even what I think it is (player arrived before character)?
#9;while true do
#9;#9;if newPlayer.Character ~= nil then break end
#9;#9;wait(5)
#9;end

#9;local humanoid = newPlayer.Character.Humanoid

#9;humanoid.Died:connect(function() onHumanoidDied(humanoid, newPlayer) end )

#9;-- start to listen for new humanoid
#9;newPlayer.Changed:connect(function(property) onPlayerRespawn(property, newPlayer) end )


#9;stats.Parent = newPlayer

end

--function checkTKs(victim, killer)
--#9;print(&quot;CHECK TKS&quot;)
--#9;if (killer == nil) then return end
--#9;if (victim == killer) then return end

--#9;if (victim.Team == killer.Team and killer:findFirstChild(&quot;TeamKills&quot;) ~= nil) then
#9;--#9;killer.TeamKills.Value = killer.TeamKills.Value + 1
#9;--#9;print(&quot;TK++&quot;)
#9;#9;-- show an appropraite msg

#9;--#9;local msg = Instance.new(&quot;Message&quot;)
#9;
#9;--#9;if (killer.TeamKills.Value == 1) then msg.Text = &quot;Try not to blox your team mates!&quot; end
#9;--#9;if (killer.TeamKills.Value == 2) then msg.Text = &quot;WARNING: blox your team, go to jail!&quot; end
#9;--#9;if (killer.TeamKills.Value &gt; 2) then
#9;#9;
#9;#9;#9;-- Jail time
#9;--#9;#9;msg.Text = &quot;JAIL TIME!&quot;
#9;--#9;#9;killer.Character.Humanoid.Health = 0
#9;#9;#9;

#9;--#9;end

#9;--#9;msg.Parent = killer
#9;--#9;wait(5)
#9;--#9;msg.Parent = nil
#9;--end

--end

function Send_DB_Event_Died(victim, killer)
#9;-- killer may be nil
#9;local killername = &quot;no one&quot;
#9;if killer ~= nil then killername = killer.Name end
#9;print(&quot;DIED EVENT: &quot;, victim.Name, &quot; KILLED by &quot;, killername)

#9;if shared[&quot;deaths&quot;] ~= nil then 
#9;#9;shared[&quot;deaths&quot;](victim, killer)
#9;#9;print(&quot;SENT DB DEATH EVENT&quot;)
#9;end
end

function Send_DB_Event_Kill(killer, victim)
#9;print(&quot;KILL EVENT. &quot;, killer.Name, &quot; BLOXXED &quot;, victim.Name)
#9;if shared[&quot;kills&quot;] ~= nil then 
#9;#9;shared[&quot;kills&quot;](killer, victim)
#9;#9;print(&quot;SENT DB KILL EVENT&quot;)
#9;end
end



function onHumanoidDied(humanoid, player)
#9;local stats = player:findFirstChild(&quot;leaderstats&quot;)
#9;if stats ~= nil then
#9;#9;local deaths = stats:findFirstChild(&quot;Wipeouts&quot;)
#9;#9;deaths.Value = deaths.Value + 1

#9;#9;-- do short dance to try and find the killer

#9;#9;local killer = getKillerOfHumanoidIfStillInGame(humanoid)

#9;#9;--checkTKs(player, killer)

#9;#9;Send_DB_Event_Died(player, killer)
#9;#9;handleKillCount(humanoid, player)
#9;end
end

function onPlayerRespawn(property, player)
#9;-- need to connect to new humanoid
#9;
#9;if property == &quot;Character&quot; and player.Character ~= nil then
#9;#9;local humanoid = player.Character.Humanoid
#9;#9;#9;local p = player
#9;#9;#9;local h = humanoid
#9;#9;#9;humanoid.Died:connect(function() onHumanoidDied(h, p) end )
#9;end
end

function getKillerOfHumanoidIfStillInGame(humanoid)
#9;-- returns the player object that killed this humanoid
#9;-- returns nil if the killer is no longer in the game

#9;-- check for kill tag on humanoid - may be more than one - todo: deal with this
#9;local tag = humanoid:findFirstChild(&quot;creator&quot;)

#9;-- find player with name on tag
#9;if tag ~= nil then
#9;#9;
#9;#9;local killer = tag.Value
#9;#9;if killer.Parent ~= nil then -- killer still in game
#9;#9;#9;return killer
#9;#9;end
#9;end

#9;return nil
end

function handleKillCount(humanoid, player)
#9;local killer = getKillerOfHumanoidIfStillInGame(humanoid)
#9;if killer ~= nil then
#9;#9;local stats = killer:findFirstChild(&quot;leaderstats&quot;)
#9;#9;if stats ~= nil then
#9;#9;#9;local kills = stats:findFirstChild(&quot;KOs&quot;)
#9;#9;#9;if killer ~= player then
#9;#9;#9;#9;kills.Value = kills.Value + 1
#9;#9;#9;#9;
#9;#9;#9;else
#9;#9;#9;#9;kills.Value = kills.Value - 1
#9;#9;#9;#9;
#9;#9;#9;end
#9;#9;#9;Send_DB_Event_Kill(killer, player)
#9;#9;end
#9;end
end

game.Players.ChildAdded:connect(onPlayerEntered)</ProtectedString>
