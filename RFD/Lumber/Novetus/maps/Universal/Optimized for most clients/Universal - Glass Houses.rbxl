          <Item class="Script" referent="RBX617">
            <Properties>
              <bool name="Disabled">false</bool>
              <Content name="LinkedSource">
                <null></null>
              </Content>
              <string name="Name">FireGun</string>
              <ProtectedString name="Source">local switch = script.Parent
local gunBarrelOne = script.Parent.Parent.GunBarrel.One
local gunBarrelTwo = script.Parent.Parent.GunBarrel.Two

local debounce = false
local gunOne = true

local cannonBall = Instance.new(&quot;Part&quot;)
cannonBall.Size = Vector3.new(2,2,2)
cannonBall.BrickColor = BrickColor.new(21) -- red
cannonBall.Shape = 0
cannonBall.BottomSurface = 0
cannonBall.TopSurface = 0
cannonBall.Name = &quot;Cannon Shot&quot;
cannonBall.Elasticity = .1
cannonBall.Reflectance = .2
cannonBall.Friction = 1

function getPlayer(humanoid)
#9;-- find the owning player of a humanoid.
#9;local players = game.Players:children()
#9;for i = 1, #players do
#9;#9;if players[i].Character ~= nil then
#9;#9;#9;if players[i].Character.Humanoid == humanoid then return players[i] end
#9;#9;end
#9;end
#9;return nil
end

function fire(player)

#9;local sound = script.Parent:findFirstChild(&quot;GunSound&quot;)
#9;if sound == nil then
#9;#9;sound = Instance.new(&quot;Sound&quot;)
#9;#9;sound.Name = &quot;GunSound&quot;
#9;#9;sound.SoundId = &quot;rbxasset://sounds\\Rocket shot.wav&quot;
#9;#9;sound.Volume = 1
#9;#9;sound.Parent = script.Parent
#9;end
#9;sound:play()



#9;
#9;local missile = Instance.new(&quot;Part&quot;)


#9;local barrel

#9;if gunOne == true then
#9;#9;barrel = gunBarrelOne
#9;#9;gunOne = false
#9;else
#9;#9;barrel = gunBarrelTwo
#9;#9;gunOne = true
#9;end

#9;if (barrel.Position - switch.Parent.Base.Position).magnitude &gt; 16 then return end -- Blown up guns don&apos;t shoot. Usually.
#9;

#9;local spawnPos = barrel.CFrame * Vector3.new(6, 0, 0)

#9;local dx = math.random(-10,10)
#9;local dy = math.random(-10,10)
#9;local dz = math.random(-10,10)
#9;local mag = math.random(180,260)

#9;local v = barrel.CFrame:vectorToWorldSpace(Vector3.new(mag + dx,dy,dz))
#9;
#9;local missile = cannonBall:clone()

#9;missile.Position = spawnPos
#9;missile.Velocity = v


#9;
#9;local new_script = script.Parent.CannonBall:clone()
#9;new_script.Disabled = false
#9;new_script.Parent = missile

#9;local creator_tag = Instance.new(&quot;ObjectValue&quot;)
#9;creator_tag.Value = player
#9;creator_tag.Name = &quot;creator&quot;
#9;creator_tag.Parent = missile
#9;


#9;missile.Parent = game.Workspace

end

function onTouched(hit)
#9;local humanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
#9;if humanoid~=nil and debounce == false then
#9;#9;debounce = true
#9;#9;switch.BrickColor = BrickColor.new(21)
#9;#9;local player = getPlayer(humanoid)
#9;#9;-- let slip the dogs of war
#9;#9;fire(player)
#9;#9;wait(.2)
#9;#9;fire(player)
#9;#9;wait(.2)
#9;#9;fire(player)
#9;#9;wait(.2)
#9;#9;fire(player)

#9;#9;wait(3)
#9;#9;debounce = false
#9;#9;switch.BrickColor = BrickColor.new(37)
#9;end
end


script.Parent.Touched:connect(onTouched)


</ProtectedString>
            </Properties>
          </Item>
          <Item class="Script" referent="RBX618">
            <Properties>
              <bool name="Disabled">true</bool>
              <Content name="LinkedSource">
                <null></null>
              </Content>
              <string name="Name">CannonBall</string>
              <ProtectedString name="Source">ball = script.Parent
damage = 50

function onTouched(hit)


#9;local humanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
#9;if humanoid~=nil then
#9;#9;tagHumanoid(humanoid)
#9;#9;humanoid.Health = humanoid.Health - damage
#9;#9;wait(2)
#9;#9;untagHumanoid(humanoid)
#9;#9;connection:disconnect()
#9;else
#9;#9;damage = damage / 2
#9;#9;if damage &lt; 2 then
#9;#9;#9;connection:disconnect()
#9;#9;#9;ball.Parent = nil
#9;#9;end
#9;end

#9;if math.random(1,3) == 2 then
#9;#9;explosion = Instance.new(&quot;Explosion&quot;)
#9;#9;explosion.BlastRadius = 12
#9;#9;explosion.BlastPressure = 1000000 -- these are really wussy units
#9;#9;explosion.Position = script.Parent.Position
#9;#9;explosion.Parent = game.Workspace
#9;#9;connection:disconnect()
#9;#9;ball.Parent = nil
#9;end

end

function tagHumanoid(humanoid)
#9;-- todo: make tag expire
#9;local tag = ball:findFirstChild(&quot;creator&quot;)
#9;if tag ~= nil then
#9;#9;local new_tag = tag:clone()
#9;#9;new_tag.Parent = humanoid
#9;end
end


function untagHumanoid(humanoid)
#9;if humanoid ~= nil then
#9;#9;local tag = humanoid:findFirstChild(&quot;creator&quot;)
#9;#9;if tag ~= nil then
#9;#9;#9;tag.Parent = nil
#9;#9;end
#9;end
end

connection = ball.Touched:connect(onTouched)

r = game:service(&quot;RunService&quot;)
t, s = r.Stepped:wait()
d = t + 5.0 - s
while t &lt; d do
#9;t = r.Stepped:wait()
end

ball.Parent = nil</ProtectedString>
