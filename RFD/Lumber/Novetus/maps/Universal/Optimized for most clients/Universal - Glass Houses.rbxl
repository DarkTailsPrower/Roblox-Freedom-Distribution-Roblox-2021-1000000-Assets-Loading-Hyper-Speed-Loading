          <Item class="Script" referent="RBX731">
            <Properties>
              <bool name="Disabled">false</bool>
              <Content name="LinkedSource">
                <null></null>
              </Content>
              <string name="Name">TreeElevator</string>
              <ProtectedString name="Source">local bodypos = script.Parent.BodyPosition
script.Parent.BodyGyro.cframe = script.Parent.CFrame

local down_pos = script.Parent.Position -- use relative positioning so that we can move the tree around and not mess things up
local up_pos = Vector3.new(down_pos.x, down_pos.y + 67.2, down_pos.z)


bodypos.position = down_pos

local debounce = false

local isDown = true

function onTouched(hit)
#9;local humanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
#9;if humanoid~=nil and debounce == false then
#9;#9;debounce = true

#9;#9;script.Parent.BrickColor = BrickColor.new(21)

#9;#9;wait(2)

#9;#9;if isDown == true then 
#9;#9;#9;-- going up
#9;#9;#9;bodypos.position = up_pos
#9;#9;#9;isDown = false
#9;#9;end

#9;#9;wait(10)

#9;#9;-- going down
#9;#9;bodypos.position = down_pos
#9;#9;isDown = true
#9;#9;wait(4)

#9;#9;debounce = false
#9;#9;script.Parent.BrickColor = BrickColor.new(106)
#9;end
end




script.Parent.Touched:connect(onTouched)

</ProtectedString>
            </Properties>
