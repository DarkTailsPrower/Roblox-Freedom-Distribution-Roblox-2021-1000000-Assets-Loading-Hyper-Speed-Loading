    <Item class="Script" referent="RBX3184">
      <Properties>
        <bool name="Disabled">false</bool>
        <Content name="LinkedSource">
          <null></null>
        </Content>
        <string name="Name">RegenerationStation</string>
        <ProtectedString name="Source">local game_length = 300 -- every X seconds, end the game, show a message, regen the map, rebalance teams, cause MASSIVE LAG


local red_stuff = game.Workspace.RedTeamRegen:clone()
local blue_stuff = game.Workspace.BlueTeamRegen:clone()
local gold_killbot = game.Workspace.Killbot:clone()


message = nil
function showMessage(text)
#9;-- This function flashes a message to all players
#9;-- Clear the message with hideMessage()

#9;hideMessage() -- Never show more than one message at a time
#9;if message == nil then message = Instance.new(&quot;Message&quot;) end -- only make a message if we don&apos;t have a message object lying around
#9;message.Text = text
#9;message.Parent = game.Workspace
end

function hideMessage()
#9;if message == nil then return end
#9;message.Parent = nil
end

function RegenGoldKillbot()
#9;if (game.Workspace:findFirstChild(&quot;Killbot&quot;) ~= nil) then game.Workspace.Killbot:remove() end
#9;local new_stuff = gold_killbot:clone()
#9;new_stuff.Parent = game.Workspace
end

function RegenRed()
#9;game.Workspace.RedTeamRegen:remove()
#9;local new_stuff = red_stuff:clone()
#9;new_stuff.Parent = game.Workspace
#9;new_stuff:makeJoints()
end

function RegenBlue()
#9;game.Workspace.BlueTeamRegen:remove()
#9;local new_stuff = blue_stuff:clone()
#9;new_stuff.Parent = game.Workspace
#9;new_stuff:makeJoints()
end


function clearPlayerInfo()
#9;-- resets KOs and WOs
#9;local players = game.Players:children()
#9;for i = 1, #players do
#9;#9;if (players[i]:findFirstChild(&quot;leaderstats&quot;) ~= nil) and (players[i].leaderstats.KOs ~= nil) then players[i].leaderstats.KOs.Value = 0 end
#9;#9;if (players[i]:findFirstChild(&quot;leaderstats&quot;) ~= nil) and (players[i].leaderstats.Wipeouts ~= nil) then players[i].leaderstats.Wipeouts.Value = 0 end
#9;end#9;
end

function getWinnerInfo()
#9;-- returns a string that we display to everyone about who the winner is

#9;-- in case of tie, no one wins. if someone wants to code something better, be my guest.
#9;local highscore = 0
#9;local winner = &quot;No one&quot;
#9;local tie = false

#9;local players = game.Players:children()
#9;for i = 1, #players do
#9;#9;local pscore = -1
#9;#9;if players[i]:findFirstChild(&quot;leaderstats&quot;) ~= nil then 
#9;#9;#9;if players[i].leaderstats.Points ~= nil then 
#9;#9;#9;#9;pscore = players[i].leaderstats.Points.Value 
#9;#9;#9;end
#9;#9;end

#9;#9;if pscore == highscore then
#9;#9;#9;tie = true
#9;#9;end

#9;#9;if pscore &gt; highscore then 
#9;#9;#9;-- new highscore
#9;#9;#9;highscore = pscore
#9;#9;#9;winner = players[i].Name
#9;#9;#9;tie = false
#9;#9;end
#9;end
#9;
#9;if tie == true then return &quot;There was a tie. How boring.&quot; end
#9;
#9;local text = string.format(&quot;%s %s %d %s&quot;, winner, &quot;wins with&quot;, highscore, &quot;points!&quot;)
#9;return text
end

function getWinningTeamString()
#9;local red = 0
#9;local blue = 0

#9;local p = game.Players:children()
#9;for i=1,#p do
#9;#9;if (p[i].TeamColor == game.Teams:findFirstChild(&quot;Blue Falcons&quot;).TeamColor) then
#9;#9;#9;if (p[i]:findFirstChild(&quot;leaderstats&quot;) ~= nil and p[i].leaderstats.KOs ~= nil) then
#9;#9;#9;#9;blue = blue + p[i].leaderstats.KOs.Value
#9;#9;#9;end
#9;#9;end

#9;#9;if (p[i].TeamColor == game.Teams:findFirstChild(&quot;Red Hawks&quot;).TeamColor) then
#9;#9;#9;if (p[i]:findFirstChild(&quot;leaderstats&quot;) ~= nil and p[i].leaderstats.KOs ~= nil) then
#9;#9;#9;#9;red = red + p[i].leaderstats.KOs.Value
#9;#9;#9;end
#9;#9;end
#9;end

#9;if (red == blue) then return &quot;Red and Blue tied. How boring!&quot; end

#9;if (red &gt; blue) then return string.format(&quot;Red won the match by %d points!&quot;, red - blue) end

#9;return string.format(&quot;Blue won the match by %d points!&quot;, blue - red)

end


while true do
#9;wait(game_length - 30)
#9;showMessage(&quot;30 seconds left until end of game!&quot;)
#9;wait(5)
#9;hideMessage()
#9;wait(25)

#9;-- put up winning team info
#9;showMessage(getWinningTeamString())
#9;wait(2)
#9;RegenGoldKillbot()
#9;RegenRed()
#9;RegenBlue()
#9;
#9;showMessage(&quot;Rebalancing teams and launching new game...&quot;)
#9;wait(5)
#9;clearPlayerInfo()
#9;game.Teams:rebalanceTeams()

#9;hideMessage()

end</ProtectedString>
      </Properties>
    </Item>
