          <string name="Name">KillbotScript</string>
          <ProtectedString name="Source">local sphere = script.Parent.Sphere

local myTarget = nil


-- obtain goals based on Sphere part
sphere.BodyPosition.position = sphere.Position





-- this code hijacked from the new rocket launcher
local Rocket = Instance.new(&quot;Part&quot;)
Rocket.Locked = true
Rocket.BackSurface = 3
Rocket.BottomSurface = 3
Rocket.FrontSurface = 3
Rocket.LeftSurface = 3
Rocket.RightSurface = 3
Rocket.TopSurface = 3
Rocket.Size = Vector3.new(1,1,4)
Rocket.BrickColor = BrickColor.new(24)
script.Parent.RocketScript:clone().Parent = Rocket
script.Parent.Explosion:clone().Parent = Rocket
script.Parent.Swoosh:clone().Parent = Rocket

function getPlayerTeamName(player)
#9;local teams = game.Teams:children()
#9;for i=1, #teams do
#9;#9;if (teams[i].TeamColor == player.TeamColor) then return teams[i].Name end
#9;end
end

function getTeamColorFromName(name)
#9;local teams = game.Teams:children()
#9;for i=1, #teams do
#9;#9;if (teams[i].Name == name) then return teams[i].TeamColor end
#9;end

#9;return BrickColor.new(24)
end

function fire(target)


#9;local dir = target - sphere.Position
#9;dir = computeDirection(dir)


#9;local missile = Rocket:clone()

#9;local spawnPos = sphere.Position

#9;local pos = spawnPos + (dir * 8)
#9;
#9;--missile.Position = pos
#9;missile.CFrame = CFrame.new(pos,  pos + dir)

#9;
#9;missile.RocketScript.Disabled = false
#9;missile.Parent = game.Workspace


end

function computeDirection(vec)
#9;local lenSquared = vec.magnitude * vec.magnitude
#9;local invSqrt = 1 / math.sqrt(lenSquared)
#9;return Vector3.new(vec.x * invSqrt, vec.y * invSqrt, vec.z * invSqrt)
end



function scanForHumans()
#9;-- KILL THE HUMANS!!!!!!!!!!

#9;-- find the closest human that is not on my team
#9;

#9;local players = game.Players:children()

#9;local best_distance = 10000
#9;local best_target = nil

#9;for n=1,#players do
#9;#9;if (getPlayerTeamName(players[n]) ~= script.Parent.OwningTeam.Value) then
#9;#9;#9;if (players[n].Character ~= nil) then
#9;#9;#9;#9;local dist = (players[n].Character.PrimaryPart.Position - sphere.Position).magnitude
#9;#9;#9;#9;if (dist &lt; best_distance) then
#9;#9;#9;#9;#9;best_distance = dist
#9;#9;#9;#9;#9;best_target = players[n].Character
#9;#9;#9;#9;end
#9;#9;#9;end
#9;#9;end
#9;end

#9;myTarget =  best_target

#9;
end

function moveKillbot()
#9;
#9;-- killbots move using a biased random walk toward the target
#9;-- they also like to float at least 10 studs above the ground

#9;local dx = math.random(-100,100)
#9;local dy = math.random(-40,40)
#9;local dz = math.random(-100,100)

#9;if (sphere.Position.y &lt; 10 and dy &lt; 0) then dy = -dy end
#9;if (sphere.Position.y &gt; 80 and dy &gt; 0) then dy = -dy end

#9;if (myTarget ~= nil) then
#9;#9;local dir = computeDirection(myTarget.PrimaryPart.Position - sphere.Position)
#9;#9;dx = dx + (dir.x * 80) -- change this number to alter player trophism
#9;#9;dz = dz + (dir.z * 80)
#9;end

#9;local vec = computeDirection(Vector3.new(dx,dy,dz))

#9;sphere.BodyPosition.position = sphere.Position + (vec * 40) -- change this number to alter speed
#9;

end

function onTouched(hit)
#9;local humanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
#9;if humanoid~=nil then
#9;#9;humanoid.Health = humanoid.Health - 2000 -- Killbots kill you when you touch them! duh.
#9;else
#9;#9;-- sadly, there is no good way to give a killbot hit points, so one hit with any weapon kills them
#9;#9;script.Parent.Parent = nil
#9;end
end

sphere.Touched:connect(onTouched)

if (script.Parent.OwningTeam.Value ~= nil) then sphere.BrickColor = getTeamColorFromName(script.Parent.OwningTeam.Value) end

while true do  -- loop forever
#9;scanForHumans()

#9;for n=1,5 do
#9;#9;if (myTarget ~= nil) then
#9;#9;#9;if(math.random(1,3) == 2) then fire(myTarget.PrimaryPart.Position) end
#9;#9;#9;wait(math.random(1,2))
#9;#9;#9;moveKillbot()
#9;#9;#9;wait(math.random(1,2))
#9;#9;end
#9;end
#9;wait(1) -- don&apos;t hog CPU
end
