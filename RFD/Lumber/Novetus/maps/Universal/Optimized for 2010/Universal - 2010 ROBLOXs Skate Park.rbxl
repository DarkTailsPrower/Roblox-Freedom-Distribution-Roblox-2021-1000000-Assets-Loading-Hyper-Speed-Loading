							<R11>0.408248276</R11>
							<R12>-0.1829741</R12>
							<R20>-0.447376817</R20>
							<R21>-0.816496551</R21>
							<R22>0.364948362</R22>
						</CoordinateFrame>
						<string name="Name">SkateTool</string>
						<Content name="TextureId"><url>rbxasset://../../../shareddata/textures/24421892.png</url></Content>
