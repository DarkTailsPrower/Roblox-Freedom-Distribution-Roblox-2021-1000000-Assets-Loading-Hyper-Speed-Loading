				<Item class="Tool" referent="RBX5385">
					<Properties>
						<bool name="Enabled">true</bool>
						<CoordinateFrame name="Grip">
							<X>0.600000024</X>
							<Y>0.200000003</Y>
							<Z>0</Z>
							<R00>-0.000408172607</R00>
							<R01>0.408248276</R01>
