							<ProtectedString name="Source">local skateboardId = 23154610 

local Tool = script.Parent;

function insert()
	--This call will cause a &quot;wait&quot; until the data comes back
	local root = game.Lighting.Board:clone()

	--Continue the insert process
	root.Name = &quot;InsertedObject&quot; .. skateboardId
	local Mesh = Tool.Handle.Mesh:clone()
	Mesh.Parent = root.SkateboardPlatform
	
	root.Parent = game.Workspace

	-- for some reason copying from lighting fucks up the position.
	root[&quot;Left Front&quot;].Position = Vector3.new(2.5, 75, -1.5)
	root[&quot;Left Rear&quot;].Position = Vector3.new(-2.5, 75, -1.5)
	root[&quot;Right Front&quot;].Position = Vector3.new(-2.5, 75, 1.5)
	root[&quot;Right Rear&quot;].Position = Vector3.new(2.5, 75, 1.5)

	local t = game.Players.LocalPlayer.Character:FindFirstChild(&quot;Torso&quot;)

	root:MoveTo(t.Position + t.CFrame.lookVector * 8)
	Tool.Handle.Drop:Play()
end

enabled = true
function onButton1Down(mouse)
	if not enabled then
		return
	end

	enabled = false


	insert()
	wait(.01)

	Tool:Remove()


end

function onEquippedLocal(mouse)

	if mouse == nil then
		print(&quot;Mouse not found&quot;)
		return 
	end

	mouse.Icon = &quot;rbxasset://../../../shareddata/assets/22858207&quot;
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end


