						<string name="Name">RackScript</string>
						<ProtectedString name="Source">local board = script.Parent.SkateTool:Clone()

while true do 

	wait(5)

	if (script.Parent:FindFirstChild(&quot;SkateTool&quot;) == nil) then
		
		local c = board:Clone()
		c.Parent = script.Parent

	end

end</ProtectedString>
