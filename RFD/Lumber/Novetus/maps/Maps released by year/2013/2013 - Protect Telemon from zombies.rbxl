				<Item class="Script" referent="RBX5655">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Remind</string>
						<ProtectedString name="Source">wait(3)
repeat wait() until script.Parent.Health&lt;script.Parent.MaxHealth

for i = 1,#game.Players:GetChildren() do
pcall(function()
if game.Players:GetChildren()[i].Remind.Value==false then
game.Players:GetChildren()[i].Remind.Value=true


game.Players:GetChildren()[i].PlayerGui.GameGui.Frame.CharacterLabel.Reminder.Visible=true


end
end)
end</ProtectedString>
