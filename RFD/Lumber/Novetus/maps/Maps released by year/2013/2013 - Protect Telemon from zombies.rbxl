					<ProtectedString name="Source">while true do
wait()

if script.Parent.Torso.Position.Y&lt;697 then
script.Parent.Torso.CFrame=CFrame.new(306.8, 746.2, 247.5)
end

if script.Parent.Torso:findFirstChild(&quot;BodyVelocity&quot;) then
script.Parent.Torso:findFirstChild(&quot;BodyVelocity&quot;):destroy()
end

end
