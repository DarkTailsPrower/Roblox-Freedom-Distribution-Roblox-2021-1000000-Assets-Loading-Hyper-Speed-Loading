					<Item class="Script" referent="RBX5542">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">PickupBoots</string>
							<ProtectedString name="Source">-- This script is a sin against god and man
--
-- I&apos;m using the v. ugly hack of cloning HopperBins under the Lighting service into a Player&apos;s Backpack.
--
-- If you want the box to stay in the game once one person has touched it, you should do something to 
-- keep from cloning the same tool into a player&apos;s backpack for multiple touches. Easiest thing is to 
-- check the backpack to see if a hopperbin with the same name already exists.

-- Telamon.

local c1, c2

function getPlayer(humanoid)
&#9;-- find the owning player of a humanoid. this is a hack.
&#9;local players = game.Players:children()
&#9;for i = 1, #players do
&#9;&#9;if players[i].Character.Humanoid == humanoid then return players[i] end
&#9;end
&#9;return nil
end

function onTouch(part)

&#9;local human = part.Parent:findFirstChild(&quot;Humanoid&quot;)&#9;
&#9;if (human == nil) then return end

&#9;c1:disconnect()
&#9;c2:disconnect()

&#9;local player = getPlayer(human)

&#9;if (player == nil) then return end

&#9;game.Lighting.JetBoots:clone().Parent = player.Backpack

&#9;
&#9;script.Parent.Parent = nil -- remove Present model from the game.
&#9;&#9;
&#9;if player ~= nil then
&#9;&#9;local message = Instance.new(&quot;Message&quot;)
&#9;&#9;message.Text = &quot;You found Jet Boots!&quot;
&#9;&#9;message.Parent = player
&#9;&#9;wait(5)
&#9;&#9;message.Text = &quot;Hold left mouse to fly!&quot;
&#9;&#9;wait(5)
&#9;&#9;message.Parent = nil
&#9;&#9;wait(2)
&#9;end



end

c1 = script.Parent.Boot1.Touched:connect(onTouch)
c2 = script.Parent.Boot2.Touched:connect(onTouch)</ProtectedString>
						</Properties>
					</Item>
				</Item>
