function CreateZombie()

local New=game.Lighting.Zombie:clone()
New.Parent=workspace.Zombies
New.Zombie.MaxHealth=130
New.Zombie.Health=130
New.Name=&quot;Parachuting Zombie&quot;
New:MakeJoints()
New:MoveTo(Vector3.new(304.8, 1048, 197.6)+Vector3.new(math.random(-100,100),0,math.random(-100,100)))

New.Control.Disabled=true

local Parachute = game.Lighting.Parachute:clone()
Parachute.Parent=New
Parachute.Position = New.Head.Position + Vector3.new(0,2,0)
Weld(New.Head,Parachute)


New[&quot;Right Leg&quot;].Touched:wait()

New.Control.Disabled=false

Parachute:remove()

end


while true do
wait(.5)

if #workspace.Zombies:GetChildren() &lt; 25 then
delay(0,function()
CreateZombie()
end)


end

end</ProtectedString>
