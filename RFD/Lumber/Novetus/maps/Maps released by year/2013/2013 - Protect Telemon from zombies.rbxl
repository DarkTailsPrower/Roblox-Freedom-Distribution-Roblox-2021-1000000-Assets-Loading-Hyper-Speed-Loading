			<Item class="Script" referent="RBX4191">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">script.Parent.TouchEnded:connect(function(c)
if not c then return end
if c.Name~=&quot;Torso&quot; then return end
pcall(function()
c.Parent.Launch:remove()
end)
pcall(function()
c.Parent.Torso.BodyVelocity:remove()
end)
end)

script.Parent.Touched:connect(function(x)
if not x then return end
if x.Name~=&quot;Torso&quot; then return end
pcall(function()
if x.Parent:findFirstChild(&quot;Torso&quot;) then
if not x.Parent:findFirstChild(&quot;Launch&quot;) then

if x.Parent.Torso.Position.Y &lt; 536 then

if x.Parent:findFirstChild(&quot;Humanoid&quot;) then

script.Launch:clone().Parent=x.Parent

else

xf=script.LaunchZomb:clone()
xf.Name = &quot;Launch&quot;
xf.Parent=x.Parent

end


elseif x.Parent.Torso.Position.Y &gt; 536 then

if x.Parent:findFirstChild(&quot;Humanoid&quot;) then

xf=script.Launch2:clone()
xf.Name = &quot;Launch&quot;
xf.Parent=x.Parent

else

xf=script.LaunchZomb2:clone()
xf.Name = &quot;Launch&quot;
xf.Parent=x.Parent

end

end

end
end
end)
end)</ProtectedString>
				</Properties>
				<Item class="LocalScript" referent="RBX4192">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Launch</string>
						<ProtectedString name="Source">bv=Instance.new(&quot;BodyVelocity&quot;)
bv.Parent=script.Parent.Torso
bv.velocity=Vector3.new(0,0,0)
bv.maxForce=Vector3.new(0,100000,0)

for i = 1,30 do
bv.velocity=Vector3.new(0,i,0)
wait(.05)
end</ProtectedString>
					</Properties>
				</Item>
				<Item class="LocalScript" referent="RBX4193">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Launch2</string>
						<ProtectedString name="Source">bv=Instance.new(&quot;BodyPosition&quot;)
bv.Parent=script.Parent.Torso
bv.maxForce=Vector3.new(0,math.huge,0)
bv.Name=&quot;BodyVelocity&quot;
bv.maxForce=Vector3.new(0,50000,0)

delay(0,function()

repeat wait() until script.Parent.Torso.Position.Y &lt; 456

bv:remove()

end)

for i = 1,500 do
bv.position=script.Parent.Torso.Position+Vector3.new(0,-i^.5,0)
wait(.05)
end</ProtectedString>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX4194">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">LaunchZomb</string>
						<ProtectedString name="Source">bv=Instance.new(&quot;BodyVelocity&quot;)
