					</Properties>
					<Item class="Script" referent="RBX4004">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">script.Parent.DialogChoiceSelected:connect(function(player,dialog)
c=player.Character
if dialog.UserDialog==&quot;Yes&quot; then
if not c:FindFirstChild(&quot;ShopScript&quot;) then
wait(1.5)
script.ShopScript:clone().Parent=c
end
end
end)</ProtectedString>
						</Properties>
						<Item class="LocalScript" referent="RBX4005">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">ShopScript</string>
								<ProtectedString name="Source">CurrentItem = 1

script.Parent.Humanoid.WalkSpeed = 0

sg=Instance.new(&quot;ScreenGui&quot;)
sg.Parent = game.Players[script.Parent.Name].PlayerGui

f = Instance.new(&quot;TextButton&quot;)
f.Parent = sg
f.Size = UDim2.new(1,0,1,0)
f.Transparency = 1
f.Text = &quot;&quot;

desc = Instance.new(&quot;TextLabel&quot;)
desc.Parent = sg
desc.BackgroundTransparency = .3
desc.BackgroundColor3 = BrickColor.new(&quot;Institutional white&quot;).Color
desc.TextColor3 = BrickColor.new(&quot;Really black&quot;).Color
desc.Size = UDim2.new(1,0,.1,0)
desc.Position = UDim2.new(0,0,.75,0)
desc.TextWrap = true
desc.Text = [[Health Pack - 500
Type - Tool
Kept on death - No
Description: Handy when your life is at risk. Heals 100% of MaxHealth.
]]

Left=Instance.new(&quot;TextButton&quot;)
Left.Parent = desc
Left.Size = UDim2.new(.1,0,1,0)
Left.TextColor3 = BrickColor.new(&quot;Really black&quot;).Color
Left.FontSize = &quot;Size18&quot;
Left.Text = &quot;&lt;-&quot;
Left.BackgroundColor3 = BrickColor.new(&quot;New Yeller&quot;).Color

Buy=Instance.new(&quot;TextButton&quot;)
Buy.Parent = desc
Buy.Size = UDim2.new(.6,0,1,0)
Buy.Position = UDim2.new(.2,0,-1,0)
Buy.TextColor3 = BrickColor.new(&quot;Earth green&quot;).Color
Buy.FontSize = &quot;Size18&quot;
Buy.Text = &quot;Buy - 1000 Robux&quot;
Buy.BackgroundColor3 = BrickColor.new(&quot;Bright yellow&quot;).Color
Buy.MouseButton1Click:connect(function()
if game.Players[script.Parent.Name].leaderstats.Robux.Value &gt;= Items[CurrentItem].Cost.Value then
if game.Players[script.Parent.Name]:FindFirstChild(Items[CurrentItem].ItemName.Value .. &quot;Count&quot;) ~= nil then

--[[
if game.Players[script.Parent.Name]:FindFirstChild(Items[CurrentItem].ItemName.Value .. &quot;Count&quot;).Value &lt; Items[CurrentItem].MaxUpgrades.Value then
game.Players[script.Parent.Name]:FindFirstChild(Items[CurrentItem].ItemName.Value .. &quot;Count&quot;).Value = game.Players[script.Parent.Name]:FindFirstChild(Items[CurrentItem].ItemName.Value .. &quot;Count&quot;).Value + 1

game.Players[script.Parent.Name].leaderstats.Robux.Value = game.Players[script.Parent.Name].leaderstats.Robux.Value - Items[CurrentItem].Cost.Value
loadstring(Items[CurrentItem].Functionality.Value)()

Buy.BackgroundColor3 = BrickColor.new(&quot;Deep blue&quot;).Color
delay(.3,function()
Buy.BackgroundColor3 = BrickColor.new(&quot;Bright yellow&quot;).Color
end)
--]]

fx = Buy.Text
Buy.Text = &quot;You already own this item!&quot;

wait(2)

if Buy.Text == &quot;You already own this item!&quot; then
Buy.Text = &quot;Loading...&quot;
end

else
siv=Instance.new(&quot;IntValue&quot;)
siv.Parent = game.Players[script.Parent.Name]
siv.Value = 1
siv.Name = Items[CurrentItem].ItemName.Value .. &quot;Count&quot;

CST=game.Lighting.SubtractCost:clone()
CST.Name = Items[CurrentItem].Cost.Value
--CST.Cost.Value=Items[CurrentItem].Cost
CST.Parent=game.Players.LocalPlayer.Backpack


--game.Players[script.Parent.Name].leaderstats.Robux.Value = game.Players[script.Parent.Name].leaderstats.Robux.Value - Items[CurrentItem].Cost.Value
loadstring(Items[CurrentItem].Functionality.Value)()

Buy.BackgroundColor3 = BrickColor.new(&quot;Deep blue&quot;).Color
delay(.3,function()
Buy.BackgroundColor3 = BrickColor.new(&quot;Bright yellow&quot;).Color
end)

end

else
fx = Buy.Text
Buy.Text = &quot;You do not have enough Robux to pay for this&quot;

wait(2)

if Buy.Text == &quot;You do not have enough Robux to pay for this&quot; then
Buy.Text = &quot;Loading...&quot;
end

end
end)

delay(0,function()
while true do
wait()

if (Buy.Text ~= &quot;You do not have enough Robux to pay for this&quot;) and (Buy.Text ~= &quot;You already own this item!&quot;) then
Buy.Text = &quot;Buy - &quot; .. Items[CurrentItem].Cost.Value .. &quot; Robux&quot;
end

desc.Text = Items[CurrentItem].ItemName.Value .. &quot; - &quot; .. Items[CurrentItem].Cost.Value .. &quot; Robux&quot; .. [[

Description: ]] .. Items[CurrentItem].Description.Value

end
end)

Close=Instance.new(&quot;TextButton&quot;)
Close.Parent = desc
Close.Size = UDim2.new(.1,0,1,0)
Close.Position = UDim2.new(.9,0,-1,0)
Close.TextColor3 = BrickColor.new(&quot;Institutional white&quot;).Color
Close.FontSize = &quot;Size18&quot;
Close.Text = &quot;X&quot;
Close.BackgroundColor3 = BrickColor.new(&quot;Bright red&quot;).Color
Close.MouseButton1Click:connect(function()
sg:Remove()
--workspace.CurrentCamera.CameraSubject = script.Parent.Humanoid
workspace.CurrentCamera.CameraType = &quot;Custom&quot;
bv=Instance.new(&quot;BoolValue&quot;)
bv.Parent = script.Parent
bv.Name = script.Name
script.Parent.Humanoid.WalkSpeed = 20
game:GetService(&quot;Debris&quot;):AddItem(bv,5)
script:Remove()
end)

script.Changed:connect(function()
if script.Name~=&quot;ShopScript&quot; then
sg:Remove()
--workspace.CurrentCamera.CameraSubject = script.Parent.Humanoid
workspace.CurrentCamera.CameraType = &quot;Custom&quot;
bv=Instance.new(&quot;BoolValue&quot;)
bv.Parent = script.Parent
bv.Name = script.Name
script.Parent.Humanoid.WalkSpeed = 20
game:GetService(&quot;Debris&quot;):AddItem(bv,5)
script:Remove()
end
end)

script.Parent.ChildAdded:connect(function(c)
if c.Name == &quot;CloseShop&quot; then
sg:Remove()
workspace.CurrentCamera.CameraSubject = script.Parent.Humanoid
workspace.CurrentCamera.CameraType = &quot;Custom&quot;
bv=Instance.new(&quot;BoolValue&quot;)
bv.Parent = script.Parent
bv.Name = script.Name
script.Parent.Humanoid.WalkSpeed = 20
game:GetService(&quot;Debris&quot;):AddItem(bv,5)
script:Remove()
end
end)

Left.MouseButton1Click:connect(function()
if CurrentItem -1 &gt; 0 then
CurrentItem = CurrentItem - 1
--CamPart.Anchored = false
--bp.position = Items[CurrentItem].Position
delay(1.5,function()
--CamPart.Anchored = true
end)
end
end)

Right=Instance.new(&quot;TextButton&quot;)
Right.Parent = desc
Right.Size = UDim2.new(.1,0,1,0)
Right.Position = UDim2.new(.9,0,0,0)
Right.TextColor3 = BrickColor.new(&quot;Really black&quot;).Color
Right.FontSize = &quot;Size18&quot;
Right.Text = &quot;-&gt;&quot;
Right.BackgroundColor3 = BrickColor.new(&quot;New Yeller&quot;).Color

Right.MouseButton1Click:connect(function()
if CurrentItem +1 &lt; #Items+1 then
CurrentItem = CurrentItem + 1
--CamPart.Anchored = false
--bp.position = Items[CurrentItem].Position
delay(1.5,function()
--CamPart.Anchored = true
end)
end
end)

Items = {}

for i = 1,#workspace:GetChildren() do
if workspace:GetChildren()[i].Name == &quot;ShopItem&quot; then
if workspace:GetChildren()[i]:findFirstChild(&quot;Cost&quot;) then
table.insert(Items,workspace:GetChildren()[i])
end
end
end



ZoomV = 3

--workspace.CurrentCamera.CameraSubject = CamPart
workspace.CurrentCamera.CameraType = &quot;Scriptable&quot;
delay(0,function()
while true do
for i = 1,360 do
workspace.CurrentCamera.CoordinateFrame = CFrame.new(Vector3.new(0,1,0)+(Items[CurrentItem].Position+(Items[CurrentItem].CFrame * CFrame.fromEulerAnglesXYZ(0,math.rad(i),0)).lookVector*-3),(Items[CurrentItem].Position))
wait()
end
wait()
end
end)</ProtectedString>
							</Properties>
						</Item>
					</Item>
					<Item class="DialogChoice" referent="RBX4006">
						<Properties>
							<string name="Name">DialogChoice</string>
							<string name="ResponseDialog">Okay i&apos;ll show you what i&apos;ve got in stock</string>
							<string name="UserDialog">Yes</string>
						</Properties>
					</Item>
					<Item class="DialogChoice" referent="RBX4007">
						<Properties>
							<string name="Name">DialogChoice</string>
							<string name="ResponseDialog">THEN WHY ARE YOU WASTING MY TIME?!?</string>
							<string name="UserDialog">No</string>
						</Properties>
					</Item>
				</Item>
			</Item>
			<Item class="Part" referent="RBX4008">
				<Properties>
					<bool name="Anchored">true</bool>
					<float name="BackParamA">-0.5</float>
					<float name="BackParamB">0.5</float>
					<token name="BackSurface">0</token>
					<token name="BackSurfaceInput">0</token>
					<float name="BottomParamA">-0.5</float>
					<float name="BottomParamB">0.5</float>
					<token name="BottomSurface">0</token>
					<token name="BottomSurfaceInput">0</token>
					<int name="BrickColor">194</int>
					<CoordinateFrame name="CFrame">
						<X>692.500793</X>
						<Y>208.606598</Y>
