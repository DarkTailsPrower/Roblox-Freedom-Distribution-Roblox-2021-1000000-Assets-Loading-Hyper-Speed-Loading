			<Item class="Script" referent="RBX5720">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Control</string>
					<ProtectedString name="Source">--Target = workspace.ExpressScripter.Torso

RandomPart=workspace.Director

-- Script By ExpressScripter

Still=false
Stuck=false

script.Parent.Zombie.Running:connect(function(Speed)
if Speed==0 then
Still=true
end
end)

delay(0,function()

LastPosition=Vector3.new()

while true do
wait(1)


if (script.Parent.Torso.Position-LastPosition).magnitude&lt;1 then -- Yes it is stuck or not after 5 secs

--script.Parent.Zombie:MoveTo(script.Parent.Torso.Position + script.Parent.Torso.CFrame.lookVector*-5, RandomPart)

--script.Parent.Zombie.WalkSpeed=-script.Parent.Zombie.WalkSpeed

script.Parent.Zombie.Jump=true

Stuck=true

wait(3)

--script.Parent.Zombie.WalkSpeed=script.Parent.Zombie.WalkSpeed

end

LastPosition=script.Parent.Torso.Position


end

end)

script.Parent.ControlPoint.Value=Vector3.new()

CustomPointOn=false
CustomPoint=Vector3.new()

script.Parent.ControlPoint.Changed:connect(function()

if script.Parent.ControlPoint.Value == Vector3.new() then

CustomPointOn=false

else

CustomPointOn=true
CustomPoint=script.Parent.ControlPoint.Value

end

end)


function CalculatePath(Targ)

PathPoints = {}

CurrentPosition = script.Parent.Torso.Position

Farthest = 0
FarthestVector=nil
FarthestPart=nil

--[[
p=Instance.new(&quot;Part&quot;)
p.Parent=workspace.ExpressScripter
p.Anchored=true

px=Instance.new(&quot;Part&quot;)
px.Parent=workspace.ExpressScripter
px.Anchored=true
--]]


for i = 1,10 do

x,y,z=script.Parent.Torso.CFrame:toEulerAnglesXYZ()
y=y+math.rad(i*9)

--print(tostring(CFrame.Angles(x,y,z).lookVector*500))


--px.CFrame=script.Parent.Torso.CFrame+CFrame.Angles(x,y,z).lookVector*15

Part,Position=workspace:FindPartOnRay(Ray.new(script.Parent.Torso.Position, CFrame.Angles(x,y,z).lookVector*100 ),workspace.Zombies)

--print(&quot;Mag: &quot; .. tostring((Position-script.Parent.Torso.Position).magnitude))

--p.CFrame=CFrame.new(Position)

if ((Position-script.Parent.Torso.Position).magnitude &gt; Farthest) and (Part~=nil) then
Farthest = (Position-script.Parent.Torso.Position).magnitude
FarthestVector=Position
FarthestPart=Part
end


end



for i = 1,10 do

x,y,z=script.Parent.Torso.CFrame:toEulerAnglesXYZ()
y=y+math.rad(-i*9)

--print(tostring(CFrame.Angles(x,y,z).lookVector*500))


--px.CFrame=script.Parent.Torso.CFrame+CFrame.Angles(x,y,z).lookVector*15

Part,Position=workspace:FindPartOnRay(Ray.new(script.Parent.Torso.Position, CFrame.Angles(x,y,z).lookVector*100 ),workspace.Zombies)

--print(&quot;Mag: &quot; .. tostring((Position-script.Parent.Torso.Position).magnitude))

--p.CFrame=CFrame.new(Position)

if ((Position-script.Parent.Torso.Position).magnitude &gt; Farthest) and (Part~=nil) then
Farthest = (Position-script.Parent.Torso.Position).magnitude
FarthestVector=Position
FarthestPart=Part
end


end


--print(FarthestPart.Name)
--px.CFrame=CFrame.new(FarthestVector)
script.Parent.Zombie:MoveTo(FarthestVector, FarthestPart)


Still=false

repeat wait(.3) script.Parent.Zombie:MoveTo(FarthestVector, FarthestPart) until ((script.Parent.Torso.Position-FarthestVector).magnitude &lt; 10) or (Still==true) or (CustomPointOn==true) or (Stuck==true)

if Stuck==true then

script.Parent.Zombie:MoveTo(script.Parent.Torso.Position+script.Parent.Torso.CFrame.lookVector*-8, FarthestPart)
wait(3)
Stuck=false
end

if CustomPointOn==true then



repeat script.Parent.Zombie:MoveTo(CustomPoint, RandomPart) wait(.3) until (CustomPointOn==false) or (((script.Parent.Torso.Position-CustomPoint).magnitude &lt; 5))

CustomPointOn=false
script.Parent.ControlPoint.Value=Vector3.new()

end

end

while true do
wait(.1)
CalculatePath()
end

--script.Parent.Zombie:MoveTo(target.Position, target)
</ProtectedString>
