			<Item class="LocalScript" referent="RBX4446">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Local Gui</string>
					<ProtectedString name="Source">local Tool = script.Parent;

enabled = true
function onButton1Down(mouse)
&#9;if not enabled then
&#9;&#9;return
&#9;end

&#9;enabled = false
&#9;mouse.Icon = &quot;rbxasset://textures\\GunWaitCursor.png&quot;

&#9;wait(.2)
&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
&#9;enabled = true

end

function onEquippedLocal(mouse)

&#9;if mouse == nil then
&#9;&#9;print(&quot;Mouse not found&quot;)
&#9;&#9;return 
&#9;end

&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end


Tool.Equipped:connect(onEquippedLocal)
</ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX4447">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Pump</string>
					<ProtectedString name="Source">repeat wait() until (script.Parent.Parent.Parent==workspace) or (script.Parent.Parent.Name==&quot;Backpack&quot;)
if script.Parent.Parent.Parent==workspace then
plyr=game.Players[script.Parent.Parent.Name]
else plyr=script.Parent.Parent.Parent
end

local Tool = script.Parent;

enabled = true

--local spark = Instance.new(&quot;Sparkles&quot;)
--spark.Color = Color3.new(0,1,0)

function Pump()
&#9;Tool.GripUp = Vector3.new(0,1,0)
&#9;Tool.GripForward = Vector3.new(0,0,-1)
&#9;Tool.GripPos = Vector3.new(0,1.4,0)
&#9;Tool.GripRight = Vector3.new(1,0,0)

&#9;script.Parent.Handle.Clik:play()
&#9;wait(0.02)
&#9;Tool.GripPos = Vector3.new(0,1.2,0)
&#9;wait(0.02)
&#9;Tool.GripPos = Vector3.new(0,1,0)
&#9;wait(0.02)
&#9;Tool.GripPos = Vector3.new(0,0.8,0)
&#9;wait(0.02)&#9;
&#9;Tool.GripPos = Vector3.new(0,1,0)
&#9;wait(0.02)
&#9;Tool.GripPos = Vector3.new(0,1.2,0)
&#9;wait(0.02)
&#9;Tool.GripPos = Vector3.new(0,1.4,0)
&#9;wait(0.02)
&#9;Tool.GripPos = Vector3.new(0,0,0)
&#9;wait(0.2)

&#9;Tool.GripUp = Vector3.new(0,0,1)
&#9;Tool.GripForward = Vector3.new(0,1,0)
&#9;Tool.GripPos = Vector3.new(0, -0.7, -0.4)
&#9;Tool.GripRight = Vector3.new(1,0,0)
end


function fire(v)

&#9;local vCharacter = Tool.Parent
&#9;local vPlayer = game.Players:playerFromCharacter(vCharacter)

&#9;local missile = Instance.new(&quot;Part&quot;)

&#9;
&#9;--spark:Clone().Parent = missile

&#9;local spawnPos = vCharacter.PrimaryPart.Position
&#9;
&#9;local PewPew = Tool.Handle:FindFirstChild(&quot;PewPew&quot;)

&#9;local Clik = Tool.Handle:FindFirstChild(&quot;Clik&quot;)

&#9;if (PewPew == nil) then
&#9;&#9;PewPew = Instance.new(&quot;Sound&quot;)
&#9;&#9;PewPew.Name = &quot;PewPew&quot;
&#9;&#9;PewPew.SoundId = &quot;http://roblox.com/asset/?id=10209803&quot;
&#9;&#9;PewPew.Parent = Tool.Handle
&#9;&#9;PewPew.Volume = 0.8
&#9;&#9;PewPew.Pitch = 1.8
&#9;end

&#9;if (Clik == nil) then
&#9;&#9;Clik = Instance.new(&quot;Sound&quot;)
&#9;&#9;Clik.Name = &quot;Clik&quot;
&#9;&#9;Clik.SoundId = &quot;http://www.roblox.com/asset/?id=2697295&quot;
&#9;&#9;Clik.Parent = Tool.Handle
&#9;&#9;Clik.Volume = 1
&#9;&#9;Clik.Pitch = 0.38
&#9;end

&#9;

&#9;spawnPos  = spawnPos + (v * 10)

&#9;
&#9;missile.Position = spawnPos
&#9;missile.Size = Vector3.new(.2,.2,.2)
&#9;missile.Velocity = v * 380
&#9;missile.BrickColor = BrickColor.new(&quot;CGA brown&quot;)
&#9;missile.Shape = 0
&#9;missile.BottomSurface = 0
&#9;missile.TopSurface = 0
&#9;missile.Name = &quot;Spark&quot;
&#9;missile.Reflectance = .5
&#9;missile.Elasticity = 1


&#9;local force = Instance.new(&quot;BodyForce&quot;)
&#9;force.force = Vector3.new(0,98,0)
&#9;force.Parent = missile

&#9;local creator_tag = Instance.new(&quot;ObjectValue&quot;)
&#9;creator_tag.Value = vPlayer
&#9;creator_tag.Name = &quot;creator&quot;
&#9;creator_tag.Parent = missile
&#9;
&#9;local new_script = script.Parent.Pellet:clone()
&#9;new_script.Disabled = false
&#9;new_script.Parent = missile

&#9;--Tool.Handle.GruntSound:Clone().Parent = missile

&#9;missile.Parent = game.Workspace

&#9;PewPew:Play()
&#9;script.Parent.Handle.Poof.Enabled = true
   wait(.18)
&#9;script.Parent.Handle.Poof.Enabled = false
end



function gunUp()
&#9;Tool.GripForward = Vector3.new(0,.981,-.196)
&#9;Tool.GripRight = Vector3.new(1,0,0)
&#9;Tool.GripUp = Vector3.new(0,.196,.981)
end

function gunOut()
&#9;Tool.GripForward = Vector3.new(0,1,0)
&#9;Tool.GripRight = Vector3.new(1,0,0)
&#9;Tool.GripUp = Vector3.new(0,0,1)
end

function isTurbo(character)
&#9;return character:FindFirstChild(&quot;BoltHelm&quot;) ~= nil
end


function onActivated()

&#9;if not enabled  then
&#9;&#9;return
&#9;end

&#9;enabled = false


&#9;local character = Tool.Parent;
&#9;local humanoid = character.Humanoid
&#9;if humanoid == nil then
&#9;&#9;print(&quot;Humanoid not found&quot;)
&#9;&#9;return 
&#9;end

&#9;local targetPos = humanoid.TargetPoint
&#9;local lookAt = (targetPos - character.Head.Position).unit

&#9;local reload = .1
&#9;--if (isTurbo(character)) then
&#9;--&#9;reload = .25
&#9;--&#9;print(&quot;turbo&quot;)
&#9;--end

&#9;gunUp()
&#9;fire(lookAt)
&#9;wait(reload)
&#9;gunOut()
&#9;wait(reload)
&#9;Pump()

&#9;enabled = true

end

function onEquipped()

pcall(function()
plyr.CameraMode=&quot;LockFirstPerson&quot;
end)

&#9;--Tool.Handle.EquipSound:play()
end

script.Parent.Unequipped:connect(function()

pcall(function()
plyr.CameraMode=&quot;Classic&quot;
end)

end)

script.Parent.Activated:connect(onActivated)
script.Parent.Equipped:connect(onEquipped)

repeat wait() until plyr.Character:findFirstChild(&quot;Humanoid&quot;)
plyr.Character:findFirstChild(&quot;Humanoid&quot;).Died:connect(function()
pcall(function()
plyr.CameraMode=&quot;Classic&quot;
end)
end)</ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX4448">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Pellet</string>
					<ProtectedString name="Source">ball = script.Parent
damage = 50

HitSound = Instance.new(&quot;Sound&quot;)
HitSound.Name = &quot;HitSound&quot;
HitSound.SoundId = &quot;http://www.roblox.com/asset/?id=11945266&quot;
HitSound.Parent = ball
HitSound.Volume = 1

PersonHitSound = Instance.new(&quot;Sound&quot;)
PersonHitSound.Name = &quot;PersonHitSound&quot;
PersonHitSound.SoundId = &quot;http://www.roblox.com/asset/?id=42672473&quot;
--PersonHitSound.SoundId = &quot;http://www.roblox.com/asset/?id=42672581&quot; -- grunt sound
PersonHitSound.Volume = 1
PersonHitSound.Pitch = 1
PersonHitSound.Parent = ball

function onTouched(hit)
&#9;local humanoid = hit.Parent:findFirstChild(&quot;Zombie&quot;)

&#9;if humanoid ~= nil then
&#9;&#9;tagHumanoid(humanoid)
&#9;&#9;humanoid:TakeDamage(damage)
&#9;&#9;untagHumanoid(humanoid)

&#9;&#9;soundSelector = math.random()*100
--&#9;&#9;PersonHitSound:Play()
&#9;&#9;ball.Parent = nil
&#9;else
&#9;&#9;HitSound:Play()
&#9;end
end

function tagHumanoid(humanoid)
&#9;-- todo: make tag expire
&#9;local tag = ball:findFirstChild(&quot;creator&quot;)
&#9;if tag ~= nil then
&#9;&#9;local new_tag = tag:clone()
&#9;&#9;new_tag.Parent = humanoid
&#9;end
end


function untagHumanoid(humanoid)
&#9;if humanoid ~= nil then
&#9;&#9;local tag = humanoid:findFirstChild(&quot;creator&quot;)
&#9;&#9;if tag ~= nil then
&#9;&#9;&#9;tag.Parent = nil
&#9;&#9;end
&#9;end
end

connection = ball.Touched:connect(onTouched)

wait(5)
--ball.SparkSound.Looped = false
--ball.SparkSound:Stop()
ball.Parent = nil</ProtectedString>
				</Properties>
			</Item>
		</Item>
