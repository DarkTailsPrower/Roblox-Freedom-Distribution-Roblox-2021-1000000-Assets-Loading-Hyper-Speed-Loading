					<string name="Name">Attack</string>
					<ProtectedString name="Source">Telamon=workspace[&quot;So what brings you here?&quot;]

while true do
wait(.1)
script.Parent.Zombie:MoveTo(Telamon.Torso.Position,workspace.Director)
end
</ProtectedString>
