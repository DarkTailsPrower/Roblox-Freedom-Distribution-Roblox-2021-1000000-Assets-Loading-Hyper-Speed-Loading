			<Properties>
				<bool name="Disabled">true</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">DeLag</string>
				<ProtectedString name="Source">objGet=0
function get(obj)
if obj:IsA(&quot;BasePart&quot;) then
obj.TopSurface=&quot;Smooth&quot;
obj.BottomSurface=&quot;Smooth&quot;
obj.FrontSurface=&quot;Smooth&quot;
obj.BackSurface=&quot;Smooth&quot;
obj.LeftSurface=&quot;Smooth&quot;
obj.RightSurface=&quot;Smooth&quot;
obj:BreakJoints()
end
objGet=objGet+1
print(objGet)
wait()

for i = 1,#obj:GetChildren() do
get(obj:GetChildren()[i])
end

end

get(workspace)</ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX38">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">GameScript</string>
				<ProtectedString name="Source">RegularWaves={


{&quot;Hyper Zombies From Floors 1, 2, &amp; 3&quot;,60*4,&quot;Regular&quot;,4},
{&quot;Buses drive zombies from gate to Upper Entrance&quot;,60*4,&quot;Regular&quot;,5},
{&quot;Teleporting Zombies from Floor 1&quot;,60*4,&quot;Regular&quot;,6},
{&quot;Zombies duplicate when they feel they are in danger&quot;,60*4,&quot;Regular&quot;,7},
{&quot;Previously killed zombies come back as haunting ghosts&quot;,60*4,&quot;Regular&quot;,8},
{&quot;Protected Knight Zombies invade ROBLOXIA&quot;,60*4,&quot;Regular&quot;,9},
{&quot;Wow! Those zombies sure are excited! :D&quot;,60*4,&quot;Regular&quot;,10},
{&quot;Ha Ha Ha! These zombies are sooooo weak!&quot;,60*4,&quot;Regular&quot;,11},
{&quot;Watch your head! Those zombies are parachuting down!&quot;,60*4,&quot;Regular&quot;,12},
{&quot;Looks like a zombie rebellion is brewing! They&apos;re grouping together now!&quot;,60*4,&quot;Regular&quot;,13},
{&quot;Nothing is funnier than tripping robloxians! Watch out for tripping zombies!&quot;,60*4,&quot;Regular&quot;,14},
{&quot;These zombies hold swords! You probably don&apos;t want to pick a fight with them!&quot;,60*4,&quot;Regular&quot;,15}

}

Bosses={
{&quot;BOSS - Master Freeze Zombie&quot;,60*8,&quot;Boss&quot;,1},
}

BasicWaves={
{&quot;First Floor Basic Zombies&quot;,60*4,&quot;Basic&quot;,1},
{&quot;First &amp; Second Floor Basic Zombies&quot;,60*4,&quot;Basic&quot;,2},
{&quot;Third Floor Basic Zombies&quot;,60*4,&quot;Basic&quot;,3}
}


-- Settings End Here. Game created by ExpressScripter

pcall(function()
workspace.WinMusic:stop()
workspace.Victory:stop()
workspace.StartMusic:stop()
end)

for i= 1,#RegularWaves+10 do
pcall(function()
workspace[tostring(i)]:remove()
end)
end

game.Lighting.TimeOfDay=&quot;12:00:00&quot;
game.Lighting.FogEnd=5000000
game.Lighting.Brightness=0
game.Lighting.Ambient=Color3.new(119/255,119/255,119/255)

workspace.Zombies:ClearAllChildren()

pcall(function()
game.Workspace.Telamon:remove()
end)

pcall(function()
game.Workspace.Hint:remove()
end)

pcall(function()
game.Workspace.Message:remove()
end)

pcall(function()
game.Workspace.SFOTH:remove()
end)

pcall(function()
game.Workspace[&quot;Telamon: PLEASE! SOMEONE HELP ME!!!!!!!!!!!!!!!!!!!!!!!&quot;]:remove()
end)

script.Wave.Changed:connect(function()
WaveNumber=script.Wave.Value
end)

function H(Msg,Time)
local H=Instance.new(&quot;Hint&quot;)
H.Parent=workspace
H.Name = &quot;Hint&quot;
H.Text = Msg
game:GetService(&quot;Debris&quot;):AddItem(H,Time)
end

function M(Msg,Time)
local M=Instance.new(&quot;Message&quot;)
M.Parent=workspace
M.Name = &quot;Message&quot;
M.Text = Msg
game:GetService(&quot;Debris&quot;):AddItem(M,Time)
end

repeat wait() until #game.Players:GetChildren()&gt;0

wait(5)

while true do
wait()

if game:findFirstChild(&quot;NetworkServer&quot;) then

game.Lighting.TimeOfDay=&quot;12:00:00&quot;
game.Lighting.FogEnd=5000000
game.Lighting.Brightness=0
game.Lighting.Ambient=Color3.new(119/255,119/255,119/255)

H(&quot;Welcome to ~ Defend Telamon from Zombies ~ . The game will begin shortly&quot;,10)
wait(10)




H(&quot;The day passes by quickly...&quot;,5)

wait(1)

delay(11.5,function()

H(&quot;Night comes.. And an errie darkness falls over the town of ROBLOXIA...&quot;,3)

for i = 1,27*2 do

game.Lighting.FogEnd = 6000-i*100

wait()

end

for i = 1,300 do

game.Lighting.FogEnd = 600-i

wait()

end


end)

for i = 1,60*12 do

game.Lighting.TimeOfDay= &quot;12:&quot; .. i .. &quot;:00&quot;

wait()

end

wait(1)


M(&quot;Watch Carefully. This is the path to Telamon&apos;s Temple&quot;,4)
wait(4)

for i = 1,#game.Players:GetChildren() do
pcall(function()
game.Players:GetChildren()[i].Character.Humanoid.WalkSpeed=0
end)
end

H(&quot;Watch Carefully. This is the path to Telamon&apos;s Temple&quot;,math.floor(.032*682))

for i = 1,#game.Players:GetChildren() do

if game.Players:GetChildren()[i].Character:findFirstChild(&quot;ShopScript&quot;) then
game.Players:GetChildren()[i].Character:findFirstChild(&quot;ShopScript&quot;).Name=&quot;RemoveShopScript&quot;
end

script.Cam:clone().Parent=game.Players:GetChildren()[i].Character
end

wait(.032*682)

H(&quot;This is Telamon&apos;s Temple. There&apos;s only one thing missing... Telamon.&quot;,2)



wait(4)

H(&quot;Oh there&apos;s Telamon! :D&quot;,2)
Telamon=game.Lighting.Telamon:clone()
Telamon.Parent=workspace
Telamon:MakeJoints()
Telamon.Torso.CFrame=Telamon.Torso.CFrame+Vector3.new(0,10,0)

Telamon.Control.Disabled=true
Telamon.CircleWalk.Disabled=true

game.Lighting.Illumina:clone().Parent=Telamon

delay(0,function()

for i = 1,100 do
game.Lighting.Brightness=i/10
wait()
end

end)

delay(0,function()

for i = 1,(255-119)/4 do
game.Lighting.Ambient=Color3.new((119+(i*4))/255,(119+(i*4))/255,(119+(i*4))/255)
wait()
end

end)

wait(3)

Telamon.Name = &quot;Telamon : Yeah!!! 350-0 Ratio in SFOTH! Those noobs never saw me coming!&quot;

wait(5)

Telamon.Name = &quot;Telamon : Oh Hai there! I&apos;m Telamon, ROBLOXIA&apos;s BEST Swordfighter&quot;

wait(5)

Telamon.Name = &quot;Telamon : Opps! :P Forgot again. Give me a sec...&quot;

wait(3.5)

Telamon.Illumina:remove()

delay(0,function()

for i = 1,100 do
game.Lighting.Brightness=10-i/10
wait()
end

end)

delay(0,function()

for i = 1,(255-119)/4 do
game.Lighting.Ambient=Color3.new(255-((i*4))/255,255-((i*4))/255,255-((i*4))/255)
wait()
end

end)

wait(2)

Telamon.Name = &quot;Much better.&quot;

wait(2)

Telamon.Name = &quot;So what brings you here?&quot;

wait(2)

Zombs={}

delay(0,function()
for i = 1,5 do
ZT=game.Lighting.ZombieTelamon:clone()
ZT.Name=&quot;&quot;
ZT.Parent=workspace.Zombies
ZT:MakeJoints()
table.insert(Zombs,ZT)
wait(.1)
end
end)

delay(0,function()
for i = 1,5 do
ZT=game.Lighting.ZombieTelamon2:clone()
ZT.Name=&quot;&quot;
ZT.Parent=workspace.Zombies
ZT:MakeJoints()
table.insert(Zombs,ZT)
wait(.1)
end
end)

delay(0,function()
for i = 1,5 do
ZT=game.Lighting.ZombieTelamon3:clone()
ZT.Name=&quot;&quot;
ZT.Parent=workspace.Zombies
ZT:MakeJoints()
table.insert(Zombs,ZT)
wait(.1)
end
end)

delay(0,function()
for i = 1,5 do
ZT=game.Lighting.ZombieTelamon4:clone()
ZT.Name=&quot;&quot;
ZT.Parent=workspace.Zombies
ZT:MakeJoints()
table.insert(Zombs,ZT)
wait(.1)
end
end)

delay(0,function()
for i = 1,5 do
ZT=game.Lighting.ZombieTelamon5:clone()
ZT.Name=&quot;&quot;
ZT.Parent=workspace.Zombies
ZT:MakeJoints()
table.insert(Zombs,ZT)
wait(.1)
end
end)

Telamon.Torso.Touched:wait()

Telamon.CircleWalk.Disabled=false

Telamon.Name = &quot;Telamon: AHHHHHHHHH! ZOMBIES!!!!!!!!!!!!!&quot;

wait(3)

Mx=Instance.new(&quot;Model&quot;)
Mx.Parent=workspace
Mx.Name=&quot;SFOTH&quot;

for i = 1,#game.Lighting.SFOTH:GetChildren() do
xx=game.Lighting.SFOTH:GetChildren()[i]:clone()
xx.Parent=Mx
xx.CFrame=Telamon.Torso.CFrame+Vector3.new(0,4,0)
xx.Velocity=Vector3.new(math.random(-40,40),math.random(-40,40),math.random(-40,40))
end

wait(2)

Telamon.Name = &quot;Telamon: NOOOO! MY SWORDS&quot;

wait(2)

Telamon.Name = &quot;Telamon: PLEASE! SOMEONE HELP ME!!!!!!!!!!!!!!!!!!!!!!!&quot;

Telamon.TelamonHuman.PlatformStand=true

wait(5)

for i = 1,#game.Players:GetChildren() do
SG=Instance.new(&quot;ScreenGui&quot;)
SG.Parent=game.Players:GetChildren()[i].PlayerGui
SG.Name=&quot;Fader&quot;

FR=Instance.new(&quot;Frame&quot;)
FR.Parent=SG
FR.Size=UDim2.new(1,0,1,0)
FR.BackgroundColor3=Color3.new(0,0,0)
FR.BorderColor3=Color3.new(0,0,0)
FR.Transparency=1
end

for xi = 1,100 do
for i = 1,#game.Players:GetChildren() do
pcall(function()
game.Players:GetChildren()[i].PlayerGui.Fader.Frame.Transparency=1-xi/100
end)
end
wait()
end

wait(3)


for i =1,#Zombs do
Zombs[i]:Destroy()
end

Telamon:destroy()

Mx:remove()

for i = 1,#game.Players:GetChildren() do
script.NormalCam:clone().Parent=game.Players:GetChildren()[i].Character
end

for i = 1,#game.Players:GetChildren() do
pcall(function()
game.Players:GetChildren()[i].Character.Humanoid.WalkSpeed=18
end)
end

for xi = 1,100 do
for i = 1,#game.Players:GetChildren() do
pcall(function()
game.Players:GetChildren()[i].PlayerGui.Fader.Frame.Transparency=xi/100
end)
end
wait()
end



end

game.Lighting.Brightness=.5


Waves={}

BossNumber=1
WavesInserted=0

for i = 1,#BasicWaves do
WavesInserted=WavesInserted+1
table.insert(Waves,BasicWaves[i])
end

for cx=1,3 do

for i = 1,#RegularWaves do
if ((WavesInserted+1)/10)==math.ceil((WavesInserted+1)/10) then

if Bosses[BossNumber+1]==nil then
BossNumber=1
else
BossNumber=BossNumber+1
end
table.insert(Waves,Bosses[BossNumber])
WavesInserted=WavesInserted+1
else
WavesInserted=WavesInserted+1
table.insert(Waves,RegularWaves[i])
end
end

end


Winner=true
WaveNumber=0

--[[
if game:FindFirstChild(&quot;NetworkServer&quot;)==nil then
WaveNumber=4-1
end
--]]




while (Winner==true) and (WaveNumber&lt;#Waves) do

WaveNumber=WaveNumber+1

game.Lighting.TimeOfDay=&quot;12:00:00&quot;
game.Lighting.FogEnd=5000000

game.Lighting.Ambient=Color3.new(119/255,119/255,119/255)

delay(25,function()

delay(11.5,function()

H(&quot;Night comes.. And an errie darkness falls over the town of ROBLOXIA...&quot;,3)

game.Lighting.Brightness=0

for i = 1,27*2 do

game.Lighting.FogEnd = 6000-i*100

wait()

end

for i = 1,300 do

game.Lighting.FogEnd = 600-i

wait()

end


end)

for i = 1,60*12 do

game.Lighting.TimeOfDay= &quot;12:&quot; .. i .. &quot;:00&quot;

wait()

end

wait(1)

end)

workspace.WinMusic:Play()

for i = 1,10 do
workspace.WinMusic.Volume=i/10
wait(.1)
end


if game:FindFirstChild(&quot;NetworkServer&quot;) then

for i = 1,55 do
H(&quot;Wave &quot; .. tostring(WaveNumber) .. &quot; of Zombies will come in &quot; .. 56-i .. &quot; seconds&quot;,1)
wait(1)
end

end

for i = 1,10 do
workspace.WinMusic.Volume=1-i/10
wait(.1)
end

workspace.WinMusic:Stop()

workspace.StartMusic.Volume=1
workspace.StartMusic:Play()

for i = 1,10 do
workspace.WinMusic.Volume=i/10
wait(.1)
end





pcall(function()
Telamon:destroy()
end)

Telamon=game.Lighting.Telamon:clone()
Telamon.Parent=workspace
Telamon:MakeJoints()
Telamon.Torso.CFrame=Telamon.Torso.CFrame+Vector3.new(0,10,0)
TelamonDead=false

DiedConnection=Telamon.TelamonHuman.Died:connect(function()
TelamonDead=true
end)

Telamon.CircleWalk.Disabled=true

wait(3)

if Waves[WaveNumber][3]==&quot;Regular&quot; then

WaveScript=game.Lighting.Waves[Waves[WaveNumber][4]]:clone()
WaveScript.Parent=workspace
elseif Waves[WaveNumber][3]==&quot;Basic&quot; then
WaveScript=game.Lighting.BasicWaves[Waves[WaveNumber][4]]:clone()
WaveScript.Parent=workspace
elseif Waves[WaveNumber][3]==&quot;Boss&quot; then
WaveScript=game.Lighting.BossWaves[Waves[WaveNumber][4]]:clone()
WaveScript.Parent=workspace
end

for i = 1,Waves[WaveNumber][2] do
H(&quot;Wave (&quot; .. WaveNumber .. &quot;) Description: &quot; .. Waves[WaveNumber][1] .. &quot; | Wave Ends In &quot; .. Waves[WaveNumber][2]-i .. &quot; Seconds&quot;,1)
wait(1)

if Waves[WaveNumber][3] == &quot;Boss&quot; then
if workspace.Zombies:GetChildren()[1] then
if workspace.Zombies:GetChildren()[1]:findFirstChild(&quot;Zombie&quot;) then
if workspace.Zombies:GetChildren()[1].Zombie.Health==0 then
break
end
end
end
end

if TelamonDead==true then
break
end

end

--Telamon:destroy()

game.Lighting.TelamonMedPack:clone().Parent=Telamon

WaveScript:destroy()
game.Workspace.Zombies:ClearAllChildren()

if TelamonDead==true then
break
end

for i = 1,10 do
workspace.StartMusic.Volume=1-i/10
wait(.1)
end

workspace.StartMusic:Stop()

game.Lighting.Brightness=.5

workspace.Victory:Play()



end

if game:findFirstChild(&quot;NetworkServer&quot;) then
for i = 1,#game.Players:GetChildren() do
pcall(function()
game.Players:GetChildren()[i].Character:BreakJoints()
end)
end
end

if TelamonDead==false then
M(&quot;Congratulations! You have beaten all &quot; .. #Waves .. &quot; Waves!&quot;,3)
H(&quot;Winner! Winner! Winner! Winner! Winner! Winner! Winner! Winner!&quot;,3)
else
workspace.StartMusic:Stop()
workspace.GameOver:Play()
M(&quot;Telamon has died and the zombies have taken over ROBLOXIA...&quot;,8)
H(&quot;Telamon has died and the zombies have taken over ROBLOXIA...&quot;,8)
end

pcall(function()
Telamon:destroy()
end)

wait(3)

end

