		<Item class="Script" referent="RBX4534">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">TripScript</string>
				<ProtectedString name="Source">x=false

script.Parent.Touched:connect(function(c)
if x==true then return end
if c.Parent:findFirstChild(&quot;Humanoid&quot;) then
if c.Parent:findFirstChild(&quot;Torso&quot;) then
x=true

ba=Instance.new(&quot;BodyAngularVelocity&quot;)
ba.Parent=c.Parent.Torso
ba.angularvelocity=Vector3.new(-6,0,0)
ba.maxTorque=Vector3.new(math.huge,0,0)
game:GetService(&quot;Debris&quot;):AddItem(ba,1)
wait(9)

x=false

end
end

end)</ProtectedString>
			</Properties>
