			<Item class="Script" referent="RBX5656">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">CircleWalk</string>
					<ProtectedString name="Source">while true do
wait()

script.Parent.TelamonHuman:MoveTo(Vector3.new(288.609253, 746.115417, 264.318542),workspace.Director)

wait(1.5)

script.Parent.TelamonHuman:MoveTo(Vector3.new(291.661743, 746.115417, 236.415512),workspace.Director)
wait(1.5)

script.Parent.TelamonHuman:MoveTo(Vector3.new(322.347137, 746.115417, 247.079514),workspace.Director)

wait(1.5)


script.Parent.TelamonHuman:MoveTo(Vector3.new(312.242584, 746.115356, 261.918549),workspace.Director)
wait(1.5)

end</ProtectedString>
