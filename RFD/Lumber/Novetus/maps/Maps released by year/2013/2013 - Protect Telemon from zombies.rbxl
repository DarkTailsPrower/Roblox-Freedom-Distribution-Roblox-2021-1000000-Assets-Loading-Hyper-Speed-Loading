&#9;W.C1 = C1
&#9;W.Parent = x
end


while true do
wait(7)

if (#workspace.Zombies:GetChildren() &lt;= 23) and (#workspace.Zombies:GetChildren() &lt; 17) then

New=game.Lighting[&quot;Bus&quot;]:clone()
New.Parent=workspace.Zombies

for i = 1,#New:GetChildren() do
if New:GetChildren()[i]:IsA(&quot;BasePart&quot;) then
Weld(New:GetChildren()[i],New.engine)
end
end

