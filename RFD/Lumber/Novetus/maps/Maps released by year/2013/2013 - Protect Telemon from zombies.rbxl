c:WaitForDataReady()

local Kos=c:LoadNumber(&quot;Kills&quot;)
ldr.Kills.Value=ldr.Kills.Value+Kos
ldr.Robux.Value=ldr.Robux.Value+(Kos*5)

repeat wait() until ldr.Parent:findFirstChild(&quot;PlayerGui&quot;)

print(Kos)

if Kos&gt;0 then
print(&quot;implating&quot;)
wb=game.Lighting.WelcomeBack:clone()
wb.Frame.TextLabel.Text = &quot;I have saved &quot; .. Kos .. &quot; of your kills from last time you played! That&apos;s an extra &quot; .. Kos*5 .. &quot; robux you can play with now!&quot;
wb.Parent=ldr.Parent.PlayerGui
end

end)

workspace.ChildAdded:connect(function(c)

if game.Players:findFirstChild(c.Name)==nil then return end

if c:findFirstChild(&quot;Humanoid&quot;) then

c.Humanoid.WalkSpeed=20

if (string.match ((c.Name), &quot;Guest...&quot;)) ~= nil then
c.Humanoid.MaxHealth=500
c.Humanoid.Health=500
elseif game.Players[c.Name].AccountAge&lt;30*6 then
c.Humanoid.MaxHealth=500
c.Humanoid.Health=500
elseif game.Players[c.Name].AccountAge&lt;30*12 then
c.Humanoid.MaxHealth=400
c.Humanoid.Health=400
elseif game.Players[c.Name].AccountAge&lt;30*30 then
c.Humanoid.MaxHealth=300
c.Humanoid.Health=3000
else
c.Humanoid.MaxHealth=250
c.Humanoid.Health=250
end


end

end)

