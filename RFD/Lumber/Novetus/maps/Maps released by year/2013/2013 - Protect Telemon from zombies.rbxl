				<Item class="Tool" referent="RBX5501">
					<Properties>
						<bool name="CanBeDropped">true</bool>
						<bool name="Enabled">true</bool>
						<CoordinateFrame name="Grip">
							<X>0</X>
							<Y>0</Y>
							<Z>-1.5</Z>
							<R00>0</R00>
							<R01>0</R01>
							<R02>1</R02>
							<R10>1</R10>
