			<Item class="Script" referent="RBX5744">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Attack</string>
					<ProtectedString name="Source">Telamon=workspace[&quot;So what brings you here?&quot;]

for i = 1,#script.Parent:GetChildren() do

if script.Parent:GetChildren()[i]:IsA(&quot;BasePart&quot;) then

script.Parent:GetChildren()[i].Touched:connect(function(x)

if x.Parent:findFirstChild(&quot;TelamonHumanoid&quot;) then

x.Parent.Humanoid:TakeDamage(1)

end

end)

end

end

script.Parent.Zombie:MoveTo(Vector3.new(291.5, 810.1, 281),workspace.Director)

repeat wait() until ((script.Parent.Torso.Position-Vector3.new(291.5, 810.1, 281)).magnitude) &lt; 5

if math.random(1,2) then

script.Parent.Zombie:MoveTo(Vector3.new(341, 744.3, 291.6),workspace.Director)

repeat wait() until ((script.Parent.Torso.Position-Vector3.new(341, 744.3, 291.6)).magnitude) &lt; 5

script.Parent.Zombie:MoveTo(Vector3.new(332.9, 746.2, 271),workspace.Director)


repeat wait() until ((script.Parent.Torso.Position-Vector3.new(332.9, 746.2, 271)).magnitude) &lt; 5

wait(.2)

script.Parent.Zombie.Jump=true


else


script.Parent.Zombie:MoveTo(Vector3.new(254.845184, 744.316895, 252.165955),workspace.Director)

repeat wait() until ((script.Parent.Torso.Position-Vector3.new(254.845184, 744.316895, 252.165955)).magnitude) &lt; 5

script.Parent.Zombie:MoveTo(Vector3.new(266.206726, 746.115356, 246.299118),workspace.Director)


repeat wait() until ((script.Parent.Torso.Position-Vector3.new(266.206726, 746.115356, 246.299118)).magnitude) &lt; 5

wait(.2)

script.Parent.Zombie.Jump=true



end



while true do
wait(.1)
script.Parent.Zombie:MoveTo(Telamon.Torso.Position,workspace.Director)
end
</ProtectedString>
				</Properties>
			</Item>
