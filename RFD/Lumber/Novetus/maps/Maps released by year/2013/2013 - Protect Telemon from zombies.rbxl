			<Item class="Script" referent="RBX4269">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">TelamonMoveDirector</string>
					<ProtectedString name="Source">script.Parent.Touched:connect(function(c)

if c.Parent:findFirstChild(&quot;TelamonHuman&quot;)==nil then return end

if c.Parent:findFirstChild(&quot;ControlPoint&quot;) then



if c.Parent.ControlPoint.Value==Vector3.new() then

c.Parent.ControlPoint.Value=Vector3.new(346.929016, 744.315613, 193.91832)

wait(2)

c.Parent.TelamonHuman.Jump=true

end

end

end)</ProtectedString>
