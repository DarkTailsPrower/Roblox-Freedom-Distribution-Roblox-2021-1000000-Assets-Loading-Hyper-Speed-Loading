								<string name="Name">Script</string>
								<ProtectedString name="Source">repeat wait() until script.Parent.Parent.Parent.Parent.Parent.Parent.Character~=nil

while true do
wait(.1)
if script.Parent.Visible==true then

if script.Parent.Parent.Parent.Parent.Parent.Parent.Character:findFirstChild(&quot;ForceFieldSuper&quot;)==nil then
ff=Instance.new(&quot;ForceField&quot;)
ff.Parent=script.Parent.Parent.Parent.Parent.Parent.Parent.Character
ff.Name=&quot;ForceFieldSuper&quot;
game:GetService(&quot;Debris&quot;):AddItem(ff,25)
end


else

if script.Parent.Parent.Parent.Parent.Parent.Parent.Character:findFirstChild(&quot;ForceFieldSuper&quot;)~=nil then
script.Parent.Parent.Parent.Parent.Parent.Parent.Character:findFirstChild(&quot;ForceFieldSuper&quot;):remove()
end

end
end
