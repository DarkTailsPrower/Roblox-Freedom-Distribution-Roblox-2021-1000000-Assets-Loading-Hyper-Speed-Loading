function AttachHealth(z)

local func=z.Zombie.Changed:connect(function(pro)
if #workspace.Zombies:GetChildren() &lt; 25 then
if (pro==&quot;Health&quot;) and z.Zombie.Health&lt;z.Zombie.MaxHealth-10 then
New=game.Lighting[&quot;Zombie&quot;]:clone()
New.Parent=workspace.Zombies
New.Zombie.MaxHealth=130
New.Zombie.Health=130
New:MakeJoints()
New:MoveTo(z.Torso.Position+z.Torso.CFrame.lookVector*-5)

x=Instance.new(&quot;StringValue&quot;,z)
game:GetService(&quot;Debris&quot;):AddItem(x,1)

wait(1)
delay(0,function()
AttachHealth(z)
end)
delay(1,function()
AttachHealth(New)
end)

end
end
end)

z.ChildAdded:wait()

func:disconnect()

end

while true do
wait(1)

if #workspace.Zombies:GetChildren() &lt; 12 then

New=game.Lighting[&quot;Zombie&quot;]:clone()
New.Parent=workspace.Zombies
New.Zombie.Health=200
New:MakeJoints()
New:MoveTo(ZombieSpawns[math.random(1,#ZombieSpawns)].Position+Vector3.new(0,5,0))

delay(0,function()
AttachHealth(New)
end)

end

end</ProtectedString>
