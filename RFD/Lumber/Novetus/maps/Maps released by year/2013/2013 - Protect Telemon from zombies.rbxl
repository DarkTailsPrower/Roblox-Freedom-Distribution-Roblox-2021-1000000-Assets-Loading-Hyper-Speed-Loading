				<string name="Name">LocalScript</string>
				<ProtectedString name="Source">wait(10)

if game.Players.LocalPlayer:findFirstChild(&quot;VIP_Client&quot;)==nil then
if workspace.CurrentCamera:findFirstChild(&quot;VipDoor&quot;)==nil then
game.Lighting.VipDoor:clone().Parent=workspace.CurrentCamera
end
else
if workspace.CurrentCamera:findFirstChild(&quot;VipDoor&quot;)~=nil then
workspace.CurrentCamera:findFirstChild(&quot;VipDoor&quot;):remove()
end
end</ProtectedString>
