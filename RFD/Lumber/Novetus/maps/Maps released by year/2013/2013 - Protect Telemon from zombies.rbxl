				<Item class="Script" referent="RBX5631">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">while true do
wait()

repeat wait() until (script.Parent.Value==nil) or (script.Parent.Value.Parent==nil)

zg=nil
repeat wait()
for i = 1,#workspace.Zombie:GetChildren() do
workspace.Zombie:GetChildren()[i].Name==&quot;Zombie General&quot; then
zg= workspace.Zombie:GetChildren()[i]
end
end
until zg~=nil

script.Parent.Follow.Value=zg


end
</ProtectedString>
