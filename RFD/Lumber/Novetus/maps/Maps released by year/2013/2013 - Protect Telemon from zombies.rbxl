&#9;&#9;print(&quot;Zombie not found&quot;)
&#9;&#9;return 
&#9;end

&#9;t = r.Stepped:wait()

&#9;if (t - last_attack &lt; .2) then
&#9;&#9;lunge()
&#9;else
&#9;&#9;attack()
&#9;end

&#9;last_attack = t

