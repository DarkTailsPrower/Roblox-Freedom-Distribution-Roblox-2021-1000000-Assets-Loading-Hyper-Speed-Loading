				<Item class="Script" referent="RBX5466">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Regen</string>
						<ProtectedString name="Source">-- Ajedi32

bin = script.Parent

ItemName = &quot;Ice Dagger&quot; -- The name of the item in the stand.
WaitTime = 20 -- The amount of time to wait before regenerating the item.


Item = bin:findFirstChild(ItemName)
backup = Item:clone()

function regen()
&#9;local regen = backup:clone()
&#9;regen.Parent = bin
end

debounce = false
function onTaken(property)
if (debounce == true) then return end
debounce = true
&#9;if (bin:findFirstChild(ItemName) == nil) then
&#9;&#9;wait(WaitTime)
&#9;&#9;regen()
&#9;end
debounce = false
end


Item.Changed:connect(onTaken)</ProtectedString>
					</Properties>
				</Item>
			</Item>
