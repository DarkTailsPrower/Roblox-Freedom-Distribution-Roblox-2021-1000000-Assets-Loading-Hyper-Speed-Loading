			<Item class="Vector3Value" referent="RBX5743">
				<Properties>
					<string name="Name">ControlPoint</string>
					<Vector3 name="Value">
						<X>0</X>
						<Y>0</Y>
						<Z>0</Z>
					</Vector3>
				</Properties>
