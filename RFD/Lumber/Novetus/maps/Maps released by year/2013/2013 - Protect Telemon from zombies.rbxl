				<Item class="Script" referent="RBX4134">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">local ting = 0
script.Parent.Head.Touched:connect(function(hit)
local Human = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
if ting == 0 and Human then
local Pl = game.Players:GetPlayerFromCharacter(hit.Parent)
if Pl.PlayerGui:findFirstChild(&quot;Loading&quot;) == nil then
ting = 1
Human.WalkSpeed = 0
script.Parent.Head.BrickColor = BrickColor.new(&quot;Really black&quot;)
for i=1,7 do
script.Parent.Head.CFrame = script.Parent.Head.CFrame - Vector3.new(0,0.1,0)
wait(0.1)
end
local SG = Instance.new(&quot;ScreenGui&quot;)
local Fr = Instance.new(&quot;Frame&quot;)
local TL = Instance.new(&quot;TextLabel&quot;)
local Ba = Instance.new(&quot;Frame&quot;)
SG.Parent = Pl.PlayerGui
SG.Name = &quot;Loading&quot;
Fr.Parent = SG
Fr.Name = &quot;Background&quot;
Fr.BackgroundColor3 = Color3.new(1,1,1)
Fr.BorderColor3 = Color3.new(0,0,0)
Fr.Size = UDim2.new(0,250,0,100)
Fr.Position = UDim2.new(0.5,-125,0.5,-50)
TL.Parent = Fr
TL.Name = &quot;Heading&quot;
TL.Text = &quot;Loading&quot;
TL.Position = UDim2.new(0.5,0,0,10)
TL.TextColor3 = Color3.new(0,0,0)
Ba.Parent = Fr
Ba.Name = &quot;Bar&quot;
Ba.BorderColor3 = Color3.new(1,1,1)
Ba.BackgroundColor3 = Color3.new(0.35,1,0.2)
Ba.Size = UDim2.new(0,0,1,-30)
Ba.Position = UDim2.new(0,10,0,20)
for i=1,23 do
Ba.Size = Ba.Size + UDim2.new(0,10,0,0)
wait(0.1)
end
SG:Remove()
Human.WalkSpeed = script.Parent.Humanoid.WalkSpeed
wait(3)
for i=1,7 do
script.Parent.Head.CFrame = script.Parent.Head.CFrame + Vector3.new(0,0.1,0)
wait(0.1)
end
script.Parent.Head.BrickColor = BrickColor.new(&quot;Institutional white&quot;)
ting = 0
end end end)</ProtectedString>
					</Properties>
				</Item>
			</Item>
