SpedUp=false

function SpeedUp()
if SpedUp==true then return end
SpedUp=true
for i = 1,#game.Workspace.Zombies:GetChildren() do
workspace.Zombies:GetChildren()[i].Zombie.WalkSpeed=32
end

wait(3)

for i = 1,#game.Workspace.Zombies:GetChildren() do
workspace.Zombies:GetChildren()[i].Zombie.WalkSpeed=10
end

SpedUp=false

end


while true do
wait(.5)

if #workspace.Zombies:GetChildren() &lt; 25 then

New=game.Lighting.Zombie:clone()
New.Parent=workspace.Zombies
New.Zombie.MaxHealth=5
New.Zombie.Health=5
New.Name=&quot;Wimpy Zombie&quot;
New.Zombie.WalkSpeed=10
New.Attack:remove()
nat=game.Lighting.AttackIgnoreRobloxian:clone()
nat.Parent=New
nat.Name=&quot;Attack&quot;
New.Zombie.Died:connect(SpeedUp)
New:MakeJoints()
New:MoveTo(ZombieSpawns[math.random(1,#ZombieSpawns)].Position+Vector3.new(0,5,0))



end

end</ProtectedString>
