						<string name="Name">Weld Breaker</string>
						<ProtectedString name="Source">function onTouched(hit)if hit.Parent.Name == &quot;wheel&quot; thenhit:BreakJoints()
elseif hit.Name == &quot;bodypart&quot; then
hit:BreakJoints()

elseif hit.Name == &quot;engine&quot; then
hit:BreakJoints()end
end

connection = script.Parent.Touched:connect(onTouched)
</ProtectedString>
