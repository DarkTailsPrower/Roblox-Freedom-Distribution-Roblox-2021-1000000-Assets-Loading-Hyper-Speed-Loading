							<ProtectedString name="Source">local pos = script.Parent.Handle.Position

function e()
local player = game.Players:findFirstChild(script.Parent.Parent.Name)
if player ~= nil then
if player.TeamColor == BrickColor.new(&quot;Bright green&quot;) then
local Tool = script.Parent:clone()
script.Parent:remove()
wait(2)
Tool.Parent = game.Workspace
Tool.Handle.Position = pos
Tool.Handle.CanCollide = true
end
end
end

