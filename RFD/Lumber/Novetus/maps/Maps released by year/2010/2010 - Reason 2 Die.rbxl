&#9;gameOn = false
&#9;endgame = false
&#9;local childs = get_players()
&#9;if childs &lt;2 then
&#9;msg.Text = &quot;Two players are at least required to play, please hold..&quot;
&#9;wait(5)
&#9;start()
&#9;else
&#9;killAll()
&#9;wait(10)
&#9;script.GameOn.Value = true
&#9;gameOn = true
&#9;msg.Text = &quot;The zombie apocalypse is coming, no where to run!&quot;
&#9;setup_players()
&#9;msg.Text = &quot;Run from the zombie! He will infect you!&quot;
&#9;wait(3)
&#9;script.GameOn.Value = false
&#9;timedone = MaxTime
&#9;&#9;while true do
&#9;&#9;&#9;if endgame == true then return end
&#9;&#9;&#9;timedone = timedone - 1
&#9;&#9;&#9;msg.Text = &quot;Time til rescue arrives: &quot;..timedone
&#9;&#9;&#9;wait(1)
&#9;&#9;&#9;if timedone == 0 then
&#9;&#9;&#9;&#9;local rescuetype = math.random(1,2)
&#9;&#9;&#9;&#9;if rescuetype == 1 then
&#9;&#9;&#9;&#9;escape = &quot;heli&quot;
&#9;&#9;&#9;&#9;msg.Text = &quot;Rescue is arriving! Hurry to the roof of the office building to get picked up!&quot;
&#9;&#9;&#9;&#9;heli = game.Lighting.Heli:clone()
&#9;&#9;&#9;&#9;heli.Engine.Script.Disabled = false
&#9;&#9;&#9;&#9;heli.Parent = game.Workspace
&#9;&#9;&#9;&#9;heli:MakeJoints()
&#9;&#9;&#9;&#9;break
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;if rescuetype == 2 then
&#9;&#9;&#9;&#9;&#9;escape = &quot;boat&quot;
&#9;&#9;&#9;&#9;&#9;msg.Text = &quot;Rescue is arriving! Hurry to the dock to get picked up!&quot;
&#9;&#9;&#9;&#9;&#9;boat = game.Lighting.Ship:clone()
&#9;&#9;&#9;&#9;&#9;boat.Engine.Script.Disabled = false
&#9;&#9;&#9;&#9;&#9;boat.Parent = game.Workspace
&#9;&#9;&#9;&#9;&#9;boat:MakeJoints()
&#9;&#9;&#9;&#9;&#9;break
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;if endgame == true then return end
&#9;&#9;if escape == &quot;heli&quot; then
&#9;&#9;wait(2)
&#9;&#9;wait(helitime)
&#9;&#9;takeofftime = 60
&#9;&#9;&#9;heli.Engine.State.Value = &quot;stay&quot;
&#9;&#9;&#9;while true do
&#9;&#9;&#9;&#9;takeofftime = takeofftime - 1
&#9;&#9;&#9;&#9;msg.Text = &quot;Im leaving in &quot;..takeofftime..&quot; seconds! Hurry!&quot;
&#9;&#9;&#9;&#9;wait(1)
&#9;&#9;&#9;&#9;if endgame == true then return end
&#9;&#9;&#9;&#9;if takeofftime == 1 then
&#9;&#9;&#9;&#9;heli.Engine.State.Value = &quot;leave&quot;
&#9;&#9;&#9;&#9;msg.Text = &quot;Now Im getting out of this bloxhole!&quot;
&#9;&#9;&#9;&#9;wait(1)
&#9;&#9;&#9;&#9;heli.Engine.State.Value = &quot;leave2&quot;
&#9;&#9;&#9;&#9;break
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;&#9;if endgame == true then return end
&#9;&#9;&#9;leaveScene()
&#9;&#9;&#9;wait(20)
&#9;&#9;end
&#9;&#9;if escape == &quot;boat&quot; then
&#9;&#9;&#9;wait(4.2)
&#9;&#9;&#9;takeofftime = 60
&#9;&#9;&#9;while true do
&#9;&#9;&#9;&#9;takeofftime = takeofftime - 1
&#9;&#9;&#9;&#9;msg.Text = &quot;Im getting out of here in &quot;..takeofftime..&quot; seconds! Move it!&quot;
&#9;&#9;&#9;&#9;wait(1)
&#9;&#9;&#9;&#9;if endgame == true then return end
&#9;&#9;&#9;&#9;if takeofftime == 1 then
&#9;&#9;&#9;&#9;msg.Text = &quot;Alriiight, time to leave these freaks!&quot;
&#9;&#9;&#9;&#9;break
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end&#9;
&#9;&#9;&#9;if endgame == true then return end
&#9;&#9;&#9;leaveScene2()
&#9;&#9;&#9;wait(25)
&#9;&#9;end

&#9;&#9;if heli ~= nil then
&#9;&#9;heli:remove()
&#9;&#9;end
&#9;&#9;if boat ~= nil then
&#9;&#9;boat:remove()
&#9;&#9;end
&#9;&#9;if game.Workspace:findFirstChild(&quot;gameCam&quot;) ~= nil then
&#9;&#9;game.Workspace.gameCam:remove()
&#9;&#9;end
&#9;&#9;if game.Workspace:findFirstChild(&quot;gameCam2&quot;) ~= nil then
&#9;&#9;game.Workspace.gameCam2:remove()
&#9;&#9;end
&#9;&#9;if game.Workspace:findFirstChild(&quot;Peices&quot;) ~= nil then
&#9;&#9;game.Workspace.Peices:remove()
&#9;&#9;end

&#9;end
end




function start2()
