						<string name="Name">Script</string>
						<ProtectedString name="Source">var = 0
x = 3
time = 34
posNumber = 200
while true do
wait(0.1)
var = var + 1
if var &lt;posNumber then
script.Parent.BodyPosition.position = script.Parent.BodyPosition.position + Vector3.new(0,0,3)
end
if var == posNumber then
script.Parent.BodyPosition.position = Vector3.new(163, 44.6, 187)
wait(time)
local c = script.Parent.Parent.Doors:GetChildren()
for i = 1,#c do
c[i].CanCollide = true
c[i].Transparency = 0
end
end
if var &gt; posNumber then
script.Parent.BodyPosition.position = script.Parent.BodyPosition.position + Vector3.new(0,0,x)
x = x + 0.03
end
end
</ProtectedString>
