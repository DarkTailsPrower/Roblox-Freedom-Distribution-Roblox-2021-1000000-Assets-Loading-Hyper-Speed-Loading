&#9;&#9;&#9;&#9;&#9;takeofftime = takeofftime - 1
&#9;&#9;&#9;&#9;&#9;msg.Text = &quot;The train will depart in &quot;..takeofftime..&quot; seconds! Deffend my train booy!&quot;
&#9;&#9;&#9;&#9;&#9;wait(1)
