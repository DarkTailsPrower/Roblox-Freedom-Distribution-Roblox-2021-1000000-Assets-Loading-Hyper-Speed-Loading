			<Item class="Script" referent="RBX441">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">placed = false
var = 14
function touched(hit)
&#9;if placed == false then
&#9;placed = true
&#9;local orginPosition = script.Parent.Position
&#9;script.Parent.CanCollide = false
&#9;script.Parent.BodyForce.force = Vector3.new(0,500,0)
&#9;&#9;while true do
&#9;&#9;wait(0.7)
&#9;&#9;&#9;if script.Parent == nil then return end
&#9;&#9;script.Parent.Velocity = Vector3.new(0,0,0)
&#9;&#9;script.Parent.Position = orginPosition
&#9;&#9;var = var - 1
&#9;&#9;&#9;if var == 0 then
&#9;&#9;&#9;script.Parent:remove()
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;if hit.Parent:FindFirstChild(&quot;Zombie&quot;) ~= nil then
&#9;hit.Parent.Zombie.Health = hit.Parent.Zombie.Health - 3
&#9;end
&#9;if hit.Parent:FindFirstChild(&quot;Humanoid&quot;) ~= nil then
&#9;hit.Parent.Humanoid.Health = hit.Parent.Humanoid.Health - 3
&#9;end
end

wait(0.8)
script.Parent.Touched:connect(touched)</ProtectedString>
				</Properties>
