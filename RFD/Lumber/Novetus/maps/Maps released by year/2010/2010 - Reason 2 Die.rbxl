--CONNECTIONS

game.Players.ChildAdded:connect(added)
game.Workspace.ChildAdded:connect(spwn)
game.Workspace.ChildRemoved:connect(leave)


--Start it all


while true do

msg.Text = &quot;Loading Forbidden Waters by JohnBricker, please hold!&quot;
wait(1)
local map6 = game.Lighting.ForbiddenWaters:clone()
map6.Parent = game.Workspace
map6:MakeJoints()
wait()
wait(1)
setSpawns(&quot;ForbiddenWaters&quot;)

local max = 10
for i = 1,10 do
msg.Text = &quot;Next game starts in &quot;..max
max = max - 1
wait(1)
end
Map_6()
map6:remove()
&#9;&#9;local surv = find_survivors6()
&#9;&#9;if surv ~= &quot;&quot; and surv ~= nil then
&#9;&#9;&#9;msg.Text = &quot;The survivors are: &quot;..surv
&#9;&#9;&#9;script.Victory:Play()
&#9;&#9;&#9;ShowWinners()
&#9;&#9;else
&#9;&#9;&#9;msg.Text = &quot;GAME OVER&quot;
&#9;&#9;&#9;showGO()&#9;
&#9;&#9;end
&#9;&#9;if game.Workspace:findFirstChild(&quot;Heli2&quot;) ~= nil then
&#9;&#9;game.Workspace.Heli2:remove()
&#9;&#9;end
&#9;&#9;if game.Workspace:findFirstChild(&quot;gameCam5&quot;) ~= nil then
&#9;&#9;game.Workspace.gameCam5:remove()
&#9;&#9;end


msg.Text = &quot;Loading Smoker Ville by VETRONE, please hold!&quot;
wait(1)
local map5 = game.Lighting.SmokerVille:clone()
map5.Parent = game.Workspace
map5:MakeJoints()
wait()
wait(1)
setSpawns(&quot;SmokerVille&quot;)

local max = 10
for i = 1,10 do
msg.Text = &quot;Next game starts in &quot;..max
max = max - 1
