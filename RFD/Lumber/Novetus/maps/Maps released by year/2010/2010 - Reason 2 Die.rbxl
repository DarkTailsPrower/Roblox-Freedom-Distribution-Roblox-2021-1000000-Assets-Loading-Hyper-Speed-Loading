function setSpawns(name)
if game.Workspace:findFirstChild(name) ~= nil then
game.Workspace.SurvivorsSpawn.CFrame = game.Workspace:findFirstChild(name).SS.CFrame
local model = game.Workspace:findFirstChild(name).Zspawns:GetChildren()
for x = 1,#model do
if game.Workspace.ZombieSpawns:findFirstChild(model[x].Name) == nil then return end
game.Workspace.ZombieSpawns:findFirstChild(model[x].Name).CFrame = model[x].CFrame
end
end
end


