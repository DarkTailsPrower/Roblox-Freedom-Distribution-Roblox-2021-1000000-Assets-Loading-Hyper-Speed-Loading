						<ProtectedString name="Source">d = 0
a = 0
function weld()
if d == 1 then return end
d = 1
local w1 = Instance.new(&quot;Weld&quot;)
w1.Parent = script.Parent.Handle
w1.Part0 = w1.Parent
w1.Part1 = script.Parent.Handle2
w1.C1 = CFrame.new(3, 0, 0)
if script.Parent.Parent:findFirstChild(&quot;Animate&quot;) ~= nil then
script.Parent.Parent:findFirstChild(&quot;Animate&quot;):remove()
end
local s = script.Parent.DoubleAnimate:clone()
s.Disabled = false
s.Parent = script.Parent.Parent
wait(0.1)
d = 0
end

function weld2()
if a == 1 then return end
a = 1
char= script.Parent.Parent.Parent.Character
if char:findFirstChild(&quot;DoubleAnimate&quot;) ~= nil then
char:findFirstChild(&quot;DoubleAnimate&quot;):remove()
end
local s = script.Parent.Animate:clone()
s.Disabled = false
s.Parent = char
wait(0.1)
a = 0
end

script.Parent.Equipped:connect(weld)
script.Parent.Unequipped:connect(weld2)

