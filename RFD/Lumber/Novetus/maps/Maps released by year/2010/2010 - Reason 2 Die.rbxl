						<Item class="LocalScript" referent="RBX4862">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Local Gui</string>
								<ProtectedString name="Source">Tool=script.Parent
function onEquippedLocal(mouse)
&#9;if mouse == nil then
&#9;&#9;print(&quot;Mouse not found&quot;)
&#9;&#9;return 
&#9;end
&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
end

Tool.Equipped:connect(onEquippedLocal)</ProtectedString>
							</Properties>
						</Item>
						<Item class="Script" referent="RBX4863">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">NinjaStar</string>
								<ProtectedString name="Source">Tool = script.Parent
VELOCITY = 50 -- constant
loaded=false


local Pellet = script.Parent.Handle:clone()


function isTurbo(character)
&#9;return character:FindFirstChild(&quot;NinjaMaskOfShadows&quot;) ~= nil
end


function fire(v)
script.Value.Value = 1
Tool.Parent.Torso[&quot;Right Shoulder&quot;].MaxVelocity = 0.7
Tool.Parent.Torso[&quot;Right Shoulder&quot;].DesiredAngle = 3.6
wait(.1)
Tool.Parent.Torso[&quot;Right Shoulder&quot;].MaxVelocity = 1
Tool.Handle.Transparency=1
Tool.Handle.Fire:Play()

-- find player&apos;s head pos

&#9;local vCharacter = Tool.Parent
&#9;local vPlayer = game.Players:playerFromCharacter(vCharacter)

&#9;local head = vCharacter:findFirstChild(&quot;Head&quot;)
&#9;if head == nil then return end


&#9;local launch = head.Position + 10 * v

&#9;&#9;

&#9;local missile = Pellet:clone()
&#9;missile.PelletScript.Disabled = false&#9;

&#9;missile.Position = launch
&#9;missile.Velocity = v * 80

&#9;
&#9;missile.Parent = game.Workspace

end





Tool.Enabled = true
function onActivated()
&#9;if script.Value.Value == 1 then
&#9;&#9;wait(0)
&#9;&#9;Tool.Parent = nil
&#9;else
&#9;&#9;local character = Tool.Parent;
&#9;&#9;local humanoid = character.Humanoid
&#9;&#9;if humanoid == nil then
&#9;&#9;&#9;print(&quot;Humanoid not found&quot;)
&#9;&#9;&#9;return 
&#9;&#9;end
&#9;&#9;local targetPos = humanoid.TargetPoint
&#9;&#9;local lookAt = (targetPos - character.Head.Position).unit
&#9;&#9;fire(lookAt)
&#9;&#9;Tool.Parent = nil
&#9;end
end

script.Parent.Activated:connect(onActivated)
</ProtectedString>
							</Properties>
							<Item class="NumberValue" referent="RBX4864">
								<Properties>
									<string name="Name">Value</string>
									<double name="Value">0</double>
								</Properties>
							</Item>
						</Item>
						<Item class="Script" referent="RBX4865">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">AntiZombieUse</string>
								<ProtectedString name="Source">local pos = script.Parent.Handle.Position

function e()
local player = game.Players:findFirstChild(script.Parent.Parent.Name)
if player ~= nil then
if player.TeamColor == BrickColor.new(&quot;Bright green&quot;) then
local Tool = script.Parent:clone()
script.Parent:remove()
wait(2)
Tool.Parent = game.Workspace
Tool.Handle.Position = pos
Tool.Handle.CanCollide = true
end
end
end

script.Parent.Equipped:connect(e)
</ProtectedString>
							</Properties>
