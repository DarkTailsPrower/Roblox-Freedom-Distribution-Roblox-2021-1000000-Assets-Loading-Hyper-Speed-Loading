			<Item class="Tool" referent="RBX93">
				<Properties>
					<bool name="CanBeDropped">true</bool>
					<bool name="Enabled">true</bool>
					<CoordinateFrame name="Grip">
						<X>0</X>
						<Y>-0.200000003</Y>
						<Z>-0.5</Z>
						<R00>1</R00>
						<R01>0</R01>
						<R02>0</R02>
						<R10>0</R10>
						<R11>1</R11>
						<R12>-6.00000021e-005</R12>
						<R20>-0</R20>
						<R21>6.00000021e-005</R21>
