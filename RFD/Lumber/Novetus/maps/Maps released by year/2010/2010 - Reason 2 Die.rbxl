							<string name="Name">BloxyColaScript</string>
							<ProtectedString name="Source">local Tool = script.Parent;

enabled = true




function onActivated()
&#9;if not enabled  then
&#9;&#9;return
&#9;end
&#9;if script.Parent.Taken.Value == true then
&#9;Tool.Parent = nil
&#9;end

&#9;enabled = false
&#9;Tool.GripForward = Vector3.new(0,-.759,-.651)
&#9;Tool.GripPos = Vector3.new(1.5,-.9,0.1)
&#9;Tool.GripRight = Vector3.new(1,0,0)
&#9;Tool.GripUp = Vector3.new(0,.651,-.759)


&#9;--Tool.Handle.DrinkSound:Play()

&#9;wait(0.4)
&#9;
&#9;local h = Tool.Parent:FindFirstChild(&quot;Humanoid&quot;)
&#9;if (h ~= nil) then
&#9;&#9;if h.Parent:findFirstChild(&quot;Drain&quot;) == nil then
&#9;&#9;Tool.Taken.Value = true
&#9;&#9;local s = script.Parent.Drain:clone()
&#9;&#9;s.Disabled = false
&#9;&#9;s.Parent = Tool.Parent
&#9;&#9;wait(0)
&#9;&#9;Tool.Parent = nil
&#9;&#9;else
&#9;&#9;h.Parent.Drain.hpleft.Value = h.Parent.Drain.hpleft.Value + 70
&#9;&#9;h.Health = h.Health + 70
&#9;&#9;if h.Parent.Drain.hpleft.Value &gt; h.MaxHealth then
&#9;&#9;&#9;h.Parent.Drain.hpleft.Value = h.Parent.Drain.hpleft.Value + (h.MaxHealth - h.Health)
&#9;&#9;&#9;h.Health = h.MaxHealth
&#9;&#9;end
&#9;&#9;wait(0)
&#9;&#9;Tool.Parent = nil
&#9;&#9;end
&#9;end

&#9;Tool.GripForward = Vector3.new(-.976,0,-0.217)
&#9;Tool.GripPos = Vector3.new(0.03,-0.2,0)
&#9;Tool.GripRight = Vector3.new(.217,0,-.976)
&#9;Tool.GripUp = Vector3.new(0,1,0)

&#9;enabled = true

end

function onEquipped()
&#9;--Tool.Handle.OpenSound:play()
end

script.Parent.Activated:connect(onActivated)
script.Parent.Equipped:connect(onEquipped)
