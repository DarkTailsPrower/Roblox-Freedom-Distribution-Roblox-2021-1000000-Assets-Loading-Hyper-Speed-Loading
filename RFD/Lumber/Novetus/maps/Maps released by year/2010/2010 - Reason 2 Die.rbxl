		<Item class="LocalScript" referent="RBX415">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">LeaveScene2</string>
				<ProtectedString name="Source">local player = game.Players.LocalPlayer
&#9;&#9;&#9;local camera = game.Workspace.gameCam2
&#9;&#9;&#9;local cam = game.Workspace.CurrentCamera
&#9;&#9;&#9;cam.CameraSubject = camera
&#9;&#9;&#9;cam.CameraType = 3
</ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX416">
			<Properties>
				<bool name="Disabled">true</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">StoneScript</string>
				<ProtectedString name="Source">function touched(hit)
local model = Instance.new(&quot;Model&quot;)
model.Parent = game.Workspace
script.Parent.Parent = model
script.Parent.Size = Vector3.new(1,1,1)
script.Parent.StoneBodyForce:remove()
for x =1,8 do
local a = script.Parent:clone()
a.StoneScript:remove()
a.Parent = model
end
&#9;if hit.Parent:FindFirstChild(&quot;Humanoid&quot;) ~= nil then
&#9;hit.Parent.Humanoid.Health = hit.Parent.Humanoid.Health - 30
&#9;hit.Parent.Humanoid.Sit = true
&#9;hit.RotVelocity = Vector3.new(20,30,50)
&#9;end
&#9;if hit.Name == &quot;Window&quot; then
&#9;hit.Anchored = false
&#9;hit:BreakJoints()
&#9;end
&#9;wait(2)
&#9;model:remove()
&#9;script.Parent:remove()
end
script.Parent.Touched:connect(touched)
</ProtectedString>
			</Properties>
		</Item>
