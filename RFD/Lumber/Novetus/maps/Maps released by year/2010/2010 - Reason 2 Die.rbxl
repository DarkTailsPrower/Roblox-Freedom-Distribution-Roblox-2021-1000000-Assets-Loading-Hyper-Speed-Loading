						<ProtectedString name="Source">var = 0
a = 7
x = 0
bin = script.Parent

function move(target)
&#9;local dir = (target.Position - bin.Position).unit
&#9;local spawnPos = bin.Position
&#9;local pos = spawnPos + (dir * 1)
&#9;bin:findFirstChild(&quot;BodyGyro&quot;).cframe = CFrame.new(pos,  pos + dir)
&#9;bin:findFirstChild(&quot;BodyGyro&quot;).maxTorque = Vector3.new(9000,9000,9000)
end

function moveTo(target)
&#9;a = a+1
&#9;bin.BodyPosition.position = Vector3.new(target.Position.x,102,target.Position.z)
&#9;bin.BodyPosition.maxForce = Vector3.new(1000*a, 4e+010,1000*a) * 100
end


while true do
wait(0.1)
var = var + 1
if var &lt; 22 then
