------------------------------------------------------------------------------------------------
----Zombie Types--------------------------------------------------------------------------
------------------------------------------------------------------------------------------------

function MakeTank(char)
if char:findFirstChild(&quot;GameOn&quot;) ~= nil then return end
script.GameOn:clone().Parent = char

game.Lighting.Tank:clone().Parent = game.Players:FindFirstChild(char.Name).Backpack
local child = char:GetChildren()

for x = 1,#child do
if child[x].Name ~= &quot;Right Leg&quot; and child[x].Name ~= &quot;Left Leg&quot; then
if child[x].className == &quot;Part&quot; then
child[x].Transparency = 1
end
end
if child[x].className == &quot;Hat&quot; then
child[x]:Remove()
end
if child[x].Name == &quot;Head&quot; then
if child[x]:findFirstChild(&quot;face&quot;) ~= nil then
child[x]:findFirstChild(&quot;face&quot;):remove()
end
end
end

char.Zombie.MaxHealth = 1000
wait(0.1)
char.Zombie.Health = 999

if char:findFirstChild(&quot;Right Arm&quot;) ~= nil then
char:findFirstChild(&quot;Right Arm&quot;).Transparency = 1
end
if char:findFirstChild(&quot;Left Arm&quot;) ~= nil then
char:findFirstChild(&quot;Left Arm&quot;).Transparency = 1
end

ls = char.Torso:findFirstChild(&quot;Left Shoulder&quot;)
if ls ~= nil then
ls.C0 = CFrame.new(-2,2,0,0,0,-1,0,1,0,1,0,0)
end
rs = char.Torso:findFirstChild(&quot;Right Shoulder&quot;)
if rs ~= nil then
rs.C0 = CFrame.new(3,2,0,0,0,-1,0,1,0,1,0,0)
--rs.Part1 = 
end

--right arm
local muscle1 = game.Lighting.Muscle:clone()
muscle1 .Parent = char
muscle1.Mesh.Scale = Vector3.new(1.3,4,2)
local weld = Instance.new(&quot;Weld&quot;) 
weld.Part0 = muscle1
weld.Part1 = char:findFirstChild(&quot;Right Arm&quot;)
weld.C0 = CFrame.new(0,0,0)
weld.C1 = CFrame.new(0,0,0)
weld.Parent = muscle1
local muscle2 = game.Lighting.Muscle:clone()
muscle2 .Parent = char
muscle2.Mesh.Scale = Vector3.new(2,4,2)
local weld = Instance.new(&quot;Weld&quot;) 
weld.Part0 = muscle2
