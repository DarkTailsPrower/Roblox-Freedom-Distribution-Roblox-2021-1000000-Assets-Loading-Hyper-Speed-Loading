				<Item class="Script" referent="RBX3644">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">var = 0
time = 43
bin = script.Parent
stopPos = 170

local fire = game.Lighting.Fire2:clone()

function move(target)
&#9;local dir = (target.Position - bin.Position).unit
&#9;local spawnPos = bin.Position
&#9;local pos = spawnPos + (dir * 1)
&#9;bin:findFirstChild(&quot;BodyGyro&quot;).cframe = CFrame.new(pos,  pos + dir)
&#9;bin:findFirstChild(&quot;BodyGyro&quot;).maxTorque = Vector3.new(9000,9000,9000)
end

function moveTo(target)
&#9;bin.BodyPosition.position = target.Position + Vector3.new(0,15.2-target.Position.y,0)
&#9;bin.BodyPosition.maxForce = Vector3.new(20000, 4e+013,10000) * 100
end


function set_on_fire()
&#9;local pos = script.Parent.Position + Vector3.new(0,2,0)
&#9;for x = 1,30 do
&#9;wait(0.2)
&#9;local s = fire:clone()
&#9;s.Script.Disabled = false
&#9;s.Script2.Disabled = false
&#9;s.Parent = game.Workspace
&#9;s.Position = pos + Vector3.new(0,1,0)&#9;
&#9;vx = math.random(-30,30)
&#9;vz = math.random(-30,30)
&#9;s.Velocity = Vector3.new(vx,10,vz)
&#9;s.RotVelocity = Vector3.new(vx,vx,vz)
&#9;end
&#9;wait(5)
&#9;script.Parent.Parent.Seats:remove()
&#9;script.Parent.Parent:BreakJoints()
&#9;local ex =Instance.new(&quot;Explosion&quot;)
&#9;ex.Position = script.Parent.Position
&#9;ex.Parent = game.Workspace
&#9;ex.BlastRadius = 20
&#9;wait(2.5)
&#9;script.Parent.BodyPosition:remove()
&#9;script.Parent.BodyGyro:remove()

end

move(game.Workspace.BloxHarbor.Point0)


while true do
wait(0.1)
var = var + 1
if var &lt;stopPos then
script.Parent.BodyPosition.position = script.Parent.BodyPosition.position + Vector3.new(2,0,0)
end
if var == stopPos then
script.Parent.BodyPosition.position = Vector3.new(-49.5, 15.2, 13)
wait(time)
script.Parent.Parent.CaptainWindow.Scream:Play()
end
if var == stopPos+1 then
local target = game.Workspace.BloxHarbor.Point1
move(target)
bin.BodyPosition.position = target.Position + Vector3.new(0,15.2-target.Position.y,0)
bin.BodyPosition.maxForce = Vector3.new(10000, 4e+013,10000) * 100
wait(1.2)
move(game.Workspace.BloxHarbor.Point2)
moveTo(game.Workspace.BloxHarbor.Point2)
wait(1)
move(game.Workspace.BloxHarbor.Point3)
moveTo(game.Workspace.BloxHarbor.Point3)
wait(0.2)
moveTo(game.Workspace.BloxHarbor.Point4)
bin.BodyPosition.maxForce = Vector3.new(4e+013, 4e+013,4e+013) 
wait(2)
set_on_fire()
end
end
</ProtectedString>
					</Properties>
				</Item>
