				<Item class="Script" referent="RBX5610">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">var = 0
maxPos = 100
time = 53
while true do
wait(0.1)
var = var+1
&#9;if var&lt;maxPos then
&#9;script.Parent.BodyPosition.position = script.Parent.BodyPosition.position + Vector3.new(-1,-0.2,0)

&#9;end
&#9;if var == maxPos then 
&#9;script.Parent.BodyPosition.position = script.Parent.BodyPosition.position
&#9;script.Parent.Anchored = true
&#9;script.Parent.Velocity = Vector3.new(0,0,0)
&#9;script.Parent.RotVelocity = Vector3.new(0,0,0)
&#9;local a = script.Parent.Parent.Ladder:GetChildren()
&#9;for i = 1,#a do
&#9;&#9;a[i].CanCollide = true
&#9;&#9;a[i].Transparency = 0
&#9;&#9;a[i].Velocity = Vector3.new(0,0,0)
&#9;end
&#9;wait(time)
&#9;end
&#9;if var == maxPos+1 then
&#9;&#9;script.Parent.Anchored = false
&#9;&#9;local seat = Instance.new(&quot;Seat&quot;)
&#9;&#9;seat.Parent = script.Parent.Parent
&#9;&#9;seat.Transparency =1
&#9;&#9;local weld = Instance.new(&quot;Weld&quot;)
&#9;&#9;weld.Parent = script.Parent.Parent.Ladder.End
&#9;&#9;weld.Part0 = script.Parent.Parent.Ladder.End
&#9;&#9;weld.Part1 = seat
&#9;&#9;weld.C0 = CFrame.new(0,0,0)
&#9;&#9;weld.C1 = CFrame.new(0,0.2,-1)
&#9;end
&#9;if var &gt;maxPos then
&#9;script.Parent.BodyPosition.position = script.Parent.BodyPosition.position + Vector3.new(-1,0.2,0)
&#9;end
end
</ProtectedString>
					</Properties>
				</Item>
