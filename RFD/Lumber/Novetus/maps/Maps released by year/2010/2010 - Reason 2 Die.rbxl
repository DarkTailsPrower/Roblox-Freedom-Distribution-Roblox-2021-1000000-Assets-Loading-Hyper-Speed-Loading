				<Item class="Script" referent="RBX219">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Slingshot</string>
						<ProtectedString name="Source">Tool = script.Parent
VELOCITY = 100 -- constant
local Enabled = true 

local Pellet = script.Parent.Handle:clone()
Pellet.BrickColor = BrickColor.new(2)
script.Parent.Explosives:clone().Parent = Pellet
script.Parent.Explosion:clone().Parent = Pellet
script.Parent.pipe:clone().Parent = Pellet
script.Parent.Script:clone().Parent = Pellet
script.Parent.remove:clone().Parent = Pellet

function fire(mouse_pos)

&#9;script.Parent.Value.Value = 1
-- find player&apos;s head pos

&#9;local vCharacter = Tool.Parent
&#9;local vPlayer = game.Players:playerFromCharacter(vCharacter)

&#9;local head = vCharacter:findFirstChild(&quot;Head&quot;)
&#9;if head == nil then return end

&#9;local dir = mouse_pos - head.Position
&#9;dir = computeDirection(dir)

&#9;local launch = head.Position + 5 * dir

&#9;local delta = mouse_pos - launch
&#9;
&#9;local dy = delta.y
&#9;
&#9;local new_delta = Vector3.new(delta.x, 0, delta.z)
&#9;delta = new_delta

&#9;local dx = delta.magnitude
&#9;local unit_delta = delta.unit
&#9;
&#9;-- acceleration due to gravity in RBX units
&#9;local g = (-9.81 * 20)

&#9;local theta = computeLaunchAngle( dx, dy, g)

&#9;local vy = math.sin(theta)
&#9;local xz = math.cos(theta)
&#9;local vx = unit_delta.x * xz
&#9;local vz = unit_delta.z * xz
&#9;

&#9;local missile = Pellet:clone()
        

&#9;&#9;

&#9;missile.Position = launch
&#9;missile.Velocity = Vector3.new(vx,vy,vz) * VELOCITY

&#9;missile.Explosives.Disabled = false
&#9;missile.remove.Disabled = false

&#9;missile.Name = &quot;PipeBomb&quot;

&#9;missile.Parent = game.Workspace

end


function computeLaunchAngle(dx,dy,grav)
&#9;-- arcane
&#9;-- http://en.wikipedia.org/wiki/Trajectory_of_a_projectile
&#9;
&#9;local g = math.abs(grav)
&#9;local inRoot = (VELOCITY*VELOCITY*VELOCITY*VELOCITY) - (g * ((g*dx*dx) + (2*dy*VELOCITY*VELOCITY)))
&#9;if inRoot &lt;= 0 then
&#9;&#9;return .25 * math.pi
&#9;end
&#9;local root = math.sqrt(inRoot)
&#9;local inATan1 = ((VELOCITY*VELOCITY) + root) / (g*dx)

&#9;local inATan2 = ((VELOCITY*VELOCITY) - root) / (g*dx)
&#9;local answer1 = math.atan(inATan1)
&#9;local answer2 = math.atan(inATan2)
&#9;if answer1 &lt; answer2 then return answer1 end
&#9;return answer2
end

function computeDirection(vec)
&#9;local lenSquared = vec.magnitude * vec.magnitude
&#9;local invSqrt = 1 / math.sqrt(lenSquared)
&#9;return Vector3.new(vec.x * invSqrt, vec.y * invSqrt, vec.z * invSqrt)
end





function onActivated()

&#9;if script.Parent.Value.Value == 1 then
&#9;&#9;wait(0)
&#9;&#9;Tool.Parent = nil
&#9;else

&#9;&#9;Enabled = false

&#9;&#9;local character = Tool.Parent;
&#9;&#9;local humanoid = character.Humanoid
&#9;&#9;if humanoid == nil then
&#9;&#9;&#9;print(&quot;Humanoid not found&quot;)
&#9;&#9;&#9;return 
&#9;&#9;end

&#9;&#9;local targetPos = humanoid.TargetPoint

&#9;&#9;fire(targetPos)
&#9;&#9;wait(0)
&#9;&#9;Tool.Parent = nil
&#9;end
end

script.Parent.Activated:connect(onActivated)


</ProtectedString>
					</Properties>
				</Item>
				<Item class="LocalScript" referent="RBX220">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Local Gui</string>
						<ProtectedString name="Source">local Tool = script.Parent;

function onEquippedLocal(mouse)

&#9;if mouse == nil then
&#9;&#9;print(&quot;Mouse not found&quot;)
&#9;&#9;return 
&#9;end
&#9;mouse.Icon =&quot;rbxasset://textures\\GunCursor.png&quot;
&#9;local player = game.Players:findFirstChild(Tool.Parent.Name)
&#9;if player ~= nil then
&#9;&#9;if player.TeamColor == BrickColor.new(&quot;Bright green&quot;) then
&#9;&#9;Tool.Parent = nil
&#9;&#9;end
&#9;end
end



Tool.Equipped:connect(onEquippedLocal)
</ProtectedString>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX221">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Explosives</string>
						<ProtectedString name="Source">local p = game.Players:GetChildren()
for i = 1,#p do
&#9;if p[i].TeamColor == BrickColor.new(&quot;Bright green&quot;) then
&#9;&#9;local s = script.walk:clone()
&#9;&#9;s.Disabled = false
&#9;&#9;s.Parent = p[i].Character.Zombie
&#9;end
end
&#9;local minus = 0
&#9;for x = 1,20 do
&#9;wait(1-minus)
&#9;script.Parent.pipe:play()
&#9;minus = minus + 0.1
&#9;end

&#9;local e = Instance.new(&quot;Explosion&quot;)
&#9;e.Parent = game.Workspace
&#9;e.Position = script.Parent.Position
&#9;e.BlastRadius = 17
&#9;e.BlastPressure = 0
&#9;script.Parent.Explosion:play()

local p = game.Players:GetChildren()
for i = 1,#p do
&#9;if p[i].TeamColor == BrickColor.new(&quot;Bright green&quot;) then
&#9;&#9;local s = p[i].Character.Torso
&#9;&#9;if s ~= nil then
&#9;&#9;&#9;local dist = (s.Position-script.Parent.Position).magnitude
&#9;&#9;&#9;if dist &lt;17 then
&#9;&#9;&#9;&#9;p[i].Character.Zombie.Health = p[i].Character.Zombie.Health-150
&#9;&#9;&#9;&#9;local humanoid = p[i].Character.Zombie
&#9;&#9;&#9;&#9;if humanoid:FindFirstChild(&quot;Killa&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;humanoid.Killa.Value = script.Parent.Parent.Name
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end&#9;

script.Parent.Anchored = true
script.Parent.CanCollide = false
script.Parent.Transparency = 1


&#9;wait(0)
&#9;script.Parent:remove()


</ProtectedString>
					</Properties>
					<Item class="Script" referent="RBX222">
						<Properties>
							<bool name="Disabled">true</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">walk</string>
							<ProtectedString name="Source">local original = script.Parent.WalkSpeed
script.Parent.WalkSpeed = 0
script.Parent.Jump = true

local force = Instance.new(&quot;BodyPosition&quot;)
force.maxForce = Vector3.new(100000,0,100000)
force.position = script.Parent.Parent.Torso.Position
force.Parent = script.Parent.Parent.Torso

local force2 = Instance.new(&quot;BodyGyro&quot;)
force2.Parent = script.Parent.Parent.Torso

function move(bin,target)
&#9;local dir = (target.Position - bin.Position).unit
&#9;local spawnPos = bin.Position
&#9;local pos = spawnPos + (dir * 1)
&#9;bin:findFirstChild(&quot;BodyGyro&quot;).cframe = CFrame.new(pos,  pos + dir)
&#9;bin:findFirstChild(&quot;BodyGyro&quot;).maxTorque = Vector3.new(90000,90000,90000)
end

function move2(bomb)
local pos = script.Parent.Parent.Torso.Position
local pos2 = bomb.Position
x = pos.x-pos2.x
z = pos.z-pos2.z
local dist = math.sqrt ((x*x)+(z*z))
print(dist)
scale = dist/10
print(scale)
x2 = force.position.x + (x*scale)
z2 = force.position.z + (z*scale)
print(x2)
print(z2)
force.position = Vector3.new(x,0,z)
end

local bomb = game.Workspace:findFirstChild(&quot;PipeBomb&quot;)
while true do
&#9;wait(0.1)
&#9;if game.Workspace:findFirstChild(&quot;PipeBomb&quot;) ~= nil then
&#9;&#9;local dist = (script.Parent.Parent.Torso.Position-game.Workspace.PipeBomb.Position).magnitude
&#9;&#9;print(dist)
&#9;&#9;&#9;if dist &lt; 100 then
&#9;&#9;&#9;script.Parent.WalkSpeed = 0
&#9;&#9;&#9;move(script.Parent.Parent.Torso,game.Workspace:findFirstChild(&quot;PipeBomb&quot;))
&#9;&#9;&#9;force.maxForce = Vector3.new(100000,0,100000)
&#9;&#9;&#9;force.position = script.Parent.Parent.Torso.Position + script.Parent.Parent.Torso.CFrame.lookVector * (original*0.3)
&#9;&#9;&#9;else
&#9;&#9;&#9;force.maxForce = Vector3.new(0,0,0)
&#9;&#9;&#9;script.Parent.WalkSpeed = original
&#9;&#9;&#9;end
&#9;&#9;--move2(game.Workspace:findFirstChild(&quot;PipeBomb&quot;))
&#9;else
&#9;&#9;force:remove()
&#9;&#9;force2:remove()
&#9;&#9;script.Parent.WalkSpeed = original
&#9;&#9;script:remove()
&#9;&#9;break

&#9;end
end
</ProtectedString>
						</Properties>
					</Item>
				</Item>
