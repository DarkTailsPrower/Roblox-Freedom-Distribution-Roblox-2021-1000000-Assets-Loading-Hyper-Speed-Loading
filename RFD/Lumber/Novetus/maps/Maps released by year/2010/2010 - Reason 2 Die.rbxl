						<string name="Name">Script</string>
						<ProtectedString name="Source">Tool =script.Parent
function onEquippedLocal(mouse)

&#9;if script.Parent:findFirstChild(&quot;equp&quot;) ~= nil then
&#9;&#9;script.Parent.equp.Value = script.Parent.equp.Value + 1
&#9;&#9;if script.Parent.equp.Value &gt;5 then
&#9;&#9;local msg = Instance.new(&quot;Message&quot;)
&#9;&#9;msg.Text = &quot;Your sniper is deleted. Dont try to create lag.&quot;
&#9;&#9;msg.Parent = game.Players:FindFirstChild(script.Parent.Parent.Name)
&#9;&#9;local s = script.Parent.remo:clone()
&#9;&#9;s.Disabled = false
&#9;&#9;s.Parent = msg
&#9;&#9;Tool:remove()
&#9;&#9;end
&#9;else&#9;
&#9;&#9;local equp = Instance.new(&quot;NumberValue&quot;)
&#9;&#9;equp.Value = 1
&#9;&#9;equp.Name = &quot;equp&quot;
&#9;&#9;equp.Parent = script.Parent
&#9;&#9;local s = script.Parent.remo:clone()
&#9;&#9;s.Disabled = false
&#9;&#9;s.Parent = equp
&#9;end

end





Tool.Equipped:connect(onEquippedLocal)</ProtectedString>
