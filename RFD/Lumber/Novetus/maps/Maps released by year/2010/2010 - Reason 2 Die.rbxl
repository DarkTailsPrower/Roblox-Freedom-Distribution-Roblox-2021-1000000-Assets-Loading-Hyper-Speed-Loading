					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">LocalScript</string>
					<ProtectedString name="Source">function onEquipped(mouse)
&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
end


script.Parent.Selected:connect(onEquipped)</ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX449">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">Reload = 0
Reload2 = 0
Reload3 = 0
damage = 5

function dance()
if Reload == 0 then
Reload = 1
damage = 10

local me = script.Parent.Parent.Parent.Character.Torso

local RightShoulder = me[&quot;Right Shoulder&quot;]
local LeftShoulder = me[&quot;Left Shoulder&quot;]
local RightHip = me[&quot;Right Hip&quot;]
local LeftHip = me[&quot;Left Hip&quot;]

DA = 3
script.Parent.Scream:Play()
for i=1, 10 do 

&#9;RightShoulder.MaxVelocity = 0.35
&#9;LeftShoulder.MaxVelocity = 0.35


&#9;RightShoulder.DesiredAngle = -DA
&#9;LeftShoulder.DesiredAngle = -DA
&#9;wait(0)
DA = DA+0.25
RightShoulder.MaxVelocity = 0.15
LeftShoulder.MaxVelocity = 0.15
end
DA = 1
for x = 1,10 do
&#9;RightShoulder.MaxVelocity = 0.35
&#9;LeftShoulder.MaxVelocity = 0.35
&#9;RightShoulder.DesiredAngle = 0
&#9;LeftShoulder.DesiredAngle = 0
RightShoulder.MaxVelocity = 0.15
LeftShoulder.MaxVelocity = 0.15
end

damage = 5

RightShoulder.MaxVelocity = 0.15
LeftShoulder.MaxVelocity = 0.15
wait(3)
Reload = 0
end
end

function onKeyDown(key)
if key == &quot;e&quot; then
local char = script.Parent.Parent.Parent.Character
local me = char.Torso

local RightShoulder = me[&quot;Right Shoulder&quot;]
local LeftShoulder = me[&quot;Left Shoulder&quot;]
if damage == 5 and Reload2 == 0 then
char.Zombie.WalkSpeed = 0
Reload2 = 1
char:findFirstChild(&quot;Stone&quot;).Transparency = 0
DA = 3
script.Parent.Scream:Play()
for i=1, 10 do 

&#9;RightShoulder.MaxVelocity = 0.35
&#9;LeftShoulder.MaxVelocity = 0.35


&#9;RightShoulder.DesiredAngle = -DA
&#9;LeftShoulder.DesiredAngle = -DA
&#9;wait(0)
DA = DA+0.25
RightShoulder.MaxVelocity = 0.15
LeftShoulder.MaxVelocity = 0.15
end


local plate = game.Lighting.Stone:clone()
plate.Parent = char
plate.Transparency = 0
plate.Position = me.Position + char.Torso.CFrame.lookVector*6
plate.Velocity = char.Head.CFrame.lookVector * 100 + Vector3.new(0,10,0)
plate.RotVelocity = Vector3.new(0,30,9)
char:findFirstChild(&quot;Stone&quot;).Transparency = 1
plate.CanCollide = true
local s1 = game.Lighting.StoneScript:clone()
s1.Disabled = false
s1.Parent = plate
game.Lighting.StoneBodyForce:Clone().Parent = plate
plate.Name = &quot;Stony&quot;
wait(0.2)
char.Zombie.WalkSpeed = 16
wait(5)
Reload2 = 0
end
end
end


function kill(hit)
&#9;local humanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;if humanoid ~= nil and Reload3 == 0 then
&#9;Reload3 = 1
&#9;humanoid.Health = humanoid.Health - damage
&#9;&#9;if damage == 10 then
&#9;&#9;humanoid.Sit = true
&#9;&#9;hit.Parent.Torso.Velocity = Vector3.new(0,100,0)
&#9;&#9;hit.Parent.Torso.RotVelocity = Vector3.new(0,30,90)
&#9;&#9;end
&#9;Reload3 = 0
&#9;end
&#9;if hit.Name == &quot;Window&quot; then
&#9;hit.Anchored = false
&#9;hit:BreakJoints()
&#9;end
end

function go(mouse)
mouse.Button1Down:connect(dance)
&#9;mouse.KeyDown:connect(onKeyDown)
if script.Parent.Parent.Parent.Character:findFirstChild(&quot;Left Arm&quot;) ~= nil then
connection1 = script.Parent.Parent.Parent.Character:findFirstChild(&quot;Left Arm&quot;).Touched:connect(kill)
print(&quot;got arm1&quot;)
end
if script.Parent.Parent.Parent.Character:findFirstChild(&quot;Right Arm&quot;) ~= nil then
print(&quot;got arm2&quot;)
connection1 = script.Parent.Parent.Parent.Character:findFirstChild(&quot;Right Arm&quot;).Touched:connect(kill)
end
if script.Parent.Parent.Parent.Character:findFirstChild(&quot;LH&quot;) ~= nil then
connection1 = script.Parent.Parent.Parent.Character:findFirstChild(&quot;LH&quot;).Touched:connect(kill)
print(&quot;got arm1&quot;)
end
if script.Parent.Parent.Parent.Character:findFirstChild(&quot;RH&quot;) ~= nil then
print(&quot;got arm2&quot;)
connection1 = script.Parent.Parent.Parent.Character:findFirstChild(&quot;RH&quot;).Touched:connect(kill)
end
end

script.Parent.Selected:connect(go)
</ProtectedString>
