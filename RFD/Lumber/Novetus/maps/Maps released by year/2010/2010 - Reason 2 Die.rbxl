						<string name="Name">Script</string>
						<ProtectedString name="Source">function t(hit)
if hit.Name == &quot;Paintball&quot; then
&#9;hit:remove()
end

if hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil then
hit.Parent.Torso.CFrame =  CFrame.new(hit.Parent.Torso.Position.x-10,hit.Parent.Torso.Position.y,hit.Parent.Torso.Position.z)
end
end

script.Parent.Touched:connect(t)</ProtectedString>
