&#9;&#9;&#9;&#9;&#9;wait(1)
&#9;&#9;&#9;&#9;&#9;break
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;takeofftime = takeofftime - 1
&#9;&#9;&#9;&#9;&#9;msg.Text = &quot;Soliders! Were leaving in &quot;..takeofftime..&quot; seconds! Deffend the van!!&quot;
&#9;&#9;&#9;&#9;&#9;wait(1)
&#9;&#9;&#9;&#9;&#9;if endgame2 == true then return end
&#9;&#9;&#9;&#9;&#9;if takeofftime == 1 then
&#9;&#9;&#9;&#9;&#9;msg.Text = &quot;GOGOGO!&quot;
&#9;&#9;&#9;&#9;&#9;wait(1)
&#9;&#9;&#9;&#9;&#9;break
&#9;&#9;&#9;&#9;&#9;end&#9;
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;&#9;if endgame2 == true then return end
&#9;&#9;&#9;leaveScene3()
&#9;&#9;&#9;wait(20)

&#9;&#9;if train ~= nil then
&#9;&#9;train:remove()
&#9;&#9;end
