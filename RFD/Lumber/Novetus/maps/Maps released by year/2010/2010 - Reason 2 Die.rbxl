		<Item class="HopperBin" referent="RBX264">
			<Properties>
				<bool name="Active">false</bool>
				<token name="BinType">0</token>
				<string name="Name">Smoker</string>
				<Content name="TextureId"><null></null></Content>
			</Properties>
			<Item class="Script" referent="RBX265">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">local COOLDOWN = 5
enabled = true
r = game:service(&quot;RunService&quot;)
MAX_VELOCITY  = 0
MIN_VELOCITY  = 0
PULLBACK_TIME = 1
ToungeOut = false
wait(1)
Reload = 0
Reload3 = 0

local Arrow = Instance.new(&quot;Part&quot;)
Arrow.Anchored = true
Arrow.BackSurface = 0
Arrow.BottomSurface = 0
Arrow.FrontSurface = 0
Arrow.LeftSurface = 0
Arrow.RightSurface = 0
Arrow.TopSurface = 0
Arrow.CanCollide = false
Arrow.formFactor = 2
Arrow.BrickColor = BrickColor.new(&quot;Bright red&quot;)
Arrow.Name = &quot;Tounge&quot;
Arrow.Size = Vector3.new(1,0.2,5)
script.Parent.Mesh:clone().Parent = Arrow


function fire(mouse_pos, VELOCITY)
&#9;local char = script.Parent.Parent.Parent.Character
&#9;local head = char:findFirstChild(&quot;Head&quot;)
&#9;if head == nil then return end
&#9;local headpos = (head.Position+head.CFrame.lookVector*0.5)-Vector3.new(0,0.3,0)
&#9;local dir = mouse_pos - headpos
&#9;dir = computeDirection(dir)
&#9;local dist = (headpos - mouse_pos).magnitude
&#9;local launch = headpos + dir
&#9;local delta = mouse_pos - launch
&#9;delta = delta / (delta.magnitude)
&#9;local missile = Arrow:clone()
&#9;missile.CFrame = CFrame.new(launch, launch + dir)
&#9;missile.Velocity = delta * VELOCITY
&#9;missile.Anchored = false
&#9;missile.Name = &quot;shoot&quot;
&#9;missile.Parent = char
&#9;missile.Velocity = missile.CFrame.lookVector * 540
&#9;local s = script.Parent.Touch:clone()
&#9;s.Disabled = false
&#9;s.Parent = missile
&#9;script.Parent.BodyForce:clone().Parent = missile
&#9;missile.Mesh:remove()

end


function update(mouse_pos, VELOCITY)
&#9;local char = script.Parent.Parent.Parent.Character
&#9;local head = char:findFirstChild(&quot;Head&quot;)
&#9;if head == nil then return end
&#9;local headpos = (head.Position+head.CFrame.lookVector*0.5)-Vector3.new(0,0.3,0)
&#9;local dir = mouse_pos - headpos
&#9;dir = computeDirection(dir)
&#9;local dist = (headpos - mouse_pos).magnitude
&#9;local launch = headpos + (dist/2) * dir
&#9;local delta = mouse_pos - launch
&#9;delta = delta / (delta.magnitude)
&#9;local missile = char:findFirstChild(&quot;Tounge&quot;)
&#9;if missile == nil then
&#9;&#9;missile = Arrow:clone()
&#9;&#9;missile.Parent = char
&#9;end
&#9;missile.CFrame = CFrame.new(launch, launch + dir)

&#9;missile.Velocity = delta * VELOCITY
&#9;missile.Parent = char
&#9;missile.Mesh.Scale = Vector3.new(0.5,0.5,dist/5)
&#9;
end




function computeDirection(vec)
&#9;local lenSquared = vec.magnitude * vec.magnitude
&#9;local invSqrt = 1 / math.sqrt(lenSquared)
&#9;return Vector3.new(vec.x * invSqrt, vec.y * invSqrt, vec.z * invSqrt)
end


function removeTounge()
local char = script.Parent.Parent.Parent.Character
if char:findFirstChild(&quot;Tounge&quot;) ~= nil then
char.Tounge:remove()
end
obj = script.Parent.Object.Value
&#9;if obj ~= nil then
&#9;obj.Torso.BodyPosition:remove()
&#9;end
if char.Torso:findFirstChild(&quot;freeze&quot;) ~= nil then
char.Torso.freeze:remove()
end
ToungeOut = false
end






function onButton1Down(mouse)
&#9;if enabled == true then
&#9;&#9;if ToungeOut == false then
&#9;&#9;&#9;local char = script.Parent.Parent.Parent.Character
&#9;&#9;&#9;--dist = (mouse.Target.Parent.Head.Position- char.Head.Position).magnitude
&#9;&#9;&#9;ToungeOut = true
&#9;&#9;&#9;local player = script.Parent.Parent.Parent
&#9;&#9;&#9;if player == nil then return end
&#9;&#9;&#9;local pos = mouse.Hit.p
&#9;&#9;&#9;script.Parent.Object.Value = nil
&#9;&#9;&#9;fire(pos, MAX_VELOCITY)
&#9;&#9;&#9;local freeze = Instance.new(&quot;BodyPosition&quot;)
&#9;&#9;&#9;freeze.maxForce = Vector3.new(99999,99999,999999)
&#9;&#9;&#9;freeze.position = char.Torso.Position
&#9;&#9;&#9;freeze.Parent = char.Torso
&#9;&#9;&#9;freeze.Name = &quot;freeze&quot;
&#9;&#9;&#9;while true do
&#9;&#9;&#9;&#9;if script.Parent.Object.Value == nil and char:findFirstChild(&quot;shoot&quot;) ~= nil and enabled == true then
&#9;&#9;&#9;&#9;&#9;if (char.shoot.Position-char.Torso.Position).magnitude &gt; 100 then
&#9;&#9;&#9;&#9;&#9;break
&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;update(char:findFirstChild(&quot;shoot&quot;).Position, 0)
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;break
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;wait(0.02)
&#9;&#9;&#9;end
&#9;&#9;&#9;if char:findFirstChild(&quot;shoot&quot;) ~= nil then
&#9;&#9;&#9;&#9;char.shoot:remove()
&#9;&#9;&#9;end
&#9;&#9;&#9;if script.Parent.Object.Value ~= nil then
&#9;&#9;&#9;&#9;local obj = script.Parent.Object.Value
&#9;&#9;&#9;&#9;local freeze2 = Instance.new(&quot;BodyPosition&quot;)
&#9;&#9;&#9;&#9;freeze2.maxForce = Vector3.new(99999,99999,999999)
&#9;&#9;&#9;&#9;freeze2.position = obj.Torso.Position
&#9;&#9;&#9;&#9;freeze2.Parent = obj.Torso
&#9;&#9;&#9;&#9;while true do
&#9;&#9;&#9;&#9;&#9;if char.Zombie.Health &gt;0 then
&#9;&#9;&#9;&#9;&#9;obj.Humanoid.Health = obj.Humanoid.Health - 8
&#9;&#9;&#9;&#9;&#9;local dist2 = (freeze2.position-obj.Torso.Position).magnitude
&#9;&#9;&#9;&#9;&#9;&#9;if dist2 &gt; 10 then
&#9;&#9;&#9;&#9;&#9;&#9;removeTounge()
&#9;&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;local repeats = (obj.Torso.Position- char.Torso.Position).magnitude/10
&#9;&#9;&#9;&#9;&#9;&#9;freeze2.position = freeze2.position - Vector3.new((obj.Torso.Position.x-char.Torso.Position.x)/repeats,(obj.Torso.Position.y-char.Torso.Position.y)/repeats,(obj.Torso.Position.z-char.Torso.Position.z)/repeats)
&#9;&#9;&#9;&#9;&#9;&#9;update(obj.Head.Position, 0)
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;if obj.Humanoid.Health &lt;1 then
&#9;&#9;&#9;&#9;&#9;&#9;removeTounge()
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;removeTounge()
&#9;&#9;&#9;&#9;&#9;break
&#9;&#9;&#9;&#9;&#9;end&#9;
&#9;&#9;&#9;&#9;&#9;wait(1)
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end

&#9;&#9;&#9;else if ToungeOut == true then
&#9;&#9;&#9;&#9;removeTounge()
&#9;&#9;&#9;&#9;enabled = false
&#9;&#9;&#9;&#9;wait(3)
&#9;&#9;&#9;&#9;enabled = true
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end



function dance()

local me = script.Parent.Parent.Parent.Character.Torso

local RightShoulder = me[&quot;Right Shoulder&quot;]
local LeftShoulder = me[&quot;Left Shoulder&quot;]
local RightHip = me[&quot;Right Hip&quot;]
local LeftHip = me[&quot;Left Hip&quot;]

DA = 3
for i=1, 10 do 

&#9;RightShoulder.MaxVelocity = 0.35
&#9;LeftShoulder.MaxVelocity = 0.35


&#9;RightShoulder.DesiredAngle = DA
&#9;LeftShoulder.DesiredAngle = -DA
&#9;wait(0)
DA = DA-0.25
RightShoulder.MaxVelocity = 0.15
LeftShoulder.MaxVelocity = 0.15
end


end

function onKeyDown(key)
&#9;if (key~=nil) then
&#9;key = key:lower()
&#9;&#9;if (key==&quot;e&quot;) then
&#9;&#9;dance()
&#9;&#9;end
&#9;end
end


function kill(hit)
&#9;local humanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;if humanoid ~= nil and Reload3 == 0 then
&#9;Reload3 = 1
&#9;humanoid.Health = humanoid.Health - 5
&#9;wait(0.1)
&#9;Reload3 = 0
&#9;end
&#9;if hit.Name == &quot;Window&quot; then
&#9;hit.Anchored = false
&#9;hit:BreakJoints()
&#9;end
end


function onSelected(mouse)
&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
&#9;mouse.KeyDown:connect(onKeyDown)
if script.Parent.Parent.Parent.Character:findFirstChild(&quot;Left Arm&quot;) ~= nil then
connection1 = script.Parent.Parent.Parent.Character:findFirstChild(&quot;Left Arm&quot;).Touched:connect(kill)
print(&quot;got arm1&quot;)
end
if script.Parent.Parent.Parent.Character:findFirstChild(&quot;Right Arm&quot;) ~= nil then
print(&quot;got arm2&quot;)
connection1 = script.Parent.Parent.Parent.Character:findFirstChild(&quot;Right Arm&quot;).Touched:connect(kill)
end
end





script.Parent.Selected:connect(onSelected)





