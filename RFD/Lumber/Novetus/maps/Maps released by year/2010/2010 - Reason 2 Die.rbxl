					<Item class="Script" referent="RBX9176">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script3</string>
							<ProtectedString name="Source">function x(hit)
x = script.Parent.Velocity.x
if x &lt;0 then
x = -x
end
z = script.Parent.Velocity.z
if z &lt;0 then
z = -z
end
if x+z &gt; 22 then
if hit.Parent:findFirstChild(&quot;TankHead&quot;) ~= nil then return end
if hit.Parent:FindFirstChild(&quot;Zombie&quot;) ~= nil then
hit.Parent.Zombie.Killa.Value = script.Parent.Parent.Parent.Parent.Name
hit.Parent.Zombie.Sit = true
hit.Parent:BreakJoints()
end
if hit.Name == &quot;Window&quot; then
hit:BreakJoints()
hit.Velocity = script.Parent.Velocity
end
end
end

script.Parent.Touched:connect(x)</ProtectedString>
						</Properties>
					</Item>
				</Item>
