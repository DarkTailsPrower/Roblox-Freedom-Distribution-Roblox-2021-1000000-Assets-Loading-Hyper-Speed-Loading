				<Item class="Script" referent="RBX198">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">-------- OMG HAX

r = game:service(&quot;RunService&quot;)
LungeSound = script.Parent.Melee
hitting= false

local damage = 5


local slash_damage = 10
local lunge_damage = 30

sword = script.Parent.Handle
Tool = script.Parent


function lunge()
&#9;damage = lunge_damage

&#9;LungeSound:play()

&#9;local anim = Instance.new(&quot;StringValue&quot;)
&#9;anim.Name = &quot;toolanim&quot;
&#9;anim.Value = &quot;Slash&quot;
&#9;anim.Parent = Tool
&#9;
&#9;
&#9;force = Instance.new(&quot;BodyVelocity&quot;)
&#9;force.velocity = Tool.Parent.Torso.CFrame.lookVector * 80
&#9;force.Parent = Tool.Parent.Torso
&#9;wait(.5)
&#9;force.Parent = nil
&#9;wait(.5)

&#9;damage = slash_damage
end

function Smash(char,vel,damage)
&#9;if hitting == true or char:findFirstChild(&quot;TankHead&quot;) ~= nil then return end
&#9;hitting = true
&#9;if vel &gt;0 then
&#9;char.Zombie.Sit = true
&#9;char.Torso.RotVelocity = Vector3.new(70,30,50)
&#9;char.Zombie.Health = char.Zombie.Health - damage
&#9;char.Torso.Velocity = script.Parent.Parent.Torso.CFrame.lookVector * vel
&#9;else
&#9;char.Zombie.Health = char.Zombie.Health - damage
&#9;end
&#9;local humanoid = char.Zombie
&#9;if humanoid:FindFirstChild(&quot;Killa&quot;) ~= nil then
&#9;&#9;humanoid.Killa.Value = script.Parent.Parent.Name
&#9;end
end


function blow(hit)
&#9;if hit.Parent:findFirstChild(&quot;Zombie&quot;) ~= nil then
&#9;&#9;if Tool.Enabled == false then
&#9;&#9;&#9;Smash(hit.Parent,50,30)
&#9;&#9;else
&#9;&#9;&#9;Smash(hit.Parent,0,5)
&#9;&#9;end
&#9;end
&#9;if hit.Name == &quot;Window&quot; then
&#9;&#9;if Tool.Enabled == false then
&#9;&#9;hit:BreakJoints()
&#9;&#9;hit.Anchored = false
&#9;&#9;end
&#9;end
end&#9;&#9;

Tool.Enabled = true
local last_attack = 0
function onActivated()

&#9;if not Tool.Enabled then
&#9;&#9;return
&#9;end

&#9;Tool.Enabled = false

&#9;local character = Tool.Parent;
&#9;local humanoid = character.Humanoid
&#9;if humanoid == nil then
&#9;&#9;print(&quot;Humanoid not found&quot;)
&#9;&#9;return 
&#9;end

&#9;lunge()
&#9;wait(5)
&#9;Tool.Enabled = true
&#9;hitting = false
end


function onEquipped()
&#9;--UnsheathSound:play()
end


script.Parent.Activated:connect(onActivated)
script.Parent.Equipped:connect(onEquipped)


connection = sword.Touched:connect(blow)


</ProtectedString>
					</Properties>
				</Item>
