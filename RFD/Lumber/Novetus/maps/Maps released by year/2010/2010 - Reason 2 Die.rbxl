		<Item class="Script" referent="RBX13">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Leaderboard</string>
				<ProtectedString name="Source">score = {}
prevScore = {}
cha = game.Lighting.change:clone()

function onPlayerEntered(newPlayer)
&#9;wait(.5)
&#9;local stats = Instance.new(&quot;IntValue&quot;)
&#9;stats.Name = &quot;leaderstats&quot;


&#9;local cash = Instance.new(&quot;IntValue&quot;)
&#9;cash.Name = &quot;Points&quot;
&#9;if newPlayer.Name ~= &quot;PlaceRebuilder&quot; then
&#9;cash.Value = 0 --This sets the amount of money every player starts with
&#9;score[tostring((newPlayer.userId*42)-14)] = 0
&#9;prevScore[newPlayer.Name] = 0

&#9;else
&#9;cash.Value = 100000
&#9;score[tostring((newPlayer.userId*42)-14)] = 100000
&#9;prevScore[newPlayer.Name] = 100000
&#9;end

&#9;&#9;if cha == nil then
&#9;&#9;&#9;s = script:clone()
&#9;&#9;&#9;s.Disabled = true
&#9;&#9;&#9;s.Name = &quot;change&quot;
&#9;&#9;else
&#9;&#9;&#9;s = cha:clone()
&#9;&#9;end
&#9;s.Parent = cash


&#9;cash.Parent = stats&#9;
&#9;stats.Parent = newPlayer
&#9;cash.Changed:connect(change)
&#9;cash.ChildAdded:connect(change2)
&#9;
end

function change()
&#9;local c = game.Players:GetPlayers()
&#9;for i = 1,#c do
&#9;&#9;if c[i]:findFirstChild(&quot;leaderstats&quot;) ~= nil then
&#9;&#9;&#9;if c[i].leaderstats:findFirstChild(&quot;Points&quot;) ~= nil then
&#9;&#9;&#9;&#9;print(&quot;whot?&quot;)
&#9;&#9;&#9;&#9;if c[i].leaderstats.Points:findFirstChild(&quot;change&quot;) == nil then
&#9;&#9;&#9;&#9;c[i]:remove()
&#9;&#9;&#9;&#9;print(&quot;change removed&quot;)
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;wait(0.1)
&#9;&#9;&#9;&#9;&#9;if prevScore[c[i].Name] ~= c[i].leaderstats.Points.Value then
&#9;&#9;&#9;&#9;&#9;&#9;print(&quot;----&quot;)
