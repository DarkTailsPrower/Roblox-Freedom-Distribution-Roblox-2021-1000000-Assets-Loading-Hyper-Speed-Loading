						<Item class="SpecialMesh" referent="RBX3564">
							<Properties>
								<token name="LODX">2</token>
								<token name="LODY">2</token>
								<Content name="MeshId"><url>http://www.roblox.com/asset/?id=10470609</url></Content>
								<token name="MeshType">5</token>
