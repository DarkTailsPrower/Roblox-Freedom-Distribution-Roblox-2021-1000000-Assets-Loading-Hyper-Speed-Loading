					<Item class="Script" referent="RBX4732">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">function boom()
script.Parent.Anchored = false
script.Parent:BreakJoints()
stuff = game.Lighting.Peices
stuff:clone().Parent = game.Workspace
--script.Parent.Velocity = Vector3.new(20,1000,0)
--script.Parent.RotVelocity = Vector3.new(10,30,39)
&#9;local sound = Instance.new(&quot;Sound&quot;)
&#9;&#9;sound.SoundId = &quot;rbxasset://sounds\\Rocket shot.wav&quot;
&#9;&#9;sound.Parent = script.Parent
&#9;&#9;sound.Volume = 1
&#9;&#9;sound:play()
local ex = Instance.new(&quot;Explosion&quot;)
ex.Parent = game.Workspace
ex.BlastRadius = 30
ex.BlastPressure = 1000000
ex.Position = script.Parent.Position
&#9;local sound = Instance.new(&quot;Sound&quot;)
&#9;&#9;sound.SoundId = &quot;rbxasset://sounds\\Rocket shot.wav&quot;
&#9;&#9;sound.Parent = script.Parent
&#9;&#9;sound.Volume = 1
&#9;&#9;sound:play()
local ex2 = Instance.new(&quot;Explosion&quot;)
ex2.Parent = game.Workspace
ex2.BlastRadius = 30
ex2.BlastPressure = 1000
ex2.Position = ex.Position + Vector3.new(15,0,0)
local ex3 = Instance.new(&quot;Explosion&quot;)
ex3.Parent = game.Workspace
ex3.BlastRadius = 30
ex3.BlastPressure = 1000
ex3.Position = ex.Position + Vector3.new(-15,0,0)
local ex4 = Instance.new(&quot;Explosion&quot;)
ex4.Parent = game.Workspace
ex4.BlastRadius = 30
ex4.BlastPressure = 1000
ex4.Position = ex.Position + Vector3.new(30,0,0)
&#9;local sound = Instance.new(&quot;Sound&quot;)
&#9;&#9;sound.SoundId = &quot;rbxasset://sounds\\Rocket shot.wav&quot;
&#9;&#9;sound.Parent = script.Parent
&#9;&#9;sound.Volume = 10
&#9;&#9;sound:play()
local ex5 = Instance.new(&quot;Explosion&quot;)
ex5.Parent = game.Workspace
ex5.BlastRadius = 30
ex5.BlastPressure = 1000
ex5.Position = ex.Position + Vector3.new(-30,0,0)
wait(0.3)
&#9;local sound = Instance.new(&quot;Sound&quot;)
&#9;&#9;sound.SoundId = &quot;rbxasset://sounds\\Rocket shot.wav&quot;
&#9;&#9;sound.Parent = script.Parent
&#9;&#9;sound.Volume = 1
&#9;&#9;sound:play()

wait(20)
stuff:remove()
if script.Parent ~= nil then
script.Parent:Remove()
end
end

function x(hit)
if hit.Name == &quot;Paintball&quot; or hit.Name == &quot;Fire&quot; then
script.Parent.hp.Value = script.Parent.hp.Value - 1
if script.Parent.hp.Value == 0 then
script.Parent.CanCollide = false
boom()
wait(3)
script.Parent.CanCollide = true
end
end
end
script.Parent.Touched:connect(x)</ProtectedString>
