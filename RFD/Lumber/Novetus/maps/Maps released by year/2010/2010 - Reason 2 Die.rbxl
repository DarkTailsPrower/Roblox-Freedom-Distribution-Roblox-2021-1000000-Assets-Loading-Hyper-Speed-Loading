								<string name="Name">PelletScript</string>
								<ProtectedString name="Source">pellet = script.Parent
damage = 100
local fire = game.Lighting.Fire:clone()
ok = true
function onTouched()
&#9;if ok == true then
&#9;ok = false
&#9;local pos = script.Parent.Position
&#9;script.Parent:remove()
&#9;&#9;for x = 1,30 do
&#9;&#9;&#9;wait(0.2)
&#9;&#9;&#9;local s = fire:clone()
&#9;&#9;&#9;s.Script.Disabled = false
&#9;&#9;&#9;s.Script2.Disabled = false
&#9;&#9;&#9;s.Parent = game.Workspace
&#9;&#9;&#9;s.Position = pos + Vector3.new(0,1,0)&#9;
&#9;&#9;&#9;vx = math.random(-10,10)
&#9;&#9;&#9;vz = math.random(-10,10)
&#9;&#9;&#9;s.Velocity = Vector3.new(vx,10,vz)
&#9;&#9;&#9;s.RotVelocity = Vector3.new(vx,vx,vz)
&#9;&#9;end
&#9;&#9;pellet:remove()
&#9;end
end&#9;

connection = pellet.Touched:connect(onTouched)</ProtectedString>
