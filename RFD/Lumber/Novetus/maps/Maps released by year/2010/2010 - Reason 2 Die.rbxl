				<Item class="StringValue" referent="RBX6561">
					<Properties>
						<string name="Name">State</string>
						<string name="Value">arrive</string>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX6562">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">var = script.Parent.State.Value
script.Parent.BodyPosition.position = script.Parent.Position
while true do
wait(0.1)
&#9;if script.Parent.State.Value == &quot;arrive&quot; then
&#9;script.Parent.BodyPosition.position = script.Parent.BodyPosition.position + Vector3.new(1,-0.2,0)

&#9;end
&#9;if script.Parent.State.Value == &quot;stay&quot; then 
&#9;script.Parent.BodyPosition.position = script.Parent.BodyPosition.position
&#9;script.Parent.Parent.door.Anchored = true
&#9;&#9;else if script.Parent.State.Value == &quot;leave&quot; then
&#9;&#9;local door = script.Parent.Parent.door
&#9;&#9;door.Transparency = 0
&#9;&#9;door.CanCollide = true
&#9;&#9;door.Anchored = false
&#9;&#9;&#9;else if script.Parent.State.Value == &quot;leave2&quot; then
&#9;&#9;&#9;&#9;script.Parent.BodyPosition.position = script.Parent.BodyPosition.position + Vector3.new(1,0.6,0)
&#9;&#9;&#9;&#9;if script.Parent.BodyPosition.position.y &gt; 130 then
&#9;&#9;&#9;&#9;script.Parent.BodyPosition.position = script.Parent.BodyPosition.position + Vector3.new(0,-0.6,0)
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end
</ProtectedString>
					</Properties>
				</Item>
			</Item>
