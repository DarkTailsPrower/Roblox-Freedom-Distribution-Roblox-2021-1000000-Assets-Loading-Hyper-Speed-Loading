						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">AmmoScript</string>
						<ProtectedString name="Source">Tool = script.Parent 
function change()

Tool.Name= &quot;[&quot;..script.Ammo.Value..&quot;] [&quot;..script.Clip.Value..&quot;]&quot;
end

script.Ammo.Changed:connect(change)
script.Clip.Changed:connect(change)
</ProtectedString>
