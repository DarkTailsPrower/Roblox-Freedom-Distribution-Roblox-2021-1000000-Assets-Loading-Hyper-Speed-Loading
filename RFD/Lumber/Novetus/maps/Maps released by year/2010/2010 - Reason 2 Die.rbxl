				<string name="Name">LeaveScene5</string>
				<ProtectedString name="Source">local player = game.Players.LocalPlayer
&#9;&#9;&#9;local camera = game.Workspace.gameCam5
&#9;&#9;&#9;local cam = game.Workspace.CurrentCamera
