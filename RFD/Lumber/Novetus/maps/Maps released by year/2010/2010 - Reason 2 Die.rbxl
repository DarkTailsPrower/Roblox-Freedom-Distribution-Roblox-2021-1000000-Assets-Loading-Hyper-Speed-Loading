				<Item class="Script" referent="RBX193">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">AmmoNear</string>
						<ProtectedString name="Source">clips = 5
function e()
if script.Parent.Punshing.Value == true then
&#9;&#9;if game.Workspace:findFirstChild(&quot;BloxcoastCity&quot;) ~= nil then
&#9;&#9;local s = game.Workspace.BloxcoastCity.AmmoGivers:GetChildren()
&#9;&#9;&#9;for x = 1,#s do
&#9;&#9;&#9;local dist= (script.Parent.Handle.Position-s[x].Position).magnitude
&#9;&#9;&#9;&#9;if dist &lt; 5 then
&#9;&#9;&#9;&#9;script.Parent.AmmoScript.Clip.Value = clips
&#9;&#9;&#9;&#9;script.Parent.Handle.Reload:Play()
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;if game.Workspace:findFirstChild(&quot;StudHarvest&quot;) ~= nil then
&#9;&#9;local s = game.Workspace.StudHarvest.AmmoGivers:GetChildren()
&#9;&#9;&#9;for x = 1,#s do
&#9;&#9;&#9;local dist= (script.Parent.Handle.Position-s[x].Position).magnitude
&#9;&#9;&#9;&#9;if dist &lt; 5 then
&#9;&#9;&#9;&#9;script.Parent.AmmoScript.Clip.Value = clips
&#9;&#9;&#9;&#9;script.Parent.Handle.Reload:Play()
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;if game.Workspace:findFirstChild(&quot;Farmhouse&quot;) ~= nil then
&#9;&#9;local s = game.Workspace.Farmhouse.AmmoGivers:GetChildren()
&#9;&#9;&#9;for x = 1,#s do
&#9;&#9;&#9;local dist= (script.Parent.Handle.Position-s[x].Position).magnitude
&#9;&#9;&#9;&#9;if dist &lt; 5 then
&#9;&#9;&#9;&#9;script.Parent.AmmoScript.Clip.Value = clips
&#9;&#9;&#9;&#9;script.Parent.Handle.Reload:Play()
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;if game.Workspace:findFirstChild(&quot;BloxHarbor&quot;) ~= nil then
&#9;&#9;local s = game.Workspace.BloxHarbor.AmmoGivers:GetChildren()
&#9;&#9;&#9;for x = 1,#s do
&#9;&#9;&#9;local dist= (script.Parent.Handle.Position-s[x].Position).magnitude
&#9;&#9;&#9;&#9;if dist &lt; 5 then
&#9;&#9;&#9;&#9;script.Parent.AmmoScript.Clip.Value = clips
&#9;&#9;&#9;&#9;script.Parent.Handle.Reload:Play()
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end

&#9;&#9;if game.Workspace:findFirstChild(&quot;SmokerVille&quot;) ~= nil then
&#9;&#9;local s = game.Workspace.SmokerVille.AmmoGivers:GetChildren()
&#9;&#9;&#9;for x = 1,#s do
&#9;&#9;&#9;local dist= (script.Parent.Handle.Position-s[x].Position).magnitude
&#9;&#9;&#9;&#9;if dist &lt; 5 then
&#9;&#9;&#9;&#9;script.Parent.AmmoScript.Clip.Value = clips
&#9;&#9;&#9;&#9;script.Parent.Handle.Reload:Play()
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;if game.Workspace:findFirstChild(&quot;ForbiddenWaters&quot;) ~= nil then
&#9;&#9;local s = game.Workspace.ForbiddenWaters.AmmoGivers:GetChildren()
&#9;&#9;&#9;for x = 1,#s do
&#9;&#9;&#9;local dist= (script.Parent.Handle.Position-s[x].Position).magnitude
&#9;&#9;&#9;&#9;if dist &lt; 5 then
&#9;&#9;&#9;&#9;script.Parent.AmmoScript.Clip.Value = clips
&#9;&#9;&#9;&#9;script.Parent.Handle.Reload:Play()
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
local player = game.Players:GetChildren()
for x = 1,5 do
wait(0.1)
for i = 1,#player do
if player[i].TeamColor == BrickColor.new(&quot;Bright green&quot;) then
if player[i].Character ~= nil then
local pos = player[i].Character.Torso.Position
local pos2 = script.Parent.Handle.Position
local dist = (pos-pos2).magnitude
if dist &lt;3 then
if player[i].Character:findFirstChild(&quot;TankHead&quot;) ~= nil then return end
player[i].Character.Zombie.Sit = true
player[i].Character.Torso.RotVelocity = Vector3.new(70,30,50)
player[i].Character.Zombie.Health = player[i].Character.Zombie.Health - 2
player[i].Character.Torso.Velocity = script.Parent.Parent.Torso.CFrame.lookVector * 20
end
end
end
end
end

end
end

script.Parent.Punshing.Changed:connect(e)</ProtectedString>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX194">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Paintball</string>
						<ProtectedString name="Source">ball = script.Parent
damage = 25

function makeblood(hit)
script.Parent.Velocity = hit.Velocity + Vector3.new(hit.Velocity.x/2,hit.Velocity.y,hit.Velocity.z/2)
--script.Parent.CanCollide = false
script.Parent.BrickColor = BrickColor.new(&quot;Bright red&quot;)
script.Parent.formFactor = 2
script.Parent.Size = Vector3.new(1,0.2,1)
script.Parent.Name = &quot;blood&quot;
script.Parent.Reflectance = 0
script.Parent.BodyForce:remove()
script.Parent.Bullet:remove()
script.Parent.CFrame = hit.CFrame
connection:disconnect()
wait(3)
script.Parent.CanCollide = false
script:remove()
end

function onTouched(hit)
&#9;local humanoid = hit.Parent:findFirstChild(&quot;Zombie&quot;)


&#9;if humanoid ~= nil then
&#9;&#9;humanoid.Health = humanoid.Health - damage
&#9;&#9;if humanoid:FindFirstChild(&quot;Killa&quot;) ~= nil then
&#9;&#9;&#9;humanoid.Killa.Value = script.Parent.Shooter.Value
&#9;&#9;end
&#9;&#9;makeblood(hit)
&#9;&#9;else
&#9;&#9;if hit.CanCollide == false then return end
&#9;end

&#9;connection:disconnect()
&#9;if script.Parent.Name ~= &quot;blood&quot; then
&#9;ball.Parent = nil
&#9;end
end

connection = ball.Touched:connect(onTouched)

wait(0.5)
ball.Parent = nil</ProtectedString>
