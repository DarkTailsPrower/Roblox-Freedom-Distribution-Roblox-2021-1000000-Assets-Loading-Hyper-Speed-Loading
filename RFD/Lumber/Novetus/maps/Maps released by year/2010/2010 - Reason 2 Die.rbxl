							<ProtectedString name="Source">local Tool = script.Parent;

enabled = true

function clicked(key)
&#9;if (key~=nil) then
&#9;&#9;key = key:lower()
&#9;&#9;print(key)
&#9;&#9;if (key==&quot;e&quot;) then
&#9;&#9;&#9;local p = game.Players:GetChildren()
&#9;&#9;&#9;for i = 1,#p do
&#9;&#9;&#9;local player = game.Workspace:findFirstChild(p[i].Name)
&#9;&#9;&#9;&#9;if player ~= nil  then --and p[i].TeamColor == BrickColor.new(&quot;Bright blue&quot;)
&#9;&#9;&#9;&#9;&#9;local torso = Tool.Parent:FindFirstChild(&quot;Torso&quot;)
&#9;&#9;&#9;&#9;&#9;if torso ~= nil and player:FindFirstChild(&quot;Torso&quot;) ~= nil  then
&#9;&#9;&#9;&#9;&#9;&#9;local dist = (torso.Position-player.Torso.Position).magnitude
&#9;&#9;&#9;&#9;&#9;&#9;if dist &lt;3 and player ~= Tool.Parent then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;if script.Parent.Amo.Value &gt;0 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;script.Parent.Parent.Torso[&quot;Right Shoulder&quot;].CurrentAngle = script.Parent.Parent.Torso[&quot;Right Shoulder&quot;].CurrentAngle - 0.5
&#9;&#9;&#9;&#9;&#9;&#9;&#9;Heal(player)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;script.Parent.Amo.Value = script.Parent.Amo.Value - 1
&#9;&#9;&#9;&#9;&#9;&#9;&#9;wait(0)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;Tool.Parent = nil
&#9;&#9;&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;&#9;Tool.Parent = nil
&#9;&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

function Heal(vCharacter )

&#9;local childs = vCharacter:GetChildren()

&#9;local colors = {}

&#9;for i=1,#childs do
&#9;&#9;if (childs[i].className == &quot;Part&quot;) then
&#9;&#9;&#9;colors[i] = childs[i].BrickColor
&#9;&#9;&#9;childs[i].BrickColor = BrickColor.new(1)
&#9;&#9;end
&#9;end

&#9;wait(1)

&#9;local human = vCharacter:FindFirstChild(&quot;Humanoid&quot;)
&#9;if (human ~= nil) then
&#9;&#9;human.Health = human.MaxHealth
&#9;end

&#9;for i=1,#childs do
&#9;&#9;if (childs[i].className == &quot;Part&quot;) then
&#9;&#9;&#9;childs[i].BrickColor = colors[i]
&#9;&#9;end
&#9;end


end



function onEquippedLocal(mouse)

&#9;if mouse == nil then
&#9;&#9;print(&quot;Mouse not found&quot;)
&#9;&#9;return 
&#9;end

&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
&#9;mouse.KeyDown:connect(clicked)
end


Tool.Equipped:connect(onEquippedLocal)
</ProtectedString>
