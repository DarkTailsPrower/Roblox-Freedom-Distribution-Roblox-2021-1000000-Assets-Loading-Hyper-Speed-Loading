					<Item class="Script" referent="RBX6741">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script2</string>
							<ProtectedString name="Source">function x(hit)
x = script.Parent.Velocity.x
if x &lt;0 then
x = -x
