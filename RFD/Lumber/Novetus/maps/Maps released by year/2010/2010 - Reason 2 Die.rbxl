				<Item class="Script" referent="RBX79">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">PaintballShooter</string>
						<ProtectedString name="Source">local kTool = script.Parent
local kBVeloc = 500

function fire(v)

&#9;kTool.Handle.Fire:play()
&#9;
&#9;local vCharacter = kTool.Parent
&#9;local vPlayer = game.Players:playerFromCharacter(vCharacter)

&#9;local kBullet = Instance.new(&quot;Part&quot;)

&#9;local SpawnPos = kTool.Handle.Position
&#9;SpawnPos  = SpawnPos + (v * 5)

&#9;kBullet.Position = SpawnPos
&#9;kBullet.Size = Vector3.new(1,1,1)
&#9;kBullet.Velocity = v * kBVeloc
&#9;kBullet.BrickColor = BrickColor.new(26)
&#9;kBullet.Shape = 0
&#9;kBullet.BottomSurface = 0
&#9;kBullet.TopSurface = 0
&#9;kBullet.Name = &quot;Bullet&quot;
&#9;kBullet.Elasticity = 0
&#9;kBullet.Reflectance = 0
&#9;kBullet.Friction = 1

&#9;local NewScript = script.Parent.Paintball:clone()
&#9;NewScript.Disabled = false
&#9;NewScript.Parent = kBullet

&#9;local CreatorTag = Instance.new(&quot;StringValue&quot;)
&#9;CreatorTag.Value = vPlayer.Name
&#9;CreatorTag.Name = &quot;creator&quot;
&#9;CreatorTag.Parent = kBullet
&#9;
&#9;kBullet.Parent = workspace
&#9;
end

function check()

&#9;if (kTool.Enabled == false) then return false
&#9;elseif (kTool.Enabled == true) then return true 
&#9;end

end

function onActivated()

&#9;if not kTool.Enabled then return end

&#9;local Character = kTool.Parent
&#9;local Humanoid = Character:findFirstChild(&quot;Humanoid&quot;)
&#9;if Humanoid == nil then return end

&#9;local TargetPos = Humanoid.TargetPoint
&#9;local LookAt = (TargetPos - Character.Head.Position).unit
&#9;
&#9;if (check()) then
&#9;&#9;fire(LookAt)
&#9;&#9;wait(0.1)
&#9;&#9;onActivated()
&#9;end

end

kTool.Activated:connect(onActivated)</ProtectedString>
					</Properties>
				</Item>
				<Item class="LocalScript" referent="RBX80">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Local Gui</string>
						<ProtectedString name="Source">local Tool = script.Parent;

enabled = true
function onButton1Down(mouse)
&#9;if not enabled then
&#9;&#9;return
&#9;end
&#9;enabled = true
&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;

end


function onButton1Up(mouse)
enabled = false
Tool.Enabled = false
mouse.Icon = &quot;rbxasset://textures\\GunWaitCursor.png&quot;
wait(2.2)
mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
enabled = true
Tool.Enabled = true
end


function clickedButton(key)
&#9;if key == &quot;-&quot;then
&#9;Tool.GripForward = Vector3.new(0,0,1)
&#9;local s = game.Lighting.Punch:clone()
&#9;s.Parent = Tool.Handle
&#9;wait(0.7)
&#9;Tool.GripForward = Vector3.new(1, -0, 1e-037)
&#9;s:remove()
&#9;end
end

function onEquippedLocal(mouse)

&#9;if mouse == nil then
&#9;&#9;print(&quot;Mouse not found&quot;)
&#9;&#9;return 
&#9;end
&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)&#9;
&#9;mouse.Button1Up:connect(function() onButton1Up(mouse)end)
&#9;mouse.KeyDown:connect(clickedButton)
end


Tool.Equipped:connect(onEquippedLocal)
</ProtectedString>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX81">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Paintball</string>
						<ProtectedString name="Source">ball = script.Parent

damage = 20
function onTouched(hit)

&#9;local humanoid = hit.Parent:findFirstChild(&quot;ZombieH&quot;)
&#9;if humanoid ~= nil then
&#9;humanoid.Health = humanoid.Health - damage
&#9;connection:disconnect()
&#9;ball.Parent = nil
&#9;end
end


connection = ball.Touched:connect(onTouched)



wait(2)

ball.Parent = nil</ProtectedString>
					</Properties>
				</Item>
			</Item>
