				<Item class="Script" referent="RBX4897">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">openDoor = false
function open()
print(&quot;open&quot;)
script.Parent.Bod.force = Vector3.new(0,50000,30000)
end

function close()
print(&quot;close&quot;)
script.Parent.Bod.force = Vector3.new(0,0,0)
end

function start()
print(&quot;clicked&quot;)
if openDoor == false then
open()
openDoor = true
else
close()
openDoor = false
end
end

script.Parent.ClickDetector.MouseClick:connect(start)

</ProtectedString>
