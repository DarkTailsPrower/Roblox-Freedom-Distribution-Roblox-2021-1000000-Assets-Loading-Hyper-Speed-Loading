function spwn(newPlayer) 
local Team = game.Players:findFirstChild(newPlayer.Name)
&#9;if Team == nil then return end
&#9;if gameOn == true then
&#9;char = Team.Character

&#9;Team.TeamColor = BrickColor.new(&quot;Bright green&quot;)
&#9;&#9;if char:findFirstChild(&quot;Humanoid&quot;) ~= nil then
&#9;&#9;char.Humanoid.WalkSpeed = 19
&#9;&#9;char.Humanoid.Name = &quot;Zombie&quot;
&#9;&#9;&#9;local s = game.Lighting.Zomb:clone()
&#9;&#9;&#9;s.Disabled = false
&#9;&#9;&#9;s.Parent = char.Zombie
&#9;&#9;&#9;local cash = Instance.new(&quot;StringValue&quot;)
&#9;&#9;&#9;cash.Name = &quot;Killa&quot;
&#9;&#9;&#9;cash.Value = &quot;&quot;
&#9;&#9;&#9;cash.Parent = char.Zombie
&#9;&#9;end
&#9;if char:findFirstChild(&quot;Torso&quot;) ~= nil then
&#9;&#9;if char.Torso:FindFirstChild(&quot;roblox&quot;) ~= nil then
&#9;&#9;char.Torso.roblox:remove()
&#9;&#9;end
&#9;end
&#9;char.Head.Transparency = 1
&#9;nh = game.Lighting.NewHead:clone()
&#9;nh.Parent = char
&#9;local weld = Instance.new(&quot;Weld&quot;) 
&#9;weld.Part0 = nh
&#9;weld.Part1 = char.Head
&#9;weld.C0 = CFrame.new(0,0,0)
&#9;weld.C1 = CFrame.new(0,0,0)
&#9;weld.Parent = nh
&#9;local ZT = math.random(1,20)
&#9;if ZT ~= 20 then
&#9;&#9;scri = game.Lighting.ZombieAnimate:clone()
&#9;&#9;scri.Parent = char
&#9;&#9;local z = game.Lighting.ZombP:clone()
&#9;&#9;z.Disabled = false
&#9;&#9;z.Parent = char.Zombie
&#9;else
&#9;&#9;local z = game.Lighting.ZombP2:clone()
&#9;&#9;z.Disabled = false
&#9;&#9;z.Parent = char.Zombie
&#9;local scri = game.Lighting.TankAnimate:clone()
&#9;scri.Parent = char
&#9;end


&#9;&#9;if ZT &lt;8 then
&#9;&#9;game.Lighting.Zombie:clone().Parent = game.Players:FindFirstChild(char.Name).Backpack
&#9;&#9;&#9;else if ZT &gt;7 and ZT &lt;12 then
&#9;&#9;&#9;print(&quot;making hunter&quot;)
&#9;&#9;&#9;MakeHunter(char)
&#9;&#9;&#9;&#9;else if ZT &gt;11 and ZT &lt;16 then
&#9;&#9;&#9;&#9;MakeBoomer(char)&#9;
&#9;&#9;&#9;&#9;&#9;else if ZT &gt;15 and ZT &lt;20 then
&#9;&#9;&#9;&#9;&#9;MakeSmoker(char)
&#9;&#9;&#9;&#9;&#9;&#9;else if ZT == 20 then
&#9;&#9;&#9;&#9;&#9;&#9;MakeTank(char)
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;local peps = count_survivors()
&#9;&#9;if peps == &quot;&quot; then
&#9;&#9;endgame = true
&#9;&#9;endgame2 = true
&#9;&#9;end
&#9;end
&#9;if Team ~= nil and gameOn == false then
&#9;Team.TeamColor = BrickColor.new(&quot;Bright blue&quot;)
&#9;local health =  newPlayer:findFirstChild(&quot;Health&quot;)
&#9;&#9;if health ~= nil then
&#9;&#9;&#9;health:remove()
&#9;&#9;end
&#9;&#9;game.Lighting.dScream:clone().Parent = newPlayer.Head
&#9;&#9;game.Lighting.humanDeath:clone().Parent = newPlayer.Humanoid
&#9;end
end 

function leave()
&#9;local peps = count_survivors()
&#9;if peps == &quot;&quot; then
&#9;endgame = true
&#9;endgame2 = true
&#9;end
&#9;local peps2 = count_zombies()
&#9;if peps2 == &quot;&quot; then
&#9;&#9;endgame = true
&#9;end
end




function onChatted(msg, recipient, speaker) 

-- convert to all lower case 

local source = speaker.Name
msg = string.lower(msg) 
if (msg == &quot;test&quot;) then 
local player = game.Workspace:findFirstChild(source)
if player ~= nil then
game.Lighting.TestBoard:clone().Parent = player
end
end
if (msg == &quot;reset&quot;) then 
wait(10)
local player = game.Workspace:findFirstChild(source)
if player ~= nil then
if player:findFirstChild(&quot;Head&quot;) ~= nil then
player.Head:remove()
end
end
end
if (msg == &quot;francis&quot;) then 
local player = game.Players:findFirstChild(source)
if player ~= nil then
player.Type.Value = &quot;Francis&quot;
end
end
if (msg == &quot;zoey&quot;) then 
local player = game.Players:findFirstChild(source)
if player ~= nil then
player.Type.Value = &quot;Zoey&quot;
end
end
if (msg == &quot;louis&quot;) then 
local player = game.Players:findFirstChild(source)
if player ~= nil then
player.Type.Value = &quot;Louis&quot;
end
end
if (msg == &quot;bill&quot;) then 
local player = game.Players:findFirstChild(source)
if player ~= nil then
player.Type.Value = &quot;Bill&quot;
end
end
if (msg == &quot;shovel&quot;) then 
local player = game.Players:findFirstChild(source)
if player ~= nil then
player.Melee.Value = &quot;Shovel&quot;
end
end
if (msg == &quot;hammer&quot;) then 
local player = game.Players:findFirstChild(source)
if player ~= nil then
player.Melee.Value = &quot;Hammer&quot;
end
end
if (msg == &quot;tinpot&quot;) then 
local player = game.Players:findFirstChild(source)
if player ~= nil then
player.Melee.Value = &quot;TinPot&quot;
end
end
if ( msg == &quot;fixcam&quot;) then
game.Workspace.CurrentCamera:remove()
game.Workspace:findFirstChild(source):BreakJoints()
end

if (msg == &quot;buy/van&quot;) then
local player2 = game.Players:FindFirstChild(source)
local player = game.Workspace:findFirstChild(source)
if player2 ~= nil and player ~= nil then
&#9;if player2:FindFirstChild(&quot;leaderstats&quot;) ~= nil then
&#9;&#9;if player2.leaderstats:FindFirstChild(&quot;Points&quot;) ~= nil and player:FindFirstChild(&quot;Torso&quot;) ~= nil then
&#9;&#9;&#9;if player2.leaderstats.Points.Value&lt;50 then return end
&#9;&#9;&#9;cashOut(source,player2.leaderstats.Points.Value-50)
&#9;&#9;&#9;local van = game.Lighting.Van:clone()
&#9;&#9;&#9;van.Parent = game.Workspace
&#9;&#9;&#9;van:MakeJoints()
&#9;&#9;&#9;van:MoveTo(player.Torso.Position + player.Torso.CFrame.lookVector*15)
&#9;&#9;end
&#9;end
end
end

if (msg == &quot;buy/sniper&quot;) then
local player2 = game.Players:FindFirstChild(source)
local player = game.Workspace:findFirstChild(source)
if player2 ~= nil and player ~= nil then
&#9;if player2:FindFirstChild(&quot;leaderstats&quot;) ~= nil then
&#9;&#9;if player2.leaderstats:FindFirstChild(&quot;Points&quot;) ~= nil and player:FindFirstChild(&quot;Torso&quot;) ~= nil then
&#9;&#9;&#9;if player2.leaderstats.Points.Value&lt;30 then return end
&#9;&#9;&#9;cashOut(source,player2.leaderstats.Points.Value-30)
&#9;&#9;&#9;local van = game.Lighting.Guns.Sniper:clone()
&#9;&#9;&#9;van.Parent = player2.Backpack
&#9;&#9;end
&#9;end
end
end

if (msg == &quot;buy/car&quot;) then
local player2 = game.Players:FindFirstChild(source)
local player = game.Workspace:findFirstChild(source)
if player2 ~= nil and player ~= nil then
&#9;if player2:FindFirstChild(&quot;leaderstats&quot;) ~= nil then
&#9;&#9;if player2.leaderstats:FindFirstChild(&quot;Points&quot;) ~= nil and player:FindFirstChild(&quot;Torso&quot;) ~= nil then
&#9;&#9;&#9;if player2.leaderstats.Points.Value&lt;35 then return end
&#9;&#9;&#9;cashOut(source,player2.leaderstats.Points.Value-35)
&#9;&#9;&#9;local van = game.Lighting.Car:clone()
&#9;&#9;&#9;van.Parent = game.Workspace
&#9;&#9;&#9;van:MakeJoints()
&#9;&#9;&#9;van:MoveTo(player.Torso.Position + player.Torso.CFrame.lookVector*15)
&#9;&#9;end
&#9;end
end
end

end


function added(player)
local type = Instance.new(&quot;StringValue&quot;)
type.Parent = player
type.Name = &quot;Type&quot;
type.Value = &quot;Francis&quot;
local type2 = Instance.new(&quot;StringValue&quot;)
type2.Parent = player
type2.Name = &quot;Melee&quot;
type2.Value = &quot;None&quot;

player.Chatted:connect(function(msg, recipient) onChatted(msg, recipient, player) end) 
end


