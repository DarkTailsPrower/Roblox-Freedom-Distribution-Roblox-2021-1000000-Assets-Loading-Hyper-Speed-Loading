&#9;&#9;&#9;if timedone == 0 then
&#9;&#9;&#9;&#9;res = math.random(1,3)
&#9;&#9;&#9;&#9;if res == 3 then
&#9;&#9;&#9;&#9;msg.Text = &quot;Rescue is arriving! Hurry to train station to get picked up!&quot;
