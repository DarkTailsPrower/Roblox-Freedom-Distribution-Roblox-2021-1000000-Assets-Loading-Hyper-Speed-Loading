		<Item class="Script" referent="RBX575">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">humanDeath</string>
				<ProtectedString name="Source">part = Instance.new(&quot;Part&quot;)
part.BrickColor = BrickColor.new(&quot;Bright red&quot;)
part.formFactor = 2
part.Size  =Vector3.new(1,0.2,1)
part.CanCollide = false

function x()
script.Parent.Parent.Head.dScream:Play()
game.Lighting.dead:clone().Parent = script.Parent.Parent
for x = 1,5 do
local blood = part:clone()
blood.Parent = script.Parent.Parent
blood.CFrame = script.Parent.Parent.Head.CFrame
blood.Velocity = script.Parent.Parent.Head.Velocity + Vector3.new(math.random(-10,10),50,math.random(-10,10))
blood.RotVelocity = Vector3.new(math.random(-10,10),math.random(-10,10),math.random(-10,10))
end

end


script.Parent.Died:connect(x)</ProtectedString>
			</Properties>
