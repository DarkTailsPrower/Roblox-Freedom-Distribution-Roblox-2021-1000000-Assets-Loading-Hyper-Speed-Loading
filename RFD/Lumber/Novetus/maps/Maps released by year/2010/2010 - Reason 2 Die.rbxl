				<Item class="LocalScript" referent="RBX157">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Local Gui</string>
						<ProtectedString name="Source">local Tool = script.Parent;Reload = 0
Reload2 =0

enabled = true

function onButton1Up(mouse)
Tool.Enabled = false
wait(0.5)
Tool.Enabled = true
end

function onButton1Down(mouse)
&#9;if not enabled then
&#9;&#9;return
&#9;end

&#9;enabled = false
&#9;mouse.Icon = &quot;rbxasset://textures\\GunWaitCursor.png&quot;


&#9;wait(.5)

&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
&#9;enabled = true

end

function onKeyDown(key)
&#9;if (key~=nil) then
&#9;key = key:lower()
&#9;print(key)
&#9;&#9;if (key==&quot;r&quot;) and (Reload == 0) then
&#9;&#9;&#9;if script.Parent.AmmoScript.Ammo.Value &lt;8 and script.Parent.AmmoScript.Clip.Value ~= 0 then
&#9;&#9;&#9;Reload = 1
&#9;&#9;&#9;script.Parent.Handle.Reload:Play()
&#9;&#9;&#9;script.Parent.AmmoScript.Clip.Value = script.Parent.AmmoScript.Clip.Value - 1
&#9;&#9;&#9;script.Parent.AmmoScript.Ammo.Value = 22
&#9;&#9;&#9;wait(2)
&#9;&#9;&#9;Reload = 0
&#9;&#9;&#9;end
&#9;&#9;&#9;else if (key==&quot;-&quot;) and (Reload2 == 0) then
&#9;&#9;&#9;print(&quot;punching&quot;)
&#9;&#9;&#9;Reload2 = 1
&#9;&#9;&#9;script.Parent.Punshing.Value = true
&#9;&#9;&#9;script.Parent.Parent.Torso[&quot;Right Shoulder&quot;].CurrentAngle = script.Parent.Parent.Torso[&quot;Right Shoulder&quot;].CurrentAngle - 0.5
&#9;&#9;&#9;wait(0.5)
&#9;&#9;&#9;script.Parent.Punshing.Value = false&#9;
&#9;&#9;&#9;wait(5)
&#9;&#9;&#9;Reload2 = 0
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;
&#9;end
end


function onEquippedLocal(mouse)

&#9;if mouse == nil then
&#9;&#9;print(&quot;Mouse not found&quot;)
&#9;&#9;return 
&#9;end

&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;

&#9;mouse.Button1Up:connect(function() onButton1Up(mouse) end)
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
mouse.KeyDown:connect(onKeyDown)
end


Tool.Equipped:connect(onEquippedLocal)
</ProtectedString>
