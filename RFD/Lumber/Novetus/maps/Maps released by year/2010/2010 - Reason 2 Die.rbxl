					<Item class="Script" referent="RBX1856">
						<Properties>
							<bool name="Disabled">true</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Drain</string>
							<ProtectedString name="Source">msg = Instance.new(&quot;Message&quot;)
local player = game.Players:findFirstChild(script.Parent.Name)
msg.Parent = player

hp = Instance.new(&quot;NumberValue&quot;)
hp.Name = &quot;hpleft&quot;
hp.Parent = script
if script.Parent.Humanoid.Health + 70 &gt;100 then
hp.Value = 100-script.Parent.Humanoid.Health
else
hp.Value = 70
end
script.Parent.Humanoid.Health = script.Parent.Humanoid.Health +hp.Value
msg.Text = &quot;PillsHp left(&quot;..tostring(hp.Value)..&quot;)&quot;
takehp = 3
dead = false

while true do
wait(2.5)
&#9;if dead == true or script.Parent.Humanoid.Health-takehp &lt;1 or hp.Value &lt;1 then
&#9;msg:remove()
&#9;script:remove()
&#9;else
&#9;hp.Value = hp.Value-takehp
&#9;script.Parent.Humanoid.Health = script.Parent.Humanoid.Health-takehp
&#9;msg.Text = &quot;PillsHp left(&quot;..tostring(hp.Value)..&quot;)&quot;
&#9;end
end

function dead()
dead = true
end

script.Parent.Humanoid.Died:connect(dead)</ProtectedString>
