								<Vector3 name="Offset">
									<X>0</X>
									<Y>0</Y>
									<Z>0</Z>
								</Vector3>
								<Vector3 name="Scale">
									<X>0.899999976</X>
									<Y>0.800000012</Y>
									<Z>0.800000012</Z>
								</Vector3>
								<Content name="TextureId"><url>http://www.roblox.com/asset/?id=14689229</url></Content>
