&#9;&#9;&#9;s.Script.Disabled = false
&#9;&#9;&#9;s.Script2.Disabled = false
&#9;&#9;&#9;s.Parent = game.Workspace
&#9;&#9;&#9;s.Position = pos + Vector3.new(0,1,0)&#9;
