		<Item class="Script" referent="RBX7666">
			<Properties>
				<bool name="Disabled">true</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">change</string>
				<ProtectedString name="Source">val = script.Parent;
value = (script.Parent.Value*42)-14
function change()
&#9;if (script.Parent.Value*42)-14 ~= value then
&#9;&#9;if script.Parent.findFirstChild(&quot;code&quot;) ~= nil then
&#9;&#9;&#9;if script.Parent.code.Value == toString((script.Parent.Parent.Parent.userId*84)-32) then
&#9;&#9;&#9;&#9;value = (script.Parent.code.v.Value*42)-14
&#9;&#9;&#9;&#9;script.Parent.Value = value&#9;
&#9;&#9;&#9;&#9;script.Parent.v:remove()
&#9;&#9;&#9;end
&#9;&#9;else
&#9;&#9;&#9;script.Parent.Parent.Parent:remove()
&#9;&#9;end
&#9;end
end


val.Changed:connect(change)</ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX7667">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">ZombP</string>
				<ProtectedString name="Source">points = 1
function death()
&#9;if game.Players:findFirstChild(script.Parent.Killa.Value) ~= nil then
&#9;&#9;killer = game.Players:findFirstChild(script.Parent.Killa.Value)
&#9;&#9;local v = Instance.new(&quot;NumberValue&quot;)
&#9;&#9;v.Name = &quot;code&quot;
&#9;&#9;v.Value = (killer.userId*42)-14
&#9;&#9;local v2 = Instance.new(&quot;NumberValue&quot;)
&#9;&#9;v2.Name = &quot;v&quot;
&#9;&#9;v2.Value = killer.leaderstats.Points.Value + points
&#9;&#9;v2.Parent = v
&#9;&#9;v.Parent = killer.leaderstats.Points
&#9;end
end

script.Parent.Died:connect(death)</ProtectedString>
			</Properties>
