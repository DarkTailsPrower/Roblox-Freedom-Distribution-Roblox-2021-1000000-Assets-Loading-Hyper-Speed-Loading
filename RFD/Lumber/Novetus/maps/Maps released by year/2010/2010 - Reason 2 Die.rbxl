				<Item class="Script" referent="RBX382">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">var = 0

bin = script.Parent

function move(target)
&#9;local dir = (target.Position - bin.Position).unit
&#9;local spawnPos = bin.Position
&#9;local pos = spawnPos + (dir * 1)
&#9;bin:findFirstChild(&quot;BodyGyro&quot;).cframe = CFrame.new(pos,  pos + dir)
&#9;bin:findFirstChild(&quot;BodyGyro&quot;).maxTorque = Vector3.new(9000,9000,9000)
end

function moveTo(target)
&#9;bin.BodyPosition.position = target.Position + Vector3.new(0,-target.Position.y+18,0)
&#9;bin.BodyPosition.maxForce = Vector3.new(10000, 4e+013,10000) * 100
end


while true do
wait(0.1)
var = var + 1
if var == 42 then
script.Parent.BodyPosition.maxForce = Vector3.new(4e+013, 4e+013,4e+013)
end
if var == 42 then
wait(60)
move(game.Workspace.BloxcoastCity.BoatPath.Point1)
moveTo(game.Workspace.BloxcoastCity.BoatPath.Point1)
wait(2)
move(game.Workspace.BloxcoastCity.BoatPath.Point2)
moveTo(game.Workspace.BloxcoastCity.BoatPath.Point2)
wait(1)
move(game.Workspace.BloxcoastCity.BoatPath.Point3)
moveTo(game.Workspace.BloxcoastCity.BoatPath.Point3)
wait(1)
move(game.Workspace.BloxcoastCity.BoatPath.Point4)
moveTo(game.Workspace.BloxcoastCity.BoatPath.Point4)
wait(1)
move(game.Workspace.BloxcoastCity.BoatPath.Point5)
moveTo(game.Workspace.BloxcoastCity.BoatPath.Point5)
wait(1)
move(game.Workspace.BloxcoastCity.BoatPath.Point6)
moveTo(game.Workspace.BloxcoastCity.BoatPath.Point6)
wait(2)
bin.BodyPosition.maxForce = Vector3.new(0, 4e+013,0) 
end
end
</ProtectedString>
					</Properties>
				</Item>
			</Item>
