function MakeHunter(char)
if char:findFirstChild(&quot;GameOn&quot;) ~= nil then return end
script.GameOn:clone().Parent = char
local hood = game.Lighting.Hood:clone()
local fleshpart2 = hood
fleshpart2.Parent = char
local weld2 = Instance.new(&quot;Weld&quot;) 
weld2.Part0 = fleshpart2
weld2.Part1 = char.Head
weld2.C0 = CFrame.new(0,-0.5,0,-1,0,0,0,1,0,0,0,-1)
weld2.C1 = CFrame.new(0,0,0)
weld2.Parent = fleshpart2
game.Lighting.Hunter:clone().Parent = game.Players:FindFirstChild(char.Name).Backpack
char:findFirstChild(&quot;NewHead&quot;).BrickColor = BrickColor.new(&quot;Dark stone grey&quot;)
if char:FindFirstChild(&quot;BodyColors&quot;) ~= nil then
char.BodyColors:remove()
end
if char:findFirstChild(&quot;Right Arm&quot;) ~= nil then
char:findFirstChild(&quot;Right Arm&quot;).BrickColor = BrickColor.new(&quot;Black&quot;)
end
if char:findFirstChild(&quot;Left Arm&quot;) ~= nil then
char:findFirstChild(&quot;Left Arm&quot;).BrickColor = BrickColor.new(&quot;Black&quot;)
end
if char:findFirstChild(&quot;Torso&quot;) ~= nil then
char:findFirstChild(&quot;Torso&quot;).BrickColor = BrickColor.new(&quot;Black&quot;)
end
if char:findFirstChild(&quot;Torso&quot;) ~= nil then
char:findFirstChild(&quot;Torso&quot;).BrickColor = BrickColor.new(&quot;Black&quot;)
end
if char:findFirstChild(&quot;Right Leg&quot;) ~= nil then
char:findFirstChild(&quot;Right Leg&quot;).BrickColor = BrickColor.new(&quot;Black&quot;)
end
if char:findFirstChild(&quot;Left Leg&quot;) ~= nil then
char:findFirstChild(&quot;Left Leg&quot;).BrickColor = BrickColor.new(&quot;Black&quot;)
end
end


