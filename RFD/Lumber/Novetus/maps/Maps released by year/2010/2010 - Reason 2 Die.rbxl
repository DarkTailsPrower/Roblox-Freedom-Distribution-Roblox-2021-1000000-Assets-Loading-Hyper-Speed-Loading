						<ProtectedString name="Source">openDoor = false
function open()
print(&quot;open&quot;)
script.Parent.Bod.force = Vector3.new(60000,100000,0)
end

function close()
print(&quot;close&quot;)
script.Parent.Bod.force = Vector3.new(0,0,0)
end

function start()
print(&quot;clicked&quot;)
if openDoor == false then
open()
openDoor = true
else
close()
openDoor = false
end
end

script.Parent.ClickDetector.MouseClick:connect(start)

</ProtectedString>
