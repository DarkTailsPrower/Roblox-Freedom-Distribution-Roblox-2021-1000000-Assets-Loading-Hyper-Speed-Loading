				<Item class="Script" referent="RBX514">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">var = 0
x = -1
time = 60
posNumber = 220
while true do
wait(0.1)
var = var + 1
if var &lt;posNumber then
script.Parent.BodyPosition.position = script.Parent.BodyPosition.position + Vector3.new(-1,0,0)
end
if var == posNumber then
script.Parent.BodyPosition.position = Vector3.new(2, 111.8, 77)
wait(time)
script.Parent.Parent.Door.CanCollide = true
script.Parent.Parent.Door.Transparency = 0
end
if var &gt; posNumber then
script.Parent.BodyPosition.position = script.Parent.BodyPosition.position + Vector3.new(x,0,0)
x = x - 0.03
end
end
</ProtectedString>
					</Properties>
				</Item>
