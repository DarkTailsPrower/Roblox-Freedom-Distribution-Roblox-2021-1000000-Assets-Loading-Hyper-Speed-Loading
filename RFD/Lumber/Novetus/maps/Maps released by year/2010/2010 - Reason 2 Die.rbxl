&#9;wait(5)
&#9;start4()
&#9;else
&#9;killAll()
&#9;wait(10)
&#9;script.GameOn.Value = true
&#9;gameOn = true
&#9;msg.Text = &quot;The zombie apocalypse is coming, no where to run!&quot;
&#9;setup_players()
&#9;msg.Text = &quot;Run from the zombie! He will infect you!&quot;
&#9;wait(3)
&#9;script.GameOn.Value = false
&#9;timedone = MaxTime
&#9;&#9;while true do
&#9;&#9;&#9;if endgame == true then return end
&#9;&#9;&#9;timedone = timedone - 1
&#9;&#9;&#9;msg.Text = &quot;Time til rescue arrives: &quot;..timedone
&#9;&#9;&#9;wait(1)
&#9;&#9;&#9;if timedone == 0 then
&#9;&#9;&#9;&#9;msg.Text = &quot;Rescue is arriving at dock! Hurry there!&quot;
&#9;&#9;&#9;&#9;train = game.Lighting.Boat:clone()
&#9;&#9;&#9;&#9;train.Engine.Script.Disabled = false
&#9;&#9;&#9;&#9;train.Parent = game.Workspace
&#9;&#9;&#9;&#9;train:MakeJoints()
&#9;&#9;&#9;&#9;break
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;if endgame == true then return end
&#9;&#9;--wait(22)
&#9;&#9;takeofftime = 60
&#9;&#9;&#9;while true do
&#9;&#9;&#9;&#9;takeofftime = takeofftime - 1
&#9;&#9;&#9;&#9;msg.Text = &quot;Hop on guys, &quot;..takeofftime..&quot; seconds then Im off. Keep deffending!&quot;
&#9;&#9;&#9;&#9;wait(1)
&#9;&#9;&#9;&#9;if endgame == true then return end
&#9;&#9;&#9;&#9;if takeofftime == 1 then
&#9;&#9;&#9;&#9;msg.Text = &quot;No what, wait!! A hunter onboard!! aahhhrg BLARGH! *dies*&quot;
&#9;&#9;&#9;&#9;wait(1)
&#9;&#9;&#9;&#9;break
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;&#9;local time = 0
&#9;&#9;&#9;local model = game.Workspace.ZombieSpawns:GetChildren()
&#9;&#9;&#9;for x = 1,#model do
&#9;&#9;&#9;&#9;model[x].CFrame = game.Workspace.BloxHarbor.Zspawns:findFirstChild(&quot;SpecialSpawn&quot;).CFrame
&#9;&#9;&#9;end
&#9;&#9;&#9;wait(20)
&#9;&#9;&#9;local players = game.Players:GetPlayers()
&#9;&#9;&#9;for i = 1,#players do
&#9;&#9;&#9;&#9;if players[i].Character ~= nil then
&#9;&#9;&#9;&#9;&#9;if players[i].Character:findFirstChild(&quot;Head&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;if players[i].Character.Head.Position.x &lt; 200 then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;players[i].Character.Head:remove()
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;&#9;while true do
&#9;&#9;&#9;wait(1)
&#9;&#9;&#9;if endgame == true then break end
&#9;&#9;&#9;time = time+1
&#9;&#9;&#9;msg.Text = &quot;You survived: &quot;..time..&quot; seconds extra!&quot;
&#9;&#9;&#9;end

&#9;end
end



