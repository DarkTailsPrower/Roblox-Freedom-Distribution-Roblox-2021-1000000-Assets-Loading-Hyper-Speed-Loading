&#9;&#9;&#9;&#9;for i = 1, 80 do
&#9;&#9;&#9;&#9;&#9;box.Text = box.Text .. stringv:sub(c,c)
&#9;&#9;&#9;&#9;&#9;c = c + 1
&#9;&#9;&#9;&#9;end
&#9;&#9;end
&#9;elseif script.Parent:findFirstChild(&quot;SValue&quot;) then
&#9;&#9;script.Parent.Parent.Parent.Parent.Sourcer.Background[&apos;Line[1]&apos;].Text = script.Parent.SValue.Value
