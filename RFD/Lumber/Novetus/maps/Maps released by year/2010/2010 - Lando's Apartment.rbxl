		<Item class="Script" referent="RBX3">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">ChatChanger</string>
				<ProtectedString name="Source">function getMsg(player,text)
if player.MembershipType == 0 then
return &quot;{ NonBC } &quot;..player.Name..&quot; : &quot;..text
end 

if player.MembershipType == 1 then
return &quot;{ BC } &quot;..player.Name..&quot; : &quot;..text
end 

if player.MembershipType == 2 then
return &quot;{ TBC } &quot;..player.Name..&quot; : &quot;..text
end 

if player.MembershipType == 3 then
return &quot;{ OBC } &quot;..player.Name..&quot; : &quot;..text
end 

end 

function onChatted(msg,speaker)
script.Text1.Value = script.Text2.Value
script.Text2.Value = script.Text3.Value
script.Text4.Value = script.Text5.Value
script.Text6.Value = getMsg(speaker,msg)
end

function oE(newPlayer)
newPlayer.Chatted:connect(function(msg) onChatted(msg,newPlayer) end)
end

c = game.Players:GetChildren()
for i=1,#c do
oE(c[i])
end
</ProtectedString>
