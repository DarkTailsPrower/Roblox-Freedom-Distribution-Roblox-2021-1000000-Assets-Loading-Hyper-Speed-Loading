c[i].Reflectance = 0
end
if c[i].className == &quot;Humanoid&quot; then
c[i].MaxHealth = 100
c[i].Health = 100
end 
if c[i].Name == &quot;God FF&quot; then
c[i]:remove()
end end end end end end end

