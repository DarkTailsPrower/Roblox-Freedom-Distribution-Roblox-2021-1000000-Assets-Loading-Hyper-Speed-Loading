				<Item class="Script" referent="RBX451">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Control</string>
						<ProtectedString name="Source">wait()
local value = false
local moving = false
local spd = .05

function MoveModel(part, newcf)
&#9;for i, p in pairs(part.Parent:GetChildren()) do
&#9;&#9;if p ~= part and p.className == &quot;Part&quot; then
&#9;&#9;&#9;p.CFrame = newcf * (part.CFrame:inverse() * CFrame.new(part.CFrame.p)) * (p.CFrame:inverse() * CFrame.new(part.CFrame.p)):inverse()
&#9;&#9;end
&#9;end
&#9;part.CFrame = newcf
end

script.Parent.Open.Changed:connect(function()
&#9;if moving then
&#9;&#9;script.Parent.Open.Value = value
&#9;&#9;return
&#9;end
&#9;if script.Parent.Open.Value == value then return end
&#9;value = script.Parent.Open.Value
&#9;if value then
&#9;&#9;moving = true
&#9;&#9;for i = 1, 10 do
&#9;&#9;&#9;MoveModel(script.Parent.Button, (script.Parent.Button.CFrame * CFrame.fromEulerAnglesXYZ(0,0,math.pi/10)))
&#9;&#9;&#9;wait(spd)
&#9;&#9;end
&#9;&#9;wait(3)
&#9;&#9;moving = false
&#9;&#9;script.Parent.Open.Value = false
&#9;end
end)
script.Parent.Button.CD.MouseClick:connect(function() script.Parent.Open.Value = not script.Parent.Open.Value end)
</ProtectedString>
					</Properties>
				</Item>
			</Item>
