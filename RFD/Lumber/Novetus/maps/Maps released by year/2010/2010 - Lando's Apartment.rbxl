if c[i]:FindFirstChild(&quot;Context&quot;) then
if string.sub(c[i].Context.Value,1,41) == &quot;script.Parent.Humanoid.MaxHealth = 999999&quot; then
c[i]:remove()
isgod = true
end end end end
if isgod == true then
local c = player[i].Character:GetChildren()
for i=1,#c do
