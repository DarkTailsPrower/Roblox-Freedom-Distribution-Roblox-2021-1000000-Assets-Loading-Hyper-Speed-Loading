				<Item class="Script" referent="RBX826">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Weld</string>
						<ProtectedString name="Source">function Weld(x, y)
&#9;local weld = Instance.new(&quot;Weld&quot;)
&#9;weld.Part0 = x
&#9;weld.Part1 = y
&#9;weld.C0 = x.CFrame:inverse() * CFrame.new(x.Position)
&#9;weld.C1 = y.CFrame:inverse() * CFrame.new(x.Position)
&#9;weld.Parent = x
end

Weld(script.Parent.r,script.Parent.Seat)
script.Parent.Seat.Anchored = false
</ProtectedString>
					</Properties>
				</Item>
			</Item>
