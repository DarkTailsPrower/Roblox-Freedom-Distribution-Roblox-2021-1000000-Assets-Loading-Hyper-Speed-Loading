								<ProtectedString name="Source">local inDex = 1
local tinDex = script.Parent.Parent.Parent.Tindex

script.Parent.MouseButton1Click:connect(function()
&#9;tinDex.Value = 1
&#9;if not script.Parent:FindFirstChild(&quot;Children&quot;) then return end
&#9;local _place = script.Parent.Children.Value:GetChildren()
&#9;script.Parent.Parent.Parent.Oindex.Value = script.Parent.Children.Value
&#9;for i,v in pairs(script.Parent.Parent:GetChildren()) do
&#9;&#9;v.Text = &quot;&quot;
&#9;&#9;pcall(function()
&#9;&#9;&#9;v.Children:Remove()
&#9;&#9;&#9;end)
&#9;end
&#9;for i = tinDex.Value, tinDex.Value + 15 do
&#9;&#9;local cBox = script.Parent.Parent:FindFirstChild(&quot;Box[&quot; .. tostring(inDex) .. &quot;]&quot;)
&#9;&#9;if _place[i] ~= nil then
&#9;&#9;&#9;local o = Instance.new(&quot;ObjectValue&quot;)
&#9;&#9;&#9;o.Value = _place[i]
&#9;&#9;&#9;o.Name = &quot;Children&quot;
&#9;&#9;&#9;o.Parent = cBox

&#9;&#9;&#9;cBox.Text = _place[i].Name
&#9;&#9;&#9;inDex = inDex + 1
&#9;&#9;end
&#9;end 
&#9;inDex = 1
end)
</ProtectedString>
