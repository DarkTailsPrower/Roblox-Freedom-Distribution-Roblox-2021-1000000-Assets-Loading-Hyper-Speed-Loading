					<Item class="Script" referent="RBX129">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Return Game Objects</string>
							<ProtectedString name="Source">local inDex = 1
local tinDex = script.Parent.Parent.Tindex

script.Parent.MouseButton1Click:connect(function()
&#9;local _place = script.Parent.Parent.Oindex.Value
&#9;if not _place then return end
&#9;if tinDex.Value == 16 then return end
&#9;tinDex.Value = tinDex.Value + 1
&#9;for i,v in pairs(script.Parent.Parent.Background:GetChildren()) do
&#9;&#9;v.Text = &quot;&quot;
&#9;&#9;pcall(function()
&#9;&#9;&#9;v.Children:Remove()
&#9;&#9;&#9;end)
&#9;end
&#9;for i = tinDex.Value, tinDex.Value + 15 do
&#9;&#9;local cBox = script.Parent.Parent.Background:FindFirstChild(&quot;Box[&quot; .. tostring(inDex) .. &quot;]&quot;)
&#9;&#9;if _place:GetChildren()[i] ~= nil then
&#9;&#9;&#9;local o = Instance.new(&quot;ObjectValue&quot;)
&#9;&#9;&#9;o.Value = _place:GetChildren()[i]
&#9;&#9;&#9;o.Name = &quot;Children&quot;
&#9;&#9;&#9;o.Parent = cBox
&#9;&#9;&#9;cBox.Text = _place:GetChildren()[i].Name
&#9;&#9;&#9;inDex = inDex + 1
&#9;&#9;end
&#9;end 
&#9;inDex = 1
end)
</ProtectedString>
						</Properties>
					</Item>
				</Item>
