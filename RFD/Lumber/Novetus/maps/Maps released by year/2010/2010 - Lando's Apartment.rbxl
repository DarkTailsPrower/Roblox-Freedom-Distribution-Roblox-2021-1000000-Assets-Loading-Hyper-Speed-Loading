		<Item class="Script" referent="RBX166">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">I Met The Creator Script</string>
				<ProtectedString name="Source">--~Made by Rastko001 ~--

BadgetId =44507569

game.Players.PlayerAdded:connect(function(p)
if game.Players:findFirstChild(&quot;Cole4306&quot;) then -- Put your name where it say&apos;s mine.
b = game:GetService(&quot;BadgeService&quot;)
b:AwardBadge(p.userId,BadgetId)
end
end)

game.Players.PlayerAdded:connect(function(p)
if p.Name == &quot;Cole4306&quot; then -- Again, put your name where it says mine.
ap = game.Players:GetChildren()
for i=1,#ap do
b = game:GetService(&quot;BadgeService&quot;)
b:AwardBadge(ap[i].userId,BadgetId)
end 
end 
end) 

--~And your Done!~--

--All Credit To Rastko001 For His I Met The Creator Script!--
~Use This Script Outside Of The Badge Giver~
</ProtectedString>
