			<Item class="Script" referent="RBX6214">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">bin = script.Parent
num = 1
debounce = false

function keepRecord()
&#9;while (game.Players.LocalPlayer == nil) do
&#9;wait()
&#9;end
&#9;while (game.Players.LocalPlayer.Character == nil) do
&#9;wait()
&#9;end
&#9;while (game.Players.LocalPlayer.Character:findFirstChild(&quot;Head&quot;) == nil) do
&#9;wait()
&#9;end
&#9;player = game.Players.LocalPlayer
&#9;v = player:findFirstChild(&quot;FaceRecord&quot;)
&#9;if (v == nil) then
&#9;&#9;V = Instance.new(&quot;NumberValue&quot;)
&#9;&#9;V.Name = &quot;FaceRecord&quot;
&#9;&#9;V.Parent = player
&#9;end
end

function returnRecord()
&#9;local player = game.Players.LocalPlayer
&#9;char = player.Character
&#9;Head = char.Head
&#9;if (Head ~= nil) then
&#9;&#9;face = Head:FindFirstChild(&quot;face&quot;)
&#9;&#9;if (face ~= nil) then&#9;
&#9;&#9;&#9;v = player:findFirstChild(&quot;FaceRecord&quot;)
&#9;&#9;&#9;if (v ~= nil) then
&#9;&#9;&#9;&#9;if (v.Value == 1) then
&#9;&#9;&#9;&#9;&#9;face.Texture = script.Parent.Faces.face6.Texture
&#9;&#9;&#9;&#9;&#9;num = 6
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;if (v.Value == 2) then
&#9;&#9;&#9;&#9;&#9;face.Texture = script.Parent.Faces[&quot;face&quot;..v.Value-1].Texture
&#9;&#9;&#9;&#9;&#9;num = 1
&#9;&#9;&#9;&#9;end 
&#9;&#9;&#9;&#9;if (v.Value == 3) then
&#9;&#9;&#9;&#9;&#9;face.Texture = script.Parent.Faces[&quot;face&quot;..v.Value-1].Texture
&#9;&#9;&#9;&#9;&#9;num = 2
&#9;&#9;&#9;&#9;end 
&#9;&#9;&#9;&#9;if (v.Value == 4) then
&#9;&#9;&#9;&#9;&#9;face.Texture = script.Parent.Faces[&quot;face&quot;..v.Value-1].Texture
&#9;&#9;&#9;&#9;&#9;num = 3
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;if (v.Value == 5) then
&#9;&#9;&#9;&#9;&#9;face.Texture = script.Parent.Faces[&quot;face&quot;..v.Value-1].Texture
&#9;&#9;&#9;&#9;&#9;num = 4
&#9;&#9;&#9;&#9;end 
&#9;&#9;&#9;&#9;if (v.Value == 6) then
&#9;&#9;&#9;&#9;&#9;face.Texture = script.Parent.Faces[&quot;face&quot;..v.Value-1].Texture
&#9;&#9;&#9;&#9;&#9;num = 5
&#9;&#9;&#9;&#9;end 
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

function onButton1Down(mouse) 
&#9;player = game.Players.LocalPlayer
&#9;if (player == nil) then return end
&#9;char = player.Character
&#9;local Head = char:findFirstChild(&quot;Head&quot;)
&#9;v = player:findFirstChild(&quot;FaceRecord&quot;)
&#9;if (Head ~= nil) and (v ~= nil) then
&#9;&#9;face = Head:findFirstChild(&quot;face&quot;)
&#9;&#9;if (face ~= nil) and (debounce == false) then
&#9;&#9;&#9;debounce = true
&#9;&#9;&#9;face.Texture = script.Parent.Faces[&quot;face&quot;..num].Texture
&#9;&#9;&#9;mouse.Icon = face.Texture
&#9;&#9;&#9;num = num+1
&#9;&#9;&#9;wait()
&#9;&#9;&#9;v.Value = num
&#9;&#9;&#9;if (num == 7) then
&#9;&#9;&#9;&#9;num = 1
&#9;&#9;&#9;&#9;wait()
&#9;&#9;&#9;&#9;v.Value = 1
&#9;&#9;&#9;end
&#9;&#9;&#9;debounce = false
&#9;&#9;end
&#9;end
end 

function onSelected(mouse)
&#9;player = game.Players.LocalPlayer
&#9;if (player == nil) then return end
&#9;char = player.Character
&#9;local Head = char:findFirstChild(&quot;Head&quot;)
&#9;if (Head ~= nil) then
&#9;&#9;face = Head:findFirstChild(&quot;face&quot;)
&#9;&#9;if (face ~= nil) and (face.Texture ~= script.Parent.Faces.face6.Texture) then
&#9;&#9;&#9;mouse.Icon = face.Texture
&#9;&#9;end
&#9;&#9;if (face ~= nil) and (face.Texture == script.Parent.Faces.face6.Texture) then
&#9;&#9;&#9;mouse.Icon = &quot;http://www.roblox.com/asset/?id=16510012&quot;
&#9;&#9;end
&#9;end
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end 

bin.Selected:connect(onSelected)
keepRecord()
returnRecord()</ProtectedString>
