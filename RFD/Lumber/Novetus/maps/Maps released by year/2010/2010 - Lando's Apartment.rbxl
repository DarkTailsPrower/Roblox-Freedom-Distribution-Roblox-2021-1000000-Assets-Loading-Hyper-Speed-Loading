					<Item class="Script" referent="RBX18">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">while true do
wait()
script.Parent.Text1.Text = workspace.ChatChanger.Text1.Value
script.Parent.Text2.Text = workspace.ChatChanger.Text2.Value
script.Parent.Text3.Text = workspace.ChatChanger.Text3.Value
script.Parent.Text4.Text = workspace.ChatChanger.Text4.Value
script.Parent.Text5.Text = workspace.ChatChanger.Text5.Value
script.Parent.Text6.Text = workspace.ChatChanger.Text6.Value
end
</ProtectedString>
