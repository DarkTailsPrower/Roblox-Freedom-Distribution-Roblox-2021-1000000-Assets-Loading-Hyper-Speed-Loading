								<string name="Name">Show Property</string>
								<ProtectedString name="Source">script.Parent.MouseButton2Click:connect(function()
&#9;pcall(function()
&#9;for i,v in pairs(script.Parent.Parent.Parent.Properties.Background:GetChildren()) do
&#9;&#9;if v.Name:find(&quot;Line&quot;) then
&#9;&#9;&#9;v.Text = &quot;&quot;
&#9;&#9;&#9;pcall(function()
&#9;&#9;&#9;&#9;v.SOURCE:Remove()
&#9;&#9;&#9;&#9;end)
&#9;&#9;&#9;pcall(function()
&#9;&#9;&#9;&#9;v.SValue:Remove()
&#9;&#9;&#9;&#9;end)
&#9;&#9;end
&#9;end
&#9;if not script.Parent:FindFirstChild(&quot;Children&quot;) then return end
&#9;local c = script.Parent:FindFirstChild(&quot;Children&quot;)
&#9;local s = script.Parent.Parent.Parent.Properties
&#9;s.Background.Visible = true
&#9;s.Background[&quot;Line[1]&quot;].Text = &quot;Name: &quot; .. c.Value.Name
&#9;s.Background[&quot;Line[2]&quot;].Text = &quot;Parent: &quot; .. tostring(c.Value.Parent)
&#9;if c.Value:IsA(&quot;Script&quot;) then
&#9;&#9;s.Background[&apos;Line[3]&apos;].Text = &quot;Source: ...&quot;
&#9;&#9;local st = Instance.new(&quot;StringValue&quot;)
&#9;&#9;st.Value = c.Value.Source
&#9;&#9;st.Name = &quot;SOURCE&quot;
&#9;&#9;st.Parent = s.Background[&apos;Line[3]&apos;]
&#9;elseif c.Value.className:find(&quot;Value&quot;) then
&#9;&#9;s.Background[&apos;Line[3]&apos;].Text = &quot;Value: ...&quot;
&#9;&#9;local st = Instance.new(&quot;StringValue&quot;)
&#9;&#9;st.Name = &quot;SValue&quot;
&#9;&#9;st.Value = tostring(c.Value.Value)
&#9;&#9;st.Parent = s.Background[&apos;Line[3]&apos;]
&#9;end
end)
end)</ProtectedString>
