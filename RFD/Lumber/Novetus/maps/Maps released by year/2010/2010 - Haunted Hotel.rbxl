			<Item class="Script" referent="RBX7966">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Air</string>
					<ProtectedString name="Source">function windforce(victimTorso)
&#9;if (victimTorso.Parent:FindFirstChild(&quot;ForceField&quot;) ~= nil) then return end
&#9;if victimTorso:FindFirstChild(&quot;WindEffect&quot;) == nil then

&#9;&#9;local dir = script.Parent.Velocity.unit
&#9;&#9;local force = Instance.new(&quot;BodyVelocity&quot;)
&#9;&#9;force.Name = &quot;WindEffect&quot;
&#9;&#9;force.maxForce = Vector3.new(1e7, 1e7, 1e7)
&#9;&#9;force.P = 125
&#9;&#9;force.velocity =  (dir * 75) + Vector3.new(0, 30,0)
&#9;&#9;force.Parent = victimTorso
&#9;&#9;game.Debris:AddItem(force, .5)
&#9;end
end


function OnTouch(part)
&#9;if (part.Parent == nil) then return end
&#9;if (part.Parent:FindFirstChild(&quot;Humanoid&quot;) ~= nil) then
&#9;&#9;local t = part.Parent:FindFirstChild(&quot;Torso&quot;)
&#9;&#9;if (t ~= nil) then
&#9;&#9;&#9;windforce(t)
&#9;&#9;end
&#9;end
&#9;script.Parent:Remove()
end


script.Parent.Touched:connect(OnTouch)


wait(2)
script.Parent:Remove()</ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX7967">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">BlowDryer</string>
					<ProtectedString name="Source">print(&quot;Flamethrower script loaded&quot;)

Tool = script.Parent

shooting = false
reloadtime = 0

colors = {1, 208, 45, 11} 

function fire(v)


&#9;

&#9;local missile = Instance.new(&quot;Part&quot;)

&#9;local vCharacter = Tool.Parent

&#9;local head = vCharacter:findFirstChild(&quot;Head&quot;)
&#9;if head == nil then return end


&#9;local spawnPos = head.Position
&#9;spawnPos  = spawnPos + (v * 10)

&#9;missile.Name = &quot;HotAir&quot;

&#9;local dx = (math.random() - .5) * 50
&#9;local dy = (math.random() - .5) * 50
&#9;local dz = (math.random() - .5) * 50

&#9;missile.CFrame = CFrame.new(spawnPos, Vector3.new(dx,dy,dz))
&#9;missile.Size = Vector3.new(2,2,2)
&#9;missile.Velocity = v * 80
&#9;missile.BrickColor = BrickColor.new(colors[math.random(1, #colors)])
&#9;missile.Shape = 0
&#9;missile.CanCollide = false
&#9;missile.Transparency = (math.random() * .5)

&#9;local force = Instance.new(&quot;BodyForce&quot;)
&#9;force.force = Vector3.new(0,98 * 8,0)
&#9;force.Parent = missile

&#9;local new_script = script.Parent.Air:clone()
&#9;new_script.Disabled = false
&#9;new_script.Parent = missile
&#9;
&#9;missile.Parent = game.Workspace

end



Tool.Enabled = true
function onActivated(mouse)
&#9;if (Tool.Enabled == false) then return end
&#9;Tool.Enabled = false
&#9;if reloadtime &gt; 0 then return end
&#9;if shooting == true then return end
&#9;print(&quot;start shooting&quot;)
&#9;reloadtime = 1.0
&#9;shooting = true

&#9;local time = 0

&#9;local character = Tool.Parent;
&#9;local humanoid = character.Humanoid
&#9;if humanoid == nil then
&#9;&#9;print(&quot;Humanoid not found&quot;)
&#9;&#9;return 
&#9;end

&#9;local sound = character.PrimaryPart:findFirstChild(&quot;DryerSound&quot;)
&#9;if sound == nil then 
&#9;&#9;sound = Instance.new(&quot;Sound&quot;)
&#9;&#9;sound.Name = &quot;DryerSound&quot;
&#9;&#9;sound.SoundId = &quot;http://www.roblox.com/asset/?id=11717967&quot;
&#9;&#9;sound.Parent = character.PrimaryPart
&#9;end
&#9;sound:Play()


&#9;while shooting == true do
&#9;&#9;local targetPos = humanoid.TargetPoint
&#9;&#9;local lookAt = (targetPos - character.Head.Position).unit
&#9;&#9;local dx = (math.random() - .5) * .3
&#9;&#9;local dy = (math.random() - .5) * .3
&#9;&#9;local dz = (math.random() - .5) * .3

&#9;&#9;fire(Vector3.new(lookAt.x + dx, lookAt.y + dy, lookAt.z + dz))
&#9;&#9;wait(.05)
&#9;&#9;time = time + .05
&#9;&#9;if time &gt; 2.0 then shooting = false end
&#9;end

&#9;sound:Stop()

&#9;wait(reloadtime)
&#9;reloadtime = 0

&#9;Tool.Enabled = true
end

function onDeactivated(mouse)
&#9;shooting = false
end



script.Parent.Activated:connect(onActivated)
script.Parent.Deactivated:connect(onDeactivated)





</ProtectedString>
				</Properties>
			</Item>
