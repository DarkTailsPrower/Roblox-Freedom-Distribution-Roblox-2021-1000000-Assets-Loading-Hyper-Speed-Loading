					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">function onHit(hit)
&#9;local human = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;if (human ~= nil) then


human.Health = 1 --change this to 0 if u want the person to die when touched
local message = Instance.new(&quot;Message&quot;)
message.Parent = game.Players:playerFromCharacter(hit.Parent)
wait(4.5) --change this to how long u want the message to stay (in seconds)
message:Remove ()
&#9;end
end

script.Parent.Touched:connect(onHit)
</ProtectedString>
				</Properties>
			</Item>
		</Item>
