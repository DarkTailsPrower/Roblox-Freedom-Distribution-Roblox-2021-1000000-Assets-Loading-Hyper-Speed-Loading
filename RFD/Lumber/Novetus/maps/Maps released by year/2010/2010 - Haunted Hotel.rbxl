		<Item class="HopperBin" referent="RBX6979">
			<Properties>
				<bool name="Active">false</bool>
				<token name="BinType">0</token>
				<string name="Name">FalconPunch</string>
				<Content name="TextureId"><null></null></Content>
			</Properties>
			<Item class="Sound" referent="RBX6980">
				<Properties>
					<bool name="Looped">false</bool>
					<string name="Name">Sound</string>
					<float name="Pitch">1</float>
					<bool name="PlayOnRemove">false</bool>
					<Content name="SoundId"><url>http://www.roblox.com/asset/?id=1387390</url></Content>
