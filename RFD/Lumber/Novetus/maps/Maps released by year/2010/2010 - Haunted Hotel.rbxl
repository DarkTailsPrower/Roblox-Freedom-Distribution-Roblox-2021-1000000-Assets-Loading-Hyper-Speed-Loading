			<Item class="Script" referent="RBX7231">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">WeldScript</string>
					<ProtectedString name="Source">t = script.Parent

function stick(x, y)
&#9;weld = Instance.new(&quot;Weld&quot;) 
&#9;weld.Part0 = x
&#9;weld.Part1 = y
&#9;local HitPos = x.Position
&#9;local CJ = CFrame.new(HitPos) 
&#9;local C0 = x.CFrame:inverse() *CJ 
&#9;local C1 = y.CFrame:inverse() * CJ 
&#9;weld.C0 = C0 
&#9;weld.C1 = C1 
&#9;weld.Parent = x
end

function Weldnow()
&#9;c = t:children()
&#9;for n = 1, #c do
&#9;&#9;if (c[n].className == &quot;Part&quot;) then
&#9;&#9;&#9;if (c[n].Name ~= &quot;Handle&quot;) then
&#9;&#9;&#9;&#9;c[n].CFrame = t.Handle.CFrame
&#9;&#9;&#9;&#9;stick(c[n], t.Handle)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

script.Parent.Equipped:connect(Weldnow)
script.Parent.Unequipped:connect(Weldnow)
Weldnow()</ProtectedString>
				</Properties>
			</Item>
			<Item class="LocalScript" referent="RBX7232">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Local Gui</string>
					<ProtectedString name="Source">local Tool = script.Parent;

function stick(x, y)
&#9;weld = Instance.new(&quot;Weld&quot;) 
&#9;weld.Part0 = x
&#9;weld.Part1 = y
&#9;local HitPos = x.Position
&#9;local CJ = CFrame.new(HitPos) 
&#9;local C0 = x.CFrame:inverse() *CJ 
&#9;local C1 = y.CFrame:inverse() * CJ 
&#9;weld.C0 = C0 
&#9;weld.C1 = C1 
&#9;weld.Parent = x
end


enabled = true

function onButton1Down(mouse)
&#9;if (not enabled) then return end
&#9;enabled = false

&#9;script.Parent.Parent.Torso[&quot;Right Shoulder&quot;].CurrentAngle = 2
&#9;targ = mouse.Target
&#9;if (targ == nil) then 
&#9;&#9;script.Parent.Handle.Fail:play()
&#9;&#9;for abcde = 1, 5 do
&#9;&#9;&#9;script.Parent.Part3.Mesh.Offset = script.Parent.Part3.Mesh.Offset + Vector3.new(0,0, 0.1)
&#9;&#9;&#9;wait(0.01)
&#9;&#9;end
&#9;&#9;shell = Instance.new(&quot;Part&quot;)
&#9;&#9;shell.Name = &quot;SHELL&quot;
&#9;&#9;shell.CFrame = script.Parent.Handle.CFrame
&#9;&#9;shell.Parent = script.Parent.Parent
&#9;&#9;shell.BrickColor = BrickColor.Red()
&#9;&#9;shell.Size = Vector3.new(1,1.2,2)
&#9;&#9;mesh = Instance.new(&quot;BlockMesh&quot;)
