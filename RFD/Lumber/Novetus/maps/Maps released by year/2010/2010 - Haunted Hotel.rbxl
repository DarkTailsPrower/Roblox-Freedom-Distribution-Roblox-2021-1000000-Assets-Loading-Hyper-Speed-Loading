			<Item class="Script" referent="RBX7349">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Freeze</string>
					<ProtectedString name="Source">pod = script.Parent

function onTouched(part)

if part.Name == &quot;Base&quot; then -- If name of object touched is safe dont remove.
return end

if part.Name == &quot;lol&quot; then -- If name of object touched is safe dont remove.
return end

if part.Name == &quot;Middle&quot; then -- If name of object touched is safe dont remove.
return end

&#9;wait(0.1)
&#9;part.Reflectance = 0.1 
&#9;wait(0.1)
&#9;part.Reflectance = 0.2
&#9;wait(0.1)&#9;
&#9;part.Reflectance = 0.3
&#9;wait(0.1)
&#9;part.Reflectance = 0.4
&#9;wait(0.1)
&#9;part.Reflectance = 0.5 
&#9;wait(0.1)
&#9;part.Reflectance = 0.6
&#9;wait(0.1)&#9;
&#9;part.Reflectance = 0.7
&#9;wait(0.1)
&#9;part.Reflectance = 0.8
&#9;wait(0.1)
&#9;part.Reflectance = 0.9 
&#9;wait(0.1)
&#9;part.Reflectance = 1
        wait(0.1)
        part.Anchored = true
end

connection = pod.Touched:connect(onTouched)</ProtectedString>
				</Properties>
			</Item>
