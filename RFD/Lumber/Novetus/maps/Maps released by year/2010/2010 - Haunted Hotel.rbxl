				<string name="Name">Sounds</string>
				<ProtectedString name="Source">while true do
wait(10)
local m = math.random(1,6)

if m == 1 then
script.Sound.SoundId = &quot;http://www.roblox.com/asset/?id=13061810&quot;
script.Sound.Pitch = 0.3
script.Sound:play()
end

if m == 2 then
script.Sound.SoundId = &quot;http://www.roblox.com/asset/?id=13061809&quot;
script.Sound.Pitch = 0.2
script.Sound:play()
end

if m == 3 then
script.Sound.SoundId = &quot;http://www.roblox.com/asset/?id=13061810&quot;
script.Sound.Pitch = 0.1
script.Sound:play()
end

if m == 4 then
script.Sound.SoundId = &quot;http://www.roblox.com/asset/?id=13061802&quot;
script.Sound.Pitch = 0.1
script.Sound:play()
end

if m == 5 then
script.Sound.SoundId = &quot;http://www.roblox.com/asset/?id=13061809&quot;
script.Sound.Pitch = 0.1
script.Sound:play()
end

if m == 6 then
script.Sound.SoundId = &quot;http://www.roblox.com/asset/?id=12229501&quot;
script.Sound.Pitch = 0.1
script.Sound:play()
end

end
</ProtectedString>
