			<Item class="Script" referent="RBX7172">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">fire</string>
					<ProtectedString name="Source">bin = script.Parent

wait(0.1)

function exhaust()
&#9;while (bin.Transparency &lt; 1) do
&#9;&#9;bin.Transparency = bin.Transparency+0.05
&#9;&#9;wait(0.05)
&#9;end
&#9;bin:remove()
end

local x = 0
while x&lt;30 do
&#9;local ex = Instance.new(&quot;Explosion&quot;)
&#9;ex.Position = bin.Position
&#9;ex.BlastRadius = 2
&#9;ex.BlastPressure = 75000
&#9;ex.Parent = game.Workspace
&#9;x=x+1
&#9;wait(0.175)
end

exhaust()
</ProtectedString>
