			<Item class="Script" referent="RBX9600">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">WoodlandsStaff</string>
					<ProtectedString name="Source">local Tool = script.Parent;

enabled = true



p = {}


Tool = script.Parent

local WoodWalk = Instance.new(&quot;Sound&quot;)
WoodWalk.SoundId = &quot;http://www.roblox.com/asset/?id=11387922&quot;
WoodWalk.Volume = .7
WoodWalk.Parent = Tool.Handle

function setTrans(root, trans, character)
&#9;if (root:IsDescendantOf(character) == false and root ~= character) then return end
&#9;local c = root:GetChildren()
&#9;for i=1,#c do
&#9;&#9;setTrans(c[i], trans, character)
&#9;&#9;if (c[i].className == &quot;Part&quot; and c[i]:IsDescendantOf(character)) then -- concurrency hell
&#9;&#9;&#9;p[c[i]] = c[i].Transparency 
&#9;&#9;&#9;c[i].Transparency = trans
&#9;&#9;end
&#9;end
end

function resetTrans()
&#9;WoodWalk:Stop()
&#9;for k,v in pairs(p) do 
&#9;&#9;k.Transparency = v
&#9;end
end

function SetTransparency(root, trans, character)
&#9;p = {}
&#9;setTrans(root, trans, character)
&#9;WoodWalk:Play()
end



function staffUp()
&#9;Tool.GripForward = Vector3.new(0,0,-1)
&#9;Tool.GripRight = Vector3.new(1,0,0)
&#9;Tool.GripUp = Vector3.new(0,1,0)
end

function staffOut()
&#9;Tool.GripForward = Vector3.new(.0976, .00976, -.995)
&#9;Tool.GripRight = Vector3.new(.195, -.981, .00952)
&#9;Tool.GripUp = Vector3.new(.976, .195, .0976)
end

function isTurbo(character)
&#9;return character:FindFirstChild(&quot;TreeHelm&quot;) ~= nil
end


Tool.Enabled = true
function onActivated()
&#9;if Tool.Enabled == false  then
&#9;&#9;return
&#9;end

&#9;Tool.Enabled = false


&#9;local character = Tool.Parent;
&#9;local humanoid = character.Humanoid
&#9;if humanoid == nil then
&#9;&#9;print(&quot;Humanoid not found&quot;)
&#9;&#9;return 
&#9;end


&#9;local trans = .94
&#9;if (isTurbo(character) == true) then trans = .97 end

&#9;staffOut()
&#9;wait(.5)
&#9;staffUp()
&#9;print(Tool.Parent, &quot;  &quot;, character)
&#9;SetTransparency(Tool.Parent, trans, character)
&#9;wait(8)
&#9;resetTrans()
&#9;wait(3)

&#9;Tool.Enabled = true

end

function onEquipped()
&#9;Tool.Handle.EquipSound:play()
end

function onUnequipped()

&#9;resetTrans()
&#9;

end

script.Parent.Activated:connect(onActivated)
script.Parent.Equipped:connect(onEquipped)
script.Parent.Unequipped:connect(onUnequipped)
</ProtectedString>
