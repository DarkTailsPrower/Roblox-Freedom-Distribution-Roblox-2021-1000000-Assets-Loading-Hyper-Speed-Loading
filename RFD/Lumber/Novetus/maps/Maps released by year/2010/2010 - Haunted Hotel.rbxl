&#9;&#9;end
&#9;&#9;shell:breakJoints()
&#9;&#9;enabled = true
&#9;&#9;return 
&#9;end
&#9;hum = targ.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;if (hum ~= nil) then
&#9;&#9;script.Parent.Handle.Fail:play()
&#9;&#9;c = Instance.new(&quot;ObjectValue&quot;)
