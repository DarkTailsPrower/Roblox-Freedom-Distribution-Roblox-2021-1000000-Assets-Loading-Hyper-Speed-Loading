			<Item class="Script" referent="RBX6981">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Hurt</string>
					<ProtectedString name="Source">--[[--[[--[[*LuigiFan*]]--]]--]]--
-- Thanks to clockwork for making the original falcon punch :)

Arm = script.Parent
Torso = script.Parent.Parent.Torso

function boom(arm)
&#9;E = Instance.new(&quot;Explosion&quot;)
&#9;E.Parent = arm
&#9;E.Position = arm.Position
&#9;E.BlastRadius = 1
&#9;E.BlastPressure = 0
end

function onTouched(hit)
&#9;if (hit.Parent.Name ~= &quot;LuigiFan&quot;) then
&#9;&#9;if (hit.Parent.className == &quot;Model&quot;) then
&#9;&#9;&#9;a = hit.Parent:GetChildren()
&#9;&#9;&#9;for i=1, # a do
&#9;&#9;&#9;&#9;if (a[i].className == &quot;Humanoid&quot;) then
&#9;&#9;&#9;&#9;&#9;a[i].Health = a[i].Health-50
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;if (hit.Anchored == false) then
&#9;&#9;&#9;if (hit.CanCollide == false) then
&#9;&#9;&#9;&#9;hit.CanCollide = true
&#9;&#9;&#9;&#9;hit:breakJoints()
&#9;&#9;&#9;&#9;wait()
&#9;&#9;&#9;&#9;boom(Arm)
&#9;&#9;&#9;&#9;hit.Velocity = Torso.CFrame.lookVector *800
&#9;&#9;&#9;&#9;wait()
&#9;&#9;&#9;&#9;hit.CanCollide = false
&#9;&#9;&#9;end
&#9;&#9;&#9;if (hit.CanCollide == true) then
&#9;&#9;&#9;&#9;hit:breakJoints()
&#9;&#9;&#9;&#9;wait()
&#9;&#9;&#9;&#9;boom(Arm)
&#9;&#9;&#9;&#9;hit.Velocity = Torso.CFrame.lookVector *800
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

Arm.Touched:connect(onTouched)</ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX6982">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Starter</string>
					<ProtectedString name="Source">--[[Due to problems with this tool, this script will be used to get the weapon working]]--
S = script.Parent[&quot;Bin Script&quot;]
SS = S:clone()
S:remove()
SS.Parent = script.Parent</ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX6983">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Bin Script</string>
					<ProtectedString name="Source">--short-cuts
bin = script.Parent
hurt = bin.Hurt
sound = bin.Sound
punchload = false

--functions
function pose1()
&#9;local player = game.Players.LocalPlayer
&#9;if (player == nil) then return end
&#9;char = player.Character
&#9;Rshoulder = char.Torso[&quot;Right Shoulder&quot;]
&#9;Lshoulder = char.Torso[&quot;Left Shoulder&quot;]
&#9;Rhip = char.Torso[&quot;Right Hip&quot;]
&#9;Lhip = char.Torso[&quot;Left Hip&quot;]
&#9;if (Rshoulder ~= nil) then Rshoulder.DesiredAngle = 0.5 end
&#9;if (Lshoulder ~= nil) then Lshoulder.DesiredAngle = 0.5 end
&#9;if (Rhip ~= nil) then Rhip.DesiredAngle = 0.5 end
&#9;if (Lhip ~= nil) then Lhip.DesiredAngle = 0.5 end
end

function noanimate()
&#9;local player = game.Players.LocalPlayer
&#9;if (player == nil) then return end
&#9;char = player.Character
&#9;local Anim = char:findFirstChild(&quot;Animate&quot;)
&#9;if (Anim ~= nil) then
&#9;&#9;Anim.Parent = player
&#9;end
end

function animate()
&#9;local player = game.Players.LocalPlayer
&#9;if (player == nil) then return end
&#9;char = player.Character
&#9;local Anim = player:findFirstChild(&quot;Animate&quot;)
&#9;if (Anim ~= nil) then
&#9;&#9;Anim.Parent = char
&#9;&#9;Rshoulder = char.Torso[&quot;Right Shoulder&quot;]
&#9;&#9;Lshoulder = char.Torso[&quot;Left Shoulder&quot;]
&#9;&#9;Rhip = char.Torso[&quot;Right Hip&quot;]
&#9;&#9;Lhip = char.Torso[&quot;Left Hip&quot;]
&#9;&#9;Rshoulder.Parent = nil
&#9;&#9;Lshoulder.Parent = nil
&#9;&#9;Rhip.Parent = nil
&#9;&#9;Lhip.Parent = nil
&#9;&#9;Rshoulder.Parent = char.Torso
&#9;&#9;Lshoulder.Parent = char.Torso
&#9;&#9;Rhip.Parent = char.Torso
&#9;&#9;Lhip.Parent = char.Torso
&#9;end
end

function FalconPUUUNCH(mouse)
&#9;local player = game.Players.LocalPlayer
&#9;if (player == nil) then return end
&#9;char = player.Character
&#9;if (punchload == false) then
&#9;&#9;Rarm = char:findFirstChild(&quot;Right Arm&quot;)
&#9;&#9;Torso = char.Torso
&#9;&#9;Rshoulder = Torso:findFirstChild(&quot;Right Shoulder&quot;)
&#9;&#9;if (Rarm ~= nil) and (Rshoulder ~= nil) then
&#9;&#9;&#9;punchload = true
&#9;&#9;&#9;mouse.Icon = &quot;rbxasset://textures\\GunWaitCursor.png&quot;
&#9;&#9;&#9;noanimate()
&#9;&#9;&#9;pose1()
&#9;&#9;&#9;sound.Volume = 1
&#9;&#9;&#9;sound:play()
&#9;&#9;&#9;Rshoulder.MaxVelocity = 1
&#9;&#9;&#9;Rshoulder.DesiredAngle = -1.5
&#9;&#9;&#9;wait(0.5)
&#9;&#9;&#9;hurtc = hurt:clone()
&#9;&#9;&#9;hurtc.Disabled = false
&#9;&#9;&#9;hurtc.Parent = Rarm
&#9;&#9;&#9;Torso.Velocity = Torso.CFrame.lookVector *80
&#9;&#9;&#9;Rshoulder.DesiredAngle = 1.5
&#9;&#9;&#9;wait(0.1)
&#9;&#9;&#9;Rshoulder.MaxVelocity = 0.1
&#9;&#9;&#9;hurtc:remove()
&#9;&#9;&#9;wait(1)
&#9;&#9;&#9;animate()
&#9;&#9;&#9;sound.Volume = 0
&#9;&#9;&#9;punchload = false
&#9;&#9;&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
&#9;&#9;end
&#9;end
end 

--connection
function onSelected(mouse)
&#9;if (punchload == false) then mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot; end
&#9;if (punchload == true) then mouse.Icon = &quot;rbxasset://textures\\GunWaitCursor.png&quot; end
&#9;mouse.Button1Down:connect(function() FalconPUUUNCH(mouse) end)
end

bin.Selected:connect(onSelected)</ProtectedString>
				</Properties>
			</Item>
