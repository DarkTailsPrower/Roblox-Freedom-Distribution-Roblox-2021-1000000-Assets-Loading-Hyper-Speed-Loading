			<Item class="Script" referent="RBX8131">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">SandwichScript</string>
					<ProtectedString name="Source">local Tool = script.Parent;

enabled = true




function onActivated()
&#9;if not enabled  then
&#9;&#9;return
&#9;end

&#9;enabled = false
&#9;Tool.GripForward = Vector3.new(0.675, -0.675, -0.3)
&#9;Tool.GripPos = Vector3.new(0.2, -0.65, 1.2)
&#9;Tool.GripRight = Vector3.new(0.212, -0.212, 0.954)
&#9;Tool.GripUp = Vector3.new(0.707, 0.707, 0)


&#9;Tool.Handle.DrinkSound:Play()

&#9;wait(3)
&#9;
&#9;local h = Tool.Parent:FindFirstChild(&quot;Humanoid&quot;)
&#9;if (h ~= nil) then
&#9;&#9;if (h.MaxHealth &gt; h.Health + 5) then
&#9;&#9;&#9;h.Health = h.Health + 5
&#9;&#9;else&#9;
&#9;&#9;&#9;h.Health = h.MaxHealth
&#9;&#9;end
&#9;end

&#9;Tool.GripForward = Vector3.new(-0.976,0,0.217)
&#9;Tool.GripPos = Vector3.new(0.55, 0, 0)
&#9;Tool.GripRight = Vector3.new(0.217,0,-0.976)
&#9;Tool.GripUp = Vector3.new(0,1,0)


&#9;enabled = true

end

function onEquipped()
&#9;Tool.Handle.OpenSound:play()
end

script.Parent.Activated:connect(onActivated)
script.Parent.Equipped:connect(onEquipped)
</ProtectedString>
				</Properties>
			</Item>
