			<Item class="Script" referent="RBX7173">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Paintball</string>
					<ProtectedString name="Source">ball = script.Parent

function CheckBrick(brick) -- This function checks to see if brick is anchored or locked.
&#9;if brick.Anchored == nil then return false end -- if the brick does not posses the property &quot;anchored&quot; then don&apos;t bother.
&#9;if brick.Locked == nil then return false end -- if the brick does not posses the property &quot;Locked&quot; then don&apos;t bother.
&#9;if brick.Anchored == true then return false end -- if the brick is anchored return false
&#9;if brick.Locked == true then return false end&#9;-- if the brick is anchored return false
&#9;return true -- in none of the above is true then return True.
end

function onTouched(hit)
&#9;if CheckBrick(hit) then
&#9;&#9;local FireScript = script.Parent.fire:clone()
&#9;&#9;FireScript.Disabled = false
&#9;&#9;FireScript.Parent = hit
&#9;end
end


connection = ball.Touched:connect(onTouched)

wait(0.3)
ball.Parent = nil

ball:remove()
</ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX7174">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">PaintballShooter</string>
					<ProtectedString name="Source">Tool = script.Parent

colors = {199}

FireDelay = 0.1 --0.1
Velocity = 225 -- 500

function fire(v)

&#9;Tool.Handle.Fire:play()
&#9;

&#9;local vCharacter = Tool
&#9;local vPlayer = game.Players:playerFromCharacter(vCharacter)

&#9;local missile = Instance.new(&quot;Part&quot;)

        

&#9;local spawnPos = vCharacter.Handle.Position
&#9;


&#9;spawnPos  = spawnPos + (v * 5)

&#9;missile.Position = spawnPos
&#9;missile.Size = Vector3.new(0.2,0.2,0.2)
&#9;missile.Velocity = v * Velocity
&#9;missile.BrickColor = BrickColor.new(colors[math.random(1, #colors)])
&#9;missile.Shape = 0
&#9;missile.BottomSurface = 0
&#9;missile.TopSurface = 0
&#9;missile.Name = &quot;Paintball&quot;
&#9;missile.Elasticity = 0
&#9;missile.Reflectance = 0
&#9;missile.Friction = 1
&#9;missile.Transparency = 1

&#9;local force = Instance.new(&quot;BodyForce&quot;)
&#9;force.force = Vector3.new(0,220,0)
&#9;force.Parent = missile
&#9;
&#9;Tool.BrickCleanup:clone().Parent = missile

&#9;local new_script = script.Parent.Paintball:clone()
&#9;new_script.Disabled = false
&#9;new_script.Parent = missile

&#9;local FireScript = script.Parent.fire:clone()
&#9;FireScript.Disabled = false
&#9;FireScript.Parent = missile

&#9;local creator_tag = Instance.new(&quot;ObjectValue&quot;)
&#9;creator_tag.Value = vPlayer
&#9;creator_tag.Name = &quot;creator&quot;
&#9;creator_tag.Parent = missile
&#9;


&#9;missile.Parent = game.Workspace
&#9;--wait(0.05)
&#9;--fire(
&#9;

end


function check(en)
---------------------------------------Function start here.
if (Tool.Enabled == false) then
return false
end--end for if!
-------------------------------
if (Tool.Enabled == true) then
return true
end
---------------------------------------Function end here.
end


Tool.Enabled = true
function onActivated()

&#9;if not Tool.Enabled then
&#9;&#9;return
&#9;end

&#9;--Tool.Enabled = false

&#9;local character = Tool.Parent;
&#9;local humanoid = character.Humanoid
&#9;if humanoid == nil then
&#9;&#9;print(&quot;Humanoid not found&quot;)
&#9;&#9;return 
&#9;end

&#9;local targetPos = humanoid.TargetPoint
&#9;local lookAt = (targetPos - character.Head.Position).unit
&#9;
&#9;if (check()) then
&#9;fire(lookAt)
&#9;wait(FireDelay)
&#9;onActivated()
&#9;end
&#9;return

&#9;--Tool.Enabled = true
end


script.Parent.Activated:connect(onActivated)
</ProtectedString>
				</Properties>
