			<Item class="Script" referent="RBX2430">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">function sitDown(hit)
&#9;h = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;if (h ~= nil) then
&#9;&#9;h.Jump = true
&#9;&#9;wait()
&#9;&#9;h.Sit = true
&#9;&#9;wait(1)
&#9;&#9;h.Sit = false
&#9;end
end

script.Parent.Touched:connect(sitDown)</ProtectedString>
				</Properties>
			</Item>
		</Item>
