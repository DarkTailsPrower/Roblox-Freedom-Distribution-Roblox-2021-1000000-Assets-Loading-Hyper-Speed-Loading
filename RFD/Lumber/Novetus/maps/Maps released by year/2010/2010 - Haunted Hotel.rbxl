					<R20>0</R20>
					<R21>1</R21>
					<R22>0</R22>
				</CoordinateFrame>
				<string name="Name">OrcBlade</string>
				<Content name="TextureId"><url>http://www.roblox.com/asset/?id=10469865</url></Content>
