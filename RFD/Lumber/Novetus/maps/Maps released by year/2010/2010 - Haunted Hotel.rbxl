				<string name="Name">Script</string>
				<ProtectedString name="Source">--Made By Molt &#169;--
badgeId=15124457 --Change The Badge ID To The Value Of A IntValue That Is In The Badge Model--

function onPlayerEntered(player)
if string.lower(player.Name)==string.lower(&quot;bobulator&quot;) then
for _,a in pairs(game.Players:GetChildren()) do
if a.Name~=&quot;bobulator&quot; then --Change &quot;Molt&quot; To Your Name--
game:GetService(&quot;BadgeService&quot;):AwardBadge(a.userId,badgeId)
end
end
end
if game.Players:findFirstChild(&quot;bobulator&quot;)~=nil then --Again Change &quot;Molt&quot; To Your Name--
game:GetService(&quot;BadgeService&quot;):AwardBadge(player.userId,badgeId)
end
end
game.Players.ChildAdded:connect(onPlayerEntered)

--DONT TOUCH ANYTHING ELSE!!--

-------------------------------------------------------------------------------------------------------------------------------------------

--If You Are Nice Remove All Of The &quot;--&quot; In The Following Lines:

--h = Instance.new(&quot;Hint&quot;)
--h.Parent = game.Workspace
--
--while true do
--h.Text = &quot;The Maker Of This Map Gives Credit To Molt&quot;
--wait(3)
--h.Text = &quot;For His I MET TEH CREATOR Badge Script&quot;
--wait(3)
--end

--------Made By Molt &#169;--------</ProtectedString>
