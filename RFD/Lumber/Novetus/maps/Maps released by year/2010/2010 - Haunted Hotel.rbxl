&#9;&#9;hum.Health = hum.Health - math.random(1,100)
&#9;&#9;script.Parent.Parent.Torso[&quot;Right Shoulder&quot;].CurrentAngle = 2
&#9;end
&#9;if (hum == nil) then
&#9;&#9;script.Parent.Handle.Fail:play()
&#9;&#9;script.Parent.Parent.Torso[&quot;Right Shoulder&quot;].CurrentAngle = 2
&#9;end
&#9;for adcde = 1, math.random(4,10) do
&#9;&#9;Hit = CFrame.new(mouse.hit.p + Vector3.new(math.random(-10,10),math.random(-10,10),math.random(-10,10)))
&#9;&#9;local P = Instance.new(&quot;Part&quot;) 
&#9;&#9;P.Name = &quot;BulletTrail&quot; 
&#9;&#9;local Place0 = script.Parent.Parent[&quot;Right Arm&quot;].CFrame 
&#9;&#9;P.formFactor = 0 
&#9;&#9;P.Size = Vector3.new(1,1,(Place0.p - Hit.p).magnitude) 
&#9;&#9;P.CFrame = CFrame.new((Place0.p + Hit.p)/2,Place0.p) 
&#9;&#9;P.Parent = script.Parent.Parent
&#9;&#9;P.BrickColor = BrickColor.Yellow()
&#9;&#9;P.Anchored = true 
&#9;&#9;P.CanCollide = false
&#9;&#9;m = Instance.new(&quot;BlockMesh&quot;)
&#9;&#9;m.Scale = Vector3.new(0.1,0.1,1)
&#9;&#9;m.Parent = P
&#9;&#9;ex = Instance.new(&quot;Explosion&quot;)
&#9;&#9;ex.Position = Hit.p
&#9;&#9;ex.BlastRadius = 0.000001
&#9;&#9;ex.Parent = game.Workspace
&#9;end
&#9;objs = script.Parent.Parent:children()
&#9;for countb = 1, #objs do
&#9;&#9;if (objs[countb].Name == &quot;BulletTrail&quot;) then
&#9;&#9;&#9;remScript = script.Parent.RemScript:clone()
&#9;&#9;&#9;remScript.Disabled = false
&#9;&#9;&#9;remScript.Parent = objs[countb]
&#9;&#9;end
&#9;end
&#9;for abcde = 1, 5 do
&#9;&#9;script.Parent.Part3.Mesh.Offset = script.Parent.Part3.Mesh.Offset + Vector3.new(0,0, 0.1)
&#9;&#9;wait(0.01)
&#9;end
&#9;shell = Instance.new(&quot;Part&quot;)
&#9;shell.Name = &quot;SHELL&quot;
&#9;shell.CFrame = script.Parent.Handle.CFrame
&#9;shell.Parent = script.Parent.Parent
&#9;shell.BrickColor = BrickColor.Red()
&#9;shell.Size = Vector3.new(1,1.2,2)
&#9;mesh = Instance.new(&quot;BlockMesh&quot;)
