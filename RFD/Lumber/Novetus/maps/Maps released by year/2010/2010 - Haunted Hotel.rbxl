&#9;mesh.Parent = shell
&#9;for abcde = 1, 5 do
&#9;&#9;script.Parent.Part3.Mesh.Offset = script.Parent.Part3.Mesh.Offset - Vector3.new(0,0, 0.1)
&#9;&#9;wait(0.01)
&#9;end
&#9;shell:breakJoints()
&#9;enabled = true
end



function onEquippedLocal(mouse)



&#9;if mouse == nil then

&#9;&#9;print(&quot;Mouse not found&quot;)

