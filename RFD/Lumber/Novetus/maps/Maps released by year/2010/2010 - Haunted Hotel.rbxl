			<Item class="Script" referent="RBX2029">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">debounce = false

function onT(hit)
&#9;if (hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil) and (debounce == false) then

&#9;&#9;debounce = true

&#9;&#9;local m = Instance.new(&quot;Message&quot;)
&#9;&#9;m.Parent = hit.Parent
&#9;&#9;m.Text = &quot;Ill see you in hell, &quot;..hit.Parent.Name..&quot;&quot;&#9;&#9;&#9;&#9;&#9;&#9;&#9;--Edit
&#9;&#9;wait(4) &#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;--Seconds to wait for text to change (edit) &#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;--Seconds to wait for text to change (edit)
&#9;&#9;m:Remove()
&#9;&#9;debounce = false
&#9;end
end

script.Parent.Touched:connect(onT)</ProtectedString>
				</Properties>
			</Item>
		</Item>
