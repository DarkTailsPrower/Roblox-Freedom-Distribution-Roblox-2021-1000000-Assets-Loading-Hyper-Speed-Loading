			<Item class="Script" referent="RBX6367">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">--This is Waksack
print(&quot;SK8RDEVAN&apos;s message box&quot;)

local debounce = false


function onHit(hit)
&#9;local human = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;if (human ~= nil) and debounce == false then

                debounce = true

local message = Instance.new(&quot;Message&quot;)
message.Text = &quot;Samara.....&quot; -- Waksack, Type what you want in the parenthesis.
message.Parent = game.Players:playerFromCharacter(hit.Parent)
wait(3)
message:Remove ()

                debounce = false
&#9;end
end

script.Parent.Touched:connect(onHit)

-- If you dont want that many messages, delete some of them off. If you want more, copy more of them.</ProtectedString>
				</Properties>
