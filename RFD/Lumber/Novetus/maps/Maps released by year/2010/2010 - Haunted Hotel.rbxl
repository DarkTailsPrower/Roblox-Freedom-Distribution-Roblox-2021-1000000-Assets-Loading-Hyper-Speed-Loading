					<ProtectedString name="Source">print(&quot;lol&quot;)

function Touched(part)
&#9;script.Parent.GlassBreak:Play()
&#9;con:disconnect()
end



con = script.Parent.Touched:connect(Touched)

wait(30)
script.Parent:Remove()</ProtectedString>
