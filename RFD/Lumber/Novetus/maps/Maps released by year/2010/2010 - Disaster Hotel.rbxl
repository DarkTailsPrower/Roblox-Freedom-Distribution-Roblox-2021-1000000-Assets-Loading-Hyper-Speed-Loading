ray.CFrame=CFrame.new((mouse.hit.p+script.Parent.Handle.Position)/2)
ray.CFrame=CFrame.new(ray.Position,mouse.hit.p)
m.Scale=Vector3.new(2,2,(mouse.hit.p-script.Parent.Handle.Position).magnitude)
if ran==2 and mouse.Target~=nil and (mouse.Target.Position-script.Parent.Handle.Position).magnitude&lt;40 and mouse.Target.Name==&quot;Burning&quot; then
mouse.Target.Name=&quot;Part&quot;
if mouse.Target:FindFirstChild(&quot;Smoke&quot;)~=nil then
mouse.Target.Smoke:remove()
end
elseif ran==2 and mouse.Target~=nil and (mouse.Target.Position-script.Parent.Handle.Position).magnitude&lt;40 and mouse.Target.Name==&quot;Flame&quot; then
mouse.Target:remove()
end
wait(.1)
script.Parent.Water.Value=script.Parent.Water.Value-1
t.Size=UDim2.new(0.0008*script.Parent.Water.Value,0,0.05,0)
t.Text=&quot;WATER LEFT=&quot;..script.Parent.Water.Value
end
if ray~=nil and ray.Parent~=nil then
ray:remove()
end
end

end

