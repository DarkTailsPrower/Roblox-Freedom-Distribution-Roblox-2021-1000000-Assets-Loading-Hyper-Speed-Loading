			<Item class="Script" referent="RBX5589">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">local normal=&quot;http://www.roblox.com/asset?id=258070165&quot;
local fire=&quot;http://www.roblox.com/asset?id=25807481&quot;
local nuke=&quot;http://www.roblox.com/asset?id=25807450&quot;
local earthquake=&quot;http://www.roblox.com/asset?id=25807422&quot;
local flood=&quot;http://www.roblox.com/asset?id=25807460&quot;
local tsunami=&quot;http://www.roblox.com/asset?id=25807474&quot;
local bombs=&quot;http://www.roblox.com/asset?id=25807491&quot;
local storm=&quot;http://www.roblox.com/asset?id=25807433&quot;
local shop=false


if script.Parent.Parent.Name~=&quot;StarterGui&quot; then
local shopgui=game.Lighting.Shop:clone()
shopgui.Parent=nil

function OpenShop()
if shop==false then
shop=true
shopgui.Parent=script.Parent.Parent
script.Parent.shop.BackgroundColor3=Color3.new(0,0.7,0)
script.Parent.shop.Text=&quot;CLICK TO CLOSE SHOP&quot;
elseif shop==true then
shop=false
shopgui.Parent=nil
script.Parent.shop.BackgroundColor3=Color3.new(0,0.9,0)
script.Parent.shop.Text=&quot;CLICK TO OPEN SHOP&quot;
end
end
script.Parent.shop.MouseButton1Click:connect(OpenShop)


function Update(state)
if state==&quot;Normal&quot; then
script.Parent.State.Text=&quot;HOTEL STATE=NORMAL&quot;
script.Parent.StatePic.Image=normal
elseif state==&quot;Burning&quot; then
script.Parent.State.Text=&quot;HOTEL STATE=BURNING&quot;
script.Parent.StatePic.Image=fire
elseif state==&quot;Flood&quot; then
script.Parent.State.Text=&quot;HOTEL STATE=FLOOD&quot;
script.Parent.StatePic.Image=flood
elseif state==&quot;Tsunami&quot; then
script.Parent.State.Text=&quot;HOTEL STATE=TSUNAMI&quot;
script.Parent.StatePic.Image=tsunami
elseif state==&quot;Nuke&quot; then
script.Parent.State.Text=&quot;HOTEL STATE=BEING NUKED&quot;
script.Parent.StatePic.Image=nuke
elseif state==&quot;Earthquake&quot; then
script.Parent.State.Text=&quot;HOTEL STATE=EARTHQUAKE&quot;
script.Parent.StatePic.Image=earthquake
elseif state==&quot;Dangeurous rescue&quot; then
script.Parent.State.Text=&quot;HOTEL STATE=BOMB RAIN&amp;RESCUE&quot;
script.Parent.StatePic.Image=bombs
elseif state==&quot;Storm&quot; then
script.Parent.State.Text=&quot;HOTEL STATE=STORM&quot;
script.Parent.StatePic.Image=storm
end
end
game.Workspace.GameState.Changed:connect(Update)

function reset()
script.Parent.Parent.Parent.Character:BreakJoints()
end
script.Parent.Reset.MouseButton1Click:connect(reset)

Update(game.Workspace.GameState.Value)
while true do
if script.Parent.Parent.Parent.Character:FindFirstChild(&quot;Torso&quot;)~=nil then
script.Parent.Height.Text=&quot;HEIGHT = &quot;..math.floor(script.Parent.Parent.Parent.Character.Torso.Position.y)..&quot; STUDS&quot;
end
if Data~=nil then
script.Parent.flames.Text=&quot;#FLAMES= &quot;..Data.x
script.Parent.parts.Text=&quot;#BURNING PARTS= &quot;..Data.y
end
script.Parent.ServerAge.Text=&quot;Server Age= &quot;..math.floor(game.Workspace.DistributedGameTime)..&quot; Seconds&quot;
wait(.5)
end
end

</ProtectedString>
