							<string name="Name">Script</string>
							<ProtectedString name="Source">function onTouched(hit)
if hit.Locked==false and hit.Velocity.magnitude==0 then
local e=Instance.new(&quot;Explosion&quot;)
e.Parent=script.Parent
e.Position=script.Parent.Position
e.BlastRadius=20
e.BlastPressure=0
e.Hit:connect(
function(h)
if h.Locked==false and h.Name==&quot;Part&quot; then
shared.AddPart(h)
end
end
)
end
end
wait(1)
script.Parent.Touched:connect(onTouched)</ProtectedString>
							<bool name="archivable">true</bool>
