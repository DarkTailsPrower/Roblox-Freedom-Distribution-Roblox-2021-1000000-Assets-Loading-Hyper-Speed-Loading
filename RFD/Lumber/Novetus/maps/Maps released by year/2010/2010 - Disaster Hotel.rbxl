						<ProtectedString name="Source">local spawn=game.Workspace.Hotel.Spawn4
local sn=spawn.Name
local db=0
local cost=3

function touch(hit)
if db==0 and hit.Parent~=nil and game.Players:FindFirstChild(hit.Parent.Name)~=nil then
db=1
local player=game.Players:FindFirstChild(hit.Parent.Name)
if spawn~=nil and spawn.Parent~=nil then
if shared.CheckVIP(hit.Parent) == false and shared.CheckAdmin(hit.Parent) == false then
if player.leaderstats.Points.Value&gt;=cost then
player.leaderstats.Points.Value=player.leaderstats.Points.Value-cost
script.Parent.Head.BrickColor=BrickColor.New(&quot;Really black&quot;)
hit.Parent:MoveTo(spawn.Position+Vector3.new(0,3,0))
player.Mode.Value=false
end
else
script.Parent.Head.BrickColor=BrickColor.New(&quot;Really black&quot;)
hit.Parent:MoveTo(spawn.Position+Vector3.new(0,3,0))
player.Mode.Value=false
end
end
