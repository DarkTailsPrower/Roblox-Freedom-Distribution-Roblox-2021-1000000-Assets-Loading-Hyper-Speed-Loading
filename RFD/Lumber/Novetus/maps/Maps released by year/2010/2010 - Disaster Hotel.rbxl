				<string name="Name">IdCheckScript</string>
				<ProtectedString name="Source">local list={&quot;Radioaktiivinen&quot;,&quot;buildthomas&quot;,&quot;joshystrong&quot;,&quot;geolantgru&quot;,&quot;RomulusAndRemus&quot;,&quot;Player&quot;,&quot;Einnel&quot;,&quot;Watahell&quot;,&quot;paratroopersoldier&quot;,&quot;Awlq&quot;,&quot;RandomMe98&quot;,&quot;Sogy456&quot;,&quot;IVORBLOX&quot;,&quot;Kasukiro&quot;,&quot;mikki&quot;,&quot;cosmicguy&quot;,&quot;Funkyman5000&quot;,&quot;Wizardtail&quot;,&quot;Georgebobpants&quot;,&quot;Ashiscool1&quot;}


shared[&quot;CheckID&quot;]=function(Name)
for i,v in pairs(list) do
if v==Name then
return true
end
end
return false
end

shared[&quot;CheckVIP&quot;]=function(char)
if char:findFirstChild(&quot;Shirt Graphic&quot;) ~= nil then
if char:findFirstChild(&quot;Shirt Graphic&quot;).Graphic==workspace.VIP.Value or char:findFirstChild(&quot;Shirt Graphic&quot;).Graphic==workspace.VIP2.Value then
return true
end
end
return false
end

shared[&quot;CheckAdmin&quot;]=function(char)
if char:findFirstChild(&quot;Shirt Graphic&quot;) ~= nil then
if char:findFirstChild(&quot;Shirt Graphic&quot;).Graphic==workspace.ULTRA.Value or char:findFirstChild(&quot;Shirt Graphic&quot;).Graphic==workspace.ULTRA2.Value then
return true
end
end
return false
end </ProtectedString>
				<bool name="archivable">true</bool>
