				<Item class="Script" referent="RBX5449">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">local Ele=script.Parent
local CurrentFloor=1
local engy=script.Parent.Engine
local db=0
local Floors={}
table.insert(Floors,#Floors+1,{Vector3.new(0,6.1,0),Ele.F11,Ele.F12,Ele.Floor1.ClickDetector,Ele.Floor1C.ClickDetector})
table.insert(Floors,#Floors+1,{Vector3.new(0,20.1,0),Ele.F21,Ele.F22,Ele.Floor2.ClickDetector,Ele.Floor2C.ClickDetector})
table.insert(Floors,#Floors+1,{Vector3.new(0,34.1,0),Ele.F31,Ele.F32,Ele.Floor3.ClickDetector,Ele.Floor3C.ClickDetector})
table.insert(Floors,#Floors+1,{Vector3.new(0,48.1,0),Ele.F41,Ele.F42,Ele.Floor4.ClickDetector,Ele.Floor4C.ClickDetector})
table.insert(Floors,#Floors+1,{Vector3.new(0,62.1,0),Ele.F51,Ele.F52,Ele.Floor5.ClickDetector,Ele.Floor5C.ClickDetector})
table.insert(Floors,#Floors+1,{Vector3.new(0,76.1,0),Ele.F61,Ele.F62,Ele.Floor6.ClickDetector,Ele.Floor6C.ClickDetector})
table.insert(Floors,#Floors+1,{Vector3.new(0,90.1,0),Ele.F71,Ele.F72,Ele.Floor7.ClickDetector,Ele.Floor7C.ClickDetector})
table.insert(Floors,#Floors+1,{Vector3.new(0,104.1,0),Ele.F81,Ele.F82,Ele.Floor8.ClickDetector,Ele.Floor8C.ClickDetector})
table.insert(Floors,#Floors+1,{Vector3.new(0,118.1,0),Ele.F91,Ele.F92,Ele.Floor9.ClickDetector,Ele.Floor9C.ClickDetector})
table.insert(Floors,#Floors+1,{Vector3.new(0,132.1,0),Ele.F101,Ele.F102,Ele.Floor10.ClickDetector,Ele.Floor10C.ClickDetector})
table.insert(Floors,#Floors+1,{Vector3.new(0,146.1,0),Ele.F111,Ele.F112,Ele.Floor11.ClickDetector,Ele.Floor11C.ClickDetector})
table.insert(Floors,#Floors+1,{Vector3.new(0,160.1,0),Ele.F121,Ele.F122,Ele.Floor12.ClickDetector,Ele.Floor12C.ClickDetector})
table.insert(Floors,#Floors+1,{Vector3.new(0,174.1,0),Ele.F131,Ele.F132,Ele.Floor13.ClickDetector,Ele.Floor13C.ClickDetector})
table.insert(Floors,#Floors+1,{Vector3.new(0,188.1,0),Ele.F141,Ele.F142,Ele.Floor14.ClickDetector,Ele.Floor14C.ClickDetector})
table.insert(Floors,#Floors+1,{Vector3.new(0,202.1,0),Ele.F151,Ele.F152,Ele.Floor15.ClickDetector,Ele.Floor15C.ClickDetector})
table.insert(Floors,#Floors+1,{Vector3.new(0,216.1,0),Ele.F161,Ele.F162,Ele.Floor16.ClickDetector,Ele.Floor16C.ClickDetector})

for i,v in pairs(Floors) do
v[1]=v[1]-Vector3.new(0,2,0)
end



function Move(Floor)
if db==0 then
db=1
local FloorData=Floors[Floor]
if Floors[CurrentFloor][4].Parent.Parent~=nil and Floors[CurrentFloor][5].Parent.Parent~=nil then
Floors[CurrentFloor][4].Parent.BrickColor=BrickColor.new(&quot;Bright red&quot;)
Floors[CurrentFloor][5].Parent.BrickColor=BrickColor.new(&quot;Bright red&quot;)
end
if FloorData[4].Parent.Parent~=nil and FloorData[5].Parent.Parent~=nil then
FloorData[4].Parent.BrickColor=BrickColor.new(&quot;Bright yellow&quot;)
FloorData[5].Parent.BrickColor=BrickColor.new(&quot;Bright yellow&quot;)
end
if Floors[CurrentFloor][2].Parent~=nil then
Floors[CurrentFloor][2].CanCollide=true
Floors[CurrentFloor][2].Transparency=0
end
if Floors[CurrentFloor][3].Parent~=nil then
Floors[CurrentFloor][3].CanCollide=true
Floors[CurrentFloor][3].Transparency=0
end
if Ele:FindFirstChild(&quot;E1&quot;)~=nil then
Ele.E1.CanCollide=true
Ele.E1.Transparency=0
end
if Ele:FindFirstChild(&quot;E2&quot;)~=nil then
Ele.E2.CanCollide=true
Ele.E2.Transparency=0
end
local dir=0
if FloorData[1].y&lt;Ele.Engine.Position.y then
dir=-1
else
dir=1
end

while (FloorData[1].y-Ele.Engine.Position.y)*dir&gt;0.5 do
Ele.Engine.BodyVelocity.velocity=Vector3.new(0,(3+(math.abs(FloorData[1].y-Ele.Engine.Position.y)/10))*dir,0)
wait(.1)
end

Ele.Engine.BodyVelocity.velocity=Vector3.new(0,0,0)
if Ele:FindFirstChild(&quot;E1&quot;)~=nil then
Ele.E1.CanCollide=false
Ele.E1.Transparency=1
end
if Ele:FindFirstChild(&quot;E2&quot;)~=nil then
Ele.E2.CanCollide=false
Ele.E2.Transparency=1
end
if Floors[Floor][2].Parent~=nil then
Floors[Floor][2].CanCollide=false
Floors[Floor][2].Transparency=1
end
if Floors[Floor][3].Parent~=nil then
Floors[Floor][3].CanCollide=false
Floors[Floor][3].Transparency=1
end
if FloorData[4].Parent.Parent~=nil and FloorData[5].Parent.Parent~=nil then
FloorData[4].Parent.BrickColor=BrickColor.new(&quot;Lime green&quot;)
FloorData[5].Parent.BrickColor=BrickColor.new(&quot;Lime green&quot;)
end
CurrentFloor=Floor
wait(4)
db=0
end
end


for i,v in pairs(Floors) do
v[4].MouseClick:connect(function() Move(i) end)
v[5].MouseClick:connect(function() Move(i) end)
end
