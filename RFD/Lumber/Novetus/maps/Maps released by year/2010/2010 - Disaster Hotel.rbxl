				<Item class="Script" referent="RBX3832">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">function onTouched(hit)
if hit.Locked==true then
if hit.Name==&quot;Burning&quot; then
hit.Name=&quot;Part&quot;
end
local b=Instance.new(&quot;Part&quot;)
b.Shape=0
b.Size=Vector3.new(1,1,1)
b.BrickColor=BrickColor.new(&quot;Bright blue&quot;)
b.Transparency=0.6
b.CanCollide=false
b.Name=&quot;Water&quot;
b.Position=hit.Position
b.Velocity=Vector3.new(math.random(-10,10),10,math.random(-10,10))
b.Parent=script.Parent
game:GetService(&quot;Debris&quot;):AddItem(b,2)
end
end
script.Parent.Touched:connect(onTouched)</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
