				<Item class="Script" referent="RBX5535">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">local spawn=game.Workspace.Hotel.Spawn2
local sn=spawn.Name
local db=0
local cost=1

function touch(hit)
if db==0 and hit.Parent~=nil and game.Players:FindFirstChild(hit.Parent.Name)~=nil then
db=1
local player=game.Players:FindFirstChild(hit.Parent.Name)
if spawn~=nil and spawn.Parent~=nil then
if shared.CheckVIP(hit.Parent) == false and shared.CheckAdmin(hit.Parent) == false then
if player.leaderstats.Points.Value&gt;=cost then
player.leaderstats.Points.Value=player.leaderstats.Points.Value-cost
script.Parent.Head.BrickColor=BrickColor.New(&quot;Really black&quot;)
hit.Parent:MoveTo(spawn.Position+Vector3.new(0,3,0))
player.Mode.Value=false
end
else
script.Parent.Head.BrickColor=BrickColor.New(&quot;Really black&quot;)
hit.Parent:MoveTo(spawn.Position+Vector3.new(0,3,0))
player.Mode.Value=false
end
end
wait(1)
script.Parent.Head.BrickColor=BrickColor.New(&quot;Camo&quot;)
db=0
elseif spawn==nil or spawn.Parent==nil then
script.Parent.Head.BrickColor=BrickColor.new(&quot;Really red&quot;)
db=1
else
script.Parent.Head.BrickColor=BrickColor.New(&quot;Really black&quot;)
wait(1)
script.Parent.Head.BrickColor=BrickColor.New(&quot;Camo&quot;)
db=0
end
end

script.Parent.Head.Touched:connect(touch)</ProtectedString>
