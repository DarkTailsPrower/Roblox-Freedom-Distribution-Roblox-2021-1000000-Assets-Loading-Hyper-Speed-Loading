				<Item class="Script" referent="RBX57">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">local db=0
function t(hit)
if db==0 and hit.Parent~=nil and game.Players:FindFirstChild(hit.Parent.Name)~=nil then
db=1
local player=game.Players:FindFirstChild(hit.Parent.Name)
player.leaderstats.Points.Value=math.ceil(player.leaderstats.Points.Value+((player.leaderstats.Survived.Value/5)^1.15))
hit.Parent:BreakJoints()
wait(2)
db=0
end
end
script.Parent.Touched:connect(t)
wait(180)
script.Parent.BodyVelocity.velocity=Vector3.new(0,8,0)
wait(10)
script.Parent.Parent:remove()</ProtectedString>
						<bool name="archivable">true</bool>
