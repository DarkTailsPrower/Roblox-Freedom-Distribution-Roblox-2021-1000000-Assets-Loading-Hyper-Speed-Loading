			<Item class="Script" referent="RBX5630">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">WeldScript</string>
					<ProtectedString name="Source">local weld=Instance.new(&quot;Weld&quot;)
weld.Part0=script.Parent.Handle
weld.Part1=script.Parent.Handle1
weld.C0=CFrame.new(0,1.5,0)
weld.Parent=game.JointsService
function weld()
local weld=Instance.new(&quot;Weld&quot;)
weld.Part0=script.Parent.Handle
weld.Part1=script.Parent.Handle1
weld.C0=CFrame.new(0,1.5,0)
weld.Parent=game.JointsService
end
script.Parent.Equipped:connect(weld)
script.Parent.Unequipped:connect(weld)</ProtectedString>
