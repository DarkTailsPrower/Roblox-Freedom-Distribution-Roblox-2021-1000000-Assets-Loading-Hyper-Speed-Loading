		<Item class="Script" referent="RBX6">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">CreatorBadge</string>
				<ProtectedString name="Source">badgeId=28606010

function onPlayerEntered(player)
if string.lower(player.Name)==string.lower(&quot;Radioaktiivinen&quot;) then
for _,a in pairs(game.Players:GetChildren()) do
if a.Name~=&quot;Radioaktiivinen&quot; then
game:GetService(&quot;BadgeService&quot;):AwardBadge(a.userId,badgeId)
end
end
end
if game.Players:findFirstChild(&quot;Radioaktiivinen&quot;)~=nil then
game:GetService(&quot;BadgeService&quot;):AwardBadge(player.userId,badgeId)
end
end
game.Players.ChildAdded:connect(onPlayerEntered)</ProtectedString>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX7">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">GameScript</string>
				<ProtectedString name="Source">local hclone=game.Workspace.Hotel:clone()
local wclone=game.Workspace.WaitRoom:clone()
local fclone=game.Workspace.FireScript:clone()
local sclone=game.Workspace.Sea:clone()
local NoobBoat=game.Workspace.NoobBoat:clone()
game.Workspace.NoobBoat:remove()
local Tidal=game.Workspace.TidalWave:clone()
game.Workspace.TidalWave:remove()
local Heli=game.Workspace.Heli:clone()
game.Workspace.Heli:remove()
local debris=game:GetService(&quot;Debris&quot;)
local nuke=game.Workspace.Nuke:clone()
game.Workspace.Nuke:remove()
local k=1




function Nuke()
local n=nuke:clone()
n.Parent=game.Workspace
n.BigRedButton.Value=true
while n~=nil and n.Parent~=nil do
wait(3)
end
end

function Storm(time)
local r=1
local bricks=game.Workspace.Hotel:GetChildren()
for i=1,10 do
game.Lighting.Brightness=game.Lighting.Brightness-0.1
wait(.2)
end
game.Lighting.Ambient=Color3.new(80/255,80/255,80/255)
for i=1,20 do
local p=Instance.new(&quot;Part&quot;)
p.Anchored=true
p.CanCollide=false
p.Locked=true
p.Transparency=1
p.CFrame=CFrame.new(math.random(-70,70)+20,math.random(0,200),math.random(-70,70)+155)
local s=Instance.new(&quot;Smoke&quot;)
s.Color=Color3.new(0,0,0)
s.Size=75
s.Opacity=0.5
s.RiseVelocity=0
s.Parent=p
p.Parent=workspace
game:GetService(&quot;Debris&quot;):AddItem(p,time)
end
for i=1,time do

if math.random(1,10)==7 then
game.Lighting.Ambient=Color3.new(255/255,255/255,255/255)
wait(0.3)
game.Lighting.Ambient=Color3.new(80/255,80/255,80/255)
wait(0.3)
game.Lighting.Ambient=Color3.new(255/255,255/255,255/255)
wait(0.3)
game.Lighting.Ambient=Color3.new(80/255,80/255,80/255)
else
wait(1)
end

for i,v in pairs(bricks) do
if r==137 and v.className==&quot;Part&quot; and v.Locked==false and v.Anchored==false then
v:BreakJoints()
v.Velocity=Vector3.new(math.random(-20,20),math.random(0,40),math.random(0,80))
table.remove(bricks,i)
end
if r&lt;2000 then
r=r+1
else
r=1
end
end

local evel=Vector3.new(math.random(-20,20),0,math.random(0,80))
for i,v in pairs(game.Players:GetChildren()) do
if v.Character~=nil and v:findFirstChild(&quot;Mode&quot;).Value == false and v.Character:FindFirstChild(&quot;Torso&quot;)~=nil then
local vel=v.Character.Torso:FindFirstChild(&quot;BodyVelocity&quot;)
if vel==nil then
local b=Instance.new(&quot;BodyVelocity&quot;)
b.Parent=v.Character.Torso
b.maxForce=Vector3.new(50000,0,50000)
b.velocity=Vector3.new(0,0,0)
vel=b
end
vel.velocity=evel
if math.random(1,30)==13 then
v.Character.Humanoid.Sit=true
end
end
end



end
for i=1,10 do
game.Lighting.Brightness=game.Lighting.Brightness+0.1
wait(.3)
end
game.Lighting.Ambient=Color3.new(192/255,192/255,192/255)

for i,v in pairs(game.Players:GetChildren()) do
if v.Character~=nil and v.Character.Parent~=nil and v.Character:FindFirstChild(&quot;Torso&quot;)~=nil then
local vel=v.Character.Torso:FindFirstChild(&quot;BodyVelocity&quot;)
if vel~=nil then
vel:remove()
end
end
end

end


function Rescue()
local heli=Heli:clone()
heli.Parent=game.Workspace
heli:MakeJoints()
end

function ClearDebris()
for i,v in pairs(game.Workspace.Hotel:GetChildren()) do
if v.className==&quot;Part&quot; and v.Velocity.y~=0 and v.Locked==false and math.random(1,10)&gt;2 then
v:remove()
end
end
end

function NoobBoatAttack()
Boat=NoobBoat:clone()
Boat.Parent=game.Workspace
Boat:MakeJoints()
wait(25)
for i,v in pairs(Boat.Ignitables:GetChildren()) do
shared.AddPart(v,false)
end
end

function TidalWave()
local tid=Tidal:clone()
tid.Parent=game.Workspace
tid:MakeJoints()
debris:AddItem(tid,120)
end

function BombAttack(time,bombs)
for i=1,bombs do
wait(time)

local p=Instance.new(&quot;Part&quot;)

p.Locked=true
p.formFactor=&quot;Symmetric&quot;
p.Size=Vector3.new(2,3,2)
p.BrickColor=BrickColor.new(&quot;Black&quot;)
p.Position=Vector3.new(math.random(-70,70),500,math.random(-70,70))+Vector3.new(25,140)
local v=Instance.new(&quot;BodyVelocity&quot;)
v.Parent=p
v.maxForce=Vector3.new(100,1000000,100)
v.velocity=Vector3.new(0,-120,0)

p.Parent=game.Workspace
p.Touched:connect(
function(hit)
p:remove()
local E=Instance.new(&quot;Explosion&quot;)
E.Parent=game.Workspace
E.Position=p.Position
E.BlastPressure=0
E.BlastRadius=10
E.Hit:connect(
function(h)
if game.Players:FindFirstChild(h.Parent.Name)==nil and hit.Locked==false then
h:BreakJoints()
if math.random(1,4)&gt;1 then
h:remove()
end
h.Velocity=(E.Position-h.Position).unit*(((E.Position-h.Position).magnitude)*20)
elseif h.Parent:FindFirstChild(&quot;Humanoid&quot;)~=nil then
h.Parent.Humanoid:TakeDamage(((E.Position-h.Position).magnitude)*5)
end
end
)

end
)
end
end



function EarthQuake(model,time)
local file=model:GetChildren()
for i=1,time*2 do
wait(.5)
local evel=Vector3.new(math.random(-20,20),0,math.random(-20,20))
for i,v in pairs(game.Players:GetChildren()) do
if v.Mode.Value ==false and v.Character~=nil and v.Character.Parent~=nil and v.Character:FindFirstChild(&quot;Torso&quot;)~=nil then
local vel=v.Character.Torso:FindFirstChild(&quot;BodyVelocity&quot;)
if vel==nil then
local b=Instance.new(&quot;BodyVelocity&quot;)
b.Parent=v.Character.Torso
b.maxForce=Vector3.new(10000,0,10000)
b.velocity=Vector3.new(0,0,0)
vel=b
end
vel.velocity=evel
if math.random(1,20)==13 then
v.Character.Humanoid.Sit=true
end
end
end


for i,v in pairs(file) do
if k==137 and v.Parent~=nil and v.className==&quot;Part&quot; and v.Velocity.y==0 and v.Locked==false then
v.Anchored=false
v:BreakJoints()
debris:AddItem(v,30)
end
if k&lt;2000 then
k=k+1
else
k=1
end
end

for i,v in pairs(game.Players:GetChildren()) do
if v.Character~=nil and v.Character.Parent~=nil and v.Character:FindFirstChild(&quot;Torso&quot;)~=nil then
local vel=v.Character.Torso:FindFirstChild(&quot;BodyVelocity&quot;)
if vel~=nil then
vel:remove()
end
end
end
end
end

function Regen()

shared.ClearData()
game.Workspace.Hotel:remove()
game.Workspace.WaitRoom:remove()
for i,v in pairs(game.Players:GetChildren()) do
if v.Character~=nil then
v.Character:BreakJoints()
end
end
wait(5)
local c=hclone:clone()
c.Parent=game.Workspace
c:MakeJoints()
c=wclone:clone()
c.Parent=game.Workspace
c:MakeJoints()
if game.Workspace:FindFirstChild(&quot;NoobBoat&quot;)~=nil then
game.Workspace.NoobBoat:remove()
end
if game.Workspace:FindFirstChild(&quot;TidalWave&quot;)~=nil then
game.Workspace.TidalWave:remove()
end
if game.Workspace:FindFirstChild(&quot;Flames&quot;)~=nil then game.Workspace.Flames:remove() end
if game.Workspace:FindFirstChild(&quot;FireScript&quot;)~=nil then
game.Workspace.FireScript:remove()
end
c=fclone:clone()
c.Parent=game.Workspace
if game.Workspace:FindFirstChild(&quot;Sea&quot;)~=nil then
game.Workspace.Sea:remove()
end
c=sclone:clone()
c.Parent=game.Workspace
end

function MakeMessage(time,message)
for i,v in pairs(game.Players:GetChildren()) do
if v:FindFirstChild(&quot;PlayerGui&quot;)~=nil then
local s=Instance.new(&quot;ScreenGui&quot;)
s.Parent=v.PlayerGui
local m=Instance.new(&quot;TextLabel&quot;)
m.Size=UDim2.new(0.84,0,0.04,0)
m.Position=UDim2.new(0.16,0,0.96,0)
m.BackgroundColor3=Color3.new(0,0,0)
m.TextColor3=Color3.new(0,1,0)
m.BorderColor3=Color3.new(0,1,0)
m.Text=message
m.Parent=s
debris:AddItem(s,time)
end
end
local s=Instance.new(&quot;ScreenGui&quot;)
s.Parent=game.StarterGui
local m=Instance.new(&quot;TextLabel&quot;)
m.Size=UDim2.new(0.84,0,0.04,0)
m.Position=UDim2.new(0.16,0,0.96,0)
m.BackgroundColor3=Color3.new(0,0,0)
m.TextColor3=Color3.new(0,1,0)
m.BorderColor3=Color3.new(0,1,0)
m.Text=message
m.Parent=s
debris:AddItem(s,time)
end

function waitforplayer()
while #(game.Players:GetChildren())==0 do
wait(1)
end
end

while true do
wait(20)
Regen()
wait(20)
shared.UpdateBricks(game.Workspace.Hotel,game.Workspace.Hotel)
game.Workspace.GameState.Value=&quot;Normal&quot;
wait(10)
MakeMessage(20,&quot;Its a nice day today, isnt it? :3 Ill call my noob friends to come here with a boat :D&quot;)
wait(20)------------------------------------------------------------------------------------------------disaster free time
MakeMessage(25,&quot;Oh there they come! *points at the ocean*&quot;)
NoobBoatAttack()
MakeMessage(15,&quot;ZOMG MEH GEEH THEIR BOAT IS ON FIRE!!!111     GAAHW!!1111     O_O&quot;)
wait(15)
MakeMessage(10,&quot;AHHHHH OMG RANN PANIC DO SOMETHING OLOLOLO!!!111111    X_X THE ISLAND IS ON FIRE!!!!111&quot;)
game.Workspace.GameState.Value=&quot;Burning&quot;
wait(10)
MakeMessage(30,&quot;*cools down* Search something to shut it down!!!1111  we wont be able to stop it, but we will get time!&quot;)
wait(30)
MakeMessage(600,&quot;its burning.         &gt;.&gt;&quot;)
wait(800)-----------------------------------------------------------------------------------------------Burning time
ClearDebris()
MakeMessage(105,&quot;*&gt;.&gt;* AHHHH A FLOOD!!!   RUN!    The water is full of toxic waste from medicine factories!!!11      -.-&quot;)
game.Workspace.GameState.Value=&quot;Flood&quot;
for i=1,210 do
for i=1,5 do
game.Workspace.Sea.CFrame=game.Workspace.Sea.CFrame+Vector3.new(0,0.2,0)
wait(.1)
end
shared.Sealevel=game.Workspace.Sea.Position.y
end
shared.ClearData()
wait(5)
MakeMessage(105,&quot;:D The flood is decreasing fast! And it has shut down most of the fire! :3&quot;)
for i=1,210 do
for i=1,5 do
game.Workspace.Sea.CFrame=game.Workspace.Sea.CFrame+Vector3.new(0,-0.2,0)
shared.Sealevel=game.Workspace.Sea.Position.y
wait(.1)
end
end
MakeMessage(30,&quot;Wooo the flood is over :D&quot;)
wait(30)
MakeMessage(120,&quot;AHHH EARTHQUAKE!!111&quot;)
game.Workspace.GameState.Value=&quot;Earthquake&quot;
EarthQuake(game.Workspace.Hotel,120)
MakeMessage(15,&quot;Huh, its over!&quot;)
wait(15)
ClearDebris()
MakeMessage(60,&quot;The earthquake caused a tsunami!!11!11  Get off the first floors! NAO!&quot;)
game.Workspace.GameState.Value=&quot;Tsunami&quot;
TidalWave()
wait(100)
ClearDebris()
MakeMessage(100,&quot;Uh oh, a ubar big storm is comin for us!!!1111&quot;)
game.Workspace.GameState.Value=&quot;Storm&quot;
Storm(100)
ClearDebris()
MakeMessage(30,&quot;Woo we are getting rescued soon and the storm is over!&quot;)
wait(30)
MakeMessage(10,&quot;Noob: OMGEEH a war plane! *shoots warplane down* &quot;)
wait(10)
MakeMessage(300,&quot;AHHH we are being bombarded! Get on the choppah! (you die, and get 2x more points than normally)&quot;)
game.Workspace.GameState.Value=&quot;Dangerous rescue&quot;
Rescue()
BombAttack(2,150)
shared.ClearData()
MakeMessage(24,&quot;AAAAAAAAAAAAHHHHHHHHHHH A NUKE HIT THE ISLAND OMGEEH AHHH &lt;.&lt;   &gt;.&gt;   &gt;.&lt;    O_O    X_X&quot;)
game.Workspace.GameState.Value=&quot;Nuke&quot;
Nuke()
MakeMessage(10,&quot;Thankyou baibai visitagain! *new game starts in 120 seconds*&quot;)
wait(120)
MakeMessage(15,&quot;Regening the game! Nobody is sorry for the 2 second lagg you might feel.&quot;)
wait(5)

end </ProtectedString>
				<bool name="archivable">true</bool>
