				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">local d=game:GetService(&quot;Debris&quot;)
function reve(h)
if h.Anchored==false and h.Locked==false then
d:AddItem(h,7)
end
end

function Launch()
for i=1,195 do
script.Parent.Parta.Mesh.Scale=script.Parent.Parta.Mesh.Scale+Vector3.new(3,3,3)
script.Parent.Partb.Mesh.Scale=script.Parent.Partb.Mesh.Scale+Vector3.new(3,3,3)
local e=Instance.new(&quot;Explosion&quot;)
e.BlastRadius=script.Parent.Parta.Mesh.Scale.y/2
e.BlastPressure=10000
e.Parent=script.Parent
e.Position=script.Parent.Parta.Position
e.hit:connect(reve)
wait(.2)
e:remove()
end
script.Parent:remove()
end

script.Parent.BigRedButton.Changed:connect(function(val) if val==true then Launch()  end end)</ProtectedString>
					<bool name="archivable">true</bool>
