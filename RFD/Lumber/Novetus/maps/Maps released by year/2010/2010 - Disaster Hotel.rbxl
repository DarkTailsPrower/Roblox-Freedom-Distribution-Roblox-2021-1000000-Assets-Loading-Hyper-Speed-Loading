		<Item class="HopperBin" referent="RBX5740">
			<Properties>
				<bool name="Active">false</bool>
				<token name="BinType">0</token>
				<string name="Name">Teleport</string>
				<Content name="TextureId"><null></null></Content>
				<bool name="archivable">true</bool>
			</Properties>
			<Item class="Script" referent="RBX5741">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">function teleportPlayer(pos)

	local player = game.Players.LocalPlayer
	if player == nil or player.Character == nil then return end

	local char = player.Character.Torso

	CreateBall(char,false)

	wait(.5)

	char.CFrame = CFrame.new(Vector3.new(pos.x, pos.y + 7, pos.z))

	CreateBall(char,true)

end

function CreateBall(torso,value)
	sm = Instance.new(&quot;Part&quot;)
	sm.Size=Vector3.new(2,2,2)
	sm.BrickColor=BrickColor.new(&quot;Institutional white&quot;)
	sm.BottomSurface = 0
	sm.TopSurface = 0
	sm.Reflectance=.2
	sm.Anchored=true
	sm.CanCollide=false
	sm.Parent = game.Workspace
	sm.CFrame=torso.CFrame
	if value==false then
	script.S1:clone().Parent=sm
	else
	script.S2:clone().Parent=sm
	end
end

enabled = true
function onButton1Down(mouse)
	if not enabled then
		return
	end

	local player = game.Players.LocalPlayer
	if player == nil then return end

	if player.Mode.Value==false then
	
	enabled = false
	mouse.Icon = &quot;rbxasset://textures\\ArrowFarCursor.png&quot;

	local cf = mouse.Hit
	local v = cf.lookVector

	teleportPlayer(cf.p)

	mouse.Icon = &quot;rbxasset://textures\\ArrowCursor.png&quot;
	wait(10)
	enabled = true
	end

end

function onSelected(mouse)
	mouse.Icon = &quot;rbxasset://textures\\ArrowCursor.png&quot;
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end

script.Parent.Selected:connect(onSelected)</ProtectedString>
