		<Item class="Script" referent="RBX8">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">FireScript</string>
				<ProtectedString name="Source">shared.Data=Vector3.new(0,0,0)
shared.Sealevel=0
local Flames={} ---the flames
local Parts={} ---burning ones
local Bricks={} ---the ones to catch on fire
local SpreadSpeed=2
local BurnSpeed=SpreadSpeed---How fast it spreads
local BurnTime=0.1 ---how long it takes for a brick to burn
local FlameSize=3 ---Flame size
local FlameAge=0.3 ---smaller the longer
local debris=game:GetService(&quot;Debris&quot;)
local k=1
local MODEL=nil
local FH=-10


function UpdatePositions()
for i,v in pairs(Bricks) do
if v~=nil and v[1]~=nil and v[1].Parent~=nil then
v[2]=v[1].Position
else
table.remove(Bricks,i)
end
end
end


function sortbricks()
local msg=Instance.new(&quot;Message&quot;)
msg.Parent=game.Workspace
local count=0
for i,v in pairs(Bricks) do
for l,x in pairs(Bricks) do
if l&lt;i and i&lt;#Bricks then
l=i+1
elseif i&gt;=#Bricks then
break
end
if Bricks[l][2]~=nil and Bricks[i][2]~=nil and Bricks[l][2].y&lt;Bricks[i][2].y then
local b=Bricks[l]
Bricks[l]=Bricks[i]
Bricks[i]=b
end
end
count=count+1
msg.Text=count..&quot;/4931 Bricks sorted...&quot;
if math.random(1,15)==7 then
wait()
end
end
msg:remove()
end


local tab={}
for i=1,BurnSpeed do
table.insert(tab,#tab+1,0)
end
tab[1]=1


function GetBurnTime(part)
if (part.Size.x+part.Size.y+part.Size.z)/3&gt;3 then
return (5+(((part.Size.x+part.Size.y+part.Size.z)*2)*BurnTime))
else
return (5)
end
end

shared[&quot;AddPart&quot;]=function(part,mode)
part.Name=&quot;Burning&quot;
part.Color=Color3.new(0,0,0)
pm=part.Size.magnitude
if mode==true then
FH=FH+0.05
end
if pm&gt;10 and math.random(1,20)==3 then
local S=Instance.new(&quot;Smoke&quot;)
S.Parent=part
S.Size=pm/1.5
S.Color=Color3.new(0.05,0.05,0.05)
S.RiseVelocity=3
S.Opacity=0.7
S.Name=&quot;Smoke&quot;
end
local a=GetBurnTime(part)
pm=(part.Size*Vector3.new(1,1.2,1)).magnitude
table.insert(Parts,1,{part,a,a,pm})
end

shared[&quot;UpdateBricks&quot;]=function(model,file)
if file~=nil then MODEL=file end
if model==MODEL then
Parts={}
Bricks={}
end
for i,v in pairs(model:GetChildren()) do
if v.Name~=&quot;Burning&quot; and (v.className==&quot;Part&quot; or v.className==&quot;TrussPart&quot; or v.className==&quot;Seat&quot; ) and v.Name~=&quot;Burnd&quot; and v.Name~=&quot;Water&quot; and v.Anchored==false and v.Locked==false then
table.insert(Bricks,1,{v,v.Position,v.Size.magnitude})
elseif v.className==&quot;Model&quot; and v.Name~=&quot;Flames&quot; then
shared.UpdateBricks(v,nil)
end
end
if model==MODEL then
sortbricks()
end
end



function UpdateParts()
for i,v in pairs(Parts) do
if v==nil or v[1]==nil or v[1].Parent==nil or v[1].Name~=&quot;Burning&quot; then
if v~=nil and v[1]~=nil and v[1].Parent~=nil and v[1]:FindFirstChild(&quot;Smoke&quot;)~=nil then
v[1].Smoke:remove()
end
table.remove(Parts,i)
end
end
end

function Touched(hit)
if hit.Anchored==false and (hit.Locked==false or game.Players:FindFirstChild(hit.Parent.Name)~=nil) and hit.Name~=&quot;Burning&quot; and hit.Name~=&quot;Water&quot; and hit.Name~=&quot;Burnd&quot; and hit.Name~=&quot;Torso&quot; and hit.Name~=&quot;Head&quot; then
shared.AddPart(hit,false)
elseif (hit.Name==&quot;Torso&quot; or hit.Name==&quot;Head&quot;) and hit.Parent:FindFirstChild(&quot;Humanoid&quot;)~=nil then
hit.Parent.Humanoid:TakeDamage(10)
end
end


local FlameFile=Instance.new(&quot;Model&quot;)
FlameFile.Name=&quot;Flames&quot;
FlameFile.Parent=game.Workspace

shared[&quot;ClearData&quot;]=function()
FH=-10
if MODEL~=nil then
for i,v in pairs(MODEL:GetChildren()) do
if v~=nil and v.Parent~=nil and (v.Name==&quot;Burnd&quot; or v.Name==&quot;Burning&quot;) then
v.Name=&quot;Part&quot;
elseif v~=nil and v.Parent~=nil and v.Name==&quot;Part&quot; then
if v:FindFirstChild(&quot;Smoke&quot;)~=nil then v.Smoke:remove() end
end
end
end
Bricks={}
Parts={}
Flames={}
if FlameFile~=nil and FlameFile.Parent~=nil then
for i,v in pairs(FlameFile:GetChildren()) do
v:remove()
end
end
end

while true do
local lolwut=math.random(1,3)
if lolwut==1 then
UpdateParts()
else
UpdatePositions()
end

local tab={}
for i=1,BurnSpeed do
table.insert(tab,#tab+1,0)
end
tab[1]=1
k=math.floor(#tab/2)

for i=1,50 do
shared.Data=Vector3.new(#Flames,#Parts,#Bricks)
if #Flames&lt;300 then
for i,v in pairs(Parts) do
local p=v[1]
if p~=nil and p.Parent~=nil then
if v[2]&gt;0 and p.Parent~=nil and math.random(1,2+(v[4]*5))==1 and p.Position.y&gt;shared.Sealevel and p.Name==&quot;Burning&quot; then
v[2]=v[2]-1
local f=Instance.new(&quot;Part&quot;)
f.Shape=0
f.TopSurface=0
f.BottomSurface=0
f.CanCollide=false
f.Anchored=true
f.Locked=true
f.Name=&quot;Flame&quot;
f.Color=Color3.new(math.random(70,100)/100,math.random(0,40)/100,0)
f.Transparency=0.6
local size=(v[4]+math.random(1,3))*FlameSize
if size&lt;=8 then
f.Size=Vector3.new(1,1,1)*size
else
size=8
f.Size=Vector3.new(1,1,1)*8
end

f.Position=p.Position+((v[4]*0.7)*Vector3.new(math.random(-4,4)/4,math.random(0,2)/4,math.random(-4,4)/4))
f.Parent=FlameFile
table.insert(Flames,1,{f,FlameAge/size,f.Size.y})
local fdata=Flames[1]
f.Touched:connect(Touched)

if k&lt;#tab then
k=k+1
else
k=1
end
r=tab[k]
local d=0
if r==1 and #Parts&lt;1000 and f.Position.y&gt;FH then
local vpos=f.Position
for i,x in ipairs(Bricks) do
local cp=x[1]
local dif=f.Position.y-cp.Position.y
if d==0 and dif&gt;20 then
d=1
i=math.floor(((#Bricks/260)*f.Position.y)-100)
else
local xpos=x[2]
local nm=cp.Name
local pos=(vpos-xpos)
if math.abs(dif)&lt;20 and pos.magnitude&lt;(fdata[3]+x[3]) then ------
if nm~=&quot;Burning&quot; and nm~=&quot;Burned&quot; and nm~=&quot;Water&quot; then
shared.AddPart(cp,true)
break
elseif nm==&quot;Water&quot; then
f:remove()
table.remove(Flames,1)
break
end
elseif xpos.y-vpos.y&gt;20 then
break
end-------

end
end
end

if v[2]&gt;1 and v[2]&lt;v[3]/4 and math.random(1,v[3]*4)==1 then
p:BreakJoints()
p.BottomSurface=0
p.TopSurface=0
p.FrontSurface=0
p.BackSurface=0
p.LeftSurface=0
p.RightSurface=0
end
elseif v[2]&lt;=0 then
p.Name=&quot;Burnd&quot;
if p:FindFirstChild(&quot;Smoke&quot;)~=nil then
p.Smoke:remove()
end
if v[4]&lt;8 or math.random(1,6)==2 then
p:remove()
end
table.remove(Parts,i)
elseif p.Position.y&lt;shared.Sealevel or p.Name~=&quot;Burning&quot; then
p.Name=&quot;Part&quot;
if p:FindFirstChild(&quot;Smoke&quot;)~=nil then
p.Smoke:remove()
end
table.remove(Parts,i)
end
end
end


end


for l,v in ipairs(Flames) do
if v[1]~=nil and v[1].Parent~=nil then
v[1].Transparency=v[1].Transparency+v[2]
v[1].CFrame=v[1].CFrame+Vector3.new(0,0.7,0)
if v[1].Transparency&gt;=1 or v[1].Position.y&lt;shared.Sealevel then
v[1]:remove()
table.remove(Flames,l)
end
else
table.remove(Flames,l)
end
end
wait(.2)

end


end










