					<Item class="HopperBin" referent="RBX1424">
						<Properties>
							<bool name="Active">false</bool>
							<token name="BinType">0</token>
							<string name="Name">Plane</string>
							<Content name="TextureId"><null></null></Content>
							<bool name="archivable">true</bool>
						</Properties>
						<Item class="LocalScript" referent="RBX1425">
							<Properties>
								<bool name="Disabled">true</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<ProtectedString name="Source">local plane=nil
local buttondown=false
local mode=true

function ButtonDown(mouse)
buttondown=true
while buttondown==true and mode==true do
plane.Engine.BodyGyro.cframe=CFrame.new(plane.Engine.Position,mouse.hit.p)
plane.Engine.BodyVelocity.velocity=plane.Engine.CFrame.lookVector*30
wait(.1)
end
end

function ButtonUp(mouse)
buttondown=false
end

function KeyDown(key)
key=key:lower()

if key==&quot;y&quot; then
mode=true
plane.Engine.BodyVelocity.velocity=plane.Engine.CFrame.lookVector*30
elseif key==&quot;x&quot; then
mode=false
plane.Engine.BodyVelocity.velocity=Vector3.new(0,-5,0)
plane.Engine.BodyGyro.cframe=CFrame.fromEulerAnglesXYZ(math.rad(90),0,0)
end
end

function Selected(mouse)
if game.Players.localPlayer.Character:FindFirstChild(&quot;Plane&quot;)~=nil then
plane=game.Players.localPlayer.Character.Plane
plane.Engine.BodyGyro.cframe=CFrame.fromEulerAnglesXYZ(math.rad(90),0,0)
plane.Engine.BodyVelocity.velocity=plane.Engine.CFrame.lookVector*30
if plane:FindFirstChild(&quot;Holder&quot;)~=nil then
plane.Holder:BreakJoints()
end
mouse.Button1Down:connect(function() ButtonDown(mouse) end)
mouse.Button1Up:connect(function() ButtonUp(mouse) end)
mouse.KeyDown:connect(KeyDown)
end
end
script.Parent.Selected:connect(Selected)

function DeSelected()
buttondown=false
mode=false
plane.Engine.BodyVelocity.velocity=Vector3.new(0,-5,0)
plane.Engine.BodyGyro.cframe=CFrame.fromEulerAnglesXYZ(math.rad(90),0,0)
plane=nil
end
script.Parent.Deselected:connect(DeSelected)</ProtectedString>
								<bool name="archivable">true</bool>
							</Properties>
						</Item>
					</Item>
					<Item class="Script" referent="RBX1426">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">plyr=nil
tool=nil

function seated(weld)
if weld.Name==&quot;SeatWeld&quot; and shared.CheckID(weld.Part1.Parent.Name)==true then
plyr=weld.Part1.Parent
tool=script.Parent.Plane:clone()
tool.Script.Disabled=false
tool.Parent=game.Players:FindFirstChild(plyr.Name).Backpack
script.Parent.Parent.Parent=plyr
script.Parent.Parent.Engine.BodyGyro.maxTorque=Vector3.new(1000000,1000000,1000000)
script.Parent.Parent.Engine.BodyVelocity.maxForce=Vector3.new(1000000,1000000,1000000)
elseif CheckID(weld.Part1.Parent.Name)==false then
weld:remove()
end
end
script.Parent.ChildAdded:connect(seated)

function deseated(weld)
if weld.Name==&quot;SeatWeld&quot; then
if tool~=nil then
tool:remove()
plyr=nil
script.Parent.Parent.Parent=game.Workspace
end
end
end
script.Parent.ChildRemoved:connect(deseated)</ProtectedString>
