			<Item class="Script" referent="RBX5731">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">local hammer=200
local extinguisher=300
local medipack=50
local coil=200
local para=250
local run=100

function TakeMoney(value)
script.Parent.Parent.Parent.leaderstats.Points.Value=script.Parent.Parent.Parent.leaderstats.Points.Value-value
end

function GetMoney()
return script.Parent.Parent.Parent.leaderstats.Points.Value
end

function Message(text)
local g=Instance.new(&quot;TextLabel&quot;)
g.Parent=script.Parent
g.Size=UDim2.new(0.5,0,0.04,0)
g.Position=UDim2.new(0.25,0,0.4,0)
g.BackgroundColor3=Color3.new(0,0.9,0)
g.BorderColor3=Color3.new(0,0,0)
g.TextColor3=Color3.new(0,0,0)
g.Text=text
wait(4)
g:remove()
end

function BuyHammer()
if GetMoney()&gt;=hammer then
TakeMoney(hammer)
game.Lighting.Hammer:clone().Parent=script.Parent.Parent.Parent.StarterGear
game.Lighting.Hammer:clone().Parent=script.Parent.Parent.Parent.Backpack
Message(&quot;YOU HAVE BOUGHT A HAMMER!  USE IT TO BREAK SMALL PARTS!&quot;)
else
Message(&quot;NOT ENOUGH POINTS ;C&quot;)
end
end
script.Parent.Hammer.MouseButton1Click:connect(BuyHammer)

function BuyPara()
if GetMoney()&gt;=para then
TakeMoney(para)
game.Lighting.Parachute:clone().Parent=script.Parent.Parent.Parent.StarterGear
game.Lighting.Parachute:clone().Parent=script.Parent.Parent.Parent.Backpack
Message(&quot;YOU HAVE BOUGHT A PARACHUTE!  USE IT TO DESCEND SAFELY!&quot;)
else
Message(&quot;NOT ENOUGH POINTS ;C&quot;)
end
end
script.Parent.Para.MouseButton1Click:connect(BuyPara)

function BuyRun()
if GetMoney()&gt;=run then
TakeMoney(run)
game.Lighting.Run:clone().Parent=script.Parent.Parent.Parent.StarterGear
game.Lighting.Run:clone().Parent=script.Parent.Parent.Parent.Backpack
Message(&quot;YOU HAVE BOUGHT THE RUN ABILITY! USE IT TO MOVE FASTER!&quot;)
else
Message(&quot;NOT ENOUGH POINTS ;C&quot;)
end
end
script.Parent.Run.MouseButton1Click:connect(BuyRun)


function BuyExtinguisher()
if GetMoney()&gt;=extinguisher then
TakeMoney(extinguisher)
game.Lighting.Extinguisher:clone().Parent=script.Parent.Parent.Parent.StarterGear
game.Lighting.Extinguisher:clone().Parent=script.Parent.Parent.Parent.Backpack
Message(&quot;YOU HAVE BOUGHT A EXTINGUISHER!  USE IT TO SHUT DOWN FIRES!&quot;)
else
Message(&quot;NOT ENOUGH POINTS ;C&quot;)
end
end
script.Parent.Extinguisher.MouseButton1Click:connect(BuyExtinguisher)

function BuyCoil()
if GetMoney()&gt;=coil then
TakeMoney(coil)
game.Lighting.Coil:clone().Parent=script.Parent.Parent.Parent.StarterGear
game.Lighting.Coil:clone().Parent=script.Parent.Parent.Parent.Backpack
Message(&quot;YOU HAVE BOUGHT A GRAVITY COIL!  USE IT TO BOOST YOUR AGILITY!&quot;)
else
Message(&quot;NOT ENOUGH POINTS ;C&quot;)
end
end
script.Parent.Coil.MouseButton1Click:connect(BuyCoil)

function BuyMedipack()
if GetMoney()&gt;=medipack then
TakeMoney(medipack)
game.Lighting.Medipack:clone().Parent=script.Parent.Parent.Parent.StarterGear
game.Lighting.Medipack:clone().Parent=script.Parent.Parent.Parent.Backpack
Message(&quot;YOU HAVE BOUGHT A MEDIPACK!  USE IT TO HEAL YOURSELF!&quot;)
else
Message(&quot;NOT ENOUGH POINTS ;C&quot;)
end
end
script.Parent.Medipack.MouseButton1Click:connect(BuyMedipack)
