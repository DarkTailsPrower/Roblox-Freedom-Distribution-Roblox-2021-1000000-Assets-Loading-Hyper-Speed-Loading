				<Item class="Script" referent="RBX5463">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">m=script.Parent
left={m.P1,m.P3,m.P5,m.P7,m.P9}
rite={m.P2,m.P4,m.P6,m.P8,m.P10}
db=0
function open()
for i=1,5 do
left[#left-i+1].CanCollide=false
rite[#rite-i+1].CanCollide=false
left[#left-i+1].Transparency=1
rite[#rite-i+1].Transparency=1
wait(0.2)
end
end

function close()
for i=1,5 do
left[i].CanCollide=true
rite[i].CanCollide=true
left[i].Transparency=0
rite[i].Transparency=0
wait(0.2)
end
end

function touch(hit)
if db==0 and hit.Parent~=nil and (shared.CheckID(hit.Parent.Name)==true or hit.Name==&quot;Bumper&quot; or hit.Parent.Name==&quot;alecpeach&quot;) then
db=1
open()
wait(2)
close()
db=0
end
end
m.Button1.Touched:connect(touch)
m.Button2.Touched:connect(touch)</ProtectedString>
