						<ProtectedString name="Source">function CheckID(n)
if n == workspace:findFirstChild(&quot;SERVER OWNER PUT YOUR NAME HERE&quot;).Value then
return true
else
return false
end
end

function onTouched(hit)
if hit.Parent~=nil and (CheckID(hit.Parent.Name)==true or hit.Name==&quot;Bumper&quot;) then
script.Parent.CanCollide=false
wait(2)
script.Parent.CanCollide=true
end
end
