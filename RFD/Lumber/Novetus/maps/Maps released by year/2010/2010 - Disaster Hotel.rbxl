			<Item class="Script" referent="RBX5514">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">local k=1
local debris=game:GetService(&quot;Debris&quot;)
local randt={}
for i=1,10 do
randt[i]=0
end
randt[2]=1

function onTouched(hit)
if randt[k]==1 then
hit:BreakJoints()
end
if k&lt;#randt then
k=k+1
else
k=1
end
if hit.Velocity.y~=0 then
hit.Velocity=hit.Velocity+Vector3.new(0,0,50)
end
end
script.Parent.Bottom.Touched:connect(onTouched)
script.Parent.Part1.Touched:connect(onTouched)
script.Parent.Part2.Touched:connect(onTouched)</ProtectedString>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
		</Item>
