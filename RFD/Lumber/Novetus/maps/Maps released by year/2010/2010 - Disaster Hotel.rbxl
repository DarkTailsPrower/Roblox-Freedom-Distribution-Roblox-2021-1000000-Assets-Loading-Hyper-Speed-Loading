					<Item class="LocalScript" referent="RBX3713">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">LocalScript</string>
							<ProtectedString name="Source">local buttondown=false
local selected=false
local db=0
local ray=nil



function ButtonDown(mouse)
buttondown=true
if db==0 then
db=1
ray=Instance.new(&quot;Part&quot;)
ray.formFactor=&quot;Symmetric&quot;
ray.Size=Vector3.new(1,1,1)
ray.CFrame=CFrame.new((mouse.hit.p+script.Parent.Handle.Position)/2)
ray.CFrame=CFrame.new(ray.Position,mouse.hit.p)
ray.BrickColor=BrickColor.new(&quot;Bright blue&quot;)
ray.Anchored=true
ray.Locked=true
ray.CanCollide=false
ray.Transparency=0.8
ray.Name=&quot;Ray&quot;
ray.Parent=script.Parent
local m=Instance.new(&quot;BlockMesh&quot;)
m.Parent=ray
m.Scale=Vector3.new(2,2,(mouse.hit.p-script.Parent.Handle.Position).magnitude)
while selected==true and script.Parent.Water.Value&gt;0 and buttondown==true and ray~=nil and ray.Parent~=nil do
local ran=math.random(1,20)
ray.CFrame=CFrame.new((mouse.hit.p+script.Parent.Handle.Position)/2)
ray.CFrame=CFrame.new(ray.Position,mouse.hit.p)
m.Scale=Vector3.new(2,2,(mouse.hit.p-script.Parent.Handle.Position).magnitude)
if ran==2 and mouse.Target~=nil and (mouse.Target.Position-script.Parent.Handle.Position).magnitude&lt;20 and mouse.Target.Name==&quot;Burning&quot; then
mouse.Target.Name=&quot;Part&quot;
script.Parent.Water.Value=script.Parent.Water.Value-1
if mouse.Target:FindFirstChild(&quot;Smoke&quot;)~=nil then
mouse.Target.Smoke:remove()
end
elseif ran==2 and mouse.Target~=nil and (mouse.Target.Position-script.Parent.Handle.Position).magnitude&lt;20 and mouse.Target.Name==&quot;Flame&quot; then
mouse.Target:remove()
script.Parent.Water.Value=script.Parent.Water.Value-1
end
wait(.1)

t.Size=UDim2.new(0.008*script.Parent.Water.Value,0,0.05,0)
t.Text=&quot;WATER LEFT=&quot;..script.Parent.Water.Value
end
if ray~=nil and ray.Parent~=nil then
ray:remove()
end
end

end

function ButtonUp(mouse)
buttondown=false
wait(1)
db=0
end


function Equip(mouse)
script.Parent.Handle.Anchored=false
script.Parent.Handle1.Anchored=false
selected=true
mouse.Button1Down:connect(function()  ButtonDown(mouse) end)
mouse.Button1Up:connect(function()  ButtonUp(mouse) end)
g=Instance.new(&quot;ScreenGui&quot;)
g.Parent=game.Players.localPlayer.PlayerGui
t=Instance.new(&quot;TextLabel&quot;)
t.Size=UDim2.new(0.8,0,0.05,0)
t.Position=UDim2.new(0.1,0,0.94,0)
t.BackgroundColor3=Color3.new(1,0,0)
t.Text=&quot;&quot;
t.Parent=g
t=Instance.new(&quot;TextLabel&quot;)
t.Size=UDim2.new(0.8,0,0.05,0)
t.Position=UDim2.new(0.1,0,0.94,0)
t.BackgroundColor3=Color3.new(0,1,0)
t.Text=&quot;WATER LEFT=200&quot;
t.Parent=g
t.Size=UDim2.new(0.008*script.Parent.Water.Value,0,0.05,0)
t.Text=&quot;WATER LEFT=&quot;..script.Parent.Water.Value
end
script.Parent.Equipped:connect(Equip)

function UnEquip()
if script.Parent:FindFirstChild(&quot;Ray&quot;)~=nil then
script.Parent.Ray:remove()
end
selected=false
buttondown=false
db=0
g:remove()
end
script.Parent.Unequipped:connect(UnEquip)</ProtectedString>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
					<Item class="Script" referent="RBX3714">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">WeldScript</string>
							<ProtectedString name="Source">local weld=Instance.new(&quot;Weld&quot;)
weld.Part0=script.Parent.Handle
weld.Part1=script.Parent.Handle1
weld.C0=CFrame.new(0,1.5,0)
weld.Parent=game.JointsService
function weld()
local weld=Instance.new(&quot;Weld&quot;)
weld.Part0=script.Parent.Handle
weld.Part1=script.Parent.Handle1
weld.C0=CFrame.new(0,1.5,0)
weld.Parent=game.JointsService
end
script.Parent.Equipped:connect(weld)
script.Parent.Unequipped:connect(weld)</ProtectedString>
