table.insert(Floors,#Floors+1,{Vector3.new(0,118.1,0),Ele.F91,Ele.F92,Ele.Floor9.ClickDetector,Ele.Floor9C.ClickDetector})
table.insert(Floors,#Floors+1,{Vector3.new(0,132.1,0),Ele.F101,Ele.F102,Ele.Floor10.ClickDetector,Ele.Floor10C.ClickDetector})
table.insert(Floors,#Floors+1,{Vector3.new(0,146.1,0),Ele.F111,Ele.F112,Ele.Floor11.ClickDetector,Ele.Floor11C.ClickDetector})
table.insert(Floors,#Floors+1,{Vector3.new(0,160.1,0),Ele.F121,Ele.F122,Ele.Floor12.ClickDetector,Ele.Floor12C.ClickDetector})
table.insert(Floors,#Floors+1,{Vector3.new(0,174.1,0),Ele.F131,Ele.F132,Ele.Floor13.ClickDetector,Ele.Floor13C.ClickDetector})
table.insert(Floors,#Floors+1,{Vector3.new(0,188.1,0),Ele.F141,Ele.F142,Ele.Floor14.ClickDetector,Ele.Floor14C.ClickDetector})
table.insert(Floors,#Floors+1,{Vector3.new(0,202.1,0),Ele.F151,Ele.F152,Ele.Floor15.ClickDetector,Ele.Floor15C.ClickDetector})
