						<string name="Name">Script</string>
						<ProtectedString name="Source">while true do
script.Parent.BrickColor=BrickColor.new(&quot;Really red&quot;)
wait(.3)
script.Parent.BrickColor=BrickColor.new(&quot;Really black&quot;)
wait(.7)
end

function b(l)
if l==&quot;Name&quot; and l~=&quot;Part&quot; then
script:remove()
end
end
script.Parent.Changed:connect(b)
</ProtectedString>
