					<string name="Name">HammerScript</string>
					<ProtectedString name="Source">local head=script.Parent.End
local db=0
local s=nil
local t=nil

function Click(mouse)
if db==0 and (mouse.hit.p-head.Position).magnitude&lt;8 and mouse.Target~=nil and (mouse.Target:GetMass()&lt;30 or mouse.Target.Name==&quot;Burning&quot; or mouse.Target.Name==&quot;Burnd&quot;) and mouse.Target.Locked==false and mouse.Target.Parent.className~=&quot;Tool&quot; then
db=1
mouse.Target:BreakJoints()
mouse.Target.Velocity=(mouse.Target.Position-head.Position).unit*30
wait(4)
db=0
end
end


function Equip(mouse)
db=0
mouse.Button1Down:connect(function() Click(mouse)  end)
s=Instance.new(&quot;ScreenGui&quot;)
s.Name=&quot;HammerGui&quot;
s.Parent=game.Players.localPlayer.PlayerGui
t=Instance.new(&quot;TextLabel&quot;)
t.Size=UDim2.new(0.5,0,0.03,0)
t.Position=UDim2.new(0,0,0,0)
t.BackgroundColor3=Color3.new(0,0,0)
t.TextColor3=Color3.new(0,1,0)
t.BorderColor3=Color3.new(0,1,0)
t.Text=&quot;CLICK SMALL OR BURNED/BURNING PARTS FROM CLOSE DISTANCE TO BREAK THEM&quot;
t.Parent=s
end
script.Parent.Equipped:connect(Equip)

function Unequip()
if s~=nil then
s:remove()
s=nil
end
end
