		<Item class="Script" referent="RBX11">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">LeaderBoard</string>
				<ProtectedString name="Source">function PlayerEntered(player)
local leaderboard=Instance.new(&quot;IntValue&quot;)
leaderboard.Parent=player
leaderboard.Name=&quot;leaderstats&quot;
local time=Instance.new(&quot;IntValue&quot;)
time.Parent=leaderboard
time.Name=&quot;Survived&quot;
local rec=Instance.new(&quot;IntValue&quot;)
rec.Parent=leaderboard
rec.Name=&quot;Record&quot;
local Points=Instance.new(&quot;IntValue&quot;)
Points.Parent=leaderboard
Points.Name=&quot;Points&quot;
local check=Instance.new(&quot;BoolValue&quot;)
check.Parent=player
check.Name=&quot;Mode&quot;
check.Value=true
Timer(player)
end

function PlayerEntered2(plr)
while plr.Character == nil do
wait(.1)
end
local co=0
while plr.Character:FindFirstChild(&quot;Shirt Graphic&quot;)==nil and co&lt;100 do
wait(.1)
co=co+1
end
if shared.CheckVIP(plr.Character) == true then
game:GetService(&quot;BadgeService&quot;):AwardBadge(plr.userId, 28606182)
elseif shared.CheckAdmin(plr.Character) == true then
gear=plr:findFirstChild(&quot;StarterGear&quot;)
if gear~=nil then
game.Lighting.FireBomb:clone().Parent=gear
else
Instance.new(&quot;StarterGear&quot;).Parent=plr
game.Lighting.FireBomb:clone().Parent=plr.StarterGear
end
plr.Character:BreakJoints()
game:GetService(&quot;BadgeService&quot;):AwardBadge(plr.userId, 28606182)
end
end

game.Players.ChildAdded:connect(PlayerEntered)
game.Players.ChildAdded:connect(PlayerEntered2)

function Timer(player)
while player~=nil do
if player.Mode.Value==false then
player.leaderstats.Survived.Value=player.leaderstats.Survived.Value+1
if player.leaderstats.Record.Value&lt;player.leaderstats.Survived.Value then
player.leaderstats.Record.Value=player.leaderstats.Survived.Value
if player.leaderstats.Survived.Value &gt;= 1337 then
game:GetService(&quot;BadgeService&quot;):AwardBadge(player.userId, 28605972)
end
end
elseif player.Mode.Value==true then
if player.leaderstats.Record.Value&lt;player.leaderstats.Survived.Value then
player.leaderstats.Record.Value=player.leaderstats.Survived.Value
end
player.leaderstats.Survived.Value=0
end
if player.leaderstats.Record.Value&gt;=game.Workspace.ServerRecord.Value then
game.Workspace.ServerRecordMaker.Value=player.Name
game.Workspace.ServerRecord.Value=player.leaderstats.Record.Value
end
wait(1)
end
end

function spawned(model)
if model.className==&quot;Model&quot; and model.Parent~=nil and game.Players:FindFirstChild(model.Name)~=nil then
local player=game.Players:FindFirstChild(model.Name)
player.Character.Humanoid.Died:connect(function()  PlayerDied(player) end)
if shared.CheckVIP(player.Character) == false and shared.CheckAdmin(player.Character) == false then
player.Character.Humanoid.WalkSpeed = player.Character.Humanoid.WalkSpeed - 2
end
end
end
game.Workspace.ChildAdded:connect(spawned)

function PlayerDied(player)
if player.Mode.Value==false then
if shared.CheckVIP(player.Character) == true or shared.CheckAdmin(player.Character) == true then
player.leaderstats.Points.Value=math.ceil(player.leaderstats.Points.Value+((player.leaderstats.Survived.Value/5)^1.15))
else
player.leaderstats.Points.Value=math.ceil(player.leaderstats.Points.Value+((player.leaderstats.Survived.Value/10)^1.15))
end
end
player.Mode.Value=true
local g=Instance.new(&quot;ScreenGui&quot;)
g.Parent=player.PlayerGui
local f=Instance.new(&quot;Frame&quot;)
f.Size=UDim2.new(1,0,1.4,0)
f.Position=UDim2.new(0,0,-0.1,0)
f.BackgroundColor3=Color3.new(0.6,0,0)
f.BackgroundTransparency=1
f.Parent=g
while f.Parent~=nil do
f.BackgroundTransparency=f.BackgroundTransparency-0.03
wait(.1)
end
end </ProtectedString>
