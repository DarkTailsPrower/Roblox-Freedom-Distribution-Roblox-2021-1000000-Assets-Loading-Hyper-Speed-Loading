						<Item class="Script" referent="RBX3933">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<ProtectedString name="Source">door = script.Parent.Door1


function onTouched(Hit)
   if script.Parent.Enabled.Value == false then                       --- If the Door is off
      if Hit.Parent:FindFirstChild(&quot;Humanoid&quot;) ~= nil then        --- Then Is Touched by a humanoid
         script.Parent.Enabled.Value = true                                --- It is now active

          for i=1, 45 do
            door.CFrame = door.CFrame * CFrame.new(0,0,0.15) 
            wait(0.035)
         end

         wait(2)

         for i=1, 45 do
            door.CFrame = door.CFrame * CFrame.new(0,0,-0.15)
            wait(0.035)
         end

         wait(1)
         script.Parent.Enabled.Value = false

      end
   end
end

script.Parent.Button2.Touched:connect(onTouched)
script.Parent.Button1.Touched:connect(onTouched)
</ProtectedString>
