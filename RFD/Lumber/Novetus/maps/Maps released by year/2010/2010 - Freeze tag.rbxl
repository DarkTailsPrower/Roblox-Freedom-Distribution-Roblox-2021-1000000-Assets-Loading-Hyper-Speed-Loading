		<Item class="Tool" referent="RBX2133">
			<Properties>
				<bool name="CanBeDropped">true</bool>
				<bool name="Enabled">true</bool>
				<CoordinateFrame name="Grip">
					<X>0</X>
					<Y>0</Y>
					<Z>-0.400000006</Z>
					<R00>0</R00>
					<R01>0</R01>
