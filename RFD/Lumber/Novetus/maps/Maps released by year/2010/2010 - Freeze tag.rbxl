						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">connector</string>
						<ProtectedString name="Source">script.Parent.MouseButton1Click:connect(function() sendVote(script.Parent.Parent.Parent.Parent.Parent.Name, script.Parent.Text) end)
</ProtectedString>
					</Properties>
