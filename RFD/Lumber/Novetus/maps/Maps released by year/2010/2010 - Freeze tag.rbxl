&#9;&#9;&#9;tp = tele.Position
&#9;&#9;&#9;torso.CFrame = CFrame.new(tp.x, tp.y+3, tp.z)
&#9;&#9;end
&#9;&#9;if (checkOkToLetIn(hit.Parent.Name)) then
&#9;&#9;&#9;tp = tele.Position
&#9;&#9;&#9;torso.CFrame = CFrame.new(tp.x, tp.y+3, tp.z)
&#9;&#9;end
&#9;end
end 

