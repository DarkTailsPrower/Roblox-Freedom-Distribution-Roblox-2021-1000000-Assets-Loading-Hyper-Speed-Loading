			<Item class="Script" referent="RBX1237">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">TwoShueFreezeTag</string>
					<ProtectedString name="Source">print(&quot;Freeze-Tag game established...&quot;)
print(&quot;_________________________&quot;)
print(&quot;Running TwoShue&apos;s Freeze Tag!&quot;)&#9;--XD

local running = false

local info = game.Workspace:findFirstChild(&quot;InfoReel&quot;)
local tagger = game.Workspace:findFirstChild(&quot;TaggerReel&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;--XD the trusty InfoReel!

local players = 2&#9;&#9;&#9;&#9;&#9;--Adjust the minimum number of players

local itcount = 0
--local its = {}
local connection = nil&#9;&#9;&#9;&#9;--Yep, another it-check function...but this one just switches out players

local select = 0

local round = 5&#9;&#9;&#9;&#9;&#9;--This is the length in minutes of each round.

local map = nil

function mapGame(maps)
&#9;local mapSelection = maps:GetChildren()
&#9;map = mapSelection[math.random(1,#mapSelection)]:clone()
&#9;map.Parent = game.Workspace
&#9;map:MakeJoints()
&#9;info.Value = &quot;Map selected: &quot;..map.Name..&quot;!&quot;
&#9;wait(3)
end

function arrival(newbie)&#9;&#9;&#9;&#9;--Establishing leaderboard stats
&#9;print(&quot;New arrival: &quot;..newbie.Name..&quot;: Establishing game stats&quot;)

&#9;local lead = Instance.new(&quot;IntValue&quot;)
&#9;lead.Name = &quot;leaderstats&quot;
&#9;lead.Value = 2&#9;&#9;&#9;&#9;&#9;--NOTE: this is important. The actual leaderstat value will control movement condition!

&#9;local tags = Instance.new(&quot;IntValue&quot;)
&#9;tags.Name = &quot;Tags&quot;
&#9;tags.Value = 0&#9;&#9;&#9;&#9;&#9;--This will fire if you freeze or unfreeze someone. That way people who
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;--are not it may still generate tags, which they&apos;ll probably be able to use
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;--to buy upgrades if you add them...

&#9;local itstat = Instance.new(&quot;BoolValue&quot;)
&#9;itstat.Name = &quot;ItStatus&quot;
&#9;itstat.Value = false

&#9;lead.Parent = newbie
&#9;tags.Parent = lead

&#9;itstat.Parent = newbie
&#9;print(&quot;Character stats established for new arrival &quot;..newbie.Name..&quot;...&quot;)
&#9;--[[while newbie.Character == nil do
&#9;&#9;wait(1)
&#9;end
&#9;if running == true then
&#9;&#9;local spawns = map:findFirstChild(&quot;Spawns&quot;):GetChildren()
&#9;&#9;local torso = newbie.Character:findFirstChild(&quot;Torso&quot;)
&#9;&#9;if torso ~= nil then
&#9;&#9;&#9;local spawn = spawns[math.random(1,#spawns)]
&#9;&#9;&#9;torso.CFrame = spawn.CFrame * CFrame.new(0,5,0)
&#9;&#9;end
&#9;end]]&#9;&#9;&#9;&#9;&#9;&#9;--If you decide to throw out the lobby idea, add this back in.
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;--This will spawn new players directly into the game as long as it&apos;s running.
end
game.Players.ChildAdded:connect(arrival)

function countdown(time)
&#9;local minutes = time
&#9;local seconds = 0
&#9;local check = 1
&#9;while check &gt; 0 and minutes &gt;= 0 do
&#9;&#9;if seconds &gt;= 10 then
&#9;&#9;&#9;info.Value = &quot;Time remaining: &quot;..minutes..&quot;:&quot;..seconds
&#9;&#9;else
&#9;&#9;&#9;info.Value = &quot;Time remaining: &quot;..minutes..&quot;:0&quot;..seconds
&#9;&#9;end
&#9;&#9;wait(1)
&#9;&#9;seconds = seconds - 1
&#9;&#9;if seconds &lt; 0 then
&#9;&#9;&#9;minutes = minutes - 1
&#9;&#9;&#9;seconds = 59
&#9;&#9;end
&#9;&#9;check = 0
&#9;&#9;local players = game.Players:GetChildren()
&#9;&#9;for i = 1,#players do
&#9;&#9;&#9;local lead = players[i]:findFirstChild(&quot;leaderstats&quot;)
&#9;&#9;&#9;local isit = players[i]:findFirstChild(&quot;ItStatus&quot;)
&#9;&#9;&#9;if lead ~= nil and isit ~= nil then
&#9;&#9;&#9;&#9;if lead.Value == 0 and isit.Value == false then
&#9;&#9;&#9;&#9;&#9;check = check + 1
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

function dubHat(receiver)
&#9;if receiver.Character:findFirstChild(&quot;Head&quot;) then
&#9;&#9;local hats = receiver.Character:GetChildren()
&#9;&#9;for i = 1,#hats do
&#9;&#9;&#9;if hats[i].className == &quot;Hat&quot; or hats[i].className == &quot;Accountrement&quot; then
&#9;&#9;&#9;&#9;hats[i]:remove()
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;local sparkles = Instance.new(&quot;Sparkles&quot;)
&#9;&#9;sparkles.SparkleColor = Color3.new(0,0,255)
&#9;&#9;sparkles.Parent = receiver.Character:findFirstChild(&quot;Head&quot;)
&#9;&#9;wait()
&#9;&#9;local h = Instance.new(&quot;Hat&quot;)
&#9;&#9;local p = Instance.new(&quot;Part&quot;)
&#9;&#9;h.Name = &quot;Futuristic 12&quot;
&#9;&#9;p.Parent = h
&#9;&#9;p.Position = receiver.Character:findFirstChild(&quot;Head&quot;).Position
&#9;&#9;p.Name = &quot;Handle&quot; 
&#9;&#9;p.formFactor = 0
&#9;&#9;p.Size = Vector3.new(2, 1, 2) 
&#9;&#9;p.BottomSurface = 0 
&#9;&#9;p.TopSurface = 0 
&#9;&#9;p.Locked = true
&#9;&#9;script:findFirstChild(&quot;Mesh&quot;):clone().Parent = p
&#9;&#9;h.Parent = receiver.Character.Parent
&#9;&#9;h.AttachmentPos = Vector3.new(0, 0.35, 0)
&#9;&#9;h.AttachmentRight = Vector3.new(1, -0, 0)
&#9;&#9;h.AttachmentUp = Vector3.new(0, 0.995, -0.0995)
&#9;&#9;h.AttachmentForward = Vector3.new(0, -0.0995, -0.995)
&#9;end
end

function selectCharacter(person)&#9;&#9;--XD this got a wee-bit confusing!
&#9;local chosen = person[math.random(1,#person)]
&#9;if string.find(tagger.Value,chosen.Name) == nil then
&#9;&#9;if chosen:findFirstChild(&quot;ItStatus&quot;) ~= nil then
&#9;&#9;&#9;chosen:findFirstChild(&quot;ItStatus&quot;).Value = true
&#9;&#9;end
&#9;&#9;if chosen:findFirstChild(&quot;leaderstats&quot;) ~= nil then
&#9;&#9;&#9;chosen:findFirstChild(&quot;leaderstats&quot;).Value = 0
&#9;&#9;end
&#9;&#9;local hum = chosen.Character:findFirstChild(&quot;Humanoid&quot;)
&#9;&#9;if hum ~= nil then
&#9;&#9;&#9;hum.WalkSpeed = 20
&#9;&#9;end
&#9;&#9;local parts = chosen.Character:GetChildren()
&#9;&#9;for i = 1,#parts do
&#9;&#9;&#9;if parts[i].className == &quot;Part&quot; then
&#9;&#9;&#9;&#9;parts[i].Anchored = false
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;wait()
&#9;&#9;local tagscript = chosen.Character:findFirstChild(&quot;Torso&quot;):findFirstChild(&quot;TagFlee&quot;)
&#9;&#9;if tagscript ~= nil then
&#9;&#9;&#9;tagscript.Name = &quot;TagIt&quot;
&#9;&#9;end
&#9;&#9;local tagblock = chosen.Character:findFirstChild(&quot;TagBlock&quot;)
&#9;&#9;if tagblock ~= nil then
&#9;&#9;&#9;tagblock.Parent = nil
&#9;&#9;end
&#9;&#9;dubHat(chosen)
&#9;&#9;tagger.Value = tagger.Value..&quot;, &quot;..chosen.Name
&#9;else
&#9;&#9;selectCharacter(person)
&#9;end
end

function calculate(char)
&#9;local characters = char:GetChildren()
&#9;select = (#characters/5)-((#characters/5)%-1)
&#9;for i = 1,select do
&#9;&#9;selectCharacter(characters)
&#9;&#9;itcount = itcount + 1
&#9;end
end

function itCheck(leave)
&#9;print(&quot;Player left: &quot;..leave.Name)
&#9;local isit = leave:findFirstChild(&quot;ItStatus&quot;)
&#9;if isit ~= nil and isit.Value == true then
&#9;&#9;tagger.Value = &quot;&quot;
&#9;&#9;selectCharacter(game.Players:GetChildren())
&#9;&#9;local gamers = game.Players:GetChildren()
&#9;&#9;for i = 1,#gamers do
&#9;&#9;&#9;local isit2 = gamers[i]:findFirstChild(&quot;ItStatus&quot;)
&#9;&#9;&#9;if isit2 ~= nil and isit2.Value == true then
&#9;&#9;&#9;&#9;if tagger.Value == &quot;&quot; then
&#9;&#9;&#9;&#9;&#9;tagger.Value = gamers[i].Name
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;tagger.Value = tagger.Value..&quot;, &quot;..gamers[i].Name
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

function send(host)&#9;&#9;&#9;&#9;--You should be familiar with the playerspawn map method.
&#9;local spawns = map:findFirstChild(&quot;Spawns&quot;):GetChildren()
&#9;local itspawn = map:findFirstChild(&quot;ItSpawn&quot;)

&#9;local players = host:GetChildren()
&#9;for i = 1,#players do&#9;&#9;&#9;--Note: all players spawn in at once, so keep player spawns away from the &quot;ItSpawn&quot;
&#9;&#9;if players[i]:findFirstChild(&quot;leaderstats&quot;) ~= nil then
&#9;&#9;&#9;players[i]:findFirstChild(&quot;leaderstats&quot;).Value = 0
&#9;&#9;end
&#9;&#9;local tagger2 = script:findFirstChild(&quot;Tag&quot;):clone()
&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;--Yes! The same script controls both &quot;it&quot; and &quot;runner&quot; tagging options XD
&#9;&#9;if players[i]:findFirstChild(&quot;ItStatus&quot;) ~= nil and players[i]:findFirstChild(&quot;ItStatus&quot;).Value == false then
&#9;&#9;&#9;local torso = players[i].Character:findFirstChild(&quot;Torso&quot;)
&#9;&#9;&#9;if torso ~= nil then
&#9;&#9;&#9;&#9;tagger2.Disabled = false
&#9;&#9;&#9;&#9;tagger2.Name = &quot;TagFlee&quot;
&#9;&#9;&#9;&#9;tagger2.Parent = torso
&#9;&#9;&#9;&#9;local spawn = spawns[math.random(1,#spawns)]
&#9;&#9;&#9;&#9;torso.CFrame = spawn.CFrame * CFrame.new(0,5,0)
&#9;&#9;&#9;end
&#9;&#9;else
&#9;&#9;&#9;local torso = players[i].Character:findFirstChild(&quot;Torso&quot;)
&#9;&#9;&#9;if torso ~= nil then
&#9;&#9;&#9;&#9;tagger2.Disabled = false
&#9;&#9;&#9;&#9;tagger2.Name = &quot;TagIt&quot;
&#9;&#9;&#9;&#9;tagger2.Parent = torso
&#9;&#9;&#9;&#9;torso.CFrame = itspawn.CFrame * CFrame.new(0,5,0)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

function clear()
&#9;local player = game.Players:GetChildren()
&#9;for i = 1,#player do
&#9;&#9;if player[i]:findFirstChild(&quot;ItStatus&quot;) ~= nil then
&#9;&#9;&#9;player[i]:findFirstChild(&quot;ItStatus&quot;).Value = false
&#9;&#9;end
&#9;&#9;if player[i]:findFirstChild(&quot;leaderstats&quot;) ~= nil then
&#9;&#9;&#9;player[i]:findFirstChild(&quot;leaderstats&quot;).Value = 2
&#9;&#9;end
&#9;end
&#9;tagger.Value = &quot;&quot;
end

function begin()
&#9;clear()
&#9;calculate(game.Players)
&#9;info.Value = &quot;Selecting players to be taggers...&quot;
&#9;wait(3)
&#9;info.Value = &quot;Tagger(s): &quot;..tagger.Value
&#9;wait(3)
&#9;info.Value = &quot;Everyone get ready!&quot;
&#9;wait(3)
&#9;send(game.Players)
&#9;running = true
&#9;info.Value = &quot;GAMERS, RUN!!&quot;
&#9;connection = game.Players.ChildRemoved:connect(itCheck)
