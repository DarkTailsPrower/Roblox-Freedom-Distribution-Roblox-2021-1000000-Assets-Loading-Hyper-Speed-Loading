			</Item>
			<Item class="Script" referent="RBX1900">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">--MrSven
--Did you read the README file?

main=script.Parent
player=main.Parent.Parent
connector=script.connector
open=false

function clicked()
&#9;if open==true then-- if open, then close it
&#9;&#9;main.selector:Remove()
&#9;&#9;open=false
&#9;&#9;else
&#9;&#9;if game.Workspace.voting.Value==false then--if not already voting
&#9;&#9;&#9;players= game.Players:GetChildren()
&#9;&#9;&#9;if #players&gt;2 then--if enough players
&#9;&#9;&#9;&#9;open=true
&#9;&#9;&#9;&#9;frame=Instance.new(&quot;Frame&quot;)--make the player selector
&#9;&#9;&#9;&#9;frame.Parent=main
&#9;&#9;&#9;&#9;frame.Name=&quot;selector&quot;
&#9;&#9;&#9;&#9;frame.Position=UDim2.new(0,main.Frame.Position.X.Offset,0,5)
&#9;&#9;&#9;&#9;frame.Size=UDim2.new(0,150,0,(#players*25)-15)
&#9;&#9;&#9;&#9;frame.BackgroundColor3=Color3.new(1,1,1)
&#9;&#9;&#9;&#9;frame.BackgroundTransparency=.5
&#9;&#9;&#9;&#9;frame.BorderSizePixel=0
&#9;&#9;&#9;&#9;pos=0
&#9;&#9;&#9;&#9;for i=1, #players do--build the buttons
&#9;&#9;&#9;&#9;&#9;if players[i].Name~=player.Name then
&#9;&#9;&#9;&#9;&#9;&#9;but=Instance.new(&quot;TextButton&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;but.Name=players[i].Name
&#9;&#9;&#9;&#9;&#9;&#9;but.Parent=frame
&#9;&#9;&#9;&#9;&#9;&#9;but.BackgroundColor3=Color3.new(1,1,1)
&#9;&#9;&#9;&#9;&#9;&#9;but.Size=UDim2.new(1,-10,0,20)
&#9;&#9;&#9;&#9;&#9;&#9;but.Position=UDim2.new(0,5,0,5+(pos*25))
&#9;&#9;&#9;&#9;&#9;&#9;but.Text=players[i].Name
&#9;&#9;&#9;&#9;&#9;&#9;connect=connector:Clone()
&#9;&#9;&#9;&#9;&#9;&#9;connect.Parent=but
&#9;&#9;&#9;&#9;&#9;&#9;connect.Disabled=false
&#9;&#9;&#9;&#9;&#9;&#9;pos=pos+1
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end else
&#9;&#9;&#9;&#9;q=Instance.new(&quot;Message&quot;)
&#9;&#9;&#9;&#9;q.Parent=player
&#9;&#9;&#9;&#9;q.Text=&quot;Not Enough Players!&quot;
&#9;&#9;&#9;&#9;wait(3)
&#9;&#9;&#9;&#9;q:Remove()
&#9;&#9;&#9;end else
&#9;&#9;&#9;q=Instance.new(&quot;Message&quot;)
&#9;&#9;&#9;q.Parent=player
&#9;&#9;&#9;q.Text=&quot;Already voting!&quot;
&#9;&#9;&#9;wait(3)
&#9;&#9;&#9;q:Remove()
&#9;&#9;end
&#9;end
end
if not game.Lighting:findFirstChild(&quot;globalled&quot;) then
&#9;function _G.sendVote(sender, tokick)
&#9;&#9;game.Players:findFirstChild(sender).PlayerGui.VoteToKickMain.selector:Remove()
&#9;&#9;open=false
&#9;&#9;if game.Workspace.voting.Value==false then--double-check that we arn&apos;t already voting
&#9;&#9;&#9;game.Workspace.voting.Value=true
&#9;&#9;&#9;game.Workspace.voting.tobekicked.Value=tokick
&#9;&#9;&#9;players=game.Players:GetChildren()
&#9;&#9;&#9;for i=1, #players do --open the voting frame
&#9;&#9;&#9;&#9;if players[i].Name~=sender and players[i].Name~=tokick then
&#9;&#9;&#9;&#9;&#9;players[i].PlayerGui.VoteToKickMain.vote.Visible=true
&#9;&#9;&#9;&#9;&#9;players[i].PlayerGui.VoteToKickMain.vote.question.Text=sender..&quot; wants &quot;..tokick..&quot; to be kicked from this server: Do you agree?&quot;
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;&#9;q=Instance.new(&quot;Message&quot;)
&#9;&#9;&#9;q.Parent=game.Players:findFirstChild(sender)
&#9;&#9;&#9;q.Text=&quot;The vote has been initiated.&quot;
&#9;&#9;&#9;q2=Instance.new(&quot;Message&quot;)
&#9;&#9;&#9;q2.Parent=game.Players:findFirstChild(tokick)
&#9;&#9;&#9;q2.Text=&quot;A vote to kick you has been initiated &gt;:]&quot;
&#9;&#9;&#9;wait(3)
&#9;&#9;&#9;q:Remove()
&#9;&#9;&#9;q2:Remove()
&#9;&#9;&#9;else --let the sender know that we are already voting.
&#9;&#9;&#9;q=Instance.new(&quot;Message&quot;)
&#9;&#9;&#9;q.Parent=game.Players:findFirstChild(sender)
&#9;&#9;&#9;q.Text=&quot;Already voting: vote not initiated!&quot;
&#9;&#9;&#9;wait(3)
&#9;&#9;&#9;q:Remove()
&#9;&#9;end&#9;
&#9;end
&#9;val=Instance.new(&quot;StringValue&quot;)
&#9;val.Parent=game.Lighting
&#9;val.Name=&quot;globalled&quot;
end

main.Frame.TextButton.MouseButton1Click:connect(clicked)
</ProtectedString>
				</Properties>
