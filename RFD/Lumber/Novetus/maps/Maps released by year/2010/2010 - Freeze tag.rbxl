					<string name="Name">Script</string>
					<ProtectedString name="Source">local info = game.Workspace:findFirstChild(&quot;InfoReel&quot;)
local tagline = game.Workspace:findFirstChild(&quot;TaggerReel&quot;)

local infotab = script.Parent:findFirstChild(&quot;Information&quot;)
local tag = script.Parent:findFirstChild(&quot;TagInfo&quot;)

function news(Value)
&#9;infotab.Text = info.Value
end
function tagger(Value)
&#9;tag.Text = &quot;Tagger(s): &quot;..tagline.Value
end

if info ~= nil and tagline ~= nil then
&#9;info.Changed:connect(news)
&#9;tagline.Changed:connect(tagger)
&#9;infotab.Text = info.Value
&#9;tag.Text = &quot;Tagger(s): &quot;..tagline.Value
end
</ProtectedString>
				</Properties>
			</Item>
