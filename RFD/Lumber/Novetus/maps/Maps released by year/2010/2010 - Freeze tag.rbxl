		<Item class="Script" referent="RBX729">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">ReadMe</string>
				<ProtectedString name="Source">--[[
&#9;
&#9;Directions;
&#9;Put &quot;Chat&quot; into StarterGui,
&#9;Put &quot;Chat2&quot; into ServerStorage,
&#9;-----
&#9;How to use;
&#9;Click on the GUI snd type in your message.
&#9;Then click enter twice.
&#9;
&#9;
]]</ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX730">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Cheats</string>
				<ProtectedString name="Source">-- Badcc

local VAL = &quot;Tags&quot; --Change this to the name of the stat.
local AMMOUNT = 500 --Change this to how much money they get.


function onChatted(msg,player)
&#9;msg = msg:lower()  -- Make msg into lowercase.
&#9;if (msg == &quot;/sc money&quot;) then
&#9;&#9;player.leaderstats:findFirstChild(VAL).Value = player.leaderstats:findFirstChild(VAL).Value + tonumber(AMMOUNT)
&#9;end
end

function onEnter(player)
&#9;player.Chatted:connect(function(msg) onChatted(msg,player) end)
end

game.Players.PlayerAdded:connect(onEnter)</ProtectedString>
			</Properties>
		</Item>
