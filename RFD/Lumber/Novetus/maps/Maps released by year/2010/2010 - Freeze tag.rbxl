&#9;&#9;&#9;local torso = player.Character:findFirstChild(&quot;Torso&quot;)

&#9;&#9;&#9;local tagger3 = script:findFirstChild(&quot;Tag&quot;):clone()

&#9;&#9;&#9;if torso ~= nil then
&#9;&#9;&#9;&#9;tagger3.Disabled = false
&#9;&#9;&#9;&#9;tagger3.Name = &quot;TagFlee&quot;
&#9;&#9;&#9;&#9;tagger3.Parent = torso
&#9;&#9;&#9;&#9;local spawn = spawns[math.random(1,#spawns)]
&#9;&#9;&#9;&#9;torso.CFrame = spawn.CFrame * CFrame.new(0,5,0)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end
script.Parent.Touched:connect(tele)

verify(game.Players)
