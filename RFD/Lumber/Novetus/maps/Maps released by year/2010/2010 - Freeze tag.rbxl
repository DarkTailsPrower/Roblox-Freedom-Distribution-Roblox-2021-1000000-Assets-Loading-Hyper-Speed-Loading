					</Item>
					<Item class="Script" referent="RBX1890">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Main</string>
							<ProtectedString name="Source">price = 275
player = script.Parent.Parent.Parent.Parent.Parent
Points = player.leaderstats.Points 
m = Instance.new(&quot;Message&quot;)
function buy()
if player.StarterGear:findFirstChild(&quot;SnowCannon&quot;) then
m.Parent = player
m.Text = &quot;You already own a Snow Cannon.&quot;
wait(3)
m:remove()
elseif Points.Value &lt;= price - 1 then
m.Parent = player
m.Text = &quot;Nice try, you need &quot; .. price - Points.Value .. &quot; more Points.&quot;
wait(3)
m:remove()
elseif Points.Value &gt;= price then 
Points.Value = Points.Value - price
g = game.Lighting.SnowCannon:clone()
g.Parent = player.StarterGear
wait(0.01)
g = game.Lighting.SnowCannon:clone()
g.Parent = player.Backpack
wait(0.01)
m.Parent = player
m.Text = &quot;Snow Cannon bought.&quot;
wait(3)
m:remove()
end
end

script.Parent.MouseButton1Down:connect(buy)
--jjjj1111222 customized GUI shop button</ProtectedString>
						</Properties>
					</Item>
				</Item>
			</Item>
