				<Item class="Script" referent="RBX1700">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">button = script.Parent
tele = button.Parent.Tele
human = button.Parent.Humanoid
admins = { &quot;jaredvaldez2&quot; } --put the people you want here to enter without vip shirt

function checkOkToLetIn(name) 
&#9;for i = 1,#admins do 
&#9;&#9;if (string.upper(name) == string.upper(admins[i])) then return true end 
&#9;end 
&#9;return false 
end 

function onTouched(hit)
&#9;local h = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;local torso = hit.Parent:findFirstChild(&quot;Torso&quot;)
&#9;if (h ~= nil) and (torso ~= nil) then
&#9;&#9;local shirt = hit.Parent.Torso:findFirstChild(&quot;roblox&quot;)
