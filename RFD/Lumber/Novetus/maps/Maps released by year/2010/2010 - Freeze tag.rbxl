							<ProtectedString name="Source">price = 60
player = script.Parent.Parent.Parent.Parent.Parent
Points = player.leaderstats.Points 
m = Instance.new(&quot;Message&quot;)
i = Instance.new(&quot;Fire&quot;)
function buy()
if player.Character.Head.Transparency == 1 then
m.Parent = player
m.Text = &quot;You already have an invisible head.&quot;
wait(3)
m:remove()
elseif Points.Value &lt;= price - 1 then
m.Parent = player
m.Text = &quot;Nice try, you need &quot; .. price - Points.Value .. &quot; more Points.&quot;
wait(3)
m:remove()
elseif Points.Value &gt;= price then 
Points.Value = Points.Value - price
player.Character.Head.Transparency = 1
m.Parent = player
m.Text = &quot;Invisible Head!&quot;
wait(3)
m:remove()
end
end

