			<Item class="Script" referent="RBX10">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">gui = script.Parent
local player = script.Parent.Parent.Parent
function enter(gui)
&#9;text = Instance.new(&quot;TextLabel&quot;, gui[&quot;chat_frame&quot;]) text.Size = UDim2.new(1, 0, 0.056, 0)
&#9;text.BackgroundTransparency = 1 text.TextColor3 = Color3.new(0/255, 0/255, 0/255)
&#9;text.Text = player.Name..&quot;: &quot;..gui.message.Text text.Name = #game.ServerStorage.Chat2[&quot;chat_frame&quot;]:GetChildren()
&#9;text.Font = &quot;SourceSansBold&quot; text.FontSize = &quot;Size14&quot; text.TextWrapped = true text:Clone().Parent = game.ServerStorage.Chat2[&quot;chat_frame&quot;]
&#9;for index, val in pairs(gui[&quot;chat_frame&quot;]:GetChildren()) do
&#9;if val.Name ~= text.Name then
&#9;val.Position = val.Position + UDim2.new(0, 0, 0.056, 0)
&#9;game.ServerStorage.Chat2[&quot;chat_frame&quot;]:FindFirstChild(val.Name):Destroy()
&#9;val:Clone().Parent = game.ServerStorage.Chat2[&quot;chat_frame&quot;]
&#9;&#9;end
&#9;end
end

gui.update.Changed:connect(function() if gui.message.Text ~= &quot;Click here to chat your message.&quot; and gui.update.Value == true then  enter(gui)  
gui.message.Text = &quot;Click here to chat your message.&quot;
end end)


&#9;
function update(gui)
&#9;while true do wait(0)
&#9;&#9;for index, val2 in pairs(game.ServerStorage.Chat2[&quot;chat_frame&quot;]:GetChildren()) do 
&#9;&#9;if gui[&quot;chat_frame&quot;]:FindFirstChild(val2.Name) == nil then
&#9;&#9;val2:Clone().Parent = gui[&quot;chat_frame&quot;]
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

update(gui)</ProtectedString>
				</Properties>
