			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Remove Health Bar</string>
				<ProtectedString name="Source">while true do -- Health Bar Remover By:Bradan10

for inx, val in pairs(game.Players:GetPlayers()) do 
if val:FindFirstChild(&quot;PlayerGui&quot;) then 
if val.PlayerGui:FindFirstChild(&quot;HealthGUI&quot;) then 
val.PlayerGui.HealthGUI:Remove() 
end 
end 
end 

wait()
end
</ProtectedString>
			</Properties>
