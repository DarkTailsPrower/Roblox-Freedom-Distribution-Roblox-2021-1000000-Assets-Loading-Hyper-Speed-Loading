&#9;&#9;mapGame(game.Lighting:findFirstChild(&quot;Maps&quot;))
&#9;&#9;begin()
&#9;end
end

for i = 1,30 do
&#9;wait(1)
&#9;info.Value = &quot;Waiting for 1 more player...&quot;
end

function tele(hit)
&#9;if running == true and map ~= nil then
&#9;&#9;local player = game.Players:findFirstChild(hit.Parent.Name)
&#9;&#9;if player ~= nil then
&#9;&#9;&#9;if player:findFirstChild(&quot;leaderstats&quot;) ~= nil then
&#9;&#9;&#9;&#9;player:findFirstChild(&quot;leaderstats&quot;).Value = 0
&#9;&#9;&#9;end
