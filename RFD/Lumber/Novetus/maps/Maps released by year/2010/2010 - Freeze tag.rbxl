						<string name="Name">Script</string>
						<ProtectedString name="Source">button = script.Parent
tele = button.Parent.Tele
human = button.Parent.Humanoid
admins = { &quot;Mitsos123alt&quot;,&quot;Chase0114&quot;,&quot;Hackie04&quot;,&quot;MadGameVEVO&quot; } --put the people you want here to enter without vip shirt

function checkOkToLetIn(name) 
&#9;for i = 1,#admins do 
&#9;&#9;if (string.upper(name) == string.upper(admins[i])) then return true end 
&#9;end 
&#9;return false 
end 

function onTouched(hit)
&#9;local h = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;local torso = hit.Parent:findFirstChild(&quot;Torso&quot;)
&#9;if (h ~= nil) and (torso ~= nil) then
&#9;&#9;local shirt = hit.Parent.Torso:findFirstChild(&quot;roblox&quot;)
&#9;&#9;if (shirt ~= nil) and (shirt.Texture == &quot;http://www.roblox.com/asset/?id=68186494&quot;) then --put the texture here
&#9;&#9;&#9;tp = tele.Position
&#9;&#9;&#9;torso.CFrame = CFrame.new(tp.x, tp.y+3, tp.z)
&#9;&#9;end
&#9;&#9;if (checkOkToLetIn(hit.Parent.Name)) then
&#9;&#9;&#9;tp = tele.Position
&#9;&#9;&#9;torso.CFrame = CFrame.new(tp.x, tp.y+3, tp.z)
&#9;&#9;end
&#9;end
end 

button.Touched:connect(onTouched)</ProtectedString>
