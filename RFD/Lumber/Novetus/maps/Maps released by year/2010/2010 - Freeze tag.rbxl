							<ProtectedString name="Source">price = 5
player = script.Parent.Parent.Parent.Parent.Parent
Tags = player.leaderstats.Tags 
m = Instance.new(&quot;Message&quot;)
function buy()
if player.Character.Humanoid.WalkSpeed == 20 or player.Character.Humanoid.WalkSpeed == 25 then
m.Parent = player
m.Text = &quot;Your WalkSpeed is &quot; ..player.Character.Humanoid.WalkSpeed.. &quot;.&quot;
wait(3)
m:remove()
elseif Tags.Value &lt;= price - 1 then
m.Parent = player
m.Text = &quot;Nice try, you need &quot; .. price - Tags.Value .. &quot; more Tags.&quot;
wait(3)
m:remove()
elseif Tags.Value &gt;= price then 
Tags.Value = Tags.Value - price
player.Character.Humanoid.WalkSpeed = 20
m.Parent = player
m.Text = &quot;Walkspeed = 20&quot;
wait(3)
m:remove()
end
end

