			<Item class="Script" referent="RBX1037">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">local P = script.Parent.Head
local D = false

function onTouch(hit)
if D == false then
D = true
local H = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;if H~= nil then
&#9;local U = game.Players:playerFromCharacter(hit.Parent)
&#9;local S = U.leaderstats.Tags
&#9;&#9;if S.Value &gt; 4 then
&#9;&#9;S.Value  = S.Value - 5
&#9;&#9;game.Lighting.HideLegs:clone().Parent = U.Backpack
&#9;&#9;end
&#9;end
wait(2)
D = false
end
end

P.Touched:connect(onTouch)</ProtectedString>
