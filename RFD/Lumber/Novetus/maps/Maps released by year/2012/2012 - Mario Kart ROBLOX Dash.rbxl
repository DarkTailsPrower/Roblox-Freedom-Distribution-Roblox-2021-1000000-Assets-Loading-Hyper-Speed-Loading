				<string name="Name">DunsJump</string>
				<ProtectedString name="Source">wait(.7)
script.Parent.Humanoid.Changed:connect(function(val)
if script.Parent.Humanoid.Sit == false then
if script.Parent.Humanoid.Health ~= 0 then
script.Parent.Humanoid.Health = 0
end
end
end)</ProtectedString>
