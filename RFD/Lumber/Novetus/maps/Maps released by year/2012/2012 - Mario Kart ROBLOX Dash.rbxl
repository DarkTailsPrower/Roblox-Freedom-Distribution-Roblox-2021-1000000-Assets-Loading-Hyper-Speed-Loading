						<ProtectedString name="Source">while true do
&#9;script.Parent.Box.CFrame = script.Parent.Box.CFrame * CFrame.Angles(0.02, 0.02, 0.005)
&#9;script.Parent.Question.CFrame = script.Parent.Question.CFrame * CFrame.Angles(0, 0.03, 0)
&#9;wait()
end </ProtectedString>
					</Properties>
