						<ProtectedString name="Source">player = script.Parent.Parent.Parent.Parent.Parent

function onButtonClicked()
if script.Parent.Parent.Voted.Value == false then
script.Parent.Parent.Chosen.Value = &quot;Seven&quot;
script.Parent.Parent.Selected.Text = &quot;GBA Bowser Castle 1&quot;
script.Parent.Parent.Track.Image = &quot;http://www.roblox.com/asset/?id=73336945&quot;
end
end

script.Parent.MouseButton1Click:connect(onButtonClicked)</ProtectedString>
