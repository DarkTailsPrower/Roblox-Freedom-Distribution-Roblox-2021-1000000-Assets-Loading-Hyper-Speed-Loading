				<ProtectedString name="Source">local cam = workspace.CurrentCamera

script.Parent.Parent.Character.Humanoid.Changed:connect(function(val)
if script.Parent.Parent.Character.Humanoid.Sit == true then
wait(1)
cam.CameraSubject = game.Players.LocalPlayer.Character.Humanoid
cam.CameraType = &quot;Follow&quot; 
script:Remove()
end 
end)</ProtectedString>
