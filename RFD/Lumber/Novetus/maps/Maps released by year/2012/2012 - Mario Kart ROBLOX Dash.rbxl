						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">script.Parent.Touched:connect(function(hit)
&#9;if hit.Parent:findFirstChild(&quot;Humanoid&quot;) then
&#9;&#9;a = hit.Parent.Name
&#9;&#9;if game.Players[a]:findFirstChild(&quot;Section&quot;).Value == 12 then
&#9;&#9;&#9;game.Players[a]:findFirstChild(&quot;Lap&quot;).Value = game.Players[a]:findFirstChild(&quot;Lap&quot;).Value + 1
&#9;&#9;end
&#9;&#9;game.Players[a]:findFirstChild(&quot;Section&quot;).Value = 0
&#9;end
end)</ProtectedString>
					</Properties>
				</Item>
			</Item>
