player = bin.Parent.Parent 

function onButton1Down(mouse)
if game.Workspace:findFirstChild(&quot;Karts&quot;) then 
bin.Timer.Disabled = false
print(&quot;Found Karts&quot;) 
time = 2.5
game.Workspace.Karts[player.Name].VehicleSeat.Script.Dash.Value = 1
game.Workspace.Karts[player.Name].VehicleSeat.MaxSpeed = 65
game.Workspace.Karts[player.Name].VehicleSeat.Script.Dash.Dashing.Value = true 
