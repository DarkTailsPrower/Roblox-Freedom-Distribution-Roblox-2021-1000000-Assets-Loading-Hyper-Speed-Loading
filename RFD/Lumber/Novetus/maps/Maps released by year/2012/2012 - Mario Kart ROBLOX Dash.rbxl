script.Parent.CFrame = script.Parent.CFrame + Vector3.new(0, i, 0)
wait(.1)
end
for i=-0.1,0,0.005 do
script.Parent.CFrame = script.Parent.CFrame + Vector3.new(0, i, 0)
wait(.1)
end
end
</ProtectedString>
