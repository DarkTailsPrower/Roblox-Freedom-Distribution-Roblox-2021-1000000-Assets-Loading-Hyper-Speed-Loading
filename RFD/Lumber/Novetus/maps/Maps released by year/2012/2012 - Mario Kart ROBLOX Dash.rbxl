					<string name="Name">Script</string>
					<ProtectedString name="Source">bin = script.Parent
player = bin.Parent.Parent

function onButton1Down(mouse)
if game.Workspace:findFirstChild(&quot;Karts&quot;) then 
player.Roullete.Value = false
print(&quot;Placing Fake Item Box&quot;) 
groupy = Instance.new(&quot;Model&quot;, game.Workspace)
groupy.Name = &quot;FakeBox&quot;
--Creating Box
box = Instance.new(&quot;Part&quot;, groupy)
box.Name = &quot;Box&quot;
box.FormFactor = &quot;Symmetric&quot;
box.Size = Vector3.new(4, 4, 4)
box.Anchored = true
box.CanCollide = false
box.BrickColor = BrickColor.new(&quot;Bright red&quot;)
box.Transparency = 0.4
box.TopSurface = &quot;Universal&quot;
box.BottomSurface = &quot;Universal&quot;
box.FrontSurface = &quot;Universal&quot;
box.LeftSurface = &quot;Universal&quot;
box.BackSurface = &quot;Universal&quot;
box.RightSurface = &quot;Universal&quot;
box.CFrame = game.Workspace.Karts[player.Name].EnginePart.CFrame + Vector3.new(0, 1.5, 0)
--Creating Questionmark
question = Instance.new(&quot;Part&quot;, groupy)
question.Name = &quot;Question&quot;
question.FormFactor = &quot;Custom&quot;
question.Size = Vector3.new(4, 4, 0.2)
question.Anchored = true
question.CanCollide = false
question.BrickColor = BrickColor.new(&quot;Bright red&quot;)
question.Transparency = 1
question.CFrame = box.CFrame
--Creating Decals
decal1 = Instance.new(&quot;Decal&quot;, question)
decal1.Face = &quot;Front&quot;
decal1.Texture = &quot;http://www.roblox.com/asset/?id=71757816&quot;
decal1.Name = &quot;Decal1&quot;
decal2 = Instance.new(&quot;Decal&quot;, question)
decal2.Face = &quot;Back&quot;
decal2.Texture = &quot;http://www.roblox.com/asset/?id=71757816&quot;
decal2.Name = &quot;Decal2&quot;
--Cloning the Spinning Script
rotate = script.Parent.Spin:Clone()
rotate.Parent = groupy 
rotate.Disabled = false
--Cloning the Hit Script
hit = bin.Hit:Clone()
hit.Parent = groupy
hit.Disabled = false
bin:Remove()
end 
end

function onSelected(mouse)
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end

bin.Selected:connect(onSelected)
