					<bool name="Looped">true</bool>
					<string name="Name">Waiting</string>
					<float name="Pitch">1</float>
					<bool name="PlayOnRemove">false</bool>
					<Content name="SoundId"><url>rbxasset://sounds/RobloxMarioKart/Lobby.wav</url></Content>
