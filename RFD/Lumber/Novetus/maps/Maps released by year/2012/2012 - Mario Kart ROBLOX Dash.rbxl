				<Item class="Script" referent="RBX8501">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">ColourCycle</string>
						<ProtectedString name="Source">while true do
script.Parent.BrickColor = BrickColor.new(&quot;Bright orange&quot;)
wait(.1) 
script.Parent.BrickColor = BrickColor.new(&quot;Br. yellowish orange&quot;)
wait(.1)
script.Parent.BrickColor = BrickColor.new(&quot;Bright orange&quot;)
wait(.1)
script.Parent.BrickColor = BrickColor.new(&quot;Neon orange&quot;)
wait(.1)
end </ProtectedString>
					</Properties>
				</Item>
			</Item>
