				<Item class="Script" referent="RBX7033">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">GetCoin</string>
						<ProtectedString name="Source">available = true

script.Parent.Touched:connect(function(hit)
if available == true then
if hit.Parent:findFirstChild(&quot;Humanoid&quot;) then
a = hit.Parent.Name
game.Players[a].leaderstats.Coins.Value = game.Players[a].leaderstats.Coins.Value + 1
script.Parent.Transparency = 1
available = false
wait(15)
for i=1,0,-0.1 do
script.Parent.Transparency = i
wait()
end
available = true
end
end
end)</ProtectedString>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX7034">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Spin</string>
						<ProtectedString name="Source">while true do
script.Parent.CFrame = script.Parent.CFrame * CFrame.fromEulerAnglesXYZ(0, 0, 0.4)
wait(.3)
end </ProtectedString>
					</Properties>
				</Item>
			</Item>
