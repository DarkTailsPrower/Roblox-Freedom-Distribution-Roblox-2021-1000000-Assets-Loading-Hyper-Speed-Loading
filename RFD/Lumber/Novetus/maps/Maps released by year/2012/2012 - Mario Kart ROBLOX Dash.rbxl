		<Item class="Script" referent="RBX44">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">LapChange</string>
				<ProtectedString name="Source">script.Parent.Parent.Lap.Changed:connect(function(lap) 
game.Lighting.LapDisplay:Clone().Parent = script.Parent.ScreenGui 
if lap == 4 then 
for i,v in next, script.Parent.Parent.Backpack:GetChildren() do
v:Remove()
end
--script.Parent.WutPlace:Remove()
wait(.1)
script.Parent.Parent.Racing.Value = false
script.Parent.Parent.Character.DunsJump:Remove()
game.Workspace.Karts[script.Parent.Parent.Name]:Remove()
game.Workspace.Positions[script.Parent.Parent.Name].Value = 0
wait(.1)
if game.Workspace.First.Value == &quot;&quot; then
game.Workspace.First.Value = script.Parent.Parent.Name
script.Parent.ScreenGui.Laps.Text = &quot;1ST PLACE!&quot; 
script.Parent.Parent.Character.Torso.CFrame = CFrame.new(1811, 67.8, -187)
for i = 1,9 do
script.Parent.Parent.leaderstats.Points.Value = script.Parent.Parent.leaderstats.Points.Value + 1
wait(.3)
end
elseif game.Workspace.Second.Value == &quot;&quot; then
game.Workspace.Second.Value = script.Parent.Parent.Name
script.Parent.ScreenGui.Laps.Text = &quot;2nd Place!&quot; 
script.Parent.Parent.Character.Torso.CFrame = CFrame.new(1811, 59.4, -175)
for i = 1,6 do
script.Parent.Parent.leaderstats.Points.Value = script.Parent.Parent.leaderstats.Points.Value + 1
wait(.3)
end
elseif game.Workspace.Third.Value == &quot;&quot; then
game.Workspace.Third.Value = script.Parent.Parent.Name
script.Parent.ScreenGui.Laps.Text = &quot;3rd Place!&quot;
script.Parent.Parent.Character.Torso.CFrame = CFrame.new(1811, 55.8, -199)
for i = 1,3 do
script.Parent.Parent.leaderstats.Points.Value = script.Parent.Parent.leaderstats.Points.Value + 1
wait(.3)
end
else
script.Parent.ScreenGui.Laps.Text = &quot;You Lose!&quot; 
script.Parent.Parent.Character.Torso.CFrame = CFrame.new(1761, 43, -187)
script.Parent.Parent.leaderstats.Points.Value = script.Parent.Parent.leaderstats.Points.Value + 1
end 
game.Workspace.CurrentRacers.Value = game.Workspace.CurrentRacers.Value - 1
wait(5)
script.Parent.ScreenGui.Laps.Text = &quot;&quot;
script:Remove()
end
end)</ProtectedString>
