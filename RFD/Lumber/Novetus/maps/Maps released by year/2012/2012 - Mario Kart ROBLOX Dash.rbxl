		<Item class="Script" referent="RBX737">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">HostScript</string>
				<ProtectedString name="Source">Game.Players.PlayerAdded:connect(function( Player )
Instance.new(&quot;BoolValue&quot;, Player).Name = &quot;Roullete&quot;
Instance.new(&quot;BoolValue&quot;, Player).Name = &quot;Racing&quot;
Instance.new(&quot;BrickColorValue&quot;, Player).Name = &quot;Colour&quot;
Instance.new(&quot;NumberValue&quot;, Player).Name = &quot;Kart&quot;
l = Instance.new(&quot;NumberValue&quot;, Player)
l.Name = &quot;Lap&quot;
Instance.new(&quot;NumberValue&quot;, Player).Name = &quot;Section&quot;
Instance.new(&quot;NumberValue&quot;, Player).Name = &quot;Position&quot;
Instance.new(&quot;IntValue&quot;, Player).Name = &quot;leaderstats&quot;
Instance.new(&quot;IntValue&quot;, Player.leaderstats).Name = &quot;Points&quot;
Instance.new(&quot;IntValue&quot;, Player.leaderstats).Name = &quot;Coins&quot;
Player.CharacterAdded:connect(function( Character ) 
Character.Humanoid.Died:connect(function() 
if Player.Racing.Value == true then
if game.Workspace:findFirstChild(&quot;Karts&quot;) then
if game.Workspace.Karts:findFirstChild(Player.Name) then
game.Workspace.Karts[Player.Name]:Remove()
game.Workspace.Positions[Player.Name].Value = 100000
game.Workspace.Positions[Player.Name].Name = &quot;NotUsed&quot;
end
end
Player.Racing.Value = false
script.Parent.CurrentRacers.Value = script.Parent.CurrentRacers.Value - 1
end
end)
end)
end)

game.Players.PlayerRemoving:connect(function(p)
if p.Racing.Value == true then
if game.Workspace:findFirstChild(&quot;Karts&quot;) then
if game.Workspace.Karts:findFirstChild(p.Name) then
game.Workspace.Karts[p.Name]:Remove()
game.Workspace.Positions[p.Name].Value = 100000
game.Workspace.Positions[p.Name].Name = &quot;NotUsed&quot;
end
end
script.Parent.CurrentRacers.Value = script.Parent.CurrentRacers.Value - 1
end
end)</ProtectedString>
			</Properties>
			<Item class="Message" referent="RBX738">
				<Properties>
					<string name="Name">Message</string>
					<string name="Text"></string>
				</Properties>
			</Item>
		</Item>
		<Item class="Script" referent="RBX739">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">GameScript</string>
				<ProtectedString name="Source">function finishThis()
script.Parent.Info.Value = &quot;The Race Is Over!&quot;
game.Workspace.Racing.Value = false
wait(5)
for i,v in next, game.Workspace.Positions:GetChildren() do
v.Name = &quot;NotUsed&quot;
v.Value = 100000
end
for i,v in next, game.Workspace:GetChildren() do
if (v.Name == &quot;Banana&quot;) or (v.Name == &quot;FakeItem&quot;) then
v:Remove()
end
end
for i,k in pairs(game.Players:GetPlayers()) do 
k.Lap.Value = 0
k.Section.Value = 0
end
game.Workspace.Map:Remove()
lol = script.PlaceChecker:Clone()
script.PlaceChecker:Remove()
lol.Parent = script
game.Lighting.FogEnd = 100000
game.Lighting.Ambient = Color3.new(0.5, 0.5, 0.5)
if game.Lighting:findFirstChild(&quot;Sky&quot;) then
game.Lighting.Sky:Remove()
end
if game.Workspace:findFirstChild(&quot;Karts&quot;) then
game.Workspace.Karts:Remove()
end
script.Parent.First.Value = &quot;&quot; 
script.Parent.Second.Value = &quot;&quot;
script.Parent.Third.Value = &quot;&quot;
for i,v in next, game.Workspace.Votes:GetChildren() do
v.Value = 0
end 
script.Waiting:Play()
countdown()
end

script.Parent.First.Changed:connect(function(val)
if val ~= &quot;&quot; then
script.Hint.Text = &quot;1st: &quot;..val
if game.Workspace.CurrentRacers.Value &lt;= 1 then 
script.Parent.Info.Value = val..&quot; Claimed 1st!&quot;
game.Workspace.Map.Section1:Remove()
wait(3)
finishThis() 
else
script.Parent.Info.Value = &quot;20 Seconds Until The End Of The Race!&quot;
wait(3)
script.Parent.Info.Value = &quot;&quot;
wait(17)
if game.Workspace.CurrentRacers.Value &gt;= 1 then 
finishThis()
end
end
end
end)

script.Parent.Second.Changed:connect(function(val)
if val ~= &quot;&quot; then
script.Hint.Text = &quot;1st: &quot;..script.Parent.First.Value..&quot; -- 2nd: &quot;..val
script.Parent.Info.Value = val..&quot; Claimed 2nd!&quot;
wait(3)
if game.Workspace.CurrentRacers.Value &lt;= 1 then 
game.Workspace.Map.Section1:Remove()
finishThis() 
end
end
end)

script.Parent.Third.Changed:connect(function(val)
if val ~= &quot;&quot; then
script.Hint.Text = &quot;1st: &quot;..script.Parent.First.Value..&quot; -- 2nd: &quot;..script.Parent.Second.Value..&quot; -- 3rd: &quot;..val
script.Parent.Info.Value = val..&quot; Claimed 3rd!&quot;
wait(3)
if game.Workspace.CurrentRacers.Value &lt;= 1 then
finishThis() 
end
end
end)

script.Parent.CurrentRacers.Changed:connect(function(drivers)
if script.Parent.Racing.Value == true then
if drivers &lt;= 0 then
script.Parent.Info.Value = &quot;There are no Racers Left!&quot;
wait(3)
finishThis() 
end
end
end)
 
function gameStart()
one = script.Parent.Votes.One.Value
two = script.Parent.Votes.Two.Value
three = script.Parent.Votes.Three.Value
four = script.Parent.Votes.Four.Value
five = script.Parent.Votes.Five.Value
six = script.Parent.Votes.Six.Value
seven = script.Parent.Votes.Seven.Value

maps = {1,2,3,4,5,6,7}
votes = {one,two,three,four,five,six,seven}
maps,vot={1},0

for i=1, #votes do
if votes[i] &gt; vot then
maps = {i}
vot = votes[i]
elseif votes[i] == vot then
table.insert(maps, i)
end
end

mapselected = maps[math.random(1, #maps)]
print(mapselected)
game.Lighting[mapselected]:Clone().Parent = game.Workspace
game.Workspace[mapselected].Name = &quot;Map&quot;
wait(3.5)
game.Lighting.Karts:Clone().Parent = game.Workspace
game.Workspace.Karts:makeJoints()
game.Lighting.KartRoom:Clone().Parent = game.Workspace
game.Workspace.Practice:Remove()
script.Parent.Info.Value = &quot;Preparing...&quot;
script.Parent.Preparing.Value = true
script.Waiting:Stop()
wait(3)
for i,k in pairs(game.Players:GetPlayers()) do 
k.Character.Torso.CFrame = CFrame.new(-326.5, 75.6, -110.5) -- -328, 83.9, -112
k.Racing.Value = true
k.Lap.Value = 1
k.Section.Value = 0
game.Workspace.Positions.NotUsed.Name = k.Name 
game.Lighting.LapChange:Clone().Parent = k.PlayerGui
game.Lighting.CamChange:Clone().Parent = k.PlayerGui
game.Workspace.Racers.Value = game.Workspace.Racers.Value + 1
game.Workspace.CurrentRacers.Value = game.Workspace.Racers.Value
end
script.Parent.Info.Value = &quot;Ready!&quot;
game.Lighting.Practice:Clone().Parent = game.Workspace
game.Workspace.Practice:makeJoints()
wait(2)
script.Parent.Info.Value = &quot;Get In Your Karts!&quot;
wait(10)
script.Parent.Info.Value = &quot;The Race Starts In...&quot;
wait(3)
script.Parent.Info.Value = &quot;The Race Starts In 3...&quot;
wait(1)
script.Parent.Info.Value = &quot;The Race Starts In 2...&quot;
wait(1)
script.Parent.Info.Value = &quot;The Race Starts In 1...&quot;
wait(1)
script.Parent.Info.Value = &quot;GO!!!&quot;
game.Workspace.KartRoom:Remove()
script.Parent.Preparing.Value = false
script.Parent.Racing.Value = true
wait(2)
for i,k in pairs(game.Players:GetPlayers()) do 
if k.Character.Humanoid.Sit == false then
k.Character.Humanoid.Health = 0
end
end
script.Parent.Info.Value = &quot;&quot; 
end

function voting()
for i,k in pairs(game.Players:GetPlayers()) do 
game.Lighting.Voting:Clone().Parent = k.PlayerGui.ScreenGui
k.PlayerGui.ScreenGui.Info.Visible = false
end
for i=20,0,-1 do
script.Parent.Info.Value = i..&quot; Seconds left to Vote!&quot;
wait(1)
end
for i,k in pairs(game.Players:GetPlayers()) do 
if k.PlayerGui.ScreenGui:findFirstChild(&quot;Voting&quot;) then
k.PlayerGui.ScreenGui.Voting:Remove()
k.PlayerGui.ScreenGui.Info.Visible = true
end
end
script.Parent.Info.Value = &quot;The Race Will Now Start!&quot;
wait(3)
gameStart()
end 

function countdown()
game.Lighting.TimeOfDay = &quot;00:00:00&quot;
script.Hint.Text = &quot;NEW ITEMS HAVE BEEN ADDED! Better Items will be given, further towards 8th.&quot;
for i = 40,0,-1 do
wait(1)
script.Parent.Info.Value = i..&quot; Seconds Until The Race Starts!&quot;
game.Workspace.Racers.Value = 0
end 
if game.Players.NumPlayers &gt;= 2 then 
script.Parent.Info.Value = &quot;Voting will now Start!&quot; 
wait(3)
voting()
else
script.Parent.Info.Value = &quot;2 Or More Players Are Needed! Restarting Countdown...&quot;
wait(3)
countdown()
end
end

script.Waiting:Play()
countdown()</ProtectedString>
			</Properties>
