				</Properties>
			</Item>
			<Item class="Script" referent="RBX742">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">PlaceChecker</string>
					<ProtectedString name="Source">bleh = false

game.Workspace.Racing.Changed:connect(function(yus)
if game.Workspace.Racing.Value == true then
if bleh == false then
bleh = true
&#9;repeat
&#9;&#9;for i,k in pairs(game.Players:GetPlayers()) do
&#9;&#9;&#9;if k.Racing.Value == true then 
&#9;&#9;&#9;if k.Character:findFirstChild(&quot;Torso&quot;) then
&#9;&#9;&#9;&#9;magnitude = (k.Character.Torso.Position - game.Workspace.Map:findFirstChild(&quot;Section&quot;..k.Section.Value + 1).Position).magnitude
&#9;&#9;&#9;&#9;game.Workspace.Positions[k.Name].Value = magnitude
&#9;&#9;&#9;&#9;mypos = 8
&#9;&#9;&#9;&#9;for i,v in next, game.Workspace.Positions:GetChildren() do
&#9;&#9;&#9;&#9;&#9;temp = v.Name
&#9;&#9;&#9;&#9;&#9;if game.Players[temp].Lap.Value &lt; k.Lap.Value then
&#9;&#9;&#9;&#9;&#9;&#9;mypos = mypos - 1
&#9;&#9;&#9;&#9;&#9;&#9;elseif (game.Players[temp].Lap.Value == k.Lap.Value) and (game.Players[temp].Section.Value &lt; k.Section.Value) then 
&#9;&#9;&#9;&#9;&#9;&#9;mypos = mypos - 1
&#9;&#9;&#9;&#9;&#9;&#9;elseif (game.Players[temp].Lap.Value == k.Lap.Value) and (game.Players[temp].Section.Value == k.Section.Value) and (v.Value &gt; game.Workspace.Positions[k.Name].Value) then 
&#9;&#9;&#9;&#9;&#9;&#9;mypos = mypos - 1
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end 
&#9;&#9;&#9;&#9;k.Position.Value = mypos
&#9;&#9;&#9;&#9;if mypos == 1 then
&#9;&#9;&#9;&#9;k.PlayerGui.ScreenGui.Positioning.Image = &quot;http://www.roblox.com/asset/?id=73543327&quot;
&#9;&#9;&#9;&#9;elseif mypos == 2 then
&#9;&#9;&#9;&#9;k.PlayerGui.ScreenGui.Positioning.Image = &quot;http://www.roblox.com/asset/?id=73543295&quot;
&#9;&#9;&#9;&#9;elseif mypos == 3 then
&#9;&#9;&#9;&#9;k.PlayerGui.ScreenGui.Positioning.Image = &quot;http://www.roblox.com/asset/?id=73543256&quot;
&#9;&#9;&#9;&#9;elseif mypos == 4 then
&#9;&#9;&#9;&#9;k.PlayerGui.ScreenGui.Positioning.Image = &quot;http://www.roblox.com/asset/?id=73543238&quot;
&#9;&#9;&#9;&#9;elseif mypos == 5 then
&#9;&#9;&#9;&#9;k.PlayerGui.ScreenGui.Positioning.Image = &quot;http://www.roblox.com/asset/?id=73543224&quot;
&#9;&#9;&#9;&#9;elseif mypos == 6 then
&#9;&#9;&#9;&#9;k.PlayerGui.ScreenGui.Positioning.Image = &quot;http://www.roblox.com/asset/?id=73543196&quot;
&#9;&#9;&#9;&#9;elseif mypos == 7 then
&#9;&#9;&#9;&#9;k.PlayerGui.ScreenGui.Positioning.Image = &quot;http://www.roblox.com/asset/?id=73543181&quot;
&#9;&#9;&#9;&#9;elseif mypos == 8 then
&#9;&#9;&#9;&#9;k.PlayerGui.ScreenGui.Positioning.Image = &quot;http://www.roblox.com/asset/?id=73543122&quot;
&#9;&#9;&#9;end 
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;wait()
&#9;until game.Workspace.Racing.Value == false 
bleh = false
end
end 
end)</ProtectedString>
				</Properties>
