				<Item class="LocalScript" referent="RBX839">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">LocalScript</string>
						<ProtectedString name="Source">spectating = false 
local cam = workspace.CurrentCamera

function onButtonClicked()
if spectating == false then
spectating = true
script.Parent.BackgroundColor3 = Color3.new(0.4, 1, 1)
cam.CameraSubject = game.Workspace.Camlol
cam.CoordinateFrame = CFrame.new(-44, 46.2, -15)
cam.Focus = CFrame.new(52, 45, -15)
cam.CameraType = &quot;Fixed&quot;
else
spectating = false
script.Parent.BackgroundColor3 = Color3.new(0.8, 0.8, 0.8)
cam.CameraSubject = game.Players.LocalPlayer.Character.Humanoid
cam.CameraType = &quot;Custom&quot;
if game.Workspace:findFirstChild(&quot;Karts&quot;) then
if game.Workspace.Karts:findFirstChild(script.Parent.Parent.Parent.Parent.Name) then
cam.CoordinateFrame = game.Players.LocalPlayer.Character.Head.CFrame + Vector3.new(12, 6, 0)
cam.CameraType = &quot;Follow&quot; 
end
end
end
end

script.Parent.MouseButton1Click:connect(onButtonClicked)</ProtectedString>
