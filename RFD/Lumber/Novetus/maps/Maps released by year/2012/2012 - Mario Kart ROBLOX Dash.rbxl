				<Item class="Script" referent="RBX6904">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Animate</string>
						<ProtectedString name="Source">script.Parent.Lid.CFrame = script.Parent.Lid.CFrame + Vector3.new(0, -3.6, 0)
script.Parent.Rocky.CFrame = script.Parent.Rocky.CFrame + Vector3.new(0, -2.8, 0)
wait(math.random(1,20))
while true do
script.Parent.Lid.CFrame = script.Parent.Lid.CFrame + Vector3.new(0, 0.8, 0)
script.Parent.Rocky.Face1.Transparency = 0
script.Parent.Rocky.Face2.Transparency = 0
wait(2.5)
script.Parent.Lid.CFrame = script.Parent.Lid.CFrame + Vector3.new(0, -0.8, 0)
script.Parent.Rocky.Face1.Transparency = 1
script.Parent.Rocky.Face2.Transparency = 1
wait(1)
script.Parent.Rocky.Face1.Transparency = 0
script.Parent.Rocky.Face2.Transparency = 0
script.Parent.Lid.CFrame = script.Parent.Lid.CFrame + Vector3.new(0, 0.8, 0)
for i=1,14 do
script.Parent.Lid.CFrame = script.Parent.Lid.CFrame + Vector3.new(0, 0.2, 0)
script.Parent.Rocky.CFrame = script.Parent.Rocky.CFrame + Vector3.new(0, 0.2, 0)
wait()
end
script.Parent.Rocky.Able.Value = true
wait(2.5)
script.Parent.Rocky.Able.Value = false
for i=1,14 do
script.Parent.Lid.CFrame = script.Parent.Lid.CFrame + Vector3.new(0, -0.2, 0)
script.Parent.Rocky.CFrame = script.Parent.Rocky.CFrame + Vector3.new(0, -0.2, 0)
wait()
end
script.Parent.Lid.CFrame = script.Parent.Lid.CFrame + Vector3.new(0, -0.8, 0)
script.Parent.Rocky.Face1.Transparency = 1
script.Parent.Rocky.Face2.Transparency = 1
wait(7)
end
</ProtectedString>
					</Properties>
				</Item>
			</Item>
