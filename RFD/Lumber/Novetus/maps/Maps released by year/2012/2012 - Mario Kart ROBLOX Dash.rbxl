body.Shape = &quot;Cylinder&quot;
body.Size = Vector3.new(6, 6, 6)
body.BrickColor = BrickColor.new(&quot;Black&quot;)
body.TopSurface = &quot;Smooth&quot;
body.Anchored = true
body.CanCollide = false
front = Instance.new(&quot;Part&quot;, script.Parent)
front.Name = &quot;Front&quot;
front.Shape = &quot;Ball&quot;
front.Size = Vector3.new(6, 6, 6)
front.BrickColor = BrickColor.new(&quot;Black&quot;)
front.TopSurface = &quot;Smooth&quot;
front.Anchored = true
front.CanCollide = false
groupy = Instance.new(&quot;Model&quot;, script.Parent)
groupy.Name = &quot;Rocket&quot;
body.Parent = groupy
front.Parent = groupy
body.CFrame = script.Parent.Shooter.CFrame + Vector3.new(6, 0, 0)
a = script.Move:Clone()
a.Parent = body
a.Disabled = false
b = script.Hazard:Clone()
b.Parent = body
b.Disabled = false 
end

while true do
for i=1,24 do
