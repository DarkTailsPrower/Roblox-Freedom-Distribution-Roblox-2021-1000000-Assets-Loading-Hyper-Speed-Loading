					<Item class="Script" referent="RBX6948">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Burn</string>
							<ProtectedString name="Source">script.Parent.Touched:connect(function(hit) 
if hit.Parent:findFirstChild(&quot;Humanoid&quot;) then
a = hit.Parent
if a:findFirstChild(&quot;Hit&quot;) == nil then
Instance.new(&quot;ObjectValue&quot;, a).Name = &quot;Hit&quot;
game.Workspace.Karts[a.Name].VehicleSeat.Script.Dash.Value = -1
game.Workspace.Karts[a.Name].VehicleSeat.MaxSpeed = 0
effect = Instance.new(&quot;Explosion&quot;)
effect.Parent = game.Workspace
effect.BlastPressure = 0
effect.BlastRadius = 3
effect.Position = script.Parent.Position - Vector3.new(0, 8, 0)
wait(1.5)
a.Hit:Remove()
game.Workspace.Karts[a.Name].VehicleSeat.Script.Dash.Value = 0
game.Workspace.Karts[a.Name].VehicleSeat.MaxSpeed = game.Workspace.Karts[a.Name].VehicleSeat.Speed.Value 
end
end
end) </ProtectedString>
						</Properties>
