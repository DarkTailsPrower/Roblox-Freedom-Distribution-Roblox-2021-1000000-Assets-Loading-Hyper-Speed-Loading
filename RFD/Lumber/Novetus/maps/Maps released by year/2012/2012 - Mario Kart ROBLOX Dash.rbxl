						<ProtectedString name="Source">script.Parent.Touched:connect(function(hit)
&#9;if hit.Parent:findFirstChild(&quot;Humanoid&quot;) then
&#9;&#9;a = hit.Parent.Name
&#9;&#9;if (game.Players[a]:findFirstChild(&quot;Section&quot;).Value == 6) or (game.Players[a]:findFirstChild(&quot;Section&quot;).Value == 8) then
&#9;&#9;&#9;game.Players[a]:findFirstChild(&quot;Section&quot;).Value = 7
&#9;&#9;end
&#9;end
end)</ProtectedString>
