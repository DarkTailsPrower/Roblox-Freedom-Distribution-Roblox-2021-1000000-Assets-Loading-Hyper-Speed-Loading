function onButtonClicked()
if (script.Parent.Parent.Voted.Value == false) and (script.Parent.Parent.Chosen.Value ~= &quot;&quot;) then
script.Parent.Parent.Voted.Value = true
game.Workspace.Votes[script.Parent.Parent.Chosen.Value].Value = game.Workspace.Votes[script.Parent.Parent.Chosen.Value].Value + 1
script.Parent.BackgroundColor3 = Color3.new(.5, 1, .5)
script.Parent.Text = &quot;Voted!&quot;
wait(2)
for i=1,23 do
script.Parent.Parent.Position = script.Parent.Parent.Position + UDim2.new(0, 0, 0.04, 0)
wait()
end 
script.Parent.Parent.Parent.Info.Visible = true
end
end

