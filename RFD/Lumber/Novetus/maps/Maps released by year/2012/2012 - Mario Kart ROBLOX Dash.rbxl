			<Item class="Script" referent="RBX6591">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">game.Lighting.FogEnd = 250
game.Lighting.FogColor = Color3.new(.85, .85, .85)
script.Parent.Sky.Parent = game.Lighting
game.Lighting.TimeOfDay = &quot;14:00:00&quot;
wait(360)
game.Workspace.CurrentRacers.Value = 0
wait()
game.Workspace.Info.Value = &quot;Time is up!&quot;</ProtectedString>
				</Properties>
			</Item>
