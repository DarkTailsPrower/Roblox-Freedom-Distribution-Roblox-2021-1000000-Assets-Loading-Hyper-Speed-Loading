					<Item class="Script" referent="RBX4325">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">GiveItem</string>
							<ProtectedString name="Source">obtainable = true

script.Parent.Touched:connect(function(hit)
&#9;if obtainable == true then
&#9;&#9;if hit.Parent:findFirstChild(&quot;Humanoid&quot;) then
&#9;&#9;&#9;a = hit.Parent.Name
&#9;&#9;&#9;if game.Players[a]:findFirstChild(&quot;Roullete&quot;).Value == false then
&#9;&#9;&#9;game.Players[a]:findFirstChild(&quot;Roullete&quot;).Value = true
&#9;&#9;&#9;obtainable = false
&#9;&#9;&#9;script.Parent.Transparency = 1
&#9;&#9;&#9;script.Parent.Parent.Question.Decal1.Transparency = 1
&#9;&#9;&#9;script.Parent.Parent.Question.Decal2.Transparency = 1
&#9;&#9;&#9;wait(5)
&#9;&#9;&#9;for i=1,0,-.01 do
&#9;&#9;&#9;&#9;if i &gt;= 0.4 then
&#9;&#9;&#9;&#9;&#9;script.Parent.Transparency = i
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;script.Parent.Parent.Question.Decal1.Transparency = i
&#9;&#9;&#9;&#9;script.Parent.Parent.Question.Decal2.Transparency = i
&#9;&#9;&#9;&#9;wait()
&#9;&#9;&#9;end
&#9;&#9;&#9;obtainable = true
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end)</ProtectedString>
						</Properties>
					</Item>
				</Item>
