						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">LocalScript</string>
						<ProtectedString name="Source">moving = false
open = false

function onButtonClicked()
if moving == false then
moving = true
if open == false then
script.Parent.BackgroundColor3 = Color3.new(0.4, 1, 1)
for i=1,18 do
wait()
script.Parent.Parent.Info.Position = script.Parent.Parent.Info.Position + UDim2.new(0, 0, -0.05, 0)
script.Parent.Parent.Options.Position = script.Parent.Parent.Options.Position + UDim2.new(0, 0, -0.05, 0) 
end
open = true
elseif open == true then
script.Parent.BackgroundColor3 = Color3.new(0.8, 0.8, 0.8)
for i=1,18 do
wait()
script.Parent.Parent.Info.Position = script.Parent.Parent.Info.Position + UDim2.new(0, 0, 0.05, 0)
script.Parent.Parent.Options.Position = script.Parent.Parent.Options.Position + UDim2.new(0, 0, 0.05, 0)
end
open = false
end
moving = false 
end
end

script.Parent.MouseButton1Click:connect(onButtonClicked)</ProtectedString>
