game.Workspace.Karts[player.Name].Exhaust2.Fire.Enabled = true 
repeat
time = time - 0.2
wait(.2)
until time &lt;= 0 
game.Workspace.Karts[player.Name].VehicleSeat.MaxSpeed = game.Workspace.Karts[player.Name].VehicleSeat.Speed.Value 
