			<Item class="Script" referent="RBX833">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">player = script.Parent.Parent.Parent
wait(1)
player.Roullete.Value = false 
player.Lap.Value = 0
oldone = 0

function itemScroll()
repeat
cycle = math.random(1,9)
until cycle ~= oldone
if cycle == 1 then
script.Parent.Item.ItemImage.Image = &quot;http://www.roblox.com/asset/?id=42283863&quot; -- Mushroom
elseif cycle == 2 then
script.Parent.Item.ItemImage.Image = &quot;http://www.roblox.com/asset/?id=73582494&quot; -- Triple Mushroom
elseif cycle == 3 then
script.Parent.Item.ItemImage.Image = &quot;http://www.roblox.com/asset/?id=73582521&quot; -- Golden Mushroom
elseif cycle == 4 then
script.Parent.Item.ItemImage.Image = &quot;http://www.roblox.com/asset/?id=71770565&quot; -- Banana
elseif cycle == 5 then
script.Parent.Item.ItemImage.Image = &quot;http://www.roblox.com/asset/?id=73858036&quot; -- Triple Banana
elseif cycle == 6 then
script.Parent.Item.ItemImage.Image = &quot;http://www.roblox.com/asset/?id=71770427&quot; -- Green Shell
elseif cycle == 7 then
script.Parent.Item.ItemImage.Image = &quot;http://www.roblox.com/asset/?id=73582476&quot; -- Red Shell
elseif cycle == 8 then
script.Parent.Item.ItemImage.Image = &quot;http://www.roblox.com/asset/?id=73582421&quot; -- Blue Shell
elseif cycle == 9 then
script.Parent.Item.ItemImage.Image = &quot;http://www.roblox.com/asset/?id=73582442&quot; -- Blooper
elseif cycle == 10 then
script.Parent.Item.ItemImage.Image = &quot;http://www.roblox.com/asset/?id=73312162&quot; -- Fake Box
end
oldone = cycle
end 

player.Roullete.Changed:connect(function(box)
if box == true then 
script.Roullete:Play()
plc = player.Position.Value
for i=1,40 do
wait(.05)
itemScroll()
end 
for i=0.05,0.5,0.05 do
wait(i)
itemScroll()
end 
script.Roullete:Stop()
script.Select:Play()
if plc &lt;= 2 then
item = math.random(1,3)
if item == 1 then
game.Lighting.Banana:Clone().Parent = player.Backpack
script.Parent.Item.ItemImage.Image = &quot;http://www.roblox.com/asset/?id=71770565&quot;
elseif item == 2 then
game.Lighting.TripleBanana:Clone().Parent = player.Backpack
script.Parent.Item.ItemImage.Image = &quot;http://www.roblox.com/asset/?id=73858036&quot;
elseif item == 3 then
game.Lighting.FakeItem:Clone().Parent = player.Backpack
script.Parent.Item.ItemImage.Image = &quot;http://www.roblox.com/asset/?id=73312162&quot;
end
elseif plc &lt;= 4 then
item = math.random(1,4)
if item == 1 then
game.Lighting.Banana:Clone().Parent = player.Backpack
script.Parent.Item.ItemImage.Image = &quot;http://www.roblox.com/asset/?id=71770565&quot;
elseif item == 2 then
game.Lighting.Mushroom:Clone().Parent = player.Backpack
