					<Item class="Script" referent="RBX1197">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Destroymeh</string>
							<ProtectedString name="Source">script.Parent.Touched:connect(function(hit)
a = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
if a then
script.Parent.Parent.Name = a.Parent.Name
game.Lighting.DunsJump:Clone().Parent = a.Parent
script.Parent.startSound:Play()
if game.Players[a.Parent.Name].Kart.Value == 1 then
script.Parent.Speed.Value = 40
script.Parent.TurnSpeed = 1.8
script.Parent.Torque = 1.5
script.Parent.Parent.Side1.Transparency = 1
script.Parent.Parent.Side2.Transparency = 1
script.Parent.Parent.Main.BrickColor = game.Players[a.Parent.Name].Colour.Value
script.Parent.Parent.Rest.BrickColor = game.Players[a.Parent.Name].Colour.Value
script.Parent.Parent.Front.Mesh.Scale = Vector3.new(0.5, 1, 1)
script.Parent.Parent.Front.Decal:Remove()
elseif game.Players[a.Parent.Name].Kart.Value == 2 then
script.Parent.Speed.Value = 50
script.Parent.TurnSpeed = 1
script.Parent.Torque = .65
script.Parent.Parent.Front.Mesh.Scale = Vector3.new(2, 1, 1)
script.Parent.Parent.Front.Decal:Remove()
script.Parent.Parent.Exhaust1.Mesh.Scale = Vector3.new(1, 3, 1)
script.Parent.Parent.Exhaust2.Mesh.Scale = Vector3.new(1, 3, 1)
end
script.Parent.Parent.Side1.BrickColor = game.Players[a.Parent.Name].Colour.Value
script.Parent.Parent.Side2.BrickColor = game.Players[a.Parent.Name].Colour.Value
script.Parent.Parent.Front.BrickColor = game.Players[a.Parent.Name].Colour.Value
script.Parent.Anchored = false
script.Parent.Parent.EnginePart.Script.Disabled = false
script:Remove()
end
end)

wait(17)
script.Parent.Parent:Remove()</ProtectedString>
						</Properties>
					</Item>
					<Item class="NumberValue" referent="RBX1198">
						<Properties>
							<string name="Name">Speed</string>
							<double name="Value">45</double>
						</Properties>
					</Item>
					<Item class="Script" referent="RBX1199">
						<Properties>
							<bool name="Disabled">true</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">TerrainCheck</string>
							<ProtectedString name="Source">while true do
wait(.2)
local ray = Ray.new(script.Parent.Position, Vector3.new(0, -3, 0))
local ignore = script.Parent
local part, endPoint = Workspace:FindPartOnRay(ray, ignore)
if part then
print(part.Name)
if (part.Name == &quot;Slow&quot;) then
if (script.Parent.Script.Dash.Value == 0) or (script.Parent.Script.Dash.Value &gt;= 2) then 
script.Parent.MaxSpeed = script.Parent.Speed.Value - 30 
end
elseif (part.Name == &quot;Track&quot;) and (script.Parent.MaxSpeed &lt; 40) and (script.Parent.Script.Dash.Value ~= -1) then 
script.Parent.MaxSpeed = script.Parent.Speed.Value
end
end
end </ProtectedString>
						</Properties>
					</Item>
					<Item class="Script" referent="RBX1200">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">drifting = false
time = 0
faster = 0

game.Workspace.Preparing.Changed:connect(function(ready)
if ready == false then
script.Parent.MaxSpeed = script.Parent.Speed.Value
script.Parent.TerrainCheck.Disabled = false
end
end)

function Drift() 
if drifting == false then
direction = script.Parent.Steer
drifting = true
wait(.75)
if (script.Dash.Value == 0) and (script.Parent.Steer == direction) and (script.Parent.Throttle == 1) then 
script.Parent.Parent.Wheel_BackLeft.Sparkles.Enabled = true
script.Parent.Parent.Wheel_BackRight.Sparkles.Enabled = true
script.Parent.Parent.Wheel_BackLeft.Sparkles.SparkleColor = Color3.new(.25, .25, 1)
script.Parent.Parent.Wheel_BackRight.Sparkles.SparkleColor = Color3.new(.25, .25, 1)
script.Dash.Value = 2
time = 0.5
faster = 7
wait(.75)
if (script.Dash.Value == 2) and (script.Parent.Steer == direction) and (script.Parent.Throttle == 1) then
script.Parent.Parent.Wheel_BackLeft.Sparkles.SparkleColor = Color3.new(1, .5, 0)
script.Parent.Parent.Wheel_BackRight.Sparkles.SparkleColor = Color3.new(1, .5, 0) 
time = 2
faster = 7
else
drifting = false
if script.Dash.Value ~= 1 then
script.Dash.Value = 0
end
script.Parent.Parent.Wheel_BackLeft.Sparkles.Enabled = false
script.Parent.Parent.Wheel_BackRight.Sparkles.Enabled = false
end
else
drifting = false
if script.Dash.Value ~= 1 then
script.Dash.Value = 0
end
script.Parent.Parent.Wheel_BackLeft.Sparkles.Enabled = false
script.Parent.Parent.Wheel_BackRight.Sparkles.Enabled = false
end 
end 
end

function Boost()
if (script.Dash.Dashing.Value == false) and (script.Dash.Value == 2) then 
script.Dash.Dashing.Value = true 
script.Parent.Parent.Wheel_BackLeft.Sparkles.Enabled = false
script.Parent.Parent.Wheel_BackRight.Sparkles.Enabled = false 
script.Parent.Parent.Exhaust1.Fire.Enabled = true 
script.Parent.Parent.Exhaust2.Fire.Enabled = true
script.Parent.MaxSpeed = script.Parent.Speed.Value + faster 
wait(time) 
drifting = false
if script.Dash.Value ~= 1 then
script.Dash.Value = 0
script.Parent.MaxSpeed = script.Parent.Speed.Value 
script.Parent.Parent.Exhaust1.Fire.Enabled = false 
script.Parent.Parent.Exhaust2.Fire.Enabled = false
script.Dash.Dashing.Value = false
end 
end
end

script.Parent.Changed:connect(function(val)
if (script.Parent.Throttle == 1) and (script.Parent.Steer ~= 0) then 
Drift()
elseif (script.Parent.Steer == 0) and (script.Dash.Value == 2) then 
Boost()
end 
end)</ProtectedString>
