			<Item class="LocalScript" referent="RBX8822">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">LocalScript</string>
					<ProtectedString name="Source">wait()
if script.Parent.Parent.Parent.Parent.Lap.Value == 2 then
script.Parent.Image = &quot;http://www.roblox.com/asset/?id=72553144&quot;
elseif script.Parent.Parent.Parent.Parent.Lap.Value == 3 then
script.Parent.Image = &quot;http://www.roblox.com/asset/?id=72553289&quot;
end
for i=1,20 do
script.Parent.Position = script.Parent.Position + UDim2.new(0, 0, 0.02, 0)
wait()
end
for i=1,10 do
script.Parent.Position = script.Parent.Position + UDim2.new(0, 0, 0.01, 0)
wait()
end
for r = 1,3 do
for i=1,10 do
script.Parent.Position = script.Parent.Position + UDim2.new(0, 0, 0.005, 0)
wait()
end
for i=1,10 do
script.Parent.Position = script.Parent.Position + UDim2.new(0, 0, -0.005, 0)
wait()
end
wait()
end 
for i=1,10 do
script.Parent.Position = script.Parent.Position + UDim2.new(0, 0, -0.01, 0)
wait()
end
for i=1,20 do
script.Parent.Position = script.Parent.Position + UDim2.new(0, 0, -0.02, 0)
wait()
end 
script.Parent:Remove()</ProtectedString>
				</Properties>
			</Item>
		</Item>
		<Item class="HopperBin" referent="RBX8823">
			<Properties>
				<bool name="Active">false</bool>
				<token name="BinType">0</token>
				<string name="Name">Banana</string>
				<Content name="TextureId"><url>http://www.roblox.com/asset/?id=71770565</url></Content>
			</Properties>
			<Item class="Script" referent="RBX8824">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">bin = script.Parent
player = bin.Parent.Parent

function onButton1Down(mouse)
if game.Workspace:findFirstChild(&quot;Karts&quot;) then 
player.Roullete.Value = false
print(&quot;Placing Banana&quot;) 
peel = Instance.new(&quot;Part&quot;, game.Workspace)
peel.Name = &quot;Banana&quot;
peel.Size = Vector3.new(1, 2.4, 1)
peel.Anchored = true
peel.CanCollide = false
peel.CFrame = game.Workspace.Karts[player.Name].EnginePart.CFrame + Vector3.new(0, -0.3, 0)
shape = Instance.new(&quot;SpecialMesh&quot;, peel)
shape.MeshId = &quot;http://www.roblox.com/asset/?id=28937301&quot;
shape.TextureId = &quot;http://www.roblox.com/asset/?id=28937670&quot;
shape.Scale = Vector3.new(1.5, 2, 1.5)
whoops = bin.Slip:Clone()
whoops.Parent = peel
whoops.Disabled = false
bin:Remove()
end 
end

function onSelected(mouse)
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end

bin.Selected:connect(onSelected)
</ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX8825">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Slip</string>
					<ProtectedString name="Source">bleh = false

script.Parent.Touched:connect(function(hit)
if bleh == false then
if hit.Parent:findFirstChild(&quot;Humanoid&quot;) then
bleh = true
a = hit.Parent.Name
game.Workspace.Karts[a].VehicleSeat.Script.Dash.Value = -1
game.Workspace.Karts[a].VehicleSeat.MaxSpeed = 0
effect = Instance.new(&quot;Explosion&quot;)
effect.Parent = game.Workspace
effect.BlastPressure = 0
effect.BlastRadius = 3
effect.Position = script.Parent.Position
script.Parent.Transparency = 1
wait(1)
game.Workspace.Karts[a].VehicleSeat.Script.Dash.Value = 0
game.Workspace.Karts[a].VehicleSeat.MaxSpeed = game.Workspace.Karts[a].VehicleSeat.Speed.Value
script.Parent:Remove()
end
end
end)

wait(45)
if bleh == false then
script.Parent:Remove()
end </ProtectedString>
				</Properties>
			</Item>
		</Item>
		<Item class="HopperBin" referent="RBX8826">
			<Properties>
				<bool name="Active">false</bool>
				<token name="BinType">0</token>
				<string name="Name">Blooper</string>
				<Content name="TextureId"><url>http://www.roblox.com/asset/?id=73582442</url></Content>
			</Properties>
			<Item class="Script" referent="RBX8827">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">bin = script.Parent
player = bin.Parent.Parent 

function onButton1Down(mouse) 
bin.Blooper.Place.Value = player.Position.Value
attack = bin.Blooper:Clone()
attack.Parent = game.Workspace
attack.Disabled = false
leave = bin.AnimateLeave:Clone()
leave.Parent = player.PlayerGui.ScreenGui
leave.Disabled = false
player.Roullete.Value = false 
bin:Remove() 
end

function onSelected(mouse)
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end

bin.Selected:connect(onSelected)
</ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX8828">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Blooper</string>
					<ProtectedString name="Source">for i,k in pairs(game.Players:GetPlayers()) do 
if k.Racing.Value == true then
if k.Position.Value &lt; script.Place.Value then
blooper = Instance.new(&quot;ImageLabel&quot;, k.PlayerGui.ScreenGui)
blooper.Name = &quot;Attacker&quot;
blooper.BackgroundTransparency = 1
blooper.Position = UDim2.new(0.4, 0, -0.25, 0)
blooper.Size = UDim2.new(0.2, 0, 0.25, 0)
blooper.Image = &quot;http://www.roblox.com/asset/?id=73582442&quot;
attack = script.AnimateAttack:Clone()
attack.Parent = blooper.Parent
attack.Disabled = false
end
end
end
wait(1)
script:Remove()</ProtectedString>
				</Properties>
				<Item class="Script" referent="RBX8829">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">AnimateAttack</string>
						<ProtectedString name="Source">blooper = script.Parent.Attacker
for i=1,18 do
blooper.Position = blooper.Position + UDim2.new(0, 0, 0.037, 0)
wait()
end 
for r=1,3 do
for i=1,8 do
blooper.Position = blooper.Position + UDim2.new(0, 0, 0.01, 0)
wait()
end 
for i=1,8 do
blooper.Position = blooper.Position + UDim2.new(0, 0, -0.01, 0)
wait()
end 
end
for i=1,12 do
