				<Item class="LocalScript" referent="RBX841">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Woosh</string>
						<ProtectedString name="Source">able = true

function glow()
able = false
repeat
for i = 1,12 do
script.Parent.Size = script.Parent.Size + UDim2.new(0.001, 0, 0.001, 0) 
wait()
end
for i = 1,12 do
script.Parent.Size = script.Parent.Size + UDim2.new(-0.001, 0, -0.001, 0) 
wait()
end
until script.Parent.Image ~= &quot;http://www.roblox.com/asset/?id=73543327&quot;
able = true
end 

script.Parent.Changed:connect(function(pic)
if script.Parent.Image == &quot;http://www.roblox.com/asset/?id=73543327&quot; then
if able == true then
glow()
end
end
end)</ProtectedString>
