effect.Position = script.Parent.Box.Position
script.Parent.Box.Transparency = 1
script.Parent.Question.Decal1.Transparency = 1
script.Parent.Question.Decal2.Transparency = 1
wait(1.5)
game.Workspace.Karts[a].VehicleSeat.Script.Dash.Value = 0
game.Workspace.Karts[a].VehicleSeat.MaxSpeed = game.Workspace.Karts[a].VehicleSeat.Speed.Value
script.Parent:Remove()
end
end
end)

wait(45)
if bleh == false then
script.Parent:Remove()
end </ProtectedString>
