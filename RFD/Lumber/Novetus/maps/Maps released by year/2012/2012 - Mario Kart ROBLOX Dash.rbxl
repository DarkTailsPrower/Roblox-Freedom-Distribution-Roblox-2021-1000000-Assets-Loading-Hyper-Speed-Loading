shoot()
for i=1,24 do
script.Parent.Shooter.CFrame = script.Parent.Shooter.CFrame + Vector3.new(0, 0, 0.5)
script.Parent.Support.CFrame = script.Parent.Support.CFrame + Vector3.new(0, 0, 0.5)
