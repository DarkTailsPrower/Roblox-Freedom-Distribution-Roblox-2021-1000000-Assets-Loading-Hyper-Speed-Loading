function onButtonClicked()
if script.Parent.Parent.Voted.Value == false then
a = math.random(1,7)
if a == 1 then
script.Parent.Parent.Chosen.Value = &quot;One&quot;
elseif a == 2 then
script.Parent.Parent.Chosen.Value = &quot;Two&quot;
elseif a == 3 then
script.Parent.Parent.Chosen.Value = &quot;Three&quot;
elseif a == 4 then
script.Parent.Parent.Chosen.Value = &quot;Four&quot;
elseif a == 5 then
script.Parent.Parent.Chosen.Value = &quot;Five&quot;
elseif a == 6 then
script.Parent.Parent.Chosen.Value = &quot;Six&quot;
elseif a == 6 then
script.Parent.Parent.Chosen.Value = &quot;Seven&quot;
end
script.Parent.Parent.Selected.Text = &quot;? Random Track ?&quot;
script.Parent.Parent.Track.Image = &quot;http://www.roblox.com/asset/?id=71757816&quot;
end
end

