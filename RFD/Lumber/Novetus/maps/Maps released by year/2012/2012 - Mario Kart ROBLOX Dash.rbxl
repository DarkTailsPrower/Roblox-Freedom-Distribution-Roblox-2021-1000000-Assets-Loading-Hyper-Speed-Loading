				<Item class="Script" referent="RBX37">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">value = script.Parent.Parent.Number

function OnClicked()
if value.Value ==-1 then
value.Value = 0
script.Parent.Parent.Name = &quot;Welcome to my Talking person (Click to read more)&quot;
elseif value.Value == 0 then 
value.Value = 1
script.Parent.Parent.Name = &quot;This is a test of a click talk humonoid (Click to read more)&quot;
elseif value.Value == 1 then 
value.Value = 2
script.Parent.Parent.Name = &quot;Simply Just change the text in this script (Click to read more)&quot;
elseif value.Value == 2 then 
value.Value = 3
script.Parent.Parent.Name = &quot;The you just have to click the torso (Click to read more)&quot;
elseif value.Value == 3 then 
value.Value = 4
script.Parent.Parent.Name = &quot;And the text will appear (Click to read more)&quot;
elseif value.Value == 4 then 
value.Value = 5
script.Parent.Parent.Name = &quot;Click the torso again for the next text (Click to read more)&quot;
elseif value.Value == 5 then 
value.Value = 6
script.Parent.Parent.Name = &quot;It&apos;s as easy as that (Click to read more)&quot;
elseif value.Value == 6 then 
value.Value = 7
script.Parent.Parent.Name = &quot;(Delete and change this)1&quot;
value.Value = 8
script.Parent.Parent.Name = &quot;(Delete and change this)2&quot;
elseif value.Value == 8 then 
value.Value = 9
script.Parent.Parent.Name = &quot;(Delete and change this)3&quot;
elseif value.Value == 9 then 
value.Value = -1
script.Parent.Parent.Name = &quot;~End~&quot;
end
end

script.Parent.ClickDetector.MouseClick:connect(OnClicked)</ProtectedString>
