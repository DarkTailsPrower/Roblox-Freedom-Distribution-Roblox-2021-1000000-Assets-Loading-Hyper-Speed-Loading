			<Item class="Script" referent="RBX1495">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Movement</string>
					<ProtectedString name="Source">while true do
wait(5)
script.Parent.Shadow.CFrame = script.Parent.Shadow.CFrame + Vector3.new(.25,0,0)
script.Parent.Thwomp.CFrame = script.Parent.Thwomp.CFrame + Vector3.new(.25,0,0)
wait(.05)
for i=1,20 do
script.Parent.Shadow.CFrame = script.Parent.Shadow.CFrame - Vector3.new(.5,0,0)
script.Parent.Thwomp.CFrame = script.Parent.Thwomp.CFrame - Vector3.new(.5,0,0)
wait()
script.Parent.Shadow.CFrame = script.Parent.Shadow.CFrame + Vector3.new(.5,0,0)
script.Parent.Thwomp.CFrame = script.Parent.Thwomp.CFrame + Vector3.new(.5,0,0)
wait()
end 
script.Parent.Shadow.CFrame = script.Parent.Shadow.CFrame - Vector3.new(.25,0,0)
script.Parent.Thwomp.CFrame = script.Parent.Thwomp.CFrame - Vector3.new(.25,0,0)
for i=1,8 do 
script.Parent.Thwomp.CFrame = script.Parent.Thwomp.CFrame - Vector3.new(0,1.2,0)
wait()
end 
wait(3)
for i=1,16 do 
script.Parent.Thwomp.CFrame = script.Parent.Thwomp.CFrame + Vector3.new(0,.6,0)
wait()
end 
end </ProtectedString>
