					<string name="Name">LocalScript</string>
					<ProtectedString name="Source">wait(2)

game.Workspace.Info.Changed:connect(function(val)
script.Parent.Info.Text = val
if val == &quot;The Race Will Now Start!&quot; then
script.Parent.Info.TextColor3 = Color3.new(.5,.5,.5)
for up=1,-0.05,-0.05 do
script.Parent.Frame.BackgroundTransparency = up
wait()
end
elseif val == &quot;Ready!&quot; then
script.Parent.Info.TextColor3 = Color3.new(1,1,1)
for down=0,1.05,0.05 do
script.Parent.Frame.BackgroundTransparency = down
wait()
end
elseif val == &quot;Get In Your Karts!&quot; then
script.Parent.Frame.BackgroundTransparency = 1
script.Parent.Info.TextColor3 = Color3.new(1,1,1)
end
end)

script.Parent.Parent.Parent.Roullete.Changed:connect(function(item)
if item == true then
for i=0,10 do
script.Parent.Item.Position = script.Parent.Item.Position + UDim2.new(0, 0, 0, 16)
wait()
end
else
for i=0,10 do
script.Parent.Item.Position = script.Parent.Item.Position + UDim2.new(0, 0, 0, -16)
wait()
end
end
end)

script.Parent.Parent.Parent.Lap.Changed:connect(function(lap)
if lap ~= 4 and lap ~= 0 then
for i = 1,10 do
script.Parent.Laps.Text = &quot;Lap: #/3&quot;
wait(.1)
script.Parent.Laps.Text = &quot;Lap: &quot;..lap..&quot;/3&quot;
wait(.1)
end
end
end)</ProtectedString>
				</Properties>
