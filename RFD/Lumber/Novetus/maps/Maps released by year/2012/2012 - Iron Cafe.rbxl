		</Item>
		<Item class="Script" referent="RBX359">
			<Properties>
				<bool name="Disabled">true</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">VIPHat</string>
				<string name="Source">local ChatLocalization = {}

function ChatLocalization:Get(key,default)
  local rtv = default
  pcall(function()
		local LocalizationService = game:GetService(&quot;LocalizationService&quot;)
			rtv = game:GetService(&quot;Chat&quot;).ChatLocalization:GetString(LocalizationService.RobloxLocaleId, key)
	end)
	return rtv
end

return ChatLocalization</string>
