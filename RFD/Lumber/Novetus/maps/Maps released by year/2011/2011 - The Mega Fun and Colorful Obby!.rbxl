					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Lava</string>
						<ProtectedString name="Source">function onTouched(hit)
&#9;human = hit.Parent:FindFirstChild(&quot;Humanoid&quot;) -- returns &quot;Humanoid&quot; if exists, else returns nil
&#9;if human ~= nil then     -- if the toucher is human, then
&#9;&#9;human:TakeDamage(human.MaxHealth) -- damage the human
&#9;end
end

script.Parent.Touched:connect(onTouched)</ProtectedString>
					</Properties>
				</Item>
			</Item>
		</Item>
