					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">--iBlocker

a = script.Parent.sb

while true do
a.Adornee = script.Parent
a.Color = script.Parent.BrickColor
wait(0.5)
end
</ProtectedString>
				</Properties>
			</Item>
