			<Item class="Script" referent="RBX8838">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">function onTouch(part)
        local humanoid = part.Parent:FindFirstChild(&quot;Humanoid&quot;)
        if (humanoid ~= nil) then
        wait(0.2) -- Can be editted if you change the size or if your place is laggy
        script.Parent.CanCollide = false
        script.Parent.Transparency = 1
        wait(5) -- Can be editted if you want, kinda pointless thought but if you want them to respawn quicker then feel free to. 
        script.Parent.CanCollide = true
        script.Parent.Transparency = 0
       end
end

script.Parent.Touched:connect(onTouch)
</ProtectedString>
				</Properties>
			</Item>
		</Item>
