					<string name="Name">RackScript</string>
					<ProtectedString name="Source">local board = script.Parent.SkateTool:Clone()

while true do 

&#9;wait(5)

&#9;if (script.Parent:FindFirstChild(&quot;SkateTool&quot;) == nil) then
&#9;&#9;
&#9;&#9;local c = board:Clone()
&#9;&#9;c.Parent = script.Parent

&#9;end

end</ProtectedString>
