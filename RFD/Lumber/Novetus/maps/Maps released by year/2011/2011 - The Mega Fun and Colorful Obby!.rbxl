							<string name="Name">WalkSpeed Changer </string>
							<ProtectedString name="Source">debounce = true

function onTouched(hit)
&#9;local h = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;if (h ~= nil and debounce == true) then
&#9;&#9;debounce = false
&#9;&#9;h.WalkSpeed = 5
&#9;&#9;wait(1)
&#9;&#9;debounce = true
&#9;end
end

script.Parent.Touched:connect(onTouched)</ProtectedString>
