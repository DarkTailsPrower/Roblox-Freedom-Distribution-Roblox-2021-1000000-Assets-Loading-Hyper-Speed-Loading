							<R22>1</R22>
						</CoordinateFrame>
						<string name="Name">d&#229;&#229;&#229;&#229;&#229;&#229;&#229;&#229;&#229;&#229;&#229;&#229;&#229;&#229;ng.........you got owned...</string>
						<Ref name="Part0">null</Ref>
