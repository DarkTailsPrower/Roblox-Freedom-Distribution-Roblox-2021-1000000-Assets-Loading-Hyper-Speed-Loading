if msg:sub(chk1+1):lower() == &quot;batman&quot; then teststr = [[BrickColor.new(&quot;Really black&quot;) local dec = Instance.new(&quot;Decal&quot;, p) dec.Face = 2 dec.Texture = &quot;http://www.roblox.com/asset/?id=108597669&quot;]] end
