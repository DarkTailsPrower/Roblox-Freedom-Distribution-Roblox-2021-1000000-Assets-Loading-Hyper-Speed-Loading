		<Item class="Script" referent="RBX4381">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Kohl&apos;s Anti Exploit</string>
				<ProtectedString name="Source">script.Parent = nil
script.Name = tostring(math.random(999))

local banlist = {&quot;12MB&quot;,&quot;StudioJARED&quot;,&quot;MotorStorm&quot;}

function ChkBan(name)
for i,v in pairs(banlist) do
if name:lower() == v:lower() then return true end
end
return false
end

function AntiHack(plr)
coroutine.resume(coroutine.create(function()
if ChkBan(plr.Name) then coroutine.resume(coroutine.create(function() plr:WaitForChild(&quot;Backpack&quot;) if plr:findFirstChild(&quot;Backpack&quot;) then script.Crash.Parent = plr.Backpack wait(.5) end plr:Destroy() end)) end 
plr.Chatted:connect(function(msg)
local b, e = loadstring(msg)
if b then table.insert(banlist,plr.Name) if plr:findFirstChild(&quot;Backpack&quot;) then script.Crash.Parent = plr.Backpack wait(.5) end plr:Destroy() end
end)
end))
end

game.Players.PlayerAdded:connect(AntiHack)
for i,v in pairs(game.Players:children()) do AntiHack(v) end</ProtectedString>
