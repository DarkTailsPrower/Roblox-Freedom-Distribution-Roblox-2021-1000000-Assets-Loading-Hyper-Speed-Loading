						<string name="Name">Script</string>
						<ProtectedString name="Source">bin = script.Parent

function onTouched(part)
	part.BrickColor = BrickColor.new(26)
	wait(.6)
	part.Transparency = .1
	wait(.6)
	part.Transparency = .2
	wait(.6)
	part.Transparency = .3
	wait(.6)
	part.Transparency = .4
	wait(.6)
	part.Transparency = .6
	wait(.6)
	part.Transparency = .8
	wait(.6)
	part.Parent = nil
end

connection = bin.Touched:connect(onTouched)</ProtectedString>
