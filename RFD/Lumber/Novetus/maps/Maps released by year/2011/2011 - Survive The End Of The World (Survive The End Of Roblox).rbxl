									<float name="Transparency">0</float>
									<Vector3 name="Velocity">
										<X>0</X>
										<Y>0</Y>
										<Z>0</Z>
									</Vector3>
									<bool name="archivable">true</bool>
									<token name="shape">1</token>
									<Vector3 name="size">
										<X>3</X>
										<Y>25.2000008</Y>
										<Z>3</Z>
