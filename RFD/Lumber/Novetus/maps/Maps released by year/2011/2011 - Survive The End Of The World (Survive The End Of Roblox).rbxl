					<Properties>
						<bool name="Looped">false</bool>
						<string name="Name">MoneySound2</string>
						<float name="Pitch">1</float>
						<bool name="PlayOnRemove">false</bool>
						<Content name="SoundId"><url>http://www.roblox.com/asset/?id=16720502</url></Content>
						<float name="Volume">1</float>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
				<Item class="Sound" referent="RBX5738">
					<Properties>
						<bool name="Looped">false</bool>
						<string name="Name">MoneySound3</string>
						<float name="Pitch">1</float>
						<bool name="PlayOnRemove">false</bool>
						<Content name="SoundId"><url>http://www.roblox.com/asset/?id=16720508</url></Content>
