							<ProtectedString name="Source">person = script.Parent.Parent.Parent.Parent
function MouseButton1Down(x,y)
script.Parent.Visible = false
script.Parent.Parent.Parent.Open.Visible = true
script.Parent.Parent.Parent.Stuff.Visible = false
--if person.Character.Torso.roblox.Texture == &quot;http://www.roblox.com/asset/?id=26655641&quot; then
--script.Parent.Parent.VIP.Visible = true
--end
end
script.Parent.MouseButton1Down:connect(MouseButton1Down)</ProtectedString>
