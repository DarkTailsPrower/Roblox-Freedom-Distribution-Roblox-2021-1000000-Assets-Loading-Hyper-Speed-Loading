		h.Health = h.Health -3
		wait(.1)
		h.Health = h.Health -3
		wait(.1)
		h.Health = h.Health -3
		wait(.1)
		h.Health = h.Health -10
wait(.1)
	end
end

script.Parent.Touched:connect(onTouched)


