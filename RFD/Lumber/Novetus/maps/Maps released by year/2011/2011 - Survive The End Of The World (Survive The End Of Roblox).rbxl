					<R11>0.99998641</R11>
					<R12>-0.00521730399</R12>
					<R20>0.0105794081</R20>
					<R21>-0.00521701202</R21>
					<R22>-0.999930441</R22>
				</CoordinateFrame>
				<string name="Name">GrannysCrossBow</string>
				<Content name="TextureId"><url>http://www.roblox.com/asset/?id=16973292</url></Content>
