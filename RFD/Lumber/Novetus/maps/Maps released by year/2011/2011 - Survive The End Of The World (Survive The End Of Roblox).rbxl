					<string name="Name">LocalScript</string>
					<ProtectedString name="Source">local Tool = script.Parent
local blow = nil

local sound = Instance.new(&quot;Sound&quot;)
sound.Parent  = Tool.Handle
local sounds = {&quot;29029134&quot;,&quot;29029143&quot;,&quot;29029154&quot;,&quot;29029170&quot;,&quot;29029176&quot;}
sound.Volume = 0.01

for i = 1, #sounds do
	sound.SoundId = &quot;http://www.roblox.com/asset/?id=&quot; .. sounds[i]
	sound:Play()	
end

sound:Stop()
sound.Volume = 0.5

function onEquipped()
	sound:Stop()
	blow = Tool.Parent:FindFirstChild(&quot;Humanoid&quot;):LoadAnimation(Tool.hornblow)
end

function unEquipped()

	blow:remove()	sound:Stop()

end

local enabled = false

function onActivated()

	if enabled then
		return
	end

	enabled = true

	blow:Play()
	sound.SoundId = &quot;http://www.roblox.com/asset/?id=&quot; .. sounds[math.random(1,#sounds)]
	sound.Pitch = math.random(0.7,1)
	sound:Play()

	wait(1)

	enabled = false

end

Tool.Activated:connect(onActivated)
Tool.Equipped:connect(onEquipped)
Tool.Unequipped:connect(onUnequipped)

