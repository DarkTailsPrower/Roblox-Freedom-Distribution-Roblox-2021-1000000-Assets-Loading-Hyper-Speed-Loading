					<bool name="archivable">true</bool>
				</Properties>
				<Item class="Script" referent="RBX2333">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">secs</string>
						<ProtectedString name="Source">while true do
wait(1) 
script.Parent.Value = script.Parent.Value +1
if script.Parent.Value &gt;= 60 then 
script.Parent.Value = script.Parent.Value - 60 
script.Parent.Parent.Minutes.Value = script.Parent.Parent.Minutes.Value +1
end

end

</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
