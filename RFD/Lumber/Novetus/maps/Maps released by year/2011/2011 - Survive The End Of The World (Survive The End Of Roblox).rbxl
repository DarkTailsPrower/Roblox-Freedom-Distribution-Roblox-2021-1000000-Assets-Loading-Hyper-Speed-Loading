			<Item class="Script" referent="RBX7885">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">SnowballLauncher</string>
					<ProtectedString name="Source">Tool = script.Parent
VELOCITY = 50 -- constant
loaded=false

local Pellet = Instance.new(&quot;Part&quot;)
Pellet.Size = Vector3.new(1,1,1)
Pellet.Shape = 0
Pellet.BrickColor = BrickColor.new(&quot;Institutional white&quot;)
Pellet.Material = Enum.Material.Concrete
Pellet.Locked = true
Pellet.TopSurface = 0
Pellet.BottomSurface = 0

script.Parent.SnowballScript:clone().Parent = Pellet





function fire(v, turbo)


-- find player&apos;s head pos

	local vCharacter = Tool.Parent
	local vPlayer = game.Players:playerFromCharacter(vCharacter)

	local head = vCharacter:findFirstChild(&quot;Head&quot;)
	if head == nil then return end

	Tool.Handle.Fire:Play()

	local launch = head.Position + 10 * v

	local missile = Pellet:clone()
    
	missile.Position = launch
	missile.Velocity = v * 100


	local force = Instance.new(&quot;BodyForce&quot;)
	force.force = Vector3.new(0,85,0)
	force.Parent = missile

	missile.SnowballScript.Disabled = false


	missile.Parent = game.Workspace

end

function gunUp()
	Tool.GripForward = Vector3.new(0,.981,-.196)
	Tool.GripRight = Vector3.new(1,0,0)
	Tool.GripUp = Vector3.new(0,.196,.981)
end

function gunOut()
	Tool.GripForward = Vector3.new(0,1,0)
	Tool.GripRight = Vector3.new(1,0,0)
	Tool.GripUp = Vector3.new(0,0,1)
end


enabled = true
function onActivated()
	if not enabled  then
		return
	end

	enabled = false


	local character = Tool.Parent;
	local humanoid = character.Humanoid
	if humanoid == nil then
		print(&quot;Humanoid not found&quot;)
		return 
	end

	local targetPos = humanoid.TargetPoint
	local lookAt = (targetPos - character.Head.Position).unit

	local reload = .1


	gunUp()
	fire(lookAt)
	wait(reload)
	gunOut()
	wait(reload)

	enabled = true

end

script.Parent.Activated:connect(onActivated)
</ProtectedString>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX7886">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">SnowballScript</string>
					<ProtectedString name="Source">arrow = script.Parent


debris = game:GetService(&quot;Debris&quot;)



local hitsounds = {&quot;19326853&quot;, &quot;19326880&quot;, &quot;19326891&quot;}
local flakes = {&quot;19003948&quot;, &quot;19003957&quot;, &quot;19003971&quot;, &quot;19003978&quot;, &quot;19003982&quot;, &quot;19003990&quot;, &quot;19003998&quot;}
local globs = {&quot;19323823&quot;, &quot;19323854&quot;}

local HitSound = Instance.new(&quot;Sound&quot;)
HitSound.SoundId = &quot;http://www.roblox.com/asset/?id=&quot; .. hitsounds[math.random(1,#hitsounds)]
HitSound.Parent = arrow
HitSound.Volume = 1

function Snowface(p)
	

	local guiMain = Instance.new(&quot;GuiMain&quot;) 
	guiMain.Parent = p.PlayerGui 
	local mainFrame = Instance.new(&quot;Frame&quot;) 
	mainFrame.Name = &quot;SnowfaceEffect&quot;
	mainFrame.Position = UDim2.new(0, 0, 0, 0) 
	mainFrame.Size = UDim2.new(1, 0, 1, 0) 
	mainFrame.BackgroundColor = BrickColor.new(1,1,1)
	mainFrame.Transparency = 1
	mainFrame.BorderColor = BrickColor.new(1,1,1)
	mainFrame.Parent = guiMain

	debris:AddItem(guiMain, 10)

	--- big glob
	local s = Instance.new(&quot;ImageLabel&quot;)
	local size = (math.random() * .2) + .5
	s.Size = UDim2.new(size,0,size,0)
	s.Position = UDim2.new(math.random() - (size/2),0, math.random() - (size/2),0)
	s.SizeConstraint = Enum.SizeConstraint.RelativeXX
	s.Transparency = 1
	s.Image = &quot;http://www.roblox.com/asset/?id=&quot; .. globs[math.random(1, #globs)]
	s.Parent = mainFrame

	debris:AddItem(s, 5 + (math.random() * 2))

	--flakes
	for i=1,20 do

		local s = Instance.new(&quot;ImageLabel&quot;)
		local size = (math.random() * .05) + .05
		s.Size = UDim2.new(size,0,size,0)
		s.Position = UDim2.new(math.random() - (size/2),0, math.random() - (size/2),0)
		s.SizeConstraint = Enum.SizeConstraint.RelativeXX
		s.Transparency = 1
		s.Image = &quot;http://www.roblox.com/asset/?id=&quot; .. flakes[math.random(1, #flakes)]
		s.Parent = mainFrame
		debris:AddItem(s, 3 + (math.random() * 6))
	end


	

end

function Explode()

	local count = 5


	for i=1,count do
		local p = Instance.new(&quot;Part&quot;)
		p.BrickColor = BrickColor.new(&quot;White&quot;)
		p.formFactor = 2
		p.Size = Vector3.new(1,.4,1)
		p.Material = Enum.Material.Ice
		p.TopSurface = 0
		p.BottomSurface = 0
		
		p.Velocity = arrow.Velocity * (4 + (math.random() *2))
		p.RotVelocity = Vector3.new(math.random(-20,20), math.random(-20,20), math.random(-20,20))
		p.Position = arrow.Position + (arrow.Velocity * math.random() * .05) + Vector3.new(0,math.random() * 3, 0)
		p.Parent = game.Workspace

		debris:AddItem(p, 60)
	end

end




function onTouched(hit)

	connection:disconnect()

	

	HitSound:Play()

	if hit.Parent ~= nil then
		humanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
		if humanoid~=nil then
			local p = game.Players:GetPlayerFromCharacter(humanoid.Parent)
			if (p ~= nil) then
				Snowface(p)
			end
		end
	end

	Explode()

	arrow:Remove()

	
end



connection = arrow.Touched:connect(onTouched)

wait(10)

arrow.Parent = nil</ProtectedString>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
			<Item class="LocalScript" referent="RBX7887">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Local Gui</string>
					<ProtectedString name="Source">Tool=script.Parent
function onEquippedLocal(mouse)
	if mouse == nil then
		print(&quot;Mouse not found&quot;)
		return 
	end
	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
end

Tool.Equipped:connect(onEquippedLocal)</ProtectedString>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
		</Item>
		<Item class="Tool" referent="RBX7888">
			<Properties>
				<bool name="Enabled">true</bool>
				<CoordinateFrame name="Grip">
					<X>1.5</X>
					<Y>2.5</Y>
					<Z>0.800000012</Z>
					<R00>1</R00>
					<R01>0</R01>
					<R02>0</R02>
					<R10>0</R10>
					<R11>1</R11>
					<R12>0</R12>
					<R20>0</R20>
					<R21>0</R21>
					<R22>1</R22>
				</CoordinateFrame>
				<string name="Name">SoccerBall</string>
				<Content name="TextureId"><url>http://www.roblox.com/asset/?id=28502279</url></Content>
				<bool name="archivable">true</bool>
			</Properties>
			<Item class="StringValue" referent="RBX7889">
				<Properties>
					<string name="Name">PersonToPassTo</string>
					<string name="Value"></string>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX7890">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">SoccerBallScript</string>
					<ProtectedString name="Source">local Tool = script.Parent
local debris = game:GetService(&quot;Debris&quot;)
local human = nil
local passing = false

Tool.Handle.CanCollide = true

function onTouched(part)

	if passing then
		local pos = Tool.Handle.Position
		Tool.Parent = game.Workspace
		Tool.Handle.Position = pos
		return
	end

	local humanoid = part.Parent:FindFirstChild(&quot;Humanoid&quot;)
	if humanoid ~= nil and humanoid ~= human then

		-- steal the ball!
		Tool.Parent = humanoid.Parent
		wait(0.7)

	end

end


function onEquipped()

	human = Tool.Parent:FindFirstChild(&quot;Humanoid&quot;)
	Tool.Handle.boo:Stop()

	Tool.GripPos = Vector3.new(1.5,-2,0.8)

end

function onUnequipped()

	if Tool.Parent.Name ==  &quot;Backpack&quot; then
		Tool.Handle.boo:Play()
	end

end

function passBallTo(humanoid)

	if humanoid ~= nil and humanoid ~= &quot;changer&quot; then
		passing = true

		local currPlayer = Tool.Parent.Torso
		local lookAt = currPlayer.CFrame.lookVector.unit
		local outFrontBuffer = 5
		local denom = math.abs(lookAt.x) + math.abs(lookAt.z)

		local xPos = (lookAt.x/denom) * outFrontBuffer
		local zPos = (lookAt.Z/denom) * outFrontBuffer

		local bodyPos = Instance.new(&quot;BodyPosition&quot;)
		bodyPos.position = game.Workspace:FindFirstChild(humanoid, false):FindFirstChild(&quot;Right Leg&quot;, false).Position
		bodyPos.P = 2000
		bodyPos.maxForce = Vector3.new(bodyPos.P,bodyPos.P,bodyPos.P)
		debris:AddItem(bodyPos,5)
		wait(0.1)
		local pos = Tool.Handle.Position
		Tool.Parent = game.Workspace
		Tool.Handle.Position = Vector3.new(pos.x + xPos, pos.y, pos.z + zPos)
		bodyPos.Parent = Tool.Handle
		Tool.Handle.kick:Play()
		wait(0.1)

		passing = false
	end

end


Tool.Activated:connect(onActivated)
Tool.Equipped:connect(onEquipped)
Tool.Unequipped:connect(onUnequipped)
Tool.Handle.Touched:connect(onTouched)
Tool.PersonToPassTo.Changed:connect(passBallTo)
</ProtectedString>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
			<Item class="LocalScript" referent="RBX7891">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">LocalScript</string>
					<ProtectedString name="Source">local Tool = script.Parent
local connection = nil
local enabled = true
local human = nil 
local shooting = false
local kick = nil

local debris = game:GetService(&quot;Debris&quot;)

function onButton1Down(mouse)

	if mouse.Target == nil or not enabled then
		return
	end

	enabled = false

		local humanoid = mouse.Target.Parent:FindFirstChild(&quot;Humanoid&quot;)

		-- pass the ball to someone
		if humanoid ~= nil then
			Tool.PersonToPassTo.Value = &quot;changer&quot;
			wait()
			Tool.PersonToPassTo.Value = humanoid.Parent.Name

			kick:Play()
			kick.Stopped:connect(function()
				kick:remove()
			end)

		-- kick the ball
		else
			shooting = true

			kick:Play()
			kick.Stopped:connect(function()
				kick:remove()
			end)

			local targetPos = human.TargetPoint
			local v = (targetPos - Tool.Parent.Head.Position).unit

			local currTorso = Tool.Parent.Torso
			local lookAt = currTorso.CFrame.lookVector.unit
			local outFrontBuffer = 5
			local denom = math.abs(lookAt.x) + math.abs(lookAt.z)

			local xPos = (lookAt.x/denom) * outFrontBuffer
			local zPos = (lookAt.Z/denom) * outFrontBuffer

			wait()
			Tool.Parent = game.Workspace
			Tool.Handle.Position = Vector3.new(Tool.Handle.Position.x + xPos, Tool.Handle.Position.y, Tool.Handle.Position.z + zPos)
			Tool.Handle.Velocity = v * 100
			Tool.Handle.kick:Play()

			wait(0.1)

			shooting = false
		end

	enabled = true

end

function onEquippedLocal(mouse)

	if mouse == nil then
		print(&quot;Mouse not found&quot;)
		return 
	end

	connection = mouse.Button1Down:connect(function() onButton1Down(mouse) end)
	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	
	human = Tool.Parent:FindFirstChild(&quot;Humanoid&quot;)
	kick = human:LoadAnimation(Tool.soccerkick)

end

function onUnequippedLocal()

	connection = nil

end

function onTouched(part)

	if shooting then
		local pos = Tool.Handle.Position
		Tool.Parent = game.Workspace
		Tool.Handle.Position = pos
		return
	end
end

Tool.Handle.Touched:connect(onTouched)
Tool.Equipped:connect(onEquippedLocal)
Tool.Unequipped:connect(onUnequippedLocal)
</ProtectedString>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX7892">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">WeldArm</string>
					<ProtectedString name="Source">Tool = script.Parent;
local arms = nil
local torso = nil
local welds = {}

function Equip(mouse)
wait(0.01)
arms = {Tool.Parent:FindFirstChild(&quot;Left Arm&quot;), Tool.Parent:FindFirstChild(&quot;Right Arm&quot;)}
torso = Tool.Parent:FindFirstChild(&quot;Torso&quot;)
if arms ~= nil and torso ~= nil then
local sh = {torso:FindFirstChild(&quot;Left Shoulder&quot;), torso:FindFirstChild(&quot;Right Shoulder&quot;)}
if sh ~= nil then
local yes = true
if yes then
yes = false
sh[1].Part1 = nil
sh[2].Part1 = nil
local weld1 = Instance.new(&quot;Weld&quot;)
weld1.Part0 = torso
weld1.Parent = torso
weld1.Part1 = arms[1]
weld1.C1 = CFrame.new(1.5,0,0) * CFrame.fromEulerAnglesXYZ(0,0,0)
welds[1] = weld1
local weld2 = Instance.new(&quot;Weld&quot;)
weld2.Part0 = torso
weld2.Parent = torso
weld2.Part1 = arms[2]
weld2.C1 = CFrame.new(-1.5,0,0) * CFrame.fromEulerAnglesXYZ(0,0,0)
welds[2] = weld2
end
else
print(&quot;sh&quot;)
end
else
print(&quot;arms&quot;)
end
end

function Unequip(mouse)
if arms ~= nil and torso ~= nil then
local sh = {torso:FindFirstChild(&quot;Left Shoulder&quot;), torso:FindFirstChild(&quot;Right Shoulder&quot;)}
if sh ~= nil then
local yes = true
if yes then
yes = false
sh[1].Part1 = arms[1]
sh[2].Part1 = arms[2]
welds[1].Parent = nil
welds[2].Parent = nil
end
else
print(&quot;sh&quot;)
end
else
print(&quot;arms&quot;)
end
end
Tool.Equipped:connect(Equip)
Tool.Unequipped:connect(Unequip)
</ProtectedString>
