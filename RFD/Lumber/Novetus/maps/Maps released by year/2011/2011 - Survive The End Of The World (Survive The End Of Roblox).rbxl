							<string name="Name">Decal</string>
							<float name="Shiny">20</float>
							<float name="Specular">0</float>
							<Content name="Texture"><url>http://www.roblox.com/asset/?id=47288626</url></Content>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
					<Item class="IntValue" referent="RBX501">
