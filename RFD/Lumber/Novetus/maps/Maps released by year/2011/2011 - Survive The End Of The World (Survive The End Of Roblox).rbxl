								<string name="Name">9001hp</string>
								<ProtectedString name="Source">debounce = true
function onTouched(hit)
wait(1)
local h = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
if (h ~= nil and debounce == true) then
debounce = false
h.Health = 9001
wait(1)
h.MaxHealth = 9001
debounce = true
end
end
script.Parent.Touched:connect(onTouched)</ProtectedString>
