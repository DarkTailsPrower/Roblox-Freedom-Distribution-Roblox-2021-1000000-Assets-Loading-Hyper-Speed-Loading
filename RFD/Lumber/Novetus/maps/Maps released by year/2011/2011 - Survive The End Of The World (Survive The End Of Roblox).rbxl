			<Item class="LocalScript" referent="RBX7769">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Local Gui</string>
					<ProtectedString name="Source">local Tool = script.Parent
local con = nil
local shootAnim = nil
local reloadAnim = nil

enabled = true
function onButton1Down(mouse)
	if not enabled then
		return
	end

	enabled = false
	Tool.Object.Value = mouse.Target

	if Tool.Object.Value == nil then
		enabled = true
		return
	end
	
	Tool.Reload.Value = 13
	shootAnim:Play()
	mouse.Icon = &quot;rbxasset://textures\\GunWaitCursor.png&quot;
	while Tool.Reload.Value &gt; 1 do
		wait(.5) 								--change this value to shorten the time. ~Taboo206
		Tool.Reload.Value = Tool.Reload.Value - 1
	end
	reloadAnim:Play()
	Tool.Handle.Reload:Play()
	wait(0.5)
	Tool.Reload.Value = 0
	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;

	enabled = true

end

function onEquippedLocal(mouse)

	if mouse == nil then
		print(&quot;Mouse not found&quot;)
		return 
	end

	if enabled then
		mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	else
		mouse.Icon = &quot;rbxasset://textures\\GunWaitCursor.png&quot;
		while Tool.Reload.Value &gt; 0 do
			wait(1)
			Tool.Reload.Value = Tool.Reload.Value - 1
		end
		mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
		enabled = true
	end
	shootAnim = Tool.Parent.Humanoid:LoadAnimation(Tool.rocketkickback)
	reloadAnim = Tool.Parent.Humanoid:LoadAnimation(Tool.rocketreload)
	con = mouse.Button1Down:connect(function() onButton1Down(mouse) end)

end

function onUnequippedLocal()
	shootAnim:stop()
	shootAnim:remove()
	con:disconnect()
end


Tool.Equipped:connect(onEquippedLocal)
Tool.Unequipped:connect(onUnequippedLocal)
</ProtectedString>
