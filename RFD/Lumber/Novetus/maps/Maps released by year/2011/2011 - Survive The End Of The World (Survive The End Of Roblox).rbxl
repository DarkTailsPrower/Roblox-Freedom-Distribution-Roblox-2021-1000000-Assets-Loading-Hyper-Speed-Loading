				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Remove Hats/Gear</string>
				<ProtectedString name="Source">while true do
wait(120)
L = game.Workspace:GetChildren()
for i = 1, #L do
if L[i].className == &quot;Hat&quot; or L[i].className == &quot;Tool&quot; then
L[i]:Remove()
wait(1)
end
end
end
