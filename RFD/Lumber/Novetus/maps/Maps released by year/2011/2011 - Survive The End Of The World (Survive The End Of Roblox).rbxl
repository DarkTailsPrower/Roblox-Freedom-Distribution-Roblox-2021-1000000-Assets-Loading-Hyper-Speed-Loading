		<Item class="Script" referent="RBX369">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">OnSpawnTools</string>
				<ProtectedString name="Source">function teamFromColor(color) 
for _,t in pairs(game:GetService(&quot;Teams&quot;):GetChildren()) do 
if t.TeamColor==color then return t end 
end 
return nil 
end 

function onSpawned(plr)
local tools = teamFromColor(plr.TeamColor):GetChildren() 
for _,c in pairs(tools) do 
c:Clone().Parent = plr.Backpack 
--c:Clone().Parent = plr.StarterGear
end 
end 

function onChanged(prop,plr)
if prop==&quot;Character&quot; then 
onSpawned(plr) 
end 
end 

function onAdded(plr) 
plr.Changed:connect(function(prop)
onChanged(prop,plr) 
end) 
end 

game.Players.PlayerAdded:connect(onAdded) </ProtectedString>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
		<Item class="SpawnLocation" referent="RBX370">
			<Properties>
				<bool name="AllowTeamChangeOnTouch">false</bool>
				<bool name="Anchored">true</bool>
				<float name="BackParamA">-0.5</float>
				<float name="BackParamB">0.5</float>
				<token name="BackSurface">2</token>
