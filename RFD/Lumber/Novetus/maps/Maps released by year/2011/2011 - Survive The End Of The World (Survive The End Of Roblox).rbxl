	weld.Part1 = script.Parent.Parent.Torso

	local HitPos = p[i].Position + (p[i].CFrame.lookVector * .5) 

	local CJ = CFrame.new(HitPos) 
	local C0 = p[i].CFrame:inverse() *CJ 
	local C1 = script.Parent.Parent.Torso.CFrame:inverse() * CJ 

	weld.C0 = C0 
	weld.C1 = C1 

	weld.Parent = p[i]
end
end </ProtectedString>
