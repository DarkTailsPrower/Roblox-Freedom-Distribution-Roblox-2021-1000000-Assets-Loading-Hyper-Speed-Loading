					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Slip</string>
						<ProtectedString name="Source">wait(0.5)
local banana = script.Parent
function onTouched(part)
	local humanoid = part.Parent:FindFirstChild(&quot;Humanoid&quot;)
	if humanoid ~= nil then
		humanoid.Jump = true
		humanoid.Sit = true
		wait(5)
		humanoid.Sit = false
end
end
banana.Touched:connect(onTouched)
</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
