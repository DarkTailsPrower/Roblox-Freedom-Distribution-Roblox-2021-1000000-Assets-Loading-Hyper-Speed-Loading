					<string name="Name">SUPERVIP Badge</string>
					<ProtectedString name="Source">BadgeID = 47288723
Texture = &quot;http://www.roblox.com/asset/?id=24074629&quot;
game.Players.PlayerAdded:connect(function(p) 
wait(5)
if p.Character:findFirstChild(&quot;Shirt Graphic&quot;).Graphic == Texture then
game:GetService(&quot;BadgeService&quot;):AwardBadge(p.userId,BadgeID) 
end 
end) </ProtectedString>
