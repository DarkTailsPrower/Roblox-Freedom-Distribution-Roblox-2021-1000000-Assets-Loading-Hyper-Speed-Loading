			<Item class="LocalScript" referent="RBX6617">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Local Gui</string>
					<ProtectedString name="Source">local Tool = script.Parent;

enabled = true
function onButton1Down(mouse)
	if not enabled then
		return
	end

	enabled = false
	mouse.Icon = &quot;rbxasset://textures\\GunWaitCursor.png&quot;

	wait(15)
	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	enabled = true

end

function onEquippedLocal(mouse)

	if mouse == nil then
		print(&quot;Mouse not found&quot;)
		return 
	end

	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end


Tool.Equipped:connect(onEquippedLocal)
</ProtectedString>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX6618">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">FlashBangScript</string>
					<ProtectedString name="Source">local Tool = script.Parent;
local Enabled = true
local GlassBreak = Instance.new(&quot;Sound&quot;) 
GlassBreak.Name = &quot;GlassBreak&quot; 
GlassBreak.SoundId = &quot;http://www.roblox.com/asset/?id=16976189&quot; 
GlassBreak.Volume = 1 
GlassBreak.Parent = Tool.Handle 

function onActivated() 
	if not Enabled then
		return
	end
	Enabled = false 
	wait(1) 
	local Player = game.Players:GetPlayerFromCharacter(Tool.Parent) 
	local Human = Tool.Parent:FindFirstChild(&quot;Humanoid&quot;) 
	if (Human == nil or Player == nil) then 
		Tool.Enabled = true 
	return 
	end 

	local tosser = Instance.new(&quot;ObjectValue&quot;) 
	tosser.Value = player 
	tosser.Name = &quot;Tosser&quot; 
	tosser.Parent = Clone

	local Clone = Tool.Handle:Clone() 
	Clone.Name = &quot;FlashBang&quot;
	local GasClone = Tool.GasScript:Clone()
	GasClone.Disabled = false
	GasClone.Parent = Clone
	GlassBreak:Clone().Parent = Clone 
	Clone.Transparency = 0 

	Tool.Parent.Torso[&quot;Right Shoulder&quot;].MaxVelocity = 0.7 
	Tool.Parent.Torso[&quot;Right Shoulder&quot;].DesiredAngle = 3.6 
	wait(0.1) 
	Tool.Parent.Torso[&quot;Right Shoulder&quot;].MaxVelocity = 1 

	local tosser = Instance.new(&quot;ObjectValue&quot;) 
	tosser.Value = Player
	tosser.Name = &quot;Tosser&quot; 
	tosser.Parent = Clone
	local dir = Human.Parent.Head.CFrame.lookVector
	Clone.Velocity = (dir * 45) + Vector3.new(0,45,0)
	Clone.CanCollide = true
	Clone.Parent = game.Workspace
	local Smoke = Instance.new(&quot;Smoke&quot;)
	Smoke.Parent = Clone
	Smoke.Size = 0 
	Smoke.Opacity = 0 
	print(&quot;SmokeGrenade Running&quot;)
	for i = 1, 8 do 
	Smoke.Opacity = Smoke.Opacity + .1 
	Smoke.Size = Smoke.Size + 1 
	wait(.2) 
	end 
	for i = 1, 17 do 
	Smoke.Size = Smoke.Size + 1 
	wait(.2) 
	end 
	wait(19) 
	Clone:Remove()
	wait(14) 
	Clone.Transparency = 1 
	Enabled = true 
end 

function onEquipped() 
	--Tool.Handle.OpenSound:play() 
end 

Tool.Activated:connect(onActivated) 
Tool.Equipped:connect(onEquipped) 
</ProtectedString>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX6619">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">GasScript</string>
					<ProtectedString name="Source">--- AdmiralLua
local FlashBang = script.Parent

function DetectHumanoids(x)
	local C = x:GetChildren()
	for i=1,#C do
		if C[i].className == &quot;Model&quot; and
			C[i]:findFirstChild(&quot;Humanoid&quot;)~=nil then
			if (C[i].Torso.CFrame.p - FlashBang.CFrame.p).magnitude &lt; 15 then
				if C[i].Name ~= FlashBang.Tosser.Value.Name then
					C[i].Humanoid.Health = C[i].Humanoid.Health -6
				else
					C[i].Humanoid.Health = C[i].Humanoid.Health -3
				end
			end
		end
	end
end

while true do
	DetectHumanoids(game.Workspace)
	wait()
end
</ProtectedString>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
		</Item>
