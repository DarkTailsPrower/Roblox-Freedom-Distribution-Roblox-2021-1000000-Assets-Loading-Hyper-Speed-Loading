								<string name="Name">150hp</string>
								<ProtectedString name="Source">debounce = true
function onTouched(hit)
	local h = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
	if (h ~= nil and debounce == true) then
		debounce = false
h.MaxHealth = 150
wait(1)
h.Health = 150
		debounce = true
	end
end

script.Parent.Touched:connect(onTouched)</ProtectedString>
								<bool name="archivable">true</bool>
							</Properties>
						</Item>
						<Item class="Script" referent="RBX2034">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">GiveTool</string>
								<ProtectedString name="Source">local t = false 
function h(hit) 
	if t then return end 
	if game.Players:findFirstChild(hit.Parent.Name) == nil then return end 
	local player = game.Players[hit.Parent.Name] 
	if #script.Parent.Parent.Parent.GiverTool:GetChildren() == 0 then 
		t = true 
		local m = Instance.new(&quot;Message&quot;) 
		m.Parent = player 
		m.Text = &quot;(This giver is empty)&quot; 
		wait(2) 
		m:remove() 
		t = false 
		return 
	end 
	t = true 
	a = script.Parent.Parent.Parent.GiverTool:GetChildren() 
	for i = 1, #a do 
		if a[i].className == &quot;Tool&quot; or a[i].className == &quot;HopperBin&quot; then 
			local skip = false 
			if player.Backpack:findFirstChild(a[i].Name) ~= nil then 
				local m = Instance.new(&quot;Message&quot;) 
				m.Parent = player 
				m.Text = &quot;You already have the &quot;..a[i].Name..&quot; tool&quot; 
				wait(2) 
				m:remove() 
				skip = true 
			end 
			if not skip then 
				a[i]:clone().Parent = player.Backpack 
				print(a[i].Name..&quot; tool successfully cloned to &quot;..player.Name..&quot;&apos;s Backpack&quot;) 
				local m = Instance.new(&quot;Hint&quot;) 
				m.Parent = player 
				m.Text = &quot;You have been given the &quot;..a[i].Name..&quot; tool!&quot; 
				wait(3) 
				m:remove() 
			end 
			t = false 
		end 
	end 
end 

script.Parent.Touched:connect(h) </ProtectedString>
								<bool name="archivable">true</bool>
