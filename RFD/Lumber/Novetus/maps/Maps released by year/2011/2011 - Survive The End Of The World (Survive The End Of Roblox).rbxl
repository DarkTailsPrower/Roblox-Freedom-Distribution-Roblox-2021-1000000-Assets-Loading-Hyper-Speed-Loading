						<float name="Pitch">0.699999988</float>
						<bool name="PlayOnRemove">false</bool>
						<Content name="SoundId"><url>http://www.roblox.com/asset/?id=16211041</url></Content>
						<float name="Volume">1</float>
						<bool name="archivable">true</bool>
					</Properties>
