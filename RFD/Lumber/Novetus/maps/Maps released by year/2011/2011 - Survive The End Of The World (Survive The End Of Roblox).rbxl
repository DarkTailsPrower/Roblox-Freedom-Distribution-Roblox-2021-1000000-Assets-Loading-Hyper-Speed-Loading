				</Properties>
				<Item class="ObjectValue" referent="RBX6638">
					<Properties>
						<string name="Name">Challenger</string>
						<Ref name="Value">null</Ref>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
				<Item class="ObjectValue" referent="RBX6639">
