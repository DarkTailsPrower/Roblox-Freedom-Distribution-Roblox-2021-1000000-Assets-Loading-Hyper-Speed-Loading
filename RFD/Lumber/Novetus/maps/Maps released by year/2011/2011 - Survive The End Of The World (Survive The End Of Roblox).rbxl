			mess.Text=&quot;V Chord&quot;
		elseif x==4 then
			mess.Text=&quot;V-VII Transition&quot;
		elseif x==5 then
			mess.Text=&quot;I-VII Transition&quot;
		elseif x==6 then
			mess.Text=&quot;III Chord&quot;
		end
		wait(1)
		mess.Parent=nil
	end
end]]

