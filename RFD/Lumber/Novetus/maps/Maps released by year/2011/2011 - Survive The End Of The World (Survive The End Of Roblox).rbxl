			if (key==&quot;t&quot;) and planedebounce == false and stuntdebounce == false then
				planedebounce = true
				stuntdebounce = true
				plane.Parent.Stunt.Value = 1
				local body = plane.Engine.BodyGyro
				body.maxTorque = Vector3.new(9000, 9000, 9000)

				local currentframe = plane.Engine.CFrame
				local valy = 30
				local valz = 30

				for i = 1,8 do
