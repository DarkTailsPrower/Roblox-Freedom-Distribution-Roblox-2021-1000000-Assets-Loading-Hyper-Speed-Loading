								<Item class="Script" referent="RBX3923">
									<Properties>
										<bool name="Disabled">false</bool>
										<Content name="LinkedSource"><null></null></Content>
										<string name="Name">WoodScript</string>
										<ProtectedString name="Source">--[[

This script allows realistic properties for wood

-----------------------------------------------------------------------

This brick includes basic properties such as

1) High Friction (In part properties)

2) Less bouncy (In part properties)

-----------------------------------------------------------------------

But this script will make the brick

1) Flammable (to catch on fire and disappear through any explosion)

2) Lighter 

-----------------------------------------------------------------------

Have fun ^^

--]]
debounce = false -- Caution

bf = Instance.new(&quot;BodyForce&quot;)
bf.Parent = script.Parent
script.Parent.BodyForce.force = Vector3.new(0,script.Parent:GetMass() * 100,0) --This will make the wood lighter than plastic

c = 2.4 -- Alter if you wish: a higher constant makes wood catch on fire from explosions that are farther away.

num = script.Parent:GetMass()^(1/3)*c -- Clever way to sensor things
--print(num)

function onChildAdded(wut)
	--print(wut.className)
	if wut.className == &quot;Explosion&quot; then
		if (wut.Position - script.Parent.Position).magnitude &lt; num and debounce == false then --Sense if explosion is nearby
			debounce = true
			wait(math.random(0,2)*.1)
			e = Instance.new(&quot;Explosion&quot;)
			e.Parent = game.Workspace
			e.Position = script.Parent.Position
			e.BlastPressure = 0
			e.BlastRadius = num --Fire effect
			wait(math.random(0,1)) -- Variable time to burn up
			script.Parent.BrickColor = BrickColor.new(26) --Burnt effect
			while script.Parent.Transparency &lt; 1 do
				wait()
				script.Parent.Transparency = script.Parent.Transparency + .1 --Sense of burning
				end
			e:remove()
			script.Parent:remove()
			end
	end
end

game.Workspace.ChildAdded:connect(onChildAdded)</ProtectedString>
