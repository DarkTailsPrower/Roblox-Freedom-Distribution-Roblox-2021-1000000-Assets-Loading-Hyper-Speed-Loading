			<Item class="LocalScript" referent="RBX7614">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">LocalToolScript</string>
					<ProtectedString name="Source">wait(0.5)
script.Parent.CamFocus.Changed:connect(function()
	local o = script.Parent.CamFocus.Value
	if o then
		wait()
		game.Workspace.CurrentCamera.CameraType = 1
		game.Workspace.CurrentCamera.CameraSubject = o
	else
		wait()
		game.Workspace.CurrentCamera.CameraType = 5	
		game.Workspace.CurrentCamera.CameraSubject = game.Players.LocalPlayer.Character.Humanoid	
	end
end)

local mouseCon = nil

local startSound = Instance.new(&quot;Sound&quot;)
startSound.Name = &quot;startSound&quot;
startSound.SoundId = &quot;http://www.roblox.com/asset/?id=31245452&quot;
startSound:Play()

local idleSound = Instance.new(&quot;Sound&quot;)
idleSound.Name = &quot;idleSound&quot;
idleSound.SoundId = &quot;http://www.roblox.com/asset/?id=31245465&quot;
idleSound.Looped = true
idleSound:Play()

local hardStopSound = Instance.new(&quot;Sound&quot;)
hardStopSound.Name = &quot;hardStopSound&quot;
hardStopSound.SoundId = &quot;http://www.roblox.com/asset/?id=31245495&quot;
hardStopSound:Play()

local squealTires = hardStopSound:clone()
squealTires.Name = &quot;squealTires&quot;
squealTires.Looped = true

function CreatePlane()

	--This call will cause a &quot;wait&quot; until the data comes back
	local root = game:GetService(&quot;InsertService&quot;):LoadAsset(31184482)

	local instances = root:GetChildren()
	if #instances == 0 then
		root:Remove()
		return nil
	end

	root = root:FindFirstChild(&quot;RCCar&quot;)
	root.Name = &quot;RCCar&quot;
	
	startSound.Parent = root
	idleSound.Parent = root
	hardStopSound.Parent = root
	squealTires.Parent = root

	return root

end

local dropped = false
local equipped = false
local gui = nil
local player = nil
local velocityConstant = 0
local gasDown = false
local brakeDown = false
local plane =  nil

--local smoke = Instance.new(&quot;Smoke&quot;)

local friction = 0.97
local maxForwardSpeed = 60
local maxReverseSpeed = -40

local keyUp = nil
local keyDown = nil

script.Parent.Changed:connect(function(pr)
	if pr == &quot;Parent&quot; then
		if script.Parent.Parent == game.Workspace then --dropped
			dropped = true	
			script.Parent.Handle.CanCollide = true
		elseif dropped then
			dropped = false
			script.Parent.Handle.CanCollide = false
		end
	end
end)

function killSmoke()
	smoke.Parent = nil
	squealTires.Looped = false
	squealTires:Stop()
end

script.Parent.Equipped:connect(function(mouse)

	script.Parent.Handle.Float.force = Vector3.new(0, 392, 0)
	equipped = true
	player = game.Players:GetPlayerFromCharacter(script.Parent.Parent)
	gui = script.Parent.PaperPlaneGui:clone()
	gui.Parent = player.PlayerGui
	-- enable failsafe
	wait() --needed, strange error occurs when no wait is put here
	local fail = script.Parent.CamFocusFailsafe:clone()
	fail.Disabled = false
	fail.Tool.Value = script.Parent
	fail.Target.Value = player.Character.Humanoid
	--put in character
	fail.Parent = script.Parent.Parent
	---
	local turnpressed = false
	---
	mouseCon = gui.MainFrame.ThrowPlane.MouseButton1Down:connect(function()
		if plane then
			plane.Parent = nil
			plane = nil
			player.Character.Torso.Anchored = false
			if keyUp then keyUp:disconnect() end
			if keyDown then keyDown:disconnect() end
		else
			plane = CreatePlane()
			player.Character.Torso.Anchored = true
			plane.AncestryChanged:connect(function(child,parent)
				if parent == nil then
					player.Torso.Humanoid.Anchored = false
					if keyUp then keyUp:disconnect() end
					if keyDown then keyDown:disconnect() end
					plane = nil
				end
			end)

			velocityConstant = 0
			gasDown = false
			brakeDown = false

			plane.Parent = game.Workspace
			startSound:Play()
			do
				plane.Position = script.Parent.Handle.Position + (-script.Parent.Handle.CFrame.lookVector * 5)
				local cf = script.Parent.Handle.CFrame
				plane.CFrame = CFrame.new(plane.Position, plane.Position + Vector3.new(-cf.lookVector.x, 0, -cf.lookVector.z))
			end
			local pplane = plane
			--
			keyDown = mouse.KeyDown:connect(onKeyDown)
			keyUp = mouse.KeyUp:connect(onKeyUp)
			script.Parent.Plane.Value = plane
			idleSound:Play()
		
			while plane do
				script.Parent.VelocityConstant.Value = velocityConstant
				velocityConstant = velocityConstant * friction
				wait()
			end

			if not equipped then return end
			script.Parent.CamFocus.Value = nil
			gui.MainFrame.ThrowPlane.TXT.Text = &quot;Throw Plane&quot;
		end
	end)
end)

function onKeyDown(key)
	key:lower()
	if key == &quot;w&quot; then
		gasDown = true
		gui.MainFrame.Gas.Selected = true
		while gasDown do
			if velocityConstant &lt; maxForwardSpeed then
				velocityConstant = velocityConstant + 0.8
			end
			wait(0.03)
		end
	elseif key == &quot;s&quot; then
		brakeDown = true
		gui.MainFrame.Brake.Selected = true
		if velocityConstant &gt; 0 and plane.Velocity.magnitude &gt; 5 then
			hardStopSound.Volume = 1 * math.abs(velocityConstant/maxForwardSpeed)
			hardStopSound:Play()
		end
		while brakeDown do
			if velocityConstant &gt; maxReverseSpeed then
				velocityConstant = velocityConstant - 0.8
			end
			wait(0.03)
		end
	elseif key == &quot;a&quot; then
		if plane then
			plane.Turn.angularvelocity = Vector3.new(0, plane.Turn.angularvelocity.y + 1.2, 0)
			gui.MainFrame.TurnLeft.Selected = true
		end
	elseif key == &quot;d&quot; then
		if plane then
			plane.Turn.angularvelocity = Vector3.new(0, plane.Turn.angularvelocity.y - 1.2, 0)
			gui.MainFrame.TurnRight.Selected = true
		end
	end

end

function onKeyUp(key)
	key:lower()
	if key == &quot;w&quot; then
		gui.MainFrame.Gas.Selected = false
		gasDown = false
	elseif key == &quot;s&quot; then
		gui.MainFrame.Brake.Selected = false
		brakeDown = false
	elseif key == &quot;a&quot;then
		if plane then
			gui.MainFrame.TurnLeft.Selected = false
			plane.Turn.angularvelocity = Vector3.new(0, plane.Turn.angularvelocity.y - 1.2, 0)
		end
	elseif key == &quot;d&quot; then
		if plane then
			gui.MainFrame.TurnRight.Selected = false
			plane.Turn.angularvelocity = Vector3.new(0, plane.Turn.angularvelocity.y + 1.2, 0)
		end
	end
end

script.Parent.Unequipped:connect(function()
	player.Character.Torso.Anchored = false
	if keyUp then keyUp:disconnect() end
	if keyDown then keyDown:disconnect() end
	if mouseCon then mouseCon:disconnect() end
	equipped = false
	if plane then 
		plane.Parent = nil
		plane = nil
	end
	script.Parent.CamFocus.Value = nil
	if gui then
		gui:remove()
		gui = nil
	end
end)
</ProtectedString>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX7615">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">ToolScript</string>
					<ProtectedString name="Source">local Tool = script.Parent
local planeObject = Tool.Plane
local plane = Tool.Plane.Value
local velocityConstant = Tool.VelocityConstant.Value
local player = nil

local smoke = Instance.new(&quot;Smoke&quot;)

local maxForwardSpeed = 60
local maxReverseSpeed = -40

function killSmoke()
	smoke.Parent = nil
	plane.squealTires.Looped = false
	plane.squealTires:Stop()
end


planeObject.Changed:connect(function()
	plane = Tool.Plane.Value
	player.PlayerGui.PaperPlaneGui.MainFrame.ThrowPlane.TXT.Text = &quot;End Flight&quot;
	Tool.CamFocus.Value = plane
	plane.Fly.maxForce = Vector3.new(4000, 0, 4000)
	plane.Velocity = Vector3.new(0, 0, 0)
	plane.Fly.velocity = Vector3.new(0, 0, 0)
	plane.Turn.angularvelocity = Vector3.new(0, 0, 0)
	while plane do
		velocityConstant = Tool.VelocityConstant.Value
		plane.Fly.velocity = velocityConstant * plane.CFrame.lookVector.unit
		plane.idleSound.Volume = 1 * math.abs(velocityConstant/(maxForwardSpeed/2))
		plane.idleSound.Pitch = (math.abs(velocityConstant/(maxForwardSpeed/2)) * 2) + 1
		plane.Bank.maxTorque = Vector3.new(40000, 0, 40000)
		local cf = plane.CFrame
		plane.Bank.cframe = CFrame.new(cf.p, cf.p+Vector3.new(cf.lookVector.x, 0, cf.lookVector.z))*CFrame.fromEulerAnglesXYZ(0, 0, plane.RotVelocity.y*0.5)

		if player.PlayerGui.PaperPlaneGui.MainFrame.Gas.Selected and player.PlayerGui.PaperPlaneGui.MainFrame.Brake.Selected then
			smoke.Parent = plane
			plane.squealTires.Volume = 1
			plane.squealTires.Looped = true
			plane.squealTires:Play()
		else
			delay(2,killSmoke)
		end
		wait()
	end

end)


function onEquipped()
	player = game.Players:GetPlayerFromCharacter(Tool.Parent)
end


function onUnequipped()
	player = nil
end


Tool.Equipped:connect(onEquipped)
Tool.Unequipped:connect(onUnequipped)
</ProtectedString>
