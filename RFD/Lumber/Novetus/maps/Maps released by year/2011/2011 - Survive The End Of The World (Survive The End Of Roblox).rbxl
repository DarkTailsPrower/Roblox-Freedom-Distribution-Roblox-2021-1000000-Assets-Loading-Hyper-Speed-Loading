										<string name="Name">Script</string>
										<ProtectedString name="Source">function onTouched(hit)
hit:BreakJoints()
if hit.Name == &quot;Engine&quot; then
local children = hit:GetChildren()
for i=1, #children do
if children[i] ~= nil then children[i]:Remove()
end end end endconnection = script.Parent.Touched:connect(onTouched) </ProtectedString>
