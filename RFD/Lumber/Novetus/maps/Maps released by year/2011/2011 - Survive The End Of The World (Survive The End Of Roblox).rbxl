						<Item class="Script" referent="RBX2220">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">t-shirt</string>
								<ProtectedString name="Source">texture = &quot;http://www.roblox.com/asset/?id=24074629&quot;

function onTouch(part) 
local human = part.Parent:findFirstChild(&quot;Humanoid&quot;) 
if (human == nil) then return end

if human.Parent.Torso:findFirstChild(&quot;roblox&quot;) ~= nil then
human.Parent.Torso:findFirstChild(&quot;roblox&quot;).Texture = texture
--Change shirts
else
local shirt = Instance.new(&quot;Decal&quot;)
shirt.Parent = human.Parent.Torso
shirt.Name = &quot;roblox&quot;
shirt.Texture = texture
end

if human.Parent.Torso:findFirstChild(&quot;roblox&quot;).Texture == texture then
--GUUD
else
local shirt = Instance.new(&quot;Decal&quot;)
shirt.Parent = human.Parent.Torso
shirt.Name = &quot;roblox&quot;
shirt.Texture = texture

wait(1)
end
end 
