					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">TicTac_OpponentCleanup</string>
					<ProtectedString name="Source">----------------------------------------------------------------------------
-------- cleans up the opponent&apos;s stuff if the player leaves

game.Players.ChildRemoved:connect(function(p)
	if p == script.Challenger.Value then
		script.Cleanup.Value:remove()
		script:remove()
	end
end)
