if person.StarterGear:findFirstChild(&quot;NuclearWinterGun&quot;) then
--no
else
if points.Value &gt;= price then
points.Value = points.Value - price
g = game.Lighting.NuclearWinterGun:Clone()
g.Parent = person.StarterGear
g = game.Lighting.NuclearWinterGun:Clone()
g.Parent = person.Backpack
end
end
end
