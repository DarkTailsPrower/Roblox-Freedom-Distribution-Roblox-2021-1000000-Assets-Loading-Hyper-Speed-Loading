				<Item class="Script" referent="RBX965">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Dead human ontouch</string>
						<ProtectedString name="Source">function onTouched(part)
	local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
	if h~=nil then
		h.Health = h.Health -25
		wait(.1)
		h.Health = h.Health -20
		wait(.1)
		h.Health = h.Health -15
		wait(.1)
		h.Health = h.Health -10
		wait(.1)
		h.Health = h.Health -5
		wait(.1)
		h.Health = h.Health -3
		wait(.1)
		h.Health = h.Health -3
		wait(.1)
		h.Health = h.Health -3
		wait(.1)
		h.Health = h.Health -3
		wait(.1)
		h.Health = h.Health -3
		wait(.1)
		h.Health = h.Health -3
		wait(.1)
		h.Health = h.Health -3
		wait(.1)
		h.Health = h.Health -3
		wait(.1)
		h.Health = h.Health -10
wait(.1)
	end
end

script.Parent.Touched:connect(onTouched)


</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
