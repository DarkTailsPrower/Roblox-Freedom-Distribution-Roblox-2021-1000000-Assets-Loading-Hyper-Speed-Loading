		<Item class="Tool" referent="RBX7291">
			<Properties>
				<bool name="Enabled">true</bool>
				<CoordinateFrame name="Grip">
					<X>0</X>
					<Y>-0.400000006</Y>
					<Z>0</Z>
					<R00>1</R00>
					<R01>0</R01>
					<R02>-0</R02>
