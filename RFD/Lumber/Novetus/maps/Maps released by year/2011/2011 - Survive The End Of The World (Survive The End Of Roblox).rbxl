				<Item class="Script" referent="RBX2331">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">mins</string>
						<ProtectedString name="Source">while true do
wait(.1) 
if script.Parent.Value &gt;= 60 then 
script.Parent.Value = script.Parent.Value - 60 
script.Parent.Parent.Hours.Value = script.Parent.Parent.Hours.Value +1
end

end

</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
			<Item class="NumberValue" referent="RBX2332">
