							<ProtectedString name="Source">b=script.Parent
r=true
b.Touched:connect(function(t)
p=game.Players:getPlayerFromCharacter(t.Parent)
if p then
if game:getService&quot;BadgeService&quot;:UserHasBadge(p.userId,24074630)then
if r then
r=false
b.Reflectance=1
b.CanCollide=false
wait(1)
b.Reflectance=0
b.CanCollide=true
r=true
end
else
h=p.Character:findFirstChild(&quot;Humanoid&quot;)
if h then
h.Health=0
end end end end)</ProtectedString>
