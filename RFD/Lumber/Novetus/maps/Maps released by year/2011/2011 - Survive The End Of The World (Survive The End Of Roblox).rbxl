					<Item class="Script" referent="RBX498">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">MessageScript</string>
							<ProtectedString name="Source">local ting = 0 
function onHit(hit) 
if ting == 0 then 
ting = 1
local human = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
if (human ~= nil) then
local message = script.Message
											message.Text = &quot;Buy vip to get this badge&quot;
message.Parent = game.Players:playerFromCharacter(hit.Parent)
											wait(4) 
message.Text = &quot;&quot;

end
end
ting = 0 
end
script.Parent.Touched:connect(onHit)</ProtectedString>
							<bool name="archivable">true</bool>
						</Properties>
						<Item class="Message" referent="RBX499">
							<Properties>
								<string name="Name">Message</string>
								<string name="Text"></string>
								<bool name="archivable">true</bool>
							</Properties>
						</Item>
					</Item>
