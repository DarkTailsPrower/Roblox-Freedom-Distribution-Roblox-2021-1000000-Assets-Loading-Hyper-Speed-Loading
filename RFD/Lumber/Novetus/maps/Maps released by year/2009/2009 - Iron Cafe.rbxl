							<string name="Name">ClickDetectorScript</string>
							<ProtectedString name="Source">local isOn = true

function on()
&#9;isOn = true
&#9;script.Parent.Pos1.CanCollide = true
&#9;script.Parent.Pos1.Transparency = 0
&#9;script.Parent.Pos2.CanCollide = false
&#9;script.Parent.Pos2.Transparency = 1
end

function off()
&#9;isOn = false
&#9;script.Parent.Pos1.CanCollide = false
&#9;script.Parent.Pos1.Transparency = 1
&#9;script.Parent.Pos2.CanCollide = true
&#9;script.Parent.Pos2.Transparency = 0
end

function onClicked()
&#9;
&#9;if isOn == true then off() else on() end

end

script.Parent.Pos1.ClickDetector.MouseClick:connect(onClicked)
script.Parent.Pos2.ClickDetector.MouseClick:connect(onClicked)

on()</ProtectedString>
