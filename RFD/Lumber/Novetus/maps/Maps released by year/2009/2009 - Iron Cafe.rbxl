						<ProtectedString name="Source">print(&quot;IronInforcer message loaded.&quot;)-- Please keep this.

local debounce = false


function onHit(hit)
&#9;local human = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;if (human ~= nil) and debounce == false then

                debounce = true

local message = Instance.new(&quot;Message&quot;)--Change this to a Hint if you want a hint.
message.Text = &quot;Enjoy your stay at the Iron Cafe&quot;
message.Parent = game.Players:playerFromCharacter(hit.Parent)
wait(4)



message:Remove ()

                debounce = false
&#9;end
end

script.Parent.Touched:connect(onHit)</ProtectedString>
