							<Item class="Script" referent="RBX3231">
								<Properties>
									<bool name="Disabled">false</bool>
									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">PresentScript</string>
									<ProtectedString name="Source">function tch(h)
if (h.Parent.Name == &quot;Cup (Empty)&quot;) then
h.Parent.Name = &quot;Tea&quot;
script.Parent.Parent.Spill.Transparency = 0.1
wait(0.5)
script.Parent.Parent.Spill.Transparency = 1
h.Parent.Drink1.BrickColor = BrickColor.new(119)
h.Parent.Drink1.Transparency = 0.1
end
end

script.Parent.Touched:connect(tch)
</ProtectedString>
								</Properties>
