										<string name="Name">Script</string>
										<string name="Source">---attach this to the button you want to click on to make &quot;*****&quot; go away for a limited time
door = script.Parent.Parent.Door
function onClicked()
	door.Transparency = 0.1
	door.CanCollide = true
end
script.Parent.ClickDetector.MouseClick:connect(onClicked)
---Replace &quot;*****&quot; with the name of the thing you want to go away for a limited time
---Replace &quot;#&quot; with the amount of seconds &quot;*****&quot; is gone
---Make sure ClickDetector is with this</string>
