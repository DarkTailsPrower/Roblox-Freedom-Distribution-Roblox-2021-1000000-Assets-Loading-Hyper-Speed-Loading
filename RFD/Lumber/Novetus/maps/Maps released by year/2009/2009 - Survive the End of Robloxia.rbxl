					<Item class="Script" referent="RBX3136">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">QucikSand speed</string>
							<string name="Source">debounce = true
--by ShadowStormer dont copy or else :P
function onTouched(hit)
	local h = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
	if (h ~= nil and debounce == true) then
		debounce = false
		h.WalkSpeed = 10-- This means when you touch the object the script is put in, it will change your WalkSpeed to 32. Change it to how fast you wanna go.
		wait(.1)
		debounce = true
		wait(1)
		h.WalkSpeed = 13
		wait(2)
		h.WalkSpeed = 14
		wait(3)
		h.WalkSpeed = 15
		wait(5)
		h.WalkSpeed = 16
	end
end

script.Parent.Touched:connect(onTouched)</string>
							<bool name="archivable">true</bool>
