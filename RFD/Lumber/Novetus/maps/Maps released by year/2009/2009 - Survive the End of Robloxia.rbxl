			<Item class="Script" referent="RBX5369">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Weld Script</string>
					<string name="Source">function Weldnow()	
	local w1 = Instance.new(&quot;Weld&quot;)
	w1.Parent = script.Parent.Handle
	w1.Part0 = w1.Parent
	w1.Part1 = script.Parent.Handle1
	w1.C1 = CFrame.fromEulerAnglesXYZ(0, 0, 1.57) * CFrame.new(.75, 0, 0)
	
	local w2 = Instance.new(&quot;Weld&quot;)
	w2.Parent = script.Parent.Handle
	w2.Part0 = w1.Parent
	w2.Part1 = script.Parent.Handle2
	w2.C1 = CFrame.fromEulerAnglesXYZ(0, 0, 1.57) * CFrame.new(-.75, 0, 0)

	local w3 = Instance.new(&quot;Weld&quot;)
	w3.Parent = script.Parent.Handle
	w3.Part0 = w1.Parent
	w3.Part1 = script.Parent.Handle3
	w3.C1 = CFrame.fromEulerAnglesXYZ(0, 0, 1.57) * CFrame.new(3, 0, 0)

	local w4 = Instance.new(&quot;Weld&quot;)
	w4.Parent = script.Parent.Handle
	w4.Part0 = w1.Parent
	w4.Part1 = script.Parent.Handle4
	w4.C1 = CFrame.fromEulerAnglesXYZ(0, 0, -1.57) * CFrame.new(-1.5, 0, 0)
	
	local w5 = Instance.new(&quot;Weld&quot;)
