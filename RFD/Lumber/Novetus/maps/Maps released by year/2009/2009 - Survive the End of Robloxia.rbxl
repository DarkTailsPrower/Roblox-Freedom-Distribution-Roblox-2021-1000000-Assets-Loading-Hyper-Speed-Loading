				<string name="Name">Lightning regen</string>
				<string name="Source">model = game.Workspace.light4 -- group everything and name it something then change this.
messageText = &quot;&quot; -- This is not it , it will not work.
message = Instance.new(&quot;Message&quot;)
message.Text = messageText
backup = model:clone()

while true do --This is where the regening starts.
	wait(.2) -- Every 5 mins
	message.Parent = game.Workspace
	model:remove()

	wait(76)

	model = backup:clone()
	model.Parent = game.Workspace
	model:makeJoints()
	message.Parent = nil
end
