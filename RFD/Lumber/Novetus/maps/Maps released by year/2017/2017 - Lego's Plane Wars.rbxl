				engine3.RotVelocity = Vector3.new(0, engine3.RotVelocity.y -0.2, 0)
				engine4.RotVelocity = Vector3.new(0, engine4.RotVelocity.y -0.2, 0)
				wait()
				engine.RotVelocity = Vector3.new(0, engine.RotVelocity.y -0.2, 0)
				engine2.RotVelocity = Vector3.new(0, engine2.RotVelocity.y -0.2, 0)
				engine3.RotVelocity = Vector3.new(0, engine3.RotVelocity.y -0.2, 0)
				engine4.RotVelocity = Vector3.new(0, engine4.RotVelocity.y -0.2, 0)
