plane=nil
hold=false
local debounce = false
local planedebounce = false
local stuntdebounce = false
local controlling = false

function computeDirection(vec)
	local lenSquared = vec.magnitude * vec.magnitude
	local invSqrt = 1 / math.sqrt(lenSquared)
	return Vector3.new(vec.x * invSqrt, vec.y * invSqrt, vec.z * invSqrt)
end

function move(target, engine, engine2, engine3, engine4)
	local origincframe = engine:findFirstChild(&quot;BodyGyro&quot;).cframe
	local dir = (target - engine.Position).unit
	local spawnPos = engine.Position

	local pos = spawnPos + (dir * 1)

	local origincframe2 = engine2:findFirstChild(&quot;BodyGyro&quot;).cframe
	local dir2 = (target - engine2.Position).unit
	local spawnPos2 = engine2.Position

	local pos2 = spawnPos2 + (dir2 * 1)

	local origincframe3 = engine3:findFirstChild(&quot;BodyGyro&quot;).cframe
	local dir3 = (target - engine3.Position).unit
	local spawnPos3 = engine3.Position

	local pos3 = spawnPos3 + (dir3 * 1)

	local origincframe4 = engine4:findFirstChild(&quot;BodyGyro&quot;).cframe
	local dir4 = (target - engine4.Position).unit
	local spawnPos4 = engine4.Position

	local pos4 = spawnPos4 + (dir4 * 1)

	engine:findFirstChild(&quot;BodyGyro&quot;).maxTorque = Vector3.new(9000, 9000, 9000)
	engine:findFirstChild(&quot;BodyGyro&quot;).cframe = CFrame.new(pos,  pos + dir)
	engine2:findFirstChild(&quot;BodyGyro&quot;).maxTorque = Vector3.new(9000, 9000, 9000)
	engine2:findFirstChild(&quot;BodyGyro&quot;).cframe = CFrame.new(pos2,  pos2 + dir2)
	engine3:findFirstChild(&quot;BodyGyro&quot;).maxTorque = Vector3.new(9000, 9000, 9000)
	engine3:findFirstChild(&quot;BodyGyro&quot;).cframe = CFrame.new(pos3,  pos3 + dir3)
	engine4:findFirstChild(&quot;BodyGyro&quot;).maxTorque = Vector3.new(9000, 9000, 9000)
	engine4:findFirstChild(&quot;BodyGyro&quot;).cframe = CFrame.new(pos4,  pos4 + dir4)
	wait(0.1)
	engine:findFirstChild(&quot;BodyGyro&quot;).maxTorque = Vector3.new(0, 0, 0)
	engine:findFirstChild(&quot;BodyGyro&quot;).cframe = origincframe
	engine2:findFirstChild(&quot;BodyGyro&quot;).maxTorque = Vector3.new(0, 0, 0)
	engine2:findFirstChild(&quot;BodyGyro&quot;).cframe = origincframe2
	engine3:findFirstChild(&quot;BodyGyro&quot;).maxTorque = Vector3.new(0, 0, 0)
	engine3:findFirstChild(&quot;BodyGyro&quot;).cframe = origincframe3
	engine4:findFirstChild(&quot;BodyGyro&quot;).maxTorque = Vector3.new(0, 0, 0)
	engine4:findFirstChild(&quot;BodyGyro&quot;).cframe = origincframe4
end

function findPlane(player)
	local list = player.Character:GetChildren()
	for x = 1, #list do
		if (list[x].Name == &quot;Nuke&quot;) then
			local weld = list[x]:FindFirstChild(&quot;Parts&quot;):FindFirstChild(&quot;Seat&quot;):FindFirstChild(&quot;SeatWeld&quot;)
			if (weld ~= nil) and (weld.Part1 == player.Character:FindFirstChild(&quot;Torso&quot;)) then
				return list[x]
			end
		end
	end
	return nil
end

function onButton1Down(mouse)
	local vehicle = findPlane(script.Parent.Parent.Parent)
	if vehicle ~= nil and debounce == false and planedebounce == false then
	debounce = true

	controlling = true

	while true do
		wait()
		local engine = vehicle.Parts.Engine
		local engine2 = vehicle.BodyKit.Top
		local engine3 = vehicle.BodyKit.Left
		local engine4 = vehicle.BodyKit.Right
		local position = mouse.Hit
		local target = position.p
		if engine:findFirstChild(&quot;FlyScript&quot;) ~= nil then
		move(target, engine, engine2, engine3, engine4)
		end
		if planedebounce == true or
		controlling == false then break end
	end
	wait(.1)
	debounce = false
	end
end

function onButton1Up(mouse)
	controlling = false
end

function onSelected(mouse)
	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
	mouse.Button1Up:connect(function() onButton1Up(mouse) end)
	mouse.KeyDown:connect(onKeyDown)
end

function onKeyDown(key)
