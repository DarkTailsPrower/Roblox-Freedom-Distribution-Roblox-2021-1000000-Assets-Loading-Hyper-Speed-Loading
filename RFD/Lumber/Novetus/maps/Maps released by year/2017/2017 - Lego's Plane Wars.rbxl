				<Item class="Script" referent="RBX1531">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">model = game.Workspace.Plane1

function regenerate()
	message.Parent = game.Workspace
	model:remove()

	

	model = backup:clone()
	model.Parent = game.Workspace
	model:makeJoints()
	message.Parent = nil

	enabled = false
	wait(30)
	enabled = true
end

function onHit(hit)
	if (hit.Parent:FindFirstChild(&quot;Humanoid&quot;) ~= nil) and enabled then
		regenerate()
	end
end

script.Parent.Touched:connect(onHit)</ProtectedString>
