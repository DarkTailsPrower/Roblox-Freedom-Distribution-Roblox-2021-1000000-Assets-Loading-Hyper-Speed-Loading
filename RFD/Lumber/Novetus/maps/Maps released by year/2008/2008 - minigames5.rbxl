		<Item class="Script" referent="RBX2">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">__STATS</string>
				<string name="Source">function GiveStats(newPlayer)

	local stats = Instance.new(&quot;IntValue&quot;)
	stats.Name = &quot;leaderstats&quot;

	local mins = Instance.new(&quot;IntValue&quot;)
	mins.Name = &quot;Points&quot;
	mins.Value = 10


	mins.Parent = stats
	
	stats.Parent = newPlayer
	
	local S = Instance.new(&quot;BoolValue&quot;)
	S.Parent = newPlayer
	S.Name = &quot;Alive&quot;
	S.Value = false

end


game.Players.ChildAdded:connect(GiveStats)</string>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
