	sDied:play()
end

function onState(state, sound)
	if state then
		sound:play()
	else
		sound:pause()
	end
end

function onRunning(speed)
	if speed&gt;0 then
		sRunning:play()
	else
		sRunning:pause()
	end
end


Horse.Died:connect(onDied)
Horse.Running:connect(onRunning)
