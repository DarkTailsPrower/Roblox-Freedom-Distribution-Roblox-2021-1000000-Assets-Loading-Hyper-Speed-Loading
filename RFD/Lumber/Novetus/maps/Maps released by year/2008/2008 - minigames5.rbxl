		<Item class="Script" referent="RBX84">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">__TALK</string>
				<string name="Source">model = game.Workspace[&quot;__BRAIN&quot;] 
backup = model:clone() 

function onChatted(msg, speaker) 

local source = string.lower(speaker.Name) 
msg = string.lower(msg) 

if (msg == &quot;fixgame&quot;) then 
model:remove() 
model = backup:clone() 
model.Parent = game.Workspace 
model:makeJoints() 
end 

if (msg == &quot;vip&quot;) then 
id = &quot;http://www.roblox.com/asset/?id=11486497&quot;
get = game.Lighting[&quot;vip&quot;]
if game.Players[speaker.Name].Character.Torso[&quot;roblox&quot;].Texture == id then
for _,v in pairs(get:GetChildren()) do
a = v:Clone()
a.Parent = game.Players:findFirstChild(speaker.Name).Backpack
end 
end 
end 

end 

function onPlayerEntered(newPlayer) 
newPlayer.Chatted:connect(function(msg) onChatted(msg, newPlayer) end) 
end 

game.Players.ChildAdded:connect(onPlayerEntered) </string>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX85">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">__SPAWN</string>
				<string name="Source">local equalizingForce = 236 / 1.2 -- amount of force required to levitate a mass
local gravity = .75 -- things float at &gt; 1
function recursiveGetMass(node)
	local m = 0
	local c = node:GetChildren()
	for i=1,#c do
		if c[i].className == &quot;Part&quot; then
			m = m + c[i]:GetMass()
		end
		m = m + recursiveGetMass(c[i])
	end
	return m
end

function onPlayerRespawned(newPlayer)
	repeat wait(0.1) until newPlayer.Character ~= nil
	local NEW = script[&quot;Spawn&quot;]:Clone()
	NEW.Disabled = false
	NEW.Parent = newPlayer.Character
	if newPlayer.Name == &quot;Bannana97&quot; then
		newPlayer[&quot;leaderstats&quot;][&quot;Points&quot;].Value = 1337
	end 
	id = &quot;http://www.roblox.com/asset/?id=11486497&quot;
	get = game.Lighting[&quot;vip&quot;]
	if newPlayer.Character.Torso[&quot;roblox&quot;].Texture == id then
		for _,v in pairs(get:GetChildren()) do
			a = v:Clone()
			a.Parent = newPlayer[&quot;Backpack&quot;]
		end 
	end 
	if newPlayer:findFirstChild(&quot;Ghost&quot;) ~= nil then
		char = newPlayer.Character
		ghostEffect = Instance.new(&quot;BodyForce&quot;)
		ghostEffect.Name = &quot;GhostEffect&quot;
		ghostEffect.force = Vector3.new(0, recursiveGetMass(char) * equalizingForce * gravity,0)
		ghostEffect.Parent = char[&quot;Head&quot;]
	end 
	if newPlayer:findFirstChild(&quot;HealthBonus&quot;) ~= nil then
		hit = newPlayer.Character.Head
		hit.Parent.Humanoid.MaxHealth = hit.Parent.Humanoid.MaxHealth * 2
		hit.Parent.Humanoid.Health = hit.Parent.Humanoid.MaxHealth * 2
	end 
	if newPlayer:findFirstChild(&quot;Sneak&quot;) ~= nil then
		if hit.Parent:findFirstChild(&quot;Head&quot;) then
			hit.Parent.Head.Transparency = 1
		end
	end 
	newPlayer.Alive.Value = false
end
 
function onPlayerEntered(newPlayer)
        newPlayer.Changed:connect(function (property)
                if (property == &quot;Character&quot;) then
                        onPlayerRespawned(newPlayer)
                end
        end)
end
 
game.Players.PlayerAdded:connect(onPlayerEntered)
</string>
