				<Item class="Script" referent="RBX1082">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<string name="Source">num = 49
function Ran()
p=script.Parent:GetChildren()
for i=1, #p do
i = math.random(1, #p)
if p[i].className ~= &quot;Script&quot; then
p[i].Parent = script.Parent.Parent
return p[i]
end 
end 
end 

while true do
wait(0.1)
p = Ran()
p.Anchored = false
end </string>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
