				<string name="Name">__HANDLE</string>
				<string name="Source">while true do
 wait(0.001)
 for _,v in pairs(game.Workspace:GetChildren()) do
  a = _
  tbl = {a, v}
  if v.className == &quot;Tool&quot; or v.className == &quot;HopperBin&quot; then
   v:Remove()
