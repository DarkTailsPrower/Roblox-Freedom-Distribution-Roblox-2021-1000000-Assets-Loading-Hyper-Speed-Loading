				<Item class="Script" referent="RBX509">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Move</string>
						<string name="Source">p = script.Parent.Platform
function forward()
for i=1, 60 do
wait()
p.Parent = nil
new = script.Parent
pos = p.Position
p.Position = Vector3.new(pos.x-0.5, pos.y, pos.z)
p.Parent = new
end 
end 
function back()
for i=1, 60 do
wait()
p.Parent = nil
new = script.Parent
pos = p.Position
p.Position = Vector3.new(pos.x+0.5, pos.y, pos.z)
p.Parent = new
end 
end 

wait(4)
while true do
back()
wait()
forward()
wait()
end </string>
