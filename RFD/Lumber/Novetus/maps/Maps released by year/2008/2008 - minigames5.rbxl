								<string name="Name">Script</string>
								<string name="Source">function onTouched(hit)
	p = game.Players:getPlayerFromCharacter(hit.Parent)
	if p ~= nil then
		if p:findFirstChild(&quot;VIP&quot;) ~= nil then return true end
		if p.Character:findFirstChild(&quot;Torso&quot;) ~= nil then
			if p.Character.Torso.roblox.Texture ~= &quot;http://www.roblox.com/asset/?id=11486497&quot; then return false end 
		end 
		local pa = Instance.new(&quot;StringValue&quot;)
		pa.Parent = p
		pa.Name = &quot;VIP&quot;
		stats = p:findFirstChild(&quot;leaderstats&quot;)
		if stats ~= nil then
		stats = stats:findFirstChild(&quot;Points&quot;)
			if stats ~= nil then
				stats.Value = stats.Value + 50
			end 
		end 
	end 
end 

