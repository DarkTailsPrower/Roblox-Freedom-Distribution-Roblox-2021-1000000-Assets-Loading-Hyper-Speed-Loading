				<string name="Name">__BRAIN</string>
				<string name="Source">--Bannana97 
--[[
INSTRUCTIONS:
Do not mess with this script.
To make a minigame, simple make a model. Name it &quot;Game_GAME NUMBER_Game Title Here&quot;
For game tools, make a model named Tools_GAME NUMBER
Insert the tools into that model.
Put both of the models inside the Lighting folder.
This script will find all the games in the Lighting automaticly.
The below tables are for settings.

]]

------------------------------------------------------------------------------------------------------------------

a1a1 = {&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;} 
a1a2 = {&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;} 
a1a3 = {&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;} 
a1a4 = {&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;} 
a1a5 = {&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;} 
a1a6 = {&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;} 
a1a7 = {&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;} 
a1a8 = {&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;} 
a1a9 = {&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;} 
a2b0 = {&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;} 
a2b1 = {&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;,&quot;&quot;} 

------------------------------------------------------------------------------------------------------------------

games = {}
h = Instance.new(&quot;Hint&quot;)
votes = {}
min = 1
max = min
function get()
	p = math.random(1, 6)
	return p
end 

function exe(v,a)
	p = get()
	find = a:findFirstChild(&quot;Spawn&quot;..p)
	if find ~= nil then
		find.Name = &quot;TakenSpawn&quot;
		v.Character.Torso.CFrame=CFrame.new(find.Position +Vector3.new(0,5,0))
	else
		exe(v)
		print  (  &quot;&quot;  )
	end 
end 

function pick(NUM)
	p = 0
	for i=1, NUM do
		wait()
		r = math.random(1, #games)
		p = r
	end 
	return p
end 


function getGames()
	n = 1
	rn = 6
	for _,v in pairs(game.Lighting:GetChildren()) do
		if v.Name == &quot;Game_&quot;..n..&quot;_&quot;..string.sub(v.Name,rn +2) then
			print(&quot;Game found&quot;)
			n = n+1
			NAME = string.sub(v.Name,rn +2)
			if n == 10 then
				rn = 7
			elseif n == 9 then
				NAME = &quot;&quot;..string.sub(v.Name,rn +2)
			end 
			table.insert(games, NAME)
			print(rn)
			print(&quot;Game_&quot;..n..&quot;_... is being found.&quot;)
		end 
	end 
	for i,v in pairs(games) do
		print(i..&quot;: &quot;..v)
	end
end 

function onDied(DeadPlayer)
	DeadPlayer = DeadPlayer -- DeadPlayer = the dead player
	DeadPlayer[&quot;Alive&quot;].Value = false
end 

function ResetGame(a)
	for _,v in pairs(game.Players:GetChildren()) do
		if v[&quot;Alive&quot;].Value == true then
			v.Character:BreakJoints()
		end 
		v[&quot;Alive&quot;].Value = false
	end 
	a:Remove()
end 


function StartGame()
	wait(3)
	if game.Players.NumPlayers &lt; max then 
		local m = Instance.new(&quot;Message&quot;)
		m.Parent = workspace
		m.Text = &quot;Not enough players to start - What to do: Invite a friend, or wait for one.&quot;
		wait(3)
		m:Remove()
		wait(3)
		StartGame()
	else
		h.Parent = game.Workspace
		time = 10
		h.Text = &quot;The next game will start in &quot;..time..&quot; seconds.&quot;
		for i=1, 10 do
			wait(1)
			time = time -1
			h.Text = &quot;The next game will start in &quot;..time..&quot; seconds.&quot;
		end 
	print(&quot;Starting Minigames..&quot;)
	chosen = 0
	NUM = #games * 3
	chosen = pick(NUM)
	workspace.Last.Value = chosen
	local m = Instance.new(&quot;Message&quot;)
	m.Parent = workspace
	m.Text = games[chosen]
	h.Text = &quot;Finding file: Lighting\\Games\\Files\\&quot;..&quot;Game_&quot;..chosen..&quot;_&quot;..games[chosen]
	wait(2)
	m:Remove()
	p = game.Lighting:findFirstChild(&quot;Game_&quot;..chosen..&quot;_&quot;..games[chosen])
	a = p:Clone()
	a.Parent = workspace
	a.Name = &quot;CurrentGame&quot;
	tools = game.Lighting[&quot;Tools_&quot;..chosen]
	for _,v in pairs(game.Players:GetChildren()) do
		C = v.Character:findFirstChild(&quot;Humanoid&quot;)
			if C ~= nil then
				C.WalkSpeed = 0
			end 
		for _,va in pairs(tools:GetChildren()) do
			pall = va:Clone()
			pall.Parent = v.Backpack
		end 
		check = a:findFirstChild(&quot;Bottom&quot;)
		if check ~= nil then
			v.Character.Torso.CFrame = CFrame.new(math.random(check.Position.x-10, check.Position.x +10),math.random(check.Position.y+5, check.Position.y +10),math.random(check.Position.z-10, check.Position.z +10))
		else
			v.Character.Torso.CFrame = CFrame.new(-36, math.random(160,180), -23)
		end 
		v.Character.Humanoid.Died:connect(function() onDied(v) end)
		v[&quot;Alive&quot;].Value = true
		C = v.Character:findFirstChild(&quot;Humanoid&quot;)
			if C ~= nil then
				C.WalkSpeed = 16
			end 
	end 
	h.Parent = nil
	local m = Instance.new(&quot;Message&quot;)
	m.Parent = workspace
	m.Text = &quot;GO!&quot;
	wait(2)
	m:Remove()
	h.Parent = workspace
	h.Text = &quot;Loading menu...&quot;
	wait(1)
	winner = &quot;No One&quot;
	for i=1, 100 do
		wait(1)
		time = 100 - i
		h.Text = &quot;This minigame will end in &quot;..time..&quot; seconds!&quot;
		num = 0
		for _,v in pairs(game.Players:GetChildren()) do
			if v[&quot;Alive&quot;].Value == true then
				num = num +1
				winner = v.Name
			end 
		end 
		if num == 1 then
			h.Text = &quot;Showing winners..&quot;
			local m = Instance.new(&quot;Message&quot;)
			m.Parent = game.Workspace
			m.Text = &quot;The winner is &quot;..winner..&quot;!&quot;
			player = game.Players:findFirstChild(winner)
			if player ~= nil then
				player[&quot;leaderstats&quot;]:findFirstChild(&quot;Points&quot;).Value = player[&quot;leaderstats&quot;]:findFirstChild(&quot;Points&quot;).Value + 6
			end 
			wait(3)
			m:Remove()
			h.Parent = nil
			i = 10000 -- STOP! :D
			ResetGame(a)
			StartGame()
		elseif num == 0 then
			local m = Instance.new(&quot;Message&quot;)
			m.Parent = game.Workspace
			m.Text = &quot;Nobody has won!&quot;
			wait(2)
			m:Remove()
			i = 10000
			ResetGame(a)
			StartGame()
		end 
	end 
	winners = &quot;&quot;
	for _,v in pairs(game.Players:GetChildren()) do
		if v[&quot;Alive&quot;].Value == true then
			af = v.leaderstats[&quot;Points&quot;]
			af.Value = af.Value + 3
			if winners == &quot;&quot; then
				winners = winners..&quot;&quot;..v.Name
			else
				winners = winners..&quot;, &quot;..v.Name
			end 
		end 
	end 
	local m = Instance.new(&quot;Message&quot;)
	m.Parent = game.Workspace
	m.Text = winners..&quot; won the game!&quot;
	i = 10000 -- STOP! :D
	h.Parent = nil
	ResetGame(a)
	wait(4)
	m:Remove()
	StartGame()
	end 
end 


getGames()
print(#games..&quot; Minigames loaded&quot;)
wait(2)
StartGame()</string>
