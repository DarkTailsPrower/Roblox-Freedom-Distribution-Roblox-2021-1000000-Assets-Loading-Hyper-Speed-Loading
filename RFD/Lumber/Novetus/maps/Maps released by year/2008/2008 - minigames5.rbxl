							<string name="Name">Script</string>
							<string name="Source">function onTouched(hit)
p = game.Players:GetPlayerFromCharacter(hit.Parent)
if p ~= nil then
name = p.Name
for _,v in pairs(game.Players:GetChildren()) do
if v[&quot;Alive&quot;].Value == true and v.Name ~= p.Name then
v.Character:BreakJoints()
end 
end 
end 
end 

script.Parent.Touched:connect(onTouched)</string>
							<bool name="archivable">true</bool>
