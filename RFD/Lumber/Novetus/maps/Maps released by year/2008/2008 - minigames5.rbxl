						<string name="Source">function onTouch(hit)
	if hit.Parent:findFirstChild(&quot;Humanoid&quot;) then
		hit.Parent.Humanoid.Health = 0
		hit.Anchored = true
	end
end
script.Parent.Touched:connect(onTouch)</string>
