&#9;&#9;&#9;&#9;return
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;local teleportto=script.Parent.Parent:findFirstChild(script.Parent.Parent.Model.Value)
&#9;&#9;&#9;&#9;if teleportto~=nil then
&#9;&#9;&#9;&#9;&#9;local torso = h.Parent.Torso
