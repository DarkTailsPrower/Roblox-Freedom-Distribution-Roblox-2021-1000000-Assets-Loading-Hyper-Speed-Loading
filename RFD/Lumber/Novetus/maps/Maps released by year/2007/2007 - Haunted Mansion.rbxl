		<Item class="Script" referent="RBX1673">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">RegenerateFurniture</string>
				<ProtectedString name="Source">model = game.Workspace.RegenFurniture
messageText = &quot;Regenerating the Cursed Furniture...&quot;

message = Instance.new(&quot;Message&quot;)
message.Text = messageText
backup = model:clone()

while true do
&#9;wait(600 * (1-math.random()*0.5))

&#9;message.Parent = game.Workspace
&#9;model:remove()

&#9;wait(4)

&#9;model = backup:clone()
&#9;model.Parent = game.Workspace
&#9;model:makeJoints()
&#9;message.Parent = nil
end
</ProtectedString>
			</Properties>
		</Item>
