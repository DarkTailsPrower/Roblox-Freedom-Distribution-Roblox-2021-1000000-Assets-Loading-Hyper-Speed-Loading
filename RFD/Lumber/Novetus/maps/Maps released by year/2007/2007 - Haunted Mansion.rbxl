bin = script.Parent

walking = false
reloadtime = 0

local thrust = Instance.new(&quot;BodyVelocity&quot;)

function makeMeGhostly(trans)
&#9;local char = game.Players.LocalPlayer.Character

&#9;char.Head.Transparency = trans
&#9;char.Torso.Transparency = trans

&#9;char:findFirstChild(&quot;Left Leg&quot;).Transparency = trans
&#9;char:findFirstChild(&quot;Right Leg&quot;).Transparency = trans
&#9;char:findFirstChild(&quot;Left Arm&quot;).Transparency = trans
&#9;char:findFirstChild(&quot;Right Arm&quot;).Transparency = trans

end

function onStart()
&#9;print(&quot;start walking&quot;)
&#9;walking = true
&#9;reloadtime = 8.0
&#9;makeMeGhostly(.5)
&#9;
&#9;thrust.Parent = game.Players.LocalPlayer.Character.PrimaryPart
&#9;
&#9;thrust.velocity = Vector3.new(0,5,0)
&#9;thrust.maxForce = Vector3.new(0,8e+003,0) 
&#9;
&#9;local sound = game.Players.LocalPlayer.Character.PrimaryPart:findFirstChild(&quot;GhostSound&quot;)
&#9;if sound == nil then 
&#9;&#9;sound = Instance.new(&quot;Sound&quot;)
&#9;&#9;sound.Name = &quot;GhostSound&quot;
&#9;&#9;sound.SoundId = &quot;rbxasset://sounds\\HalloweenGhost.wav&quot;
&#9;&#9;sound.Parent = game.Players.LocalPlayer.Character.PrimaryPart
&#9;end
&#9;sound:play()

end

function onEnd()
&#9;print(&quot;stop walking&quot;)
&#9;walking = false
&#9;makeMeGhostly(0)
&#9;thrust.Parent = nil
&#9;wait(reloadtime)
&#9;reloadtime = 0
end

function onButton1Down(mouse)
&#9;if reloadtime &gt; 0 then return end
&#9;if walking == true then return end
&#9;
&#9;onStart()
&#9;mouse.Icon = &quot;rbxasset://textures\\ArrowFarCursor.png&quot;

&#9;local time = 0
&#9;while walking == true do
&#9;&#9;--onWalk()
&#9;&#9;wait(.05)
&#9;&#9;time = time + .05
&#9;&#9;if time &gt; 7.0 then onButton1Up(mouse) end
&#9;end
end

function onButton1Up(mouse)
&#9;onEnd()
&#9;mouse.Icon = &quot;rbxasset://textures\\ArrowCursor.png&quot;
end

function onSelected(mouse)
&#9;print(&quot;ghostwalker selected&quot;)
&#9;if reloadtime &gt; 0 then
&#9;&#9;mouse.Icon = &quot;rbxasset://textures\\ArrowFarCursor.png&quot;
&#9;else
&#9;&#9;mouse.Icon = &quot;rbxasset://textures\\ArrowCursor.png&quot;
&#9;end
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
&#9;mouse.Button1Up:connect(function() onButton1Up(mouse) end)
end

bin.Selected:connect(onSelected)




