		<Item class="Script" referent="RBX2914">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">StopSpawnCampingNoobs</string>
				<ProtectedString name="Source">print(&quot;Random spawn script loaded&quot;)

function onPlayerEntered(newPlayer)

&#9;
&#9;
&#9;
&#9;-- start to listen for new humanoid
&#9;newPlayer.Changed:connect(function(property) onPlayerPropChanged(property, newPlayer) end )

&#9;onPlayerRespawn(newPlayer)

end


function onPlayerPropChanged(property, player)
&#9;if property == &quot;Character&quot; then
&#9;&#9;onPlayerRespawn(player)
&#9;end
end


function onPlayerRespawn(player)
&#9;
&#9;
&#9;local x = math.random(-80, 80)
&#9;local z = math.random(-80, 80)
&#9;local y = 90 + math.random(0, 20)

&#9;local char = player.Character.Head

&#9;local cf = char.CFrame

&#9;local lx = 0
&#9;local ly = y
&#9;local lz = 0

&#9;char.CFrame = CFrame.new(Vector3.new(x,y,z), Vector3.new(lx,ly,lz))


&#9;
end


game.Players.ChildAdded:connect(onPlayerEntered)</ProtectedString>
			</Properties>
