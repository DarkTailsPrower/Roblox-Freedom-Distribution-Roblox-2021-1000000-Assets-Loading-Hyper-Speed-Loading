					<ProtectedString name="Source">--[[--[[--[[*LuigiFan*]]--]]--]]--
-- Thanks to clockwork for making the original falcon punch :)

Arm = script.Parent
Torso = script.Parent.Parent.Torso

function boom(arm)
	E = Instance.new(&quot;Explosion&quot;)
	E.Parent = arm
	E.Position = arm.Position
	E.BlastRadius = 1
	E.BlastPressure = 0
end

function onTouched(hit)
	if (hit.Parent.Name ~= &quot;LuigiFan&quot;) then
		if (hit.Parent.className == &quot;Model&quot;) then
			a = hit.Parent:GetChildren()
			for i=1, # a do
				if (a[i].className == &quot;Humanoid&quot;) then
					a[i].Health = a[i].Health-50
				end
			end
		end
		if (hit.Anchored == false) then
			if (hit.CanCollide == false) then
				hit.CanCollide = true
				hit:breakJoints()
				wait()
				boom(Arm)
				hit.Velocity = Torso.CFrame.lookVector *800
				wait()
				hit.CanCollide = false
			end
			if (hit.CanCollide == true) then
				hit:breakJoints()
				wait()
				boom(Arm)
				hit.Velocity = Torso.CFrame.lookVector *800
			end
		end
	end
end

Arm.Touched:connect(onTouched)</ProtectedString>
