					<ProtectedString name="Source">--short-cuts
bin = script.Parent
hurt = bin.Hurt
sound = bin.Sound
punchload = false

--functions
function pose1()
	local player = game.Players.LocalPlayer
	if (player == nil) then return end
	char = player.Character
	Rshoulder = char.Torso[&quot;Right Hip&quot;]
	Lshoulder = char.Torso[&quot;Left Hip&quot;]
	Rhip = char.Torso[&quot;Right Shoulder&quot;]
	Lhip = char.Torso[&quot;Left Shoulder&quot;]
	if (Rshoulder ~= nil) then Rshoulder.DesiredAngle = 0.5 end
	if (Lshoulder ~= nil) then Lshoulder.DesiredAngle = 0.5 end
	if (Rhip ~= nil) then Rhip.DesiredAngle = 0.5 end
	if (Lhip ~= nil) then Lhip.DesiredAngle = 0.5 end
end

function noanimate()
	local player = game.Players.LocalPlayer
	if (player == nil) then return end
	char = player.Character
	local Anim = char:findFirstChild(&quot;Animate&quot;)
	if (Anim ~= nil) then
		Anim.Parent = player
	end
end

function animate()
	local player = game.Players.LocalPlayer
	if (player == nil) then return end
	char = player.Character
	local Anim = player:findFirstChild(&quot;Animate&quot;)
	if (Anim ~= nil) then
		Anim.Parent = char
		Rshoulder = char.Torso[&quot;Right Shoulder&quot;]
		Lshoulder = char.Torso[&quot;Left Shoulder&quot;]
		Rhip = char.Torso[&quot;Right Hip&quot;]
		Lhip = char.Torso[&quot;Left Hip&quot;]
		Rshoulder.Parent = nil
		Lshoulder.Parent = nil
		Rhip.Parent = nil
		Lhip.Parent = nil
		Rshoulder.Parent = char.Torso
		Lshoulder.Parent = char.Torso
		Rhip.Parent = char.Torso
		Lhip.Parent = char.Torso
	end
end

function FalconPUUUNCH(mouse)
	local player = game.Players.LocalPlayer
	if (player == nil) then return end
	char = player.Character
	if (punchload == false) then
		Rarm = char:findFirstChild(&quot;Right Arm&quot;)
		Torso = char.Torso
		Rshoulder = Torso:findFirstChild(&quot;Right Shoulder&quot;)
		if (Rarm ~= nil) and (Rshoulder ~= nil) then
			punchload = true
			mouse.Icon = &quot;rbxasset://textures\\GunWaitCursor.png&quot;
			noanimate()
			pose1()
			sound.Volume = 1
			sound:play()
			Rshoulder.MaxVelocity = 1
			Rshoulder.DesiredAngle = -1.5
			wait(0.5)
			hurtc = hurt:clone()
			hurtc.Disabled = false
			hurtc.Parent = Rarm
			Torso.Velocity = Torso.CFrame.lookVector *150
			Rshoulder.DesiredAngle = 1.5
			wait(0.1)
			Rshoulder.MaxVelocity = 0.1
			hurtc:remove()
			wait(1)
			animate()
			sound.Volume = 0
			punchload = false
			mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
		end
	end
end 

--connection
function onSelected(mouse)
	if (punchload == false) then mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot; end
	if (punchload == true) then mouse.Icon = &quot;rbxasset://textures\\GunWaitCursor.png&quot; end
	mouse.Button1Down:connect(function() FalconPUUUNCH(mouse) end)
end

bin.Selected:connect(onSelected)</ProtectedString>
