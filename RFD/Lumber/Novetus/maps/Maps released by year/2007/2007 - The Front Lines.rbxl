				<Item class="Script" referent="RBX2218">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<string name="Source">-----MrDoomBringer&apos;s ugly modifications of Eric Cassel&apos;s rocket script.&#13;&#10;wait(5)&#13;&#10;players = game:service(&quot;Players&quot;)&#13;&#10;&#13;&#10;-- get the Rocket&#13;&#10;template = script.Parent[&quot;Rocket&quot;]&#13;&#10;&#13;&#10;-- hide the rocket template (hack)&#13;&#10;template.Parent = nil&#13;&#10;template.Anchored = false&#13;&#10;&#13;&#10;function bang(part)&#13;&#10;&#9;local e = Instance.new(&quot;Explosion&quot;)&#13;&#10;&#9;e.Position = part.Position&#13;&#10;&#9;part.Parent = nil&#13;&#10;&#9;e.Parent = workspace&#13;&#10;end&#13;&#10;&#13;&#10;-- Targets a rocket and causes it to blow up on touch (arms it)&#13;&#10;function setTarget(propulsion, target)&#13;&#10;&#9;local rocket = propulsion.Parent&#13;&#10;&#9;propulsion.TargetOffset = Vector3.new(-5,0,5)&#13;&#10;&#9;propulsion.Target = target&#13;&#10;&#9;return rocket.Touched:connect(function() bang(rocket) end)&#13;&#10;end&#13;&#10;&#13;&#10;target = nil&#13;&#10;function shoot(player)&#13;&#10;&#9;if player.Character then&#13;&#10;&#9;&#9;print(player.TeamColor.Number)&#13;&#10;&#9;&#9;if (player.TeamColor.Number ~= 21) then&#13;&#10;&#9;&#9;&#9;target = player.Character.PrimaryPart&#13;&#10;&#9;&#9;&#9;print(&quot;targeting hostile&quot;)&#13;&#10;&#9;&#9;elseif (player.TeamColor.Number == 21) then&#13;&#10;&#9;&#9;&#9;print(&quot;friendly, aborting&quot;)&#13;&#10;&#9;&#9;&#9;target = nil&#13;&#10;&#9;&#9;end&#13;&#10;&#9;&#9;if (target ~= nil) then&#13;&#10;&#9;&#9;&#9;local rocket = template:clone()&#13;&#10;&#9;&#9;&#9;rocket.Parent = workspace&#13;&#10;&#13;&#10;&#9;&#9;&#9;local propulsion = rocket[&quot;Propulsion&quot;]&#13;&#10;&#13;&#10;&#9;&#9;&#9;-- First the rocket flies upwards. &#13;&#10;&#9;&#9;&#9;-- When it reaches the first destination it targets the character&apos;s primary part&#13;&#10;&#9;&#9;&#9;propulsion.TargetOffset = Vector3.new(0,100,50)&#13;&#10;&#9;&#9;&#9;propulsion:Fire()&#13;&#10;&#9;&#9;&#9;wait(2)&#13;&#10;&#9;&#9;&#9;propulsion.TargetOffset = Vector3.new(0,100,100)&#13;&#10;&#9;&#9;&#9;wait(.5)&#13;&#10;&#9;&#9;&#9;local bangConnection&#13;&#10;&#9;&#9;&#9;bangConnection = setTarget(propulsion, target)&#13;&#10;&#13;&#10;&#9;&#9;&#9;-- after 20 seconds kill the rocket&#13;&#10;&#9;&#9;&#9;delay(20, function() &#13;&#10;&#9;&#9;&#9;&#9;-- stop blowing up on touch&#13;&#10;&#9;&#9;&#9;&#9;bangConnection:disconnect()&#13;&#10;&#13;&#10;&#9;&#9;&#9;&#9;-- fall out of the sky&#13;&#10;&#9;&#9;&#9;&#9;propulsion:Abort() &#13;&#10;&#13;&#10;&#9;&#9;&#9;&#9;-- after a few more seconds blow up the dud rocket&#13;&#10;&#9;&#9;&#9;&#9;wait(4) &#13;&#10;&#9;&#9;&#9;&#9;if rocket:IsDescendentOf(workspace) then &#13;&#10;&#9;&#9;&#9;&#9;&#9;bang(rocket)&#13;&#10;&#9;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;&#9;end)&#9;&#9;&#13;&#10;&#9;&#9;end&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;&#13;&#10;enabled = true&#13;&#10;while (enabled == true) do&#13;&#10;&#9;test = script.Parent.Parent:FindFirstChild(&quot;gyro&quot;)&#13;&#10;&#9;if (text == nil) then&#13;&#10;&#9;&#9;enabled = false&#13;&#10;&#9;end&#13;&#10;&#9;local ps = players:GetPlayers()&#13;&#10;&#9;if #ps&gt;0 then&#13;&#10;&#9;&#9;local i = math.random(1,#ps)&#13;&#10;&#9;&#9;shoot(ps[i])&#13;&#10;&#9;end&#13;&#10;&#9;local waittime = math.random(5,20)&#13;&#10;&#9;wait(waittime)&#13;&#10;end&#13;&#10;</string>
						<bool name="archivable">true</bool>
