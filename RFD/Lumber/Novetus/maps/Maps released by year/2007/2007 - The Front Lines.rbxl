		<Item class="Script" referent="RBX2289">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">buildingregen</string>
				<string name="Source">-----MrDoom&apos;s multiregen script&#13;&#10;&#13;&#10;print (&quot;regen script ready&quot;)&#13;&#10;&#13;&#10;building1 = game.Workspace.building1:Clone()&#13;&#10;building2 = game.Workspace.building2:Clone()&#13;&#10;building3 = game.Workspace.building3:Clone()&#13;&#10;building4 = game.Workspace.building4:Clone()&#13;&#10;msg = game.Workspace.Message&#13;&#10;&#13;&#10;while true do&#13;&#10;&#9;wait(250)&#13;&#10;&#9;regen = building1:Clone()&#13;&#10;&#9;msg.Text = &quot;Rebuilding Building&quot;&#13;&#10;&#9;game.Workspace.building1:Remove()&#13;&#10;&#9;wait(1)&#13;&#10;&#9;regen.Parent = game.Workspace&#13;&#10;&#9;regen:MakeJoints()&#13;&#10;&#9;wait(10)&#13;&#10;------------&#13;&#10;&#9;regen = building3:Clone()&#13;&#10;&#9;game.Workspace.building3:Remove()&#13;&#10;&#9;wait(1)&#13;&#10;&#9;regen.Parent = game.Workspace&#13;&#10;&#9;regen:MakeJoints()&#13;&#10;-------------&#13;&#10;&#9;wait(10)&#13;&#10;&#9;regen = building2:Clone()&#13;&#10;&#9;game.Workspace.building2:Remove()&#13;&#10;&#9;wait(1)&#13;&#10;&#9;regen.Parent = game.Workspace&#13;&#10;&#9;regen:MakeJoints()&#13;&#10;&#9;wait(10)&#13;&#10;------------------&#13;&#10;&#9;regen = building4:Clone()&#13;&#10;&#9;game.Workspace.building4:Remove()&#13;&#10;&#9;wait(1)&#13;&#10;&#9;regen.Parent = game.Workspace&#13;&#10;&#9;regen:MakeJoints()&#9;&#13;&#10;&#9;wait(4)&#13;&#10;&#9;msg.Text = &quot;Fight back and take the green flags! &quot;&#13;&#10;end</string>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
