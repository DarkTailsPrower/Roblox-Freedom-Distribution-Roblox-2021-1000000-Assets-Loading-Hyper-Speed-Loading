						<Item class="RocketPropulsion" referent="RBX2579">
							<Properties>
								<float name="CartoonFactor">0.899999976</float>
								<float name="MaxSpeed">30</float>
								<float name="MaxThrust">40000</float>
								<Vector3 name="MaxTorque">
