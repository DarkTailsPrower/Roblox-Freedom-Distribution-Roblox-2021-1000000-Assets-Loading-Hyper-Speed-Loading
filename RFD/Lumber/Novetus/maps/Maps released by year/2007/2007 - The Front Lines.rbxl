				<string name="Source">-----MrDoom&apos;s multiregen script&#13;&#10;&#13;&#10;print (&quot;tankregen script ready&quot;)&#13;&#10;&#13;&#10;tankr = game.Workspace.RocketTank1R:Clone()&#13;&#10;tankb = game.Workspace.RocketTank1B:Clone()&#13;&#10;msg = game.Workspace.Message&#13;&#10;&#13;&#10;tops = game.Teams.Tops&#13;&#10;fronts = game.Teams.Fronts&#13;&#10;&#13;&#10;&#13;&#10;print(&quot;point tank regen ready&quot;)&#13;&#10;&#13;&#10;while true do&#13;&#10;&#9;wait(3)&#13;&#10;&#9;if (tops.Score &gt; 9) then&#13;&#10;&#9;&#9;regen = tankr:Clone()&#13;&#10;&#9;&#9;msg.Text = &quot;Tops got a new rocket tank!&quot;&#13;&#10;&#9;&#9;game.Workspace.RocketTank1R.Parent = nil&#13;&#10;&#9;&#9;wait(2)&#13;&#10;&#9;&#9;regen.Parent = game.Workspace&#13;&#10;&#9;&#9;regen:MakeJoints()&#13;&#10;&#9;&#9;wait(2)&#13;&#10;&#9;&#9;msg.Text = &quot;Fight back and take the green flags!&quot;&#13;&#10;&#9;&#9;tops.Score = 0&#13;&#10;&#9;end&#13;&#10;&#9;if (fronts.Score &gt; 9) then&#13;&#10;&#9;&#9;regen = tankb:Clone()&#13;&#10;&#9;&#9;msg.Text =  &quot;Fronts got a new rocket tank!&quot;&#13;&#10;&#9;&#9;game.Workspace.RocketTank1B.Parent = nil&#13;&#10;&#9;&#9;wait(2)&#13;&#10;&#9;&#9;regen.Parent = game.Workspace&#13;&#10;&#9;&#9;regen:MakeJoints()&#13;&#10;&#9;&#9;wait(2)&#13;&#10;&#9;&#9;msg.Text = &quot;Fight back and take the green flags!&quot;&#13;&#10;&#9;&#9;fronts.Score = 0&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;&#13;&#10;</string>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
