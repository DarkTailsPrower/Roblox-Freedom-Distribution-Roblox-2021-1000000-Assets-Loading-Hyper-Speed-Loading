								<Ref name="Target">null</Ref>
								<Vector3 name="TargetOffset">
									<X>0</X>
									<Y>50</Y>
									<Z>0</Z>
								</Vector3>
								<float name="TargetRadius">4</float>
								<float name="ThrustD">9.99999975e-005</float>
								<float name="ThrustP">5</float>
								<float name="TurnD">500</float>
