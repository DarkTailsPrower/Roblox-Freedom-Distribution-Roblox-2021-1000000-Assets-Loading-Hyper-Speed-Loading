			<Item class="Script">
				<Properties>
					<bool name="Disabled">false</bool>
					<string name="Name">Conductor</string>
					<string name="Source">print(&quot;Robloxpolice&apos;s Autocar script loaded!&quot;)&#13;&#10;&#13;&#10;part=script.Parent&#13;&#10;le=part.LeftEngine.BodyVelocity&#13;&#10;re=part.RightEngine.BodyVelocity&#13;&#10;starter=part.Parent.StartBlock&#13;&#10;ender=part.Parent.EndBlock&#13;&#10;running=true&#13;&#10;&#13;&#10;dir=1&#13;&#10;spd=0&#13;&#10;maxspd=20&#13;&#10;&#13;&#10;pos1=starter.Position.z&#13;&#10;pos2=ender.Position.z&#13;&#10;&#13;&#10;function SetSpeed(setvel)&#13;&#10;&#9;le.velocity = Vector3.new(0,0,-setvel)&#13;&#10;&#9;re.velocity = Vector3.new(0,0,-setvel)&#13;&#10;end&#13;&#10;&#13;&#10;function StartUp()&#13;&#10;&#9;while (spd&lt;maxspd) do&#13;&#10;&#9;&#9;wait(.1)&#13;&#10;&#9;&#9;spd=spd+1&#13;&#10;&#9;&#9;SetSpeed(spd)&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;&#13;&#10;function StartUpRev()&#13;&#10;&#9;while (spd&gt;-maxspd) do&#13;&#10;&#9;&#9;wait(.1)&#13;&#10;&#9;&#9;spd=spd-1&#13;&#10;&#9;&#9;SetSpeed(spd)&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;&#13;&#10;function SlowDown()&#13;&#10;&#9;while (spd&gt;0) do&#13;&#10;&#9;&#9;wait(.1)&#13;&#10;&#9;&#9;spd=spd-1&#13;&#10;&#9;&#9;SetSpeed(spd)&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;&#13;&#10;function SlowDownRev()&#13;&#10;&#9;while (spd&lt;0) do&#13;&#10;&#9;&#9;wait(.1)&#13;&#10;&#9;&#9;spd=spd+1&#13;&#10;&#9;&#9;SetSpeed(spd)&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;&#13;&#10;while true do&#13;&#10;&#9;wait(.1)&#13;&#10;&#9;local cpos=part.LeftEngine.Position.z&#13;&#10;&#9;if (running==true) then&#13;&#10;&#9;&#9;if (dir==1) then&#13;&#10;&#9;&#9;&#9;if (spd==0) then&#13;&#10;&#9;&#9;&#9;&#9;StartUp()&#13;&#10;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;&#9;if (cpos&lt;=pos2) then&#13;&#10;&#9;&#9;&#9;&#9;SlowDown()&#13;&#10;&#9;&#9;&#9;&#9;wait(5)&#13;&#10;&#9;&#9;&#9;&#9;dir=-1&#13;&#10;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;end&#13;&#10;&#9;&#9;if (dir==-1) then&#13;&#10;&#9;&#9;&#9;if (spd==0) then&#13;&#10;&#9;&#9;&#9;&#9;StartUpRev()&#13;&#10;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;&#9;if (cpos&gt;=pos1) then&#13;&#10;&#9;&#9;&#9;&#9;SlowDownRev()&#13;&#10;&#9;&#9;&#9;&#9;wait(5)&#13;&#10;&#9;&#9;&#9;&#9;dir=1&#13;&#10;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;end&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;</string>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
