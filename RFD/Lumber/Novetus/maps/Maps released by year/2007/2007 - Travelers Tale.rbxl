				<string name="Name">Regenerate Center</string>
				<string name="Source">&#13;&#10;model = game.Workspace.Center&#13;&#10;messageText = &quot;Regenerating The Center of the Map...&quot;&#13;&#10;&#13;&#10;message = Instance.new(&quot;Message&quot;)&#13;&#10;message.Text = messageText&#13;&#10;backup = model:clone()&#13;&#10;&#13;&#10;while true do&#13;&#10;&#9;wait(200) -- regenerate this model every 300 seconds&#13;&#10;&#13;&#10;&#9;message.Parent = game.Workspace&#13;&#10;&#9;model:remove()&#13;&#10;&#13;&#10;&#9;wait(4) -- display regen message for 4 seconds&#13;&#10;&#13;&#10;&#9;model = backup:clone()&#13;&#10;&#9;model.Parent = game.Workspace&#13;&#10;&#9;model:makeJoints()&#13;&#10;&#9;message.Parent = nil&#13;&#10;end&#13;&#10;&#13;&#10;</string>
				<bool name="archivable">true</bool>
			</Properties>
