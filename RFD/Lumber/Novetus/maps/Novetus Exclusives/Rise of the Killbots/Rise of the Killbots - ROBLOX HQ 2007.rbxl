		<Item class="Tool" referent="RBX5280">
			<Properties>
				<bool name="Archivable">true</bool>
				<bool name="Enabled">true</bool>
				<CoordinateFrame name="Grip">
					<X>0</X>
					<Y>-0.200000003</Y>
					<Z>0</Z>
