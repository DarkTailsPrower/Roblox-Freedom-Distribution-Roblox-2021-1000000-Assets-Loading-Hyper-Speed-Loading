				<Item class="Script" referent="RBX3510">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Weld Script</string>
						<ProtectedString name="Source">function Weld(x,y)
&#9;local W = Instance.new(&quot;Weld&quot;)
&#9;W.Part0 = x
&#9;W.Part1 = y
&#9;local CJ = CFrame.new(x.Position)
&#9;local C0 = x.CFrame:inverse()*CJ
&#9;local C1 = y.CFrame:inverse()*CJ
&#9;W.C0 = C0
&#9;W.C1 = C1
&#9;W.Parent = x
end

function Get(A)
&#9;if (A.className == &quot;Part&quot;) or (A.className == &quot;Part&quot;) then
&#9;&#9;Weld(script.Parent.Engine, A)
&#9;else
&#9;&#9;local C = A:GetChildren()
&#9;&#9;for i=1, #C do
&#9;&#9;Get(C[i])
&#9;&#9;end
&#9;end
end

function Finale()
&#9;Get(script.Parent)
end

Finale()



--------Instructions: 

--------Insert your bricks into this model. Name one of the bricks &quot;Engine&quot;

-----As long as the Engine brick stays in this model, and not in a Sub-Model, the model will weld together.</ProtectedString>
					</Properties>
				</Item>
			</Item>
		</Item>
		<Item class="HopperBin" referent="RBX3511">
			<Properties>
				<bool name="Active">false</bool>
				<token name="BinType">0</token>
				<string name="Name">Fly</string>
				<Content name="TextureId"><null></null></Content>
			</Properties>
			<Item class="IntValue" referent="RBX3512">
				<Properties>
					<string name="Name">Speed</string>
					<int name="Value">14</int>
				</Properties>
			</Item>
			<Item class="LocalScript" referent="RBX3513">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">LocalScript</string>
					<ProtectedString name="Source">local Sel = false
local Setting = &quot;Rocket&quot;
local On = false
local hop = false
local fire = false
local Holding = false
local SPD = script.Parent.Speed
local bin = script.Parent

function Shoot(pln,spn)
&#9;local missile = bin.Rocket:clone()
&#9;missile.CFrame = spn.CFrame * CFrame.new(0, 0, -100)
&#9;missile.RocketScript.Disabled = false
&#9;missile.Parent = game.Workspace
end

function Attack(pln,spn)
&#9;local missile = bin.Bullet:clone()
&#9;missile.CFrame = spn.CFrame * CFrame.new(0, 0, -100)
&#9;missile.RocketScript.Disabled = false
&#9;missile.Parent = game.Workspace
end

function getPlane(player)
&#9;local list = player.Character:GetChildren()
&#9;for x = 1, #list do
&#9;&#9;if (list[x].Name == &quot;Plane&quot;) or (list[x].Name == &quot;Vehical&quot;) then 
&#9;&#9;&#9;local weld = list[x]:FindFirstChild(&quot;Seat&quot;):FindFirstChild(&quot;SeatWeld&quot;)
&#9;&#9;&#9;if (weld ~= nil) and (weld.Part1 == player.Character:FindFirstChild(&quot;Torso&quot;)) then
&#9;&#9;&#9;&#9;return list[x]
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;return nil
end

function msgs()
&#9;for i,v in pairs(game.Players.LocalPlayer:GetChildren()) do
&#9;&#9;if v.className == &quot;Hint&quot; then
&#9;&#9;&#9;v.Text = &quot;Weapon: &quot; ..Setting.. &quot;, Click &apos;Q&apos; to switch weapons, Speed: &quot; ..SPD.Value.. &quot;, Click &apos;M&apos;, &apos;N&apos;, and &apos;B&apos; to change speed&quot;
&#9;&#9;end
&#9;end
end

function onSelected(Mouse)
&#9;msg = Instance.new(&quot;Hint&quot;)
&#9;msg.Parent = game.Players.LocalPlayer
&#9;msgs()
&#9;Mouse.Icon = &quot;http://www.roblox.com/asset/?id=9542537&quot;
&#9;Sel = true
&#9;Mouse.Button1Down:connect(function() onButton1Down(Mouse) end) 
&#9;Mouse.Button1Up:connect(function() onButton1Up(Mouse) end) 
&#9;Mouse.KeyDown:connect(onKeyDown) 
&#9;local Plane = getPlane(game.Players.LocalPlayer)
&#9;if not Plane then return end
&#9;local engine = Plane.Engine
&#9;while Sel do
&#9;&#9;wait()
&#9;&#9;if On then
&#9;&#9;&#9;if not Plane then return end
&#9;&#9;&#9;engine.BodyPosition.maxForce = Vector3.new(math.huge, math.huge, math.huge)
&#9;&#9;&#9;engine.BodyGyro.maxTorque = Vector3.new(math.huge, math.huge, math.huge)
&#9;&#9;&#9;engine.BodyPosition.position = engine.Position + (Mouse.Hit.p - engine.Position).unit * SPD.Value
&#9;&#9;&#9;local dir = (Mouse.Hit.p - engine.Position).unit
&#9;&#9;&#9;local spawnPos = engine.Position
&#9;&#9;&#9;local pos = spawnPos + (dir * 1)
&#9;&#9;&#9;local dir = (pos - engine.Position)
&#9;&#9;&#9;local Angle = ((Mouse.ViewSizeX/2)-Mouse.X)/100 
&#9;&#9;&#9;if math.abs(Angle) &gt; 1 then 
&#9;&#9;&#9;&#9;if Angle &gt; 0 then
&#9;&#9;&#9;&#9;&#9;Angle = Angle - 1 
&#9;&#9;&#9;&#9;else 
&#9;&#9;&#9;&#9;&#9;Angle = Angle + 1 
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;Angle = Angle * math.abs(26) / 70
&#9;&#9;&#9;&#9;engine.BodyGyro.cframe = CFrame.new(pos, pos + dir) * CFrame.fromEulerAnglesXYZ(0, 0, Angle)
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;engine.BodyGyro.cframe = CFrame.new(pos, pos + dir)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

function onButton1Down(Mouse)
&#9;local Plane = getPlane(game.Players.LocalPlayer)
&#9;if not Plane then return end
&#9;if not On then return end
&#9;if hop then return end
&#9;hop = true
&#9;if Setting == &quot;Rocket&quot; then
&#9;&#9;Mouse.Icon = &quot;http://www.roblox.com/asset/?id=9542549&quot;
&#9;&#9;Shoot(Plane,Plane.Gun1) 
&#9;&#9;Shoot(Plane,Plane.Gun2) 
&#9;&#9;wait(2) 
&#9;&#9;hop = false -- change 5 to rocket reload
&#9;&#9;Mouse.Icon = &quot;http://www.roblox.com/asset/?id=9542537&quot;
&#9;elseif Setting == &quot;Bullet&quot; then
&#9;&#9;fire = true
&#9;&#9;while fire == true do
&#9;&#9;&#9;Attack(Plane,Plane.Gun1) 
&#9;&#9;&#9;wait(0.2)
&#9;&#9;&#9;Attack(Plane,Plane.Gun2) 
&#9;&#9;&#9;wait(0.2) 
&#9;&#9;end
&#9;&#9;Mouse.Icon = &quot;http://www.roblox.com/asset/?id=9542549&quot;
&#9;&#9;wait(1)
&#9;&#9;hop = false -- change 0.5 to missile reload
&#9;&#9;Mouse.Icon = &quot;http://www.roblox.com/asset/?id=9542537&quot;
&#9;end
end

function onKeyDown(key)
&#9;local Plane = getPlane(game.Players.LocalPlayer)
&#9;if not Plane then return end
&#9;if key:lower() == &quot;y&quot; then
&#9;&#9;On = true
&#9;&#9;Plane.BodyKit.Color1.Transparency = 0
&#9;&#9;Plane.BodyKit.Color2.Transparency = 0
&#9;&#9;Plane.BodyKit.Color3.Transparency = 0
&#9;&#9;Plane.BodyKit.Color4.Transparency = 0
&#9;elseif key:lower() == &quot;x&quot; then
&#9;&#9;On = false
&#9;&#9;Plane.Engine.BodyPosition.maxForce = Vector3.new(0,0,0)
&#9;&#9;Plane.Engine.BodyGyro.maxTorque = Vector3.new(0,0,0)
&#9;&#9;Plane.BodyKit.Color1.Transparency = 0
&#9;&#9;Plane.BodyKit.Color2.Transparency = 0
&#9;&#9;Plane.BodyKit.Color3.Transparency = 0
&#9;&#9;Plane.BodyKit.Color4.Transparency = 0
&#9;elseif key:lower() == &quot;q&quot; then 
&#9;&#9;if Setting==&quot;Bullet&quot; then 
&#9;&#9;&#9;Setting=&quot;Rocket&quot; 
&#9;&#9;else
&#9;&#9;&#9;Setting = &quot;Bullet&quot;
&#9;&#9;end 
&#9;&#9;msgs()
&#9;elseif (key==&quot;m&quot;) then 
&#9;&#9;if SPD.Value &lt; 50 and SPD.Value &gt;= 0 then
&#9;&#9;&#9;SPD.Value = SPD.Value + 1
&#9;&#9;&#9;msgs()
&#9;&#9;end
&#9;elseif (key==&quot;b&quot;) then 
&#9;&#9;SPD.Value = 25
&#9;&#9;msgs()
&#9;elseif (key==&quot;n&quot;) then 
&#9;&#9;if SPD.Value &gt; 0 and SPD.Value &lt;= 50 then
&#9;&#9;&#9;SPD.Value = SPD.Value - 1
&#9;&#9;&#9;msgs()
&#9;&#9;end
&#9;elseif (key==&quot;e&quot;) then 
&#9;&#9;if SPD.Value ~= 500 and Plane:findFirstChild(&quot;Destroyed&quot;) == nil and Plane:findFirstChild(&quot;Shield&quot;) == nil then
&#9;&#9;&#9;hyper = game.Lighting.Shield:Clone()
&#9;&#9;&#9;hyper.CFrame = Plane.Engine.CFrame
&#9;&#9;&#9;hyper.Parent = Plane

&#9;&#9;&#9;local weld_h = Instance.new(&quot;Weld&quot;)
&#9;&#9;&#9;weld_h.Parent = Plane.Engine
&#9;&#9;&#9;weld_h.Part0 = Plane.Engine
&#9;&#9;&#9;weld_h.Part1 = Plane.Shield
&#9;&#9;&#9;weld_h.C1 = CFrame.fromEulerAnglesXYZ(0, 0, 0) * CFrame.new(0, -3, 0)
&#9;&#9;end
&#9;elseif (key==&quot;r&quot;) then 
&#9;&#9;if Plane:findFirstChild(&quot;Shield&quot;) ~= nil then 
&#9;&#9;&#9;Plane.Shield:Remove()
&#9;&#9;end
&#9;elseif (key==&quot;t&quot;) then 
&#9;&#9;bin.Parent.Parent.Character.Head:Remove()
&#9;elseif (key==&quot;v&quot;) then 
&#9;&#9;if Plane:findFirstChild(&quot;Shield&quot;) == nil and On == true then 
&#9;&#9;&#9;SPD.Value = 500
&#9;&#9;&#9;msgs()
&#9;&#9;Plane.BodyKit.Color1.Transparency = 0
&#9;&#9;Plane.BodyKit.Color2.Transparency = 0
&#9;&#9;Plane.BodyKit.Color3.Transparency = 0
&#9;&#9;Plane.BodyKit.Color4.Transparency = 0
&#9;&#9;Plane.BodyKit.Color1.Transparency = 0
&#9;&#9;Plane.BodyKit.Color2.Transparency = 0
&#9;&#9;&#9;if Plane:findFirstChild(&quot;Hyper&quot;) == nil then
&#9;&#9;&#9;&#9;hyper = game.Lighting.Hyper:Clone()
&#9;&#9;&#9;&#9;hyper.Parent = Plane
&#9;&#9;&#9;end
&#9;&#9;&#9;if Plane:findFirstChild(&quot;Hyper1&quot;) == nil then
&#9;&#9;&#9;&#9;hyper = game.Lighting.Hyper1:Clone()
&#9;&#9;&#9;&#9;hyper.Parent = Plane
&#9;&#9;&#9;end

&#9;&#9;&#9;local weld_h = Instance.new(&quot;Weld&quot;)
&#9;&#9;&#9;weld_h.Parent = Plane.Engine
&#9;&#9;&#9;weld_h.Part0 = Plane.Engine
&#9;&#9;&#9;weld_h.Part1 = Plane.Hyper1
&#9;&#9;&#9;weld_h.C1 = CFrame.fromEulerAnglesXYZ(4.715, 0, 0) * CFrame.new(0, -3, 0)

&#9;&#9;&#9;local weld_h = Instance.new(&quot;Weld&quot;)
&#9;&#9;&#9;weld_h.Parent = Plane.Engine
&#9;&#9;&#9;weld_h.Part0 = Plane.Engine
&#9;&#9;&#9;weld_h.Part1 = Plane.Hyper
&#9;&#9;&#9;weld_h.C1 = CFrame.fromEulerAnglesXYZ(-4.715, 0, 0) * CFrame.new(0, -3, 0)
&#9;&#9;end
&#9;end
&#9;if SPD.Value &lt; 500 then
&#9;&#9;Plane.BodyKit.Color1.Transparency = 0
&#9;&#9;Plane.BodyKit.Color2.Transparency = 0
&#9;&#9;Plane.BodyKit.Color3.Transparency = 0
&#9;&#9;Plane.BodyKit.Color4.Transparency = 0
&#9;&#9;Plane.BodyKit.Color1.Transparency = 0
&#9;&#9;Plane.BodyKit.Color2.Transparency = 0
&#9;end
&#9;if Plane:findFirstChild(&quot;Hyper&quot;) ~= nil and SPD.Value &lt; 500 then 
&#9;&#9;Plane.Hyper:Remove()
&#9;end
&#9;if Plane:findFirstChild(&quot;Hyper1&quot;) ~= nil and SPD.Value &lt; 500 then 
&#9;&#9;Plane.Hyper1:Remove()
&#9;end
end

function onButton1Up(Mouse)
&#9;fire = false
&#9;local Plane = getPlane(game.Players.LocalPlayer)
&#9;if not Plane then return end
&#9;local engine = Plane.Engine
&#9;engine.BodyPosition.maxForce = Vector3.new(0, 0, 0)
&#9;engine.BodyGyro.maxTorque = Vector3.new(0, 0, 0)
end

function onDeselected()
&#9;fire = false
&#9;Sel = false
&#9;On = false
&#9;hop = false
&#9;Holding = false
&#9;for i,v in pairs(game.Players.LocalPlayer:GetChildren()) do
&#9;&#9;if v.className == &quot;Hint&quot; then
&#9;&#9;&#9;v:remove()
&#9;&#9;end
&#9;end
&#9;if Plane:findFirstChild(&quot;Hyper&quot;) ~= nil then 
&#9;&#9;Plane.Hyper:Remove()
&#9;end
&#9;if Plane:findFirstChild(&quot;Hyper1&quot;) ~= nil then 
&#9;&#9;Plane.Hyper1:Remove()
&#9;end
&#9;local Plane = getPlane(game.Players.LocalPlayer)
&#9;if not Plane then return end
&#9;Plane.Engine.BodyPosition.maxForce = Vector3.new(0,0,0)
&#9;Plane.Engine.BodyGyro.maxTorque = Vector3.new(0,0,0)
&#9;Plane.BodyKit.Color1.Transparency = 0
&#9;Plane.BodyKit.Color2.Transparency = 0
&#9;Plane.BodyKit.Color3.Transparency = 0
&#9;Plane.BodyKit.Color4.Transparency = 0
end

script.Parent.Selected:connect(onSelected)
script.Parent.Deselected:connect(onDeselected)</ProtectedString>
