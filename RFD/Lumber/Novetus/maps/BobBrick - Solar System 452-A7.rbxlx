			</Item>
			<Item class="Script" referent="RBX3564">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Gui</string>
					<ProtectedString name="Source">--[[
&#9;Simple Reset GUI made for everyone who kept asking me
&#9;to make one. Here it is, your very simple GUI with only a 
&#9;few lines of coding. Basically, when you click the button,
&#9;this script will check if your player was found correctly,
&#9;see if your character is in the game, and if both of those
&#9;are true, then check if you have a humanoid, just in case.
&#9;If all returns true, it will set your Humanoid&apos;s Health to 0.

                               &#151;&lt;| crazyman32 |&gt;&#151;
]]

local player = script.Parent.Parent.Parent 
local gui = script.Parent 

function setup() 
&#9;gui.Reset.MouseButton1Click:connect(function() 
&#9;&#9;if ((player) and (player.Character) and (player.Character:findFirstChild(&quot;Humanoid&quot;))) then &#9;-- You don&apos;t need &apos;== true&apos;. It simply returns itself as true or false. This works for anything like this.
&#9;&#9;&#9;player.Character.Humanoid.Health = 0 
&#9;&#9;end 
&#9;end) 
end 

setup() </ProtectedString>
				</Properties>
			</Item>
		</Item>
	</Item>
