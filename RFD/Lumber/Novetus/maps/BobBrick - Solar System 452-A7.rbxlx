				<Item class="Script" referent="RBX3515">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">RocketScript</string>
						<ProtectedString name="Source">r = game:service(&quot;RunService&quot;)

shaft = script.Parent
position = shaft.Position

function fly()
&#9;direction = shaft.CFrame.lookVector 
&#9;position = position + 35*direction
&#9;error = position - shaft.Position
&#9;shaft.Velocity = 5*error
end

function findNearestTorso(pos)
&#9;local list = game.Workspace:children()
&#9;local torso = nil
&#9;local dist = 10
&#9;local temp = nil
&#9;local human = nil
&#9;local temp2 = nil
&#9;for x = 1, #list do
&#9;&#9;temp2 = list[x]
&#9;&#9;local safe = temp2:findFirstChild(&quot;Safe&quot;)
&#9;&#9;if (temp2.className == &quot;Model&quot;) and (temp2 ~= script.Parent) and (safe == nil) then
&#9;&#9;&#9;temp = temp2:findFirstChild(&quot;Torso&quot;)
&#9;&#9;&#9;human = temp2:findFirstChild(&quot;Humanoid&quot;)
&#9;&#9;&#9;if (temp ~= nil) and (human ~= nil) and (human.Health &gt; 0) then
&#9;&#9;&#9;&#9;if (temp.Position - pos).magnitude &lt; dist then
&#9;&#9;&#9;&#9;&#9;torso = temp
&#9;&#9;&#9;&#9;&#9;dist = (temp.Position - pos).magnitude
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;return torso
end

function onTouch(hit)
&#9;exp = game.Lighting.Explosion:Clone()
&#9;target = findNearestTorso(position)
&#9;if target ~= nil then
&#9;&#9;target.Parent.Humanoid.Health = target.Parent.Humanoid.Health - 10
&#9;end
&#9;if hit.Name == Shield then
&#9;&#9;hit.Power.Value = hit.Power.Value - 1
&#9;&#9;if hit.Power.Value &lt;= 0 then
&#9;&#9;&#9;game.Lighting.Destroyed:Clone().Parent = hit.Parent
&#9;&#9;&#9;hit:Remove()
&#9;&#9;end
&#9;end
&#9;exp.CFrame = shaft.CFrame
&#9;exp.Parent = game.Workspace
&#9;shaft:Remove()
&#9;wait(1)
&#9;exp:Remove()
end

t, s = r.Stepped:wait()

d = t + 4.0 - s
connection = shaft.Touched:connect(onTouch)

while t &lt; d do
&#9;fly()
&#9;t = r.Stepped:wait()
end

shaft:Remove()
</ProtectedString>
