					<ProtectedString name="Source">--  ~~~NZ~~~  (NintendoZACHERY)

--Info: To Use This Just Inset A Model Inside This Tool And Change The Name Where It Says Below

bin = script.Parent
function onButton1Down(mouse)

&#9;local model = bin.Crate4:clone() --Change &quot;Plane&quot; to What Ever Model Name You Have
&#9;model.Parent = game.Workspace
&#9;model:MakeJoints()
&#9;model:MoveTo(mouse.hit.p)bin:remove()
end
function onSelected(mouse)
&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end

bin.Selected:connect(onSelected)</ProtectedString>
