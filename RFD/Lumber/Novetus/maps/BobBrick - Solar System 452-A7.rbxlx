enabled = true
function onButton1Down(mouse)
&#9;if not enabled then
&#9;&#9;return
&#9;end

&#9;enabled = false
&#9;mouse.Icon = &quot;http://www.roblox.com/asset/?version=1&amp;id=1279200&quot;

&#9;wait(5)
&#9;mouse.Icon = &quot;http://www.roblox.com/asset/?version=1&amp;id=1279200&quot;
&#9;enabled = true

end

