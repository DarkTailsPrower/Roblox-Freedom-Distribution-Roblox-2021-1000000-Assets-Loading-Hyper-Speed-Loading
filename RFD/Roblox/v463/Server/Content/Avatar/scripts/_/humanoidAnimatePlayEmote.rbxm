&#9;&#9;&#9;&#9;{ id = &quot;rbxassetid://129967390&quot;, weight = 10 }
--&#9;&#9;&#9;&#9;{ id = &quot;slash.xml&quot;, weight = 10 }
&#9;&#9;&#9;},
&#9;toollunge = {
&#9;&#9;&#9;&#9;{ id = &quot;rbxassetid://129967478&quot;, weight = 10 }
&#9;&#9;&#9;},
&#9;wave = {
&#9;&#9;&#9;&#9;{ id = &quot;rbxassetid://128777973&quot;, weight = 10 }
&#9;&#9;&#9;},
