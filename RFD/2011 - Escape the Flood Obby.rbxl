				<string name="Name">Tools,Boards, and Hats Cleanup</string>
				<ProtectedString name="Source">--&#9;&#9;&#9;&#9;&#9;Meganet&apos;s Cleanup Script V0.5&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;    --
--[[ This was made by meganet 
so do not claim for yourself, simple guidelines are included from the script&apos;s point of view
i know this script is basic and old but it honestly wasn&apos;t a big project and took about 5 mins to make
so think about it before you complain to me
I might make future updates if this becomes Popular ]]

--declarations and options
Showmessage = false -- True or False to toggle message On or Off
removeboards = true -- True or False to toggle whether or not to remove boards
removetools = true -- True or False to toggle whether or not to remove tools
removehats = true -- True or False to toggle whether or not to remove hats

countdown = 150 -- Keeps the Countdown Time, change to time you want
resettime = 150 -- Reset time, make same Value as above

warner = Instance.new(&quot;Hint&quot;)  -- I make a Text to warn people about the cleanup

function CleanBoards() -- I&apos;ll Clean the unused skateboards
local boardsearch = game.Workspace:getChildren() -- ROBLOX MADE BOARDS
&#9;for i=1,#boardsearch do
&#9;&#9;if (boardsearch[i].Name == &quot;InsertedObject23154619&quot;) and (removeboards == true) then
&#9;&#9;&#9;boardsearch[i]:remove() -- Removes
&#9;&#9;end
&#9;end
local boardsearchs = game.Workspace:getChildren() -- MY or Player made Boards
&#9;for i=1,#boardsearchs do
&#9;&#9;if (boardsearchs[i].Name == &quot;Board&quot;) and (removeboards == true) then
&#9;&#9;&#9;boardsearchs[i]:remove() -- Aww i wanted to skate
&#9;&#9;end
&#9;end
end

function CleanTools() -- Cleans up unused tools
local toolsearch = game.Workspace:getChildren() -- Gets all the stuff in the workspace
&#9;for i=1,#toolsearch do
&#9;&#9;if (toolsearch[i].className == &quot;Tool&quot;) and (removetools == true) then -- Checks if any are tools
&#9;&#9;&#9;toolsearch[i]:remove() -- Removes if Found
&#9;&#9;end
&#9;end
end 

function CleanHats() -- I&apos;ll get the Hats, but i don&apos;t get to wear them :(
local hatsearch = game.Workspace:getChildren() -- Gets all the stuff in the workspace
&#9;for i=1,#hatsearch do
&#9;&#9;if (hatsearch[i].className == &quot;Hat&quot;) and (removehats == true) then -- Checks if any are hats
&#9;&#9;&#9;hatsearch[i]:remove() -- Removes if Found
&#9;&#9;end
&#9;end
end 


function CleanTime()
-- Time to run the cleanup functions..... again T_T
print(&quot;Activating Meganet&apos;s Cleanup&quot;) -- Tell&apos;s the debugger I&apos;m Working
CleanTools() -- I&apos;ll use my functions defined earlier
print(&quot;Cleaned Tools&quot;) -- Tell&apos;s the debugger I&apos;m Working
CleanBoards()
print(&quot;Cleaned Boards&quot;) -- Tell&apos;s the debugger I&apos;m Working
CleanHats()
print(&quot;Cleaned Hats&quot;) -- Tell&apos;s the debugger I&apos;m Working
wait(3) -- Time To relax a little &lt;(-_-)&gt; {sigh}
print(&quot;Starting Over&quot;) -- Tell&apos;s the debugger I&apos;m Working
end -- Back from the top, Meh *_*

while true do 
Wait(1)
countdown = countdown - 1
if countdown &lt; 1 then -- I&apos;ll Check if it&apos;s time for the Clean yet
countdown = resettime
warner.Text = &quot;Cleaning Up&quot;
CleanTime() -- Let me clean the place
warner.Text = &quot;Cleaned Up!&quot;
wait(3)
end
if (Showmessage == true) then
warner.Parent = game.Workspace
warner.Text = &quot;Cleanup in &quot;..countdown..&quot; seconds...&quot;
print(&quot;Meganet&apos;s Cleanup Script will Clean &quot;..countdown..&quot; seconds...&quot;) -- Tell&apos;s the debugger I&apos;m Working
end
end





