			<Item class="Script" referent="RBX507">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">HealthTaker</string>
					<ProtectedString name="Source">function onTouched(hit)
script.Parent.Health.Value = script.Parent.Health.Value - 2
end
script.Parent.hit2.Touched:connect(onTouched)
while true do
wait()
script.Parent.Name = &quot;Health: &quot;..script.Parent.Health.Value..&quot;/&quot;..script.Parent.MaxHealth.Value
if script.Parent.Health.Value &lt;= 0 then
s = Instance.new(&quot;Smoke&quot;)
s.Parent = script.Parent.Bottom
s.Size = 13
wait(2)
f = Instance.new(&quot;Fire&quot;)
f.Parent = script.Parent.Bottom
f.Heat = 25
f.Size = 13
wait(3)
x = Instance.new(&quot;Explosion&quot;)
x.Parent = game.Workspace
x.BlastPressure = 10000
x.Position = script.Parent.Bottom.Position
wait(5)
script.Parent:Remove()
end
end
</ProtectedString>
				</Properties>
