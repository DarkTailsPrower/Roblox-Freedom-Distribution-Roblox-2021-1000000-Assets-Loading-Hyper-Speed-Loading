					</Item>
					<Item class="Script" referent="RBX328">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Main</string>
							<ProtectedString name="Source">local speed = 0
local box = script.Parent.Frame.Speed
local frame = box.Parent 
local mainGUI = frame.Parent
local player = mainGUI.Parent.Parent
local torso = player.Character.Torso

while true do
if torso ~= nil then 
speed = math.floor(math.sqrt((torso.Velocity.x^2)+(torso.Velocity.y^2)+(torso.Velocity.z^2)))
box.Text = &quot;MPH: &quot; .. speed 
elseif torso == nil then 
box.Text = player.Name .. &quot; has no torso&quot;
end 
wait() 
end 


</ProtectedString>
						</Properties>
					</Item>
				</Item>
				<Item class="Script" referent="RBX329">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Give</string>
						<ProtectedString name="Source">a = script.Parent.Settings
b = a:Clone()

function onChildAdded(child)
if child.Name == &quot;SeatWeld&quot; then
if child.Part1.Name == &quot;Torso&quot; then
player = game.Players:GetPlayerFromCharacter(child.Part1.Parent)
if player ~= nil then
tool = b:Clone()
tool.Parent = player.PlayerGui
end
end
end
end

function onChildRemoved()
if tool ~= nil then
tool:Remove()
end
end

script.Parent.ChildAdded:connect(onChildAdded)
script.Parent.ChildRemoved:connect(onChildRemoved)

</ProtectedString>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX330">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">a = script.Parent.Settings
b = a:Clone()

function onChildAdded(add)
script.Parent.Play:play()
wait()
s1 = script.Parent.Parent.SmokePipe.S1
wait()
s1.Enabled = true
s2 = script.Parent.Parent.SmokePipe.S2
wait()
s2.Enabled = true
wait()
script.Parent.Parent.Light.BrickColor = BrickColor.new(&quot;Bright yellow&quot;)
wait()
script.Parent.Parent.Light2.Transparency = 0.8
end
script.Parent.ChildAdded:connect(onChildAdded)

function onChildRemoved(remove)
script.Parent.Play:stop()
wait()
s1 = script.Parent.Parent.SmokePipe.S1
wait()
s1.Enabled = false
s2 = script.Parent.Parent.SmokePipe.S2
wait()
s2.Enabled = false
wait()
script.Parent.Parent.Light.BrickColor = BrickColor.new(&quot;White&quot;)
wait()
script.Parent.Parent.Light2.Transparency = 1
end
script.Parent.ChildRemoved:connect(onChildRemoved)</ProtectedString>
