									<string name="Name">Script</string>
									<ProtectedString name="Source">function onClicked(click)
script.Parent.Parent.Song:stop()
wait()
script.Parent.Parent.On.Visible = true
wait()
script.Parent.Visible = false
end
script.Parent.MouseButton1Down:connect(onClicked)</ProtectedString>
