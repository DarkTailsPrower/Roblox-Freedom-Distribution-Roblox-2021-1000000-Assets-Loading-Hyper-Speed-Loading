					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">KillbotScript</string>
					<ProtectedString name="Source">--CHANGE THESE IF YOU WANT TO BALANCE THE GAME ACCORDING TO HOW LARGE YOUR MAP IS.
local minwaveforheavy = 2
local minwaveforagility = 4
local minwaveforcommander = 10
local commanderrarity = 5
--DON&apos;T CHANGE ANYTHING BELOW

local sphere = script.Parent.Head

pcall(function() 
	sphere.Material = &quot;DiamondPlate&quot;
end)

local myTarget = nil

--wait for heavies
wait(0.2)
local speed = 40
local speedtype = math.random(1,commanderrarity)
if game.Lighting.WaveNeedsBoss.Value == true then
speed = 15
elseif speedtype == 5 and game.Lighting.Wave.Value &gt; minwaveforcommander then
speed = math.random(15,70)
else
speed = math.random(30,70)
end
local HPDef = 100
local unitname = &quot;Grunt&quot;
local gibsize = Vector3.new(1.3,1.3,1.3)
if speed &lt; 25 and game.Lighting.WaveNeedsBoss.Value == true then
unitname = &quot;Prime Commander&quot;
sphere.Size = Vector3.new(6,6,6)
sphere.Reflectance = 1
HPDef = 1500
gibsize = Vector3.new(2,2,2)
elseif speed &lt; 25 and game.Lighting.Wave.Value &gt; minwaveforcommander and game.Lighting.WaveNeedsBoss.Value == false then
unitname = &quot;Commander&quot;
sphere.Size = Vector3.new(4,4,4)
sphere.Reflectance = 0.8
HPDef = 350
gibsize = Vector3.new(1,1,1)
elseif speed &gt; 55 and game.Lighting.Wave.Value &gt; minwaveforagility then
unitname = &quot;Agility&quot;
sphere.Size = Vector3.new(2,2,2)
sphere.Reflectance = 0.1
HPDef = 50
gibsize = Vector3.new(0.8,0.8,0.8)
elseif speed &lt; 40 and game.Lighting.Wave.Value &gt; minwaveforheavy then
unitname = &quot;Heavy&quot;
sphere.Size = Vector3.new(5,5,5)
sphere.Reflectance = 0.4
HPDef = 200
gibsize = Vector3.new(2,2,2)
else
speed = math.random(40,55)
end

local HP = HPDef
local id = math.random(2,99999)
local isOnFire = false

if speed &lt; 25 and game.Lighting.WaveNeedsBoss.Value == true then
id = 1
end

script.Parent.Name = &quot;Killbot &quot;..unitname..&quot;&quot;..speed..&quot; Unit #&quot;..id..&quot; | HP: &quot;..HP..&quot;/&quot;..HPDef

local trophism = 80

--wait for heavies
wait(0.2)
script.Parent.Humanoid.MaxHealth = HPDef
script.Parent.Humanoid.Health = HPDef

script.Parent.Death.PlayOnRemove = true 

--give us a color to diferenciate ourselves
sphere.BrickColor = BrickColor.random()

-- obtain goals based on Sphere part
sphere.BodyPosition.position = sphere.Position

-- this code hijacked from the new rocket launcher
local Rocket = Instance.new(&quot;Part&quot;)
Rocket.Locked = true
Rocket.BackSurface = 3
Rocket.BottomSurface = 3
Rocket.FrontSurface = 3
Rocket.LeftSurface = 3
Rocket.RightSurface = 3
Rocket.TopSurface = 3
Rocket.Size = Vector3.new(1,1,4)
Rocket.BrickColor = BrickColor.new(21)
script.Parent.RocketScript:clone().Parent = Rocket
script.Parent.Explosion:clone().Parent = Rocket
script.Parent.Swoosh:clone().Parent = Rocket

local gib = Instance.new(&quot;Part&quot;)
gib.Name = &quot;KillbotMetal&quot; 
gib.BackSurface = 0
gib.BottomSurface = 0
gib.FrontSurface = 0
gib.LeftSurface = 0
gib.RightSurface = 0
gib.TopSurface = 0
gib.Shape = 1 -- block
gib.formFactor = 2 -- plate
gib.Size = Vector3.new(1,.4,1)
gib.Reflectance = sphere.Reflectance
pcall(function() 
	gib.Material = &quot;DiamondPlate&quot;
end)
script.Parent.BrickCleanup:clone().Parent = gib

local gib2 = Instance.new(&quot;Part&quot;)
gib2.Name = &quot;KillbotGib&quot; 
gib2.BackSurface = 0
gib2.BottomSurface = 0
gib2.FrontSurface = 0
gib2.LeftSurface = 0
gib2.RightSurface = 0
gib2.TopSurface = 0
gib2.Size = gibsize
gib2.BrickColor = sphere.BrickColor
gib2.Reflectance = sphere.Reflectance
pcall(function() 
	gib2.Material = &quot;DiamondPlate&quot;
end)
script.Parent.BrickCleanup:clone().Parent = gib2

function fire(target)
	local dir = target - sphere.Position
	dir = computeDirection(dir)
	local missile = Rocket:clone()

	local spawnPos = sphere.Position

	local pos = spawnPos + (dir * 8)
	
	if speed &lt; 25 and game.Lighting.WaveNeedsBoss.Value == true then
		local spread = 5
		local rotation = missile.CFrame - missile.Position
		missile.CFrame = CFrame.new(pos,  pos + dir) + Vector3.new(math.random(-spread,spread),math.random(-spread,spread),math.random(-spread,spread))
	else
		--missile.Position = pos
		missile.CFrame = CFrame.new(pos,  pos + dir)
	end
	missile.RocketScript.Disabled = false
	missile.Parent = game.Workspace
end

function computeDirection(vec)
	local lenSquared = vec.magnitude * vec.magnitude
	local invSqrt = 1 / math.sqrt(lenSquared)
	return Vector3.new(vec.x * invSqrt, vec.y * invSqrt, vec.z * invSqrt)
end

function scanForHumans()
	-- KILL THE HUMANS!!!!!!!!!!

	-- for now, pick a random one. In the future, pick the closest. Or use hit test to pick a visible one.
	local humansFound = {}

	local players = game.Players:children()

	if (#players &lt; 1) then return end

	local i = math.random(1, #players)

	myTarget = players[i].Character
	
end

function moveKillbot()
	
	-- killbots move using a biased random walk toward the target
	-- they also like to float at least 10 studs above the ground

	local dx = math.random(-100,100)
	local dy = math.random(-speed,speed)
	local dz = math.random(-100,100)

	if (sphere.Position.y &lt; 10 and dy &lt; 0) then dy = -dy end
	if (sphere.Position.y &gt; trophism and dy &gt; 0) then dy = -dy end

	if (myTarget ~= nil and myTarget.Humanoid ~= nil and myTarget.Humanoid.Health &gt; 0 and myTarget:findFirstChild(&quot;Torso&quot;)) then
		local dir = computeDirection(myTarget.Torso.Position - sphere.Position)
		dx = dx + (dir.x * trophism) -- change this number to alter player trophism
		dy = dy + (dir.y * trophism) 
		dz = dz + (dir.z * trophism)
	end

	local vec = computeDirection(Vector3.new(dx,dy,dz))

	sphere.BodyPosition.position = sphere.Position + (vec * speed) -- change this number to alter speed
end

function onTouched(hit)
	if hit.Parent then
		local humanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
		if humanoid~=nil then
			if hit.Parent:findFirstChild(&quot;IsKillbot&quot;) == nil then
				humanoid.Health = humanoid.Health - 2000 -- Killbots kill you when you touch them! duh.
			end
		else
			-- sadly, there is no good way to give a killbot hit points, so one hit with any weapon kills them
			--script.Parent.Parent = nil
			if HP &gt; 0 then
				onDamaged(hit)
			else
				onKilled(hit)
			end
		end
	end
end

sphere.Touched:connect(onTouched)

function onDamaged(hit)
	--todo: make it so we detect if a part has a damage value, if true, it will provide us the hp
	if hit:findFirstChild(&quot;Damage&quot;) then
		if hit.Damage.className == &quot;NumberValue&quot; then
			if speed &lt; 25 and game.Lighting.WaveNeedsBoss.Value == true then
				HP = HP - (hit.Damage.Value - 7)
			elseif speed &lt; 25 and game.Lighting.Wave.Value &gt; minwaveforcommander and game.Lighting.WaveNeedsBoss.Value == false then
				HP = HP - (hit.Damage.Value - 2)
			else
				HP = HP - hit.Damage.Value
			end
			script.Parent.Humanoid.Health = HP 
			script.Parent.Name = &quot;Killbot &quot;..unitname..&quot;&quot;..speed..&quot;Unit #&quot;..id..&quot; | HP: &quot;..HP..&quot;/&quot;..HPDef
			
			if HP &lt; 30 and isOnFire == false then
				pcall(function() 
					local deathfire = Instance.new(&quot;Fire&quot;)
					deathfire.Size = sphere.Size.x * sphere.Size.y
					deathfire.Heat = 15
					deathfire.Parent = sphere
				end)
				isOnFire = true
			end

			for n=1,3 do
				local dir = sphere.Position
				local gibPart = gib:clone()
				if math.random(1,3) == 3 then
					gib.BrickColor = BrickColor.new(27)
					gib.Reflectance = 0.4
				else
					gib.BrickColor = sphere.BrickColor
				end
				gibPart.BrickCleanup.Disabled = false
				gibPart.Position = Vector3.new(dir.x+math.random(1,10),dir.y + 10,dir.z+math.random(1,10))
				gibPart.CFrame = CFrame.new(dir,Vector3.new(dir.x+math.random(1,10),dir.y+math.random(1,10),dir.z+math.random(1,10)))
				gibPart.Parent = game.Workspace
			end
			if hit.Damage.Value &lt; 45 then
			hit = script.Parent.Hit
			hit:play()
			else
			heavy = script.Parent.Hit_Heavy
			heavy:play()
			end
		end
	end
end

function onKilled(hit)
	for n=1,4 do
			local dir = sphere.Position
			local gibPart = gib2:clone()
			gibPart.BrickCleanup.Disabled = false
			gibPart.Position = Vector3.new(dir.x+math.random(1,10),dir.y + 10,dir.z+math.random(1,10))
			gibPart.CFrame = CFrame.new(dir,Vector3.new(dir.x+math.random(1,10),dir.y+math.random(1,10),dir.z+math.random(1,10)))

			pcall(function() 
				local deathfire = Instance.new(&quot;Fire&quot;)
				deathfire.Size = gibPart.Size.x * gibPart.Size.y
				deathfire.Heat = 15
				deathfire.Parent = gibPart
			end)

			gibPart.Parent = game.Workspace
	end
	explosion = Instance.new(&quot;Explosion&quot;)
	explosion.Position = sphere.Position
	explosion.Parent = game.Workspace
	game.Lighting.EnemyCount.Value = game.Lighting.EnemyCount.Value - 1
	script.Parent:remove()
end

while true do  -- loop forever
	scanForHumans()
	for n=1,5 do
		if (myTarget ~= nil and myTarget.Humanoid ~= nil and myTarget.Humanoid.Health &gt; 0 and myTarget:findFirstChild(&quot;Torso&quot;)) then
			local randomval = math.random(1,2)
			-- speed demons fire faster
			if speed &lt; 25 and game.Lighting.WaveNeedsBoss.Value == true then
				randomval = 2
			elseif speed &lt; 25 and game.Lighting.Wave.Value &gt; minwaveforcommander and game.Lighting.WaveNeedsBoss.Value == false then
				randomval = 1
			elseif speed &gt; 55 then
				randomval = 2
			end

			if(randomval == 2) then fire(myTarget.Torso.Position) end
			
			if speed &lt; 25 and game.Lighting.WaveNeedsBoss.Value == true then
				wait(1.3)
			elseif speed &lt; 25 and game.Lighting.Wave.Value &gt; minwaveforcommander and game.Lighting.WaveNeedsBoss.Value == false then
				wait(1.5)
			elseif speed &gt; 55 then
				wait(2)
			elseif speed &lt; 40 then
				wait(3)
			else
				wait(math.random(1,2))
			end

			moveKillbot()

			if speed &lt; 25 and game.Lighting.WaveNeedsBoss.Value == true then
				wait(1.3)
			elseif speed &lt; 25 and game.Lighting.Wave.Value &gt; minwaveforcommander and game.Lighting.WaveNeedsBoss.Value == false then
				wait(1.5)
			elseif speed &gt; 55 then
				wait(2)
			elseif speed &lt; 40 then
				wait(3)
			else
				wait(math.random(1,2))
			end
		end
	end
	wait(1) -- don&apos;t hog CPU
end
