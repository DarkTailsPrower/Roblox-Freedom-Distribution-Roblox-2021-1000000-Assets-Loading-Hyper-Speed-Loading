				<string name="Source">model = game.Workspace.RegenWindows
messageText = &quot;Regenerating the Ill-fated Windows&quot;

message = Instance.new(&quot;Message&quot;)
message.Text = messageText
backup = model:clone()

while true do
	wait(600 * (1-math.random()*0.5))

	message.Parent = game.Workspace
	model:remove()

	wait(4)

	model = backup:clone()
	model.Parent = game.Workspace
	model:makeJoints()
	message.Parent = nil
end
