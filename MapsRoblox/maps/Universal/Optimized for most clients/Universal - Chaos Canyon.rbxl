					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">FireShot</string>
					<string name="Source">fire = script.Parent
damage = 3.3

function onTouched(hit)
	local humanoid = hit.Parent:findFirstChild("Humanoid")
	if humanoid~=nil then
		tagHumanoid(humanoid)
		humanoid.Health = humanoid.Health - damage
		wait(2)
		untagHumanoid(humanoid)
		connection:disconnect()
	else
		damage = damage / 2
		if damage &lt; 0.1 then
			connection:disconnect()
		end
	end
end

function tagHumanoid(humanoid)
	-- todo: make tag expire
	local tag = fire:findFirstChild("creator")
	if tag ~= nil then
		local new_tag = tag:clone()
		new_tag.Parent = humanoid
	end
end


function untagHumanoid(humanoid)
	if humanoid ~= nil then
		local tag = humanoid:findFirstChild("creator")
		if tag ~= nil then
			tag.Parent = nil
		end
	end
end

connection = fire.Touched:connect(onTouched)

r = game:service("RunService")
t, s = r.Stepped:wait()
d = t + 2.0 - s
madeGrey = false
while t &lt; d do
	t = r.Stepped:wait()
	if madeGrey == false and d-t &lt; .7 then
		madeGrey = true
		fire.BrickColor = BrickColor.new(.4,.4,.4)
	end
end

fire.Parent = nil</string>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX1934">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">ThrowerScript</string>
					<string name="Source">print("Flamethrower script loaded")

bin = script.Parent

shooting = false
reloadtime = 0

local colors = {21, 106, 105, 24, 226, 1, 226, 24, 105, 106} 

function fire(v)

	sound = Instance.new("Sound")
	sound.SoundId = "rbxasset://sounds\\Launching rocket.wav"
	sound.Parent = script.Parent
	sound:play()

	local missile = Instance.new("Part")

	local spawnPos = game.Players.LocalPlayer.Character.PrimaryPart.Position
	spawnPos = spawnPos + (v * 7)

	missile.Name = "Fire"

	local dx = (math.random() - .5) * 100
	local dy = (math.random() - .5) * 100
	local dz = (math.random() - .5) * 100

	missile.CFrame = CFrame.new(spawnPos, Vector3.new(dx,dy,dz))
	missile.Size = Vector3.new(1,1,1)
	missile.Velocity = v * 100
	missile.BrickColor = BrickColor.new(colors[math.random(1, 10)])
	missile.Shape = 2

	local new_script = script.Parent.FireShot:clone()
	new_script.Disabled = false
	new_script.Parent = missile

	local creator_tag = Instance.new("ObjectValue")
	creator_tag.Value = game.Players.LocalPlayer
	creator_tag.Name = "creator"
	creator_tag.Parent = missile
	
	missile.Parent = game.Workspace
	sound:remove()
end


function onButton1Down(mouse)
	if reloadtime &gt; 0 then return end
	if shooting == true then return end
	print("start shooting")
	reloadtime = 4.0
	shooting = true

	local time = 0
	while shooting == true do

		local cf = mouse.Hit
		local v = cf.lookVector
		local dx = (math.random() - .5) * .2
		local dy = (math.random() - .5) * .2
		local dz = (math.random() - .5) * .2

		fire(Vector3.new(v.x + dx, v.y + dy, v.z + dz))
		wait(.05)
		time = time + .05
		if time &gt; 2.0 then shooting = false end
	end
	print("stop shooting")
	mouse.Icon = "rbxasset://textures\\GunWaitCursor.png"
	while reloadtime &gt; 0 do
		wait(0.1)
		reloadtime = reloadtime - 0.1
	end
	reloadtime = 0
	mouse.Icon = "rbxasset://textures\\GunCursor.png"
end

function onButton1Up(mouse)
	shooting = false
end

function onSelected(mouse)
	print("flamethrower selected")
	if reloadtime &gt; 0 then
		mouse.Icon = "rbxasset://textures\\GunWaitCursor.png"
		while reloadtime &gt; 0 do
			wait(0.1)
			reloadtime = reloadtime - 0.1
		end
		mouse.Icon = "rbxasset://textures\\GunCursor.png"
	else
		mouse.Icon = "rbxasset://textures\\GunCursor.png"
	end
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
	mouse.Button1Up:connect(function() onButton1Up(mouse) end)
end

bin.Selected:connect(onSelected)




