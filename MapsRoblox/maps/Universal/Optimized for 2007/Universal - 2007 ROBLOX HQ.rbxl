			<Item class="Script" referent="RBX3372">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">RemoveSnaps</string>
					<string name="Source">p= game.Workspace:GetChildren()			
for i= 1, #p do				
if p[i].className == "Part" then
if p[i].Anchored == true then
p[i]:BreakJoints()
end
elseif p[i].className == "Model" then
pp=p[i]:GetChildren()
for i=1, #pp do
if p[i].className == "Part" then
if p[i].Anchored == true then
p[i]:BreakJoints()
end
end
end
end
end</string>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
