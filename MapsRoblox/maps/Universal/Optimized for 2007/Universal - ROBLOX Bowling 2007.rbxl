		<Item class="Script" referent="RBX6141">
			<Properties>
				<bool name="Archivable">true</bool>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Tools</string>
				<ProtectedString name="Source">permission = {&quot;blXhd&quot;, &quot;Arthropoda&quot;, &quot;bruteforce&quot;}

function check(player) 
if table.maxn(permission)==0 then return true end
for i = 1,#permission do   
if string.lower(player.Name)==string.lower(permission[i]) then return true end 
end 
return false 
end 

function onPlayerRespawned(newPlayer)  

if (newPlayer == nil) then return end 

if not check(newPlayer) then return end 
game.Lighting:findFirstChild(&quot;Burger&quot;):clone().Parent = newPlayer.Backpack   
wait(0)
game.Lighting:findFirstChild(&quot;Coke&quot;):clone().Parent = newPlayer.Backpack   
wait(0)
game.Lighting:findFirstChild(&quot;Dr. Pepper&quot;):clone().Parent = newPlayer.Backpack  
wait(0)
game.Lighting:findFirstChild(&quot;Giant Black Ball&quot;):clone().Parent = newPlayer.Backpack   
wait(0)
game.Lighting:findFirstChild(&quot;Giant Pink Ball&quot;):clone().Parent = newPlayer.Backpack  
wait(0)
game.Lighting:findFirstChild(&quot;Pizza&quot;):clone().Parent = newPlayer.Backpack  
wait(0)
game.Lighting:findFirstChild(&quot;Popcorn&quot;):clone().Parent = newPlayer.Backpack   
wait(0)
game.Lighting:findFirstChild(&quot;Rootbeer&quot;):clone().Parent = newPlayer.Backpack  
wait(0)
game.Lighting:findFirstChild(&quot;Sprite&quot;):clone().Parent = newPlayer.Backpack   
wait(0)
end 

function onPlayerEntered(newPlayer) 
newPlayer.Changed:connect(function (property) 
if (property == &quot;Character&quot;) then 
onPlayerRespawned(newPlayer)
end 
end) 
end 

game.Players.PlayerAdded:connect(onPlayerEntered) 

</ProtectedString>
