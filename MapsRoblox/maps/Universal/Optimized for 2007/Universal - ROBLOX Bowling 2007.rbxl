					<Item class="Script" referent="RBX6071">
						<Properties>
							<bool name="Archivable">true</bool>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">function onClicked()

script.Parent.ClickDetector.MaxActivationDistance = 0

script.Parent.BrickColor = BrickColor.new (21)

m = script.Parent.Parent.Ball:Clone()

m.Parent = game.Workspace

m.Handle.CanCollide = true

m.Handle.Anchored = false

m.Handle.Transparency = 0

m.Enabled = true

wait(7)

script.Parent.ClickDetector.MaxActivationDistance = 30

script.Parent.BrickColor = BrickColor.new (28)

end

script.Parent.ClickDetector.MouseClick:connect(onClicked)</ProtectedString>
