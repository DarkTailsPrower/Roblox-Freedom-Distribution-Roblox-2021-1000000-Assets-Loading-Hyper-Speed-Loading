				<string name="Name">RemoveTool</string>
				<ProtectedString name="Source">while true do
	wait(5)
	local m = script.Parent:GetChildren()
	for i = 1, #m do

		if m[i].className == &quot;Tool&quot; then
			m[i]:Remove()


		end

	end
end


</ProtectedString>
