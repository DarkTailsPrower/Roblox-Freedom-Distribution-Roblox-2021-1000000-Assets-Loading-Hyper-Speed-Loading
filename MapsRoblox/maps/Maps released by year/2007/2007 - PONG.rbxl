--QUICK MATH
function Round(val)
	local low = math.floor(val)
	local rem = val - low
	if (rem&gt;=0.5) then
		return math.ceiling(val)
	else
		return low
	end
end

bin = script.Parent
--External Sources
playerX = bin.PlayerX--Controller X
playerY = bin.PlayerY --Controller Y
player2X = bin.Player2X--Controller 2 X
player2Y = bin.Player2Y --Controller 2 Y
pause = bin.Pause

--Screen Declarations
screen = bin.HDScreen
scrn_bg = bin.ScreenBG.Value
scrn_clr = bin.ScreenColor.Value

--Game Variables
p1_x = playerX.Value
p1_y = playerY.Value
p1_s = 4
p1_score = 0
p2_x = 59
p2_y = 24
p2_s = 4
p2_score = 0
b_x = 32
b_y = 24
b_s = 1
b_dx = Round(math.random(-1,1))
b_dy = Round(math.random(-1,1))

--FUNCTION DECLARATIONS!
function ClearScreen() --In case we need to clear everything
	for x = 0,64 do
		for y = 0,48 do
			local pix = screen:findFirstChild(x..&quot;x&quot;..y)
			if (pix~=nil) then
				pix.Color = scrn_bg
			end
		end
	end
end
function DrawPix(x,y,clr) --The Graphics Engine
	local pix = screen:findFirstChild(x..&quot;x&quot;..y)
	if (pix~=nil) then
		pix.Color = clr
	end
end
function CheckCollide(x1,y1,plr) --The Physics Engine
	if (plr==1) then --Check player 1
		local collided_y=false
		for y = p1_y-(p1_s/2),p1_y+(p1_s/2) do
			if (y1==Round(y)) then
				collided_y=true
				break
			end
		end
		if (collided_y==true) then
			if (x1-1==p1_x or x1==p1_x) then --FULL COLLISION
				return true
			end
		end
		return false
	else --Check Player 2
		local collided_y=false
		for y = p2_y-(p2_s/2),p2_y+(p2_s/2) do
			if (y1==Round(y)) then
				collided_y=true
				break
			end
		end
		if (collided_y==true) then
			if (x1+1==p2_x or x1==p2_x) then --FULL COLLISION
				return true
			end
		end
		return false
	end
end
function RunAI() --Super Simple CPU AI script
	if (b_y&gt;p2_y) then
		DrawPix(p2_x,p2_y,scrn_bg) --Clear Last
		p2_y=p2_y+1
		DrawPix(p2_x,p2_y,scrn_clr)
	end
	if (b_y&lt;p2_y) then
		DrawPix(p2_x,p2_y,scrn_bg)
		p2_y=p2_y-1
		DrawPix(p2_x,p2_y,scrn_clr)
	end
end
function UpdateBall() --Automated systems
	DrawPix(b_x,b_y,scrn_bg) --Clear Last
	if (b_dx==0) then --Stalled
		b_dx = Round(math.random(-1,1))
		b_dy = Round(math.random(-1,1))
	end
	b_x=b_x+b_dx
	b_y=b_y+b_dy
	if (CheckCollide(b_x,b_y,1)==true) then --Collided with Player 1
		b_dx = -b_dx
		b_dy = -(b_dy+Round(math.random(-1,1)))
	end
	if (CheckCollide(b_x,b_y,2)==true) then --Collided with Player 2
		b_dx = -b_dx
		b_dy = -(b_dy+Round(math.random(-1,1)))
	end
	if (b_y&gt;=47 or b_y&lt;=1) then --Bounce
		b_dy = -(b_dy)
	end
	if (b_x&lt;=0) then --Player 2 Scored!
		p2_score = p2_score + 1
		--Reset Game
		b_x = 32
		b_y = 24
		b_dx = Round(math.random(-1,1))
		b_dy = Round(math.random(-1,1))
		wait(3)
	end
	if (b_x&gt;=64) then --Player 1 Scored
		p1_score = p1_score + 1
		--Reset Game
		b_x = 32
		b_y = 24
		b_dx = Round(math.random(-1,1))
		b_dy = Round(math.random(-1,1))
		wait(3)
	end
	DrawPix(b_x,b_y,scrn_clr) --Draw New
end
function ClearPlayers()
	--Draw Player 1
	for y = p1_y-(p1_s/2),p1_y+(p1_s/2) do
		DrawPix(p1_x,y,scrn_bg)
	end
	--Draw Player 2
	for y2 = p2_y-(p2_s/2),p2_y+(p2_s/2) do
		DrawPix(p2_x,y2,scrn_bg)
	end
end
function DrawPlayers()
	--Draw Player 1
	for y = p1_y-(p1_s/2),p1_y+(p1_s/2) do
		DrawPix(p1_x,y,scrn_clr)
	end
	--Draw Player 2
	for y2 = p2_y-(p2_s/2),p2_y+(p2_s/2) do
		DrawPix(p2_x,y2,scrn_clr)
	end
end
function RemoveOld(face)
	local getChild = face:children()
	if (#getChild&gt;0) then
		local old_dig = getChild[1]
		if (old_dig~=nil) then
			old_dig:remove()
		end
	end
end
function DisplayVal(val,face)
	local bank = game.StarterPack.Digits
	if (val==-1) then
		local new_dig = bank.digitn:clone()
		new_dig.Parent = face
	end
	local getDig = bank:findFirstChild(&quot;digit&quot;..val)
	if (getDig~=nil) then
		local new_dig = getDig:clone()
		new_dig.Parent = face
	else
		local new_dig = bank.digitn:clone()
		new_dig.Parent = face
	end
end
function DrawScore() --Uggh, there has to be a better way!
	RemoveOld(bin.Player1Score)
	DisplayVal(p1_score,bin.Player1Score)
	RemoveOld(bin.Player2Score)
	DisplayVal(p2_score,bin.Player2Score)
end



--MAIN LOOP FINALY!
playGame = true --The exit code
ClearScreen()
while (playGame==true) do
	wait(0.1) --Keep Frame Rate!
	if (pause.Value==false) then
		UpdateBall()
		ClearPlayers()
		p1_x = playerX.Value
		p1_y = playerY.Value
		p2_x = player2X.Value
		p2_y = player2Y.Value
		DrawPlayers()
		DrawScore()

		if (p1_score&gt;=10 or p2_score&gt;=10) then --Game Over Reset!
			ClearScreen()
			playerX.Value = 5
			playerY.Value = 24
			player2X.Value = 59
			player2Y.Value = 24
			p1_score = 0
			p2_score = 0
			b_x = 32
			b_y = 24
			b_dx = Round(math.random(-1,1))
			b_dy = Round(math.random(-1,1))
			wait(3)
		end
	end
end
