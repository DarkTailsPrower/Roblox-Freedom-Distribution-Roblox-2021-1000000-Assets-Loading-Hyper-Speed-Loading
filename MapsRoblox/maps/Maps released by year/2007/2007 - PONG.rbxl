			<Item class="Script" referent="RBX3259">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">PongController</string>
					<string name="Source">print(&quot;RobloxPolice&apos;s Drive Action Tool!&quot;)

shooting = false
reloadtime = 0
time = 0
dir=1
turning=false
lastPiece=nil
bin=script.Parent

function CheckDistance(part1,part2)
	if (part1~=nil and part2~=nil) then
		local x1=part1.Position.x
		local y1=part1.Position.y
		local z1=part1.Position.z
		local x2=part2.Position.x
		local y2=part2.Position.y
		local z2=part2.Position.z
		local dist=(math.abs(x1-x2)+math.abs(y1-y2)+math.abs(z1-z2))/3 --Average Position?
		if (dist&lt;=8) then
			return true
		else
			return false
		end
	else
		return false
	end
end

function SetSpeed(car,spd,spd2)
	car.FL.RightParamA = -spd
	car.FL.RightParamB = spd
	car.BL.RightParamA = -spd
	car.BL.RightParamB = spd
	car.FR.LeftParamA = spd2
	car.FR.LeftParamB = -spd2
	car.BR.LeftParamA = spd2
	car.BR.LeftParamB = -spd2
end

function Execute(piece, com)
	com = com:lower()
	if (com==&quot;cntrl_up&quot;) then
		local plr_y = game.Workspace.PlayerY
		if (plr_y.Value&gt;1) then
			plr_y.Value = plr_y.Value - 1
		end
	end
	if (com==&quot;cntrl_down&quot;) then
		local plr_y = game.Workspace.PlayerY
		if (plr_y.Value&lt;47) then
			plr_y.Value = plr_y.Value + 1
		end
	end
	if (com==&quot;game_pause&quot;) then
		local pause = game.Workspace.Pause
		if (pause~=nil) then
			if (pause.Value==true) then
				pause.Value = false
			else
				pause.Value = true
			end
		end
		time = 4
	end
end

function onButton1Down(mouse)
	if reloadtime &gt; 0 then return end
	if shooting == true then return end
	reloadtime = 1.0
	shooting = true

	time = 0
	while shooting == true do
		--FIRE MECHANISM
		local part = mouse.Target
		local act = part:findFirstChild(&quot;Action&quot;)
		if (act~=nil) then
			lastPiece=part
			local body = bin.Parent.Parent.Character.Torso
			if (CheckDistance(part,body)==true) then
				local val = act.Value
				if (val~=nil) then
					Execute(part, val)
				end
			end
		end

		wait(.075)
		time = time + .1
		if time &gt; 3.5 then shooting = false end
	end
	mouse.Icon = &quot;rbxasset://textures\\GunWaitCursor.png&quot;
	wait(0.1)
	reloadtime = 0
	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
end

function onButton1Up(mouse)
	shooting = false
end

function onSelected(mouse)
	if reloadtime &gt; 0 then
		mouse.Icon = &quot;rbxasset://textures\\GunWaitCursor.png&quot;
	else
		mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	end
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
	mouse.Button1Up:connect(function() onButton1Up(mouse) end)
end

bin.Selected:connect(onSelected)
