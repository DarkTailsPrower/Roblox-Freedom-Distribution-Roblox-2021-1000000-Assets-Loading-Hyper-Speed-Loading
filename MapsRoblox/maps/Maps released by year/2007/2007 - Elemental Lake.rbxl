				<Item class="Script" referent="RBX850">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">MoveScriptToPlayer</string>
						<string name="Source">tool = script.Parent:clone()
function onTouched(part)
	if part.Parent ~= nil then
	local humanoid = part.Parent:findFirstChild(&quot;Humanoid&quot;)
	if humanoid and debounce==nil then
		debounce = true
		script.Parent.Handle.Anchored = false
		script.Parent = game.Workspace
		wait(math.random(30,60))
		tool:clone().Parent = game.Workspace
		script:remove()
		end
	end
end
script.Parent.Handle.Touched:connect(onTouched)</string>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
