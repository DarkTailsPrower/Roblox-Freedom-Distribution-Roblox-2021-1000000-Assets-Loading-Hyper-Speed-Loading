					<Item class="Script" referent="RBX2936">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">MoveScriptToPlayer</string>
							<string name="Source">function onTouched(part)
	if part.Parent ~= nil then
	local humanoid = part.Parent:findFirstChild(&quot;Humanoid&quot;)
	if humanoid and debounce==nil and humanoid.Parent:findFirstChild(&quot;Torso&quot;) ~= nil then
		debounce = true
		humanoid.Parent:findFirstChild(&quot;Torso&quot;).Velocity = Vector3.new(0,script.Parent.Size.y*10,0)
		wait(.5)
		debounce = nil
		end
	end
end
script.Parent.Touched:connect(onTouched)</string>
