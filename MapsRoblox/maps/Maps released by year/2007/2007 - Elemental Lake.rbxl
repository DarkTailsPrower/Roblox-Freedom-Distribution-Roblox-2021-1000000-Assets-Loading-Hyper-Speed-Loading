					<Item class="Script" referent="RBX2933">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<string name="Source">script.Parent.Parent:makeJoints()
script.Parent.BodyPosition.position = script.Parent.Position
while true do
wait(5)
while script.Parent.Size.y &lt; 20 do
wait()
script.Parent.Size = Vector3.new(script.Parent.Size.x, script.Parent.Size.y+1, script.Parent.Size.z)

end
wait(4)
while script.Parent.Size.y &gt; 2 do
wait()
script.Parent.Size = Vector3.new(script.Parent.Size.x, script.Parent.Size.y-1, script.Parent.Size.z)

end
wait(2)
end
</string>
