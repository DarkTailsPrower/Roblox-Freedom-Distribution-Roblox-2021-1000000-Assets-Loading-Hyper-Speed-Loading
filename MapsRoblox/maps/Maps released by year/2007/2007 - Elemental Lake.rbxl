					<Item class="Script" referent="RBX755">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">MoveScriptToPlayer</string>
							<string name="Source">function onTouched(part)
	if part.Parent ~= nil then
	local humanoid = part.Parent:findFirstChild(&quot;Humanoid&quot;)
	if humanoid and debounce==nil then
		debounce = true
		--script.Parent.Parent = nil
		humanoid.Health = humanoid.Health -20
		explosion = Instance.new(&quot;Explosion&quot;)
		explosion.BlastRadius = 3
		explosion.BlastPressure = 0
		explosion.Position = part.Position
		explosion.Parent = game.Workspace
		wait(1)
		debounce = nil
		end
	end
end
script.Parent.Touched:connect(onTouched)</string>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
