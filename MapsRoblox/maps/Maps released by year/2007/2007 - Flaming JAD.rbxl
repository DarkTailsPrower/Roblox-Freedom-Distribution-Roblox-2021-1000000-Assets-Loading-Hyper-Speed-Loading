		<Item class="Script" referent="RBX44">
			<Properties>
				<bool name="Disabled">true</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">BurnScript</string>
				<ProtectedString name="Source">function spread_fire(brickhit)
&#9;--FRONT texture--
&#9;newdecal0 = game.Workspace.Firestarter.BurnerDecal:Clone()
&#9;newdecal0.Name = &quot;BurningFRONT&quot;
&#9;newdecal0.Face = 5
&#9;newdecal0.Parent = brickhit
&#9;wait(.3)
&#9;
&#9;--TOP texture--
&#9;newdecal1 = game.Workspace.Firestarter.BurnerDecal:Clone()
&#9;newdecal1.Name = &quot;BurningTOP&quot;
&#9;newdecal1.Face = 1
&#9;newdecal1.Parent = brickhit
&#9;wait(.3)

&#9;--BACK texture--
&#9;newdecal2 = game.Workspace.Firestarter.BurnerDecal:Clone()
&#9;newdecal2.Name = &quot;BurningBACK&quot;
&#9;newdecal2.Face = 2
&#9;newdecal2.Parent = brickhit
&#9;wait(.3)

&#9;--Sparkles--
&#9;newsparkles = Instance.new(&quot;Sparkles&quot;)
&#9;newsparkles.Name = &quot;FireSparkles&quot;
&#9;newsparkles.Color = Color3.new(156, 51, 0)
&#9;newsparkles.Parent = brickhit


&#9;wait(9)
&#9;brickhit:BreakJoints()
&#9;wait(5)
&#9;brickhit.Size = brickhit.Size * Vector3.new(0.5, 0.5, 0.5)
&#9;brickhit.BrickColor = BrickColor.new(26)
&#9;wait(5)
&#9;print(&quot;Burning done!&quot;)
&#9;brickhit.BurningFRONT:Remove()
&#9;wait(0.1)
&#9;brickhit.BurningTOP:Remove()
&#9;wait(0.1)
&#9;brickhit.BurningBACK:Remove()
&#9;wait(0.1)
&#9;brickhit.FireSparkles:Remove()
&#9;wait(0.1)
&#9;firescript = script.Parent:FindFirstChild(&quot;Burning&quot;)
&#9;if firescript ~= nil then firescript:Remove() end
&#9;wait(0.1)
&#9;brickhit.Name = &quot;Burnt&quot;
&#9;print(&quot;Removed all the decals and script&quot;)

&#9;set_to_debris(brickhit)

&#9;script:Remove()
end

function set_to_debris(brick)
&#9;game.Debris:AddItem(brick, 100)
&#9;print(&quot;Added &quot;.. brick.Name .. &quot; to debris!&quot;)
end

parentbrick = script.Parent

spread_fire(parentbrick)</ProtectedString>
