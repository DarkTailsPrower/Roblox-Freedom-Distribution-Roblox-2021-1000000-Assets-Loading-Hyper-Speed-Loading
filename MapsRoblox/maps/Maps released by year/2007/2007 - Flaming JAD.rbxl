				<ProtectedString name="Source">print(&quot;Community Leaderboard script loaded&quot;)


function onPlayerEntered(newPlayer)

&#9;local stats = Instance.new(&quot;IntValue&quot;)
&#9;stats.Name = &quot;leaderstats&quot;

&#9;local mins = Instance.new(&quot;IntValue&quot;)
&#9;mins.Name = &quot;Minutes Building&quot;
&#9;mins.Value = 0


&#9;mins.Parent = stats
&#9;
&#9;stats.Parent = newPlayer

&#9;while true do
&#9;&#9;wait(60)
&#9;&#9;mins.Value = mins.Value + 1
&#9;end
end



game.Players.ChildAdded:connect(onPlayerEntered)</ProtectedString>
