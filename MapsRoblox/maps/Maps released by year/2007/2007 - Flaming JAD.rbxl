function spread_fire(brickhit)
&#9;burner = game.Workspace.BurnScript:Clone()
&#9;burner.Disabled = False
&#9;burner.Parent = brickhit
&#9;print(&quot;Copied burner script!&quot;)
&#9;wait(0.1)
&#9;script:Clone().Parent = brickhit
&#9;print(&quot;Copied spreader script!&quot;)
end


function Touched(hit)
&#9;if debounce == true then
&#9;&#9;debounce = false
&#9;&#9;print(&quot;Touched!&quot;)
&#9;&#9;if hit:FindFirstChild(&quot;Unburnable&quot;) ~= nil then return end
&#9;&#9;if hit:FindFirstChild(&quot;BurnScript&quot;) == nil then
&#9;&#9;&#9;if hit.Name ~= &quot;Burnt&quot; then
&#9;&#9;&#9;&#9;spread_fire(hit)
&#9;&#9;&#9;&#9;print(&quot;Another brick starts burning!&quot;)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;wait()
&#9;&#9;debounce = true
&#9;end
end

