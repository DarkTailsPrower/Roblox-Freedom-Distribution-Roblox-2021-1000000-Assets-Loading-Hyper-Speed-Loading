					<Item class="Script" referent="RBX1802">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">local Debounce = true
function Touch(hit)
local Packs = 0
local P = game.Workspace:GetChildren()
for i = 1, #P do
if P[i].Name == &quot;Pack&quot; then
if P[i].OwnerModel.Value == hit.Parent then
Packs = Packs + 1
end
end
end
if Packs == 0 then
if hit.Parent:findFirstChild(&quot;Torso&quot;) ~= nil then
if hit.Parent:findFirstChild(&quot;Pack&quot;) == nil then
if Debounce == true then
Debounce = false
local Clone = script.Parent.Parent.Parent.Pack
Clone.Parent = game.Workspace
Clone.OwnerModel.Value = hit.Parent
Clone.Mode.Value = 1
Clone.On.Value = true
Clone.Name = &quot;Pack&quot;
Clone.Pack.Anchored = false
Clone.Pack.CanCollide = true
Clone.Flame1.Anchored = false
Clone.Flame1.Transparency = 0.3
Clone.Flame2.Anchored = false
Clone.Flame2.Transparency = 0.3
Clone.Cylinder1.Anchored = false
Clone.Cylinder1.CanCollide = true
Clone.Cylinder2.Anchored = false
Clone.Cylinder2.CanCollide = true
local Weld = Instance.new(&quot;Weld&quot;)
Weld.Parent = hit.Parent.Torso
Weld.Part0 = Weld.Parent
Weld.Part1 = Clone.Pack
Weld.C0 = CFrame.new(Weld.Part0.Position)
Weld.C1 =CFrame.new(Weld.Part0.Position + Vector3.new(0, 0, -1))
local Weld = Instance.new(&quot;Weld&quot;)
Weld.Parent = hit.Parent.Torso
Weld.Part0 = Weld.Parent
Weld.Part1 = Clone.Flame1
Weld.C0 = CFrame.new(Weld.Part0.Position)
Weld.C1 =CFrame.new(Weld.Part0.Position + Vector3.new(0.5, 1.2, -1))
local Weld = Instance.new(&quot;Weld&quot;)
Weld.Parent = hit.Parent.Torso
Weld.Part0 = Weld.Parent
Weld.Part1 = Clone.Flame2
Weld.C0 = CFrame.new(Weld.Part0.Position)
Weld.C1 =CFrame.new(Weld.Part0.Position + Vector3.new(-0.5, 1.2, -1))
local Weld = Instance.new(&quot;Weld&quot;)
Weld.Parent = hit.Parent.Torso
Weld.Part0 = Weld.Parent
Weld.Part1 = Clone.Cylinder1
Weld.C0 = CFrame.new(Weld.Part0.Position)
Weld.C1 =CFrame.new(Weld.Part0.Position + Vector3.new(0.5, -1.5, -1))
local Weld = Instance.new(&quot;Weld&quot;)
Weld.Parent = hit.Parent.Torso
Weld.Part0 = Weld.Parent
Weld.Part1 = Clone.Cylinder2
Weld.C0 = CFrame.new(Weld.Part0.Position)
Weld.C1 =CFrame.new(Weld.Part0.Position + Vector3.new(-0.5, -1.5, -1))
local BV = Instance.new(&quot;BodyVelocity&quot;)
BV.Parent = hit.Parent.Torso
BV.velocity = Vector3.new(0, 5, 0)
wait(3)
Debounce = true
end
end
end
end
end
script.Parent.Touched:connect(Touch)</ProtectedString>
						</Properties>
					</Item>
				</Item>
