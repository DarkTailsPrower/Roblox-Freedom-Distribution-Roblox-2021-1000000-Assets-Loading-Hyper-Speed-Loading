						<string name="Name">Script</string>
						<ProtectedString name="Source">local Jetpack = script.Parent.Parent.Pack:clone()
while true do
if script.Parent.Parent:findFirstChild(&quot;Pack&quot;) == nil then
local Packclone = Jetpack:clone()
Packclone.Parent = script.Parent.Parent
end
wait()
end
