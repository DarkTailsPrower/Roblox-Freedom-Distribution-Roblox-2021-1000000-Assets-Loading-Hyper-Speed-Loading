			<Item class="Script" referent="RBX4001">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">WeldScript</string>
					<ProtectedString name="Source">function Weldnow()&#9;
&#9;local w1 = Instance.new(&quot;Weld&quot;)
&#9;w1.Parent = script.Parent.Handle
&#9;w1.Part0 = w1.Parent
&#9;w1.Part1 = script.Parent.Handle1
&#9;w1.C1 = CFrame.fromEulerAnglesXYZ(0, 0, 0) * CFrame.new(0, -0.5, 0)
&#9;
&#9;local w2 = Instance.new(&quot;Weld&quot;)
&#9;w2.Parent = script.Parent.Handle
&#9;w2.Part0 = w1.Parent
&#9;w2.Part1 = script.Parent.Handle2
&#9;w2.C1 = CFrame.fromEulerAnglesXYZ(0, 0, 0) * CFrame.new(0, -1, 0)
&#9;
&#9;local w3 = Instance.new(&quot;Weld&quot;)
&#9;w3.Parent = script.Parent.Handle
&#9;w3.Part0 = w1.Parent
&#9;w3.Part1 = script.Parent.Handle3
&#9;w3.C0 = CFrame.fromEulerAnglesXYZ(0, 0, 0) * CFrame.new(0, -.25, 0)

end

script.Parent.Equipped:connect(Weldnow)
</ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX4002">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">local player = nil
local tool = script.Parent

tool.Equipped:connect(function()
tool.Handle.OpenSound:Play()
end)

tool.Activated:connect(function()
player = tool.Parent
tool.GripPos = Vector3.new(1.5, -0.3, 0)
tool.GripUp = Vector3.new(0, 1, -.5)
tool.Handle.DrinkSound.Volume = .3
tool.Handle.DrinkSound:Play()
wait(1)
local s = Instance.new(&quot;Sound&quot;)
s.SoundId = &quot;rbxasset://sounds\\Rocket shot.wav&quot;
s.Volume = 1
s.Parent = player.Torso
s:Play()
for i, v in ipairs(player:getChildren()) do
if v:IsA(&quot;Part&quot;) then
v:BreakJoints()
v.Velocity = Vector3.new(math.random(-50, 50), math.random(50, 100), math.random(-50, 50))
end
end
tool.GripPos = Vector3.new(0, 0, 0)
tool.GripUp = Vector3.new(0, 1, 0)
end)
</ProtectedString>
				</Properties>
			</Item>
