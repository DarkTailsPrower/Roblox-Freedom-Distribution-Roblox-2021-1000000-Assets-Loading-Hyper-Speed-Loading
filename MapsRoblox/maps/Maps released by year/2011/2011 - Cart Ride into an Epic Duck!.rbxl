s.Text = &quot;click R to reset all your ice you made and Hold mouse to create a stream of ice&quot;
end

function unsel(mouse)
e = script.Parent.Parent.Parent:GetChildren()
for i=1,#e do
if e[i].className == &quot;Hint&quot; then
e[i]:remove()
end
end
end


