				<Item class="Script" referent="RBX2065">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Tuturiol</string>
						<ProtectedString name="Source">print(&quot;Turtorial Loaded&quot;)

--This Happy Robloxian has the ability to be able to be talked to. He can do this with the StringValue named Talk.
--Open this up and you will see the Value. Change the words in the Value to what you want Bob to say when you greet him/click his head
--When you are done with that put a list of replies at the end of the words so people can reply by using their a, b, and c keys.
--Open up the talk StringValue and you should see a y and an n. change their names to what your list of replies was.
-- then open up the y and you should see an a, a b, and a c. these are the replies to the y.
--then you can open up these replies and there are replies to those too!
--you can change, add, or delete these so bob can say what you want him to say.
--and that&apos;s how you make your robloxian talk

--p.s the description is what the text will say if you are to far away for talking. you can also use descriptions in bricks so you can examine those too!</ProtectedString>
					</Properties>
				</Item>
				<Item class="HopperBin" referent="RBX2066">
					<Properties>
						<bool name="Active">false</bool>
						<token name="BinType">0</token>
						<string name="Name">talk</string>
						<Content name="TextureId"><null></null></Content>
					</Properties>
					<Item class="Script" referent="RBX2067">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">talkScript</string>
							<ProtectedString name="Source">msg=Instance.new(&quot;Hint&quot;)
t=0 --current time
tt=0 --time to take off msg
rate=0.05 --how long we wait before advancing the marquee one letter.
marqueePosition=-1 --used for &quot;marquee&quot;&apos;s with more than 100 characters. -1 means &quot;not in use&quot;
marquee=&quot;&quot;
num=100 --number of characters to display on the marquee hint.
responses={}
action={}
talking=false
newAction=nil --change to action[i] upon responses[i] for FTalk to resume
function updateMsg()
&#9;--uses marqueePosition to index &quot;marquee&quot;.
&#9;if marqueePosition==-1 then
&#9;&#9;msg.Text=marquee
&#9;else
&#9;&#9;fl=num-marqueePosition
&#9;&#9;totalMarquee=string.rep(&quot; &quot;, num) .. marquee .. string.rep(&quot; &quot;, num)
&#9;&#9;msg.Text=string.sub(totalMarquee,marqueePosition,num+marqueePosition-1)
&#9;end
end
reset=false
function waitForMarquee() --wait until marquee ends, or if no marquee then wait standard waiting time for msg length
&#9;if marqueePosition==-1 then wait(string.len(marquee)*rate+rate*20) return end
&#9;reset=false
&#9;while reset==false do
&#9;&#9;wait(.1)
&#9;end
end
shouldWait=true
function FTalk(pos)
&#9;if shouldWait then waitForMarquee() --let the msg operate; whatever it is
&#9;end
&#9;shouldWait=true
&#9;if pos.className==&quot;StringValue&quot; then
&#9;&#9;--1. It&apos;s a course of action (ie. &quot;y&quot; or &quot;n&quot;) with a msg.
&#9;&#9;--2. It&apos;s #1 without a msg (is redirect, usually)
&#9;&#9;--A. Look at the type + response
&#9;&#9;--B. Look at it&apos;s children and wait for a response.
&#9;&#9;marquee=pos.Value
&#9;&#9;if marquee:len() &lt;= num then
&#9;&#9;&#9;marqueePosition=-1
&#9;&#9;else
&#9;&#9;&#9;marqueePosition=0
&#9;&#9;end
&#9;&#9;updateMsg()
&#9;&#9;if marquee:len()==0 then shouldWait=false wait() end --this means no wait time, but also means not an infinite loop if someone tries to create one.
&#9;&#9;--Now, check to see what we&apos;re waiting for... in otherwords, GETCHILDREN
&#9;&#9;local ch=pos:getChildren()
&#9;&#9;local real={}
&#9;&#9;local rand={}
&#9;&#9;local i=1
&#9;&#9;local dealt=false
&#9;&#9;for i = 1, #ch do
&#9;&#9;&#9;if string.len(ch[i].Name)==1 then table.insert(real, ch[i])
&#9;&#9;&#9;elseif string.sub(ch[i].Name, 1, 6)==&quot;random&quot; then table.insert(rand,ch[i])
&#9;&#9;&#9;else --ACT UPON IT because it MUST be an Orb thing!
&#9;&#9;&#9;&#9;if ch[i].Name==&quot;redirect&quot; then FTalk(ch[i].Value) dealt=true
&#9;&#9;&#9;&#9;elseif ch[i].className==&quot;Script&quot; then FTalk(ch[i]) dealt = true
&#9;&#9;&#9;&#9;else--check for ORB condition
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;if not dealt then --check for what we&apos;re going to do...
&#9;&#9;&#9;--1st, is rand+real?
&#9;&#9;&#9;if #real &gt; 0 and #rand&gt;0 then
&#9;&#9;&#9;&#9;if math.random(1,#real+#rand)&lt;=#rand then real={} end --clear that array; choose a random choice!
&#9;&#9;&#9;end
&#9;&#9;&#9;if #real&gt;0 then
&#9;&#9;&#9;&#9;newAction=nil --clear from before
&#9;&#9;&#9;&#9;responses={}
&#9;&#9;&#9;&#9;action={}
&#9;&#9;&#9;&#9;for i = 1, #real do
&#9;&#9;&#9;&#9;&#9;table.insert(responses, real[i].Name)
&#9;&#9;&#9;&#9;&#9;table.insert(action, real[i])&#9;&#9;&#9;&#9;
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;expectingResponse=true
&#9;&#9;&#9;&#9;while newAction==nil do
&#9;&#9;&#9;&#9;&#9;wait(.5)
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;shouldWait=false --already waited for response!!
&#9;&#9;&#9;&#9;FTalk(newAction)
&#9;&#9;&#9;elseif #rand&gt;0 then
&#9;&#9;&#9;&#9;FTalk(rand[math.random(1,#rand)])
&#9;&#9;&#9;end --else no children and thus don&apos;t do anything! Finished conversation.
&#9;&#9;end
&#9;elseif pos.className==&quot;Script&quot; then --we need to run this script! 
&#9;&#9;sc=pos:clone()
&#9;&#9;if sc:findFirstChild(&quot;Who&quot;)~=nil then sc.Who.Value=game.Players.LocalPlayer end
&#9;&#9;sc.Disabled=false
&#9;&#9;sc.Parent=game.Workspace
&#9;else --is a redirect
&#9;&#9;FTalk(pos.Value)
&#9;end
end
expectingResponse=false
function onKeyDown(key)
&#9;if key== nil or expectingResponse==false then return end
&#9;key=key:lower()
&#9;for u = 1, #responses do
&#9;&#9;if key==responses[u] then newAction=action[u] expectingResponse=false break end
&#9;end
end
function onButton1Down(mouse)
&#9;if talking then return end
&#9;local player = game.Players.LocalPlayer
&#9;if player == nil then return end
&#9;obj=mouse.Target
&#9;if obj==nil then 
&#9;&#9;marquee=&quot;The sky! What a beautiful thing!&quot;
&#9;&#9;marqueePosition=-1
&#9;&#9;updateMsg()
&#9;&#9;msg.Parent=script.Parent.Parent.Parent
&#9;&#9;tt=t+6 --leave on for 5 to 6 seconds
&#9;&#9;return
&#9;else
&#9;&#9;talk=obj:findFirstChild(&quot;Talk&quot;)
&#9;&#9;if talk==nil then talk=obj.Parent:findFirstChild(&quot;Talk&quot;) end
&#9;&#9;if talk==nil then talk=obj.Parent.Parent:findFirstChild(&quot;Talk&quot;) end
&#9;&#9;desc=obj:findFirstChild(&quot;Description&quot;)
&#9;&#9;if desc==nil then desc=obj.Parent:findFirstChild(&quot;Description&quot;) end
&#9;&#9;if desc==nil then desc=obj.Parent.Parent:findFirstChild(&quot;Description&quot;) end
&#9;end
&#9;pos1=obj.Position
&#9;head=script.Parent.Parent.Parent.Character:findFirstChild(&quot;Head&quot;)
&#9;if head==nil then return end
&#9;pos2=head.Position
&#9;dist=(pos1-pos2).magnitude
&#9;dist=dist-math.max(math.max(obj.Size.x, obj.Size.z), obj.Size.y)
&#9;if talk~=nil and dist &lt;15 then
&#9;&#9;w=talk:findFirstChild(&quot;who&quot;)
&#9;&#9;msg.Parent=game.Players.LocalPlayer
&#9;&#9;if w==nil or w.Value==&quot;&quot; then --free!
&#9;&#9;&#9;talking=true
&#9;&#9;&#9;tt=0
&#9;&#9;&#9;if w~=nil then w.Value=game.Players.LocalPlayer.Name end
--[[&#9;&#9;&#9;marquee=&quot;STARTING CHAT...&quot;
&#9;&#9;&#9;updateMsg()
&#9;&#9;&#9;wait(1) --]]
&#9;&#9;&#9;shouldWait=false
&#9;&#9;&#9;FTalk(talk)
&#9;&#9;&#9;waitForMarquee()
&#9;&#9;&#9;msg.Parent=nil
&#9;&#9;&#9;tt=0
&#9;&#9;&#9;if w~=nil then w.Value=&quot;&quot; end --end of chat!
&#9;&#9;&#9;talking=false
&#9;&#9;else
&#9;&#9;&#9;marquee=&quot;Someone is already chatting with this humanoid. Please try again later.&quot;
&#9;&#9;&#9;marqueePosition=-1
&#9;&#9;&#9;updateMsg()
&#9;&#9;&#9;tt=t+6
&#9;&#9;end
&#9;elseif desc~=nil then
&#9;&#9;marquee=desc.Value
&#9;&#9;if marquee:len() &lt;= num then
&#9;&#9;&#9;marqueePosition=-1
&#9;&#9;else
&#9;&#9;&#9;marqueePosition=0
&#9;&#9;end
&#9;&#9;if dist&gt;=50 then marquee=&quot;Too far away... you can&apos;t get a good look at it...&quot; end
&#9;&#9;updateMsg()
&#9;&#9;msg.Parent=script.Parent.Parent.Parent
&#9;&#9;tt=t+6 --leave on for 5 to 6 seconds
&#9;else --is this an elevator button?
&#9;&#9;if obj.Parent.Parent.Name==&quot;Select Buttons&quot; and obj.Name==&quot;Head&quot; then --must be an elevator!
&#9;&#9;&#9;q= obj.Parent.Parent
&#9;&#9;&#9;if q:findFirstChild(&quot;DesiredFloor&quot;)~=nil and q:findFirstChild(&quot;FloorChange&quot;)~=nil then
&#9;&#9;&#9;&#9;if q.FloorChange.Value==false then --we are allowed to change the floor!
&#9;&#9;&#9;&#9;&#9;q.DesiredFloor.Value=obj.Parent.Name
&#9;&#9;&#9;&#9;&#9;q.FloorChange.Value=true
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end&#9;&#9;&#9;
&#9;&#9;end
&#9;end
&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
end

function onSelected(mouse)
&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
&#9;mouse.KeyDown:connect(onKeyDown)
end

script.Parent.Selected:connect(onSelected)
while true do
&#9;wait(rate)
&#9;t=t+rate
&#9;if t&gt;=tt and tt~=0 then
&#9;&#9;tt=0
&#9;&#9;msg.Parent=nil
&#9;&#9;marqueePosition=-1
&#9;end
&#9;if marqueePosition~=-1 then marqueePosition=marqueePosition+1 if marqueePosition&gt;string.len(marquee)+99 then marqueePosition=0 reset=true end updateMsg() end
end
</ProtectedString>
