							<string name="Name">Script</string>
							<ProtectedString name="Source">function Clicked()
&#9;if script.Parent.Parent.Parent.Name ~= &quot;Jetpack Set&quot; then
&#9;if script.Parent.Parent.On.Value == true then
&#9;&#9;script.Parent.Parent.On.Value = false
&#9;&#9;script.Parent.Parent.Flame1.Transparency = 1
&#9;&#9;script.Parent.Parent.Flame2.Transparency = 1
&#9;&#9;if script.Parent.Parent.Pack:findFirstChild(&quot;BodyVelocity&quot;) ~= nil then
&#9;&#9;&#9;script.Parent.Parent.Pack.BodyVelocity:remove()
&#9;&#9;end
&#9;&#9;if script.Parent.Parent.OwnerModel.Value:findFirstChild(&quot;Torso&quot;) ~= nil then
&#9;&#9;&#9;if script.Parent.Parent.OwnerModel.Value.Torso:findFirstChild(&quot;BodyVelocity&quot;) ~= nil then
&#9;&#9;&#9;&#9;script.Parent.Parent.OwnerModel.Value.Torso.BodyVelocity:remove()
&#9;&#9;&#9;end
&#9;&#9;end
&#9;else
&#9;&#9;script.Parent.Parent.On.Value = true
&#9;&#9;script.Parent.Parent.Flame1.Transparency = 0.3
&#9;&#9;script.Parent.Parent.Flame2.Transparency = 0.3
&#9;&#9;local BV = Instance.new(&quot;BodyVelocity&quot;)
&#9;&#9;BV.Parent = script.Parent.Parent.Pack
&#9;&#9;BV.velocity = Vector3.new(0, (5 * script.Parent.Parent.Mode.Value), 0)
&#9;&#9;BV.maxForce = Vector3.new(0, 4e+003, 0)
&#9;&#9;local BV = Instance.new(&quot;BodyVelocity&quot;)
&#9;&#9;BV.Parent = script.Parent.Parent.OwnerModel.Value.Torso
&#9;&#9;BV.velocity = Vector3.new(0, (5 * script.Parent.Parent.Mode.Value), 0)
&#9;&#9;BV.maxForce = Vector3.new(0, 4e+003, 0)
&#9;end
&#9;end
end
script.Parent.ClickDetector.MouseClick:connect(Clicked)
</ProtectedString>
						</Properties>
					</Item>
