		<Item class="HopperBin" referent="RBX5367">
			<Properties>
				<bool name="Active">false</bool>
				<token name="BinType">0</token>
				<string name="Name">Cannon</string>
				<Content name="TextureId"><null></null></Content>
			</Properties>
			<Item class="Script" referent="RBX5368">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">TankDriver</string>
					<ProtectedString name="Source">bin=script.Parent
Tank = nil
local debounce = false
local Tankdebounce = false
local controlling = false
local TankActive = false
local speed = 0

function computeDirection(vec)
&#9;local lenSquared = vec.magnitude * vec.magnitude
&#9;local invSqrt = 1 / math.sqrt(lenSquared)
&#9;return Vector3.new(vec.x * invSqrt, vec.y * invSqrt, vec.z * invSqrt)
end

function fire(pln,spn)
        local missile = bin.Rocket:clone()

&#9;missile.CFrame = spn.CFrame * CFrame.new(0, 0, -15)

&#9;missile.RocketScript.Disabled = false
&#9;missile.Parent = game.Workspace

&#9;local creator_tag = Instance.new(&quot;ObjectValue&quot;)
&#9;creator_tag.Value = game.Players.LocalPlayer
&#9;creator_tag.Name = &quot;creator&quot;
&#9;creator_tag.Parent = missile

&#9;missile.Owner.Value = pln
end

function moveturret(target, Engine)
&#9;local origincframe = Engine:findFirstChild(&quot;BodyGyro&quot;).cframe
&#9;local dir = (target - Engine.Position).unit
&#9;local spawnPos = Engine.Position

&#9;local pos = spawnPos + (dir * 1)

&#9;Engine:findFirstChild(&quot;BodyGyro&quot;).maxTorque = Vector3.new(0, 90, 0)
&#9;Engine:findFirstChild(&quot;BodyGyro&quot;).cframe = CFrame.new(pos,  pos + dir)

end
function movebarrel(target, Engine)
&#9;local origincframe = Engine:findFirstChild(&quot;BodyGyro&quot;).cframe
&#9;local dir = (target - Engine.Position).unit
&#9;local spawnPos = Engine.Position

&#9;local pos = spawnPos + (dir * 1)

&#9;Engine:findFirstChild(&quot;BodyGyro&quot;).maxTorque = Vector3.new(90, 0, 90)
&#9;Engine:findFirstChild(&quot;BodyGyro&quot;).cframe = CFrame.new(pos,  pos + dir)
end

function findTank(player)
&#9;local list = player.Character:GetChildren()
&#9;for x = 1, #list do
&#9;&#9;if (list[x].Name == &quot;Tank&quot;) then
&#9;&#9;&#9;local weld = list[x]:FindFirstChild(&quot;Parts&quot;):FindFirstChild(&quot;Seat&quot;):FindFirstChild(&quot;SeatWeld&quot;)
&#9;&#9;&#9;if (weld ~= nil) and (weld.Part1 == player.Character:FindFirstChild(&quot;Torso&quot;)) then
&#9;&#9;&#9;&#9;return list[x]
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;return nil
end

function onButton1Down(mouse)
&#9;local vehicle = findTank(script.Parent.Parent.Parent)

&#9;if vehicle ~= nil and debounce == false and Tankdebounce == false then
&#9;debounce = true

&#9;controlling = true

&#9;while true do
&#9;&#9;wait()
&#9;&#9;local Turret = vehicle.Parts.Weapon.Turret.Engine
&#9;&#9;local Barrel = vehicle.Parts.Weapon.Barrel.Engine
&#9;&#9;local position = mouse.Hit
&#9;&#9;local target = position.p
&#9;&#9;if Turret:findFirstChild(&quot;TankTurretScript&quot;) ~= nil then
&#9;&#9;&#9;moveturret(target, Turret)
&#9;&#9;end
&#9;&#9;if Barrel:findFirstChild(&quot;TankBarrelScript&quot;) ~= nil then
&#9;&#9;&#9;movebarrel(target, Barrel)
&#9;&#9;end
&#9;&#9;if Tankdebounce == true or
&#9;&#9;controlling == false then break end
&#9;end
&#9;wait(.1)
&#9;debounce = false
&#9;end
end

function onButton1Up(mouse)
&#9;controlling = false
end

function onSelected(mouse)
&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
&#9;mouse.Button1Up:connect(function() onButton1Up(mouse) end)
&#9;mouse.KeyDown:connect(onKeyDown)
end

function onKeyDown(key)
&#9;if (key~=nil) then
&#9;&#9;key = key:lower()
&#9;&#9;local vehicle = findTank(script.Parent.Parent.Parent)
&#9;&#9;if (vehicle==nil) then return end
&#9;&#9;Tank = vehicle.Parts
&#9;&#9;local Engine = vehicle.Parts.Engine
&#9;&#9;local r1 = Engine.Parent.r1
&#9;&#9;local r2 = Engine.Parent.r2
&#9;&#9;local r3 = Engine.Parent.r3
&#9;&#9;local r4 = Engine.Parent.r4
&#9;&#9;local r5 = Engine.Parent.r5
&#9;&#9;local l1 = Engine.Parent.l1
&#9;&#9;local l2 = Engine.Parent.l2
&#9;&#9;local l3 = Engine.Parent.l3
&#9;&#9;local l4 = Engine.Parent.l4
&#9;&#9;local l5 = Engine.Parent.l5
&#9;&#9;local speed = Engine:findFirstChild(&quot;Speed&quot;).Value

&#9;&#9;if (key==&quot;x&quot;) and Tankdebounce == false then -- turn of our tank
&#9;&#9;&#9;local Turretpower = Tank.Weapon.Turret.Engine:findFirstChild(&quot;TankTurretScript&quot;)
&#9;&#9;&#9;local Barrelpower = Tank.Weapon.Barrel.Engine:findFirstChild(&quot;TankBarrelScript&quot;)
&#9;&#9;&#9;if (Barrelpower ~= nil) then
&#9;&#9;&#9;&#9;Barrelpower:remove()
&#9;&#9;&#9;end
&#9;&#9;&#9;if (Turretpower ~= nil) then
&#9;&#9;&#9;&#9;Turretpower:remove()
&#9;&#9;&#9;end
&#9;&#9;&#9;r1.RightParamB = 0
&#9;&#9;&#9;r1.RightParamA = 0&#9;
&#9;&#9;&#9;r2.RightParamB = 0
&#9;&#9;&#9;r2.RightParamA = 0
&#9;&#9;&#9;r3.RightParamB = 0
&#9;&#9;&#9;r3.RightParamA = 0&#9;
&#9;&#9;&#9;r4.RightParamB = 0
&#9;&#9;&#9;r4.RightParamA = 0
&#9;&#9;&#9;r5.RightParamB = 0
&#9;&#9;&#9;r5.RightParamA = 0&#9;
&#9;
&#9;&#9;&#9;l1.RightParamB = 0
&#9;&#9;&#9;l1.RightParamA = 0
&#9;&#9;&#9;l2.RightParamB = 0
&#9;&#9;&#9;l2.RightParamA = 0
&#9;&#9;&#9;l3.RightParamB = 0
&#9;&#9;&#9;l3.RightParamA = 0
&#9;&#9;&#9;l4.RightParamB = 0
&#9;&#9;&#9;l4.RightParamA = 0
&#9;&#9;&#9;l5.RightParamB = 0
&#9;&#9;&#9;l5.RightParamA = 0

&#9;&#9;&#9;TankActive = false
&#9;&#9;end
&#9;&#9;if(key == &quot;y&quot;) then -- turn on our tank
&#9;&#9;&#9;TankActive = true
&#9;&#9;&#9;local Turretpower = Tank.Weapon.Turret.Engine:findFirstChild(&quot;TankTurretScript&quot;)
&#9;&#9;&#9;local Barrelpower = Tank.Weapon.Barrel.Engine:findFirstChild(&quot;TankBarrelScript&quot;)
&#9;&#9;&#9;if (Turretpower ~= nil) then return end
&#9;&#9;&#9;if (Barrelpower ~= nil) then return end
&#9;&#9;&#9;local Turretsc = script.TankTurretScript:clone()
&#9;&#9;&#9;local Barrelsc = script.TankBarrelScript:clone()
&#9;&#9;&#9;Turretsc.Disabled = true
&#9;&#9;&#9;Barrelsc.Disabled = true
&#9;&#9;&#9;Turretsc.Parent = Tank.Weapon.Turret.Engine
&#9;&#9;&#9;Barrelsc.Parent = Tank.Weapon.Barrel.Engine
&#9;&#9;end
&#9;&#9;if(TankActive == true) then
&#9;&#9;&#9;if((key == &quot;u&quot;) or (key == &quot;h&quot;) or (key == &quot;k&quot;) or (key == &quot;n&quot;) or (key == &quot;m&quot;) or (key == &quot;f&quot;)) then -- primary movement keys
&#9;&#9;&#9;&#9;if (key==&quot;u&quot;) then   -- left track forward
&#9;&#9;&#9;&#9;&#9;l1.RightParamB = speed
&#9;&#9;&#9;&#9;&#9;l1.RightParamA = speed*-1
&#9;&#9;&#9;&#9;&#9;l2.RightParamB = speed
&#9;&#9;&#9;&#9;&#9;l2.RightParamA = speed*-1
&#9;&#9;&#9;&#9;&#9;l3.RightParamB = speed
&#9;&#9;&#9;&#9;&#9;l3.RightParamA = speed*-1
&#9;&#9;&#9;&#9;&#9;l4.RightParamB = speed
&#9;&#9;&#9;&#9;&#9;l4.RightParamA = speed*-1
&#9;&#9;&#9;&#9;&#9;l5.RightParamB = speed
&#9;&#9;&#9;&#9;&#9;l5.RightParamA = speed*-1
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;if (key==&quot;n&quot;) then--  Left track Stop
&#9;&#9;&#9;&#9;&#9;l1.RightParamB = 0
&#9;&#9;&#9;&#9;&#9;l1.RightParamA = 0
&#9;&#9;&#9;&#9;&#9;l2.RightParamB = 0
&#9;&#9;&#9;&#9;&#9;l2.RightParamA = 0
&#9;&#9;&#9;&#9;&#9;l3.RightParamB = 0
&#9;&#9;&#9;&#9;&#9;l3.RightParamA = 0
&#9;&#9;&#9;&#9;&#9;l4.RightParamB = 0
&#9;&#9;&#9;&#9;&#9;l4.RightParamA = 0
&#9;&#9;&#9;&#9;&#9;l5.RightParamB = 0
&#9;&#9;&#9;&#9;&#9;l5.RightParamA = 0
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;if (key==&quot;h&quot;) then--  Left track Backwards
&#9;&#9;&#9;&#9;&#9;l1.RightParamB = speed*-1
&#9;&#9;&#9;&#9;&#9;l1.RightParamA = speed
&#9;&#9;&#9;&#9;&#9;l2.RightParamB = speed*-1
&#9;&#9;&#9;&#9;&#9;l2.RightParamA = speed&#9;
&#9;&#9;&#9;&#9;&#9;l3.RightParamB = speed*-1
&#9;&#9;&#9;&#9;&#9;l3.RightParamA = speed
&#9;&#9;&#9;&#9;&#9;l4.RightParamB = speed*-1
&#9;&#9;&#9;&#9;&#9;l4.RightParamA = speed
&#9;&#9;&#9;&#9;&#9;l5.RightParamB = speed*-1
&#9;&#9;&#9;&#9;&#9;l5.RightParamA = speed&#9;
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;if (key==&quot;u&quot;) then   -- Right track forward
&#9;&#9;&#9;&#9;&#9;r1.RightParamB = speed*-1
&#9;&#9;&#9;&#9;&#9;r1.RightParamA = speed
&#9;&#9;&#9;&#9;&#9;r2.RightParamB = speed*-1
&#9;&#9;&#9;&#9;&#9;r2.RightParamA = speed
&#9;&#9;&#9;&#9;&#9;r3.RightParamB = speed*-1
&#9;&#9;&#9;&#9;&#9;r3.RightParamA = speed
&#9;&#9;&#9;&#9;&#9;r4.RightParamB = speed*-1
&#9;&#9;&#9;&#9;&#9;r4.RightParamA = speed
&#9;&#9;&#9;&#9;&#9;r5.RightParamB = speed*-1
&#9;&#9;&#9;&#9;&#9;r5.RightParamA = speed
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;if (key==&quot;m&quot;) then   -- Right track Stop
&#9;&#9;&#9;&#9;&#9;r1.RightParamB = 0
&#9;&#9;&#9;&#9;&#9;r1.RightParamA = 0
&#9;&#9;&#9;&#9;&#9;r2.RightParamB = 0
&#9;&#9;&#9;&#9;&#9;r2.RightParamA = 0
&#9;&#9;&#9;&#9;&#9;r3.RightParamB = 0
&#9;&#9;&#9;&#9;&#9;r3.RightParamA = 0
&#9;&#9;&#9;&#9;&#9;r4.RightParamB = 0
&#9;&#9;&#9;&#9;&#9;r4.RightParamA = 0
&#9;&#9;&#9;&#9;&#9;r5.RightParamB = 0
&#9;&#9;&#9;&#9;&#9;r5.RightParamA = 0
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;if (key==&quot;k&quot;) then   -- Right track Backwards
&#9;&#9;&#9;&#9;&#9;r1.RightParamB = speed
&#9;&#9;&#9;&#9;&#9;r1.RightParamA = speed*-1
&#9;&#9;&#9;&#9;&#9;r2.RightParamB = speed
&#9;&#9;&#9;&#9;&#9;r2.RightParamA = speed*-1
&#9;&#9;&#9;&#9;&#9;r3.RightParamB = speed
&#9;&#9;&#9;&#9;&#9;r3.RightParamA = speed*-1
&#9;&#9;&#9;&#9;&#9;r4.RightParamB = speed
&#9;&#9;&#9;&#9;&#9;r4.RightParamA = speed*-1
&#9;&#9;&#9;&#9;&#9;r5.RightParamB = speed
&#9;&#9;&#9;&#9;&#9;r5.RightParamA = speed*-1
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;&#9;if (key==&quot;f&quot;) and (bin.Reload.Value == 0) then
&#9;&#9;&#9;&#9;FiringSpeed = vehicle.Parts.Weapon.FiringSpeed
&#9;&#9;&#9;&#9;fire(vehicle,vehicle.Parts.Weapon.Barrel.BigGun)
&#9;&#9;&#9;&#9;bin.Reload.Value = 1
&#9;&#9;&#9;&#9;wait(FiringSpeed.Value)
&#9;&#9;&#9;&#9;bin.Reload.Value = 0
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end

end

bin.Selected:connect(onSelected)
</ProtectedString>
