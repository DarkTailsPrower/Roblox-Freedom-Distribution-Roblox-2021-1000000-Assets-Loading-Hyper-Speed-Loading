			<Item class="Script" referent="RBX4637">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">MessageBox</string>
					<ProtectedString name="Source">print(&quot;VirtualNinja&apos;s message box&quot;)

local debounce = false


function onHit(hit)
&#9;local human = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;if (human ~= nil) and debounce == false then

                debounce = true

local message = Instance.new(&quot;Message&quot;)
message.Text = &quot;What you cant fire a cannon?&quot;
message.Parent = game.Players:playerFromCharacter(hit.Parent)
wait(4)
message.Text = &quot;No worry ill tell you&quot;
wait(4)
message.Text = &quot;use the Cannon tool&quot;
wait(4)
message.Text = &quot;press y to start&quot;
wait(4)
message.Text = &quot;u to go forward or H + K to go backward&quot;
wait(4)
message.Text = &quot;m to stop your right wheels and n to stop your left wheels&quot;
wait(4)
message.Text = &quot;F to fire your cannon ball&quot;
wait(4)
message.Text = &quot;last X to turn it all off&quot;
wait(4)
message.Text = &quot;Good luck&quot;
wait(4)

message:Remove ()

                debounce = false
&#9;end
end

script.Parent.Touched:connect(onHit)</ProtectedString>
				</Properties>
			</Item>
