							<Item class="Script" referent="RBX1604">
								<Properties>
									<bool name="Disabled">false</bool>
									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">Script</string>
									<string name="Source">local debounce = 0

function onClicked()
	if debounce == 0 then
	debounce = 1
local ClickBomb = script.Parent.Parent.ClickBomb

script.Parent.Sparkles.Enabled = true
script.Parent.Transparency = 0.1
wait(0.1)
script.Parent.Transparency = 0.2
wait(0.1)
script.Parent.Transparency = 0.3
wait(0.1)
script.Parent.Transparency = 0.4

wait(0.1)
script.Parent.Transparency = 0.5
wait(0.1)
script.Parent.Transparency = 0.6
wait(0.1)
script.Parent.Transparency = 0.7

wait(0.1)
script.Parent.Transparency = 0.8
wait(0.1)
script.Parent.Transparency = 0.9
wait(0.1)
script.Parent.Transparency = 1

wait(0.1)
script.Parent.Sparkle.Enabled = true



script.Parent.Anchored = false  

wait(3)
explosion = Instance.new(&quot;Explosion&quot;)
  explosion.BlastRadius = 12
  explosion.BlastPressure = 1111111
  explosion.Position = script.Parent.Position
  explosion.Parent = game.Workspace
  script.Parent.Transparency = 1

script.Parent.Parent.lift:remove()
script.Parent.Parent.i:remove()
script.Parent.Parent.Cone:remove()
script.Parent.Sparkles.Enabled = false

script.Parent.Parent.Bricks.a.Sparkles.Enabled = true
script.Parent.Parent.Bricks.b.Sparkles.Enabled = true
script.Parent.Parent.Bricks.c.Sparkles.Enabled = true
script.Parent.Parent.Bricks.d.Sparkles.Enabled = true
script.Parent.Parent.Bricks.e.Sparkles.Enabled = true
script.Parent.Parent.Bricks.f.Sparkles.Enabled = true
script.Parent.Parent.Bricks.g.Sparkles.Enabled = true
script.Parent.Parent.Bricks.h.Sparkles.Enabled = true
script.Parent.Parent.Bricks.i.Sparkles.Enabled = true
script.Parent.Parent.Bricks.j.Sparkles.Enabled = true


wait(2)

script.Parent.Parent.Bricks:remove()






	debounce = 0
	end
end

script.Parent.ClickDetector.MouseClick:connect(onClicked)

--[[
This clickable door was made by Lightdroid!
No noobs Copy!!! OR ELSE!!!!
&#164;Lightdroid&#164;
I AM NINJA!!!!
--]]</string>
									<bool name="archivable">true</bool>
