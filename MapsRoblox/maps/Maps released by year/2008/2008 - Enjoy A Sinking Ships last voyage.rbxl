		<Item class="Script" referent="RBX3">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">zenphar admin</string>
				<string name="Source">adminName = &quot;zenphar&quot; 
adminTeam = game.Teams:findFirstChild(&quot;Wargod99 And Zenphar&quot;) --Change to whatever 

function onEntered(newPlayer) 
if newPlayer.Name == adminName then 
newPlayer.TeamColor = adminTeam.TeamColor 
end 
end 

game.Players.ChildAdded:connect(onEntered) </string>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
