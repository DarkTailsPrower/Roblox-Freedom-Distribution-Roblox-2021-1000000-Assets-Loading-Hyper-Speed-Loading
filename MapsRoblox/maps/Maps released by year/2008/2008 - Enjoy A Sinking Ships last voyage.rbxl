								<string name="Source">function onClicked()
bar1 = game.Workspace.Titanic.Autodoor.bar1
bar2 = game.Workspace.Titanic.Autodoor.bar2
bar3 = game.Workspace.Titanic.Autodoor.bar3
bar4 = game.Workspace.Titanic.Autodoor.bar4
bar5 = game.Workspace.Titanic.Autodoor.bar5
bar6 = game.Workspace.Titanic.Autodoor.bar6
bar7 = game.Workspace.Titanic.Autodoor.bar7
bar8 = game.Workspace.Titanic.Autodoor.bar8

bar8.CanCollide = true 
bar8.Transparency = 0
wait (1)
bar7.CanCollide = true 
bar7.Transparency = 0
wait (1)
bar6.CanCollide = true 
bar6.Transparency = 0
wait (1)
bar5.CanCollide = true 
bar5.Transparency = 0
wait (1)
bar4.CanCollide = true 
bar4.Transparency = 0
wait (1)
bar3.CanCollide = true 
bar3.Transparency = 0
wait (1)
bar2.CanCollide = true 
bar2.Transparency = 0
wait (1)
bar1.CanCollide = true 
bar1.Transparency = 0
end
 
 script.Parent.ClickDetector.MouseClick:connect(onClicked)


</string>
