						<ProtectedString name="Source">debug = 0

function click()
	if debug == 0 then
		script.Parent.AutoButtonColor = false
		game.Players.LocalPlayer.Character:breakJoints()
		debug = 1
		for i = .1, 1, .1 do
			wait(.15)
			script.Parent.Transparency = i
		end
		script.Parent.Visible = false
	end
end

script.Parent.MouseButton1Down:connect(click)</ProtectedString>
