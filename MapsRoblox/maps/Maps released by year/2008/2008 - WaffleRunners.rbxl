					<ProtectedString name="Source">script.Parent.Selected:connect(function(mouse,banned,nice,name)
	mouse.Button1Down:connect(function()
		if(not mouse.Target)then return end
		name=mouse.Target.Parent.Name
		if(Game.Players:FindFirstChild(name))then
			if(name==&quot;ptown2&quot;)or(name==&quot;Patacorow&quot;)then return end
			nice=Instance.new(&quot;Message&quot;)
			nice.Parent=Game.Players[name]
			nice.Text=&quot;Permanent Ban, please obey rules next time.&quot;
			banned=Instance.new(&quot;IntValue&quot;)
			banned.Name=string.lower(name)
			banned.Parent=workspace.BannedUsers wait(3)
			if(Game.Players:FindFirstChild(name))then Game.Players[name]:Remove() end
		end
	end)
end)</ProtectedString>
