		<Item class="Script" referent="RBX4324">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Annoying</string>
				<ProtectedString name="Source">while true do
if script.Parent:findFirstChild(&quot;Humanoid&quot;) then
	if script.Parent.Head:findFirstChild(&quot;GhostEffect&quot;) then
		script.Parent.Head:findFirstChild(&quot;GhostEffect&quot;):remove()
	end
	humanoids = script.Parent.Humanoid
	humanoids.Sit = true
	wait(1)
	humanoids.Jump = true
	wait(1)
	if script.Parent:findFirstChild(&quot;Torso&quot;) then
	script.Parent.Torso.Transparency = 1
	wait(1)
	end
	if script.Parent:findFirstChild(&quot;Left Leg&quot;) then
	script.Parent:findFirstChild(&quot;Left Leg&quot;):remove()
	wait(1)
	end
	if script.Parent:findFirstChild(&quot;Torso&quot;) then
	script.Parent.Torso.Transparency = 0
	wait(1)
	end
	humanoids.Sit = true
	wait(1)
	humanoids.Jump = true
	wait(1)
	if script.Parent:findFirstChild(&quot;Left Arm&quot;) and script.Parent:findFirstChild(&quot;Right Leg&quot;) then
	script.Parent:findFirstChild(&quot;Left Arm&quot;):remove()
	wait(1)
	script.Parent:findFirstChild(&quot;Right Leg&quot;):remove()
	wait(1)
	end
	humanoids.Sit = true
	wait(1)
	humanoids.Jump = true
	wait(1)
	if script.Parent:findFirstChild(&quot;Head&quot;) and script.Parent:findFirstChild(&quot;Right Arm&quot;) then
	a = Instance.new(&quot;BodyThrust&quot;)
	a.force = Vector3.new(0,0,-3500)
	a.Parent = script.Parent.Head
	wait(0.01)
	a:remove()
	wait(1)
	script.Parent:findFirstChild(&quot;Head&quot;).Transparency = 1
	wait(1)
	script.Parent:findFirstChild(&quot;Right Arm&quot;).Reflectance = 1
	wait(1)
	end
	humanoids.Sit = true
	wait(1)
	humanoids.Jump = true
	if script.Parent:findFirstChild(&quot;Head&quot;) and script.Parent:findFirstChild(&quot;Right Arm&quot;) then
	wait(1)
	script.Parent:findFirstChild(&quot;Head&quot;).Transparency = 0
	wait(1)
	script.Parent:findFirstChild(&quot;Right Arm&quot;).Reflectance = 0
	wait(1)
	script.Parent:findFirstChild(&quot;Right Arm&quot;).Transparency = 1
	wait(1)
	script.Parent:findFirstChild(&quot;Right Arm&quot;).Transparency = 0
	end
elseif script.Parent.Name == &quot;Backpack&quot; then
	script.Parent = script.Parent.Parent.Character
end
wait(0)
end
