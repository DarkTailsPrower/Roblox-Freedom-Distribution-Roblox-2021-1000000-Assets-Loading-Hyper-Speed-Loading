	Clone = script.Parent:findFirstChild(&quot;Handle Death&quot;):findFirstChild(&quot;Void Points&quot;):clone()
	Clone.Disabled = false
	Clone.Parent = Char
	elseif Char.className == &quot;Tool&quot; or Char.className == &quot;Hat&quot; then
	Char:remove()
	end
end
