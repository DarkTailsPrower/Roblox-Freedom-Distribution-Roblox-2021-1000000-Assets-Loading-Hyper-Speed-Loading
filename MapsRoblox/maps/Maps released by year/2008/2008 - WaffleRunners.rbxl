						<Properties>
							<float name="D">10000</float>
							<string name="Name">BodyPosition</string>
							<float name="P">10000</float>
							<bool name="archivable">true</bool>
							<Vector3 name="maxForce">
								<X>4000</X>
								<Y>400000</Y>
								<Z>4000</Z>
							</Vector3>
							<Vector3 name="position">
								<X>23.1548157</X>
								<Y>52.6540909</Y>
								<Z>14.4166689</Z>
							</Vector3>
						</Properties>
