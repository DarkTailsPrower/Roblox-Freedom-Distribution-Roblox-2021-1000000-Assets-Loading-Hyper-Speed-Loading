						<ProtectedString name="Source">debugger = 0
system = script.Parent
systema = script.Parent.Parent
leada = script.Parent.Parent.Parent.Parent
Text = {&quot;CrazyTool&quot;, &quot;SitTool&quot;, &quot;Invinsible&quot;, &quot;Speedup&quot;, &quot;AntiSit&quot;, &quot;AntiCrazy&quot;, &quot;SpecCam&quot;}
Buttons = {&quot;CrazyTool&quot;, &quot;SitTool&quot;, &quot;Invinsible&quot;, &quot;Speedup&quot;, &quot;AntiSit&quot;, &quot;AntiCrazy&quot;, &quot;SpecCam&quot;, &quot;ShopTitle&quot;, &quot;Warning&quot;, &quot;Warning2&quot;}
Brought = {&quot;Crazy&quot;, &quot;Sit&quot;, &quot;Invinsible&quot;, &quot;Speedup&quot;, &quot;SitI&quot;, &quot;CrazyI&quot;, &quot;SpecCam&quot;}

function shop()
	if debugger == 0 then
		for i = 1, #Buttons do
			system[Buttons[i]].Visible = true
		end
		systema.MenuBox.Visible = true
		debugger = 1
	elseif debugger == 1 then
		for i = 1, #Buttons do
			system[Buttons[i]].Visible = false
		end
		systema.MenuBox.Visible = false
		debugger = 0
	end
	checker()
end

function checker()
	for i = 1, #Brought do
		if leada[Brought[i]].Value == 1 then
			system[Text[i]].Text = &quot;Brought...&quot;
			system[Text[i]].Visible = false
		end
	end
end

system.MouseButton1Down:connect(shop)
