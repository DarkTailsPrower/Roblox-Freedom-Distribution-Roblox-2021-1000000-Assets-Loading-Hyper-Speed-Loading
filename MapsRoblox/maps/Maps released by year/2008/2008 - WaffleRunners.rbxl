				<ProtectedString name="Source">function onDied(player,character) 
	player.leaderstats.Round.Value=0 
end 

function onRespawn(player,character) 
	character.Humanoid.Died:connect(function() onDied(player,character) end) 
end 

function onPlayerEntered(player) 
	player.Changed:connect(function(prop) if prop==&quot;Character&quot; then onRespawn(player,player.Character) end end) 
end 

