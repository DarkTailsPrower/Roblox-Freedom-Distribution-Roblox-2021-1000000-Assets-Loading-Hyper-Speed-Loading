					<ProtectedString name="Source">isenabled = true
function onButton1Down(mouse)
	if isenabled == true and game.Players:findFirstChild(mouse.Target.Parent.Name) and mouse.Target.Parent:findFirstChild(&quot;Humanoid&quot;) then
		if game.Players:findFirstChild(mouse.Target.Parent.Name):findFirstChild(&quot;CrazyI&quot;) ~= nil then
			if game.Players[mouse.Target.Parent.Name].CrazyI.Value == 0 then
				if game.Lighting:findFirstChild(&quot;Annoying&quot;) then
					CopyTool = game.Lighting.Annoying:clone()
					CopyTool.Disabled = false
					CopyTool.Parent = mouse.Target.Parent
				end
			else
				return
			end
			isenabled = false
			wait(30)
			isenabled = true
		end
	end
end

