			<Item class="Script" referent="RBX1480">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">player = {&quot;xptown2x&quot;, &quot;Patacorow&quot;} --Edit here
viptools = {&quot;BanT&quot;, &quot;BanP&quot;} --Edit here
local debug = 0
local telled = 0

function onTouched(hit)
	if debug == 0 then
		debug = 1
		if hit.Parent ~= nil then
			if hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil then
				m = Instance.new(&quot;Message&quot;)
				m.Parent = game.Players[hit.Parent.Name]
				for a = 1, #player do
					if hit.Parent.Name == player[a] then
						if game.Players:findFirstChild(hit.Parent.Name) ~= nil then
							if game.Players[hit.Parent.Name]:findFirstChild(&quot;Backpack&quot;) ~= nil then
								for i = 1, #viptools do
									if game.Lighting:findFirstChild(viptools[i]) then
										if game.Players[hit.Parent.Name].Backpack:findFirstChild(viptools[i]) ~= nil then
											if telled == 0 then
												m.Text = &quot;You have the tools already.&quot;
												print(&quot;You have the tool.&quot;)
												telled = 1
												wait(0.5)
											end
										else
											if telled == 0 then
												m.Text = &quot;Congrats you are a VIP.&quot;
												telled = 1
												wait(0.5)
											end
											print(hit.Parent.Name.. &quot; has gotten &quot; ..viptools[i])
											local p = game.Lighting[viptools[i]]:clone()
											p.Parent = game.Players[hit.Parent.Name].Backpack
										end
									else
										print(&quot;There is no VIP tool that is named &quot; ..viptools[i])
									end
								end
							end
						end
					else
						if telled == 0 then
							m.Text = &quot;You are not in VIP List&quot;
							print(&quot;Not in VIP List&quot;)
							telled = 1
							wait(0.5)
						end
					end
				end
			end
		end
		wait(0.75)
		if telled == 1 then
			m:remove()
		end
		telled = 0
		debug = 0
	end
end

-- So many ends, that I like it. XD

script.Parent.Touched:connect(onTouched)</ProtectedString>
