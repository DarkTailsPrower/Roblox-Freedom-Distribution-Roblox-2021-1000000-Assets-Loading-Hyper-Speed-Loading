						<string name="Name">Script</string>
						<ProtectedString name="Source">while true do
	if script.Parent.Parent.Enabled.Value ~= 0 then
		wait(0.08)
		script.Parent.CFrame = script.Parent.CFrame*CFrame.fromEulerAnglesXYZ(0, 0.01 ,0)
	else
		wait(0.4)
	end
end
</ProtectedString>
