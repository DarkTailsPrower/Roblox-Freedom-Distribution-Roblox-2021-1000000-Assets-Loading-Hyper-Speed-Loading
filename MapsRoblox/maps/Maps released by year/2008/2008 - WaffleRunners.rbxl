				<Item class="Script" referent="RBX1357">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">function onTouched(part)
	if script.Parent.Parent.Enabled.Value ~= 0 then
		if part.Parent ~= nil then
			local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
			if h~=nil then
				h.Parent.Torso.Velocity=Vector3.new(0,100,0)
				wait(0.2)
			else
				part.Velocity=Vector3.new(0,100,0)
			end			
		end
	end
end

