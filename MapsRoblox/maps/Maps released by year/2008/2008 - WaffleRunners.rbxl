							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">AntiNOOB</string>
							<ProtectedString name="Source">unit = script.Parent.Parent
bar = script.Parent
point = unit[&quot;Point&quot;]
bg = bar.BG
bp = bar.BP
teamcolor = bar.BrickColor
maxdis = 150
original = {bar.Position, bar.CFrame}

rocket = Instance.new(&quot;Part&quot;) --Ah, yes. The rocket. This is our defense!....Whaddya mean it&apos;s not good enough?!
rocket.Locked = true
rocket.Name = &quot;Base&quot;
rocket.CanCollide = true
rocket.BackSurface = 3
rocket.BottomSurface = 3
rocket.FrontSurface = 3
rocket.LeftSurface = 3
rocket.RightSurface = 3
rocket.TopSurface = 3
rocket.Size = Vector3.new(1,1,1)
rocket.BrickColor = teamcolor
rocket.Reflectance = 0.4
rocket.Transparency = 0.1
rocket.Shape = 0

bar.RocketScript:Clone().Parent = rocket
bar.Script:Clone().Parent = rocket
bar.Explosion:Clone().Parent = rocket
bar.Swoosh:Clone().Parent = rocket

function ComputeDirection(vec)
	local lenSquared = vec.magnitude * vec.magnitude
	local invSqrt = 1 / math.sqrt(lenSquared)
	return Vector3.new(vec.x * invSqrt, vec.y * invSqrt, vec.z * invSqrt)
end

function Aim(part)
	local p1 = part.Position
	local p2 = bar.Position
	local dir = p1 - p2
	dir = ComputeDirection(dir)
	local pos = p2 + dir
	cf = CFrame.new(pos,  pos + dir)
	bg.cframe = cf
end

function Fire(gun)
	if script.Parent.Parent.Parent.Enabled.Value == 1 then
		local missile = rocket:Clone()
		missile.CFrame = gun.CFrame * CFrame.new(0,0,-4)
		missile.RocketScript.Disabled = false
		missile.Parent = game.Workspace
		script.Parent.Fire:play()
	else
		wait(0.3)
	end
end

function GetPlayer()
	local player = nil
	local players = game.Players:GetPlayers()
	--Time to sort....lazy sort that is...
	for i=1,#players do
		char = players[i].Character
		if char ~= nil then
			p = game.Players:GetPlayerFromCharacter(char)
			if p ~= nil then
				--if p.TeamColor ~= teamcolor then
					if char:findFirstChild(&quot;Torso&quot;) ~= nil then
						pos = char.Torso.Position
						if (pos - bar.Position).magnitude &lt;= maxdis then
							if player ~= nil then
								if (char.Torso.Position - script.Parent.Position).magnitude &lt; (player.Character.Torso.Position - bar.Position).magnitude then
									player = players[i]
								else
									player = player
								end
							else
								player = players[i]
							--end
						end
					end
				end
			end
		end
	end
	if (player ~= nil) then
		if (player.Character ~= nil) then
		return player.Character.Head
		end
	else
		return nil
	end
end

-------------------------------------
--Lock and Load!
function Adjust()
bp.position = original[1]
bg.cframe = original[2]
end
-------------------------------------

function Main()
	local target = GetPlayer()
	if target ~= nil then
		for i=1, 5 do
			player = game.Players:GetPlayerFromCharacter(target.Parent)
			if player.Parent == nil or target.Parent.Humanoid.Health &lt;= 0 then break end
				Aim(target)
				wait(0.1)
				Fire(bar)
			end
		end
	Adjust()
	wait()
	Main()
end

Adjust()
Main()
</ProtectedString>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
					<Item class="Script" referent="RBX1463">
						<Properties>
							<bool name="Disabled">true</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">RocketScript</string>
							<ProtectedString name="Source">r = game:service(&quot;RunService&quot;)

shaft = script.Parent
position = shaft.Position

script.Parent.Explosion.PlayOnRemove = true -- play explosion sound when projectile removed from game

function fly()
	direction = shaft.CFrame.lookVector 
	position = position + 10 * direction
	error = position - shaft.Position
	shaft.Velocity = 60*error
end

function blow()
	swoosh:stop()
	explosion = Instance.new(&quot;Explosion&quot;)
	explosion.BlastRadius = 12
	explosion.BlastPressure = 10000
	explosion.Position = shaft.Position


	-- find instigator tag
	local creator = script.Parent:findFirstChild(&quot;creator&quot;)
	if creator ~= nil then
		explosion.Hit:connect(function(part, distance)  onPlayerBlownUp(part, distance, creator) end)
	end

	explosion.Parent = game.Workspace
	explosion:remove()
	connection:disconnect()
	wait(.1)
	shaft:remove()
end

function onPlayerBlownUp(part, distance, creator)
	
	if part.Name == &quot;Head&quot; then
	
		local humanoid = part.Parent.Humanoid
		tagHumanoid(humanoid, creator)
	end
end

function tagHumanoid(humanoid, creator)
	-- tag does not need to expire iff all explosions lethal
	
	if creator ~= nil then
		local new_tag = creator:clone()
		new_tag.Parent = humanoid
		
	end
end

function untagHumanoid(humanoid)
	if humanoid ~= nil then
		local tag = humanoid:findFirstChild(&quot;creator&quot;)
		if tag ~= nil then
		
			tag.Parent = nil
		end
	end
end

t, s = r.Stepped:wait()

swoosh = script.Parent.Swoosh
swoosh:play()

d = t + 10.0 - s
connection = shaft.Touched:connect(blow)

while t &lt; d do
	fly()
	t = r.Stepped:wait()
end

-- at max range
script.Parent.Explosion.PlayOnRemove = false
swoosh:stop()
shaft:remove()
