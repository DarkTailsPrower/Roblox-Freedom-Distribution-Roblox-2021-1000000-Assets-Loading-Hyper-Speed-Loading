					<ProtectedString name="Source">bin=script.Parent
hint=Instance.new(&quot;Message&quot;)


bin.Selected:connect(function(m)
	spec = script.Parent.Parent.Parent.leaderstats.Round
	if spec.Value == 0 then
		spec.Value = -1
		hint.Text=&quot;You are now spectating.&quot;
	end
	hint.Parent=game.Players.LocalPlayer
	m.Icon=&quot;rbxasset://textures/GunCursor.png&quot;
end)

bin.Deselected:connect(function()
	if spec.Value == -1 then
		spec.Value = 0
		hint.Text=&quot;You are playing.&quot;
		wait(3)
	end
	hint.Parent=nil
end)</ProtectedString>
