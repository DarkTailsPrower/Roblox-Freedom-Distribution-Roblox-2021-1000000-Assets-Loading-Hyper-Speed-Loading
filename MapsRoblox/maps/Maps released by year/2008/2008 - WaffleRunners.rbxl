							<ProtectedString name="Source">system = script.Parent.Parent
systema = script.Parent.Parent.Parent.Parent
systemb = script.Parent

function shop()
	system.SellingType.Value = 4
	system.Price.Value = 125
	system.Item.Value = &quot;Speed-up&quot;
	systema.ConfirmMain.ConfirmBox.Visible = true
	systema.ConfirmMain.ConfirmBox.ConfirmText.Text = &quot;Do you confirm to buy &quot;.. system.Item.Value ..&quot; for a price of &quot;.. system.Price.Value ..&quot; waffles?&quot;
	system.Visible = false
	system.Parent.MenuBox.Visible = false
end

