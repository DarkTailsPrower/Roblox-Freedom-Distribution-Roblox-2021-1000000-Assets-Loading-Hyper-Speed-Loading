							<string name="Name">Script</string>
							<ProtectedString name="Source">systema = script.Parent.Parent.Parent
system = script.Parent.Parent.Parent.Parent.ShopMain.ShopButton
systemb = script.Parent.Parent.Parent.Parent
lead = script.Parent.Parent.Parent.Parent.Parent.leaderstats
leada = script.Parent.Parent.Parent.Parent.Parent
i = script.Parent.Parent.Parent.Parent.ShopMain.ShopButton.SellingType
Text = {&quot;SitTool&quot;, &quot;CrazyTool&quot;, &quot;Invinsible&quot;, &quot;Speedup&quot;, &quot;AntiSit&quot;, &quot;AntiCrazy&quot;, &quot;SpecCam&quot;}
Brought = {&quot;Sit&quot;, &quot;Crazy&quot;,&quot;Invinsible&quot;, &quot;Speedup&quot;, &quot;SitI&quot;, &quot;CrazyI&quot;, &quot;SpecCam&quot;}

function shop()
	if leada[Brought[i.Value]].Value == 0 then
		if lead[&quot;Waffles&quot;].Value &gt;= system.Price.Value then
			lead[&quot;Waffles&quot;].Value = lead[&quot;Waffles&quot;].Value - system.Price.Value
			leada[Brought[i.Value]].Value = 1
			system[Text[i.Value]].Text = &quot;Brought...&quot;
			system[Text[i.Value]].Visible = false
			if i.Value == 1 then
				local s = game.Lighting.SIT:clone()
				s.Parent = leada.Backpack
			elseif i.Value == 2 then
				local s = game.Lighting.CRAZY:clone()
				s.Parent = leada.Backpack
			elseif i.Value == 3 then
				leada.Invinsible.Value = 1
			elseif i.Value == 4 then
				leada.Speedup.Value = 1
			elseif i.Value == 5 then
				leada.SitI.Value = 1
			elseif i.Value == 6 then
				leada.CrazyI.Value = 1
			elseif i.Value == 7 then
				local s = game.Lighting.SpecCamTool:clone()
				s.Parent = leada.Backpack
				if leada.Backpack:findFirstChild(&quot;SpecTool&quot;) ~= nil then
					leada.Backpack.SpecTool:remove()
				end
			end
			buyed()
		elseif lead.Waf.Value &lt; system.Price.Value then
			failed()
		end
	elseif leada[Brought[i.Value]].Value == 1 then
		faileda()
	end
end

function buyed()
	systemb.ConfirmedMain.ConfirmedBox.Visible = true
	systemb.ConfirmedMain.ConfirmedBox.ConfirmedText.Text = &quot;You have brought &quot;.. system.Item.Value ..&quot; for a price of &quot;.. system.Price.Value ..&quot; waffles.&quot;
	systema.ConfirmBox.Visible = false
end

function failed()
	systemb.ConfirmedMain.ConfirmedBox.Visible = true
	systemb.ConfirmedMain.ConfirmedBox.ConfirmedText.Text = &quot;You do not have enough waffles.&quot;
	systema.ConfirmBox.Visible = false
end

function faileda()
	systemb.ConfirmedMain.ConfirmedBox.Visible = true
	systemb.ConfirmedMain.ConfirmedBox.ConfirmedText.Text = &quot;You already have that tool/upgrade.&quot;
	systema.ConfirmBox.Visible = false
end

script.Parent.MouseButton1Down:connect(shop)
</ProtectedString>
