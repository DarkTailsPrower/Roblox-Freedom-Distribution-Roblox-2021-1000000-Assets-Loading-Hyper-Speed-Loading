		<Item class="Script" referent="RBX1790">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Game</string>
				<ProtectedString name="Source">print(&quot;Coin Catcher Game, by: ptown2&quot;)

--Variables
local m = Instance.new(&quot;Message&quot;)
m.Parent = game.Workspace 
local h = Instance.new(&quot;Hint&quot;)
h.Parent = game.Workspace
player = 1
modes = {&quot;Easy Way&quot;, &quot;Platforms&quot;, &quot;Trampolines&quot;, &quot;Zombies&quot;, &quot;Hyper&quot;, &quot;Spinning Lava&quot;, &quot;Vertigo&quot;, &quot;KillBots&quot;, &quot;Sentry Attack&quot;, &quot;Fake Waffles&quot;}
modesa = {&quot;Easy Way&quot;, &quot;Platforms&quot;, &quot;Trampolines&quot;, &quot;Zombies&quot;, &quot;Hyper&quot;, &quot;Spinning Lava&quot;, &quot;Vertigo&quot;, &quot;KillBots&quot;, &quot;Sentry Attack&quot;, &quot;Fake Waffles&quot;}
spawn = {&quot;Freemodea&quot;, &quot;Platformsa&quot;, &quot;Trampolinesa&quot;, &quot;Zombiesa&quot;, &quot;Hypera&quot;, &quot;Lavaa&quot;, &quot;Vertigoa&quot;, &quot;KillBota&quot;, &quot;Sentrya&quot;, &quot;FakeWafa&quot;}
spawna = {&quot;Freemodea&quot;, &quot;Platformsa&quot;, &quot;Trampolinesa&quot;, &quot;Zombiesa&quot;, &quot;Hypera&quot;, &quot;Lavaa&quot;, &quot;Vertigoa&quot;, &quot;KillBota&quot;, &quot;Sentrya&quot;, &quot;FakeWafa&quot;}
bonus = {&quot;Yes&quot;, &quot;No&quot;} --This table can be used for later purposes.
Structure = {}
Structurea = {}
passed = 0

--Sounds
DingSound = script.Ding
BamSound = script.Bam
AngrySound1 = script.AngrySound1
AngrySound2 = script.AngrySound2
AngrySound3 = script.AngrySound3
TadaSound = script.Tada
SlashSound = script.Slash
CaraDansMusic = script.CaraDans

--Read-Only Variables
for i=1, #modes do
	table.insert(Structure, game.Workspace:findFirstChild(modes[i]):clone())
	game.Workspace:findFirstChild(modes[i]):remove()
end
for i=1, #modesa do
	table.insert(Structurea, game.Lighting:findFirstChild(modesa[i]):clone())
end

while true do
	script.GameEnd.Value = false
	local p = game.Players:getChildren() 
	while #p &lt; player do 
		m.Text = &quot;Wait for more player(s).&quot; 
		game.Players.ChildAdded:wait() 
		p = game.Players:getChildren() 
	end
	timer = 5
	while timer &gt; 0 do
		m.Text = &quot;A new round starts in: &quot;..timer..&quot;&quot;
		if timer &lt; 6 then
			DingSound:play()
		end
		timer = timer - 1
		wait(1)
	end
	if script.Choosing.Value == 1 then
		timer = 20
		repeat
			m.Text = script.Chooser.Value..&quot; is choosing a gamemode, he get&apos;s &quot;..timer..&quot; seconds to finish choosing.&quot;
			if timer &lt; 6 then
				DingSound:play()
			end
			wait(1)
			timer = timer - 1
			script.GMValue.Value = 2
		until timer == 0 or timer &gt; 0 and script.Choosing.Value == 2
		if script.Choosing.Value == 1 then
			m.Text = script.Chooser.Value..&quot; failed to choose a gamemode. Now choosing one randomly.&quot;
			local P = game.Players:GetChildren()
			for i=1, #P do
				if P[i].Character ~= nil then
					if P[i].Character:findFirstChild(&quot;Torso&quot;)~=nil and P[i].Character.Humanoid.Health &gt; 0 then
						if P[i].leaderstats.Round.Value ~= 0 and P[i].leaderstats.Round.Value == 2 then
							P[i].leaderstats.Round.Value = 0
							P[i].Character.Humanoid.Jump = true
							body = P[i].Character:findFirstChild(&quot;Torso&quot;)
							if body ~= nil then
								local teleportto=game.Workspace.Lobby.CentralLocation
								if teleportto~=nil then
									local torso = body
									local location = {teleportto.Position}
									local i = 1
									local x = location[i].x
									local y = location[i].y
									local z = location[i].z
									x = x + math.random(-60, 60)
									z = z + 0
									y = y + 8
									local cf = torso.CFrame
									local lx = 0
									local ly = y
									local lz = 0
									torso.CFrame = CFrame.new(Vector3.new(x,y,z), Vector3.new(lx,ly,lz))
								end
							end
						end
					end
				end
			end
			script.GMValue.Value = 1
			wait(1.7)
		end
	end
	waiter = .1
	if #modes == 0 and #Structure == 0 then
		modes = {&quot;Easy Way&quot;, &quot;Platforms&quot;, &quot;Trampolines&quot;, &quot;Zombies&quot;, &quot;Hyper&quot;, &quot;Spinning Lava&quot;, &quot;Vertigo&quot;, &quot;KillBots&quot;, &quot;Sentry Attack&quot;, &quot;Fake Waffles&quot;}
		spawn = {&quot;Freemodea&quot;, &quot;Platformsa&quot;, &quot;Trampolinesa&quot;, &quot;Zombiesa&quot;, &quot;Hypera&quot;, &quot;Lavaa&quot;, &quot;Vertigoa&quot;, &quot;KillBota&quot;, &quot;Sentrya&quot;, &quot;FakeWafa&quot;}
		for i=1, #modes do
			table.insert(Structure, game.Lighting:findFirstChild(modes[i]):clone())
		end
	elseif #modes == 1 then
		waiter = 1
	end
	if script.GMValue.Value == 1 then
		repeat
			for i = 1, 4 do
				for i = 1, #modes do
					m.Text = &quot;Game mode: &quot; ..modes[i]
					if #modes ~= 1 then
						SlashSound:play()
						wait(waiter)
					end
				end
			end
			waiter = 0.4
		until waiter &gt; 0.35
		repeat
			for i = 1, #modes do
				m.Text = &quot;Game mode: &quot; ..modes[i]
				if #modes ~= 1 then
					SlashSound:play()
					wait(waiter)
				end
			end
			waiter = waiter + 0.2
		until waiter &gt; 0.7
		waiter = 1
	elseif script.GMValue.Value == 2 then
		m.Text = script.Chooser.Value..&quot; has requested a game mode.&quot;
		wait(1.7)
	end
	if script.GMValue.Value == 1 then
		mod = math.random(1, #modes)
		for i = 1, mod do
			m.Text = &quot;Game mode: &quot; ..modes[i]
			if #modes ~= 1 then
				SlashSound:play()
				wait(waiter)
			end
		end
	elseif script.GMValue.Value == 2 then
		mod = script.ModeValue.Value
	end
	wait(.1)
	if script.GMValue.Value == 1 then
		m.Text = &quot;--&gt; Game mode: &quot;..modes[mod]..&quot; was chosen. &lt;--&quot;
		BamSound:play()
		wait(.05)
		for i = 1, 15 do
			m.Text = &quot;--&gt; Game mode: &quot;..modes[mod]..&quot; was chosen. &lt;--&quot;
			wait(.1)
			m.Text = &quot;--&gt;  Game mode: &quot;..modes[mod]..&quot; was chosen.  &lt;--&quot;
			wait(.1)
		end
	elseif script.GMValue.Value == 2 then
		m.Text = &quot;--&gt; Game mode: &quot;..modesa[mod]..&quot; was chosen. &lt;--&quot;
		BamSound:play()
		wait(.05)
		for i = 1, 15 do
			m.Text = &quot;--&gt; Game mode: &quot;..modesa[mod]..&quot; was chosen. &lt;--&quot;
			wait(.1)
			m.Text = &quot;--&gt;  Game mode: &quot;..modesa[mod]..&quot; was chosen.  &lt;--&quot;
			wait(.1)
		end
	end
	if script.GMValue.Value == 1 then
		StrucCopy = Structure[mod]:clone()
	elseif script.GMValue.Value == 2 then
		StrucCopy = Structurea[mod]:clone()
	end
	StrucCopy.Parent = game.Workspace
	StrucCopy:makeJoints()
	if script.Choosing.Value == 1 or script.Choosing.Value == 2 then
		if game.Workspace:findFirstChild(script.Chooser.Value.. &quot; is requesting a game mode.&quot;) ~= nil then
			request = game.Workspace[script.Chooser.Value.. &quot; is requesting a game mode.&quot;]
			request.Taken.Value = 0
		elseif game.Workspace:findFirstChild(script.Chooser.Value.. &quot; has requested a game mode.&quot;) ~= nil then
			request = game.Workspace[script.Chooser.Value.. &quot; has requested a game mode.&quot;]
			request.Taken.Value = 0
		end
	end
	wait(.7)
	h.Text = &quot;&quot;
	m.Text = &quot;&quot;
	local P = game.Players:GetChildren()
	for i=1, #P do
		if P[i].Character ~= nil then
			if P[i].Character:findFirstChild(&quot;Torso&quot;)~=nil and P[i].Character.Humanoid.Health &gt; 0 then
				if P[i].leaderstats.Round.Value ~= -1 then
					P[i].leaderstats.Round.Value = 1
					P[i].Character.Humanoid.Jump = true
					body = P[i].Character:findFirstChild(&quot;Torso&quot;)
					if body ~= nil then
						if script.GMValue.Value == 1 then
							teleportto=game.Workspace[spawn[mod]]
						elseif script.GMValue.Value == 2 then 
							teleportto=game.Workspace[spawna[mod]]
						end
						if teleportto~=nil then
							local torso = body
							local location = {teleportto.Position}
							local i = 1
							local x = location[i].x
							local y = location[i].y
							local z = location[i].z
							x = x + math.random(-55, 55)
							z = z + math.random(-55, 55)
							y = y + 15
							local cf = torso.CFrame
							local lx = 0
							local ly = y
							local lz = 0
							torso.CFrame = CFrame.new(Vector3.new(x,y,z), Vector3.new(lx,ly,lz))
						end
					end
				end
			end
		end
	end
	wait(5)
	m.Text = &quot;START!&quot;
	wait(3)
	if StrucCopy:findFirstChild(&quot;Enabled&quot;) then
		StrucCopy.Enabled.Value = 1
	end
	m.Text = &quot;&quot;
	timera = 0
	checker = 0
	P = game.Players:GetChildren()
	for i=1, #P do
		if P[i].Character ~= nil then
			if P[i].Character:findFirstChild(&quot;Torso&quot;)~=nil and P[i].Character.Humanoid.Health &gt; 0 then
				checker = checker + 1
			end
		end
	end
	if checker == 2 or checker &gt; 2 then
		rand = math.random(25,30)*game.Players.NumPlayers
		if rand &gt; 150 then
			rand = 150
		elseif rand &lt; 150 then
		end
	elseif checker == 1 or checker == 0 then
		rand = 50
	end
	if script.GMValue.Value == 1 then
		if modes[mod] == &quot;Hyper&quot; then
			CaraDansMusic:play()
			rand = 5005
		end
	elseif script.GMValue.Value == 2 then
		if modesa[mod] == &quot;Hyper&quot; then
			CaraDansMusic:play()
			rand = 5005
		end
	end
	while rand &gt; 0 or rand ~= 0 do
		if script.GMValue.Value == 1 then
			if modes[mod] == &quot;Hyper&quot; then
				wait(math.random(.23,.25))
			else
				wait(math.random(.75,1))
			end
		elseif script.GMValue.Value == 2 then
			if modesa[mod] == &quot;Hyper&quot; then
				wait(math.random(.23,.25))
			else
				wait(math.random(.75,1))
			end
		end
		coinran = math.random(30)
		coin = rand
		checker = 0
		P = game.Players:GetChildren()
		for i=1, #P do
			if P[i].Character ~= nil then
				if P[i].Character:findFirstChild(&quot;Torso&quot;)~=nil and P[i].Character.Humanoid.Health &gt; 0 then
					if P[i].leaderstats.Round.Value == 1 then
						checker = checker + 1
					end
				end
			end
		end
		if checker == 0 or #P &lt; 1 then
			if StrucCopy:findFirstChild(&quot;Enabled&quot;) then
				StrucCopy.Enabled.Value = 0
			end
		end
		if #P &lt; 1 then
			m.Text = &quot;We need 2 players atleast to play. :(&quot;
			AngrySound2:Play()
			CaraDansMusic:stop()
			wait(2)
		elseif checker == 0 then
			m.Text = &quot;Everyone died so the game is over. :(&quot;
			AngrySound3:Play()
			CaraDansMusic:stop()
			rand = 0
			wait(2)
		end
		if coin == 1 then
			timera = 5
		end
		if checker ~= 0 then
			if coinran &lt; 27 or coinran == 27 then
				model = game.Lighting.Coin1
				backup = model:clone() 
				model = backup:clone() 
				model.Parent = game.Workspace
				x = math.random(-60,60)
				z = math.random(-60,60)
				rand = rand  - 1
				if script.GMValue.Value == 1 then
					model.Position = game.Workspace[spawn[mod]].Position + Vector3.new(x ,40, z)
				elseif script.GMValue.Value == 2 then
					model.Position = game.Workspace[spawna[mod]].Position + Vector3.new(x ,40, z)
				end
			elseif coinran == 28 or coinran == 29 then
				model = game.Lighting.Coin5
				backup = model:clone() 
				model = backup:clone() 
				model.Parent = game.Workspace
				x = math.random(-60,60)
				z = math.random(-60,60)
				rand = rand  - 1
				if script.GMValue.Value == 1 then
					model.Position = game.Workspace[spawn[mod]].Position + Vector3.new(x ,40, z)
				elseif script.GMValue.Value == 2 then
					model.Position = game.Workspace[spawna[mod]].Position + Vector3.new(x ,40, z)
				end
			elseif coinran == 30 then
				model = game.Lighting.Coin10
				backup = model:clone() 
				model = backup:clone() 
				model.Parent = game.Workspace
				x = math.random(-60,60)
				z = math.random(-60,60)
				rand = rand  - 1
				if script.GMValue.Value == 1 then
					model.Position = game.Workspace[spawn[mod]].Position + Vector3.new(x ,40, z)
				elseif script.GMValue.Value == 2 then
					model.Position = game.Workspace[spawna[mod]].Position + Vector3.new(x ,40, z)
				end
			end
		end
		h.Text = &quot;Game in progress. Waffles left: &quot;..coin..&quot;&quot;
		if timera ~= 0 then
			while timera &gt; 0 do
				m.Text = &quot;Time runs out in: &quot;..timera..&quot;&quot;
				DingSound:play()
				timera = timera - 1
				wait(1)
			end
		passed = 1
		end
	end
	CaraDansMusic:stop()
	if passed == 1 then
		TadaSound:play()
	elseif passed == 0 then
	end
	m.Text = &quot;&quot;
	if script.GMValue.Value == 1 then
		StrucCopy:remove()
	elseif script.GMValue.Value == 2 then
		StrucCopy:remove()
	end
	passed = 0
	local P = game.Players:GetChildren()
	for i=1, #P do
		if P[i].Character ~= nil then
			if P[i].Character:findFirstChild(&quot;Torso&quot;)~=nil and P[i].Character.Humanoid.Health &gt; 0 then
				if P[i].leaderstats.Round.Value ~= 0 and P[i].leaderstats.Round.Value ~= -1 then
					P[i].leaderstats.Round.Value = 0
					P[i].Character.Humanoid.Jump = true
					body = P[i].Character:findFirstChild(&quot;Torso&quot;)
					if body ~= nil then
						local teleportto=game.Workspace.Lobby.CentralLocation
						if teleportto~=nil then
							local torso = body
							local location = {teleportto.Position}
							local i = 1
							local x = location[i].x
							local y = location[i].y
							local z = location[i].z
							x = x + math.random(-60, 60)
							z = z + 0
							y = y + 8
							local cf = torso.CFrame
							local lx = 0
							local ly = y
							local lz = 0
							torso.CFrame = CFrame.new(Vector3.new(x,y,z), Vector3.new(lx,ly,lz))
						end
					end
				end
			end
		end
	end
	if script.GMValue.Value == 1 then
		table.remove(modes, mod)
		table.remove(spawn, mod)
		table.remove(Structure, mod)
	end
	script.GMValue.Value = 1
	script.Choosing.Value = 0
	chooser = &quot;&quot;
	script.ModeValue.Value = 1
	script.GameEnd.Value = true
	h.Text = &quot;Intermission; 25 seconds&quot;
	wait(25)
	h.Text = &quot;&quot;
end
