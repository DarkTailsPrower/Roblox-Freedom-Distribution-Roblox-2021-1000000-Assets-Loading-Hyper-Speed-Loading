			<Item class="Script" referent="RBX1820">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">while true do
	if game.Workspace.Game.GameEnd.Value == true and script.Parent.Taken.Value ~= 1 and script.Parent.Taken.Value ~= 2 then
		wait(0.17)
		script.Parent.Head.BrickColor = BrickColor.new(&quot;Bright red&quot;)
		script.Parent.Door1.BrickColor = BrickColor.new(&quot;Bright red&quot;)
		script.Parent.Name = &quot;Request a Game Mode - 50 Waffles&quot;
	elseif script.Parent.Taken.Value == 1 then
		wait(0.17)
		script.Parent.Head.BrickColor = BrickColor.new(&quot;Black&quot;)
		script.Parent.Door1.BrickColor = BrickColor.new(&quot;Black&quot;)
		script.Parent.Name = game.Workspace.Game.Chooser.Value..&quot; is requesting a game mode.&quot;
	elseif script.Parent.Taken.Value == 2 then
		wait(0.17)
		script.Parent.Head.BrickColor = BrickColor.new(&quot;Black&quot;)
		script.Parent.Door1.BrickColor = BrickColor.new(&quot;Black&quot;)
		script.Parent.Name = game.Workspace.Game.Chooser.Value..&quot; has requested a game mode.&quot;
	elseif game.Workspace.Game.GameEnd.Value == false then
		wait(0.17)
		script.Parent.Head.BrickColor = BrickColor.new(&quot;Black&quot;)
		script.Parent.Door1.BrickColor = BrickColor.new(&quot;Black&quot;)
		script.Parent.Name = &quot;Game is in progress... or cannot request a game mode yet.&quot;
	end
end
</ProtectedString>
