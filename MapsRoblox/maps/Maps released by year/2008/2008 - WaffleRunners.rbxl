				<ProtectedString name="Source">list1337 = {&quot;xptown2x&quot;, &quot;Player&quot;, &quot;gtyler55&quot;, &quot;Patacorow&quot;, &quot;fireflywater&quot;, &quot;TheBlueMarth&quot;, &quot;Akaradude&quot;, &quot;soraryuu&quot;, &quot;fanofmario2&quot;, &quot;Byndley&quot;, &quot;WaffleRunners&quot;, &quot;B0BBA&quot;, &quot;2cool4you&quot;, &quot;coolj123&quot;, &quot;Randomnessu&quot;}
upgrades = {&quot;Sit&quot;, &quot;Crazy&quot;, &quot;Invinsible&quot;, &quot;Speedup&quot;, &quot;SitI&quot;, &quot;CrazyI&quot;, &quot;SpecCam&quot;}

function onEnter(new)
	local L = Instance.new(&quot;IntValue&quot;)
	local R = Instance.new(&quot;IntValue&quot;)
	local P = Instance.new(&quot;IntValue&quot;)
	local A = Instance.new(&quot;IntValue&quot;)
	L.Name = &quot;leaderstats&quot;
	R.Name = &quot;Round&quot;
	P.Name = &quot;Waffles&quot;
	A.Name = &quot;Total Waffles&quot;
	L.Parent = new
	R.Parent = L
	P.Parent = L
	A.Parent = L
	for i = 1, #upgrades do
		local S = Instance.new(&quot;NumberValue&quot;)
		S.Name = upgrades[i]
		S.Parent = new
	end
	for i = 1, #list1337 do
		if new.Name == list1337[i] then
			wait(2)
			P.Value = 9001
			wait(0.1)
			A.Value = 9001
		end
	end
end

