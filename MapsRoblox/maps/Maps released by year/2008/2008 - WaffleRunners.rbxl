				<Item class="Script" referent="RBX1810">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">RequestGameScript</string>
						<ProtectedString name="Source">modelname=&quot;Door1&quot;
system = game.Workspace.Game
systema = script.Parent.Parent

function onTouched(part)
	if part.Parent ~= nil then
	local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
		if h~=nil then
			local teleportfrom=script.Parent.Enabled.Value
			if teleportfrom~=0 and system.GameEnd.Value ~= false and system.GMValue.Value ~= 2 and systema.Taken.Value == 0 then
				if h==humanoid then
				return
				end
				local teleportto=script.Parent.Parent:findFirstChild(modelname)
				check = part.Parent:FindFirstChild(&quot;Humanoid&quot;)
				if check ~= nil then
					local user = game.Players:GetPlayerFromCharacter(part.Parent)
					local stats = user:findFirstChild(&quot;leaderstats&quot;)
					if stats ~= nil then
						local cash = stats:findFirstChild(&quot;Waffles&quot;)
						local rnd = stats:findFirstChild(&quot;Round&quot;)
						if cash.Value &gt; 50 then
							if teleportto~=nil then
								local torso = h.Parent.Torso
								local location = {teleportto.Position}
								local i = 1

								local x = location[i].x
								local y = location[i].y
								local z = location[i].z
							
								x = x + 3
								z = z
								y = y + 3

								local cf = torso.CFrame
								local lx = 0
								local ly = y
								local lz = 0
								
								rnd.Value = 2
								script.Parent.Enabled.Value=0
								systema.Taken.Value = 1
								system.GMValue.Value = 2
								system.Choosing.Value = 1
								system.Chooser.Value = part.Parent.Name
								teleportto.Enabled.Value=0
								torso.CFrame = CFrame.new(Vector3.new(x,y,z), Vector3.new(lx,ly,lz))
								script.Parent.Enabled.Value=1
								teleportto.Enabled.Value=1
							end
						end
					end
				end
			end
		end
	end
end

script.Parent.Touched:connect(onTouched)</ProtectedString>
