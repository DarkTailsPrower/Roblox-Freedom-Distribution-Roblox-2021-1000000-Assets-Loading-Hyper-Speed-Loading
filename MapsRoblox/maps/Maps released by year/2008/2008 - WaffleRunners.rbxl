system = game.Workspace.Game
systema = script.Parent.Parent

function onTouched(part)
	if part.Parent ~= nil then
	local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
		if h~=nil then
			local teleportfrom=script.Parent.Enabled.Value
			if teleportfrom~=0 and system.Choosing.Value == 1 then
				if h==humanoid then
				return
				end
				local teleportto=game.Workspace.Lobby:findFirstChild(modelname)
				check = part.Parent:FindFirstChild(&quot;Humanoid&quot;)
				if check ~= nil then
					local user = game.Players:GetPlayerFromCharacter(part.Parent)
					local stats = user:findFirstChild(&quot;leaderstats&quot;)
					if stats ~= nil then
						local cash = stats:findFirstChild(&quot;Waf&quot;)
						cash.Value = cash.Value - 50
						local cash = stats:findFirstChild(&quot;Rnd&quot;)
						cash.Value = 0
					end
				end
				if teleportto~=nil then
					local torso = h.Parent.Torso
					local location = {teleportto.Position}
					local i = 1

					local x = location[i].x
					local y = location[i].y
					local z = location[i].z
				
					x = x + 3
					z = z
					y = y + 3

					local cf = torso.CFrame
					local lx = 0
					local ly = y
					local lz = 0
					
					script.Parent.Enabled.Value=0
					system.ModeValue.Value = script.Parent.Name
					system.Choosing.Value = 2
					systema.Taken.Value = 2
					teleportto.Enabled.Value=0
					torso.CFrame = CFrame.new(Vector3.new(x,y,z), Vector3.new(lx,ly,lz))
					script.Parent.Enabled.Value=1
					teleportto.Enabled.Value=1
				end
			end
		end
	end
end

