					<string name="Name">Script</string>
					<ProtectedString name="Source">bin=script.Parent
hint=Instance.new(&quot;Message&quot;)
hint.Text=&quot;Press Q or E to scroll through players.&quot;
cam=workspace.CurrentCamera
num=1

keyd=function(k)
	if(k==&quot;q&quot;)then
		num=num-1
		if(num==0)then
			num=#game.Players:getPlayers()
		end
		cam.CameraSubject = game.Players:getPlayers()[num].Character.Humanoid
		while (k == &quot;q&quot;) and game.Players:getPlayers()[num].Character:findFirstChild(&quot;Humanoid&quot;) and game.Players:getPlayers()[num].Character:findFirstChild(&quot;Torso&quot;) do
			cam.CameraSubject = game.Players:getPlayers()[num].Character.Humanoid
			hint.Text=&quot;Viewing: &quot;..game.Players:getPlayers()[num].Character.Name..&quot; ~~ Health: &quot;..game.Players:getPlayers()[num].Character.Humanoid.Health..&quot;/&quot;..game.Players:getPlayers()[num].Character.Humanoid.MaxHealth..&quot; ~~ Walkspeed: &quot;..game.Players:getPlayers()[num].Character.Humanoid.WalkSpeed..&quot; ~~ Position:  (&quot;..math.floor(game.Players:getPlayers()[num].Character.Torso.Position.x)..&quot;, &quot;..math.floor(game.Players:getPlayers()[num].Character.Torso.Position.y)..&quot;, &quot;..math.floor(game.Players:getPlayers()[num].Character.Torso.Position.z)..&quot;)&quot;
			wait(0.15)
		end
	end
	if(k==&quot;e&quot;)then
		num=num+1
		if(num&gt;#game.Players:getPlayers())then
			num=1
		end
		cam.CameraSubject = game.Players:getPlayers()[num].Character.Humanoid
		while (k == &quot;e&quot;) and game.Players:getPlayers()[num].Character:findFirstChild(&quot;Humanoid&quot;) and game.Players:getPlayers()[num].Character:findFirstChild(&quot;Torso&quot;) do
			cam.CameraSubject = game.Players:getPlayers()[num].Character.Humanoid
			hint.Text=&quot;Viewing: &quot;..game.Players:getPlayers()[num].Character.Name..&quot; ~~ Health: &quot;..game.Players:getPlayers()[num].Character.Humanoid.Health..&quot;/&quot;..game.Players:getPlayers()[num].Character.Humanoid.MaxHealth..&quot; ~~ Walkspeed: &quot;..game.Players:getPlayers()[num].Character.Humanoid.WalkSpeed..&quot; ~~ Position:  (&quot;..math.floor(game.Players:getPlayers()[num].Character.Torso.Position.x)..&quot;, &quot;..math.floor(game.Players:getPlayers()[num].Character.Torso.Position.y)..&quot;, &quot;..math.floor(game.Players:getPlayers()[num].Character.Torso.Position.z)..&quot;)&quot;
			wait(0.15)
		end
	end
end

bin.Selected:connect(function(m)
	spec = script.Parent.Parent.Parent.leaderstats.Rnd
	if spec.Value == 0 then
		spec.Value = -1
	end
	hint.Parent=game.Players.LocalPlayer
	m.Icon=&quot;rbxasset://textures/GunCursor.png&quot;
	m.KeyDown:connect(function(ke) keyd(ke) end)
end)

bin.Deselected:connect(function()
	if spec.Value == -1 then
		spec.Value = 0
	end
	cam.CameraSubject = game.Players.LocalPlayer.Character.Humanoid
	hint.Parent=nil
end)</ProtectedString>
