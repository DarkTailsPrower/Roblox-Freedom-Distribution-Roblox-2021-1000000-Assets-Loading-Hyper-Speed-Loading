function newSound(id)
	local sound = Instance.new(&quot;Sound&quot;)
	sound.SoundId = id
	sound.Parent = script.Parent.Head
	return sound
end


local sDied = newSound(&quot;rbxasset://sounds/uuhhh.wav&quot;)
