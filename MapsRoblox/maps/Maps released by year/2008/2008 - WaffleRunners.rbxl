			<Item class="Script" referent="RBX1722">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">name = &quot;Fake Waffles&quot;

while true do
	if script.Parent.Enabled.Value == 1 then
		coinran = math.random(1,30)
		if coinran &lt; 27 or coinran == 27 then
			model = game.Lighting.Coin1Fake
			backup = model:clone() 
			model = backup:clone() 
			model.Parent = game.Workspace
			x = math.random(-60,60)
			z = math.random(-60,60)
			model.Position = game.Workspace[name].Plate.Position + Vector3.new(x ,40, z)
		elseif coinran == 28 or coinran == 29 then
			model = game.Lighting.Coin5Fake
			backup = model:clone() 
			model = backup:clone() 
			model.Parent = game.Workspace
			x = math.random(-60,60)
			z = math.random(-60,60)
			model.Position = game.Workspace[name].Plate.Position + Vector3.new(x ,40, z)
		elseif coinran == 30 then
			model = game.Lighting.Coin10Fake
			backup = model:clone() 
			model = backup:clone() 
			model.Parent = game.Workspace
			x = math.random(-60,60)
			z = math.random(-60,60)
			model.Position = game.Workspace[name].Plate.Position + Vector3.new(x ,40, z)
		end
		wait(math.random(0.7,1.3))
	elseif script.Parent.Enabled.Value == 0 then
		wait(0.3)
	end
end
</ProtectedString>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
