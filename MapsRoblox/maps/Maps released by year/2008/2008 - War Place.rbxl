						<Item class="Sound" referent="RBX1657">
							<Properties>
								<bool name="Looped">false</bool>
								<string name="Name">Fire</string>
								<int name="PlayCount">109</int>
								<bool name="PlayOnRemove">false</bool>
								<Content name="SoundId"><hash>634bfa9634757f636f97c34c6008a41f</hash></Content>
