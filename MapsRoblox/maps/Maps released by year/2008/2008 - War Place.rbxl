					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">TankDriver</string>
					<string name="Source">bin=script.Parent
Tank = nil
local debounce = false
local Tankdebounce = false
local controlling = false
local TankActive = false
local speed = 0

function computeDirection(vec)
	local lenSquared = vec.magnitude * vec.magnitude
	local invSqrt = 1 / math.sqrt(lenSquared)
	return Vector3.new(vec.x * invSqrt, vec.y * invSqrt, vec.z * invSqrt)
end

function fire(pln,spn)
        local missile = bin.Rocket:clone()

	missile.CFrame = spn.CFrame * CFrame.new(0, 0, -15)

	missile.RocketScript.Disabled = false
	missile.Parent = game.Workspace

	local creator_tag = Instance.new(&quot;ObjectValue&quot;)
	creator_tag.Value = game.Players.LocalPlayer
	creator_tag.Name = &quot;creator&quot;
	creator_tag.Parent = missile

	missile.Owner.Value = pln
end

function moveturret(target, Engine)
	local origincframe = Engine:findFirstChild(&quot;BodyGyro&quot;).cframe
	local dir = (target - Engine.Position).unit
	local spawnPos = Engine.Position

	local pos = spawnPos + (dir * 1)

	Engine:findFirstChild(&quot;BodyGyro&quot;).maxTorque = Vector3.new(0, 90, 0)
	Engine:findFirstChild(&quot;BodyGyro&quot;).cframe = CFrame.new(pos,  pos + dir)

end
function movebarrel(target, Engine)
	local origincframe = Engine:findFirstChild(&quot;BodyGyro&quot;).cframe
	local dir = (target - Engine.Position).unit
	local spawnPos = Engine.Position

	local pos = spawnPos + (dir * 1)

	Engine:findFirstChild(&quot;BodyGyro&quot;).maxTorque = Vector3.new(90, 0, 90)
	Engine:findFirstChild(&quot;BodyGyro&quot;).cframe = CFrame.new(pos,  pos + dir)
end

function findTank(player)
	local list = player.Character:GetChildren()
	for x = 1, #list do
		if (list[x].Name == &quot;Tank&quot;) then
			local weld = list[x]:FindFirstChild(&quot;Parts&quot;):FindFirstChild(&quot;Seat&quot;):FindFirstChild(&quot;SeatWeld&quot;)
			if (weld ~= nil) and (weld.Part1 == player.Character:FindFirstChild(&quot;Torso&quot;)) then
				return list[x]
			end
		end
	end
	return nil
end

function onButton1Down(mouse)
	local vehicle = findTank(script.Parent.Parent.Parent)

	if vehicle ~= nil and debounce == false and Tankdebounce == false then
	debounce = true

	controlling = true

	while true do
		wait()
		local Turret = vehicle.Parts.Weapon.Turret.Engine
		local Barrel = vehicle.Parts.Weapon.Barrel.Engine
		local position = mouse.Hit
		local target = position.p
		if Turret:findFirstChild(&quot;TankTurretScript&quot;) ~= nil then
			moveturret(target, Turret)
		end
		if Barrel:findFirstChild(&quot;TankBarrelScript&quot;) ~= nil then
			movebarrel(target, Barrel)
		end
		if Tankdebounce == true or
		controlling == false then break end
	end
	wait(.1)
	debounce = false
	end
end

function onButton1Up(mouse)
	controlling = false
end

function onSelected(mouse)
	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
	mouse.Button1Up:connect(function() onButton1Up(mouse) end)
	mouse.KeyDown:connect(onKeyDown)
end

function onKeyDown(key)
	if (key~=nil) then
		key = key:lower()
		local vehicle = findTank(script.Parent.Parent.Parent)
		if (vehicle==nil) then return end
		Tank = vehicle.Parts
		local Engine = vehicle.Parts.Engine
		local r1 = Engine.Parent.r1
		local r2 = Engine.Parent.r2
		local r3 = Engine.Parent.r3
		local r4 = Engine.Parent.r4
		local r5 = Engine.Parent.r5
		local l1 = Engine.Parent.l1
		local l2 = Engine.Parent.l2
		local l3 = Engine.Parent.l3
		local l4 = Engine.Parent.l4
		local l5 = Engine.Parent.l5
		local speed = Engine:findFirstChild(&quot;Speed&quot;).Value

		if (key==&quot;n&quot;) and Tankdebounce == false then -- turn of our tank
			local Turretpower = Tank.Weapon.Turret.Engine:findFirstChild(&quot;TankTurretScript&quot;)
			local Barrelpower = Tank.Weapon.Barrel.Engine:findFirstChild(&quot;TankBarrelScript&quot;)
			if (Barrelpower ~= nil) then
				Barrelpower:remove()
			end
			if (Turretpower ~= nil) then
				Turretpower:remove()
			end
			r1.RightParamB = 0
			r1.RightParamA = 0	
			r2.RightParamB = 0
			r2.RightParamA = 0
			r3.RightParamB = 0
			r3.RightParamA = 0	
			r4.RightParamB = 0
			r4.RightParamA = 0
			r5.RightParamB = 0
			r5.RightParamA = 0	
	
			l1.RightParamB = 0
			l1.RightParamA = 0
			l2.RightParamB = 0
			l2.RightParamA = 0
			l3.RightParamB = 0
			l3.RightParamA = 0
			l4.RightParamB = 0
			l4.RightParamA = 0
			l5.RightParamB = 0
			l5.RightParamA = 0

			TankActive = false
		end
		if(key == &quot;y&quot;) then -- turn on our tank
			TankActive = true
			local Turretpower = Tank.Weapon.Turret.Engine:findFirstChild(&quot;TankTurretScript&quot;)
			local Barrelpower = Tank.Weapon.Barrel.Engine:findFirstChild(&quot;TankBarrelScript&quot;)
			if (Turretpower ~= nil) then return end
			if (Barrelpower ~= nil) then return end
			local Turretsc = script.TankTurretScript:clone()
			local Barrelsc = script.TankBarrelScript:clone()
			Turretsc.Disabled = true
			Barrelsc.Disabled = true
			Turretsc.Parent = Tank.Weapon.Turret.Engine
			Barrelsc.Parent = Tank.Weapon.Barrel.Engine
		end
		if(TankActive == true) then
			if((key == &quot;b&quot;) or (key == &quot;m&quot;) or (key == &quot;t&quot;) or (key == &quot;u&quot;) or (key == &quot;g&quot;) or (key == &quot;j&quot;)) then -- primary movement keys
				if (key==&quot;t&quot;) then   -- left track forward
					l1.RightParamB = speed
					l1.RightParamA = speed*-1
					l2.RightParamB = speed
					l2.RightParamA = speed*-1
					l3.RightParamB = speed
					l3.RightParamA = speed*-1
					l4.RightParamB = speed
					l4.RightParamA = speed*-1
					l5.RightParamB = speed
					l5.RightParamA = speed*-1
				end
				if (key==&quot;g&quot;) then--  Left track Stop
					l1.RightParamB = 0
					l1.RightParamA = 0
					l2.RightParamB = 0
					l2.RightParamA = 0
					l3.RightParamB = 0
					l3.RightParamA = 0
					l4.RightParamB = 0
					l4.RightParamA = 0
					l5.RightParamB = 0
					l5.RightParamA = 0
				end
				if (key==&quot;b&quot;) then--  Left track Backwards
					l1.RightParamB = speed*-1
					l1.RightParamA = speed
					l2.RightParamB = speed*-1
					l2.RightParamA = speed	
					l3.RightParamB = speed*-1
					l3.RightParamA = speed
					l4.RightParamB = speed*-1
					l4.RightParamA = speed
					l5.RightParamB = speed*-1
					l5.RightParamA = speed	
				end
				if (key==&quot;u&quot;) then   -- Right track forward
					r1.RightParamB = speed*-1
					r1.RightParamA = speed
					r2.RightParamB = speed*-1
					r2.RightParamA = speed
					r3.RightParamB = speed*-1
					r3.RightParamA = speed
					r4.RightParamB = speed*-1
					r4.RightParamA = speed
					r5.RightParamB = speed*-1
					r5.RightParamA = speed
				end
				if (key==&quot;j&quot;) then   -- Right track Stop
					r1.RightParamB = 0
					r1.RightParamA = 0
					r2.RightParamB = 0
					r2.RightParamA = 0
					r3.RightParamB = 0
					r3.RightParamA = 0
					r4.RightParamB = 0
					r4.RightParamA = 0
					r5.RightParamB = 0
					r5.RightParamA = 0
				end
				if (key==&quot;m&quot;) then   -- Right track Backwards
					r1.RightParamB = speed
					r1.RightParamA = speed*-1
					r2.RightParamB = speed
					r2.RightParamA = speed*-1
					r3.RightParamB = speed
					r3.RightParamA = speed*-1
					r4.RightParamB = speed
					r4.RightParamA = speed*-1
					r5.RightParamB = speed
					r5.RightParamA = speed*-1
				end
			end
			if (key==&quot;h&quot;) and (bin.Reload.Value == 0) then
				FiringSpeed = vehicle.Parts.Weapon.FiringSpeed
				fire(vehicle,vehicle.Parts.Weapon.Barrel.BigGun)
				bin.Reload.Value = 1
				wait(FiringSpeed.Value)
				bin.Reload.Value = 0
			end
		end
	end

end

bin.Selected:connect(onSelected)
