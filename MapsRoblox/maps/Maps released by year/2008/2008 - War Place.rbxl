					<Item class="Script" referent="RBX1543">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">RegenScript</string>
							<string name="Source">system = script.Parent
model1 = system.Station1
backup1 = model1:Clone()
regen = system.Regen

function regenerate1(model,backup)
	model:remove()
	wait(1)
	model1 = backup:Clone()
	model1.Parent = system
	model1:MakeJoints()
end

function checkRegen()
	if regen.Value == 1 then
		regenerate1(model1,backup1)
	end
end
regen.Changed:connect(checkRegen)</string>
							<bool name="archivable">true</bool>
