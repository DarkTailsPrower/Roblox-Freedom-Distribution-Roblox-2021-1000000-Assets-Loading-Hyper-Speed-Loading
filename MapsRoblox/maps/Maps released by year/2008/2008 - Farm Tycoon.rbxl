								<string name="Name">Script</string>
								<string name="Source">name = script.Parent.Parent
parent = name.Parent
local ting = 0

function onTouched(hit)
	if ting == 0 then
	ting = 1
	check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
	if check ~= nil then
		local user = game.Players:findFirstChild(hit.Parent.Name)
		if user ~= nil then
			local cowscar = user.cowsCarried
			local cows = parent.cows
			if cowscar.Value &gt; 0 and cows.Value &lt; 3 then
				local newcow = parent.cow.Value:clone()
				newcow.Parent = parent
				newcow:MakeJoints()
				cowscar.Value = cowscar.Value - 1
				cows.Value = cows.Value + 1
				local msg = user:findFirstChild(&quot;Message&quot;)
				if msg ~= nil then
					msg:remove()
				end
				wait(1)
			end
		end
	end
	ting = 0
	end
end

script.Parent.Touched:connect(onTouched)
