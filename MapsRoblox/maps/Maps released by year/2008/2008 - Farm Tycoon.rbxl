				<Item class="Script" referent="RBX145">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<string name="Source">local ting = 0 

function onTouched(hit)

	if ting == 0 then 
	ting = 1 
	check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;) 

	if check ~= nil then 

		local user = game.Players:findFirstChild(hit.Parent.Name) 
		local stats = user:findFirstChild(&quot;leaderstats&quot;) 

		if stats ~= nil then 
			local carriedcows = user.cowsCarried
			local cash = stats:findFirstChild(&quot;Money&quot;) 
			if cash.Value &gt; 2499 then
				if carriedcows.Value &lt; 1 then
					cash.Value = cash.Value - 2500
					carriedcows.Value = carriedcows.Value + 1
					message = user:findFirstChild(&quot;Message&quot;)
					if message ~= nil then
						message:remove()
					end
					message = Instance.new(&quot;Message&quot;) 
					message.Text = &quot;Carried cows: &quot; .. carriedcows.Value
					message.Parent = user
					wait(2)
				end
			end
		end

	end

	ting = 0
	end

end

script.Parent.Touched:connect(onTouched)
</string>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
