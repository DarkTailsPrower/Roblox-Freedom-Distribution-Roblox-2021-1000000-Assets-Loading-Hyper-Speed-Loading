								<string name="Source">name = script.Parent.Parent
parent = name.Parent
local ting = 0

function onTouched(hit)
	if ting == 0 then
	ting = 1
	check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
	if check ~= nil then
		local user = game.Players:findFirstChild(hit.Parent.Name)
		if user ~= nil then
			local meadow = parent.meadow
			local quality = meadow.quality
			if quality.Value &lt; 4 then
				local cash = user.leaderstats.Money
				if cash.Value &gt;349 then
				cash.Value = cash.Value - 350
				quality.Value = quality.Value + 1

				if quality.Value == 1 then
					meadow.BrickColor = BrickColor.new(29)
				end

				if quality.Value == 2 then
					meadow.BrickColor = BrickColor.new(119)
				end

				if quality.Value == 3 then
					meadow.BrickColor = BrickColor.new(37)
				end

				if quality.Value == 4 then
					meadow.BrickColor = BrickColor.new(28)
					name.Name = &quot;Meadow is perfect!&quot;
					wait(10)
					name:remove()
				end
				wait(1)
				end
			end
		end
	end
	ting = 0
	end
end

