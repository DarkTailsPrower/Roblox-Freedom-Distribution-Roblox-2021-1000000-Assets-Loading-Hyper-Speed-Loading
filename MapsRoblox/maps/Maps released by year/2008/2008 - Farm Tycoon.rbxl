						<string name="Source">name = script.Parent
owner = name.Parent.Owner

while true do
if owner.Value ~= &quot;&quot; then
name.Name = owner.Value .. &quot;s Farm!&quot;
else
name.Name = &quot;Nobodys Farm!&quot;
end
wait(2)
end
</string>
