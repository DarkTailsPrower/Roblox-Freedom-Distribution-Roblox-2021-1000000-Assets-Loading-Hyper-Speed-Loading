						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<string name="Source">message = Instance.new(&quot;Message&quot;) 
local ting = 0 

function onTouched(hit)
	if ting == 0 then 
	ting = 1 
	check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;) 
	if check ~= nil then 
		player = game.Players:findFirstChild(hit.Parent.Name) 
		if player ~= nil then
			if player:findFirstChild(&quot;Helper&quot;) == nil then
			local helper = Instance.new(&quot;IntValue&quot;)
			helper.Name = &quot;Helper&quot;
			helper.Parent = player
			script.Parent.BrickColor = BrickColor.new(226)
			message.Parent = player
			message.Text = &quot;Buy a chicken at the shop&quot;
			wait(3) 
			message.Text = &quot;Then put it in your farm&quot;
			wait(3)
			message.Text = &quot;Feed the chicken and it lays eggs&quot;
			wait(3) 
			message.Text = &quot;Be patient, egglaying takes time&quot;
			wait(3) 
			message.Text = &quot;Eggs can be sold or hatched&quot;
			wait(3) 
			message.Text = &quot;Eggs hatch after a while&quot;
			wait(3) 
			message.Text = &quot;Grown chickens can be picked up&quot;
			wait(3) 
			message.Text = &quot;Pick them up with the sell-tool&quot;
			wait(3) 
			message.Text = &quot;Then sell or use your new chicken&quot;
			wait(3) 
			message.Parent = nil
			script.Parent.BrickColor = BrickColor.new(45)
			helper:remove()
			end
		end
	end
	ting = 0 
	end
end

script.Parent.Touched:connect(onTouched) 
