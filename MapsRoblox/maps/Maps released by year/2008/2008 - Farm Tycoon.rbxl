								<string name="Name">Script</string>
								<string name="Source">wait(1)
local ting = 0
name = script.Parent.Parent
owner = name.Parent.Parent.Owner
soldOn = &quot;Wood is being sold (ON/OFF)&quot;
soldOff = &quot;Wood is not being sold (ON/OFF)&quot;
sellbutton = name.Parent:findFirstChild(&quot;Buy 10 wood - 500,-&quot;)
newbutton = sellbutton:clone()
sellbutton:remove()

function onTouched(hit)

	if ting == 0 then
	ting = 1 
	check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)

	if check ~= nil then 
		local user = game.Players:GetPlayerFromCharacter(hit.Parent)
		if user.Name == owner.Value then
		if name.Name == &quot;Wood is not being sold (ON/OFF)&quot; then
			name.Name = &quot;Wood is being sold (ON/OFF)&quot;
			local button = newbutton:clone()
			button.Parent = name.Parent
			wait(2)
		else
			name.Name = &quot;Wood is not being sold (ON/OFF)&quot;
			local button = name.Parent:findFirstChild(&quot;Buy 10 wood - 500,-&quot;)
			if button ~= nil then
				button:remove()
			end
			wait(2)
		end
		end
	end

	ting = 0
	end

end

