size = field.Size
local ting = 0

function onTouched(hit)
	if ting == 0 then
	ting = 1
	local owner = field.Parent.Owner.Value
	check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
	if check ~= nil then
		local user = game.Players:findFirstChild(hit.Parent.Name) 
		if user ~= nil then
		if owner == user.Name then
			local stats = user:findFirstChild(&quot;leaderstats&quot;)
			if stats ~= nil then
				local cash = stats:findFirstChild(&quot;Money&quot;)

				if size.Value == 2 then
				if cash.Value &gt; 999 then
					cash.Value  = cash.Value -1000
					size.Value = 3
					name.Name = &quot;Field is extended!&quot;
					wait(3)
					name.Name = &quot;Field-size is maxed!&quot;
				end
				end

				if size.Value == 1 then
				if cash.Value &gt; 499 then
					cash.Value  = cash.Value -500
					size.Value = 2
					name.Name = &quot;Field is extended!&quot;
					wait(3)
					name.Name = &quot;Extend Field! 1000,-&quot;
				end
				end

				if size.Value == 0 then
				if cash.Value &gt; 99 then
					cash.Value  = cash.Value -100
					size.Value = 1
					name.Name = &quot;Field is extended!&quot;
					wait(3)
					name.Name = &quot;Extend Field! 500,-&quot;
				end
				end


			end
		end
		end
	end
	ting = 0
	end
end

script.Parent.Touched:connect(onTouched)
</string>
								<bool name="archivable">true</bool>
							</Properties>
						</Item>
					</Item>
				</Item>
				<Item class="Script" referent="RBX5521">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">sizeChecker</string>
						<string name="Source">field = script.Parent
size = field.Size
earth = field.Earth
extention1 = field.Extention1
extention2 = field.Extention2
extention3 = field.Extention3
newextention1 = extention1:clone()
newextention2 = extention2:clone()
newextention3 = extention3:clone()
check = 10

while true do

if size.Value == check then
	wait(1)
else
	if size.Value == 0 then
		earth.Size = Vector3.new(6, 0.8, 50)
		ext = field:findFirstChild(&quot;Extention1&quot;)
		if ext ~= nil then
			ext:remove()
		end
		ext = field:findFirstChild(&quot;Extention2&quot;)
		if ext ~= nil then
			ext:remove()
		end
		ext = field:findFirstChild(&quot;Extention3&quot;)
		if ext ~= nil then
			ext:remove()
		end
		check = size.Value
	end

	if size.Value == 1 then
		earth.Size = Vector3.new(20, 0.8, 50)
		ext = newextention1:clone()
		ext.Parent = field
		check = size.Value
	end

	if size.Value == 2 then
		earth.Size = Vector3.new(34, 0.8, 50)
		ext = newextention2:clone()
		ext.Parent = field
		check = size.Value
	end

	if size.Value == 3 then
		earth.Size = Vector3.new(48, 0.8, 50)
		ext = newextention3:clone()
		ext.Parent = field
		check = size.Value
	end
end
end
