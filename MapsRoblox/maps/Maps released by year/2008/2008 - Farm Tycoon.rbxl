				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Crazymovement</string>
					<string name="Source">torso = script.Parent.Torso

while true do
torso.RotVelocity = Vector3.new(0,120,0)
wait(math.random(1,10))
torso.RotVelocity = Vector3.new(120,0,0)
wait(math.random(1,10))
torso.RotVelocity = Vector3.new(0,0,120)
wait(math.random(1,10))
torso.RotVelocity = Vector3.new(0,-120,0)
wait(math.random(1,10))
torso.RotVelocity = Vector3.new(-120,0,0)
wait(math.random(1,10))
torso.RotVelocity = Vector3.new(0,0,-120)
wait(math.random(1,10))
end
</string>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
