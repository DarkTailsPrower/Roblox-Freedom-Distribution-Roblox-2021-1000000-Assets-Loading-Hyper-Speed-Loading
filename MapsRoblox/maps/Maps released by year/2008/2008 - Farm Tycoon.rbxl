								<string name="Name">Script</string>
								<string name="Source">model = script.Parent.Parent.Autofeeder
Upgradecost = 1200
owner = model.Parent.Parent.Parent.Owner
upgradeStuff = model:clone()

model:remove()

local ting = 0

function onTouched(hit)
print(&quot;touched&quot;)
	if ting == 0 then
	ting = 1
	check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
	if check ~= nil then 
		local user = game.Players:GetPlayerFromCharacter(hit.Parent) 
print(&quot;touched2&quot;)
		if user.Name == owner.Value and script.Parent.Parent.Name == &quot;Install auto-feeder 1200,-&quot; then
		local stats = user:findFirstChild(&quot;leaderstats&quot;) 

		if stats ~= nil then 
			local cash = stats:findFirstChild(&quot;Money&quot;) 
			if cash.Value &gt; (Upgradecost-1) then 
				cash.Value = cash.Value - Upgradecost 
				upgradeStuff2 = upgradeStuff:clone()
				upgradeStuff2.Parent = script.Parent.Parent
				script.Parent.Parent.Name = &quot;Autofeeder In Place&quot;
			end
		end
		end
	end

	ting = 0 
	end
end

script.Parent.Touched:connect(onTouched)
