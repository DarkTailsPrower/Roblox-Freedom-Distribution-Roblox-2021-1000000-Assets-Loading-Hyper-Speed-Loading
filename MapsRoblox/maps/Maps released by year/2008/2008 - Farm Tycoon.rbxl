							<string name="Source">hatch = script.Parent
button = hatch:findFirstChild(&quot;Build Hatchery bin - 30 wood&quot;)
hatch.buttonclone.Value = button:clone()

hatch.hatchclone.Value = hatch.stuff:clone()
hatch.stuff:remove()
