						<string name="Name">spawnchecker</string>
						<string name="Source">owner = script.Parent.Parent.Owner
pot = script.Parent.Megapotato:clone()
script.Parent.Megapotato:remove()

while true do
	local user = game.Players:findFirstChild(owner.Value)
	if user == nil then
	wait(5)
	else
	if user.reward1.Value == 1 then
		user.reward1.Value = 2
		local newpot = pot:clone()
		newpot.Parent = script.Parent
	end
	end
	wait(1)
end
