								<string name="Name">Script</string>
								<string name="Source">model = script.Parent.Parent.Parent.SunFilter
cabmoney = model.Parent.Parent.CabbageMoney
potmoney = model.Parent.Parent.PotatoMoney
Upgradecost = 1750
owner = model.Parent.Parent.Owner
upgradeStuff = model:clone()

model:remove()

local ting = 0

function onTouched(hit)
print(&quot;touched&quot;)
	if ting == 0 then
	ting = 1
	check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
	if check ~= nil then 
		local user = game.Players:findFirstChild(hit.Parent.Name)
		if user ~= nil then
		if user.Name == owner.Value and script.Parent.Parent.Name == &quot;Sunfilter - 1750,-&quot; then
		local stats = user:findFirstChild(&quot;leaderstats&quot;) 

		if stats ~= nil then 
			local cash = stats:findFirstChild(&quot;Money&quot;) 
			if cash.Value &gt; (Upgradecost-1) then 
				cabmoney.Value = cabmoney.Value * 2
				potmoney.Value = potmoney.Value * 2
				cash.Value = cash.Value - Upgradecost 
				upgradeStuff2 = upgradeStuff:clone()
				upgradeStuff2.Parent = script.Parent.Parent.Parent
				field = upgradeStuff2.Parent.Parent.Field
				field.GrowthTime.Value = field.GrowthTime.Value / 2
				script.Parent.Parent.Name = &quot;Sunfilter In Place&quot;
			end
		end
		end
		end
	end

	ting = 0 
	end
end

script.Parent.Touched:connect(onTouched)
