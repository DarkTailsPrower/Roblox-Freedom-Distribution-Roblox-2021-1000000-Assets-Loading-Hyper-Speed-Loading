					<Item class="Script" referent="RBX31">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<string name="Source">local ting = 0

function onTouched(hit)

	if ting == 0 then
	ting = 1 
	check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)

	if check ~= nil then 

		local user = game.Players:GetPlayerFromCharacter(hit.Parent)
		local logs = user.lumberCarried
		local reward = user.reward1
		if logs.Value &gt; 14 then 
			if reward.Value == 0 then
				reward.Value = 1
				logs.Value = logs.Value - 15
				local msg = user:findFirstChild(&quot;Message&quot;)
				local tmp = &quot;&quot;
				if msg ~= nil then
					tmp = msg.Text
					msg:remove()
				end
				msg = Instance.new(&quot;Message&quot;) 
				msg.Text  = &quot;Reward: Mega-Potato unlocked!&quot;
				msg.Parent = user
				wait(3)
				if tmp ~= &quot;&quot; then
					msg.Text = tmp
				else
					msg:remove()
				end
			else
				local msg = user:findFirstChild(&quot;Message&quot;)
				local tmp = &quot;&quot;
				if msg ~= nil then
					tmp = msg.Text
					msg:remove()
				end
				msg = Instance.new(&quot;Message&quot;) 
				msg.Text  = &quot;--Already received reward--&quot;
				msg.Parent = user
				wait(3)
				if tmp ~= &quot;&quot; then
					msg.Text = tmp
				else
					msg:remove()
				end
			end
			wait(3) 
		end
	end

	ting = 0
	end

end

