					<Item class="Script" referent="RBX2869">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">HatchAndJump</string>
							<string name="Source">chicken = script.Parent.chickenclone
chicken.Value = script.Parent.Chicken:clone()
script.Parent.Chicken:remove()
feeder = script.Parent.feederclone
feeder.Value = script.Parent.Feeder:clone()
script.Parent.Feeder:remove()
egg = script.Parent.eggclone
egg.Value = script.Parent.Egg:clone()
script.Parent.Egg:remove()
eggs = script.Parent.Parent.eggs
script.Parent.Buttonclone.Value = script.Parent:findFirstChild(&quot;Place Chicken&quot;):clone()


while true do
	chick = script.Parent:findFirstChild(&quot;Chicken&quot;)
	if chick == nil then
		wait(5)
	else
		check = math.random(2,8)
		wait(7)
		if check == 5  and script.Parent.Feeder.Feed.Transparency &lt; 0.9 then
			if eggs.Value &lt; 7 then
			eggs.Value = eggs.Value + 1
			newegg = egg.Value:clone()
			newegg.Parent = script.Parent
			newegg.quality.Value = 5 - (script.Parent.Feeder.Feed.Transparency * 10)
			script.Parent.Feeder.Feed.Transparency = 1
			end
		end
	end
end
