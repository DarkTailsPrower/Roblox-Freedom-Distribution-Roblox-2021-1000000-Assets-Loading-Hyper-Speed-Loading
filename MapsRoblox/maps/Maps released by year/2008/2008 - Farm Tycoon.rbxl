					<string name="Name">Script</string>
					<string name="Source">--not mine (got from all models)
hour = script.Parent.H
minute = script.Parent.M
second = script.Parent.S


while true do
	second.Value = second.Value + 5
	if second.Value &gt;= 60 then
		minute.Value = minute.Value + 1
		second.Value = 0
	end
	if minute.Value &gt;= 60 then
		hour.Value = hour.Value + 1
		minute.Value = 0
	end
	if hour.Value &gt;= 23 and minute.Value &gt;= 58 then
		hour.Value = 0
		minute.Value = 0
		second.Value = 0
	end
	if hour.Value &gt;= 24 then
		hour.Value = 0
		minute.Value = 0
		second.Value = 0
	end
	game.Lighting.TimeOfDay = hour.Value .. &quot;:&quot; .. minute.Value .. &quot;:&quot;  .. second.Value
	wait(0.1)
end
