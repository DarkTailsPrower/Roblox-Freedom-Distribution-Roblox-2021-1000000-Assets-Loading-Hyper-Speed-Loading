		<Item class="Tool" referent="RBX8631">
			<Properties>
				<int name="ActivationState">0</int>
				<int name="BackendToolState">1</int>
				<bool name="Enabled">true</bool>
				<CoordinateFrame name="Grip">
					<X>0</X>
					<Y>0</Y>
					<Z>0.5</Z>
					<R00>1</R00>
					<R01>0</R01>
					<R02>0</R02>
					<R10>0</R10>
					<R11>1</R11>
					<R12>0</R12>
					<R20>0</R20>
					<R21>0</R21>
					<R22>1</R22>
				</CoordinateFrame>
				<string name="Name">Sell</string>
				<Content name="TextureId"><null></null></Content>
				<bool name="archivable">true</bool>
			</Properties>
			<Item class="Script" referent="RBX8632">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<string name="Source">Tool = script.Parent

function onActivated() 
	if not Tool.Enabled then
		return
	end
	
	Tool.Enabled = false
	local hit = Tool.Target.Value


	if hit ~= nil then 

		if hit.Parent.Name == &quot;Chicken&quot; then
			owner = hit.Parent.Parent.Parent.Parent.Owner.Value
			if owner == Tool.Parent.Name then
			user = game.Players:findFirstChild(owner)
			if user.chickensCarried.Value &lt; 3 then
			local temp = hit.Parent.Parent
			if temp.Name == &quot;feeder&quot; then
				temp.Feeder:remove()
				local newbutton = temp.Buttonclone.Value:clone()
				newbutton.Parent = temp
			end
			if temp.Name == &quot;Hatchery&quot; then
				temp.stopper.Transparency = 1
				temp.stopper.CanCollide = false
			end
			hit.Parent:remove()
			local carriedchicks = user.chickensCarried
			carriedchicks.Value = carriedchicks.Value + 1
			local message = user:findFirstChild(&quot;Message&quot;)
			if message ~= nil then
				message:remove()
			end
			message = Instance.new(&quot;Message&quot;) 
			message.Text = &quot;Carried chickens: &quot; .. carriedchicks.Value
			message.Parent = user
			end
			end
		end

		if hit.Name == &quot;milk&quot; then
			owner = hit.Parent.Parent.Parent.Parent.Owner.Value
			user = game.Players:findFirstChild(owner)
			if user ~= nil then 
			local upgrade = user:findFirstChild(&quot;harvestLvl&quot;)
			local stats = user:findFirstChild(&quot;leaderstats&quot;)
			local cash = stats:findFirstChild(&quot;Money&quot;)
			local qual = hit.quality.Value
			user.milksSold.Value = user.milksSold.Value + 1
			cash.Value = cash.Value + 50 + (10 * qual)
			local counter = 0
			c = hit.Parent:getChildren()
			for s = 1, #c do
				if counter &lt; upgrade.Value then
					if c[s].Name == &quot;Milk&quot; and c[s] ~= hit then
						user.milksSold.Value = user.milksSold.Value + 1
						local qual = c[s].quality.Value
						cash.Value = cash.Value + 50 + (10 * qual)
						c[s]:remove()
						counter = counter + 1
					end
				end
			end
			end
			hit:remove()
		end

		if hit.Name == &quot;Egg&quot; then
			if hit.Parent.Name ~= &quot;Hatchery&quot; then --eggs for hatching cannot be sold
			owner = hit.Parent.Parent.Parent.Owner.Value
			user = game.Players:findFirstChild(owner)
			if user ~= nil then 
			local upgrade = user:findFirstChild(&quot;harvestLvl&quot;)
			local stats = user:findFirstChild(&quot;leaderstats&quot;)
			local cash = stats:findFirstChild(&quot;Money&quot;)
			local qual = hit.quality.Value
			cash.Value = cash.Value + 200 + (30 * qual)
			hit.Parent.Parent.eggs.Value = hit.Parent.Parent.eggs.Value - 1
			local counter = 0
			c = hit.Parent:getChildren()
			for s = 1, #c do
				if counter &lt; upgrade.Value then
					if c[s].Name == &quot;Egg&quot; and c[s] ~= hit then
						local qual = c[s].quality.Value
						cash.Value = cash.Value + 200 + (30 * qual)
						c[s].Parent.Parent.eggs.Value = hit.Parent.Parent.eggs.Value - 1
						c[s]:remove()
						counter = counter + 1
					end
				end
			end
			end
			hit:remove()
			end
		end 

		if hit.Name == &quot;Cabbage&quot; then 
			if hit.ready.Value == 1 then
				temp = hit.Parent.Parent.Parent:findFirstChild(&quot;Owner&quot;)
				if temp == nil then
					temp = hit.Parent.Parent.Parent.Parent:findFirstChild(&quot;Owner&quot;)
				end
				local user = game.Players:findFirstChild(temp.Value)
				if user ~= nil then
				local upgrade = user:findFirstChild(&quot;harvestLvl&quot;)
				local stats = user:findFirstChild(&quot;leaderstats&quot;)
				local cash = stats:findFirstChild(&quot;Money&quot;)
				local counter = 0
				c = hit.Parent:getChildren()
				for s = 1, #c do
					if c[s].ready.Value == 1 and counter &lt; upgrade.Value + 1 then
					if c[s].BrickColor == BrickColor.new(38) then
					cash.Value = cash.Value + temp.Parent.PotatoMoney.Value
					else
					cash.Value = cash.Value + temp.Parent.CabbageMoney.Value
					end
					c[s].Transparency = 0.7
					c[s].Size = Vector3.new(1,1,1)
					c[s].Reflectance = 0
					local location = {c[s].Position}
					local i = 1
					local x = location[i].x
					local z = location[i].z
					c[s].Position = Vector3.new(x,3.3,z)
					c[s].BrickColor = BrickColor.new(226)
					c[s].ready.Value = 0
					counter = counter +1
					end
				end
				end
			end
		end 
	end

	Tool.Enabled = true

end 

Tool.Activated:connect(onActivated)
