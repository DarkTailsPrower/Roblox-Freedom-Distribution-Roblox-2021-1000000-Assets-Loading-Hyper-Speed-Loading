	wait(time.Value)
	
	if pot.Value == 0 then
		size3()
		script.Parent.BrickColor = BrickColor.new(28)
		script.Parent.ready.Value = 1
		check.Value = 2
	else
		size2()
		wait(time.Value)
		script.Parent.BrickColor = BrickColor.new(38)
		wait(time.Value)
		size3()
		script.Parent.ready.Value = 1
		check.Value = 2
	end
end

