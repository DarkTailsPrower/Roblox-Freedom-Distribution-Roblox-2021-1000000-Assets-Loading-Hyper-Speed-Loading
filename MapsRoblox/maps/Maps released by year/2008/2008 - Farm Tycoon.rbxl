						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<string name="Source">message = Instance.new(&quot;Message&quot;) 
local ting = 0 

function onTouched(hit)
	if ting == 0 then 
	ting = 1 
	check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;) 
	if check ~= nil then 
		player = game.Players:findFirstChild(hit.Parent.Name) 
		if player ~= nil then
			if player:findFirstChild(&quot;Helper&quot;) == nil then
			local helper = Instance.new(&quot;IntValue&quot;)
			helper.Name = &quot;Helper&quot;
			helper.Parent = player
			script.Parent.BrickColor = BrickColor.new(226)
			message.Parent = player
			message.Text = &quot;Select this tool and click invisible balls&quot;
			wait(3) 
			message.Text = &quot;Invisible balls are on your farms field&quot;
			wait(3) 
			message.Text = &quot;Each click will plant a seed&quot;
			wait(3) 
			message.Text = &quot;Upgrading makes the tool plant more&quot;
			wait(3) 
			message.Text = &quot;If a seed never grows, plant it again&quot;
			wait(3) 
			message.Text = &quot;Be patient, seed take time to grow&quot;
			wait(3) 
			message.Text = &quot;Fully grown seeds can be sold for cash&quot;
			wait(3) 
			message.Parent = nil
			script.Parent.BrickColor = BrickColor.new(45)
			helper:remove()
			end
		end
	end
	ting = 0 
	end
end

script.Parent.Touched:connect(onTouched) 
