		<Item class="Script" referent="RBX12">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">LeaderboardWithMoney</string>
				<string name="Source">function onPlayerEntered(newPlayer)
	wait(.5)
	local stats = Instance.new(&quot;IntValue&quot;)
	stats.Name = &quot;leaderstats&quot;


	local cash = Instance.new(&quot;IntValue&quot;)
	
	cash.Name = &quot;Money&quot;
	cash.Value = 50 --This sets the amount of money every player starts with

	cash.Parent = stats
	
	stats.Parent = newPlayer

	local isOwner = Instance.new(&quot;IntValue&quot;) --is 1 if the player owns a farm. To prevent multiple farmowning.
	isOwner.Name = &quot;isOwner&quot;
	isOwner.Value = 0
	isOwner.Parent = newPlayer

	local plantLvl = Instance.new(&quot;IntValue&quot;) --Keeps track of how much the player has upgraded his plant tool
	plantLvl.Name = &quot;plantLvl&quot;
	plantLvl.Value = 0
	plantLvl.Parent = newPlayer

	local harvestLvl = Instance.new(&quot;IntValue&quot;) --Keeps track of how much the player has upgraded his harvest tool
	harvestLvl.Name = &quot;harvestLvl&quot;
	harvestLvl.Value = 0
	harvestLvl.Parent = newPlayer

	local chickensCarried = Instance.new(&quot;IntValue&quot;) --Keeps track of how many chickens the player is &quot;carrying&quot;
	chickensCarried.Name = &quot;chickensCarried&quot;
	chickensCarried.Value = 0
	chickensCarried.Parent = newPlayer

	local chickensHatched = Instance.new(&quot;IntValue&quot;) --Keeps track of how many chickens the player has hatched
	chickensHatched.Name = &quot;chickensHatched&quot;
	chickensHatched.Value = 0
	chickensHatched.Parent = newPlayer

	local milksSold = Instance.new(&quot;IntValue&quot;) --Keeps track of how many milk the player has sold
	milksSold.Name = &quot;milksSold&quot;
	milksSold.Value = 0
	milksSold.Parent = newPlayer

	local cowsCarried = Instance.new(&quot;IntValue&quot;) --Keeps track of how many cows the player is &quot;carrying&quot;
	cowsCarried.Name = &quot;cowsCarried&quot;
	cowsCarried.Value = 0
	cowsCarried.Parent = newPlayer

	local superAxe = Instance.new(&quot;IntValue&quot;) --This has Value == 1 if the superaxe is aquired
	superAxe.Name = &quot;superAxe&quot;
	superAxe.Value = 0
	superAxe.Parent = newPlayer

	local axeLvl = Instance.new(&quot;IntValue&quot;) --Keeps track of how much the axe is upgraded
	axeLvl.Name = &quot;axeLvl&quot;
	axeLvl.Value = 0
	axeLvl.Parent = newPlayer

	local feedLvl = Instance.new(&quot;IntValue&quot;) --Keeps track of how much the feed-tool is upgraded
	feedLvl.Name = &quot;feedLvl&quot;
	feedLvl.Value = 0
	feedLvl.Parent = newPlayer

	local lumbersCarried = Instance.new(&quot;IntValue&quot;) --Keeps track of how many lumbers the player is &quot;carrying&quot;
	lumbersCarried.Name = &quot;lumberCarried&quot;
	lumbersCarried.Value = 0
	lumbersCarried.Parent = newPlayer

	local reward1 = Instance.new(&quot;IntValue&quot;) --checks if a player has received a reward
	reward1.Name = &quot;reward1&quot;
	reward1.Value = 0
	reward1.Parent = newPlayer

	if newPlayer.Name == &quot;uberubert&quot; or newPlayer.Name == &quot;Player&quot; then
		cash.Value = 50000
		chickensCarried.Value = 1
		lumbersCarried.Value = 1000
		cowsCarried.Value = 1
	end

end

game.Players.ChildAdded:connect(onPlayerEntered)
</string>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
