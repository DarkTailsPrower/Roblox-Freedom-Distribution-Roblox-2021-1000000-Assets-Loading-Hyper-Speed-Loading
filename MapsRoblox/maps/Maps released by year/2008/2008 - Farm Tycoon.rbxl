			<Item class="Script" referent="RBX359">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<string name="Source">local ting = 0 

function onTouched(hit)

	if ting == 0 then 
	ting = 1 
	check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;) 

	if check ~= nil then 

		local user = game.Players:findFirstChild(hit.Parent.Name)
		if user ~= nil then 
			if user.superAxe.Value == 0 then
			user.superAxe.Value = 1
			local msg = Instance.new(&quot;Message&quot;)
			msg.Text = &quot;Super-axe aquired!&quot;
			msg.Parent = user
			wait(3)
			msg.Text = &quot;More wood per tree!&quot;
			wait(3)
			msg:remove()
			else
			local msg = Instance.new(&quot;Message&quot;)
			msg.Text = &quot;Already aquired super-axe!&quot;
			msg.Parent = user
			wait(3)
			msg:remove()
			end
		end

	end

	ting = 0
	end

end

script.Parent.Touched:connect(onTouched)
