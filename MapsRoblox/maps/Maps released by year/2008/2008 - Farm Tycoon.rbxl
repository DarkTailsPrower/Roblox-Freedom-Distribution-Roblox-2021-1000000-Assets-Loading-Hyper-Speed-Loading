						<Item class="Script" referent="RBX4716">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Burn</string>
								<string name="Source">fireOn = script.Parent.Parent.fire

while true do
if fireOn.Value == 1 then
	c = script.Parent:getChildren()
	for i = 1, #c do
		if c[i].Name == &quot;wood&quot; then
		c[i].Reflectance = 0
		c[i].BrickColor = BrickColor.new(192)
		end
	end
	wait(5)
	for i = 1, #c do
		if c[i].Name == &quot;wood&quot; then
		c[i].BrickColor = BrickColor.new(21)
		wait(0.2)
		end
	end
	for k = 1, 600 do
	for j = 1, 10 do
		for i = 1, #c do
			if c[i].Name == &quot;wood&quot; then
			c[i].Reflectance = (math.random(0,1)/10)
			end
		end
	end
	wait(0.1)
	end
	for i = 1, #c do
		if c[i].Name == &quot;wood&quot; then
		c[i].Reflectance = 0
		c[i].BrickColor = BrickColor.new(26)
		end
	end
	fireOn.Value = 0
end

wait(1)
end
</string>
								<bool name="archivable">true</bool>
