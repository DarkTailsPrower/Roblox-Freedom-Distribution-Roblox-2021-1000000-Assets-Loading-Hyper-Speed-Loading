								<string name="Source">wait(1)
name = script.Parent.Parent
field = name.Parent
size = field.Size
local ting = 0

function onTouched(hit)
	if ting == 0 then
	ting = 1
	local owner = field.Parent.Owner.Value
	check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
	if check ~= nil then
		local user = game.Players:findFirstChild(hit.Parent.Name) 
		if user ~= nil then
		if owner == user.Name then
			local stats = user:findFirstChild(&quot;leaderstats&quot;)
			if stats ~= nil then
				local cash = stats:findFirstChild(&quot;Money&quot;)

				if size.Value == 2 then
				if cash.Value &gt; 999 then
					cash.Value  = cash.Value -1000
					size.Value = 3
					name.Name = &quot;Field is extended!&quot;
					wait(3)
					name.Name = &quot;Field-size is maxed!&quot;
				end
				end

				if size.Value == 1 then
				if cash.Value &gt; 499 then
					cash.Value  = cash.Value -500
					size.Value = 2
					name.Name = &quot;Field is extended!&quot;
					wait(3)
					name.Name = &quot;Extend Field! 1000,-&quot;
				end
				end

				if size.Value == 0 then
				if cash.Value &gt; 99 then
					cash.Value  = cash.Value -100
					size.Value = 1
					name.Name = &quot;Field is extended!&quot;
					wait(3)
					name.Name = &quot;Extend Field! 500,-&quot;
				end
				end


			end
		end
		end
	end
	ting = 0
	end
end

script.Parent.Touched:connect(onTouched)
