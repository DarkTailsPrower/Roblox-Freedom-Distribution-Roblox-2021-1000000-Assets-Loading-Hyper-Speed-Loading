								<X>6</X>
								<Y>0.400000006</Y>
								<Z>4</Z>
							</Vector3>
						</Properties>
						<Item class="Script" referent="RBX8321">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<string name="Source">local ting = 0 
logs = script.Parent.Parent.Parent.TotalLogs
owner = logs.Parent.Parent.Owner

function onTouched(hit)

	if ting == 0 then 
	ting = 1 
	check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;) 

	if check ~= nil then 

		local user = game.Players:GetPlayerFromCharacter(hit.Parent) 
		local stats = user:findFirstChild(&quot;leaderstats&quot;) 

		if stats ~= nil then 
			local buyerlogs = user.lumberCarried
			local cash = stats:findFirstChild(&quot;Money&quot;) 
			if cash.Value &gt; 499 then
				if logs.Value &gt; 9 then
					cash.Value = cash.Value - 500
					ownert = game.Players:findFirstChild(owner.Value)
					local stats = ownert:findFirstChild(&quot;leaderstats&quot;) 
					local cash = stats:findFirstChild(&quot;Money&quot;) 
					cash.Value = cash.Value + 500
					buyerlogs.Value = buyerlogs.Value + 10
					logs.Value = logs.Value - 10
					message = user:findFirstChild(&quot;Message&quot;)
					if message ~= nil then
						message:remove()
					end
					message = Instance.new(&quot;Message&quot;) 
					message.Text = &quot;Carried Lumber: &quot; .. buyerlogs.Value
					message.Parent = game.Players:GetPlayerFromCharacter(hit.Parent)
					wait(2)
				end
			end
		end

	end

	ting = 0
	end

end

script.Parent.Touched:connect(onTouched)
</string>
								<bool name="archivable">true</bool>
							</Properties>
