						<Item class="Script" referent="RBX5621">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<string name="Source">wait(1)
name = script.Parent.Parent
house = name.Parent
houseadd = house.houseAddclone
logs = house.Parent.Lumbershed.TotalLogs
local ting = 0

function onTouched(hit)
	if ting == 0 then
	ting = 1
	local owner = house.Parent.Owner.Value
	check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
	if check ~= nil then
		local user = game.Players:GetPlayerFromCharacter(hit.Parent) 
		if owner == user.Name then
			local stats = user:findFirstChild(&quot;leaderstats&quot;)
			if stats ~= nil then
				local cash = stats:findFirstChild(&quot;Money&quot;)
				if cash.Value &gt; 4999 then
					if logs.Value &gt; 99 then
					cash.Value  = cash.Value -5000
					logs.Value = logs.Value - 100
					local add = houseadd.Value:clone()
					name.Name = &quot;House is being rebuilt!&quot;
					wait(3)
					local c = house.HouseRemove:getChildren()
					
					for i = 1, #c do
						c[i]:remove()
						wait(3)
					end
					house.HouseRemove:remove()
					add.Parent = house
					local house3button = add:findFirstChild(&quot;House 3 --- 100 Wood + 10000,-&quot;):clone()
					add:findFirstChild(&quot;House 3 --- 100 Wood + 10000,-&quot;):remove()
					c = house.HouseAdd:getChildren()
					for i = 1, #c do
						if c[i].className ~= &quot;Model&quot; then
						c[i].Transparency = 1
						c[i].CanCollide = false
						end
					end
					name:remove()
					for i = 1, #c do
						if c[i].className ~= &quot;Model&quot; then
						if c[i].Name == &quot;Window&quot; then
							c[i].Transparency = 0.8
						else
							c[i].Transparency = 0
						end
						c[i].CanCollide = true
						wait(3)
						end
					end
					house3button.Parent = add
					end
				end
			end
		end
	end
	ting = 0
	end
end

script.Parent.Touched:connect(onTouched)
</string>
								<bool name="archivable">true</bool>
