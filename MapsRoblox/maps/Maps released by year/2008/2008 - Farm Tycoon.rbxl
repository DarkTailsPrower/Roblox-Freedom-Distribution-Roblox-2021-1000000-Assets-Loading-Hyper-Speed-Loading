							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<string name="Source">--Basically checks if the toucher of the button is a player, then adds money to that player.

--Uberubert
--This script is free to use for anyone

local ting = 0 --debouncer

function onTouched(hit)

	if ting == 0 then --debounce check
	ting = 1 --activate debounce
	check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;) --Find the human that touched the button

	if check ~= nil then --If a human is found, then
		local owner = script.Parent.Parent.Parent.Owner
		local user = game.Players:GetPlayerFromCharacter(hit.Parent)
		if user.isOwner.Value == 1 then
			script.Parent.Parent.Name = &quot;You already have a farm...&quot;
			wait(3)
			script.Parent.Parent.Name = &quot;Become Farm Owner!&quot;
		end

		if user.isOwner.Value == 0 then
			owner.Value = hit.Parent.Name
			user.isOwner.Value = 1
			owner.Parent.Stuff.OwnerButton.Value = script.Parent.Parent:clone()
			local message = Instance.new(&quot;Message&quot;) 
			message.Text = &quot;You now own this farm!&quot;
			message.Parent = user
			script.Parent.Parent:remove()
			wait(3)
			message:remove()
		end

	end

	ting = 0 --remove debounce
	end

end

script.Parent.Touched:connect(onTouched)
