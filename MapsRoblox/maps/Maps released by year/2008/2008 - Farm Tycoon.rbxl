				<Ref name="PrimaryPart">RBX5096</Ref>
				<bool name="archivable">true</bool>
			</Properties>
			<Item class="IntValue" referent="RBX5097">
				<Properties>
					<string name="Name">CabbageMoney</string>
					<int name="Value">15</int>
