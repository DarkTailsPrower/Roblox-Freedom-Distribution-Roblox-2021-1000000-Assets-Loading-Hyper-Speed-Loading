						<string name="Source">message = Instance.new(&quot;Message&quot;) 
local ting = 0 

function onTouched(hit)
	if ting == 0 then 
	ting = 1 
	check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;) 
	if check ~= nil then 
		player = game.Players:findFirstChild(hit.Parent.Name) 
		if player ~= nil then
			if player:findFirstChild(&quot;Helper&quot;) == nil then
			local helper = Instance.new(&quot;IntValue&quot;)
			helper.Name = &quot;Helper&quot;
			helper.Parent = player
			script.Parent.BrickColor = BrickColor.new(226)
			message.Parent = player
			message.Text = &quot;Select this tool and click stuff&quot;
			wait(3) 
			message.Text = &quot;The stuff you click can/will be sold&quot;
			wait(3)
			message.Text = &quot;Upgrading makes the tool sell more&quot;
			wait(3) 
			message.Text = &quot;You can sell these things.... :&quot;
			wait(3) 
			message.Text = &quot;Eggs, Fully grown crops...&quot;
			wait(3) 
			message.Text = &quot;..Chickens! You only pick up these&quot;
			wait(3) 
			message.Text = &quot;Chickens must be sold at the shop&quot;
			wait(3) 
			message.Text = &quot;You can also sell milk&quot;
			wait(3) 
			message.Text = &quot;You get money when you sell stuff&quot;
			wait(3) 
			message.Parent = nil
			script.Parent.BrickColor = BrickColor.new(45)
			helper:remove()
			end
		end
	end
	ting = 0 
	end
end

