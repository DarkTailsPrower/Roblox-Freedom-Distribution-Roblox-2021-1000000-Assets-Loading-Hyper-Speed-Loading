pott1 = time.Parent.Potato
pot = script.Parent.pot

function size2()
	script.Parent.Size = Vector3.new(2,2,2)
	local location = {script.Parent.Position}
	local x = location[1].x
	local z = location[1].z
	script.Parent.Position = Vector3.new(x,3.8,z)
end

function size3()
	script.Parent.Size = Vector3.new(3,3,3)
	local location = {script.Parent.Position}
	local x = location[1].x
	local z = location[1].z
	script.Parent.Position = Vector3.new(x,4.3,z)
end

while true do
if check.Value == 1 then
	pot.Value = pott1.Value
	wait(0.5)
	wait(time.Value)
	if pot.Value == 0 then
	script.Parent.BrickColor = BrickColor.new(29)
	else
	script.Parent.BrickColor = BrickColor.new(1)
	end

	if time.Parent.Watersystem.Value == 1 then
		script.Parent.Reflectance = 0.2
	end
	if pot.Value == 0 then
	size2()
	else
	script.Parent.BrickColor = BrickColor.new(105)
	end
	wait(time.Value)
	
	if pot.Value == 0 then
		size3()
		script.Parent.BrickColor = BrickColor.new(28)
		script.Parent.ready.Value = 1
		check.Value = 2
	else
		size2()
		wait(time.Value)
		script.Parent.BrickColor = BrickColor.new(38)
		wait(time.Value)
		size3()
		script.Parent.ready.Value = 1
		check.Value = 2
	end
end

