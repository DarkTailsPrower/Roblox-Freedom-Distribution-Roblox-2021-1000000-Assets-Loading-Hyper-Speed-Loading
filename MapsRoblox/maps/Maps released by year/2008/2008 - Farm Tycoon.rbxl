								<string name="Name">milkAndRename</string>
								<string name="Source">wait(0.6)
name = script.Parent
milk = name.milk:clone()
name.milk:remove()
udder = name.udder
quant = name.milkquantity
check = 3


while true do
	if quant.Value == check then
		wait(0.7)
	else
		if check &gt; quant.Value then
			local location = {udder.Position}
			local x = location[1].x
			local z = location[1].z
			local newmilk = milk:clone()
			newmilk.Parent = name
			newmilk.quality.Value = name.Parent.Parent.meadow.quality.Value
			newmilk.Position = Vector3.new(x,6,z)
		end
		check = quant.Value
		if check &gt; 0 then
			local newname = &quot;M&quot;
			for i = 1, check do
				newname = newname .. &quot;O&quot;
			end
			name.Name = newname
		else
			name.Name = &quot;&quot;
		end
	end
end
