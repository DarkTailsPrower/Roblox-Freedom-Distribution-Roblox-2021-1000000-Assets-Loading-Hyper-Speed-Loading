					<Item class="Script" referent="RBX3667">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<string name="Source">name = script.Parent.Parent
name2 = name.Plant
owner = name.Parent.Owner
local ting = 0

function onTouched(hit)
	if ting == 0 then
	ting = 1
	check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
	if check ~= nil then
		local owner = name.Parent.Owner.Value
		local user = game.Players:GetPlayerFromCharacter(hit.Parent) 
		if owner == user.Name then
			upgrade = user.plantLvl
			local stats = user:findFirstChild(&quot;leaderstats&quot;)
			if stats ~= nil then
				local cash = stats:findFirstChild(&quot;Money&quot;)

				if upgrade.Value &lt; 6 then

				if cash.Value &gt; 149 then
					cash.Value  = cash.Value -150
					upgrade.Value = upgrade.Value + 1
					name2.Name = &quot;Tool Level: &quot; .. upgrade.Value
					name.Name = &quot;Tool upgraded!&quot;
					wait(3)
					if upgrade.Value == 6 then
					name.Name = &quot;Plant Tool Maxed&quot;
					else
					name.Name = &quot;Upgrade Plant Tool 150,-&quot;
					end
				end

				end
					

			end
		end
	end
	ting = 0
	end
end

script.Parent.Touched:connect(onTouched)
</string>
							<bool name="archivable">true</bool>
