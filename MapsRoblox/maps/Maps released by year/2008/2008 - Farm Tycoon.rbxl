					<string name="Source">wait(1)
Tool = script.Parent
ting = 0

function hit()
	print(&quot;hitting&quot;)
	local anim = Instance.new(&quot;StringValue&quot;)
	anim.Name = &quot;toolanim&quot;
	anim.Value = &quot;Slash&quot;
	anim.Parent = Tool
end

function onActivated() 
	if not Tool.Enabled then
		return
	end
	
	Tool.Enabled = false
	hit()
	Tool.Enabled = true

end 

function onTouched(hitt)
	if ting == 0 then
	ting = 1
	if hitt.Parent.Name == &quot;Tree&quot; then
	user = game.Players:findFirstChild(Tool.Parent.Name)
	upgrade = user.axeLvl.Value + 1
	hitt.Parent.hit.Value = hitt.Parent.hit.Value - upgrade
	if hitt.Parent.hit.Value &lt; 1 and hitt.Parent.Timber.Value == 0 then
		if user.superAxe.Value == 1 then
			user.lumberCarried.Value = user.lumberCarried.Value + 3
		else
			user.lumberCarried.Value = user.lumberCarried.Value + 1
		end
		hitt.Parent.Timber.Value = 1
		local message = user:findFirstChild(&quot;Message&quot;)
		if message ~= nil then
			message:remove()
		end
		message = Instance.new(&quot;Message&quot;) 
		message.Text = &quot;Lumber carried: &quot; .. user.lumberCarried.Value
		message.Parent = user
		wait(2)
	else
		wait(1)
	end
	end
	ting = 0
	end
end

Tool.Activated:connect(onActivated)
connection = Tool.Handle.Touched:connect(onTouched)</string>
