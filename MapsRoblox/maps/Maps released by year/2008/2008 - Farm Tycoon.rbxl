									<X>0</X>
									<Y>0</Y>
									<Z>0</Z>
								</Vector3>
								<bool name="archivable">true</bool>
								<token name="shape">1</token>
								<Vector3 name="size">
									<X>3</X>
									<Y>0.400000006</Y>
