									<string name="Source">wait(1)
name = script.Parent.Parent
potato = name.Parent.Parent.Potato
local ting = 0

function onTouched(hit)
	if ting == 0 then
	ting = 1
	local owner = potato.Parent.Parent.Owner.Value
	check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
	if check ~= nil then
		local user = game.Players:findFirstChild(hit.Parent.Name)
		if user ~= nil then
		if owner == user.Name then
			if potato.Value == 0 then
				potato.Value = 1
				name.Name = &quot;--Planting Mega-Potatoes--&quot;
				wait(1)
			else	
				potato.Value = 0
				name.Name = &quot;--Planting Cabbages--&quot;
				wait(1)
			end
		end
		end
	end
	ting = 0
	end
end

