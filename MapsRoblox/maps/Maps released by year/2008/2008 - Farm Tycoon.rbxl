						<string name="Source">statue = script.Parent.theStatue:clone()
script.Parent.theStatue:remove()
owner = script.Parent.Parent.Owner

while true do

	local user = game.Players:findFirstChild(owner.Value)
	if user ~= nil then
		if user.chickensHatched.Value &gt; 99 then
		if script.Parent:findFirstChild(&quot;theStatue&quot;) == nil then
			local newstatue = statue:clone()
			newstatue.Parent = script.Parent
		end
		end
	end

wait(10)
end
