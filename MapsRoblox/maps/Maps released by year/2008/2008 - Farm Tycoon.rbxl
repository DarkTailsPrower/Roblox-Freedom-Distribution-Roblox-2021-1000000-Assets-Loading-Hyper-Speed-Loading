				<Item class="Script" referent="RBX401">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<string name="Source">message = Instance.new(&quot;Message&quot;) 
local ting = 0 

function onTouched(hit)
	if ting == 0 then 
	ting = 1 
	check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;) 
	if check ~= nil then 
		player = game.Players:findFirstChild(hit.Parent.Name) 
		if player ~= nil then
			if player:findFirstChild(&quot;Helper&quot;) == nil then
			local helper = Instance.new(&quot;IntValue&quot;)
			helper.Name = &quot;Helper&quot;
			helper.Parent = player
			script.Parent.BrickColor = BrickColor.new(226)
			message.Parent = player
			message.Text = &quot;You can give money to others!&quot;
			wait(3)
			message.Text = &quot;To do this, you must...&quot;
			wait(3)
			message.Text = &quot;..visit their farm and look for..&quot;
			wait(3)
			message.Text = &quot;..&apos;Donate xxx&apos;-buttons!&quot;
			wait(3)
			message.Text = &quot;Step on these to donate money&quot;
			wait(3)
			message.Text = &quot;The farms owner will get your money&quot;
			wait(3)
			message.Parent = nil
			script.Parent.BrickColor = BrickColor.new(45)
			helper:remove()
			end
		end
	end
	ting = 0 
	end
end

script.Parent.Touched:connect(onTouched) 
