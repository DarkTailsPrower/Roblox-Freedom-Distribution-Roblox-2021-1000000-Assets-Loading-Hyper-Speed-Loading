							<string name="Source">owner = script.Parent.Parent.Parent.Owner
local ting = 0

function onTouched(hit)
	if ting == 0 then
	ting = 1
	check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
	if check ~= nil then
		local user = game.Players:GetPlayerFromCharacter(hit.Parent) 
		if owner.Value == user.Name then
			local stats = user:findFirstChild(&quot;leaderstats&quot;)
			if stats ~= nil then
				local cash = stats:findFirstChild(&quot;Money&quot;)
				print(&quot;checking cash&quot;)
				if cash.Value &lt; 5 then
					cash.Value  = cash.Value + 25
					script.Parent.Parent.Name = &quot;25 cash added - 1 min reset&quot;
					wait(60)
					script.Parent.Parent.Name = &quot;Emergency Money&quot;
				else
					script.Parent.Parent.Name = &quot;This is for less than 5 cash&quot;
					wait(3)
					script.Parent.Parent.Name = &quot;Emergency Money&quot;
				end
			end
		end
	end
	ting = 0
	end
end

