						<string name="Source">message = Instance.new(&quot;Message&quot;) 
local ting = 0 

function onTouched(hit)
	if ting == 0 then 
	ting = 1 
	check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;) 
	if check ~= nil then 
		player = game.Players:findFirstChild(hit.Parent.Name) 
		if player ~= nil then
			if player:findFirstChild(&quot;Helper&quot;) == nil then
			local helper = Instance.new(&quot;IntValue&quot;)
			helper.Name = &quot;Helper&quot;
			helper.Parent = player
			script.Parent.BrickColor = BrickColor.new(226)
			message.Parent = player
			message.Text = &quot;Buy a Cow at the shop&quot;
			wait(3) 
			message.Text = &quot;Then put it in your meadow&quot;
			wait(3)
			message.Text = &quot;You need to upgrade your farm&quot;
			wait(3) 
			message.Text = &quot;..to get the meadow.&quot;
			wait(3) 
			message.Text = &quot;Cows make milk in time&quot;
			wait(3) 
			message.Text = &quot;If cow goes &apos;Mooo&apos; it has milk&quot;
			wait(3) 
			message.Text = &quot;Use the milk-tool to milk it&quot;
			wait(3) 
			message.Text = &quot;Milk can be sold for money&quot;
			wait(3)
			message.Parent = nil
			script.Parent.BrickColor = BrickColor.new(45)
			helper:remove()
			end
		end
	end
	ting = 0 
	end
end

