					<string name="Source">Tool = script.Parent

function onActivated() 
	if not Tool.Enabled then
		return
	end
	
	Tool.Enabled = false
	local hit = Tool.Target.Value


	if hit ~= nil then 
		if hit.Name == &quot;FeedPlate&quot; or hit.Name == &quot;Feed&quot; then 
			if hit.Parent.Feed.Transparency == 1 then
				user = game.Players:findFirstChild(Tool.Parent.Name)
				local stats = user:findFirstChild(&quot;leaderstats&quot;)
				local cash = stats:findFirstChild(&quot;Money&quot;)
				if cash.Value &gt; 9 then
					cash.Value = cash.Value -10
					hit.Parent.Feed.Transparency = 0.5 - (user.feedLvl.Value/10)
				end
			end
		end 
	end

	Tool.Enabled = true

end 

Tool.Activated:connect(onActivated)
