						<Item class="Script" referent="RBX7384">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Crazymovement</string>
								<string name="Source">wait(1)
torso = script.Parent.Torso

while true do
	local y = math.random(-1,1)*0.1
	local i
	for i = 0, math.random(1,15) do
		torso.CFrame=torso.CFrame * CFrame.fromEulerAnglesXYZ(0, y, 0)
		wait(0.1)
	end
	wait(1)
	for i = 0, math.random(1,15) do
		torso.Velocity = torso.CFrame.lookVector * math.random(25,50)
		wait(0.1)
	end
	wait(math.random(3,20))
	if torso.Parent.milkquantity.Value &lt; 15 then
		torso.Parent.milkquantity.Value = torso.Parent.milkquantity.Value + 1
	end
end
</string>
								<bool name="archivable">true</bool>
							</Properties>
