				<Item class="Script" referent="RBX5248">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">AutoFeeding</string>
						<string name="Source">while true do
checker = script.Parent:findFirstChild(&quot;Autofeeder In Place&quot;)
if checker ~= nil then
c = script.Parent:getChildren()
for i = 1, #c do
	if c[i].Name == &quot;feeder&quot; then
		check2 = c[i]:findFirstChild(&quot;Feeder&quot;)
		if check2 ~= nil then
		if c[i].Feeder.Feed.Transparency == 1 then				
			local user = game.Players:findFirstChild(script.Parent.Parent.Owner.Value)
			if user~= nil then
			local stats = user:findFirstChild(&quot;leaderstats&quot;)
			local cash = stats:findFirstChild(&quot;Money&quot;)
			if cash.Value &gt; 9 then
				cash.Value = cash.Value -10
				c[i].Feeder.Feed.Transparency = 0
			end
			end
		end
		end
	end
end
end
wait(3)
end
</string>
						<bool name="archivable">true</bool>
					</Properties>
