							<Item class="Script" referent="RBX884">
								<Properties>
									<bool name="Disabled">false</bool>
									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">Script</string>
									<string name="Source">wait(1)
name = script.Parent.Parent
parent = name.Parent.Parent
upgrade = parent.TVcornerclone
local ting = 0

function onTouched(hit)
	if ting == 0 then
	ting = 1
	local owner = parent.Parent.Owner.Value
	check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
	if check ~= nil then
		local user = game.Players:GetPlayerFromCharacter(hit.Parent) 
		if owner == user.Name then
			local stats = user:findFirstChild(&quot;leaderstats&quot;)
			if stats ~= nil then
				local cash = stats:findFirstChild(&quot;Money&quot;)
				if cash.Value &gt; 1999 then
					cash.Value = cash.Value - 2000
					name:remove()
					wait(1)
					parent.SofaTV:remove()
					new = upgrade.Value:clone()
					new.Parent = parent.HouseAdd
					new:MakeJoints()
				end
			end
		end
	end
	ting = 0
	end
end

script.Parent.Touched:connect(onTouched)
</string>
									<bool name="archivable">true</bool>
