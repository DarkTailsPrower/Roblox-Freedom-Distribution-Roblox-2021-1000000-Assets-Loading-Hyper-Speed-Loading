						<Item class="Script" referent="RBX1265">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<string name="Source">local ting = 0
totalLogs = script.Parent.Parent.Parent.TotalLogs

function onTouched(hit)

	if ting == 0 then
	ting = 1 
	check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)

	if check ~= nil then 

		local user = game.Players:GetPlayerFromCharacter(hit.Parent)
		local logs = user.lumberCarried
		if logs.Value &gt; 0 then
			totalLogs.Value = totalLogs.Value + logs.Value
			logs.Value = 0
			local msg = user:findFirstChild(&quot;Message&quot;)
			if msg ~= nil then
				msg:remove()
			end
		end
		wait(3) 
	end

	ting = 0
	end

end

script.Parent.Touched:connect(onTouched)
</string>
								<bool name="archivable">true</bool>
							</Properties>
