						<string name="Name">Script</string>
						<string name="Source">message = Instance.new(&quot;Message&quot;) 
local ting = 0 

function onTouched(hit)
	if ting == 0 then 
	ting = 1 
	check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;) 
	if check ~= nil then 
		player = game.Players:findFirstChild(hit.Parent.Name) 
		if player ~= nil then
			if player:findFirstChild(&quot;Helper&quot;) == nil then
			local helper = Instance.new(&quot;IntValue&quot;)
			helper.Name = &quot;Helper&quot;
			helper.Parent = player
			script.Parent.BrickColor = BrickColor.new(226)
			message.Parent = player
			message.Text = &quot;Select this tool and click a cow&quot;
			wait(3) 
			message.Text = &quot;Each click will make the cow give milk&quot;
			wait(3)
			message.Text = &quot;Milk must be sold with the selltool&quot;
			wait(3) 
			message.Text = &quot;A cow has alot of milk if it Mooo&apos;s&quot;
			wait(3) 
			message.Parent = nil
			script.Parent.BrickColor = BrickColor.new(45)
			helper:remove()
			end
		end
	end
	ting = 0 
	end
end

