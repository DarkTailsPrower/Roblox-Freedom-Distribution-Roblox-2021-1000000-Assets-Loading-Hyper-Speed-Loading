									<string name="Source">wait(1)
name = script.Parent.Parent
house = name.Parent.Parent
houseadd = house.house2Addclone
logs = house.Parent.Lumbershed.TotalLogs
local ting = 0

function onTouched(hit)
	if ting == 0 then
	ting = 1
	local owner = house.Parent.Owner.Value
	check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
	if check ~= nil then
		local user = game.Players:GetPlayerFromCharacter(hit.Parent) 
		if owner == user.Name then
			local stats = user:findFirstChild(&quot;leaderstats&quot;)
			if stats ~= nil then
				local cash = stats:findFirstChild(&quot;Money&quot;)
				if cash.Value &gt; 9999 then
					if logs.Value &gt; 99 then
					cash.Value  = cash.Value -10000
					logs.Value = logs.Value - 100
					local add = houseadd.Value:clone()
					name.Name = &quot;House is being extended!&quot;
					wait(3)
					house.HouseAdd.roofRemove:remove()
					add.Parent = house
					c = house.House2Add:getChildren()
					for i = 1, #c do
						if c[i].className ~= &quot;Model&quot; then
						c[i].Transparency = 1
						c[i].CanCollide = false
						end
					end
					c = house.House2Add.Stairs:getChildren()
					for i = 1, #c do
						if c[i].className ~= &quot;Model&quot; then
						c[i].Transparency = 1
						c[i].CanCollide = false
						end
					end
					for i = 1, #c do
						if c[i].className ~= &quot;Model&quot; then
						c[i].Transparency = 0
						c[i].CanCollide = true
						wait(1)
						end
					end
					name:remove()
					c = house.House2Add:getChildren()
					for i = 1, #c do
						if c[i].className ~= &quot;Model&quot; then
						if c[i].Name == &quot;Window&quot; then
							c[i].Transparency = 0.8
						else
							c[i].Transparency = 0
						end
						c[i].CanCollide = true
						wait(3)
						end
					end
					end
				end
			end
		end
	end
	ting = 0
	end
end

script.Parent.Touched:connect(onTouched)
