							<Item class="Script" referent="RBX516">
								<Properties>
									<bool name="Disabled">false</bool>
									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">Script</string>
									<string name="Source">local ting = 0
feeder = script.Parent.Parent.Parent

function onTouched(hit)

	if ting == 0 then
	ting = 1 
	check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)

	if check ~= nil then
		local user = game.Players:GetPlayerFromCharacter(hit.Parent)
		if user ~= nil then
		chickens = user.chickensCarried
		if chickens.Value &gt; 0 then
			chickens.Value = chickens.Value -1
			newchick = feeder.chickenclone.Value:clone()
			newchick.Parent = feeder
			newchick:MakeJoints()
			newfeeder = feeder.feederclone.Value:clone()
			newfeeder.Parent = feeder
			newfeeder:MakeJoints()
			message = user:findFirstChild(&quot;Message&quot;)
			if message ~= nil then
			if chickens.Value == 0 then
				message:remove()
			else
				message.Text = &quot;Chickens Carried: &quot; .. chickens.Value
			end
			end
			script.Parent.Parent:remove()
		end
		end
	end

	ting = 0
	end

end

script.Parent.Touched:connect(onTouched)
</string>
									<bool name="archivable">true</bool>
