							<Item class="Script" referent="RBX3801">
								<Properties>
									<bool name="Disabled">false</bool>
									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">Script</string>
									<string name="Source">wait(1)
name = script.Parent.Parent
parent = name.Parent
logs = parent.Parent.Parent.Lumbershed.TotalLogs
upgrade = parent.hatchclone
local ting = 0

function onTouched(hit)
	if ting == 0 then
	ting = 1
	local owner = parent.Parent.Parent.Owner.Value
	check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
	if check ~= nil then
		local user = game.Players:GetPlayerFromCharacter(hit.Parent) 
		if owner == user.Name then
			if logs.Value &gt; 29 then
			logs.Value = logs.Value - 30
			name:remove()
			wait(1)
			local new = upgrade.Value:clone()
			new.Parent = parent
			new.Parent.stopper.Transparency = 1
			new.Parent.stopper.CanCollide = false
			end
		end
	end
	ting = 0
	end
end

script.Parent.Touched:connect(onTouched)
</string>
