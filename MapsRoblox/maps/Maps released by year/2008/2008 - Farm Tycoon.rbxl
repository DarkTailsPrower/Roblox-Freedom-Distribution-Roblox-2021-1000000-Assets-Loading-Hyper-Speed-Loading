							<Item class="Script" referent="RBX2666">
								<Properties>
									<bool name="Disabled">false</bool>
									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">Script</string>
									<string name="Source">wait(1)
name = script.Parent.Parent
parent = name.Parent
logs = parent.Parent.Parent.Lumbershed.TotalLogs
upgrade = parent.hatchclone
local ting = 0

function onTouched(hit)
	if ting == 0 then
	ting = 1
	local owner = parent.Parent.Parent.Owner.Value
	check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
	if check ~= nil then
		local user = game.Players:GetPlayerFromCharacter(hit.Parent) 
		if owner == user.Name then
			if logs.Value &gt; 29 then
			logs.Value = logs.Value - 30
			name:remove()
			wait(1)
			local new = upgrade.Value:clone()
			new.Parent = parent
			new.Parent.stopper.Transparency = 1
			new.Parent.stopper.CanCollide = false
			end
		end
	end
	ting = 0
	end
end

script.Parent.Touched:connect(onTouched)
</string>
									<bool name="archivable">true</bool>
								</Properties>
							</Item>
						</Item>
					</Item>
					<Item class="Script" referent="RBX2667">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">ChickenGrower</string>
							<string name="Source">hatch = script.Parent
plat = hatch.plate
tinychicken = hatch:findFirstChild(&quot;tiny Chicken&quot;)
tinychickenclone =tinychicken:clone()
tinychicken:remove()
chicken = hatch.Chicken
chickenclone =chicken:clone()
chicken:remove()

ting = 0

function onTouch(hit)
	if ting == 0 then
		ting = 1
		if hit.Name == &quot;Egg&quot; then
			wait(60 + math.random(-10, 10)) --make into tiny chicken after this time
			if hatch.free.Value == 1 then
			hit:remove()
			newtinychicken = tinychickenclone:clone()
			newtinychicken.Parent = hatch
			newtinychicken:MakeJoints()
			end

			wait(100 + math.random(-20, 20)) --make into chicken after this time
			if hatch.free.Value == 1 then
			newtinychicken:remove()
			local newchicken = chickenclone:clone()
			newchicken.Parent = hatch
			newchicken:MakeJoints()
			local user = game.Players:findFirstChild(hatch.Parent.Parent.Owner.Value)
			if user ~= nil then
				user.chickensHatched.Value = user.chickensHatched.Value + 1
			end
			else
			if newtinychicken ~= nil then
				newtinychicken:remove()
			end
			end
			hatch.free.Value = 0
		end
		ting = 0
	end
end

plat.Touched:connect(onTouch)
