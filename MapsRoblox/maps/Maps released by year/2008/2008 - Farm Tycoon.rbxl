					<Item class="Script" referent="RBX73">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<string name="Source">local ting = 0 

function onTouched(hit)

	if ting == 0 then 
	ting = 1 
	check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;) 

	if check ~= nil then 

		local user = game.Players:GetPlayerFromCharacter(hit.Parent) 
		local stats = user:findFirstChild(&quot;leaderstats&quot;) 

		if stats ~= nil then 
			local carriedchicks = user.chickensCarried
			local cash = stats:findFirstChild(&quot;Money&quot;) 
			if cash.Value &gt; 999 then
				if carriedchicks.Value &lt; 3 then
					cash.Value = cash.Value - 1000
					carriedchicks.Value = carriedchicks.Value + 1
					message = user:findFirstChild(&quot;Message&quot;)
					if message ~= nil then
						message:remove()
					end
					message = Instance.new(&quot;Message&quot;) 
					message.Text = &quot;Carried chickens: &quot; .. carriedchicks.Value
					message.Parent = user
					wait(2)
				end
			end
		end

	end

	ting = 0
	end

end

script.Parent.Touched:connect(onTouched)
</string>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
