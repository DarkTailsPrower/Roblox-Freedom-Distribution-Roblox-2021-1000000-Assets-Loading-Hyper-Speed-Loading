					<string name="Name">ResetScript</string>
					<string name="Source">wait(0.5)
farm = script.Parent
house = farm.House
owner = farm.Owner
ownerbutton = farm.OwnerButtonclone
fieldsize = farm.Field.Size
fieldbutton = farm.Field:findFirstChild(&quot;Bigger Field! 100,-&quot;)
feeder = farm.Feeders
cabmoney = farm.CabbageMoney
potmoney = farm.PotatoMoney

farm.Landbuttonclone.Value = farm:findFirstChild(&quot;Bigger Land - 25 Wood + 1500,-&quot;):clone()
farm.Fenceclone.Value = farm.Fence.remove:clone()
ownerbutton.Value = farm:findFirstChild(&quot;Become Farm Owner&quot;):clone()
farm.Roadclone.Value = farm.Road:clone()
farm.Road:remove()
temp = farm:findFirstChild(&quot;Lay Road --- 200,-&quot;)
farm.RoadButtonclone.Value = temp:clone()
farm.Land.cow.Value = farm.Land.Cow:clone()
farm.Land.Cow:remove()
farm.Landclone.Value = farm.Land:clone()
farm.Land:remove()
ToolAxe = farm:findFirstChild(&quot;Upgrade Axe 150,-&quot;)
Axetool = ToolAxe.Axe
ToolAxe.Axe.Name = &quot;Tool Level: 0&quot;
ToolHarvest = farm:findFirstChild(&quot;Upgrade Sell Tool 150,-&quot;)
HarvestTool = ToolHarvest.Harvest
ToolHarvest.Harvest.Name = &quot;Tool Level: 0&quot;
ToolPlant = farm:findFirstChild(&quot;Upgrade Plant Tool 150,-&quot;)
PlantTool = ToolPlant.Plant
ToolPlant.Plant.Name = &quot;Tool Level: 0&quot;
ToolFeed = farm:findFirstChild(&quot;Upgrade Feed-Tool 150,-&quot;)
FeedTool = ToolFeed.Feed
ToolFeed.Feed.Name = &quot;Tool Level: 0&quot;

function remover(item)--short function to remove an item IF it exists. Relies on findFirstChild to work
if item~=nil then
item:remove()
end
end

function MajorReset() --resets the farm after the owner leaves. Lots of specialized stuff.. Lots of work making these.. :(

	wait(12)--wait in case house is being &quot;Rebuilt&quot;.
	--reset owner
	owner.Value = &quot;&quot;
	local new = ownerbutton.Value:clone()
	new.Parent = farm

	--reset expanded land
	remover(farm:findFirstChild(&quot;Land&quot;))
	remover(farm.Fence:findFirstChild(&quot;remove&quot;))
	local new = farm.Fenceclone.Value:clone()
	new.Parent = farm.Fence
	new = farm.Landbuttonclone.Value:clone()
	new.Parent = farm

	--reset tools
	Axetool.Parent.Name = &quot;Upgrade Axe 150,-&quot;
	Axetool.Name = &quot;Tool Level: 0&quot;
	HarvestTool.Parent.Name = &quot;Upgrade Sell Tool 150,-&quot;
	HarvestTool.Name = &quot;Tool Level: 0&quot;
	PlantTool.Parent.Name = &quot;Upgrade Plant Tool 150,-&quot;
	PlantTool.Name = &quot;Tool Level: 0&quot;
	FeedTool.Parent.Name = &quot;Upgrade Feed-Tool 150,-&quot;
	FeedTool.Name = &quot;Tool Leve: 0&quot;

	--reset chickenhouse
	local c = feeder:getChildren()
	c[1].Parent.eggs.Value = 0
	for i = 1, #c do
		if c[i].Name == &quot;feeder&quot; then
		remover(c[i]:findFirstChild(&quot;Chicken&quot;))
		remover(c[i]:findFirstChild(&quot;Feeder&quot;))
		remover(c[i]:findFirstChild(&quot;Place Chicken&quot;))
		local d = c[i]:getChildren()
		for j = 1, #d do
			if d[j].Name == &quot;Egg&quot; then
				d[j]:remove()
			end
		end
		temp = c[i].Buttonclone.Value:clone()
		temp.Parent = c[i]
		end
		if c[i].Name == &quot;Autofeeder In Place&quot; then
			c[i].Name = &quot;Install auto-feeder 1200,-&quot;
			remover(c[i]:findFirstChild(&quot;Autofeeder&quot;))
		end
	end
	c = farm.Hatcheries:getChildren()
	for i = 1, #c do
		if c[i].Name == &quot;Hatchery&quot; then
		local tmp = c[i]:findFirstChild(&quot;velocityplate&quot;)
		if tmp == nil then
		remover(c[i]:findFirstChild(&quot;Build Hatchery bin - 30 wood&quot;))
		local newbutton = c[i].buttonclone.Value:clone()
		newbutton.Parent = c[i]
		end
		remover(c[i]:findFirstChild(&quot;Egg&quot;))
		remover(c[i]:findFirstChild(&quot;Chicken&quot;))
		remover(c[i]:findFirstChild(&quot;tiny Chicken&quot;))
		remover(c[i]:findFirstChild(&quot;stuff&quot;))
		c[i].free.Value = 0
		end
	end

	wait(0.3)

	--reset lumberstuff
	farm.Lumbershed.TotalLogs.Value = 0
	remover(farm.Lumbershed:findFirstChild(&quot;Buy 10 wood - 500,-&quot;))
	temp = farm.Lumbershed:findFirstChild(&quot;Wood is being sold (ON/OFF)&quot;)
	if temp then
		temp.Name = &quot;Wood is not being sold (ON/OFF)&quot;
	end

	--reset road
	remover(farm:findFirstChild(&quot;Road&quot;))
	remover(farm:findFirstChild(&quot;Lay Road --- 200,-&quot;))
	temp = farm.RoadButtonclone.Value:clone()
	temp.Parent = farm

	--reset house
	remover(house:findFirstChild(&quot;HouseAdd&quot;))
	remover(house:findFirstChild(&quot;House2Add&quot;))
	remover(house:findFirstChild(&quot;House 2 --- 100 Wood + 5000,-&quot;))
	remover(house:findFirstChild(&quot;House is being rebuilt!&quot;))
	temp = house.Buttonclone.Value:clone()
	temp.Parent = house
	remover(house:findFirstChild(&quot;HouseRemove&quot;))
	temp = house.houseRemoveclone.Value:clone()
	temp.Parent = house
	remover(house:findFirstChild(&quot;Bed&quot;))
	remover(house:findFirstChild(&quot;SofaTV&quot;))
	temp = house.Bedclone.Value:clone()
	temp.Parent = house
	temp = house.SofaTVclone.Value:clone()
	temp.Parent = house

	--reset cabbagefield
	fieldsize.Value = 0
	fieldsize.Parent.Potato.Value = 0
	remover(fieldsize.Parent:findFirstChild(&quot;Megapotato&quot;))
	tmp = fieldsize.Parent.Cabbages:getChildren()
	for tmpi = 1, #tmp do
		tmp[tmpi].Transparency = 0.7
		tmp[tmpi].Size = Vector3.new(1,1,1)
		tmp[tmpi].Reflectance = 0
		local location = {tmp[tmpi].Position}
		local x = location[1].x
		local z = location[1].z
		tmp[tmpi].Position = Vector3.new(x,3.3,z)
		tmp[tmpi].BrickColor = BrickColor.new(226)
		tmp[tmpi].ready.Value = 0
	end
	fieldbutton.Name = &quot;Bigger Field! 100,-&quot;
	cabmoney.Value = 15
	potmoney.Value = 45
	farm.Field.Watersystem.Value = 0
	farm.Field.GrowthTime.Value = 20
	remover(farm.sunfilter:findFirstChild(&quot;SunFilter&quot;))
	temp = farm.sunfilter:findFirstChild(&quot;Sunfilter In Place&quot;)
	if temp~=nil then
		temp.Name = &quot;Sunfilter - 1750,-&quot;
	end
	remover(farm.Waterupgrade:findFirstChild(&quot;WateringMachine&quot;))
	temp = farm.Waterupgrade:findFirstChild(&quot;Watersystem In Place&quot;)
	if temp~=nil then
		temp.Name = &quot;Watering System - 500,-&quot;
	end

	wait(0.3)

	--reset statues
	remover(script.Parent.Cowstatue:findFirstChild(&quot;theStatue&quot;))
	remover(script.Parent.Megachicken:findFirstChild(&quot;theStatue&quot;))

end --end of MajorReset function


wait(1)
while true do
	if owner.Value ~= &quot;&quot; then
		local navn = owner.Value
		leaver = game.Players:FindFirstChild(navn)
		if leaver == nil then
			owner.Value = &quot;&quot;
			MajorReset()
		end
	end
	wait(1)
end
