					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<string name="Source">Tool = script.Parent

function onActivated(mouse)
	local temp = Tool.Parent.Name
	local player = game.Players:findFirstChild(temp)
	local upgrade = player:findFirstChild(&quot;plantLvl&quot;)

	if not Tool.Enabled then
		return
	end
	
	Tool.Enabled = false
	local hit = Tool.Target.Value


	if hit ~= nil then 
		if hit.Name == &quot;Cabbage&quot; then 
			if hit.Transparency &gt; 0 then
				local stats = player:findFirstChild(&quot;leaderstats&quot;)
				local cash = stats:findFirstChild(&quot;Money&quot;)
				if cash.Value &gt; 4 then
					cash.Value = cash.Value -5
					hit.Transparency = 0
				end
				local counter = 0
				c = hit.Parent:getChildren()
				for s = 1, #c do
					if c[s].Transparency &gt; 0 and counter &lt; upgrade.Value then
					if cash.Value &gt; 4 then
						cash.Value = cash.Value -5
						c[s].Transparency = 0
						counter = counter +1
					end
					end
				end
			else
				if hit.check.Value == 2 then
				temp = hit.Parent.Parent.Parent:findFirstChild(&quot;Owner&quot;)
				if temp == nil then
					temp = hit.Parent.Parent.Parent.Parent:findFirstChild(&quot;Owner&quot;)
				end
				if temp.Value == Tool.Parent.Name then
				hit.check.Value = 1
				end
				end
			end
		end 
	end

	Tool.Enabled = true

end 

Tool.Activated:connect(onActivated)
</string>
