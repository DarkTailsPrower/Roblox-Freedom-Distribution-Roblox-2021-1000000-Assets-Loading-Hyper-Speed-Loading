					<Item class="Script" referent="RBX1424">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">EggSnatcher</string>
							<string name="Source">hatch = script.Parent
plate = hatch.plate
stop = hatch.stopper
eggs = hatch.Parent.Parent.Feeders.eggs
ting = 0

function onTouch(hit)
	if ting == 0 and hit.Name == &quot;Egg&quot; then
		ting = 1
		eggs.Value = eggs.Value - 1
		hit.Parent = hatch
		hatch.free.Value = 1
		wait(0.4)
		stop.Transparency = 0
		stop.CanCollide = true
		ting = 0
	end
end

plate.Touched:connect(onTouch)
</string>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
					<Item class="Script" referent="RBX1425">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">ChickenGrower</string>
							<string name="Source">hatch = script.Parent
plat = hatch.plate
tinychicken = hatch:findFirstChild(&quot;tiny Chicken&quot;)
tinychickenclone =tinychicken:clone()
tinychicken:remove()
chicken = hatch.Chicken
chickenclone =chicken:clone()
chicken:remove()

ting = 0

function onTouch(hit)
	if ting == 0 then
		ting = 1
		if hit.Name == &quot;Egg&quot; then
			wait(60 + math.random(-10, 10)) --make into tiny chicken after this time
			if hatch.free.Value == 1 then
			hit:remove()
			newtinychicken = tinychickenclone:clone()
			newtinychicken.Parent = hatch
			newtinychicken:MakeJoints()
			end

			wait(100 + math.random(-20, 20)) --make into chicken after this time
			if hatch.free.Value == 1 then
			newtinychicken:remove()
			local newchicken = chickenclone:clone()
			newchicken.Parent = hatch
			newchicken:MakeJoints()
			local user = game.Players:findFirstChild(hatch.Parent.Parent.Owner.Value)
			if user ~= nil then
				user.chickensHatched.Value = user.chickensHatched.Value + 1
			end
			else
			if newtinychicken ~= nil then
				newtinychicken:remove()
			end
			end
			hatch.free.Value = 0
		end
		ting = 0
	end
end

plat.Touched:connect(onTouch)
