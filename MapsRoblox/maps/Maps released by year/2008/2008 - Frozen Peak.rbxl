				<Item class="Script" referent="RBX4542">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<string name="Source">function Captured(Captor)
local m = Instance.new(&quot;Message&quot;)
m.Name = &quot;BlueFlag2&quot;
P=game.Players:FindFirstChild(Captor.Name)
if P~=nil then
P.leaderstats.Flags.Value=P.leaderstats.Flags.Value+1
end
m.Text = Captor.Name.. &quot; has captured the red flag!&quot;
m.Parent = game.Workspace
wait(2)
m:remove()
end
script.Parent.FlagCaptured:connect(Captured)</string>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
			<Item class="Script" referent="RBX4543">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<string name="Source">function OnTaken(Flag)
if Flag.className == &quot;Flag&quot; then
local m = Instance.new(&quot;Message&quot;)
m.Name = &quot;BlueFlag1&quot;
m.Text = &quot;Blue flag taken!&quot;
m.Parent = game.Workspace
wait(2)
m:remove()
end
