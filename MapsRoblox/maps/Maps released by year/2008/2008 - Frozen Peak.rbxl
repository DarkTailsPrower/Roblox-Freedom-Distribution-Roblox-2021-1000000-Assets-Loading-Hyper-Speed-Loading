					<string name="Source">local debris = game:service(&quot;Debris&quot;)
pellet = script.Parent
damage = 60
hdamage = 150
qwerty=false
function onTouched(hit)
print(&quot;hit&quot;)
if qwerty==false then
qwerty=true
	humanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
	if humanoid~=nil then
	if humanoid.Health&lt;=0 then pellet.Parent = nil return end
	if hit.Parent.Torso.BrickColor==script.Parent.creator.Value.Torso.BrickColor then script.Parent:remove() return end
	Playor=game.Players:FindFirstChild(script.Parent.creator.Value.Name)
	if hit.Parent:FindFirstChild(&quot;ForceField&quot;) ~=nil then pellet.Parent = nil return end
		if hit.Name~=&quot;head&quot; then
		humanoid.Health=humanoid.Health-damage
		elseif hit.Name==&quot;head&quot; then
		humanoid.Health=humanoid.Health-hdamage
		end
		if humanoid.Health&lt;=0 then
		Playor.leaderstats:FindFirstChild(&quot;KO&apos;s&quot;).Value=Playor.leaderstats:FindFirstChild(&quot;KO&apos;s&quot;).Value+1
		Playor2=game.Players:FindFirstChild(hit.Parent.Name)
		Playor2.leaderstats:FindFirstChild(&quot;WO&apos;s&quot;).Value=Playor2.leaderstats:FindFirstChild(&quot;WO&apos;s&quot;).Value+1
		end
		pellet.Parent = nil

	return end
qwerty=false
end
end

