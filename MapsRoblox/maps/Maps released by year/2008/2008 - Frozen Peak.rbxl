			<Item class="Script" referent="RBX4762">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<string name="Source">function OnTouch(hit)
if hit.Name==&quot;Snowball&quot; then return end
p=game.Players:FindFirstChild(hit.Parent.Name)
if p==nil then return end
if p.Backpack:FindFirstChild(&quot;Snow Chucker&quot;)~=nil then return end
if hit.Parent:FindFirstChild(&quot;Snow Chucker&quot;)~=nil then return end
game.Lighting:FindFirstChild(&quot;Snow Chucker&quot;):clone().Parent=p.Backpack
end
script.Parent.Touched:connect(OnTouch)</string>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
