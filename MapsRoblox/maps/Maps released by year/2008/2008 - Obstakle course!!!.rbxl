								<string name="Source">function onTouch(part) 
local human = part.Parent:findFirstChild(&quot;Humanoid&quot;) 
if human ~= nil then 
wait(1)
part.Parent:findFirstChild(&quot;Head&quot;).Anchored = true
part.Parent:findFirstChild(&quot;Torso&quot;).Anchored = true
