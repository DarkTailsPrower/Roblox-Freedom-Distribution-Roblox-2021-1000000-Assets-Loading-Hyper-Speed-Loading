				<Item class="Script" referent="RBX23">
					<Properties>
						<bool name="Archivable">true</bool>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Timer-t</string>
						<ProtectedString name="Source">local Door = script.Parent
messageText = &quot;HANGER DOOR OPEN - EVACUATE STATION&quot; 
-- Enter the message you want to appear while your object(s) are regenarating.

message = Instance.new(&quot;Message&quot;)
message.Text = messageText

ticksound = Instance.new(&quot;Sound&quot;)
ticksound.SoundId = &quot;9acb4b8d066d3a454ddb489cbfc046d3&quot;
ticksound.Looped = true
ticksound.Parent = script.Parent





while true do
	wait(120) -- regenerate this model every 300 seconds

	message.Parent = game.Workspace

	wait(4) -- display regen message for 4 seconds

                        Door.Transparency = 0.5 
			Door.CanCollide = false 
	                message.Parent = nil
                        ticksound:play()
        wait(90)

messageText2 = &quot;STATION LOCKDOWN - RADIATION LEVELS CRITICAL&quot;

message2 = Instance.new(&quot;Message&quot;)
message2.Text = messageText2

        message2.Parent = game.Workspace

        wait(4)
                        Door.Transparency = 0 
			Door.CanCollide = true
	                message2.Parent = nil
                        ticksound:play()
                                 
end -- The end wasn&apos;t included in most regen scripts I downloaded!

 -- This script was by thegammingperson1994

</ProtectedString>
					</Properties>
				</Item>
