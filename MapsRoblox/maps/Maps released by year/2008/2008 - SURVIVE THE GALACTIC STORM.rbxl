				<Item class="Script" referent="RBX760">
					<Properties>
						<bool name="Archivable">true</bool>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">README</string>
						<ProtectedString name="Source">-----Use my crawler tool to drive this. If anyone remembers are92&apos;s place &quot;elephant wars&quot; the halo3 place thats where I got the idea from. He got rid of the elephant tanks and so
-----I built new ones. This is the result.

-----By camjam007----2008</ProtectedString>
					</Properties>
				</Item>
			</Item>
			<Item class="Model" referent="RBX761">
				<Properties>
					<bool name="Archivable">true</bool>
					<CoordinateFrame name="ModelInPrimary">
						<X>0</X>
						<Y>0</Y>
						<Z>0</Z>
						<R00>1</R00>
						<R01>0</R01>
						<R02>0</R02>
						<R10>0</R10>
						<R11>1</R11>
						<R12>0</R12>
