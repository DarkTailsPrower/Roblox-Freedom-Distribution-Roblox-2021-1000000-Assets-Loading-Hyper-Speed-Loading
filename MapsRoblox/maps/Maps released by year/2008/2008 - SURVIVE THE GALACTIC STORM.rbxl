					<Properties>
						<bool name="Archivable">true</bool>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">FlyScript</string>
						<ProtectedString name="Source">local engine = script.Parent.Parent.Engine
local spd = 0.5
local position = engine.Position

while true do
	wait(.1)
	direction = engine.CFrame.lookVector 
	position = position + spd*2*direction
	error = position - engine.Position
	engine.Velocity = spd*error
	engine.RotVelocity = Vector3.new(0, 0, 0)
end 
</ProtectedString>
