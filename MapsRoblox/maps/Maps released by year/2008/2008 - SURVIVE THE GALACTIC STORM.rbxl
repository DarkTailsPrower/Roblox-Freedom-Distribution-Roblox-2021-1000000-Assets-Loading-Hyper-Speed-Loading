						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Timer-t</string>
						<ProtectedString name="Source">local Door = script.Parent


while true do
	wait(120) -- Wait 2 mins before door opens

                        Door.Transparency = 0.5 
			Door.CanCollide = false 
	                message.Parent = nil
                        ticksound:play()
        wait(90) -- Door is open for 90 secs before closing again

                        Door.Transparency = 0 
			Door.CanCollide = true
	                message2.Parent = nil
                        ticksound:play()
                                 
end
 -- This script was by camjam007 creator of &quot;SURVIVE THE GALACTIC STORM&quot;

</ProtectedString>
