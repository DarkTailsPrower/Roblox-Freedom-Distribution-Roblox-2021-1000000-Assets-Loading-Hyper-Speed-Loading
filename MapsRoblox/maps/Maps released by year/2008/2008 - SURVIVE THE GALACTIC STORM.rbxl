				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">RegenScript Template by tgp1994</string>
				<ProtectedString name="Source">model = game.Workspace.Parts -- Make sure you enter the complete path to the model(s) you want to regenerate.
messageText = &quot;Storm reseting...&quot; -- Enter the message you want to appear while your object(s) are regenarating.

message = Instance.new(&quot;Hint&quot;)
message.Text = messageText
backup = model:clone()

while true do
	wait(300) -- regenerate this model every 60 seconds

	message.Parent = game.Workspace
	model:remove()

	wait(4) -- display regen message for 4 seconds

	model = backup:clone()
	model.Parent = game.Workspace
	model:makeJoints()
	message.Parent = nil
end -- The end wasn&apos;t included in most regen scripts I downloaded!

 -- This script was by thegammingperson1994

</ProtectedString>
