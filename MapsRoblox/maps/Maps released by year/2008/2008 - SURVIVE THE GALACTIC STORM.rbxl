				fly.Parent = plane.Engine
                                hover.maxForce = Vector3.new(0, 0, 0)
                                hover.velocity = Vector3.new(0, 0, 0)
                                Adoor.CanCollide = true
                                Adoor.Transparency = 0
                                Bdoor.CanCollide = true
                                Bdoor.Transparency = 0
                                ticksound2:play()
                                ticksound23:play()
			end
