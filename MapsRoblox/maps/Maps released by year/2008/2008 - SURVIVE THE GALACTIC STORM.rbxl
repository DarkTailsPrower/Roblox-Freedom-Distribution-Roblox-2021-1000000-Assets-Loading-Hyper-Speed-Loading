			<Item class="Script" referent="RBX20">
				<Properties>
					<bool name="Archivable">true</bool>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">function onTouched(part)
        p = game.Players:playerFromCharacter(part.Parent)
        if p == nil then return end
	gun = game.Lighting.Shotgun:clone()
        if p.Backpack:findFirstChild(gun.Name) ~= nil then return end
        gun.Parent = p.Backpack
end

script.Parent.Touched:connect(onTouched)</ProtectedString>
				</Properties>
			</Item>
