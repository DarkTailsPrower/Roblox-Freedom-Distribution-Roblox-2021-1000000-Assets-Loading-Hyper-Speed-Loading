				<Item class="Script" referent="RBX2346">
					<Properties>
						<bool name="Archivable">true</bool>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">name=&quot;Alien&quot;

wait(1)
robo=game.Workspace.zombie2:findFirstChild(name):clone()

while true do
	wait(5)
	if game.Workspace.zombie2:findFirstChild(name)==nil then
		robot=robo:clone()
		robot.Parent=game.Workspace.zombie2
	end
	if game.Workspace.zombie2:findFirstChild(name):findFirstChild(&quot;Zombie&quot;)==nil then
		game.Workspace.zombie2:findFirstChild(name):remove()
		robot=robo:clone()
		robot.Parent=game.Workspace.zombie2
	end
	if game.Workspace.zombie2:findFirstChild(name).Zombie.Health&lt;1 then
		game.Workspace.zombie2:findFirstChild(name):remove()
		robot=robo:clone()
		robot.Parent=game.Workspace.zombie2
	end
end
		


</ProtectedString>
					</Properties>
				</Item>
			</Item>
