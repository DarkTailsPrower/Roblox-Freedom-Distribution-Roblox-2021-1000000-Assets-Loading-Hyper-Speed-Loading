					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">README!!</string>
					<ProtectedString name="Source">--Hello
--These are teleporters
--(((((DUH))))
--if it is easier for you to un group them then go ahaed
--if you don&apos;t ungroup them then get a move tool to move them...
--Thats about it
--These were intended for monkeyhead62, but anyone can use them





----------------------------------slayer9365</ProtectedString>
