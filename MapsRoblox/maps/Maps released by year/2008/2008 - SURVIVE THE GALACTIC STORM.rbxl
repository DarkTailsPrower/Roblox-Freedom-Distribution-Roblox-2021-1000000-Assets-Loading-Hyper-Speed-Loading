					<string name="Name">Snap Removal</string>
					<ProtectedString name="Source">--Script By 12it123
p= game.Workspace:GetChildren()			
for i= 1, #p do				
if p[i].className == &quot;Part&quot; then
if p[i].Anchored == true then
p[i]:BreakJoints()
end
elseif p[i].className == &quot;Model&quot; then
pp=p[i]:GetChildren()
for i=1, #pp do
if p[i].className == &quot;Part&quot; then
if p[i].Anchored == true then
p[i]:BreakJoints()
end
end
end
end
end</ProtectedString>
