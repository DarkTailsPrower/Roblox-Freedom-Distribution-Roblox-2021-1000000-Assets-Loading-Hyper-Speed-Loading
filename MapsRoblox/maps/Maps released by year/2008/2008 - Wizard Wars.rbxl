			</Item>
			<Item class="Script" referent="RBX2004">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">MeltCage</string>
					<string name="Source">local cage = script.Parent


for i=1,3 do
	wait(8)

	local c = cage:children()
	for n=1,#c do
		if (c[n].className == &quot;Part&quot;) then
			c[n].Reflectance = 0
			c[n].Transparency = (i / 4)
		end
	end
end

script.Parent:remove()</string>
					<bool name="archivable">true</bool>
				</Properties>
