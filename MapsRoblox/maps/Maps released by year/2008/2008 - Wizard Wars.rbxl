		<Item class="Script" referent="RBX4">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">ManaRegen</string>
				<string name="Source">local wizardShirt = &quot;http://www.roblox.com/asset/?version=1&amp;id=1157047&quot;
local battlemageShirt = &quot;http://www.roblox.com/asset/?version=1&amp;id=1161248&quot;
local apprenticeShirt = &quot;http://www.roblox.com/asset/?version=1&amp;id=1161246&quot;


function hasShirt(shirtType, player)
	local char = player.Character
	if (char == nil) then return false end

	local shirt = char:findFirstChild(&quot;Shirt Graphic&quot;)
	if (shirt == nil) then return false end

	if (shirt.Graphic == shirtType) then
		return true
	end

	return false
end

function minLevel(player)
	if (hasShirt(apprenticeShirt, player)) then return 5 end
	if (hasShirt(wizardShirt, player)) then return 5 end
	if (hasShirt(battlemageShirt, player)) then return 20 end
	return 1
end


function testForSetLevel(player)
	local stats = player:findFirstChild(&quot;leaderstats&quot;)
	if stats == nil then return end
	local level = stats:findFirstChild(&quot;Level&quot;)
	if level == nil then return end

	
	if (level.Value &lt; minLevel(player)) then
		level.Value = minLevel(player)
	end
end



function GetMaxMana(level)
	return level * 20
end

function GetManaRegenRate(player, level)

	local r = 0
	if (level &lt; 5) then
		r = level
	else
		r = 5
	end

	if (hasShirt(wizardShirt, player) or hasShirt(battlemageShirt, player)) then r = r * 2 end

	return r
	
end

function RegenMana(player)
	-- make sure this player has the wizard board stats
	local stats = player:findFirstChild(&quot;leaderstats&quot;)
	if stats == nil then return end
	local mana = stats:findFirstChild(&quot;Mana&quot;)
	local level = stats:findFirstChild(&quot;Level&quot;)
	if mana == nil or level == nil then return end

	
	if (mana.Value &lt; GetMaxMana(level.Value)) then
		mana.Value = mana.Value + GetManaRegenRate(player, level.Value)
	end

	if (math.random(1, 25 * level.Value) == 12) then 
		level.Value = level.Value + 1
	end
end


while true do
	wait(2)
	
	local players = game.Players:children()
	for i =1,#players do
		RegenMana(players[i])
		testForSetLevel(players[i])
	end
end</string>
