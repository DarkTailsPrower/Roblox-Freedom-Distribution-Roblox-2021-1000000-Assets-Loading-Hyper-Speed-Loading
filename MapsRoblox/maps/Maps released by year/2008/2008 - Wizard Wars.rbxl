			<Item class="Script" referent="RBX2006">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">BallScript</string>
					<string name="Source">r = game:service(&quot;RunService&quot;)

shaft = script.Parent
position = shaft.Position



local time_aloft = 0
local max_time = 10 -- flies for 10 seconds

function getPower()
	local int_time = math.floor(time_aloft) + 1
	return int_time
end

function getSpeed()
	-- start at 5 studs per sec, decrease to 2
	local speed = 5 - (3 * (time_aloft / max_time))
	return speed
end

function fly(airtime)
	direction = shaft.CFrame.lookVector 
	position = position + direction
	error = position - shaft.Position
	shaft.Velocity = getSpeed() *error

	local power = getPower()
	if shaft.Size.x ~= power then 
		shaft.Size = Vector3.new(power, power, power)
	end
end

function blow()
	--swoosh:stop()
	explosion = Instance.new(&quot;Explosion&quot;)
	explosion.Position = shaft.Position
	explosion.BlastRadius = 2 * getPower()
	
	explosion.BlastPressure = 50000 * (getPower() * 8)

	-- find instigator tag
	local creator = script.Parent:findFirstChild(&quot;creator&quot;)
	if creator ~= nil then
		explosion.Hit:connect(function(part, distance)  onPlayerBlownUp(part, distance, creator) end)
	end

	explosion.Parent = game.Workspace
	connection:disconnect()
	wait(.1)
	shaft:remove()
end

function onPlayerBlownUp(part, distance, creator)
	
	if part.Name == &quot;Head&quot; then
	
		local humanoid = part.Parent:findFirstChild(&quot;Humanoid&quot;)
		tagHumanoid(humanoid, creator)
	end
end

function tagHumanoid(humanoid, creator)
	-- tag does not need to expire iff all explosions lethal
	
	if creator ~= nil then
		local new_tag = creator:clone()
		new_tag.Parent = humanoid
		
	end
end

function untagHumanoid(humanoid)
	if humanoid ~= nil then
		local tag = humanoid:findFirstChild(&quot;creator&quot;)
		if tag ~= nil then
		
			tag.Parent = nil
		end
	end
end

t, s = r.Stepped:wait()

--swoosh = script.Parent.Swoosh
--swoosh:play()

d = t + max_time - s
connection = shaft.Touched:connect(blow)

while t &lt; d do
	time_aloft = max_time - (d-t)
	--print (getPower())
	fly()
	t = r.Stepped:wait()
end

blow()


</string>
