				<Item class="Script" referent="RBX514">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">BridgeScript</string>
						<string name="Source">local bodyforce = script.Parent.Drawbridge.BodyForce

local debounce = false


function onTouchedUp(hit)
	print(&quot;Touched Up&quot;)
	local humanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
	if humanoid~=nil and debounce == false then
		debounce = true
		bodyforce.force = Vector3.new(0,180000,0)
		wait(5)
		debounce = false
	end
end

function onTouchedDown(hit)
	print(&quot;Touched Down&quot;)
	local humanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
	if humanoid~=nil and debounce == false then
		debounce = true
		bodyforce.force = Vector3.new(0,0,0)
		wait(5)
		debounce = false
	end
end




script.Parent.BridgeDown.Touched:connect(onTouchedDown)
script.Parent.BridgeUp.Touched:connect(onTouchedUp)


</string>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
