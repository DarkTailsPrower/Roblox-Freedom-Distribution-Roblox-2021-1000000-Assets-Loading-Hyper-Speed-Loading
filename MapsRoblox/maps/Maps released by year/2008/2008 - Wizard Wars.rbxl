		<Item class="Script" referent="RBX5">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">RegenerationStation</string>
				<string name="Source">local stuff = game.Workspace.Castle:clone()
local banditstuff = game.Workspace.BanditStuff:clone()
local cats = {&quot;Catapult1&quot;, &quot;Catapult2&quot;, &quot;Catapult3&quot;, &quot;WheelyDealy&quot;}
local catClones = {game.Workspace.Catapult1:clone(), game.Workspace.Catapult2:clone(), game.Workspace.Catapult3:clone(), game.Workspace.WheelyDealy:clone()}
local catToRegen = 1

message = nil
function showMessage(text)
	-- This function flashes a message to all players
	-- Clear the message with hideMessage()

	hideMessage() -- Never show more than one message at a time
	if message == nil then message = Instance.new(&quot;Message&quot;) end -- only make a message if we don&apos;t have a message object lying around
	message.Text = text
	message.Parent = game.Workspace
end

function hideMessage()
	if message == nil then return end
	message.Parent = nil
end

function RegenACat()
	if (catToRegen &gt; #cats) then catToRegen = 1 end

	local cat = game.Workspace:findFirstChild(cats[catToRegen])
	cat:remove()
	local new_cat = catClones[catToRegen]:clone()
	new_cat.Parent = game.Workspace
	new_cat:makeJoints()

	catToRegen = catToRegen + 1
end

function Regen()
	game.Workspace.Castle:remove()
	local new_stuff = stuff:clone()
	new_stuff.Parent = game.Workspace
	new_stuff:makeJoints()

	--game.Workspace.BanditStuff:remove()
	--new_stuff = banditstuff:clone()
	--new_stuff.Parent = game.Workspace
	--new_stuff:makeJoints()
end


local game_time = 0
while true do
	wait(20)

	game_time = game_time + 20

	if (game_time &gt; 300) then
		Regen()
		game_time = 0
	else
		RegenACat()
	end
	

end</string>
