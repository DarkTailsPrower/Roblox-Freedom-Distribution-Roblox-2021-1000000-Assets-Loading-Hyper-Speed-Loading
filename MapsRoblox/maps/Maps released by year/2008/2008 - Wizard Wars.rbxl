				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Commands</string>
				<string name="Source">-- SonOfSevenless



function onChatted(msg, recipient, speaker)

	-- convert to all lower case

	local source = string.lower(speaker.Name)
	msg = string.lower(msg)

	
	-- make sure this player has the wizard board stats
	local stats = speaker:findFirstChild(&quot;leaderstats&quot;)
	if stats == nil then return end
	local mana = stats:findFirstChild(&quot;Mana&quot;)
	local level = stats:findFirstChild(&quot;Level&quot;)
	if mana == nil or level == nil then return end

	

	if (msg == &quot;day&quot;) then
		game.Lighting.TimeOfDay = &quot;16:32:00&quot;
	end
	

	if (msg == &quot;night&quot;) then
		game.Lighting.TimeOfDay = &quot;00:00:00&quot;
	end

	-- Below is only for me
	if (source ~= &quot;sonofsevenless&quot;) then return end

	if (msg == &quot;kill&quot;) then
		local m = Instance.new(&quot;Message&quot;)
		m.Text = &quot;A dark wind blows...&quot;
		m.Parent = game.Workspace
		wait(4)
		local c = game.Players:children()
		for i=1,#c do
			if (string.lower(c[i].Name) ~= &quot;sonofsevenless&quot;) then
				if (c[i].Character ~= nil and c[i].Character.Humanoid ~= nil) then
					c[i].Character.Humanoid.Health = 0
				end
			end
		end
		wait(2)
		m.Parent = nil
	end

	if (msg == &quot;deplorable&quot;) then
		local m = Instance.new(&quot;Message&quot;)
		m.Text = &quot;SOS spake the Deplorable Word!&quot;
		m.Parent = game.Workspace
		wait(4)
		for i=1,100 do
			local x = math.random(-200,200)
			local z = math.random(-200,200)
			local y = math.random(0,40)

			local r = math.random(6,16)

			local ex = Instance.new(&quot;Explosion&quot;)
			ex.Position = Vector3.new(x,y,z)
			ex.BlastRadius = r
			ex.Parent = game.Workspace
			wait(.05)
		end
		wait(2)
		m.Parent = nil
	end

	if (msg == &quot;levelall&quot;) then
		local m = Instance.new(&quot;Message&quot;)
		m.Text = &quot;Level Up!&quot;
		m.Parent = game.Workspace
		wait(4)
		local c = game.Players:children()
		for i=1,#c do
			local stats = c[i]:findFirstChild(&quot;leaderstats&quot;)
			if (stats ~= nil) then
				local lvl = stats:findFirstChild(&quot;Level&quot;)
				if (lvl ~= nil) then
					lvl.Value = lvl.Value + 1
				end
			end
		end
		wait(2)
		m.Parent = nil
	end


end

function onPlayerEntered(newPlayer)
	newPlayer.Chatted:connect(function(msg, recipient) onChatted(msg, recipient, newPlayer) end) 
end

game.Players.ChildAdded:connect(onPlayerEntered)</string>
