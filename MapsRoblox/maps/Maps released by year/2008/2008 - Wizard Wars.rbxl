				</Properties>
			</Item>
			<Item class="Script" referent="RBX2007">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">FireBallCaster</string>
					<string name="Source">-- SonOfSevenless
print(&quot;Fireball spell loaded&quot;)

local COOLDOWN = 3
local MP = 5

bin = script.Parent

wait(2)


local Fireball = Instance.new(&quot;Part&quot;)
Fireball.Name = &quot;Fireball&quot;
Fireball.Locked = true
Fireball.BackSurface = 1
Fireball.BottomSurface = 1
Fireball.FrontSurface = 1
Fireball.LeftSurface = 1
Fireball.RightSurface = 1
Fireball.TopSurface = 1
Fireball.Transparency = .2
Fireball.Shape = 0
Fireball.Size = Vector3.new(1,1,1)
--Fireball.BrickColor = BrickColor.new(21)
Fireball.Color = Color3.new(1,0,0)
script.Parent.BallScript:clone().Parent = Fireball
script.Parent.Explosion:clone().Parent = Fireball
script.Parent.Swoosh:clone().Parent = Fireball

function TryToCast(player)
	-- returns true if player may cast this spell

	-- make sure this player has the wizard board stats
	local stats = player:findFirstChild(&quot;leaderstats&quot;)
	if stats == nil then return false end
	local mana = stats:findFirstChild(&quot;Mana&quot;)
	local level = stats:findFirstChild(&quot;Level&quot;)
	if mana == nil or level == nil then return false end

	if (mana.Value &gt;= MP) then
		mana.Value = mana.Value - MP
		return true
	end

	return false
end

function fire(target)

	if (game.Players.LocalPlayer == nil or game.Players.LocalPlayer.Character == nil) then return end
	
	local head = game.Players.LocalPlayer.Character:findFirstChild(&quot;Head&quot;)
	if head == nil then return end

	local dir = target - head.Position
	dir = computeDirection(dir)


	local missile = Fireball:clone()

	local spawnPos = game.Players.LocalPlayer.Character.PrimaryPart.Position

	local pos = spawnPos + (dir * 8)
	
	--missile.Position = pos
	missile.CFrame = CFrame.new(pos,  pos + dir)

	local creator_tag = Instance.new(&quot;ObjectValue&quot;)
	creator_tag.Value = game.Players.LocalPlayer
	creator_tag.Name = &quot;creator&quot;
	creator_tag.Parent = missile
	


	missile.BallScript.Disabled = false


	missile.Parent = game.Workspace

end

function computeDirection(vec)
	local lenSquared = vec.magnitude * vec.magnitude
	local invSqrt = 1 / math.sqrt(lenSquared)
	return Vector3.new(vec.x * invSqrt, vec.y * invSqrt, vec.z * invSqrt)
end




enabled = true
function onButton1Down(mouse)
	if not enabled then
		return
	end

	local player = game.Players.LocalPlayer
	if player == nil then return end
	if TryToCast(player) == false then return end

	enabled = false
	mouse.Icon = &quot;rbxasset://textures\\GunWaitCursor.png&quot;

	-- find the best cf
	local cf = mouse.Hit
	--local v = cf.lookVector
	local target = cf.p

	fire(target)

	wait(COOLDOWN)

	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	enabled = true
end

function onSelected(mouse)
	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end


bin.Selected:connect(onSelected)

