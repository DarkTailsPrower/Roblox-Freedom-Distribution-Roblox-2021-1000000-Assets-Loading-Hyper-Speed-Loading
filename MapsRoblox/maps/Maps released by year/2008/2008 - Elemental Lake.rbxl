		<Item class="Script" referent="RBX2866">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">onEnterScript</string>
				<ProtectedString name="Source">print(&quot;ICE128&apos;s Personal Base Script Loaded!&quot;)
game.Workspace.Bases.Parent = game.Lighting.Storage

function onPlayerRespawned(newPlayer)
&#9;print(&quot;Respawned; Moving player to base...&quot;)

&#9;while true do
&#9;wait()
&#9;if newPlayer.Character ~= nil then break --No broken scripts plz.
&#9;end
&#9;end

&#9;newPlayer.Character:moveTo(game.Workspace:findFirstChild(newPlayer.Number.Value).Spawn.Position + Vector3.new(0,5,0)) --Move the player to its base.

end

function onPlayerByeBye(player) -- ByeBye player, byebye base.
&#9;local intv = player:findFirstChild(&quot;Number&quot;)
&#9;local place = game.Workspace:findFirstChild(intv.Value)
&#9;local owner = place:findFirstChild(&quot;Owner&quot;)
&#9;if intv ~= nil and place ~= nil then 
&#9;&#9;if owner.Value == player.Name then --Check who owns the base so we can delete it! &gt;:)
&#9;&#9;place:remove()
&#9;&#9;end
&#9;end
end

function onPlayerEntered(newPlayer)
&#9;print(&quot;Entered; Finding Base...&quot;)
&#9;num = math.random(1,20) -- The bases are chosen by random :O
&#9;while true do
&#9;print(num)
&#9;if game.Workspace:findFirstChild(num) ~= nil then --If base already out there then...
&#9;&#9;print(&quot;Base already in play.&quot;)
&#9;&#9;num = math.random(1,20) --...Base is chosen again :)
&#9;else break end
&#9;wait()
&#9;end

&#9;local int = Instance.new(&quot;IntValue&quot;)
&#9;int.Parent = newPlayer
&#9;int.Name = &quot;Number&quot;
&#9;int.Value = num -- Keep the number of the base in the character for future use...

&#9;local hut = game.Lighting.Storage.Bases:findFirstChild(num):clone() -- Use the chosen number to find the base :)
&#9;hut.Parent = game.Workspace
&#9;hut.Owner.Value = newPlayer.Name

&#9;newPlayer.Changed:connect(function (property)
&#9;&#9;if (property == &quot;Character&quot;) then

&#9;&#9;&#9;onPlayerRespawned(newPlayer)
&#9;&#9;end
&#9;end)

&#9;while true do
&#9;wait()
&#9;if newPlayer.Character ~= nil then break -- No broken scripts plz.
&#9;end
&#9;end

&#9;hut.Flag1.BrickColor = newPlayer.Character:findFirstChild(&quot;Right Arm&quot;).BrickColor
&#9;hut.Flag2.BrickColor = newPlayer.Character:findFirstChild(&quot;Torso&quot;).BrickColor
&#9;hut.Flag3.BrickColor = newPlayer.Character:findFirstChild(&quot;Left Arm&quot;).BrickColor -- Whee flag color changes :D

&#9;local touch = script.MoveScriptToPlayer:clone()
&#9;touch.Disabled = false --New script in play.
&#9;touch.Parent = hut

&#9;local m = Instance.new(&quot;Model&quot;)
&#9;m.Name = newPlayer.Name .. &quot;&apos;s Base&quot;
&#9;m.Parent = hut

&#9;local h = Instance.new(&quot;Humanoid&quot;)
&#9;h.Parent = m
&#9;h.MaxHealth = 0
&#9;h.Health = 0

&#9;local head = hut.FlagPillar
&#9;head.Parent = m
&#9;head.Name = &quot;Head&quot;
&#9;
end

game.Players.PlayerAdded:connect(onPlayerEntered)
game.Players.PlayerRemoving:connect(onPlayerByeBye)</ProtectedString>
			</Properties>
			<Item class="Script" referent="RBX2867">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">MoveScriptToPlayer</string>
					<ProtectedString name="Source">function onTouched(part)
&#9;if part.Parent ~= nil then
&#9;local humanoid = part.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;if humanoid ~= nil and debounce==nil then
&#9;&#9;if script.Parent.Owner.Value == humanoid.Parent.Name then
&#9;&#9;debounce = true
&#9;&#9;--script.Parent.Parent = nil
&#9;&#9;humanoid.Health = 100
&#9;&#9;e = Instance.new(&quot;ForceField&quot;)
&#9;&#9;e.Parent = humanoid.Parent
&#9;&#9;wait(1)
&#9;&#9;e:remove()
&#9;&#9;debounce = nil
&#9;&#9;end
&#9;&#9;end
&#9;end
end
script.Parent.Base.Touched:connect(onTouched)</ProtectedString>
				</Properties>
			</Item>
		</Item>
