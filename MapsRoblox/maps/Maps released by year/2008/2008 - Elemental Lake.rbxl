						<ProtectedString name="Source">function onTouched(part)
&#9;if part.Parent ~= nil then
&#9;local humanoid = part.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;if humanoid and debounce==nil and humanoid.Parent:findFirstChild(&quot;Torso&quot;) ~= nil then
&#9;&#9;debounce = true
&#9;&#9;humanoid.Parent:findFirstChild(&quot;Torso&quot;).Velocity = Vector3.new(0,script.Parent.Size.y*10,0)
&#9;&#9;wait(.5)
&#9;&#9;debounce = nil
&#9;&#9;end
&#9;end
end
script.Parent.Touched:connect(onTouched)</ProtectedString>
