&#9;&#9;humanoid.Parent:findFirstChild(&quot;Torso&quot;).Velocity = Vector3.new(0,script.Parent.Size.y*10,0)
&#9;&#9;wait(.5)
&#9;&#9;debounce = nil
&#9;&#9;end
&#9;end
end
