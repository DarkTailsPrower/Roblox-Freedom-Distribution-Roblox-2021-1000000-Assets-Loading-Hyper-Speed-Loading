					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">MoveScriptToPlayer</string>
					<ProtectedString name="Source">tool = script.Parent:clone()
function onTouched(part)
&#9;if part.Parent ~= nil then
&#9;local humanoid = part.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;if humanoid and debounce==nil then
&#9;&#9;debounce = true
&#9;&#9;script.Parent.Handle.Anchored = false
&#9;&#9;script.Parent = game.Workspace
&#9;&#9;wait(math.random(30,60))
&#9;&#9;tool:clone().Parent = game.Workspace
&#9;&#9;script:remove()
&#9;&#9;end
&#9;end
end
script.Parent.Handle.Touched:connect(onTouched)</ProtectedString>
