&#9;&#9;&#9;elseif script.Parent.mode.Value==5 then
&#9;&#9;&#9;&#9;script.Parent.mode.Value=6
&#9;&#9;&#9;&#9;reloadtime=2
&#9;&#9;&#9;&#9;pm(6)
&#9;&#9;&#9;elseif script.Parent.mode.Value==6 then
&#9;&#9;&#9;&#9;script.Parent.mode.Value=7
&#9;&#9;&#9;&#9;reloadtime=.5
&#9;&#9;&#9;&#9;pm(7)
&#9;&#9;&#9;elseif script.Parent.mode.Value&gt;6 then
&#9;&#9;&#9;&#9;script.Parent.mode.Value=1
&#9;&#9;&#9;&#9;reloadtime=.5
&#9;&#9;&#9;&#9;pm(1)
&#9;&#9;&#9;end
&#9;&#9;elseif (key==&quot;e&quot;) then
&#9;&#9;&#9;if script.Parent.mode.Value&lt;1 then
&#9;&#9;&#9;&#9;script.Parent.mode.Value=7
&#9;&#9;&#9;&#9;reloadtime=.5
&#9;&#9;&#9;&#9;pm(7)
&#9;&#9;&#9;elseif script.Parent.mode.Value==1 then
&#9;&#9;&#9;&#9;script.Parent.mode.Value=7
&#9;&#9;&#9;&#9;reloadtime=.5
&#9;&#9;&#9;&#9;pm(7)
&#9;&#9;&#9;elseif script.Parent.mode.Value==2 then
&#9;&#9;&#9;&#9;script.Parent.mode.Value=1
&#9;&#9;&#9;&#9;reloadtime=.5
&#9;&#9;&#9;&#9;pm(1)
&#9;&#9;&#9;elseif script.Parent.mode.Value==3 then
&#9;&#9;&#9;&#9;script.Parent.mode.Value=2
&#9;&#9;&#9;&#9;reloadtime=7
&#9;&#9;&#9;&#9;pm(2)
&#9;&#9;&#9;elseif script.Parent.mode.Value==4 then
&#9;&#9;&#9;&#9;script.Parent.mode.Value=3
&#9;&#9;&#9;&#9;reloadtime=.8
&#9;&#9;&#9;&#9;pm(3)
&#9;&#9;&#9;elseif script.Parent.mode.Value==5 then
&#9;&#9;&#9;&#9;script.Parent.mode.Value=4
&#9;&#9;&#9;&#9;reloadtime=5
&#9;&#9;&#9;&#9;pm(4)
&#9;&#9;&#9;elseif script.Parent.mode.Value==6 then
&#9;&#9;&#9;&#9;script.Parent.mode.Value=5
&#9;&#9;&#9;&#9;reloadtime=5
&#9;&#9;&#9;&#9;pm(5)
&#9;&#9;&#9;elseif script.Parent.mode.Value==7 then
&#9;&#9;&#9;&#9;script.Parent.mode.Value=6
&#9;&#9;&#9;&#9;reloadtime=2
&#9;&#9;&#9;&#9;pm(6)
&#9;&#9;&#9;end
&#9;&#9;elseif (key==&quot;f&quot;) then
&#9;&#9;&#9;if script.Parent.mode.Value&lt;10 and nadeon==false then
&#9;&#9;&#9;&#9;nadeon=true
&#9;&#9;&#9;&#9;script.Parent.mode.Value=10+script.Parent.mode.Value
&#9;&#9;&#9;&#9;pm(11)
&#9;&#9;&#9;&#9;while script.Parent.mode.Value&gt;10 do wait(1) end
&#9;&#9;&#9;&#9;wait(10)
&#9;&#9;&#9;&#9;nadeon=false
&#9;&#9;&#9;end
&#9;&#9;elseif (key==&quot;p&quot;) then
&#9;&#9;&#9;if game.Players:findFirstChild(script.Parent.Parent.Name)~=nil then
&#9;&#9;&#9;local dieplz = game.Players:findFirstChild(script.Parent.Parent.Name)
&#9;&#9;&#9;if dieplz.Character ~= nil then
&#9;&#9;&#9;&#9;local diechar = dieplz.Character
&#9;&#9;&#9;&#9;if diechar:findFirstChild(&quot;Head&quot;) ~= nil then
&#9;&#9;&#9;&#9;diechar.Head:remove()
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
