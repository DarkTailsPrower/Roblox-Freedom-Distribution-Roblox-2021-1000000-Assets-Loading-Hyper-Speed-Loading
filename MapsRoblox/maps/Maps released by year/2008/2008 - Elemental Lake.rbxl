						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">MoveScriptToPlayer</string>
						<ProtectedString name="Source">function onTouched(part)
&#9;if part.Parent ~= nil then
&#9;local humanoid = part.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;if humanoid and debounce==nil then
&#9;&#9;debounce = true
&#9;&#9;--script.Parent.Parent = nil
&#9;&#9;humanoid.Health = humanoid.Health -20
&#9;&#9;explosion = Instance.new(&quot;Explosion&quot;)
&#9;&#9;explosion.BlastRadius = 3
&#9;&#9;explosion.BlastPressure = 0
&#9;&#9;explosion.Position = part.Position
&#9;&#9;explosion.Parent = game.Workspace
&#9;&#9;wait(1)
&#9;&#9;debounce = nil
&#9;&#9;end
&#9;end
end
script.Parent.Touched:connect(onTouched)</ProtectedString>
					</Properties>
				</Item>
			</Item>
