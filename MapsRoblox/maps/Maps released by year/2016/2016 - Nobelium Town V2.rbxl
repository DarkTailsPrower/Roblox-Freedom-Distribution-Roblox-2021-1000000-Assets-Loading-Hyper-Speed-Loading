		<Item class="Script" referent="RBX1787">
			<Properties>
				<bool name="Archivable">true</bool>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Leaderboard</string>
				<ProtectedString name="Source">function onPlayerEntered(newPlayer)

	local model = Instance.new(&quot;Model&quot;)
	model.Name = &quot;Deleted_Bricks&quot;
	model.Parent = newPlayer

	local stats = Instance.new(&quot;IntValue&quot;)
	stats.Name = &quot;leaderstats&quot;
	
	local deletes = Instance.new(&quot;IntValue&quot;)
	deletes.Name = &quot;Deletes&quot;
	deletes.Value = 0
	deletes.Parent = stats

	stats.Parent = newPlayer

end



game.Players.ChildAdded:connect(onPlayerEntered)
--onPlayerEntered(game.Players.B0BBA)</ProtectedString>
			</Properties>
		</Item>
