					<Item class="Sound" referent="RBX6841">
						<Properties>
							<bool name="Looped">true</bool>
							<string name="Name">Swoosh</string>
							<float name="Pitch">1</float>
							<bool name="PlayOnRemove">false</bool>
							<Content name="SoundId"><url>http://api.xdiscuss.net/Asset/?id=37</url></Content>
							<float name="Volume">0.699999988</float>
						</Properties>
					</Item>
					<Item class="Sound" referent="RBX6842">
						<Properties>
							<bool name="Looped">false</bool>
							<string name="Name">Explosion</string>
							<float name="Pitch">1</float>
							<bool name="PlayOnRemove">true</bool>
							<Content name="SoundId"><url>rbxasset://sounds/collide.wav</url></Content>
