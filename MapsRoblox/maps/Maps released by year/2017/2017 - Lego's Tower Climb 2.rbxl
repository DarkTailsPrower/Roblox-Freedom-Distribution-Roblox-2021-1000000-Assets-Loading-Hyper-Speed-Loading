							<string name="Name">BombScript</string>
							<ProtectedString name="Source">b = game:service(&quot;RunService&quot;)

shaft = script.Parent
position = shaft.Position

function blow()
&#9;swoosh:stop()
&#9;explosion = Instance.new(&quot;Explosion&quot;)
