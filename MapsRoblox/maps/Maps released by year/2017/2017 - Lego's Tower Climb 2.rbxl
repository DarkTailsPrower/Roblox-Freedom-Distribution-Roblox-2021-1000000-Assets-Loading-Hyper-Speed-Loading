			<Item class="Script" referent="RBX6526">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">local debounce = false

function Teleportation(hit)
if hit.Parent:FindFirstChild(&quot;Torso&quot;)and not debounce and script.Parent:FindFirstChild(&quot;Teleport1&quot;)and script.Parent:FindFirstChild(&quot;Teleport2&quot;)then
debounce = true
hit.Parent.Torso.CFrame=CFrame.new(script.Parent.Teleport2.Position+Vector3.new(0,3,0))

wait(4)
debounce = false
end end

script.Parent.Teleport1.Touched:connect(Teleportation)</ProtectedString>
				</Properties>
			</Item>
		</Item>
