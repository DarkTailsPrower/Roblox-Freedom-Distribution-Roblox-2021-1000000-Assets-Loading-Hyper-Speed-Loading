							<string name="Name">Script</string>
							<ProtectedString name="Source">humanoid = nil

function onTouched(part)
&#9;if part.Parent ~= nil then
&#9;local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;&#9;if h~=nil then
&#9;&#9;&#9;if remoteisenabled~=0 then
&#9;&#9;&#9;&#9;if h==humanoid then
&#9;&#9;&#9;&#9;return
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;local tv=script.Parent.Parent:findFirstChild(&quot;TV&quot;)
&#9;&#9;&#9;&#9;if tv~=nil then
&#9;&#9;&#9;&#9;local channelno = tv.channelno.Value
&#9;&#9;&#9;&#9;tv.channelno.Value=channelno+1
&#9;&#9;&#9;&#9;remoteisenabled=0
&#9;&#9;&#9;&#9;wait(2)
&#9;&#9;&#9;&#9;remoteisenabled=1
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;print(&quot;could not find TV!&quot;)
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

script.Parent.Touched:connect(onTouched)</ProtectedString>
