			<Item class="Script" referent="RBX6832">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">PlaneFlyer12</string>
					<ProtectedString name="Source">bin=script.Parent
plane=nil
hold=false
local debounce = false
local planedebounce = false
local stuntdebounce = false
local controlling = false

function computeDirection(vec)
&#9;local lenSquared = vec.magnitude * vec.magnitude
&#9;local invSqrt = 1 / math.sqrt(lenSquared)
&#9;return Vector3.new(vec.x * invSqrt, vec.y * invSqrt, vec.z * invSqrt)
end

function move(target, engine, engine2, engine3, engine4)
&#9;local origincframe = engine:findFirstChild(&quot;BodyGyro&quot;).cframe
&#9;local dir = (target - engine.Position).unit
&#9;local spawnPos = engine.Position

&#9;local pos = spawnPos + (dir * 1)

&#9;local origincframe2 = engine2:findFirstChild(&quot;BodyGyro&quot;).cframe
&#9;local dir2 = (target - engine2.Position).unit
&#9;local spawnPos2 = engine2.Position

&#9;local pos2 = spawnPos2 + (dir2 * 1)

&#9;local origincframe3 = engine3:findFirstChild(&quot;BodyGyro&quot;).cframe
&#9;local dir3 = (target - engine3.Position).unit
&#9;local spawnPos3 = engine3.Position

&#9;local pos3 = spawnPos3 + (dir3 * 1)

&#9;local origincframe4 = engine4:findFirstChild(&quot;BodyGyro&quot;).cframe
&#9;local dir4 = (target - engine4.Position).unit
&#9;local spawnPos4 = engine4.Position

&#9;local pos4 = spawnPos4 + (dir4 * 1)

&#9;engine:findFirstChild(&quot;BodyGyro&quot;).maxTorque = Vector3.new(9000, 9000, 9000)
&#9;engine:findFirstChild(&quot;BodyGyro&quot;).cframe = CFrame.new(pos,  pos + dir)
&#9;engine2:findFirstChild(&quot;BodyGyro&quot;).maxTorque = Vector3.new(9000, 9000, 9000)
&#9;engine2:findFirstChild(&quot;BodyGyro&quot;).cframe = CFrame.new(pos2,  pos2 + dir2)
&#9;engine3:findFirstChild(&quot;BodyGyro&quot;).maxTorque = Vector3.new(9000, 9000, 9000)
&#9;engine3:findFirstChild(&quot;BodyGyro&quot;).cframe = CFrame.new(pos3,  pos3 + dir3)
&#9;engine4:findFirstChild(&quot;BodyGyro&quot;).maxTorque = Vector3.new(9000, 9000, 9000)
&#9;engine4:findFirstChild(&quot;BodyGyro&quot;).cframe = CFrame.new(pos4,  pos4 + dir4)
&#9;wait(0.1)
&#9;engine:findFirstChild(&quot;BodyGyro&quot;).maxTorque = Vector3.new(0, 0, 0)
&#9;engine:findFirstChild(&quot;BodyGyro&quot;).cframe = origincframe
&#9;engine2:findFirstChild(&quot;BodyGyro&quot;).maxTorque = Vector3.new(0, 0, 0)
&#9;engine2:findFirstChild(&quot;BodyGyro&quot;).cframe = origincframe2
&#9;engine3:findFirstChild(&quot;BodyGyro&quot;).maxTorque = Vector3.new(0, 0, 0)
&#9;engine3:findFirstChild(&quot;BodyGyro&quot;).cframe = origincframe3
&#9;engine4:findFirstChild(&quot;BodyGyro&quot;).maxTorque = Vector3.new(0, 0, 0)
&#9;engine4:findFirstChild(&quot;BodyGyro&quot;).cframe = origincframe4
end

function findPlane(player)
&#9;local list = player.Character:GetChildren()
&#9;for x = 1, #list do
&#9;&#9;if (list[x].Name == &quot;Nuke&quot;) then
&#9;&#9;&#9;local weld = list[x]:FindFirstChild(&quot;Parts&quot;):FindFirstChild(&quot;Seat&quot;):FindFirstChild(&quot;SeatWeld&quot;)
&#9;&#9;&#9;if (weld ~= nil) and (weld.Part1 == player.Character:FindFirstChild(&quot;Torso&quot;)) then
&#9;&#9;&#9;&#9;return list[x]
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;return nil
end

function onButton1Down(mouse)
&#9;local vehicle = findPlane(script.Parent.Parent.Parent)
&#9;if vehicle ~= nil and debounce == false and planedebounce == false then
&#9;debounce = true

&#9;controlling = true

&#9;while true do
&#9;&#9;wait()
&#9;&#9;local engine = vehicle.Parts.Engine
&#9;&#9;local engine2 = vehicle.BodyKit.Top
&#9;&#9;local engine3 = vehicle.BodyKit.Left
&#9;&#9;local engine4 = vehicle.BodyKit.Right
&#9;&#9;local position = mouse.Hit
&#9;&#9;local target = position.p
&#9;&#9;if engine:findFirstChild(&quot;FlyScript&quot;) ~= nil then
&#9;&#9;move(target, engine, engine2, engine3, engine4)
&#9;&#9;end
&#9;&#9;if planedebounce == true or
&#9;&#9;controlling == false then break end
&#9;end
&#9;wait(.1)
&#9;debounce = false
&#9;end
end

function onButton1Up(mouse)
&#9;controlling = false
end

function onSelected(mouse)
&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
&#9;mouse.Button1Up:connect(function() onButton1Up(mouse) end)
&#9;mouse.KeyDown:connect(onKeyDown)
end

function onKeyDown(key)
&#9;if (key~=nil) then
&#9;&#9;key = key:lower()
&#9;&#9;local vehicle = findPlane(script.Parent.Parent.Parent)
&#9;&#9;if (vehicle==nil) then return end
&#9;&#9;plane = vehicle.Parts
&#9;&#9;local engine = vehicle.Parts.Engine
&#9;&#9;local engine2 = vehicle.BodyKit.Top
&#9;&#9;local engine3 = vehicle.BodyKit.Left
&#9;&#9;local engine4 = vehicle.BodyKit.Right
&#9;&#9;&#9;if (key==&quot;z&quot;) and planedebounce == false then
&#9;&#9;&#9;&#9;planedebounce = true
&#9;&#9;&#9;&#9;explosion = Instance.new(&quot;Explosion&quot;)
&#9;&#9;&#9;&#9;explosion.Position = plane.Engine.Position
&#9;&#9;&#9;&#9;explosion.BlastRadius = 1000
&#9;&#9;&#9;&#9;explosion.BlastPressure = 10000000
&#9;&#9;&#9;&#9;explosion.Parent = game.Workspace
&#9;&#9;&#9;end
&#9;&#9;&#9;if (key==&quot;x&quot;) and planedebounce == false then
&#9;&#9;&#9;&#9;local power = plane.Engine:findFirstChild(&quot;FlyScript&quot;)
&#9;&#9;&#9;&#9;if (power ~= nil) then
&#9;&#9;&#9;&#9;power:remove()
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;local power2 = vehicle.BodyKit.Top:findFirstChild(&quot;FlyScript&quot;)
&#9;&#9;&#9;&#9;if (power2 ~= nil) then
&#9;&#9;&#9;&#9;power2:remove()
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;local power3 = vehicle.BodyKit.Left:findFirstChild(&quot;FlyScript&quot;)
&#9;&#9;&#9;&#9;if (power3 ~= nil) then
&#9;&#9;&#9;&#9;power3:remove()
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;local power4 = vehicle.BodyKit.Right:findFirstChild(&quot;FlyScript&quot;)
&#9;&#9;&#9;&#9;if (power4 ~= nil) then
&#9;&#9;&#9;&#9;power4:remove()
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;&#9;if (key==&quot;y&quot;) then
&#9;&#9;&#9;&#9;local power = plane.Engine:findFirstChild(&quot;FlyScript&quot;)
&#9;&#9;&#9;&#9;if (power ~= nil) then return end
&#9;&#9;&#9;&#9;local fly = script.FlyScript:clone()
&#9;&#9;&#9;&#9;fly.Disabled = false
&#9;&#9;&#9;&#9;fly.Parent = plane.Engine
&#9;&#9;&#9;&#9;local power2 = vehicle.BodyKit.Top:findFirstChild(&quot;FlyScript&quot;)
&#9;&#9;&#9;&#9;if (power2 ~= nil) then return end
&#9;&#9;&#9;&#9;local fly2 = script.FlyScript:clone()
&#9;&#9;&#9;&#9;fly2.Disabled = false
&#9;&#9;&#9;&#9;fly2.Parent = vehicle.BodyKit.Top
&#9;&#9;&#9;&#9;local power3 = vehicle.BodyKit.Left:findFirstChild(&quot;FlyScript&quot;)
&#9;&#9;&#9;&#9;if (power3 ~= nil) then return end
&#9;&#9;&#9;&#9;local fly3 = script.FlyScript:clone()
&#9;&#9;&#9;&#9;fly3.Disabled = false
&#9;&#9;&#9;&#9;fly3.Parent = vehicle.BodyKit.Left
&#9;&#9;&#9;&#9;local power4 = vehicle.BodyKit.Right:findFirstChild(&quot;FlyScript&quot;)
&#9;&#9;&#9;&#9;if (power4 ~= nil) then return end
&#9;&#9;&#9;&#9;local fly4 = script.FlyScript:clone()
&#9;&#9;&#9;&#9;fly4.Disabled = false
&#9;&#9;&#9;&#9;fly4.Parent = vehicle.BodyKit.Right
&#9;&#9;&#9;end
&#9;&#9;&#9;if (key==&quot;k&quot;) and planedebounce == false then
&#9;&#9;&#9;&#9;wait()
&#9;&#9;&#9;&#9;engine.RotVelocity = Vector3.new(0, engine.RotVelocity.y -0.2, 0)
&#9;&#9;&#9;&#9;engine2.RotVelocity = Vector3.new(0, engine2.RotVelocity.y -0.2, 0)
&#9;&#9;&#9;&#9;engine3.RotVelocity = Vector3.new(0, engine3.RotVelocity.y -0.2, 0)
&#9;&#9;&#9;&#9;engine4.RotVelocity = Vector3.new(0, engine4.RotVelocity.y -0.2, 0)
&#9;&#9;&#9;&#9;wait()
&#9;&#9;&#9;&#9;engine.RotVelocity = Vector3.new(0, engine.RotVelocity.y -0.2, 0)
&#9;&#9;&#9;&#9;engine2.RotVelocity = Vector3.new(0, engine2.RotVelocity.y -0.2, 0)
&#9;&#9;&#9;&#9;engine3.RotVelocity = Vector3.new(0, engine3.RotVelocity.y -0.2, 0)
&#9;&#9;&#9;&#9;engine4.RotVelocity = Vector3.new(0, engine4.RotVelocity.y -0.2, 0)
&#9;&#9;&#9;&#9;wait()
&#9;&#9;&#9;&#9;engine.RotVelocity = Vector3.new(0, engine.RotVelocity.y -0.2, 0)
&#9;&#9;&#9;&#9;engine2.RotVelocity = Vector3.new(0, engine2.RotVelocity.y -0.2, 0)
&#9;&#9;&#9;&#9;engine3.RotVelocity = Vector3.new(0, engine3.RotVelocity.y -0.2, 0)
&#9;&#9;&#9;&#9;engine4.RotVelocity = Vector3.new(0, engine4.RotVelocity.y -0.2, 0)
&#9;&#9;&#9;&#9;wait()
&#9;&#9;&#9;&#9;engine.RotVelocity = Vector3.new(0, engine.RotVelocity.y -0.2, 0)
&#9;&#9;&#9;&#9;engine2.RotVelocity = Vector3.new(0, engine2.RotVelocity.y -0.2, 0)
&#9;&#9;&#9;&#9;engine3.RotVelocity = Vector3.new(0, engine3.RotVelocity.y -0.2, 0)
&#9;&#9;&#9;&#9;engine4.RotVelocity = Vector3.new(0, engine4.RotVelocity.y -0.2, 0)
&#9;&#9;&#9;end
&#9;&#9;&#9;if (key==&quot;h&quot;) and planedebounce == false then
&#9;&#9;&#9;&#9;wait()
&#9;&#9;&#9;&#9;engine.RotVelocity = Vector3.new(0, engine.RotVelocity.y +0.2, 0)
&#9;&#9;&#9;&#9;engine2.RotVelocity = Vector3.new(0, engine2.RotVelocity.y +0.2, 0)
&#9;&#9;&#9;&#9;engine3.RotVelocity = Vector3.new(0, engine3.RotVelocity.y +0.2, 0)
&#9;&#9;&#9;&#9;engine4.RotVelocity = Vector3.new(0, engine4.RotVelocity.y +0.2, 0)
&#9;&#9;&#9;&#9;wait()
&#9;&#9;&#9;&#9;engine.RotVelocity = Vector3.new(0, engine.RotVelocity.y +0.2, 0)
&#9;&#9;&#9;&#9;engine2.RotVelocity = Vector3.new(0, engine2.RotVelocity.y +0.2, 0)
&#9;&#9;&#9;&#9;engine3.RotVelocity = Vector3.new(0, engine3.RotVelocity.y +0.2, 0)
&#9;&#9;&#9;&#9;engine4.RotVelocity = Vector3.new(0, engine4.RotVelocity.y +0.2, 0)
&#9;&#9;&#9;&#9;wait()
&#9;&#9;&#9;&#9;engine.RotVelocity = Vector3.new(0, engine.RotVelocity.y +0.2, 0)
&#9;&#9;&#9;&#9;engine2.RotVelocity = Vector3.new(0, engine2.RotVelocity.y +0.2, 0)
&#9;&#9;&#9;&#9;engine3.RotVelocity = Vector3.new(0, engine3.RotVelocity.y +0.2, 0)
&#9;&#9;&#9;&#9;engine4.RotVelocity = Vector3.new(0, engine4.RotVelocity.y +0.2, 0)
&#9;&#9;&#9;&#9;wait()
&#9;&#9;&#9;&#9;engine.RotVelocity = Vector3.new(0, engine.RotVelocity.y +0.2, 0)
&#9;&#9;&#9;&#9;engine2.RotVelocity = Vector3.new(0, engine2.RotVelocity.y +0.2, 0)
&#9;&#9;&#9;&#9;engine3.RotVelocity = Vector3.new(0, engine3.RotVelocity.y +0.2, 0)
&#9;&#9;&#9;&#9;engine4.RotVelocity = Vector3.new(0, engine4.RotVelocity.y +0.2, 0)
&#9;&#9;&#9;return end
&#9;&#9;&#9;if (key==&quot;j&quot;) and planedebounce == false then
&#9;&#9;&#9;&#9;local body = plane.Engine.BodyGyro
&#9;&#9;&#9;&#9;body.maxTorque = Vector3.new(9000, 9000, 9000)

&#9;&#9;&#9;&#9;local position = engine.CFrame * Vector3.new(0, 0.5, -4)
&#9;&#9;&#9;&#9;local dir = position - engine.Position

&#9;&#9;&#9;&#9;dir = computeDirection(dir)

&#9;&#9;&#9;&#9;local spawnPos = engine.Position

&#9;&#9;&#9;&#9;local pos = spawnPos + (dir * 8)

&#9;&#9;&#9;&#9;body.cframe = CFrame.new(pos,  pos + dir)
&#9;&#9;&#9;&#9;wait(.2)
&#9;&#9;&#9;&#9;body.maxTorque = Vector3.new(0, 0, 0)
&#9;&#9;&#9;end
&#9;&#9;&#9;if (key==&quot;l&quot;) and planedebounce == false then
&#9;&#9;&#9;&#9;local body = plane.Engine.BodyGyro
&#9;&#9;&#9;&#9;body.maxTorque = Vector3.new(9000, 0, 0)
&#9;&#9;&#9;&#9;local frame = plane:FindFirstChild(&quot;OriginCFrame&quot;)
&#9;&#9;&#9;&#9;if frame ~= nil then
&#9;&#9;&#9;&#9;&#9;body.cframe = frame.Value
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;wait(0.1)
&#9;&#9;&#9;&#9;body.maxTorque = Vector3.new(0, 0, 0)
&#9;&#9;&#9;end
&#9;&#9;&#9;if (key==&quot;u&quot;) and planedebounce == false then
&#9;&#9;&#9;&#9;local body = plane.Engine.BodyGyro
&#9;&#9;&#9;&#9;body.maxTorque = Vector3.new(9000, 9000, 9000)

&#9;&#9;&#9;&#9;local position = engine.CFrame * Vector3.new(0, -0.5, -4)
&#9;&#9;&#9;&#9;local dir = position - engine.Position

&#9;&#9;&#9;&#9;dir = computeDirection(dir)

&#9;&#9;&#9;&#9;local spawnPos = engine.Position

&#9;&#9;&#9;&#9;local pos = spawnPos + (dir * 8)

&#9;&#9;&#9;&#9;body.cframe = CFrame.new(pos,  pos + dir)
&#9;&#9;&#9;&#9;wait(.2)
&#9;&#9;&#9;&#9;body.maxTorque = Vector3.new(0, 0, 0)
&#9;&#9;&#9;end
&#9;end
end

bin.Selected:connect(onSelected)
</ProtectedString>
