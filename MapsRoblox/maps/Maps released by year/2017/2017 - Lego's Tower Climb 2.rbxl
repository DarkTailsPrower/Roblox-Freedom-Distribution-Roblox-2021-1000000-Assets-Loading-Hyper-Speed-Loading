local isgod = false
local c = player[i].Character:GetChildren()
for i=1,#c do
if c[i].className == &quot;Script&quot; then
if string.sub(c[i].Name,1,41) == &quot;script.Parent.Humanoid.MaxHealth = 999999&quot; then
c[i]:remove()
isgod = true
end end end
if isgod == true then
local c = player[i].Character:GetChildren()
