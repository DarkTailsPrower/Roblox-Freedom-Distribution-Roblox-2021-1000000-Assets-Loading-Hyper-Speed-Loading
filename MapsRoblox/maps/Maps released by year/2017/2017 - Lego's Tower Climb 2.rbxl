				<Item class="Script" referent="RBX6428">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">button regen script</string>
						<ProtectedString name="Source">model = game.Workspace.Plane128.Plane
messageText = &quot;Regenerating Plane&quot;

message = Instance.new(&quot;Message&quot;)
message.Text = messageText
backup = model:clone()
enabled = true

function regenerate()
&#9;message.Parent = game.Workspace
&#9;model:remove()

&#9;wait(1) -- display regen message for 4 seconds

&#9;model = backup:clone()
&#9;model.Parent = game.Workspace
&#9;model:makeJoints()
&#9;message.Parent = nil

&#9;enabled = false
&#9;wait(5)
&#9;enabled = true
end

function onHit(hit)
&#9;if (hit.Parent:FindFirstChild(&quot;Humanoid&quot;) ~= nil) and enabled then
&#9;&#9;regenerate()
&#9;end
end

script.Parent.Touched:connect(onHit)

</ProtectedString>
