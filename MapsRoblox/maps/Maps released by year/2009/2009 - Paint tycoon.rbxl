		<Item class="ScreenGui" referent="RBX7721">
			<Properties>
				<string name="Name">ForceFieldGUI</string>
			</Properties>
			<Item class="Script" referent="RBX7722">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">VIP</string>
					<ProtectedString name="Source">--Made by bubby4j

permission = {&quot;Player&quot;,&quot;CoolJulien&quot;,&quot;bobby884&quot;,&quot;jim36&quot;,&quot;forfun321&quot;,&quot;kratos413&quot;,&quot;tyler903&quot;,&quot;zx808&quot;,&quot;firepilot777&quot;,&quot;cdl81596&quot;,&quot;nap407&quot;,&quot;lantern2009&quot;,&quot;Jake711&quot;,&quot;nap407&quot;,&quot;blomb&quot;,&quot;toont&quot;,&quot;Precaution&quot;}

function checkOkToLetIn(name) 
&#9;for i = 1,#permission do 
&#9;&#9;if (string.upper(name) == string.upper(permission[i])) then return true end 
&#9;end 
&#9;return false 
end 

if (checkOkToLetIn(script.Parent.Parent.Parent.Name)) then 
