							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">function Click(mouse)
s = script.Parent.Parent.Parent:getChildren()
for i = 1, #s do

if s[i].className ~= &quot;Script&quot; then
if s[i].Name ~= &quot;usr&quot; then
s[i].Visible = true
script.Parent.Parent.Parent.plist.check.invisible.Value = false

if s[i].className == &quot;TextButton&quot; then

if s[i].Text == &quot;undefined&quot; then
s[i].Visible = false
end

end

end

end

end
script.Parent.Visible = false
script.Parent.Parent.TC.Visible = false
end

script.Parent.MouseButton1Down:connect(Click)</ProtectedString>
