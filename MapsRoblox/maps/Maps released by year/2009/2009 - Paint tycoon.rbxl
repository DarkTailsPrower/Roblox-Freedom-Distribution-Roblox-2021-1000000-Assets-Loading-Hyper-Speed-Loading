								<ProtectedString name="Source">function fire()
     local p = Instance.new(&quot;Part&quot;)
     p.Position = script.Parent.Position
     p.Size = Vector3.new(4,1,3)
     p.BrickColor = BrickColor.new(194)
     p.BottomSurface = 0
     p.TopSurface = 0
     p.Name = &quot;Blue&quot; --DO NOT CHANGE/REMOVE
     p.Parent = script.Parent
end 


while true do
     wait(14) --Alter Rate Of Drop
     fire()
end
</ProtectedString>
