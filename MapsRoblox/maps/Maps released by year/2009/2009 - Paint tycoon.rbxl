						<string name="Name">Script</string>
						<ProtectedString name="Source">function Money(click)
local stats = script.Parent.Parent.Parent.Parent.leaderstats --Goes To The Players Leaderstats Stuff
stats.Money.Value = stats.Money.Value +500 --Change &quot;Cash&quot; To Your Money Type And &quot;500&quot; To Amount
wait(1) --Waits 3 Seconds Before Can Be Used Again
end
script.Parent.MouseButton1Down:connect(Money)</ProtectedString>
