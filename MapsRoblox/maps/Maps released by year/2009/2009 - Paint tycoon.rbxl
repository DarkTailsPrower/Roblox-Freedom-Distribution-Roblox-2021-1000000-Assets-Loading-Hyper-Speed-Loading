			<Item class="Script" referent="RBX25">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Regen</string>
					<ProtectedString name="Source">model = script.Parent.Factory 
backup = model:clone() 

function Regen() 
model:remove() 
wait(1) 
model = backup:clone() 
model.Parent = script.Parent 
model:makeJoints() 
end 

while true do 
wait(1.5) 
if script.Parent.Factory.OwnerName.Value ~= &quot;&quot; then 
if not game.Players:FindFirstChild(script.Parent.Factory.OwnerName.Value) then
Regen() 

end 
end 
end </ProtectedString>
				</Properties>
			</Item>
			<Item class="Model" referent="RBX26">
				<Properties>
					<CoordinateFrame name="ModelInPrimary">
						<X>0</X>
						<Y>0</Y>
						<Z>0</Z>
						<R00>1</R00>
						<R01>0</R01>
						<R02>0</R02>
						<R10>0</R10>
						<R11>1</R11>
