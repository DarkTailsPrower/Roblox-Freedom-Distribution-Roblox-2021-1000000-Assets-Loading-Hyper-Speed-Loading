								<string name="Name">GetCash</string>
								<ProtectedString name="Source">function onTouched(part)
&#9;local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;if (h~=nil) then
&#9;&#9;local owner = script.Parent.Parent.Parent.OwnerName
&#9;&#9;if h.Parent.Name == owner.Value then --If the one who pressed the button is the owner then
&#9;&#9;&#9;local thisplr = game.Players:findFirstChild(h.Parent.Name)
&#9;&#9;&#9;if (thisplr~=nil) then
&#9;&#9;&#9;&#9;local stats = thisplr:findFirstChild(&quot;leaderstats&quot;)
&#9;&#9;&#9;&#9;if (stats~=nil) then
&#9;&#9;&#9;&#9;&#9;local score = stats:findFirstChild(&quot;Money&quot;)
&#9;&#9;&#9;&#9;&#9;if (score~=nil) then
&#9;&#9;&#9;&#9;&#9;&#9;score.Value = score.Value + script.Parent.Parent.Money.Value
&#9;&#9;&#9;&#9;&#9;&#9;script.Parent.Parent.Money.Value = 0
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

script.Parent.Touched:connect(onTouched)
