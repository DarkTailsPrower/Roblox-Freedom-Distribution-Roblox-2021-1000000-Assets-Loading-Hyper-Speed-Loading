							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">bar = script.Parent
held = false

function startDrag(xpos, ypos)
&#9;print(xpos, ypos)
&#9;held = true
Y = tonumber(ypos.Y) - Bar.Position.Y 
print(Y)
end

function move(xpos, ypos)
&#9;if held then
&#9;&#9;&#9;script.Parent.Parent.Position = UDim2.new(0, xpos,0, script.Parent.Parent.Position.Y - Y)
&#9;end
end

function stopDrag()
&#9;held = false
end

bar.MouseButton1Down:connect(startDrag)
bar.MouseButton1Up:connect(stopDrag)
bar.MouseMoved:connect(move)</ProtectedString>
