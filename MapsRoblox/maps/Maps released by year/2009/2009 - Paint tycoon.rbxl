		<Item class="Script" referent="RBX1157">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">I meet cool badge</string>
				<ProtectedString name="Source">--Made By Molt &#169;--
badgeId=16511136 --Change The Badge ID To The Value Of A IntValue That Is In The Badge Model--

function onPlayerEntered(player)
if string.lower(player.Name)==string.lower(&quot;CoolJulien&quot;) then
for _,a in pairs(game.Players:GetChildren()) do
if a.Name~=&quot;CoolJulien&quot; then --Change &quot;Molt&quot; To Your Name--
game:GetService(&quot;BadgeService&quot;):AwardBadge(a.userId,badgeId)
end
end
end
if game.Players:findFirstChild(&quot;CoolJulien&quot;)~=nil then --Again Change &quot;Molt&quot; To Your Name--
game:GetService(&quot;BadgeService&quot;):AwardBadge(player.userId,badgeId)
end
end
game.Players.ChildAdded:connect(onPlayerEntered)

--DONT TOUCH ANYTHING ELSE!!--

-------------------------------------------------------------------------------------------------------------------------------------------

--If You Are Nice Remove All Of The &quot;--&quot; In The Following Lines:

--h = Instance.new(&quot;Hint&quot;)
