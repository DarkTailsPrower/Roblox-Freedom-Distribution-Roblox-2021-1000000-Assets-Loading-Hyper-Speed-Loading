			<Item class="Script" referent="RBX7732">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">GetPlayers</string>
					<ProtectedString name="Source">wait(1)
p = game.Players:GetChildren()
for i = 1, #p do
local find = script.Parent.plist:findFirstChild(i)
if find ~= nil then
find.Text = p[i].Name
find.TextColor = p[i].TeamColor
end
end

function opa(pa)
p = game.Players:GetChildren()
for i = 1, #p do
local find = script.Parent.plist:findFirstChild(i)
if find ~= nil then
find.Text = p[i].Name
find.TextColor = p[i].TeamColor
end
end
end

function opr(pr)
p = game.Players:GetChildren()
for i = 1, #p do
local find = script.Parent.plist:findFirstChild(i)
if find ~= nil then
find.Text = p[i].Name
find.TextColor = p[i].TeamColor
end
end
end

game.Players.PlayerAdded:connect(opa)
game.Players.PlayerRemoving:connect(opr)</ProtectedString>
				</Properties>
