model = script.Parent.Parent.Parent.Grass    --This is the MODELNAME. you made a desk in the instructions SO name the part called MODELNAME to &quot;Desk&quot;. Then change price to what you want.
Upgradecost = 1500   --This is what you want it to cost. the Example costs 100 cash.
-------------------------------------------------------------------------------------------------------------------------
