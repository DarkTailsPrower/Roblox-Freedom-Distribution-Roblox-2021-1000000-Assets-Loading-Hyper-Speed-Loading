					<Item class="Script" referent="RBX1170">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Master Script</string>
							<ProtectedString name="Source">--This Script Checks If You Are Humanoid And If You Are It Will Add Money To You

---Nailer125 Industries--

--Anyone Can Use This Script :D

local ting = 0 --Debouncer

function onTouched(hit)

&#9;if ting == 0 then --Checks Debounce
&#9;ting = 1 --Activates Debounce
&#9;check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;) --Finds The Humaniod Who Toched The Button

&#9;if check ~= nil then --If It Finds A Humanoid Then...

&#9;&#9;local user = game.Players:GetPlayerFromCharacter(hit.Parent) --Gets The Player That Touched The Button
&#9;&#9;local stats = user:findFirstChild(&quot;leaderstats&quot;) --Finds The Player That Has The Money

&#9;&#9;if stats ~= nil then --If The Moneyholder Exists Then...
&#9;&#9;&#9;local cash = stats:findFirstChild(&quot;Money&quot;) --Give The Money
&#9;&#9;&#9;cash.Value  = cash.Value +500 --Adds The Amount Shown (350) To The Player/ You Can Change It To Any Amount.
&#9;&#9;&#9;wait(3) --This Is How Long It Takes The Button To Work Again!
&#9;&#9;end

&#9;end

&#9;ting = 0 --Removes The Debounce
&#9;end

end

script.Parent.Touched:connect(onTouched)

--NAILER125 INDUSTRIES &#169;2007-2008 ALL RIGHTS RESERVED.--
</ProtectedString>
