								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<ProtectedString name="Source">money = script.Parent.Parent.Money

function onTouched(hit)
&#9;if hit.Name == &quot;Red&quot; then
&#9;hit:remove()
&#9;money.Value = money.Value + 50
&#9;elseif hit.Name == &quot;Red1&quot; then
&#9;hit:remove()
&#9;money.Value = money.Value + 100
&#9;elseif hit.Name == &quot;Red2&quot; then
&#9;hit:remove()
&#9;money.Value = money.Value + 150
        elseif hit.Name == &quot;Red3&quot; then
&#9;hit:remove()
&#9;money.Value = money.Value + 200
&#9;elseif hit.Name == &quot;Blue&quot; then
&#9;hit:remove()
&#9;money.Value = money.Value + 250
        elseif hit.Name == &quot;Blue1&quot; then
&#9;hit:remove()
&#9;money.Value = money.Value + 300
        elseif hit.Name == &quot;Blue2&quot; then
&#9;hit:remove()
&#9;money.Value = money.Value + 350
        elseif hit.Name == &quot;Blue3&quot; then
&#9;hit:remove()
&#9;money.Value = money.Value + 400
        elseif hit.Name == &quot;Yellow&quot; then
&#9;hit:remove()
&#9;money.Value = money.Value + 450
        elseif hit.Name == &quot;Yellow1&quot; then
&#9;hit:remove()
&#9;money.Value = money.Value + 500
        elseif hit.Name == &quot;Yellow2&quot; then
&#9;hit:remove()
&#9;money.Value = money.Value + 550
        elseif hit.Name == &quot;Yellow3&quot; then
&#9;hit:remove()
&#9;money.Value = money.Value + 600
        elseif hit.Name == &quot;Green&quot; then
&#9;hit:remove()
&#9;money.Value = money.Value + 650
        elseif hit.Name == &quot;Green1&quot; then
&#9;hit:remove()
&#9;money.Value = money.Value + 700
        elseif hit.Name == &quot;Green2&quot; then
&#9;hit:remove()
&#9;money.Value = money.Value + 750
        elseif hit.Name == &quot;Green3&quot; then
&#9;hit:remove()
&#9;money.Value = money.Value + 800
&#9;end
end

script.Parent.Touched:connect(onTouched)</ProtectedString>
