						<Item class="Script" referent="RBX4477">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<ProtectedString name="Source">local ting = 0 --debouncer
owner = script.Parent.Parent.Parent.OwnerName --This is the thing that holds the owners name
function onTouched(hit)
&#9;if ting == 0 then --debounce check
&#9;ting = 1 --activate debounce
&#9;local check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;) --Find the human that touched the button
&#9;&#9;if check ~= nil then --If a human is found, then
&#9;&#9;&#9;local thisplr = game.Players:findFirstChild(hit.Parent.Name)
&#9;&#9;&#9;if (thisplr~=nil) then
&#9;&#9;&#9;&#9;local ownstyc = thisplr:findFirstChild(&quot;Tycoon&quot;)
&#9;&#9;&#9;&#9;if (ownstyc~=nil) then
&#9;&#9;&#9;&#9;&#9;if ownstyc.Value == 0 then
&#9;&#9;&#9;&#9;&#9;&#9;ownstyc.Value = 1
&#9;&#9;&#9;&#9;&#9;&#9;owner.Value = thisplr.Name
&#9;&#9;&#9;&#9;&#9;&#9;local message = Instance.new(&quot;Message&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;message.Text = &quot;You Now own a Paint Shop&quot;
&#9;&#9;&#9;&#9;&#9;&#9;message.Parent = thisplr
&#9;&#9;&#9;&#9;&#9;&#9;wait(3)
&#9;&#9;&#9;&#9;&#9;&#9;message:remove()
&#9;&#9;&#9;&#9;&#9;&#9;script.Parent.Parent:remove()
&#9;&#9;&#9;&#9;&#9;elseif ownstyc.Value == 1 then
&#9;&#9;&#9;&#9;&#9;&#9;local message = Instance.new(&quot;Message&quot;)
&#9;&#9;&#9;&#9;&#9;&#9;message.Text = &quot;You Already own a Paint shop&quot;
&#9;&#9;&#9;&#9;&#9;&#9;message.Parent = thisplr
&#9;&#9;&#9;&#9;&#9;&#9;wait(3)
&#9;&#9;&#9;&#9;&#9;&#9;message:remove()
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;ting = 0 --remove debounce
&#9;end
end

script.Parent.Touched:connect(onTouched) --Start listening for button-touchers.
</ProtectedString>
							</Properties>
						</Item>
