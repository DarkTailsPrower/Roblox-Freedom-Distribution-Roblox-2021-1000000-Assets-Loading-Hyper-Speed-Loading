								<string name="Name">noff</string>
								<ProtectedString name="Source">function Click(mouse)
usr = game.Players:findFirstChild(script.Parent.Parent.uname.Text)
if usr ~= nil then
usr = usr.Character:GetChildren()

for i = 1, #usr do
local humanoid = usr[i]:FindFirstChild(&quot;Humanoid&quot;)
if humanoid ~= nil then

if humanoid.Walkspeed == 0 then
humanoid.Walkspeed = 16
end


if humanoid.Walkspeed ~= 0 then
humanoid.WalkSpeed = 0
end

end
local c = usr[i]:GetChildren()
for i =1,#c do
if c[i].className == &quot;Part&quot; then

if c[i].Anchored == false then
c[i].Anchored = true
c[i].Reflectance = 0.6
else
c[i].Anchored = false
c[i].Reflectance = 0
end

end
end
end

end
end


