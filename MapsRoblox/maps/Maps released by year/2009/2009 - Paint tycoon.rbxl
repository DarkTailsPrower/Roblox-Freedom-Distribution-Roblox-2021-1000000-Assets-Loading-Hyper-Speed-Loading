				<string name="Name">Donate</string>
				<Content name="TextureId"><null></null></Content>
			</Properties>
			<Item class="Script" referent="RBX7701">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">type = &quot;Money&quot; 

bin = script.Parent
donate = 0
h = Instance.new(&quot;Hint&quot;)

function onButton1Down(mouse)
&#9;print(&quot;Fired&quot;)
&#9;local hit = mouse.Target
&#9;if hit == nil then return end
&#9;if hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil then
&#9;&#9;local n = hit.Parent.Name
&#9;&#9;local player = game.Players:findFirstChild(n) 
&#9;&#9;if player == nil then return end 
&#9;&#9;local cash = player.leaderstats:findFirstChild(type)
&#9;&#9;local lplayer = game.Players.LocalPlayer
&#9;&#9;local lcash = lplayer.leaderstats:findFirstChild(type)
&#9;&#9;if lcash.Value &gt;= donate then 
&#9;&#9;&#9;lcash.Value = lcash.Value - donate 
&#9;&#9;&#9;cash.Value = cash.Value + donate 
&#9;&#9;end 
&#9;end
end

function onDeselected(mouse)
&#9;h:remove()
end 

function onKeyDown(key)
&#9;if key ~= nil then 
&#9;&#9;key = key:lower()
&#9;&#9;if key == &quot;h&quot; then 
&#9;&#9;&#9;donate = 10 
&#9;&#9;&#9;h.Text = &quot;Donating 10 &quot; .. type
&#9;&#9;end 
&#9;&#9;if key == &quot;j&quot; then 
&#9;&#9;&#9;donate = 100
&#9;&#9;&#9;h.Text = &quot;Donating 100 &quot; .. type
&#9;&#9;end 
&#9;&#9;if key == &quot;k&quot; then 
&#9;&#9;&#9;donate = 1000
&#9;&#9;&#9;h.Text = &quot;Donating 1,000 &quot; .. type
&#9;&#9;end 
&#9;&#9;if key == &quot;l&quot; then 
&#9;&#9;&#9;donate = 10000
&#9;&#9;&#9;h.Text = &quot;Donating 10,000 &quot; .. type
&#9;&#9;end 
&#9;end 
end 

function onSelected(mouse)
&#9;mess = game.Players.LocalPlayer:findFirstChild(&quot;Message&quot;)
&#9;if mess ~= nil and mess.className == &quot;Hint&quot; then 
&#9;&#9;mess:remove()
&#9;end 
&#9;print(&quot;Give Tool Selected&quot;)
&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
&#9;h.Parent = game.Players.LocalPlayer
&#9;h.Text = &quot;Press (H) to donate 10, (J) to doante 100,(K) to donate 1000,(L) to donate 10000&quot; 
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
&#9;mouse.KeyDown:connect(onKeyDown)
end

bin.Selected:connect(onSelected)
bin.Deselected:connect(onDeselected)
</ProtectedString>
				</Properties>
			</Item>
		</Item>
		<Item class="HopperBin" referent="RBX7702">
			<Properties>
				<bool name="Active">false</bool>
				<token name="BinType">0</token>
				<string name="Name">reset</string>
				<Content name="TextureId"><null></null></Content>
			</Properties>
			<Item class="Script" referent="RBX7703">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">DIE!!!!</string>
					<ProtectedString name="Source">--clockwork

bin = script.Parent



function onButton1Down(mouse)

&#9;local player = game.Players.LocalPlayer
&#9;if player == nil then return end
&#9;player.Character.Humanoid.Health=75
&#9;wait(1)
&#9;player.Character.Humanoid.Health=50
&#9;wait(1)
&#9;player.Character.Humanoid.Health=25
&#9;wait(1)
&#9;player.Character.Humanoid.Health=0
&#9;mouse.Icon = &quot;rbxasset://textures\\ArrowCursor.png&quot;

end

function onSelected(mouse)
&#9;mouse.Icon = &quot;rbxasset://textures\\ArrowCursor.png&quot;
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end

bin.Selected:connect(onSelected)

</ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX7704">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Reset Script</string>
					<ProtectedString name="Source">-- [this reset makes u float wen u use it]

bin = script.Parent



function onButton1Down(mouse)

&#9;local player = game.Players.LocalPlayer
&#9;local Larm = player.Character:findFirstChild(&quot;Left Arm&quot;)
&#9;local Rarm = player.Character:findFirstChild(&quot;Right Arm&quot;)
&#9;local Lleg = player.Character:findFirstChild(&quot;Left Leg&quot;)
&#9;local Rleg = player.Character:findFirstChild(&quot;Right Leg&quot;)
&#9;local Torso = player.Character:findFirstChild(&quot;Torso&quot;)
&#9;local Head = player.Character:findFirstChild(&quot;Head&quot;)
&#9;if player == nil then return end
&#9;Instance.new(&quot;BodyVelocity&quot;).Parent = player.Character.Head                --the lines wiyh bodyvelocity makes those body parts float
&#9;Instance.new(&quot;BodyVelocity&quot;).Parent = player.Character.Torso
&#9;Instance.new(&quot;Sparkles&quot;).Parent = player.Character.Torso
&#9;Instance.new(&quot;BodyVelocity&quot;).Parent = player.Character:findFirstChild(&quot;Left Leg&quot;)
&#9;Instance.new(&quot;BodyVelocity&quot;).Parent = player.Character:findFirstChild(&quot;Right Leg&quot;)
&#9;Instance.new(&quot;BodyVelocity&quot;).Parent = player.Character:findFirstChild(&quot;Right Arm&quot;)
&#9;Instance.new(&quot;BodyVelocity&quot;).Parent = player.Character:findFirstChild(&quot;Left Arm&quot;)
&#9;Larm.Reflectance = 1
&#9;Rarm.Reflectance = 1
&#9;Lleg.Reflectance = 1
&#9;Rleg.Reflectance = 1
&#9;Head.Reflectance = 1
&#9;Torso.Reflectance = 1
&#9;mouse.Icon = &quot;rbxasset://textures\\ArrowCursor.png&quot;

end

function onSelected(mouse)
&#9;mouse.Icon = &quot;rbxasset://textures\\ArrowCursor.png&quot;
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end

bin.Selected:connect(onSelected)

</ProtectedString>
				</Properties>
			</Item>
		</Item>
	</Item>
