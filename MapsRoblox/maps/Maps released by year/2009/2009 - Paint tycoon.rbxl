						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">check</string>
						<ProtectedString name="Source">while true do
wait(1)
f = script.Parent:getChildren()
for i = 1, #f do
if f[i].className == &quot;TextButton&quot; then
if f[i].Name ~= &quot;slt&quot; then
if f[i].Name ~= &quot;close&quot; then
if f[i].Name ~= &quot;Open&quot; then
local check = game.Players:findFirstChild(f[i].Text)
if check == nil then
f[i].Visible = false
end
if check ~= nil then
if script.invisible.Value == false then
f[i].Visible = true
end
end
end
end
end
end
end
end
</ProtectedString>
