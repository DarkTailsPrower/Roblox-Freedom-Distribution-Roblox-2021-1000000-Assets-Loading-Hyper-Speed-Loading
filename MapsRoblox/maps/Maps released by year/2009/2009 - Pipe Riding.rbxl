&#9;local C0 = x.CFrame:inverse() *CJ 
&#9;local C1 = y.CFrame:inverse() * CJ 

&#9;weld.C0 = C0 
&#9;weld.C1 = C1 
&#9;
&#9;weld.Parent = x
end

function onTouched(part)
