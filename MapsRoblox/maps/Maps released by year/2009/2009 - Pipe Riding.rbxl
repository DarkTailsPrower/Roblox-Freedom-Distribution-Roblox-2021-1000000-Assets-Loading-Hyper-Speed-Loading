										<string name="Name">Random</string>
										<ProtectedString name="Source">local h = game.Workspace:FindFirstChild(&quot;Hint&quot;)

if h == nil then
&#9;local h = Instance.new(&quot;Hint&quot;)
&#9;h.Name = &quot;Hint&quot;
