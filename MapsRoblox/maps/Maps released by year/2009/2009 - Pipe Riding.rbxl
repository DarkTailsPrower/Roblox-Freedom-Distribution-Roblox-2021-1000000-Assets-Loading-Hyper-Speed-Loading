							<Item class="Script" referent="RBX901">
								<Properties>
									<bool name="Disabled">true</bool>
									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">Script</string>
									<ProtectedString name="Source">model = script.Parent.Parent.Parent
backup = model:clone()
local debounce = false

function onTouch(part)
&#9;if (part.Name == &quot;Safe&quot;) and (debounce == false) and (script.Parent.Count.Value == 0) then
&#9;debounce = true
&#9;wait(2)
&#9;model = backup:clone()
&#9;model.Parent = game.Workspace
&#9;model:makeJoints()
&#9;script.Parent.Count.Value = 1
&#9;debounce = false
&#9;end
end 
script.Parent.Touched:connect(onTouch)</ProtectedString>
								</Properties>
							</Item>
							<Item class="IntValue" referent="RBX902">
								<Properties>
									<string name="Name">Count</string>
									<int name="Value">0</int>
								</Properties>
							</Item>
							<Item class="BodyVelocity" referent="RBX903">
								<Properties>
									<string name="Name">Drift</string>
									<float name="P">1250</float>
									<Vector3 name="maxForce">
										<X>0</X>
										<Y>0</Y>
										<Z>0</Z>
									</Vector3>
									<Vector3 name="velocity">
										<X>0</X>
										<Y>0</Y>
										<Z>0</Z>
									</Vector3>
								</Properties>
