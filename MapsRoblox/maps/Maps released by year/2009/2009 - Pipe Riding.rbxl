				<string name="Name">Music Script</string>
				<ProtectedString name="Source">local s = Instance.new(&quot;Sound&quot;)

s.Name = &quot;Music&quot;
s.SoundId = &quot;http://www.roblox.com/asset/?id=27697735&quot;
s.Volume = 1
s.Pitch = 3
s.Looped = true
s.archivable = false

s.Parent = game.Workspace

wait(0.5)

s:play()

-- Made by blocklogan.</ProtectedString>
