				<Item class="Script" referent="RBX1055">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Activate</string>
						<ProtectedString name="Source">button = script.Parent
regen = button.Parent.Regen

local debounce = false

function onTouch(hit)
&#9;local h = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
&#9;if h ~= nil and debounce == false then
&#9;&#9;debounce = true
&#9;&#9;button.BrickColor = BrickColor.Black()
&#9;&#9;regen.Value = 1
&#9;&#9;wait()
&#9;&#9;regen.Value = 0
&#9;&#9;wait(7)
&#9;&#9;button.BrickColor = BrickColor.new(104)
&#9;&#9;debounce = false
&#9;end
end
button.Touched:connect(onTouch)</ProtectedString>
					</Properties>
				</Item>
			</Item>
			<Item class="IntValue" referent="RBX1056">
				<Properties>
					<string name="Name">Regen</string>
					<int name="Value">0</int>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX1057">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">RegenScript</string>
					<ProtectedString name="Source">system = script.Parent
model1 = system.Station1
backup1 = model1:Clone()
regen = system.Regen

function regenerate1(model,backup)
&#9;model:remove()
&#9;wait(1)
&#9;model1 = backup:Clone()
&#9;model1.Parent = system
&#9;model1:MakeJoints()
end

function checkRegen()
&#9;if regen.Value == 1 then
&#9;&#9;regenerate1(model1,backup1)
&#9;end
end
regen.Changed:connect(checkRegen)</ProtectedString>
				</Properties>
			</Item>
		</Item>
