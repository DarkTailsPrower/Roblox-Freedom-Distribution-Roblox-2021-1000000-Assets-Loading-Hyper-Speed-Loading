					<ProtectedString name="Source">enabled = true

function sit()

if not enabled then return end

enabled = false

script.Parent.Parent.Parent.Character.Humanoid.Sit = true

enabled = true

end

script.Parent.Selected:connect(sit)

</ProtectedString>
