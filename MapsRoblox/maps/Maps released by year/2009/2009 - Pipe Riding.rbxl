				<Item class="Script" referent="RBX99">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">function explode(part)

&#9;pos = part.Position
&#9;explosion = Instance.new(&quot;Explosion&quot;)
&#9;explosion.BlastRadius = 0
&#9;explosion.BlastPressure =0
&#9;explosion.Position = pos
&#9;explosion.Parent = game.Workspace
end



local ready = 1
button = script.Parent.Parent.Button
function onTouched(hit)
local h = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
        if (ready==1) and h~=nil then
        &#9;ready = 0
                button.Transparency = 1
&#9;&#9;local m = Instance.new(&quot;Message&quot;)
&#9;&#9;m.Parent = game.Workspace
&#9;&#9;m.Text = hit.Parent.Name.. &quot; Rode Through The Pipe!&quot;
&#9;&#9;wait(5)
&#9;&#9;explode(hit)
                h.Health = 0
&#9;&#9;m:remove()
                wait(10)
                button.Transparency = 1
        &#9;ready = 1
        end
end
script.Parent.Touched:connect(onTouched)</ProtectedString>
