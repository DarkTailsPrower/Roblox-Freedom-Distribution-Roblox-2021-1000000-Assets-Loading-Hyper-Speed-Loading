				<Item class="Script" referent="RBX604">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Activate</string>
						<ProtectedString name="Source">button = script.Parent
regen = button.Parent.HangarSystem.Regen -- Change HangarSystem to what you want to regen

local debounce = false

function onTouch(hit)
&#9;local h = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
&#9;if h ~= nil and debounce == false then
&#9;&#9;debounce = true
&#9;&#9;button.BrickColor = BrickColor.Black()
&#9;&#9;regen.Value = 1
&#9;&#9;wait()
&#9;&#9;regen.Value = 0
&#9;&#9;wait(2) -- How long you want to wait before you can push it again
&#9;&#9;button.BrickColor = BrickColor.new(104)
&#9;&#9;debounce = false
&#9;end
end
button.Touched:connect(onTouch)</ProtectedString>
					</Properties>
				</Item>
			</Item>
