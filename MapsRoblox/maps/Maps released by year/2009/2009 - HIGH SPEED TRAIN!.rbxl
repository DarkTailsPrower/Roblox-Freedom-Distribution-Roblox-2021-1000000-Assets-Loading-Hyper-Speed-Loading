						<Item class="Script" referent="RBX1006">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<string name="Source">local value = script.Parent.Closed

function close()
	local c = script.Parent.Parent:GetChildren()
	for i = 1, #c do
		local c2 = c[i]:GetChildren()
		for x = 1, #c2 do
			if c2[x].Name == &quot;Door&quot; then
				c2[x].Transparency = 0
				c2[x].CanCollide = true
			end
			if c2[x].Name == &quot;Door2&quot; then
				c2[x].Transparency = 1
				c2[x].CanCollide = true
			end
		end
	end
end

function open()
	local c = script.Parent.Parent:GetChildren()
	for i = 1, #c do
		local c2 = c[i]:GetChildren()
		for x = 1, #c2 do
			if c2[x].Name == &quot;Door&quot; then
				c2[x].Transparency = 0.1
				c2[x].CanCollide = false
			end
			if c2[x].Name == &quot;Door2&quot; then
				c2[x].Transparency = 1
				c2[x].CanCollide = false
			end
		end
	end
end

function onChanged(prop)
	if prop == &quot;Value&quot; then
		if value.Value == true then
			close()
		else
			open()
		end
	end
end

value.Changed:connect(onChanged)
