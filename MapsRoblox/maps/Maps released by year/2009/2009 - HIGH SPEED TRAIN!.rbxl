					<Item class="Script" referent="RBX1029">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<string name="Source">model = script.Parent.Parent.Train
backup = model:clone()

function onTouched(hit)
	local p = hit.Parent
	if p ~= nil then
		local h = p:FindFirstChild(&quot;Humanoid&quot;)
		if h ~= nil then
			if h.Health &gt; 0 then
				local pl = game.Players:GetPlayerFromCharacter(p)
				if pl ~= nil then
					local tc = pl.TeamColor
					if tc ~= script.Parent.Parent.Spawn.TeamColor then
						h.Health = 0
					end
				end
			end
		end
	end
end

script.Parent.Touched:connect(onTouched)
</string>
							<bool name="archivable">true</bool>
