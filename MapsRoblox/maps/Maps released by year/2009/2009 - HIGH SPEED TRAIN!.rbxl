				<Item class="Script" referent="RBX2918">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<string name="Source">state = script.Parent.State
local right = &quot;B2&quot;
local left = &quot;B1&quot;

function fix(n1, n2)
	local c = script.Parent.Parent:GetChildren()
	for i = 1, #c do
		if c[i].Name == n1 then
			c[i].Transparency = 0
			c[i].CanCollide = true
		end
		if c[i].Name == n2 then
			c[i].Transparency = 1
			c[i].CanCollide = false
		end
	end
end

function act()
	state.Value = not state.Value
	if state.Value == true then
		fix(right, left)
	else
		fix(left, right)
	end
end
		

script.Parent.B.Touched:connect(function(p) if p.Name == &quot;TrainFront&quot; then state.Value = false act() end end)
script.Parent.C.Touched:connect(function(p) if p.Name == &quot;TrainFront&quot; then state.Value = true act() end end)
script.Parent.Dir1.Touched:connect(function(p) if p.Name == &quot;TrainFront&quot; then script.Parent.Point.Value = 1 end end)
script.Parent.Dir2.Touched:connect(function(p) if p.Name == &quot;TrainFront&quot; then script.Parent.Point.Value = 2 end end)
script.Parent.Dir3.Touched:connect(function(p) if p.Name == &quot;TrainFront&quot; then if script.Parent.Point.Value == 2 then print(&quot;Change&quot;)  state.Value = p.Parent.Dir.Value  act() end script.Parent.Point.Value = 3 end end)
</string>
						<bool name="archivable">true</bool>
					</Properties>
