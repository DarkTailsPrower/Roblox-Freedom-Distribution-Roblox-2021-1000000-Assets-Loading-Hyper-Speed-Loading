							<Item class="Script" referent="RBX80">
								<Properties>
									<bool name="Disabled">false</bool>
									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">Script</string>
									<string name="Source">speed = 10
maxSpeed = 100

while true do
	wait(.1)
	maxSpeed = script.Parent.Parent.Speed.Value
	if script.Parent.Parent.ExtraBreak.Value == true then
		speed = 0
		script.Parent.Parent.Speed.Value = 0
		script.Parent.Parent.On.Value = false
		script.Parent.Parent.ExtraBreak.Value = false
		for i = 1, 20 do
			wait(.1)
			script.Parent.Velocity = Vector3.new(0, 0, 0)
		end
	end
	if script.Parent.Parent.On.Value == true then
		local lv = script.Parent.CFrame.lookVector * speed
		script.Parent.Velocity = Vector3.new(lv.x, script.Parent.Velocity.y, lv.z)
		if speed &lt; maxSpeed then
			if speed &gt; 1 then
				speed = speed + 20/speed
			else
				speed = maxSpeed
			end
			if speed &gt; maxSpeed then
				speed = maxSpeed
			end
			print(speed)
		end
		if maxSpeed &lt; speed then
			if speed &gt; 1 then
				speed = speed - 40/speed
			else
				speed = maxSpeed
			end
			if speed &lt; maxSpeed then
				speed = maxSpeed
			end
			print(speed)
		end
	else
		--speed = 0
	end
end
</string>
									<bool name="archivable">true</bool>
								</Properties>
							</Item>
						</Item>
