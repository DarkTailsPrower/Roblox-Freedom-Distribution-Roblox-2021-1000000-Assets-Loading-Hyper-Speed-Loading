								<Item class="Script" referent="RBX5155">
									<Properties>
										<bool name="Disabled">false</bool>
										<Content name="LinkedSource"><null></null></Content>
										<string name="Name">Script</string>
										<string name="Source">local seat = script.Parent
local vehicle = seat.Parent.Parent


function childAdded(child)
	if child.className ~= &quot;Weld&quot; or child.Name ~= &quot;SeatWeld&quot; then return end
	local torso = child.Part1
	if torso == nil then return end
	local character = torso.Parent
	if character == nil then return end
	local player = game.Players:GetPlayerFromCharacter(character)
	if player == nil then print(&quot;Character is a bot!&quot;) return end
	local value = character:FindFirstChild(&quot;SeatedVehicle&quot;)
	if value == nil then
		local v = Instance.new(&quot;ObjectValue&quot;)
		v.Name = &quot;SeatedVehicle&quot;
		v.Parent = character
		value = v
	end
	value.Value = vehicle
end

function childRemoved(child)
	if child.className ~= &quot;Weld&quot; or child.Name ~= &quot;SeatWeld&quot; then return end
	local torso = child.Part1
	if torso == nil then return end
	local character = torso.Parent
	if character == nil then return end
	local player = game.Players:GetPlayerFromCharacter(character)
	if player == nil then print(&quot;Character is a bot!&quot;) return end
	local value = character:FindFirstChild(&quot;SeatedVehicle&quot;)
	if value ~= nil then
		value.Value = nil
	end
	script.Parent.Parent.Parent.Closed.Value = false
	script.Parent.Parent.Parent.On.Value = false
	script.Parent.Parent.Parent.Speed.Value = 0
	script.Parent.Parent.Parent.ExtraBreak.Value = true
end

seat.ChildAdded:connect(childAdded)
seat.ChildRemoved:connect(childRemoved)
</string>
