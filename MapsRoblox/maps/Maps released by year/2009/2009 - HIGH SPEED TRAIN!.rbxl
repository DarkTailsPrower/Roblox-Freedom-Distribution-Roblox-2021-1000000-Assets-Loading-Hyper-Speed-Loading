				<Content name="TextureId"><null></null></Content>
				<bool name="archivable">true</bool>
			</Properties>
			<Item class="Script" referent="RBX5407">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<string name="Source">bin = script.Parent

function getVehicle(ch)
	local value = ch:FindFirstChild(&quot;SeatedVehicle&quot;)
	if value ~= nil then
		if value.Value ~= nil then
			return value.Value
		end
	end
end

function text(msg)
	local m = Instance.new(&quot;Hint&quot;)
	m.Text = msg
	m.Parent = script.Parent.Parent.Parent
	wait(2)
	m:remove()
end

function onKeyDown(key)
	if key ~= nil then
		key = key:lower()
		local player = script.Parent.Parent.Parent
		local character = player.Character
		if character ~= nil then
			local vehicle = getVehicle(character)
			if vehicle ~= nil then
				if vehicle.Type.Value == &quot;Train&quot; then
					if key == &quot;y&quot; then
						vehicle.On.Value = true
						text(&quot;Power: ON&quot;)
					end
					if key == &quot;x&quot; then
						vehicle.On.Value = false
						text(&quot;Power: OFF&quot;)
					end
					if key == &quot;b&quot; then
						vehicle.Speed.Value = 0
						text(&quot;Speed: &quot; .. vehicle.Speed.Value)
					end
					if key == &quot;n&quot; then
						vehicle.Speed.Value = vehicle.Speed.Value - 2
						text(&quot;Speed: &quot; .. vehicle.Speed.Value)
					end
					if key == &quot;m&quot; then
						vehicle.Speed.Value = vehicle.Speed.Value + 2
						text(&quot;Speed: &quot; .. vehicle.Speed.Value)
					end
					if key == &quot;e&quot; then
						vehicle.ExtraBreak.Value = true
						text(&quot;Stopped&quot;)
					end
					if key == &quot;c&quot; then
						if vehicle.Closed.Value == true then
							vehicle.Closed.Value = false
							text(&quot;Opened doors&quot;)
						else
							vehicle.Closed.Value = true
							text(&quot;Closed doors&quot;)
						end
					end
					if key == &quot;t&quot; then
						if vehicle.Dir.Value == true then
							vehicle.Dir.Value = false
							text(&quot;Swich Direction: Right&quot;)
						else
							vehicle.Dir.Value = true
							text(&quot;Swich Direction: Left&quot;)
						end
					end
				end
			end
		end
	end
end

function onSelected(mouse)
	mouse.KeyDown:connect(onKeyDown)
end

bin.Selected:connect(onSelected)
			
</string>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
			<Item class="LocalScript" referent="RBX5408">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Camera</string>
					<string name="Source">bin = script.Parent

function getVehicle(ch)
	local value = ch:FindFirstChild(&quot;SeatedVehicle&quot;)
	if value ~= nil then
		if value.Value ~= nil then
			return value.Value
		end
	end
end

function onKeyDown(key)
	if key ~= nil then
		key = key:lower()
		local player = script.Parent.Parent.Parent
		local character = player.Character
		if character ~= nil then
			local vehicle = getVehicle(character)
			if vehicle ~= nil then
				if vehicle.Type.Value == &quot;Train&quot; then
					if key == &quot;q&quot; then
						local cam = game.Workspace.CurrentCamera
						if cam.CameraSubject == vehicle then
							cam.CameraSubject = character.Humanoid
							cam.CameraType = 5
						else
							cam.CameraSubject = vehicle
							cam.CameraType = 4
						end
					end
				end
			end
		end
	end
end

function onSelected(mouse)
	mouse.KeyDown:connect(onKeyDown)
end

bin.Selected:connect(onSelected)
