							<string name="Name">Script</string>
							<string name="Source">model = script.Parent.Parent.Train
backup = model:clone()

deb = false

function onTouched(hit)
	local p = hit.Parent
	if p ~= nil then
		local h = p:FindFirstChild(&quot;Humanoid&quot;)
		if h ~= nil then
			if deb == true then return end
			deb = true
			model:remove()
			wait(1)
			model = backup:clone()
			model.Parent = script.Parent.Parent
			model:MakeJoints()
			wait(4)
			deb = false
		end
	end
end

script.Parent.Touched:connect(onTouched)
