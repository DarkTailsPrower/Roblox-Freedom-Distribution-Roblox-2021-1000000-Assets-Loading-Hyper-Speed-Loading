			<Item class="Script" referent="RBX9652">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">function Selected(mouse)
mouse.Button1Down:connect(function() onButton1Down(mouse) end)
mouse.Button1Up:connect(function() onButton1Up(mouse) end)
mouse.KeyDown:connect(onKeyDown)
mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
end

function onButton1Down(mouse)
enabled = true
repeat
script.Parent.Parent.Parent.Character.Torso.Velocity = Vector3.new(0,80,0)
wait()
until enabled == false
end

function onButton1Up(mouse)
enabled = false
end

function Deselected()
enabled = false
end


script.Parent.Selected:connect(Selected)
script.Parent.Deselected:connect(Deselected)
