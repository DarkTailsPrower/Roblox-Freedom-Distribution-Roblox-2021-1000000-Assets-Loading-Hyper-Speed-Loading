		<Item class="Script" referent="RBX9616">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">TeleportScript</string>
				<ProtectedString name="Source">low_gravity = true
locked_camera = false

local hatmass = 0

part = script.Parent.Parent.Character.Head

for i = 1, #part.Parent:getChildren() do
if part.Parent:getChildren()[i].className == &quot;Hat&quot; then
hatmass = part.Parent:getChildren()[i].Handle:getMass()
end
end

local torso = script.Parent.Parent.Character.Torso

-- the following values determine where the character will appear: 
local starter = Workspace.SpawnLocation
x = starter.Position.x
y = starter.Position.y + 7
z = starter.Position.z

local cf = torso.CFrame 
local lx = 0
local ly = y 
local lz = 0

torso.CFrame = CFrame.new(Vector3.new(x,y,z), Vector3.new(lx,ly,lz)) 

local bp = Instance.new(&quot;BodyPosition&quot;)
bp.Name = &quot;2D-Movement&quot;
bp.position = starter.Position
bp.P = 1000000
bp.D = 1000
bp.maxForce = Vector3.new(0, 0, 1000000) --this enables the 2D movement in the Z value (X,Y,Z)
bp.Parent = torso

if low_gravity == true then --This creates low-gravity if low gravity is enabled (see top)
local bf = Instance.new(&quot;BodyForce&quot;)
bf.force = Vector3.new(0, 60*(14+hatmass), 0)
bf.Parent = torso
end

local cam = Instance.new(&quot;Part&quot;) --The camera is a brick that follows you
cam.Name = (torso.Parent.Name..&quot;&apos;s Camera&quot;)
cam.CFrame = CFrame.new(torso.Position + Vector3.new(0, 5, 10), torso.Position)
cam.Transparency = 1 
cam.CanCollide = false
cam.Parent = Workspace
cam.size = Vector3.new(-1,-1,-1)
local bp = Instance.new(&quot;BodyPosition&quot;)
bp.maxForce = Vector3.new(1000000, 1000000, 1000000)
bp.Parent = cam
local bg = Instance.new(&quot;BodyGyro&quot;)
bg.maxTorque = Vector3.new(0, 0, 0)
bg.Parent = cam
local scr = script.CameraScript:Clone()
scr.Disabled = false
scr.Parent = torso.Parent
if locked_camera == true then --[[This locks the camera so players can&apos;t change it, it&apos;s automatic.
Only locks the camera if camera lock is enabled (see top)]]
local CamScr = script.CameraAngleScript:Clone()
CamScr.Name = &quot;CameraAngleScript&quot;
CamScr.Disabled = false
CamScr.Parent = torso.Parent
end
