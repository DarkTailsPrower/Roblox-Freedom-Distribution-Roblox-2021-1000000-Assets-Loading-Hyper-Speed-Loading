		<Item class="Script" referent="RBX4">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Script</string>
				<ProtectedString name="Source">--if game:findFirstChild(&quot;NetworkServer&quot;) == nil then return end
m = Instance.new(&quot;Message&quot;)
light = Workspace.Light_Rocks:getChildren()
heavy = Workspace.Heavy_Rocks:getChildren()
very_heavy = Workspace.Very_Heavy_Rocks:getChildren()
while true do
m.Text = &quot;Regenerating mine...&quot;
m.Parent = Workspace
wait(2)
x = game.Players:getChildren()
for i =1,#x do
if x[i].Character == nil then return end
if x[i].Character:findFirstChild(&quot;Torso&quot;) == nil then return end
x[i].Character.Torso.CFrame = (x[i].Character.Torso.CFrame - x[i].Character.Torso.Position) + Vector3.new(x[i].Character.Torso.Position.x,(Workspace.SpawnLocation.Position.y + 6),x[i].Character.Torso.Position.z)
end
wait(0.1)
for l = 1,#light do
if light[l].Transparency ~= 0 then light[l].Transparency = 0 end
if light[l].Reflectance ~= 0 then light[l].Reflectance = 0 end
if light[l].CanCollide ~= true then light[l].CanCollide = true end
if light[l].BrickColor ~= BrickColor.new(&quot;Medium stone grey&quot;) then light[l].BrickColor = BrickColor.new(&quot;Medium stone grey&quot;) end
end
wait(0.1)
for h = 1,#heavy do
if heavy[h].Transparency ~= 0 then heavy[h].Transparency = 0 end
if heavy[h].Reflectance ~= 0 then heavy[h].Reflectance = 0 end
if heavy[h].CanCollide ~= true then heavy[h].CanCollide = true end
if heavy[h].BrickColor ~= BrickColor.new(&quot;Dark stone grey&quot;) then heavy[h].BrickColor = BrickColor.new(&quot;Dark stone grey&quot;) end
end
wait(0.1)
for vh = 1,#very_heavy do
if very_heavy[vh].Transparency ~= 0 then very_heavy[vh].Transparency = 0 end
if very_heavy[vh].Reflectance ~= 0 then very_heavy[vh].Reflectance = 0 end
if very_heavy[vh].CanCollide ~= true then very_heavy[vh].CanCollide = true end
if very_heavy[vh].BrickColor ~= BrickColor.new(&quot;Really black&quot;) then very_heavy[vh].BrickColor = BrickColor.new(&quot;Really black&quot;) end
end
wait(0.1)
for l = 1,#light do
if math.random(1,10) == 1 then
light[l].BrickColor = BrickColor.new(&quot;Light stone grey&quot;) --Tin 100
end
end
wait(0.1)
for l = 1,#light do
if math.random(1,25) == 1 then
light[l].BrickColor = BrickColor.new(&quot;Bright orange&quot;) --Copper 150
end
end
wait(0.1)
for l = 1,#light do
if math.random(1,75) == 1 then
light[l].BrickColor = BrickColor.new(&quot;Black&quot;) --Coal 250
end
end
wait(0.1)
for h = 1,#heavy do
if math.random(1,25) == 1 then
heavy[h].BrickColor = BrickColor.new(&quot;Black&quot;) --Coal 250
end
end
wait(0.1)
for h = 1,#heavy do
if math.random(1,50) == 1 then
heavy[h].BrickColor = BrickColor.new(&quot;New Yeller&quot;) --Gold 500
end
end
wait(0.1)
for h = 1,#heavy do
if math.random(1,75) == 1 then
heavy[h].BrickColor = BrickColor.new(&quot;Light stone grey&quot;) --Tin 100
end
end
wait(0.1)
for h = 1,#heavy do
if math.random(1,75) == 1 then
heavy[h].BrickColor = BrickColor.new(&quot;Bright orange&quot;) --Copper 150
end
end
wait(0.1)
for h = 1,#heavy do
if math.random(1,100) == 1 then
heavy[h].BrickColor = BrickColor.new(&quot;Grime&quot;) --Diamond 1000
heavy[h].Reflectance = 1
end
end
wait(0.1)
for vh = 1,#very_heavy do
if math.random(1,10) == 1 then
very_heavy[vh].BrickColor = BrickColor.new(&quot;New Yeller&quot;) --Gold 500
end
end
wait(0.1)
for vh = 1,#very_heavy do
if math.random(1,50) == 1 then
very_heavy[vh].BrickColor = BrickColor.new(&quot;Brick yellow&quot;) --Deep Diamond 5000
very_heavy[vh].Reflectance = 1
end
end


m.Parent = nil
wait(2340)
m.Text = &quot;Regenerating Mine in 1 Minute&quot;
m.Parent = Workspace
wait(2)
m.Parent = nil
wait(58)
end
</ProtectedString>
			</Properties>
