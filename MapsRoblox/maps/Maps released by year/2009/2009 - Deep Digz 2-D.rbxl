					<ProtectedString name="Source">enabled = true
m = Instance.new(&quot;Message&quot;)
m.Text = &quot;You are too far away!&quot;
function Selected(mouse)
print(&quot;Selected&quot;)
mouse.Button1Down:connect(function() onButton1Down(mouse) end)
--mouse.Button1Up:connect(function() onButton1Up(mouse) end)
mouse.KeyDown:connect(onKeyDown)
mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
end

function onKeyDown(key)
print(key..&quot; key hit!&quot;) --Cannot detect the I or O keys
end

function onButton1Down(mouse)
local ore = mouse.Target
if enabled == false then return end
if ore == nil then return end
if ore.Name ~= &quot;Part&quot; then return end
if ore.Transparency ~= 0 then return end
enabled = false
mouse.Icon = &quot;rbxasset://textures\\GunWaitCursor.png&quot;
if (script.Parent.Parent.Parent.Character.Torso.Position - ore.Position).magnitude &lt;= 12 then
if ore.BrickColor == BrickColor.new(&quot;Medium stone grey&quot;) then Value = 0 end
if ore.BrickColor == BrickColor.new(&quot;Dark stone grey&quot;) then Value = 0 end
if ore.BrickColor == BrickColor.new(&quot;Really black&quot;) then Value = 0 end
if ore.BrickColor == BrickColor.new(&quot;Light stone grey&quot;) then Value = 100 end
if ore.BrickColor == BrickColor.new(&quot;Bright orange&quot;) then Value = 150 end
if ore.BrickColor == BrickColor.new(&quot;Black&quot;) then Value = 250 end
if ore.BrickColor == BrickColor.new(&quot;New Yeller&quot;) then Value = 500 end
if ore.BrickColor == BrickColor.new(&quot;Grime&quot;) then Value = 1000 end
if ore.BrickColor == BrickColor.new(&quot;Brick yellow&quot;) then Value = 5000 end
script.Parent.Parent.Parent.leaderstats.Money.Value = script.Parent.Parent.Parent.leaderstats.Money.Value + Value
trans = 0.1

if ore.BrickColor == BrickColor.new(&quot;Medium stone grey&quot;) then 
for i = 1,10 do
ore.Transparency = trans
wait(0.1/2)
trans = trans + 0.1
end
end

if ore.BrickColor == BrickColor.new(&quot;Dark stone grey&quot;) then 
for i = 1,10 do
ore.Transparency = trans
wait(0.2/2)
trans = trans + 0.1
end
end

if ore.BrickColor == BrickColor.new(&quot;Really black&quot;) then 
for i = 1,10 do
ore.Transparency = trans
wait(0.5/2)
trans = trans + 0.1
end
end

if ((ore.BrickColor ~= BrickColor.new(&quot;Medium stone grey&quot;)) and (ore.BrickColor ~= BrickColor.new(&quot;Dark stone grey&quot;)) and (ore.BrickColor ~= BrickColor.new(&quot;Really black&quot;))) then
for i = 1,10 do
ore.Transparency = trans
wait(0.1/2)
trans = trans + 0.1
end
end

ore.CanCollide = false
else
m.Parent = script.Parent.Parent.Parent
wait(1)
end
mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
enabled = true
m.Parent = nil
end

--[[function onButton1Up(mouse)
print(&quot;Mouse UnClicked&quot;)--Is unclicked even a word?
end]]

function Deselected()
print(&quot;DeSelected&quot;)
end


script.Parent.Selected:connect(Selected)
script.Parent.Deselected:connect(Deselected)
