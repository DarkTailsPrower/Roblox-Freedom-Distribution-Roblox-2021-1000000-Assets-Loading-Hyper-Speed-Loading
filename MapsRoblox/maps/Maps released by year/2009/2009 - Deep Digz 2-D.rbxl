game.Workspace.CurrentCamera.Focus = CFrame.new(-153.009827, 651.746826, -43.0011063, 1, 1.35246566e-015, -4.50836357e-016, -1.00806185e-015, 0.89442718, 0.44721359, 1.00808123e-015, -0.44721359, 0.89442718)
