				<Item class="Script" referent="RBX3214">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">function OnTouched(hit)
if game.Players:findFirstChild(hit.Parent.Name) == nil then return end
local player =  game.Players[hit.Parent.Name]
if player.Tools:findFirstChild(script.Parent.Tool.Value) ~= nil then return end
if player.leaderstats.Money.Value &lt; script.Parent.Cost.Value then return end
player.leaderstats.Money.Value = player.leaderstats.Money.Value - script.Parent.Cost.Value
game.Lighting[script.Parent.Tool.Value]:Clone().Parent = player.Tools
game.Lighting[script.Parent.Tool.Value]:Clone().Parent = player.Backpack
end
script.Parent.Head.Touched:connect(OnTouched)</ProtectedString>
					</Properties>
				</Item>
