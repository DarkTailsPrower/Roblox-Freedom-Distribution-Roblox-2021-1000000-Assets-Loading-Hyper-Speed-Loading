					<string name="Name">CameraScript</string>
					<ProtectedString name="Source">local player = game.Players.LocalPlayer
local camera = Workspace[script.Parent.Name..&quot;&apos;s Camera&quot;]
local cam = game.Workspace.CurrentCamera
cam.CameraSubject = camera
cam.CameraType = &quot;Attach&quot;

function OnDied()
camera:Remove()
end
script.Parent.Humanoid.Died:connect(OnDied)

while true do
camera.BodyPosition.position = player.Character.Torso.Position + Vector3.new(0, 0, 10)
camera.BodyGyro.cframe = CFrame.new(camera.Position, player.Character.Torso.Position)
wait()
end
