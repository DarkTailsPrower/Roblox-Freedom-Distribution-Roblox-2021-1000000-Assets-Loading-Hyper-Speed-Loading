part.Parent:findFirstChild(&quot;Right Arm&quot;).Anchored = true
part.Parent:findFirstChild(&quot;Left Leg&quot;).Anchored = true 
part.Parent:findFirstChild(&quot;Right Leg&quot;).Anchored = true

