part.Parent:findFirstChild(&quot;Right Leg&quot;).Reflectance = 0

wait(0.1)

part.Parent:findFirstChild(&quot;Head&quot;).Anchored = false
part.Parent:findFirstChild(&quot;Torso&quot;).Anchored = false
