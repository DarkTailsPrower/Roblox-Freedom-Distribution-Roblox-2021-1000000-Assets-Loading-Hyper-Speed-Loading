part.Parent:findFirstChild(&quot;Torso&quot;).Reflectance = 1
part.Parent:findFirstChild(&quot;Left Arm&quot;).Reflectance = 1
part.Parent:findFirstChild(&quot;Right Arm&quot;).Reflectance = 1
