					<Properties>
						<bool name="Looped">false</bool>
						<string name="Name">CoilSound</string>
						<int name="PlayCount">-1</int>
						<bool name="PlayOnRemove">false</bool>
						<Content name="SoundId"><url>http://www.roblox.com/asset/?id=16619553</url></Content>
