						<string name="Source">Tool = script.Parent
iv=150
pbs=script.Parent.Paintball
reloadtime=.5
wait(.2)
gren=false
nadeloaded=true
while script.Parent.Parent:findFirstChild(&quot;Humanoid&quot;)==nil do wait(1) end
if game.Players:findFirstChild(Tool.Parent.Name)~=nil then
	local jill=game.Players:findFirstChild(Tool.Parent.Name)
