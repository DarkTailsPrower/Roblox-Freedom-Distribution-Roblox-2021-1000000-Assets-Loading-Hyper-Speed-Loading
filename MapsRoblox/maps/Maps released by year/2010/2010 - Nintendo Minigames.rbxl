						<Item class="Script" referent="RBX5346">
							<Properties>
								<bool name="Disabled">true</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Stun</string>
								<string name="Source">bg = Instance.new(&quot;BodyGyro&quot;)
bg.Parent = script.Parent.Torso
bg.maxTorque = Vector3.new(1000000000,0,1000000000)
bg.cframe = script.Parent.Torso.CFrame * CFrame.fromEulerAnglesXYZ(3.14/2,0,3.14/2)
print(&quot;Zap&quot;)
wait(.5)
bg:remove()
script:remove()</string>
								<bool name="archivable">true</bool>
