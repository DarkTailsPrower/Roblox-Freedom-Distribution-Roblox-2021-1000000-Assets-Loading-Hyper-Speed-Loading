					<Item class="Script" referent="RBX3362">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<string name="Source">local s = script.Clicky

local things = script.Parent:GetChildren()
for i=1,#things do
	if things[i].className == &quot;Part&quot; then
		if things[i]:findFirstChild(&quot;ClickDetector&quot;) ~= nil then
			local c = s:clone()
			c.Disabled = false
			c.Parent = things[i]
			end
		end
	end
</string>
							<bool name="archivable">true</bool>
						</Properties>
						<Item class="Script" referent="RBX3363">
							<Properties>
								<bool name="Disabled">true</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Clicky</string>
								<string name="Source">original = script.Parent.BrickColor
debounce = false
enabled = script.Parent.Parent.Enabled

function onClick()
	if enabled.Value == false and debounce == false then
		debounce = true
		enabled.Value = true
		m = Instance.new(&quot;Message&quot;)
		m.Parent = game.Workspace
		m.Text = script.Parent.Name .. &quot;&apos; will be crunched.&quot;
		wait(2)
		m:remove()
		enabled.Value = false
		script.Parent.BrickColor = BrickColor.new(26)
		things = script.Parent.Parent.Parent:GetChildren()
		for i=1,#things do
			if things[i].className == &quot;Part&quot; then
			if things[i].BrickColor == original and things[i].Name == &quot;Spawn&quot; then
				t = things[i]:clone()
				t.Parent = game.Workspace
				t.BrickColor = BrickColor.new(1)
				t.Anchored = false
				t.Position = things[i].Position + Vector3.new(0,120,0)
				local bg = Instance.new(&quot;BodyGyro&quot;)
				bg.Parent = t
				bg.cframe = t.CFrame
				bg.maxTorque = Vector3.new(10000000,10000000,10000000)
				local bp = Instance.new(&quot;BodyPosition&quot;)
				bp.Parent = t
				bp.position = things[i].Position
				bp.maxForce = Vector3.new(10000000,0,10000000)
				local bf = Instance.new(&quot;BodyForce&quot;)
				bf.Parent = t
				bf.force = Vector3.new(0,-100,0)
				local s = script.Die:clone()
				s.Disabled = false
				s.Parent = t
				end
				end
			end
			wait(3)
			script.Parent.BrickColor = original
			debounce = false
		end
	end

script.Parent.ClickDetector.MouseClick:connect(onClick)</string>
								<bool name="archivable">true</bool>
							</Properties>
							<Item class="Script" referent="RBX3364">
								<Properties>
									<bool name="Disabled">true</bool>
									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">Die</string>
									<string name="Source">function onTouch(part)
	h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
	if h ~= nil then
		h.Health = 0
		end
	end

script.Parent.Touched:connect(onTouch)

wait(5)

script.Parent:remove()</string>
									<bool name="archivable">true</bool>
								</Properties>
