				<Item class="Script" referent="RBX8012">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">GameScript</string>
						<string name="Source">function TeleTo(character, destination) --I hate how moveTo(someplace) is unreliable!!!
	torso = character:findFirstChild(&quot;Torso&quot;)
	if torso then
		while true do
		if character == nil then break end
		character:moveTo(destination)
		wait()
		torso = character:findFirstChild(&quot;Torso&quot;)
		if character:findFirstChild(&quot;Torso&quot;) == nil then break end
		print((torso.Position - destination).magnitude)
		if (torso.Position - destination).magnitude &lt; 15 then break end
		end
	end
	end

function onTouch(part)
	if part.Parent ~= nil then
	h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
	if h ~= nil then
		h.Health = 0
		end
		end
	end
script.Parent.Lava.Touched:connect(onTouch)


wait(8)

playing = {}
p = game.Players:GetChildren()
for i=1,#p do
	if p[i].Character ~= nil then 
	if p[i].Character:findFirstChild(&quot;Playing&quot;) ~= nil then
	--if p[i].Character:findFirstChild(&quot;Humanoid&quot;) then
		--p[i].Character.Humanoid.WalkSpeed = 30
		--end
	table.insert(playing, p[i])
	end
	end
	end

while seeker == nil do
	num = math.random(1,#playing)
	seeker = playing[num]
	print(seeker.Name)
	wait()
	end

local char = seeker.Character
print(seeker.Name)
game.Workspace.Controller.Value = seeker

m = Instance.new(&quot;Message&quot;)
m.Parent = game.Workspace
m.Text = &quot;The controller is &quot; .. seeker.Name .. &quot;!&quot;
TeleTo(char, script.Parent.Boss.Position)
if char:findFirstChild(&quot;Humanoid&quot;) then
	char.Humanoid.WalkSpeed = 0
	end

wait(3)
m:remove()</string>
						<bool name="archivable">true</bool>
