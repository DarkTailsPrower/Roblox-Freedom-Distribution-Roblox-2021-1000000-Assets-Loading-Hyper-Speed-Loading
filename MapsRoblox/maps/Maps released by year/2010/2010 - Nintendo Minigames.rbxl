							<string name="Name">face b gone</string>
							<string name="Source">function onTouched(hit)
local head = hit.Parent:findFirstChild(&quot;Head&quot;)
if head ~= nil then
local face = head:findFirstChild(&quot;face&quot;)
if face ~= nil then
head.face.Texture = &quot;qw3rtyg1y54y5th1515th3f4c3&quot;
end
end
end

