								<X>1</X>
								<Y>1</Y>
								<Z>1</Z>
							</Vector3>
							<Content name="TextureId"><url>rbxasset://textures/bombtex.png</url></Content>
							<Vector3 name="VertexColor">
								<X>1</X>
