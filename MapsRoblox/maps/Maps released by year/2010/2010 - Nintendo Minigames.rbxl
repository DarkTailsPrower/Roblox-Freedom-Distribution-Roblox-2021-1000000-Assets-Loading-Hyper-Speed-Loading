				<Item class="Script" referent="RBX7969">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">GameScript</string>
						<string name="Source">--[[for i=1,20 do
	p = Instance.new(&quot;Part&quot;)
	p.Parent = script.Parent
	p.Size = Vector3.new(math.random(15,25),math.random(15,25),math.random(15,25))
	p.Anchored = true
	p.BrickColor = BrickColor.new(1)
	x = math.random(0,314)*.1
	y = math.random(0,314)*.1
	z = math.random(0,314)*.1
	p.CFrame = script.Parent.Spawn.CFrame * CFrame.new(math.random(-150,150),0,math.random(-150,150)) * CFrame.fromEulerAnglesXYZ(x,y,z)
	end]]

wait(7)
--print(&quot;Go&quot;)
bav = script.Parent.Crate.BodyAngularVelocity
bav.angularvelocity = Vector3.new(0,0,0)

while true do
	x = math.random(0,2)
	y = math.random(0,2)
	z = math.random(0,2)
	bav.angularvelocity = Vector3.new(x,y,z)
	wait(6)
	end
</string>
						<bool name="archivable">true</bool>
					</Properties>
