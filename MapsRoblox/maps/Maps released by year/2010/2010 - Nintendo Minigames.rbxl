						<string name="Name">Hurt</string>
						<string name="Source">--[[--[[--[[*ICE128*]]--]]--]]--
-- Thanks to clockwork for making the original falcon punch :)

Arm = script.Parent
Torso = script.Parent.Parent.Torso

function boom(arm)
	--[[E = Instance.new(&quot;Explosion&quot;)
	E.Parent = arm
	E.Position = arm.Position
	E.BlastRadius = 1
	E.BlastPressure = 0]]
end

function onTouched(part)
	if part.Parent then
	if (part.Parent.Name ~= &quot;&quot;) then
		if (part.Parent.className == &quot;Model&quot;) then
			a = part.Parent:GetChildren()
			if part.Parent:findFirstChild(&quot;Humanoid&quot;) == nil then return end
			if part.Parent:findFirstChild(&quot;Key&quot;) ~= nil then
				part.Parent.Key.Parent = game.Workspace[&quot;Locked Out&quot;]
				part.Parent.Key.Attached = false
				end
			for i=1, #a do
				if (a[i].className == &quot;Humanoid&quot;) then
					part.Velocity = Torso.CFrame.lookVector * 100
					end
				end
			end
		end
		--[[if (part.Anchored == false) then
			if (part.CanCollide == false) then
				part.CanCollide = true
				part:breakJoints()
				wait()
				boom(Arm)
				part.Velocity = Torso.CFrame.lookVector * 50
				wait()
				part.CanCollide = false
			end
			if (part.CanCollide == true) then
				part:breakJoints()
				wait()
				boom(Arm)
				part.Velocity = Torso.CFrame.lookVector *800
			end]]
		end
	end


Arm.Touched:connect(onTouched)</string>
