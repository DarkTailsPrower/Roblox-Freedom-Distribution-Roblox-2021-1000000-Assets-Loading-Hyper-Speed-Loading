			<Item class="Script" referent="RBX1314">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">CannonBall</string>
					<string name="Source">ball = script.Parent
damage = 0

r = game:service(&quot;RunService&quot;)

last_sound_time = r.Stepped:wait()

function onTouched(part)

	local now = r.Stepped:wait()

	if (now - last_sound_time &gt; .1) then
		ball.Boing:play()
		last_sound_time = now
	else
		return
	end

	local humanoid = part.Parent:findFirstChild(&quot;Humanoid&quot;)
	if humanoid~=nil then
		tagHumanoid(humanoid)
		humanoid:TakeDamage(damage)
		h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
		if h ~= nil and h.Parent:findFirstChild(&quot;Stun&quot;) == nil then
			s = script.Stun:clone()
			s.Disabled = false
			s.Parent = h.Parent
			end
		wait(2)
		untagHumanoid(humanoid)
		connection:disconnect()
	else
		damage = damage / 2
		if damage &lt; 2 then
			connection:disconnect()
		end
	end
end



function tagHumanoid(humanoid)
	-- todo: make tag expire
	local tag = ball:findFirstChild(&quot;creator&quot;)
	if tag ~= nil then
		local new_tag = tag:clone()
		new_tag.Parent = humanoid
	end
end


function untagHumanoid(humanoid)
	if humanoid ~= nil then
		local tag = humanoid:findFirstChild(&quot;creator&quot;)
		if tag ~= nil then
			tag.Parent = nil
		end
	end
end

connection = ball.Touched:connect(onTouched)


t, s = r.Stepped:wait()
d = t + 5.0 - s
while t &lt; d do
	t = r.Stepped:wait()
end

ball.Parent = nil</string>
					<bool name="archivable">true</bool>
				</Properties>
				<Item class="Script" referent="RBX1315">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Stun</string>
						<string name="Source">bg = Instance.new(&quot;BodyGyro&quot;)
bg.Parent = script.Parent.Torso
bg.maxTorque = Vector3.new(1000000000,0,1000000000)
bg.cframe = script.Parent.Torso.CFrame * CFrame.fromEulerAnglesXYZ(3.14/2,0,3.14/2)
print(&quot;Zap&quot;)
wait(.5)
bg:remove()
script:remove()</string>
