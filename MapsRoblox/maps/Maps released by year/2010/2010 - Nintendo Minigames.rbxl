				<Item class="Script" referent="RBX652">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">HatRemover</string>
						<string name="Source">function onTouched(hit) 
	local d = hit.Parent:GetChildren() 
	for i=1, #d do 
		if (d[i].className == &quot;Hat&quot;) then 
			d[i].Handle.Transparency = 1
		end 
	end
end 

script.Parent.Touched:connect(onTouched) </string>
						<bool name="archivable">true</bool>
					</Properties>
