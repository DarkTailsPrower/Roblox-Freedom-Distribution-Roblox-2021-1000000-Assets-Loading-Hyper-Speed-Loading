							<string name="Source">function onTouch(part)
	if part ~= nil then
		if part.Size.x &lt; 20 and part.Size.y &lt; 20 and part.Size.z &lt; 20 then
			if part.Parent == game.Workspace or part.Parent:findFirstChild(&quot;Humanoid&quot;) then
			if part:findFirstChild(&quot;Disco&quot;) ~= nil then part.Disco:remove() end
			part.BrickColor = BrickColor.new(1)	
			part.Transparency = .5
			end
			end
		end
	end

