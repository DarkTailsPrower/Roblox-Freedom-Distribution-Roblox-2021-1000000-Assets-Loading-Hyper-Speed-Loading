						<Item class="Script" referent="RBX6546">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Pain</string>
								<string name="Source">function onTouched(part)
	if part.Parent ~= nil then
	local humanoid = part.Parent:findFirstChild(&quot;Humanoid&quot;)
	if humanoid and debounce==nil then
		debounce = true
		--script.Parent.Parent = nil
		humanoid.Health = 0
		debounce = nil
		end
	end
end
