						<string name="Name">Easy Countdown Message Script!</string>
						<string name="Source">------------------------------------
------------------------------------
local changetime = 15
------------------------------------
------------------------------------


local msg = Instance.new(&quot;Message&quot;)
msg.Parent = game.Workspace

local time = changetime

for i = 1, changetime do 

wait(1) 

time = time - 1 

msg.Text = &quot;Walls will Spawn in: &quot;..tostring(time)..&quot; !&quot; 

end 

msg.Text = &quot;Survive!&quot; 
wait(2)
msg:remove()</string>
