						<Item class="Script" referent="RBX6688">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<string name="Source">function onTouched(part)
	local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
	if h~=nil then
		h.Health = h.Health -0
	end
end

script.Parent.Touched:connect(onTouched)

Thwomp = script.Parent
Thwompvelocity = Thwomp.BodyVelocity

while true do
Thwomp.Decal.Texture = &quot;http://www.roblox.com/asset/?id=&quot;
Thwompvelocity.velocity = Vector3.new(0,15,0)
wait(1)
Thwompvelocity.velocity = Vector3.new(0,0,0)
wait(2)
Thwompvelocity.velocity = Vector3.new(0,-15,0)
wait(.07)
Thwompvelocity.velocity = Vector3.new(0,15,0)
wait(.07)
Thwompvelocity.velocity = Vector3.new(0,-15,0)
wait(.07)
Thwompvelocity.velocity = Vector3.new(0,15,0)
wait(.07)
Thwompvelocity.velocity = Vector3.new(0,-15,0)
wait(.07)
Thwompvelocity.velocity = Vector3.new(0,15,0)
wait(.07)
Thwompvelocity.velocity = Vector3.new(0,-15,0)
wait(.07)
Thwompvelocity.velocity = Vector3.new(0,15,0)
wait(.07)
Thwomp.Decal.Texture = &quot;http://www.roblox.com/asset/?id=&quot;
Thwompvelocity.velocity = Vector3.new(0,-70,0)
wait(3)
end
</string>
								<bool name="archivable">true</bool>
