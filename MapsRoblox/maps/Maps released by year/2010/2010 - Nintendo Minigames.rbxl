		--end
	--end
	--return bestXIndex

--	for j = 2, #set do
		--local tempScore = scores[set[j]]
		--if tempScore &lt; bestScore then
--			bestScore = tempScore
			--bestXIndex = j
		--end
	--end
--
--	return bestXIndex
--end

function findBestNode(set, scores)
	local bestScore = nil
	local bestValue = nil

	for key, value in pairs(set) do
		if value then
			if bestValue == nil or scores[key] &lt; bestScore then
				bestScore = scores[key]
				bestValue = key
			end
		end
	end

	return bestValue
end


