		<Item class="Script" referent="RBX58">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">leaderboard</string>
				<string name="Source">local viptools = {&quot;Forcefield Ball&quot;,&quot;Gravity Coil&quot;,&quot;Invisibility Tool&quot;,&quot;Dance Tool&quot;,&quot;Hat Jacker&quot;}


game.Players.PlayerAdded:connect(function(p)

        stats = Instance.new(&quot;IntValue&quot;)
        stats.Parent = p
        stats.Name = &quot;leaderstats&quot;

        c = Instance.new(&quot;IntValue&quot;)
        c.Parent = stats
        c.Name = &quot;Coins&quot;
        c.Value = 0
--Mega Vip
if game:service(&quot;BadgeService&quot;):UserHasBadge(p.userId,64355461) then
c.Value = c.Value + 500
local currentval = c.Value
end
--Normal Vip
if game:service(&quot;BadgeService&quot;):UserHasBadge(p.userId,68169644) or game:service(&quot;BadgeService&quot;):UserHasBadge(p.userId,68169644) then
c.Value = c.Value + 200
end
--Insane Vip
if game:service(&quot;BadgeService&quot;):UserHasBadge(p.userId,68186495) then
c.Value = c.Value + 1000
end

local ns = script.Script:clone()
ns.Parent = p.PlayerGui
ns.Disabled = false


p.CharacterAdded:connect(function()
print(&quot;Respawn&quot;)
for _,v in next, viptools do
if p:findFirstChild(v) then
print(&quot;match&quot;)
game.Lighting[v]:clone().Parent = p.Backpack
end
end
repeat wait() until p.Character:findFirstChild(&quot;Humanoid&quot;)
if p:findFirstChild(&quot;Health of 150&quot;) then
p.Character.Humanoid.MaxHealth = 150
p.Character.Humanoid.Health = 150
end
if p:findFirstChild(&quot;Double Health&quot;) then
p.Character.Humanoid.MaxHealth = 200
p.Character.Humanoid.Health = 200
end

end)

end)</string>
				<bool name="archivable">true</bool>
			</Properties>
			<Item class="Script" referent="RBX59">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<string name="Source">wait()
local p = script.Parent.Parent
local c = p.leaderstats.Coins
currentval = c.Value
print(&quot;hi&quot;)
function cashchange()
if c.Value &gt; currentval then
connection:disconnect()
local increaseby = 0
if game:service(&quot;BadgeService&quot;):UserHasBadge(p.userId,64355461) then
increaseby = increaseby+20
end
if game:service(&quot;BadgeService&quot;):UserHasBadge(p.userId,68169644) or game:service(&quot;BadgeService&quot;):UserHasBadge(p.userId,68169644) then
increaseby = increaseby+10
end
if game:service(&quot;BadgeService&quot;):UserHasBadge(p.userId,68186495) then
increaseby = increaseby+100
end
c.Value = c.Value + increaseby
connection = c.Changed:connect(cashchange)
end
currentval = c.Value
end

connection = c.Changed:connect(cashchange)

</string>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
		</Item>
