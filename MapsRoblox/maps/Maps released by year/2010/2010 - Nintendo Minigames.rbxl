							<Properties>
								<bool name="Disabled">true</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Stun</string>
								<string name="Source">bg = Instance.new(&quot;BodyGyro&quot;)
bg.Parent = script.Parent.Torso
bg.maxTorque = Vector3.new(1000000000,0,1000000000)
bg.cframe = script.Parent.Torso.CFrame * CFrame.fromEulerAnglesXYZ(3.14/2,0,3.14/2)
print(&quot;Zap&quot;)
wait(.5)
bg:remove()
script:remove()</string>
								<bool name="archivable">true</bool>
							</Properties>
						</Item>
					</Item>
					<Item class="Script" referent="RBX5256">
						<Properties>
							<bool name="Disabled">true</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Trap</string>
							<string name="Source">while true do
	wait(math.random(5,7))
	script.Parent.CanCollide = false
	script.Parent.Transparency = 1
	wait(math.random(2,3))
	script.Parent.CanCollide = true
	script.Parent.Transparency = 0
	end
</string>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
				</Item>
