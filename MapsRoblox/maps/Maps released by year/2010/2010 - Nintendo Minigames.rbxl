						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">HatRemover</string>
						<string name="Source">function onTouched(hit) 
	local d = hit.Parent:GetChildren() 
	for i=1, #d do 
		if (d[i].className == &quot;Hat&quot;) then 
			d[i]:remove() 
		end 
	end
end 

