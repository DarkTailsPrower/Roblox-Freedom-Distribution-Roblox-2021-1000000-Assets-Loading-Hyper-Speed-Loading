					<string name="Source">function onTouch(part)
	h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
	if h ~= nil then h.Health = 0 end
	if part.Name == &quot;Barrier&quot; then
		part.Anchored = false
		part:breakJoints()
