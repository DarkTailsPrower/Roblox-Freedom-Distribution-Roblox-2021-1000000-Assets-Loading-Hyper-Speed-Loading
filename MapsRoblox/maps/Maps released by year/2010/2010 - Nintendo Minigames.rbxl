					<Item class="Script" referent="RBX7895">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<string name="Source">function onTouch(part) 
local human = part.Parent:findFirstChild(&quot;Humanoid&quot;) 
if (human == nil) then return end 
human.Health = 5
end 
script.Parent.Touched:connect(onTouch)</string>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
					<Item class="Script" referent="RBX7896">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Deadly</string>
							<string name="Source">function onTouched(hit)
	local human = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
	if (human ~= nil) then
		wait(1.5)
		human.Health = human.Health - 500
		wait(.5)
	end
end

--if (script.Parent ~= nil) and (script.Parent.className == &quot;Part&quot;) then --Work if in a block
--	connection = script.Parent.Touched:connect(onTouched)
--end
script.Parent.Touched:connect(onTouched)
</string>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
					<Item class="Script" referent="RBX7897">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">BreakJoints</string>
							<string name="Source">function onTouched(hit)--made by rockjumper111 DONT COPY!


wait (50)
hit:BreakJoints()



end







connection = script.Parent.Touched:connect(onTouched)</string>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
					<Item class="Script" referent="RBX7898">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Timed Regen Script</string>
							<string name="Source">--Edited by nat2277 
--Delete the lines marked with a &quot;--***&quot; if you don&apos;t want the script to show a message when it regens

object = script.Parent  --Put this script directly INSIDE the model you want to regenerate
if (object ~= nil) and (object ~= game.Workspace) then 
model = object 

messageText = &quot;The Flood Is Over, Congrats To The Survivors&quot; --This is the Message that is shown when the model regenerates   --***

message = Instance.new(&quot;The Flood Is Over, Congrats To The Survivors&quot;) --***
message.Text = messageText  --***
backup = model:clone()  
waitTime = 1500 --Time in seconds to wait between regenerations 
wait(math.random(0, waitTime)) 
while true do 
wait(waitTime) 

message.Parent = game.Workspace --***
model:remove() 

wait(3) --Display regen message for this amount of time 

model = backup:clone() 
model.Parent = game.Workspace 
model:makeJoints() 
message.Parent = nil 
end 
end 
</string>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
					<Item class="Script" referent="RBX7899">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<string name="Source">function onTouched(hit)
	local human = hit.Parent:FindFirstChild(&quot;Humanoid&quot;) --The Humanoid
	if (human ~= nil) then --Is Your Humanoid There?
		human.Health = 0 --Your Health Is Now 0.
	end
end

if (script.Parent ~= nil) and (script.Parent.className == &quot;Part&quot;) then --Work if in a block
	connection = script.Parent.Touched:connect(onTouched)
end</string>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
					<Item class="Script" referent="RBX7900">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">raise</string>
							<string name="Source">function onTouched(part)
	local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
	if h~=nil then
		h.Health = h.Health -0
	end
end

script.Parent.Touched:connect(onTouched)

Lava = script.Parent.Parent.Lava
LavaVelocity = Lava.BodyVelocity

while true do
LavaVelocity.velocity = Vector3.new(0,1,0)
wait(210)
LavaVelocity.velocity = Vector3.new(0,0,0)
wait(1)
LavaVelocity.velocity = Vector3.new(0,-270,0)
wait(1)
LavaVelocity.velocity = Vector3.new(0,0,0)
wait(1)
end
</string>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
