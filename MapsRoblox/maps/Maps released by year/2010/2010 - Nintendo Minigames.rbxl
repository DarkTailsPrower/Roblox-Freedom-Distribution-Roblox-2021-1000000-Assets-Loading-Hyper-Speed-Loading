function go(attackPoint)
		humanoid:MoveTo(attackPoint, game.Workspace[&quot;Floor - 10 x 15 ft&quot;])

		local moveDir = ((attackPoint - torso.Position).unit * 2)
		
		-- raycast to see if we need to jump [keep everything super-basic for now]
		obstacle = game.Workspace:FindPartOnRay(Ray.new(torso.Position, moveDir), janitorBot)
		if obstacle ~= nil then 
			janitorBot.Humanoid.Jump = true 
		end
end

