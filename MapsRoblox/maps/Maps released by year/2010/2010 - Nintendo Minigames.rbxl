	script.Parent.Parent.Torso[&quot;Right Shoulder&quot;].C1 = CFrame.new(-0.4, 0.5, 0, 0, 0, 1, 0, 1, 0, -1, -0, -0) * CFrame.fromEulerAnglesXYZ(-math.pi/8,0,0)
	wait(0.05)
	script.Parent.Parent.Torso[&quot;Left Shoulder&quot;].C1 = CFrame.new(0.4, 0.5, 0, -0, -0, -1, 0, 1, 0, 1, 0, 0) * CFrame.fromEulerAnglesXYZ(-math.pi/6,0,0)
	script.Parent.Parent.Torso[&quot;Right Shoulder&quot;].C1 = CFrame.new(-0.4, 0.5, 0, 0, 0, 1, 0, 1, 0, -1, -0, -0) * CFrame.fromEulerAnglesXYZ(-math.pi/6,0,0)
	wait(0.05)
	script.Parent.Parent.Torso[&quot;Left Shoulder&quot;].C1 = CFrame.new(0.4, 0.5, 0, -0, -0, -1, 0, 1, 0, 1, 0, 0) * CFrame.fromEulerAnglesXYZ(-math.pi/3.5,0,0)
	script.Parent.Parent.Torso[&quot;Right Shoulder&quot;].C1 = CFrame.new(-0.4, 0.5, 0, 0, 0, 1, 0, 1, 0, -1, -0, -0) * CFrame.fromEulerAnglesXYZ(-math.pi/3.5,0,0)
	animate(&quot;Block&quot;)
	elseif blocking == true then
	deb = true
	deb2 = true
	script.Parent.Blocking.Value = false
	script.Parent.Parent.Torso[&quot;Left Shoulder&quot;].C1 = CFrame.new(0.4, 0.5, 0, -0, -0, -1, 0, 1, 0, 1, 0, 0) * CFrame.fromEulerAnglesXYZ(-math.pi/6,0,0)
	script.Parent.Parent.Torso[&quot;Right Shoulder&quot;].C1 = CFrame.new(-0.4, 0.5, 0, 0, 0, 1, 0, 1, 0, -1, -0, -0) * CFrame.fromEulerAnglesXYZ(-math.pi/6,0,0)
	wait(0.05)
