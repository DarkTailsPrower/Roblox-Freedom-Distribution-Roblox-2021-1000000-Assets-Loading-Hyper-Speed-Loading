	script.Parent.Parent.Torso[&quot;Right Shoulder&quot;].C1 = CFrame.new(-0.4, 0.5, 0, 0, 0, 1, 0, 1, 0, -1, -0, -0) * CFrame.fromEulerAnglesXYZ(-math.pi/8,0,0)
