					</Properties>
				</Item>
			</Item>
			<Item class="Tool" referent="RBX1904">
				<Properties>
					<int name="ActivationState">0</int>
					<int name="BackendToolState">1</int>
					<bool name="Enabled">true</bool>
					<CoordinateFrame name="Grip">
						<X>0</X>
						<Y>0</Y>
						<Z>-2</Z>
						<R00>0</R00>
						<R01>0</R01>
						<R02>1</R02>
						<R10>1</R10>
						<R11>0</R11>
						<R12>0</R12>
						<R20>0</R20>
						<R21>1</R21>
						<R22>0</R22>
					</CoordinateFrame>
