						<bool name="archivable">true</bool>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX1394">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">BananaScript</string>
						<string name="Source">wait(0.5)

local banana = script.Parent

local touched = false

function onTouched(part)

	if touched then
		return
	end
	
	touched = true

	local humanoid = part.Parent:FindFirstChild(&quot;Humanoid&quot;)
	if humanoid ~= nil then

		banana.SlipSound:Play()
		humanoid.Jump = true
		humanoid.Sit = true
		wait(0.9)
		humanoid.Sit = false

	end

	touched = false

end

banana.Touched:connect(onTouched)
