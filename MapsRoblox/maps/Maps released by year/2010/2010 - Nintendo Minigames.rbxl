script.Parent.Unequipped:connect(function()
if script.Parent.Parent.Name == &quot;Backpack&quot; then
plyr = script.Parent.Parent.Parent.Character
plyr.Torso[&quot;Left Shoulder&quot;].C1 = CFrame.new(0.5, 0.5, 0, -0, -0, -1, 0, 1, 0, 1, 0, 0)
plyr.Torso[&quot;Right Shoulder&quot;].C1 = CFrame.new(-0.5, 0.5, 0, 0, 0, 1, 0, 1, 0, -1, -0, -0)
if script.Parent.Parent:FindFirstChild(&quot;Animate2&quot;) ~= nil then
plyr.Animate2:remove()
anim = script.Animate:clone()
anim.Disabled = false
anim.Parent = plyr
end
else
plyr = script.Parent.Parent
plyr.Torso[&quot;Left Shoulder&quot;].C1 = CFrame.new(0.5, 0.5, 0, -0, -0, -1, 0, 1, 0, 1, 0, 0)
plyr.Torso[&quot;Right Shoulder&quot;].C1 = CFrame.new(-0.5, 0.5, 0, 0, 0, 1, 0, 1, 0, -1, -0, -0)
if plyr:FindFirstChild(&quot;Animate2&quot;) ~= nil then
script.Parent.Parent.Animate2:remove()
anim = script.Animate:clone()
anim.Disabled = false
anim.Parent = plyr
end
end
plyr = nil
script:Clone().Parent = script.Parent
script:Remove()
end)
