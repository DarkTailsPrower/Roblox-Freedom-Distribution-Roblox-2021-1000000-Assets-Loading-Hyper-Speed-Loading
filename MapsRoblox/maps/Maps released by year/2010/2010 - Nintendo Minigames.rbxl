						<string name="Source">--[[for i=1,20 do
	p = Instance.new(&quot;Part&quot;)
	p.Parent = script.Parent
	p.Size = Vector3.new(math.random(15,25),math.random(15,25),math.random(15,25))
	p.Anchored = true
	p.BrickColor = BrickColor.new(1)
	x = math.random(0,314)*.1
	y = math.random(0,314)*.1
	z = math.random(0,314)*.1
	p.CFrame = script.Parent.Spawn.CFrame * CFrame.new(math.random(-150,150),0,math.random(-150,150)) * CFrame.fromEulerAnglesXYZ(x,y,z)
	end]]

wait(7)
--print(&quot;Go&quot;)
local m = Instance.new(&quot;Message&quot;)
m.Parent = game.Workspace
m.Text = &quot;Get Ready To Take Over&quot; -- This Avoids Spawn killing
wait(2)
local x = math.random(2,10)
wait(x)

g = game.Players:GetChildren()
for i=1,#g do
	if g[i].Character ~= nil then 
	if g[i].Character:findFirstChild(&quot;Playing&quot;) ~= nil then
		print(&quot;Go&quot;)
		game.Lighting.LinkedTrowel:clone().Parent = g[i].Backpack
		game.Lighting.LinkedSword:clone().Parent = g[i].Backpack
		game.Lighting.LinkedSlingshot:clone().Parent = g[i].Backpack
		game.Lighting.Superball:clone().Parent = g[i].Backpack
		game.Lighting.Timebomb:clone().Parent = g[i].Backpack
		game.Lighting.RocketLauncher:clone().Parent = g[i].Backpack
		end
		end
	end

m.Text = &quot;Take Over!!&quot;
wait(.3)
m:remove()
