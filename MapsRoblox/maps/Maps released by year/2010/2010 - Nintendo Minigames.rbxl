				<Item class="Script" referent="RBX1414">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<string name="Source">--Made by Stickmasterluke

plr=game.Players.LocalPlayer
sp=script.Parent
mode = 1

function Clicked(Mouse)
	t = Mouse.Target
	if t.Name == &quot;Chip&quot; then
		t.BrickColor = BrickColor.new(21)
		t.BodyPosition.position = t.Position + Vector3.new(0,6,0)
		wait(1)
		t.BodyGyro.cframe = t.CFrame * CFrame.fromEulerAnglesXYZ(math.pi,0,0)
		wait(1)
		t.BodyPosition.position = t.Position - Vector3.new(0,6,0)
		wait(1)
		char.Playing.Value = char.Playing.Value + t.PointValue.Value
		end
	if t.Name == &quot;Card&quot; then
		t.BrickColor = BrickColor.new(21)
		t.Anchored = true
		wait(1)
		t:remove()
		end
	end

function UnClicked(Mouse)
end

function onKeyDown(key)
	--[[if (key~=nil) then
		key = key:lower()
		if (key == &quot;q&quot;) then
			if mode == 1 then
				mode = 2
				m.Text = &quot;Current Mode: Decreasing (Press Q to switch to increasing)&quot;
				elseif mode == 2 then
				mode = 1
				m.Text = &quot;Current Mode: Increasing (Press Q to switch to decreasing)&quot;
				end
			end
		end]]
	end

function Selected(Mouse) 

	char = script.Parent.Parent.Parent.Character
	if char ~= nil then
		int = char:findFirstChild(&quot;Playing&quot;)
		if int ~= nil then
			int.Changed:connect(onChanged)
			end
		end 

	Mouse.KeyDown:connect(onKeyDown)
	Mouse.Button1Down:connect(function()Clicked(Mouse)end) 
	Mouse.Button1Up:connect(function()UnClicked(Mouse)end)
	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	m = Instance.new(&quot;Hint&quot;)
	m.Parent = script.Parent.Parent.Parent
	m.Text = &quot;Click on a chip to choose. Score = &quot; .. char.Playing.Value
end 

function Deselected(Mouse)
m:remove()
end

function onChanged()
	char = script.Parent.Parent.Parent.Character
	if char ~= nil then
		int = char:findFirstChild(&quot;Playing&quot;)
		if int ~= nil then
			m.Text = &quot;Click on a chip to choose. Score = &quot; .. char.Playing.Value
			end
		end 
	end

sp.Selected:connect(Selected)
sp.Deselected:connect(Deselected) 
