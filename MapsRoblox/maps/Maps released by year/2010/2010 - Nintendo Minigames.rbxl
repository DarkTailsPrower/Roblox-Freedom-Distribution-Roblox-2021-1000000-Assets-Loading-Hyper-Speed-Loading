		<Item class="Script" referent="RBX626">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">TalkyScript</string>
				<string name="Source">--model = game.Workspace.FlapJack-- this is for the regeneration piece
--model2=game.Workspace.DoorZ --this is the door
--backup = model:clone() 


--[[minigames = {}

mm = game.Lighting.Choices:GetChildren()
for i=1,#mm do
	if mm[i].className == &quot;Model&quot; and mm[i]:findFirstChild(&quot;PickMe&quot;) == nil then
		table.insert(minigames,mm[i])
		end
	end]]


function onChatted(msg, recipient, speaker) 

	if speaker.Character ~= nil then
	-- convert to all lower case 

		local source = string.lower(speaker.Name) 
		msg = string.lower(msg) 
		local norm = msg

		if (msg == &quot;reset&quot;) or (msg == &quot;quit&quot;) or (msg == &quot;kill me&quot;) then 
		if speaker.Character:findFirstChild(&quot;Playing&quot;) ~= nil then
		speaker.Character.Torso:remove()
		end
		end 

		--[[if (msg == &quot;/spectate&quot;) then
			if speaker.Character:findFirstChild(&quot;Spectating&quot;) == nil then
			local value = Instance.new(&quot;BoolValue&quot;)
			value.Name = &quot;Spectating&quot;
			value.Parent = speaker.Character
			end
			end

		if (msg == &quot;/play&quot;) then
			if speaker.Character:findFirstChild(&quot;Spectating&quot;) ~= nil then
				speaker.Character.Spectating:remove()
				end
			end]]

		--[[if (msg == &quot;/testmode&quot;) then
			if speaker.Name == &quot;ICE128&quot; or speaker.Name == &quot;Player&quot; then
				print(&quot;!&quot;)
				if game.Workspace.TestingMode.Value == false then 
					game.Workspace.TestingMode.Value = true 
					else
					game.Workspace.TestingMode.Value = false
					end
				end
			end]]

		if (msg == &quot;/resettimer&quot;) or (msg == &quot;/endgame&quot;) then
			if speaker.Name == &quot;ICE128&quot; or speaker.Name == &quot;Player&quot; then
				game.Workspace.Timer.Value = 0
				end
			end

		--[[if string.sub(msg,1,10) == &quot;/minigame &quot; then
				if speaker.Name == &quot;ICE128&quot; or speaker.Name == &quot;Player&quot; then
				local t = BreakDown(norm)
				if msg == &quot;/minigame &quot; then return end
				print(&quot;!!&quot;)
				if #t &gt; 0 then
					for i = 1,#t do
						print(&quot;\&quot;&quot;..t[i]..&quot;\&quot;&quot;)
						print(t[i])
						local player = game.Lighting.Choices:findFirstChild(t[i])
						if player ~= nil then
							print(&quot;:O&quot;)
							game.Workspace.ChosenMinigame.Value = player.Name
							end
						end
					end
				end
			end]]

		end
	end 

function BreakDown(msg)
	local sep = &quot;, &quot;
	local str = sep..msg:sub(11)
	fields = {str:match((str:gsub(sep..&quot;[^&quot;..sep..&quot;]*&quot;, sep..&quot;([^&quot;..sep..&quot;]*)&quot;)))}

	--msg:gsub(&quot;([^&quot;..&quot;,&quot;..&quot;]*)&quot;, function(c) table.insert(sep, c) end)
	return fields
end

function onPlayerEntered(newPlayer) 
newPlayer.Chatted:connect(function(msg, recipient) onChatted(msg, recipient, newPlayer) end) 
end 

game.Players.ChildAdded:connect(onPlayerEntered) </string>
