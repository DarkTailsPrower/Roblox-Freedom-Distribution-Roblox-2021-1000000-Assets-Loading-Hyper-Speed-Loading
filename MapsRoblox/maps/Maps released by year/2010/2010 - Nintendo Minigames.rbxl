		<Item class="Script" referent="RBX1114">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">High Score</string>
				<string name="Source">stat = &quot;Coins&quot; -- change this to the EXACT name of the leaderstat you want there to be a high score for
highestscore = 0
v = script.Leader
while true do
wait(1)
p = game.Players:GetPlayers()
for i=1, #p do
local leaderstats = p[i]:findFirstChild(&quot;leaderstats&quot;)
if leaderstats ~= nil then
local stats = p[i]:findFirstChild(&quot;leaderstats&quot;):findFirstChild(stat)
if stats ~= nil then
if stats.Value &gt; highestscore then
v.Value = (p[i].Name .. &quot; with &quot; .. stats.Value .. &apos; &apos; .. stat .. &quot;!&quot;)
highestscore = stats.Value
end
end
end
end
end
