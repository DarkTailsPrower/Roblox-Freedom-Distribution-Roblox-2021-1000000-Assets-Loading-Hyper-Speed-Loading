	script.Parent.Parent.Torso[&quot;Right Shoulder&quot;].C1 = CFrame.new(-0.4, 0.5, 0, 0, 0, 1, 0, 1, 0, -1, -0, -0) * CFrame.fromEulerAnglesXYZ(0,0,0)
	wait(0.05)
	script.Parent.Parent.Torso[&quot;Left Shoulder&quot;].C1 = CFrame.new(0.4, 0.5, 0, -0, -0, -1, 0, 1, 0, 1, 0, 0) * CFrame.fromEulerAnglesXYZ(math.pi/16,0,0)
	script.Parent.Parent.Torso[&quot;Right Shoulder&quot;].C1 = CFrame.new(-0.4, 0.5, 0, 0, 0, 1, 0, 1, 0, -1, -0, -0) * CFrame.fromEulerAnglesXYZ(math.pi/16,0,0)
	end
	elseif key == &quot;q&quot; and deb == true and deb4 == true then
	target = nil
players = game.Players:GetChildren()
for i = 1,#players do
distance = (players[i].Character.Torso.Position-script.Parent.Parent.Torso.Position).magnitude
p = game.Players:GetPlayerFromCharacter(script.Parent.Parent)
if distance &lt; 5 and players[i] ~= p then
target = players[i]
break
end
end
		if target ~= nil then
