			<Item class="Tool" referent="RBX1446">
				<Properties>
					<int name="ActivationState">0</int>
					<int name="BackendToolState">1</int>
					<bool name="Enabled">true</bool>
					<CoordinateFrame name="Grip">
						<X>0</X>
						<Y>0.400000006</Y>
						<Z>0.5</Z>
						<R00>1</R00>
						<R01>4.31581466e-005</R01>
						<R02>4.80200768e-010</R02>
						<R10>9.29503585e-010</R10>
						<R11>-3.26636837e-005</R11>
						<R12>1</R12>
						<R20>4.31581502e-005</R20>
						<R21>-0.99999994</R21>
						<R22>-3.26636873e-005</R22>
					</CoordinateFrame>
					<string name="Name">PaintballGun</string>
					<Content name="TextureId"><url>rbxasset://Textures/PaintballIcon.png</url></Content>
