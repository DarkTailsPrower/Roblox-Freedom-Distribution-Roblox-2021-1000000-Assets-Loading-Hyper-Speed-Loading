						<Item class="Script" referent="RBX166">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<string name="Source">DECAL = script.Parent.Decal 
Decal2 = script.Parent.Decal2
humanoid = script.Parent.Parent.Parent:findFirstChild(&quot;Humanoid&quot;)
running = false
DecalId = &quot;http://www.roblox.com/asset/?id=52292149&quot;
DecalId2 = &quot;http://www.roblox.com/asset/?id=52292163&quot;

function Run(speed)
	if speed &gt; 0 then
		running = true
	else
		running = false
		DECAL.Texture = DecalId
		Decal2.Texture = DecalId
	end
end

humanoid.Running:connect(Run)

--All you have to do is change the DecalId things. The first one is the &quot;Not walking&quot; picture.

while true do 
wait(0.2)
if running then
	if DECAL.Texture == DecalId then
		DECAL.Texture = DecalId2
	else
		DECAL.Texture = DecalId
	end
	Decal2.Texture = DECAL.Texture
end
end 
</string>
								<bool name="archivable">true</bool>
