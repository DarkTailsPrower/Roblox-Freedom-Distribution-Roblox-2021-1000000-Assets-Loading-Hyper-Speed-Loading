					<Item class="Script" referent="RBX7999">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<string name="Source">bv = script.Parent.Parent.Crane.Engine.BV
bp = script.Parent.Parent.Crane.Engine.BodyPosition
engine = script.Parent.Parent.Crane.Engine

originalposition = engine.Position

button = script.Parent.Parent.Button
bc = button.BrickColor
door = script.Parent.Parent.Crane.Door

pressed = false

function onChange()
	if pressed == false then
	bv.velocity = Vector3.new(script.Parent.Steer*-20, 0, script.Parent.Throttle*20)
	end
	end

script.Parent.Changed:connect(onChange)

function onClick()
	if pressed == false then
		pressed = true
		button.BrickColor = BrickColor.new(21)
		bp.position = engine.Position
		bp.maxForce = Vector3.new(10000000,10000000,10000000)--catching...
		bv.maxForce = Vector3.new(0,0,0)
		catchpos = bp.position
		bp.position = bp.position - Vector3.new(0,80,0)
		wait(2)
		door.Transparency = .7
		door.CanCollide = true
		wait(1)
		bp.maxForce = Vector3.new(10000000,10000000,10000000)
		bp.position = catchpos
		wait(1)
		bp.position = originalposition
		wait(3)
		bp.maxForce = Vector3.new(10000000,0,10000000)--kill em all
		door.CanCollide = false
		door.Transparency = 1

		local things = door.Parent:GetChildren()
		for i=1,#things do
			if things[i].Name == &quot;Catcher&quot; then
			things[i].CanCollide = false
			things[i].Transparency = 1
			end
			end

		droppos = bp.position
		bp.position = droppos
		bp.maxForce = Vector3.new(0,4e+008,0)
		bv.maxForce = Vector3.new(4e+008, 4e+008, 4e+008)
		bv.velocity = Vector3.new(0,0,0)
		wait(2)

		local things = door.Parent:GetChildren()
		for i=1,#things do
			if things[i].Name == &quot;Catcher&quot; then
			things[i].CanCollide = true
			things[i].Transparency = .7
			end
			end

		button.BrickColor = bc
		pressed = false
		end
	end

button.ClickDetector.MouseClick:connect(onClick)
</string>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
				</Item>
