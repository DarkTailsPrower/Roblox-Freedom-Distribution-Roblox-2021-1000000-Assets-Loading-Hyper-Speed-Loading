	if parentList[endNode] then
		makePath(parentList, parentList[endNode])
		return p + endNode
	else
		return endNode
	end
end--]]

function makePath(parentList, endNode)
	local path = {}
	while endNode do
		table.insert(path, endNode)
		endNode = parentList[endNode]
	end
	
	return path
end


--local parents = {}
function aStarSearch(startNode, endNode)
	--print(startNode.Name, endNode.Name)
	local closed = {}
	local openElements = 1
	local open = {}
	setAdd(open, startNode.Name)

	local parents = {}
	
	local g = {}
	local h = {}
	local f = {}

	g[startNode.Name] = 0
	h[startNode.Name] = dist(startNode, endNode)
	f[startNode.Name] = h[startNode.Name]

	while openElements &gt; 0 do
		local x = findBestNode(open, f)
		--local xIndex = findBestNodeIndex(open, f)
		--local x = open[xIndex]
		--local x = findBestNodeIndex(open, f)
		--if x == endNode then return makePath(parents, parents[endNode]) end
		if x == endNode.Name then return makePath(parents, endNode.Name) end

		setRemove(open, x)
		openElements = openElements - 1
		setAdd(closed, x)
		--table.remove(open, xIndex)
		--open[x] = nil
		--table.insert(closed, x)

		local neighborList = network[x]
		local costList = costs[x]
		for i = 1, #neighborList do
			local y = neighborList[i]
			if setContains(closed, y) then -- nothing... just continue with loop
			else
				local tentativeG = g[x] + costList[i]

				local tentativeIsBetter = true
				if not setContains(open, y) then
					--table.insert(open, y)
					setAdd(open, y)
					openElements = openElements + 1
				elseif tentativeG &lt; g[y] then
					-- nothing here
				else tentativeIsBetter = false end

				if tentativeIsBetter then
					parents[y] = x
					g[y] = tentativeG
					h[y] = dist(wayPoints:FindFirstChild(y), endNode)
					f[y] = g[y] + h[y]
				end
			end
		end
	end

	print(&quot;PATHFINDING FAILURE&quot;)

end

function notTemp(waypoint)
	-- for now, we use the fact that we always have &quot;garbage_&quot; or another long string for temporary waypoints
	--return (#(waypoint.Name) &lt; 8)
	return true -- allow temps to be used in path-makings (although should also make sure that we attach to normal points to)
end

function findClosestWaypoint(point)
	local bestDistSq = nil
	local bestWaypoint = nil
	local tempDistSq
	waypoints = wayPoints:GetChildren()
	for k = 1, #waypoints do
		tempDistSq = (waypoints[k].Position - point):Dot(waypoints[k].Position - point)
		if (notTemp(waypoints[k])) then -- only check non-garbage and non-temporary waypoints
			if bestWaypoint == nil or tempDistSq &lt; bestDistSq then
				bestDistSq = tempDistSq
				bestWaypoint = waypoints[k]
			end
		end
	end

	return bestWaypoint
end


--moveFast() -- start out just roamin&apos; around
moveSlow()
local garbage = game.Workspace.GarbageParts
local currentWayPoint = findClosestWaypoint(torso.Position)
local dontBreakForNewGarbage = true
local path

function distLineSegmentPoint(startP, endP, point)
	local x = endP - startP
	local y = point - startP
	local z = point - endP

	if y:Dot(x) &lt;= 0 then
		-- return distance to startPoint
		return y.magnitude
	elseif z:Dot(x) &gt;= 0 then
		-- return distance to endPoint
		return z.magnitude
	else
		-- return distance to line
		x = x.unit
		return (y - y:Dot(x)*x).magnitude
		--(y - y:Dot(x)*x.unit).magnitude [first x needed to be unit vector, or projection got messed up]
	end
end

function findClosestEdge(point)
	local closestWaypoint = findClosestWaypoint(point)

	-- now walk through list of neighboring edges, and calculate line-segment-to-point distances for each
	local neighbors = network[closestWaypoint.Name]
	local startPoint = closestWaypoint.Position

	local bestDistance = nil
	local bestNeighbor = nil

	for c = 1, #neighbors do
		local currWayPoint = wayPoints:FindFirstChild(neighbors[c])
		local endPoint = currWayPoint.Position
		local distToPoint = distLineSegmentPoint(startPoint, endPoint, point)

		if (notTemp(currWayPoint)) then -- only check non-temporary and non-garbage waypoints
			if bestDistance == nil or distToPoint &lt; bestDistance then
				bestDistance = distToPoint
				bestNeighbor = neighbors[c]
			end
		end
	end

	return closestWaypoint.Name, bestNeighbor
end


--function addGarbage(newGarbage)
--end

--function removeGarbage(garbage)
--end

--garbage.ChildAdded:connect(addGarbage)
--garbage.ChildRemoved:connect(removeGarbage)

function makeTemporaryNode(nodeName, nodePosition)
	-- make a temporary wayPoint at current position
	local newWayPoint = Instance.new(&quot;Part&quot;)
	newWayPoint.Size = Vector3.new(0.2,0.2,0.2)
	newWayPoint.CanCollide = false
	newWayPoint.Transparency = 1
	newWayPoint.Anchored = true
	newWayPoint.CFrame = CFrame.new(nodePosition)
	
	newWayPoint.Name = nodeName

	local wp1, wp2 = findClosestEdge(newWayPoint.Position)
	newWayPoint.Parent = wayPoints

	addNeighbors({newWayPoint.Name, wp1})
	addNeighbors({newWayPoint.Name, wp2})

	return newWayPoint
end

function deleteNode(node)
	local nodeName = node.Name
	local neighbors = network[nodeName]
	costs[nodeName] = nil

	-- for each neighbor, we need to find the node corresponding to node-to-be-deleted, and delete corresponding network and cost table entries
	for n = 1, #neighbors do
		local links = network[neighbors[n]]
		local prices = costs[neighbors[n]]

		for l = 1, #links do
			if links[l] == nodeName then
				table.remove(links, l)
				table.remove(prices, l)
				break
			end
		end
	end

	network[node.Name] = nil
	node.Parent = nil
end

local chattingWithPlayer = false
local garbageTarget = nil
local lockGarbageSetting = false
local playerTargets = {}

-- for now, we just use absolute distance and not path-based distance (although would be cooler if we switch to that eventually)
function setGarbageTarget(point)
	local bestDistSq = nil
	local bestGarbage = nil
	local garbageChildren = garbage:GetChildren()

	for g = 1, #garbageChildren do
		local tempGarbage = garbageChildren[g]
		local tempGarbageDistance
		local tempGarbageVelocity
		if tempGarbage.className == &quot;Model&quot; then tempGarbageDistance = getPrimaryPart(tempGarbage).Position - point tempGarbageVelocity = getPrimaryPart(tempGarbage).Velocity
		else tempGarbageDistance = tempGarbage.Position - point tempGarbageVelocity = tempGarbage.Velocity end

		if tempGarbageVelocity:Dot(tempGarbageVelocity) &lt; 5 then
			local distSq = tempGarbageDistance:Dot(tempGarbageDistance)
			if bestGarbage == nil or distSq &lt; bestDistSq then
				bestDistSq = distSq
				bestGarbage = tempGarbage
			end		
		end
	end
	
	if garbageTarget ~= bestGarbage and not lockGarbageSetting then
		if garbageTarget == nil and not chattingWithPlayer and #playerTargets == 0 then game.Chat:Chat(janitorBot.Head, &quot;Clean!&quot;, &quot;Red&quot;) end --game.Chat(&quot;Trash!&quot;) end
		garbageTarget = bestGarbage
		dontBreakForNewGarbage = false
	end
end

function trackGarbage()
	while true do
		setGarbageTarget(torso.Position)
		wait()
	end
end


function playerAdded(newPlayer)
	--wait(5)
	table.insert(playerTargets, newPlayer)
	if not lockGarbageSetting then dontBreakForNewGarbage = false end
end

function playerObjectAdded(newPlayerObject)
	playerAdded(newPlayerObject.Value)
	newPlayerObject:Remove()
end

--game.Players.PlayerAdded:connect(playerAdded)
janitorBot.FinishedTutorial.ChildAdded:connect(playerObjectAdded)

function hammerTime(blastPos)
	hammer.Parent = janitorBot
	
	wait(.5)

	local whackAnim = Instance.new(&quot;StringValue&quot;)
	whackAnim.Name = &quot;toolanim&quot;
	whackAnim.Value = &quot;Slash&quot;
	whackAnim.Parent = hammer

	wait(.5)

	local newEx = Instance.new(&quot;Explosion&quot;)
	newEx.BlastRadius = 5
	newEx.BlastPressure = 0
	newEx.Position = blastPos
	newEx.Parent = game.Workspace
	
	debris:AddItem(whackAnim, 1)
	debris:AddItem(newEx, 1.5)
end

-- just use runservice here!!
local notStuck = true
local countdownStartTime
function isStuckCountdown()
	countdownStartTime = runService.Stepped:wait()
	
	while true do
		local currTime = runService.Stepped:wait()
		if currTime - countdownStartTime &gt; 20 then
			notStuck = false
			countdownStartTime = currTime + 10
		elseif  currTime - countdownStartTime &gt; 10 then
			janitorBot.Humanoid.Jump = true
		end
	end
end

function resetCountdown()
	countdownStartTime = runService.Stepped:wait()
end

local countdown = coroutine.create(isStuckCountdown)
coroutine.resume(countdown)

local cloneMe = janitorBot:Clone()

function getUnstuck()
	game.Chat:Chat(janitorBot.Head, &quot;Well, this is awkward...  Have I gotten stuck?&quot;, &quot;Red&quot;)
	wait(3)
	game.Chat:Chat(janitorBot.Head, &quot;Error!&quot;, &quot;Red&quot;)
	wait(1)
	game.Chat:Chat(janitorBot.Head, &quot;Error!&quot;, &quot;Red&quot;)
	wait(1)
	game.Chat:Chat(janitorBot.Head, &quot;Error!&quot;, &quot;Red&quot;)
	wait(1)
	
	local newEx1 = Instance.new(&quot;Explosion&quot;)
	newEx1.BlastRadius = 5
	newEx1.BlastPressure = 0
	newEx1.Position = torso.Position
	newEx1.Parent = game.Workspace

	local newEx2 = Instance.new(&quot;Explosion&quot;)
	newEx2.BlastRadius = 5
	newEx2.BlastPressure = 0
	newEx2.Position = safePosition
	newEx2.Parent = game.Workspace

	debris:AddItem(newEx1, 1.5)
	debris:AddItem(newEx2, 1.5)

	-- need to respawn! DX
	if janitorBot.Humanoid.Health &lt;= 0 then
		cloneMe.Parent = game.Workspace
		janitorBot:remove()
		script.Disabled = true
		wait()
		--janitorBot = cloneMe
		--torso = janitorBot.torso
	
		--cloneMe = janitorBot:Clone()
	end

	torso.CFrame = CFrame.new(safePosition)

	wait(3)
	notStuck = true
end

-- spawn garbage-tracking system
local co = coroutine.create(trackGarbage)
coroutine.resume(co)

local myDialog = janitorBot.Head.Dialog
local guideTarget = nil

function isChatting(player, dialogChoice)
	--if dialogChoice.Name == &quot;SayHi&quot; or dialogChoice.Name == &quot;ShowMeBasePlate&quot; or dialogChoice.Name == &quot;WhereIsStamper&quot; then chattingWithPlayer = false
	--else chattingWithPlayer = true
	if dialogChoice.Name == &quot;ShowMeBasePlate&quot; then 
		myDialog.Parent = nil
		local playerNumber = player:FindFirstChild(&quot;playerNumber&quot;)
		if playerNumber == nil or playerNumber.Value &gt; 9 or playerNumber.Value &lt; 1 then
			game.Chat:Chat(janitorBot.Head, &quot;, &quot; .. player.Name .. &quot;!&quot;, &quot;Green&quot;)
			wait(2)
			game.Chat:Chat(janitorBot.Head, &quot;If you don&apos;t want to wait for someone to leave, try leaving this game and then coming back.&quot;, &quot;Green&quot;)
			wait(2)
		else
			wait(2)
			guideTarget = game.Workspace.SpawnPoints[&quot;SpawnLocation&quot; .. tostring(playerNumber.Value)].Position
			dontBreakForNewGarbage = false
			game.Chat:Chat(janitorBot.Head, &quot;Follow me to your BasePlate, &quot; .. player.Name .. &quot;!&quot;, &quot;Green&quot;)
			wait(2)
		end
	end
end

function isInUse()
	if myDialog.InUse and myDialog.Parent ~= nil then chattingWithPlayer = true dontBreakForNewGarbage = false else chattingWithPlayer = false end
end

myDialog.DialogChoiceSelected:connect(isChatting)
myDialog.Changed:connect(isInUse)

function getPrimaryPart(model)
	if model.PrimaryPart ~= nil then return model.PrimaryPart end
	local mc = model:GetChildren()
	for mIndex = 1, #mc do
		if mc[mIndex].className == &quot;Part&quot; then return mc[mIndex] end
	end
end


while true do

	if not notStuck then
		-- get un-anti-unstuck!
		myDialog.Parent = nil
		getUnstuck()
		myDialog.Parent = janitorBot.Head
	end

	while chattingWithPlayer and guideTarget == nil do
		go(torso.Position) -- stop walking away; it&apos;s rude!
		wait(3)
		resetCountdown()
	end

	-- we have a particular destination we need to go for something special (like guiding someone to their BasePlate)
	if guideTarget ~= nil then
		local startNode = makeTemporaryNode(&quot;temporaryWayPoint&quot;, torso.Position - Vector3.new(0, 2, 0))
		local endNode = makeTemporaryNode(&quot;guideTargetWayPoint&quot;, guideTarget)
		path = aStarSearch(startNode, endNode)
		for j = #path, 1, -1 do
			local nextPoint = wayPoints:FindFirstChild(path[j]).Position
			while ((torso.Position - nextPoint)*Vector3.new(1, 0, 1)):Dot((torso.Position - nextPoint)*Vector3.new(1, 0, 1)) &gt; 30 and notStuck do go(nextPoint) wait() end
			resetCountdown()
		end

		deleteNode(startNode)
		deleteNode(endNode)

		guideTarget = nil

		game.Chat:Chat(janitorBot.Head, &quot;Here we are!&quot;, &quot;Green&quot;)
		wait(2)
		myDialog.Parent = janitorBot.Head
		resetCountdown()
	end

	-- greet new players!

	while #playerTargets &gt; 0 and notStuck do
		moveFast()
		myDialog.Parent = nil

		local playerTarget = playerTargets[1]
		while playerTarget ~= nil and playerTarget.Character == nil do wait() end
		if playerTarget ~= nil then
			local playerTorso = playerTarget.Character:FindFirstChild(&quot;Torso&quot;)
			if playerTorso ~= nil then
				local startNode = makeTemporaryNode(&quot;temporaryWayPoint&quot;, torso.Position - Vector3.new(0, 2, 0))
				local endNode = makeTemporaryNode(&quot;playerLocation&quot;, playerTorso.Position - Vector3.new(0, 2, 0))
				path = aStarSearch(startNode, endNode)
				for j = #path, 2, -1 do
					local nextPoint = wayPoints:FindFirstChild(path[j]).Position
					while ((torso.Position - nextPoint)*Vector3.new(1, 0, 1)):Dot((torso.Position - nextPoint)*Vector3.new(1, 0, 1)) &gt; 30 and notStuck do go(nextPoint) wait() end
					resetCountdown()
				end

				-- make sure to home in on player&apos;s current position, wherever that may be
				while ((torso.Position - playerTorso.Position)*Vector3.new(1, 0, 1)):Dot((torso.Position - playerTorso.Position)*Vector3.new(1, 0, 1)) &gt; 50 and notStuck do go(playerTorso.Position) wait() end
				resetCountdown()
				go(torso.Position)

				game.Chat:Chat(janitorBot.Head, &quot;Hello, &quot; .. playerTargets[1].Name .. &quot;!&quot;, &quot;Green&quot;)
				wait(2)
				game.Chat:Chat(janitorBot.Head, &quot;I&apos;m a friendly Goomba.  I help tidy up the place.&quot;, &quot;Green&quot;)
				wait(2)
				game.Chat:Chat(janitorBot.Head, &quot;Just come see me if you have any questions :)&quot;, &quot;Green&quot;)
				wait(4)
				
				resetCountdown()
				
				deleteNode(startNode)
				deleteNode(endNode)
			end
		end

		table.remove(playerTargets, 1)
	end

	myDialog.Parent = janitorBot.Head

	
	if dontBreakForNewGarbage and notStuck then
		-- slowly move some random place
		moveSlow()

		local wayPointChildren = wayPoints:GetChildren()
		local randomDest = wayPointChildren[math.random(1, #wayPointChildren)].Name
		--print(&quot;Moving to &quot; .. randomDest)

		local startNode = makeTemporaryNode(&quot;temporaryWayPoint&quot;, torso.Position - Vector3.new(0, 2, 0))
		--print(randomDest)
		path = aStarSearch(startNode, wayPoints:FindFirstChild(randomDest))
		for j = #path, 1, -1 do
			if dontBreakForNewGarbage then
				local nextPoint = wayPoints:FindFirstChild(path[j]).Position
				--print(wayPoints:FindFirstChild(path[j]))
				while ((torso.Position - nextPoint)*Vector3.new(1, 0, 1)):Dot((torso.Position - nextPoint)*Vector3.new(1, 0, 1)) &gt; 30 and dontBreakForNewGarbage and notStuck do go(nextPoint) wait() end
				resetCountdown()
			end
		end

		deleteNode(startNode)
	else
		-- quickly go get that garbage!
		dontBreakForNewGarbage = true
		moveFast()		

		if garbageTarget ~= nil and notStuck then
			local startNode = makeTemporaryNode(&quot;temporaryWayPoint&quot;, torso.Position - Vector3.new(0, 2, 0))
			local garbageWaypoint
			if garbageTarget.className == &quot;Model&quot; then garbageWaypoint = makeTemporaryNode(&quot;garbageWayPoint&quot;, getPrimaryPart(garbageTarget).Position)
			else garbageWaypoint = makeTemporaryNode(&quot;garbageWayPoint&quot;, garbageTarget.Position) end

			path = aStarSearch(startNode, garbageWaypoint)

			for j = #path, 1, -1 do
				if dontBreakForNewGarbage then
					local nextPoint = wayPoints:FindFirstChild(path[j]).Position
					--print(wayPoints:FindFirstChild(path[j]))
					while ((torso.Position - nextPoint)*Vector3.new(1, 0, 1)):Dot((torso.Position - nextPoint)*Vector3.new(1, 0, 1)) &gt; 30 and dontBreakForNewGarbage and notStuck do go(nextPoint) wait() end
					resetCountdown()
				end
			end
	
			if dontBreakForNewGarbage then
				-- remove garbage &amp; garbage-nodes &amp; garbage-edges &amp; garbage-edge-costs, check for more garbage, and set dontBreakForNewGarbage to false if more

				if garbageTarget then 
					lockGarbageSetting = true
					if garbageTarget.className == &quot;Model&quot; then hammerTime(getPrimaryPart(garbageTarget).Position)
					else hammerTime(garbageTarget.Position) end
					garbageTarget.Parent = nil 
					wait(1)
					hammer.Parent = game.Lighting
					garbageTarget = nil
					lockGarbageSetting = false
					resetCountdown()
				end
	
				if #(garbage:GetChildren()) &gt; 0 then dontBreakForNewGarbage = false end -- shouldn&apos;t actually be necessary currently
			end

			deleteNode(garbageWaypoint)
			deleteNode(startNode)
		end
	end
end


