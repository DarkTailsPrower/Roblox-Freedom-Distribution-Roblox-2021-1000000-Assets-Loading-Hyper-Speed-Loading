						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">GameScript</string>
						<string name="Source">wait(7)
--print(&quot;Go&quot;)
g = game.Players:GetChildren()
for i=1,#g do
	if g[i].Character ~= nil then 
	if g[i].Character:findFirstChild(&quot;Playing&quot;) ~= nil then
		print(&quot;Go&quot;)
		game.Lighting.Tools.Hammer:clone().Parent = g[i].Backpack
		end
		end
	end

</string>
						<bool name="archivable">true</bool>
					</Properties>
