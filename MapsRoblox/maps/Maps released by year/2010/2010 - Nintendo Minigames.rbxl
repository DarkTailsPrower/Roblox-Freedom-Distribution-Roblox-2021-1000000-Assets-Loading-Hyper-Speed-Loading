				<string name="Name">Regeneration</string>
				<string name="Source">prizes = game.Workspace.Prizes:clone()
e = game.Workspace.Environment:clone()
shop = game.Workspace.Shop:clone()

while true do

	wait(10)

	m = Instance.new(&quot;Hint&quot;)
	m.Parent = game.Workspace
	m.Text = &quot;Maintaining airship...&quot;
	game.Workspace.Prizes:remove()
	game.Workspace.Environment:remove()
	game.Workspace.Shop:remove()
	wait(3)
	m:remove()

	p = prizes:clone()
	p.Parent = game.Workspace
	p:breakJoints()

	en = e:clone()
	en.Parent = game.Workspace
	en:makeJoints()

	s = shop:clone()
	s.Parent = game.Workspace

	wait(290)

	end
</string>
