					<string name="Source">print(&quot;Hello world!&quot;)
v = script.Parent.Parent.Character.ChosenSongID.Value
local holder = Instance.new(&quot;IntValue&quot;)
holder.Parent = script.Parent.Parent
holder.Name = &quot;MusicHolder&quot;
local tempsong = Instance.new(&quot;Sound&quot;)
tempsong.Name = &quot;Music&quot;
tempsong.SoundId = &quot;http://www.roblox.com/Asset/?id=&quot; .. v
tempsong.Volume = 1
tempsong.Looped = false
tempsong.Parent = script.Parent.Parent.MusicHolder

	local h = Instance.new(&quot;Hint&quot;)
	h.Parent = script.Parent.Parent
	h.Text = &quot;Current Song: &quot; .. script.Parent.Parent.Character.ChosenSongName.Value .. &quot;. Chat /nm and /pm to switch songs, chat /play to play one, chat /lm to loop.&quot;


function onChanged()
	local h = Instance.new(&quot;Hint&quot;)
	h.Parent = script.Parent.Parent
	h.Text = &quot;Current Song: &quot; .. script.Parent.Parent.Character.ChosenSongName.Value .. &quot;. Chat /nm and /pm to switch songs, chat /play to play one, chat /lm to loop.&quot;
	tempsong.SoundId = &quot;http://www.roblox.com/Asset/?id=&quot; .. script.Parent.Parent.Character.ChosenSongID.Value
	wait(3)
	if h ~= nil then h:remove() end
	end

function onChildRemoved(prop)
	print(&quot;Something went away&quot;)
	if prop.className == &quot;Sound&quot; then
	print(&quot;That something was music&quot;)
	v = script.Parent.Parent.Character.ChosenSongID.Value
	print(v)
	local tempsong = Instance.new(&quot;Sound&quot;)
	tempsong.Name = &quot;Music&quot;
	tempsong.SoundId = &quot;http://www.roblox.com/Asset/?id=&quot; .. v
	tempsong.Volume = 1
	tempsong.Looped = false
	tempsong.Parent = script.Parent.Parent.MusicHolder
	end
	end

script.Parent.Parent.Character.ChosenSongName.Changed:connect(onChanged)

function onCharChange()
	script.Parent.Parent.Character.ChosenSongName.Changed:connect(onChanged)
	end

script.Parent.Parent.Character.Changed:connect(onCharChange)
script.Parent.ChildRemoved:connect(onChildRemoved)

	wait(3)
	if h ~= nil then h:remove() end
--tempsong:Play()
--tempsong:Pause()
