					<Item class="Script" referent="RBX4514">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">SquashScript</string>
							<string name="Source">function onTouched(hit)
	if hit.Parent ~= nil then
		local human = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
		if human ~= nil then
			if hit.Name == &quot;Left Leg&quot; or hit.Name == &quot;Right Leg&quot; then
				script.Parent.AttackScript:remove()
				script.Parent.Torso.Anchored = true
				script.Parent.Torso.Mesh.Scale = Vector3.new(1.4, 0.35, 2.8)
				script.Parent.Torso.Mesh.Offset = Vector3.new(0, -1.55, 0)
				script.Parent.Torso.Decal.Texture = &quot;http://www.roblox.com/asset/?id=29336765&quot;
				script.Parent.Head.SquishSound:play()
				wait(1)
				script.Parent:findFirstChild(&quot;Heh&quot;):remove()
				script.Parent:findFirstChild(&quot;Head&quot;):remove()
				script.Parent:findFirstChild(&quot;Left Leg&quot;):remove()
				script.Parent:findFirstChild(&quot;Right Leg&quot;):remove()
				script.Parent:findFirstChild(&quot;Torso&quot;):remove()
			end
		end
	end
end

script.Parent.Head.Touched:connect(onTouched)</string>
