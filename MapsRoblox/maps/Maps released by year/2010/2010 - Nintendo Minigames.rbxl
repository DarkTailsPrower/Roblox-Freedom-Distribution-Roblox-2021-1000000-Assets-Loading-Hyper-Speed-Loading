										<Content name="LinkedSource"><null></null></Content>
										<string name="Name">PushPack</string>
										<string name="Source">door = script.Parent

function onTouch(hit)
	if hit.Parent == nil then return end
	local h = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
	if h ~= nil then
		hit.Parent.Torso.Velocity=door.CFrame.lookVector * 500 -- Push the Player back
	end
end
door.Touched:connect(onTouch)</string>
