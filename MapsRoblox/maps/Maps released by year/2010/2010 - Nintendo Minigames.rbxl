animate(&quot;RightUSlash&quot;)
wait(0.35)
script.Parent.Parent.Torso[&quot;Right Shoulder&quot;].C1 = CFrame.new(-0.4, 0.5, 0, 0, 0, 1, 0, 1, 0, -1, -0, -0) * CFrame.fromEulerAnglesXYZ(math.pi/16,0,0)
wait(0.15)
script.Parent.RightActive.Value = false
wait(0.5)
deb = true
elseif key == &quot;r&quot; and deb == true and deb2 == true then
deb = false
deb2 = false
animate(&quot;SpinSlash&quot;)
script.Parent.Active.Value = true
spin = Instance.new(&quot;BodyAngularVelocity&quot;)
spin.maxTorque = Vector3.new(0,9e+009,0)
spin.angularvelocity = Vector3.new(0,250,0)
spin.Parent = script.Parent.Parent.Torso
script.Parent.Parent.Humanoid.WalkSpeed = 0
wait(0.75)
script.Parent.Parent.Humanoid.WalkSpeed = 16
script.Parent.Active.Value = false
spin:remove()
wait(0.5)
deb = true
wait(3)
deb2 = true
elseif key == &quot;c&quot; and deb == true and deb3 == true then
deb = false
deb3 = false
script.Parent.Parent.Humanoid.WalkSpeed = 24
animate(&quot;Stab&quot;)
script.Parent.ChargeActive.Value = true
script.Parent.Parent.Torso[&quot;Left Shoulder&quot;].C1 = CFrame.new(0.4, 0.5, 0, -0, -0, -1, 0, 1, 0, 1, 0, 0) * CFrame.fromEulerAnglesXYZ(0,0,0)
script.Parent.Parent.Torso[&quot;Right Shoulder&quot;].C1 = CFrame.new(-0.4, 0.5, 0, 0, 0, 1, 0, 1, 0, -1, -0, -0) * CFrame.fromEulerAnglesXYZ(0,0,0)
wait(0.05)
script.Parent.Parent.Torso[&quot;Left Shoulder&quot;].C1 = CFrame.new(0.4, 0.5, 0, -0, -0, -1, 0, 1, 0, 1, 0, 0) * CFrame.fromEulerAnglesXYZ(-math.pi/10,0,0)
script.Parent.Parent.Torso[&quot;Right Shoulder&quot;].C1 = CFrame.new(-0.4, 0.5, 0, 0, 0, 1, 0, 1, 0, -1, -0, -0) * CFrame.fromEulerAnglesXYZ(-math.pi/10,0,0)
wait(0.05)
script.Parent.Parent.Torso[&quot;Left Shoulder&quot;].C1 = CFrame.new(0.4, 0.5, 0, -0, -0, -1, 0, 1, 0, 1, 0, 0) * CFrame.fromEulerAnglesXYZ(-math.pi/6,0,0)
script.Parent.Parent.Torso[&quot;Right Shoulder&quot;].C1 = CFrame.new(-0.4, 0.5, 0, 0, 0, 1, 0, 1, 0, -1, -0, -0) * CFrame.fromEulerAnglesXYZ(-math.pi/6,0,0)
wait(0.2)
script.Parent.Parent.Humanoid.WalkSpeed = 0
wait(0.15)
script.Parent.ChargeActive.Value = false
script.Parent.Parent.Humanoid.WalkSpeed = 16
script.Parent.Parent.Torso[&quot;Left Shoulder&quot;].C1 = CFrame.new(0.4, 0.5, 0, -0, -0, -1, 0, 1, 0, 1, 0, 0) * CFrame.fromEulerAnglesXYZ(math.pi/16,0,0)
script.Parent.Parent.Torso[&quot;Right Shoulder&quot;].C1 = CFrame.new(-0.4, 0.5, 0, 0, 0, 1, 0, 1, 0, -1, -0, -0) * CFrame.fromEulerAnglesXYZ(math.pi/16,0,0)
wait(0.5)
deb = true
wait(1.5)
deb3 = true
elseif key == &quot;e&quot; then
	blocking = not blocking
	if blocking == false then
	deb = false
	deb2 = false
	script.Parent.Blocking.Value = true
	script.Parent.Parent.Torso[&quot;Left Shoulder&quot;].C1 = CFrame.new(0.4, 0.5, 0, -0, -0, -1, 0, 1, 0, 1, 0, 0) * CFrame.fromEulerAnglesXYZ(0,0,0)
	script.Parent.Parent.Torso[&quot;Right Shoulder&quot;].C1 = CFrame.new(-0.4, 0.5, 0, 0, 0, 1, 0, 1, 0, -1, -0, -0) * CFrame.fromEulerAnglesXYZ(0,0,0)
	wait(0.05)
	script.Parent.Parent.Torso[&quot;Left Shoulder&quot;].C1 = CFrame.new(0.4, 0.5, 0, -0, -0, -1, 0, 1, 0, 1, 0, 0) * CFrame.fromEulerAnglesXYZ(-math.pi/16,0,0)
	script.Parent.Parent.Torso[&quot;Right Shoulder&quot;].C1 = CFrame.new(-0.4, 0.5, 0, 0, 0, 1, 0, 1, 0, -1, -0, -0) * CFrame.fromEulerAnglesXYZ(-math.pi/16,0,0)
	wait(0.05)
