						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">WeldScript</string>
						<string name="Source">function onChanged()
	local w1 = Instance.new(&quot;Weld&quot;)
	w1.Parent = script.Parent.Handle
	w1.Part0 = w1.Parent
	w1.Part1 = script.Parent.Handle2
	w1.C1 = CFrame.new(-0, 8, -0.1)

--script.Parent.Handle2.Transparency = 0.5
end
script.Parent.AncestryChanged:connect(onChanged)</string>
