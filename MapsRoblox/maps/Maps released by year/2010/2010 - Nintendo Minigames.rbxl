				<Item class="Script" referent="RBX4810">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">GameScript</string>
						<string name="Source">win = false
function onFinishTouch(part)
	h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
	if h ~= nil and h.Parent:findFirstChild(&quot;Stun&quot;) == nil and win == false then
		win = true
		script.Parent.Winner.Value = h.Parent.Name -- We have found a winner :D
		end
	end

function setTraps(model)
	local things = model:GetChildren()
	for i=1,#things do
		if things[i].className == &quot;Part&quot; then
			local m = math.random(1,20)
			if m &lt; 3 then
				local enemy = Instance.new(&quot;Part&quot;)
				enemy.CFrame = things[i].CFrame * CFrame.new(0,10,0)
				enemy.BrickColor = BrickColor.new(21)
				enemy.CanCollide = false
				enemy.TopSurface = &quot;Smooth&quot;
				enemy.BottomSurface = &quot;Smooth&quot;
				enemy.Size = Vector3.new(5,5,5)
				enemy.Parent = script.Parent
				local thingy = script.OhNoes:clone()
				thingy.Disabled = false
				thingy.Parent = enemy

				elseif m &gt; 16 then
				things[i].TopSurface = &quot;Studs&quot;
				local crud = script.Trap:clone()
				crud.Disabled = false
				crud.Parent = things[i]

				end
			end
		end
	end

local models = script.Parent:GetChildren()
for i=1,#models do
	if models[i].Name == &quot;Track&quot; and models[i].className == &quot;Model&quot; then
		setTraps(models[i])
		end
	end

script.Parent.Finish.Touched:connect(onFinishTouch)
wait(7)

</string>
						<bool name="archivable">true</bool>
					</Properties>
					<Item class="Script" referent="RBX4811">
						<Properties>
							<bool name="Disabled">true</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">OhNoes</string>
							<string name="Source">cframe1 = script.Parent.CFrame * CFrame.new(8,0,0)
cframe2 = script.Parent.CFrame * CFrame.new(-8,0,0)
local bp = Instance.new(&quot;BodyPosition&quot;)
bp.Parent = script.Parent
bp.position = script.Parent.Position
bp.maxForce = Vector3.new(0,10000000000,0)


function onTouched(part)
	if part.Parent ~= nil then
	local humanoid = part.Parent:findFirstChild(&quot;Humanoid&quot;)

	if humanoid ~= nil and game.Players:findFirstChild(part.Parent.Name) ~= nil and part.Parent:findFirstChild(&quot;Stun&quot;) == nil then
		local s = script.Stun:clone()
		s.Disabled = false
		s.Parent = part.Parent
		--tagHumanoid(humanoid)
		--humanoid:TakeDamage(damage)
		--untagHumanoid(humanoid)
	end

	end
end

script.Parent.Touched:connect(onTouched)

while true do
	n = 0
	while n &lt; 5 do
		n = n + .1
		script.Parent.CFrame = script.Parent.CFrame * CFrame.new(0,0,.6)
		wait()
		end
	wait(1)
	n = 0
	while n &lt; 5 do
		n = n + .1
		script.Parent.CFrame = script.Parent.CFrame * CFrame.new(0,0,-.6)
		wait()
		end
	n = 0
	while n &lt; 5 do
		n = n + .1
		script.Parent.CFrame = script.Parent.CFrame * CFrame.new(0,0,-.6)
		wait()
		end
	wait(1)
	n = 0
	while n &lt; 5 do
		n = n + .1
		script.Parent.CFrame = script.Parent.CFrame * CFrame.new(0,0,.6)
		wait()
		end
	end
