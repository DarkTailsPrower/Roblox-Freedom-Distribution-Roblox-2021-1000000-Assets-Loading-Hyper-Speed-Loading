			<Item class="Script" referent="RBX1285">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Generator</string>
					<string name="Source">debounce = false

function onTouch(part)
	h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
	if h ~= nil and debounce == false then
		debounce = true
		speed = game.Lighting.Speedy
		regular = game.Lighting.Regular
		block = game.Lighting.Block
		recent = script.Parent.Parent.Recent
		m = math.random(1,3)
		if m &lt; 2 then
			s = speed:clone()
			s.Parent = script.Parent.Parent
			n = math.random(1,2)
			if n &gt; 1 then
				s.CFrame = s.CFrame * CFrame.fromEulerAnglesXYZ(0,math.pi,0) -- Backwards
				end
			s.Position = recent.Position + Vector3.new(0,0,35)
			recent.Name = &quot;Part&quot;
			s.Name = &quot;Recent&quot;
			brick = s
			else
			r = regular:clone()
			r.Parent = script.Parent.Parent
			r.Position = recent.Position + Vector3.new(0,0,35)
			recent.Name = &quot;Part&quot;
			r.Name = &quot;Recent&quot;
			brick = r
			end
		b = block:clone()
		b.Parent = script.Parent.Parent
		b.Position = brick.Position + Vector3.new(math.random(-50,50),3,math.random(-5,5))
		wait(3)
		script.Parent.Anchored = false
		end
	end

script.Parent.Touched:connect(onTouch)</string>
