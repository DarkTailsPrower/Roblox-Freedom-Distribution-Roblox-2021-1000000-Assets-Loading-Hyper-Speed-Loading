			<Item class="LocalScript" referent="RBX8269">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">PaintballShooter</string>
					<string name="Source">Tool = script.Parent



colors = {24,22}

function fire(v)
   cam = game.Workspace.CurrentCamera
	local noise = Vector3.new(math.random() - .1, math.random() - .1, math.random() - .1).unit
	v = (v + (noise * .05)).unit


	Tool.Parent.Torso[&quot;Right Shoulder&quot;].DesiredAngle = 8			--moves your arm as if firing.
	Tool.Handle.Fire:play()
	



	local vCharacter = Tool.Parent

	local vPlayer = game.Players:playerFromCharacter(vCharacter)



	local missile = Instance.new(&quot;Part&quot;)

        
	local spawnPos = Tool.Handle.Position
	


	spawnPos  = spawnPos + (v * 8)

	missile.Position = spawnPos
	missile.Size = Vector3.new(1,1,1)
	missile.Velocity = v * 500
	missile.BrickColor = BrickColor.new(colors[math.random(1, #colors)])
	missile.Shape = 1
	missile.BottomSurface = 0
	missile.TopSurface = 0
	missile.Name = &quot;Paintball&quot;
	missile.Elasticity = 0
	missile.Reflectance = 0.2
	missile.Friction = .3

	local force = Instance.new(&quot;BodyForce&quot;)
	force.force = Vector3.new(0,220,0)
	force.Parent = missile
	

	local new_script = script.Parent.Paintball:clone()
	new_script.Disabled = false
	new_script.Parent = missile

	local creator_tag = Instance.new(&quot;ObjectValue&quot;)
	creator_tag.Value = vPlayer
	creator_tag.Name = &quot;creator&quot;
	creator_tag.Parent = missile
	
	missile.Parent = workspace

   local cam_rot = cam.CoordinateFrame - cam.CoordinateFrame.p
	local cam_scroll = (cam.CoordinateFrame.p - cam.Focus.p).magnitude
	local ncf = CFrame.new(cam.Focus.p)*cam_rot*CFrame.fromEulerAnglesXYZ(0.3, 0, 0)
   cam.CoordinateFrame = ncf*CFrame.new(0, 0, cam_scroll)
        end






Tool.Enabled = true

function onActivated()



	if not Tool.Enabled then

		return

	end



	Tool.Enabled = false

	local character = Tool.Parent;

	local humanoid = character.Humanoid

	if humanoid == nil then

		print(&quot;Humanoid not found&quot;)

		return 

	end



	local targetPos = humanoid.TargetPoint

	local lookAt = (targetPos - character.Head.Position).unit



	fire(lookAt)



	for i = 1,6 do
   cam = game.Workspace.CurrentCamera
   local cam_rot = cam.CoordinateFrame - cam.CoordinateFrame.p
	local cam_scroll = (cam.CoordinateFrame.p - cam.Focus.p).magnitude
	local ncf = CFrame.new(cam.Focus.p)*cam_rot*CFrame.fromEulerAnglesXYZ(-0.05, 0, 0)
   cam.CoordinateFrame = ncf*CFrame.new(0, 0, cam_scroll)
	wait(.015)
	end



	Tool.Enabled = true
end
local arms = nil
local torso = nil
local welds = {}

function onkeydown(key)
cam = workspace.CurrentCamera
p = game.Players.LocalPlayer.Character.Humanoid
if key == &quot;q&quot; and cam.CameraSubject == p then
cam.CameraSubject = Tool.Scope
cam.CameraType = &quot;Attach&quot;
elseif key == &quot;q&quot; and cam.CameraSubject == Tool.Scope then
cam.CameraSubject = p
cam.CameraType = &quot;Custom&quot;
end
end

function Equip(mouse)
mouse.KeyDown:connect(onkeydown)
wait(0.01)
arms = {Tool.Parent:FindFirstChild(&quot;Left Arm&quot;), Tool.Parent:FindFirstChild(&quot;Right Arm&quot;)}
torso = Tool.Parent:FindFirstChild(&quot;Torso&quot;)
if arms ~= nil and torso ~= nil then
local sh = {torso:FindFirstChild(&quot;Left Shoulder&quot;), torso:FindFirstChild(&quot;Right Shoulder&quot;)}
if sh ~= nil then
local yes = true
if yes then
yes = false
sh[1].Part1 = nil
sh[2].Part1 = nil
local weld1 = Instance.new(&quot;Weld&quot;)
weld1.Part0 = torso
weld1.Parent = torso
weld1.Part1 = arms[1]
weld1.C1 = CFrame.new(-0.249, .7, 0.6) * CFrame.fromEulerAnglesXYZ(math.rad(320), 0, math.rad(-100))
welds[1] = weld1
local weld2 = Instance.new(&quot;Weld&quot;)
weld2.Part0 = torso
weld2.Parent = torso
weld2.Part1 = arms[2]
weld2.C1 = CFrame.new(-1, 0.5, 0.35) * CFrame.fromEulerAnglesXYZ(math.rad(-90), 0, 0)
welds[2] = weld2
arm1 = arms[1]:Clone()
local p = Instance.new(&quot;Weld&quot;, arm1)
p.Part0 = arm1
p.Part1 = arms[1]
arm2 = arms[2]:Clone()
local p = Instance.new(&quot;Weld&quot;, arm2)
p.Part0 = arm2
p.Part1 = arms[2]
mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
end
else
print(&quot;sh&quot;)
end
else
print(&quot;arms&quot;)
end
sonio = game.Players.LocalPlayer.Character

right = sonio[&quot;Right Arm&quot;]:clone()
right.Transparency = .45
right.CFrame = sonio[&quot;Right Arm&quot;].CFrame
right.Parent = Tool
rightw = Instance.new(&quot;Weld&quot;, right)
rightw.Part0 = sonio[&quot;Right Arm&quot;]
rightw.Part1 = right

left = sonio[&quot;Right Arm&quot;]:clone()
left.Transparency = .45
left.CFrame = sonio[&quot;Left Arm&quot;].CFrame
left.Parent = Tool
leftw = Instance.new(&quot;Weld&quot;, left)
leftw.Part0 = sonio[&quot;Left Arm&quot;]
leftw.Part1 = left
end

function Unequip(mouse)
if arms ~= nil and torso ~= nil then
local sh = {torso:FindFirstChild(&quot;Left Shoulder&quot;), torso:FindFirstChild(&quot;Right Shoulder&quot;)}
if sh ~= nil then
local yes = true
if yes then
yes = false
sh[1].Part1 = arms[1]
sh[2].Part1 = arms[2]
welds[1].Parent = nil
welds[2].Parent = nil
arm1 = nil
arm2 = nil
end
else
print(&quot;sh&quot;)
end
else
print(&quot;arms&quot;)
end
end

Tool.Equipped:connect(Equip)
Tool.Unequipped:connect(Unequip)
script.Parent.Activated:connect(onActivated)



