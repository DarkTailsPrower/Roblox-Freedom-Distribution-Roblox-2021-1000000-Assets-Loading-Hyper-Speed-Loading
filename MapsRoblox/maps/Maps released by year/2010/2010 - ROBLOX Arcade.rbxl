					<Item class="Script" referent="RBX7313">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">DigitScript</string>
							<ProtectedString name="Source">--- LED script by Telamon. Direct questions to the creations forum. 

local d = script.Parent

-- shades of EE labs...
local LEDs = {d.P1, d.P2, d.P3, d.P4, d.P5, d.P6, d.P7}

-- Transparency values for different numbers - confusing because it is the negation of the boolean &quot;on&quot; == true == 1
local on = 0
local off = 1

-- MUX -- If you want to understand this, draw it out
local c0 = {on, on, on, off, on, on, on}
local c1 = {off, off, on, off, off, on, off}
local c2 = {on, off, on, on, on, off, on}
local c3 = {on, off, on, on, off, on, on}
local c4 = {off, on, on, on,  off, on,  off}
local c5 = {on, on,  off, on,  off, on, on}
local c6 = {on, on,  off, on, on, on, on}
local c7 = {on,  off, on,  off,  off, on,  off}
local c8 = {on, on, on, on, on, on, on}
local c9 = {on, on, on, on,  off, on, on}
local cNone = { off, off, off, off, off, off, off}

local states = {c0, c1, c2, c3, c4, c5, c6, c7, c8, c9, cNone}

function display(num)
	print(num)
	local i = num + 1
	if i &lt; 1 or i &gt; #states then i = #states end

	-- think about how else you would do this, then realize how clever this is
	for p=1,#LEDs do
			LEDs[p].Transparency = states[i][p]
	end
	
end

function onDigitCommand(cmd)
	if cmd.className == &quot;IntValue&quot; then
		display(cmd.Value)
		cmd.Parent = nil
	end
end


script.Parent.ChildAdded:connect(onDigitCommand)</ProtectedString>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
				</Item>
				<Item class="Model" referent="RBX7314">
					<Properties>
