							<string name="Name">Script</string>
							<ProtectedString name="Source">function Sink(hit)
if hit.Name == &quot;Handle&quot; then
local a = script.Parent.Parent.Exit:clone()
a.Parent = game.Workspace 
a.Transparency = 0
a.BrickColor = BrickColor.new(&quot;Nougat&quot;)
a.Anchored = false 
a.CanCollide = true 
local b = game.Workspace.Tix.GetCash:Clone()
b.Parent = a 
v = Instance.new(&quot;BodyVelocity&quot;)
v.Name = &quot;remove&quot;
scr = script:findFirstChild(&quot;Erase&quot;):clone()
scr.Parent = hit
scr.Disabled = false
v.maxForce = v.maxForce*9999999
v.velocity = Vector3.new(0, -1.5, 0)
v.Parent = hit
wait(5)
hit:remove()
end
end 

script.Parent.Touched:connect(Sink)
</ProtectedString>
