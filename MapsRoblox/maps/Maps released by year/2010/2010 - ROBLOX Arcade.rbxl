						<string name="Name">Script</string>
						<ProtectedString name="Source">bin = script.Parent
box = game.Workspace.DigDug

local flipper = script.Parent
local ff = game.Workspace.BodyForce

local ballsource = game.Workspace.DigDug.Tixmaker

local ball = game.Workspace.Tix:clone()


function getBallSourcePos()
	return Vector3.new(ballsource.Position.x, ballsource.Position.y, ballsource.Position.z)
end

local debounce = false
function onClicked(mouse)
	if debounce == true then return end

	debounce = true
	flipper.BrickColor = BrickColor.new(23)
	
	box.P12.BrickColor = BrickColor.new(21)
	box.P13.BrickColor = BrickColor.new(1)
	box.P37.BrickColor = BrickColor.new(18)
	box.P45.BrickColor = BrickColor.new(18)

	if box.P11.BrickColor == BrickColor.new(37) then
	
	wait(0.5)
	box.P12.BrickColor = BrickColor.new(226)
	box.P13.BrickColor = BrickColor.new(226)
	box.P37.BrickColor = BrickColor.new(18)
	box.P45.BrickColor = BrickColor.new(18)
	wait(0.1)

	local b = ball:clone()
	b.Position = getBallSourcePos()
	b.Parent = game.Workspace

	debounce = false
	flipper.BrickColor = BrickColor.new(1)

	else

	wait(0.5)
	box.P12.BrickColor = BrickColor.new(226)
	box.P13.BrickColor = BrickColor.new(226)
	box.P37.BrickColor = BrickColor.new(18)
	box.P45.BrickColor = BrickColor.new(18)

	debounce = false
	flipper.BrickColor = BrickColor.new(1)
	end
end


bin.ClickDetector.MouseClick:connect(onClicked)</ProtectedString>
