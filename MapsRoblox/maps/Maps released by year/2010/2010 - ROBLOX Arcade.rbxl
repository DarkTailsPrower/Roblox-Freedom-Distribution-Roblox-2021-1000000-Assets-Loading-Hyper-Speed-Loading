						<string name="Name">CamChanger</string>
						<ProtectedString name="Source">wait(0.2)
while true do
wait()
if script.Parent.Parent.Character.Humanoid.Sit == true then
game.Workspace.CurrentCamera.CameraSubject = script.Parent.Parent.Character.Humanoid
game.Workspace.CurrentCamera.CameraType = &quot;Custom&quot;
torso = script.Parent.Parent.Character.Torso
anim = script.Parent.Parent.Character:findFirstChild(&quot;Animation&quot;)
if anim ~= nil then
anim.Parent = script
end
torso[&quot;Left Shoulder&quot;].DesiredAngle = 0
torso[&quot;Right Shoulder&quot;].DesiredAngle = -0
torso[&quot;Left Hip&quot;].DesiredAngle = 0
torso[&quot;Right Hip&quot;].DesiredAngle = 0
elseif script.Parent.Parent.Character.Humanoid.Sit == false then
game.Workspace.CurrentCamera.CameraSubject = script.Parent.Parent.Character.Humanoid
game.Workspace.CurrentCamera.CameraType = &quot;Custom&quot;
anim = script:findFirstChild(&quot;Animation&quot;)
if anim ~= nil then
anim.Parent = script.Parent.Parent.Character
end
script:remove()
end
end
