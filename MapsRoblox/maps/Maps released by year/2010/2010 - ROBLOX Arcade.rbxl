							<string name="Name">Script</string>
							<ProtectedString name="Source">local drink = game.Lighting.Ball
local spot = script.Parent.Parent.Holder2
local db = false

function onClick()
	if db == false then
		db = true
		local d = drink:clone()
		d.Handle.Position = spot.Position
		d.Handle.Anchored = false
		d.Parent = game.Workspace
		wait(5)
		db = false
	end
end

