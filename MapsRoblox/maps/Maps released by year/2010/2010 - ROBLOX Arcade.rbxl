						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Conversation</string>
						<ProtectedString name="Source">p = script.Parent.Parent
clicker = script.Parent.ClickDetector
function onClicked(mouse)
clicker.MaxActivationDistance = 0 --Do not change but you can delete if you remove the one below
p.Name = (&quot;Hello good sir!&quot;) --Change to what you want the first sentence to be
wait(5) --Change wait time if you want to
p.Name = (&quot;I am a pretty princess!&quot;)-- Change to the second sentence you want it to say
wait(5) --Change wait time if you want to
p.Name = (&quot;A pretty princess named Harold!&quot;)--Change to the third sentence you want it to say
wait(5) --Change wait time if you want to
p.Name = (&quot;Do you like rainbows? I like rainbows.&quot;) --Change to the fourth sentence you want it to say
wait(5) --Change wait time if you want to
p.Name = (&quot;Well bye bye!&quot;) --Change to the fifth sentence you want it to say
wait(5) --Change wait time if you want to
clicker.MaxActivationDistance = 32 --Do not change but you can delete if you remove the one above
p.Name = (&quot;Harold the Talking Brick&quot;)--Change to the name of the model that this brick is in so that it returns to the original name
end
script.Parent.ClickDetector.MouseClick:connect(onClicked)
--by devjin1
--Feel free to delete any sentences that you don&apos;t want, just delete the line and the &apos;wait()&apos; after it
--You can also change the size and color of the brick if you want to.
--No credits needed, but if you want to add a hint credit feel free to :)</ProtectedString>
