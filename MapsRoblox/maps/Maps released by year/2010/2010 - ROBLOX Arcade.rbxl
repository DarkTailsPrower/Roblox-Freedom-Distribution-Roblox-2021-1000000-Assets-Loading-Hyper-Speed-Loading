		<Item class="Script" referent="RBX2639">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">onEnter</string>
				<ProtectedString name="Source">local playr = game.Players.LocalPlayer

function onPlayerRespawned(newPlayer)
newPlayer.Character.Health:remove()
newPlayer.Character.HealthScript v2.0:remove()
newPlayer.Character.Head.CanCollide = true
newPlayer.Character.Torso.CanCollide = true
newPlayer.Character.Left Arm.CanCollide = true
newPlayer.Character.Right Arm.CanCollide = true
newPlayer.Character.Left Leg.CanCollide = true
newPlayer.Character.Right Leg.CanCollide = true

end

function onPlayerEntered(newPlayer)
	newPlayer.Changed:connect(function (property)
		if (property == &quot;Character&quot;) then
			onPlayerRespawned(newPlayer)
		end
	end)
end

game.Players.PlayerAdded:connect(onPlayerEntered)</ProtectedString>
				<bool name="archivable">true</bool>
			</Properties>
