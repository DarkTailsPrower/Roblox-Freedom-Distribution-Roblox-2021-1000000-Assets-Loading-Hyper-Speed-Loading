							<bool name="Looped">false</bool>
							<string name="Name">EatSound2</string>
							<float name="Pitch">1</float>
							<bool name="PlayOnRemove">false</bool>
							<Content name="SoundId"><url>http://www.roblox.com/asset/?id=13075805</url></Content>
