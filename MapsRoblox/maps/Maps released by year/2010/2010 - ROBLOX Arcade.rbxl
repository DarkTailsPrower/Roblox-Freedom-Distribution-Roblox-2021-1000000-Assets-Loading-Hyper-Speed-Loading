				<Item class="Script" referent="RBX11325">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">bin = script.Parent
box = script.Parent.Parent

local flipper = script.Parent
local ff = game.Workspace.BodyForce

local ballsource = script.Parent.Parent.Tixmaker

local ball = game.Workspace.Tix10:clone()


function getBallSourcePos()
	return Vector3.new(ballsource.Position.x, ballsource.Position.y, ballsource.Position.z)
end

local debounce = false
function onClicked(mouse)
	if debounce == true then return end

	debounce = true
	flipper.BrickColor = BrickColor.new(21)
	
	box.S1.BrickColor = BrickColor.new(106)
	wait(0.1)
	box.S1.BrickColor = BrickColor.new(26)
	box.S2.BrickColor = BrickColor.new(106)
	wait(0.1)
	box.S2.BrickColor = BrickColor.new(26)
	box.S3.BrickColor = BrickColor.new(106)
	wait(0.1)
	box.S3.BrickColor = BrickColor.new(26)
	box.S4.BrickColor = BrickColor.new(106)
	wait(0.1)
	box.S4.BrickColor = BrickColor.new(26)
	box.S5.BrickColor = BrickColor.new(106)
	wait(0.1)
	box.S5.BrickColor = BrickColor.new(26)
	box.S6.BrickColor = BrickColor.new(106)
	wait(0.1)
	box.S6.BrickColor = BrickColor.new(26)
	box.S7.BrickColor = BrickColor.new(106)
	wait(0.1)
	box.S7.BrickColor = BrickColor.new(26)

	if box.B3.BrickColor == BrickColor.new(23) then

	wait(0.1)
	box.B3.BrickColor = BrickColor.new(21)
	box.Y3.BrickColor = BrickColor.new(21)
	wait(0.3)
	box.B3.BrickColor = BrickColor.new(26)
	box.Y3.BrickColor = BrickColor.new(26)
	wait(0.1)

	local b = ball:clone()
	b.Position = getBallSourcePos()
	b.Parent = game.Workspace

	debounce = false
	flipper.BrickColor = BrickColor.new(28)

	else

	box.B3.BrickColor = BrickColor.new(106)
	wait(0.1)
	box.B3.BrickColor = BrickColor.new(26)
	box.Y3.BrickColor = BrickColor.new(106)
	wait(0.1)
	box.Y3.BrickColor = BrickColor.new(26)
	box.Y3.BrickColor = BrickColor.new(26)
	box.S10.BrickColor = BrickColor.new(106)
	wait(0.1)
	box.S10.BrickColor = BrickColor.new(26)
	wait(0.1)

	debounce = false
	flipper.BrickColor = BrickColor.new(28)
	end
end


bin.ClickDetector.MouseClick:connect(onClicked)</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
