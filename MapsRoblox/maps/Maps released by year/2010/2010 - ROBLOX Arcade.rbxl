				<Item class="Script" referent="RBX12597">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">DMLScript</string>
						<ProtectedString name="Source">local Tool = script.Parent;
enabled = true

function onActivated()
   if not enabled  then
      return
   end
   enabled = false
   Tool.GripForward = Vector3.new(0.675, -0.675, -0.3)
   Tool.GripPos = Vector3.new(0.4, -0.59, 1.1)
   Tool.GripRight = Vector3.new(0.212, -0.212, 0.954)
   Tool.GripUp = Vector3.new(0.707, 0.707, 0)
   Tool.Handle.EatSound:Play()
   wait(.8)
      local h = Tool.Parent:FindFirstChild(&quot;Humanoid&quot;)
      if (h ~= nil) then
         if (Tool.Parent:FindFirstChild(&quot;ChickenEffect&quot;) == nil) then
            local s = script.Parent.ChickenEffect:Clone()
            s.Disabled = false
            local TMesh = Tool.Handle.Mesh:clone()
            TMesh.Parent = s
            TMesh.Scale = Vector3.new(3,3,3)
            local Tsound = Tool.Handle.OpenSound:clone()
            Tsound.PlayOnRemove = true
            Tsound.Volume = 10
            Tsound.Parent = Tool.Parent.Head
            s.Parent = Tool.Parent			
         end
      end
   Tool.GripForward = Vector3.new(-0.976,0,-0.217)
   Tool.GripPos = Vector3.new(0, -0.4, 0)
   Tool.GripRight = Vector3.new(0.217,0,-0.976)
   Tool.GripUp = Vector3.new(0,1,0)
   enabled = true
end

function onEquipped()
   Tool.Handle.OpenSound:play()
end

script.Parent.Activated:connect(onActivated)
script.Parent.Equipped:connect(onEquipped)</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX12598">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">ChickenEffect</string>
						<ProtectedString name="Source">-- assume we are in the character, let&apos;s check
function sepuku()
	script.Parent = nil
end
local h = script.Parent:FindFirstChild(&quot;Humanoid&quot;)
if (h == nil) then sepuku() end

local d = script.Parent:GetChildren()
for i = 1, #d do
   if d[i].Name == &quot;Left Leg&quot; or d[i].Name == &quot;Right Leg&quot; then
      d[i].BrickColor = BrickColor.new(&quot;Bright yellow&quot;)
      d[i].Material = &quot;Slate&quot;
   elseif d[i].Name == &quot;Left Arm&quot; or d[i].Name == &quot;Right Arm&quot; then
      d[i].BrickColor = BrickColor.new(&quot;Bright yellow&quot;)
      d[i].Material = &quot;Slate&quot;
   elseif d[i].Name == &quot;Head&quot; or d[i].Name == &quot;Torso&quot; then
      d[i].BrickColor = BrickColor.new(&quot;Bright yellow&quot;)
      d[i].Material = &quot;Slate&quot;
      local TS = d[i]:findFirstChild(&quot;roblox&quot;)
      if TS ~= nil then TS:remove() end
      local TS2 = script.Parent:findFirstChild(&quot;Shirt Graphic&quot;)
      if TS2 ~= nil then TS2:remove() end
      if d[i].Name == &quot;Head&quot; then script.MeshCHICKEN:clone().Parent = d[i] end
      if d[i].Name == &quot;Torso&quot; then if d[i]:findFirstChild(&quot;Neck&quot;)~= nil then d[i]:findFirstChild(&quot;Neck&quot;).C0 = d[i]:findFirstChild(&quot;Neck&quot;).C0 * CFrame.new(0,0,0.5) end end
   elseif d[i].Name == &quot;Shirt&quot; then
      d[i].Parent = nil
   elseif d[i].Name == &quot;Pants&quot; then
      d[i].Parent = nil
   end
   if d[i].className == &quot;Hat&quot; then
      d[i].Parent = nil
   elseif d[i].className == &quot;Part&quot; then
      d[i].Material = &quot;Slate&quot;
      d[i].BrickColor = BrickColor.new(&quot;Bright yellow&quot;)
   end
end 

wait(10)
local d = script.Parent:GetChildren()
for i = 1, #d do 
   if d[i].className == &quot;Part&quot; then
      if d[i].Name == &quot;Left Leg&quot; or d[i].Name == &quot;Right Leg&quot; then
         script.Mesh:clone().Parent = d[i]
      else
         d[i].Parent = nil
      end
   end
end </ProtectedString>
