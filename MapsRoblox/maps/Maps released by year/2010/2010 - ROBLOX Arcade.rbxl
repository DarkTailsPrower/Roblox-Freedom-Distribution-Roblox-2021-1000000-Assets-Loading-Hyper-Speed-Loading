								<ProtectedString name="Source">bin = script.Parent
type = 1
blah = false
M = Instance.new(&quot;Message&quot;)
M.Name = &quot;RunMessage&quot;

function keepRecord()
	while (game.Players.LocalPlayer == nil) do
	wait()
	end
	while (game.Players.LocalPlayer.Character == nil) do
	wait()
	end
	player = game.Players.LocalPlayer
	v = player:findFirstChild(&quot;RunRecord&quot;)
	if (v == nil) then
		V = Instance.new(&quot;NumberValue&quot;)
		V.Name = &quot;RunRecord&quot;
		V.Parent = player
	end
end

function returnRecord()
	local player = game.Players.LocalPlayer
	v = player:findFirstChild(&quot;RunRecord&quot;)
	if (v ~= nil) then
		if (v.Value == 1) then
			startAnimation(&quot;Normal&quot;)
			type = 1
		end
		if (v.Value == 2) then
			startAnimation(&quot;NoAnimation&quot;)
			type = 2
		end 
		if (v.Value == 3) then
			startAnimation(&quot;Fast&quot;)
			type = 3
		end 
		if (v.Value == 4) then
			startAnimation(&quot;ArmsUp&quot;)
			type = 4
		end
		if (v.Value == 5) then
			startAnimation(&quot;Super&quot;)
			type = 5
		end 
		if (v.Value == 6) then
			startAnimation(&quot;OneFoot&quot;)
			type = 6
		end 
		if (v.Value == 7) then
			startAnimation(&quot;Floating&quot;)
			type = 7
		end 
	end
end

function showMessage(message) 
	local player = game.Players.LocalPlayer
	if (M.Name == &quot;RunMessage&quot;) then
		M.Parent = player
		M.Text = message
	end
end 

function noMessage()
	local player = game.Players.LocalPlayer
	local M = player:findFirstChild(&quot;RunMessage&quot;)
	if (M ~= nil) then
		M.Parent = nil
	end
end

function diedMessage()
	M.Name = &quot;Void&quot;
	M.Parent = nil
end 

function startAnimation(Type)
	local player = game.Players.LocalPlayer
	if (player == nil) then return end
	char = player.Character
	local M = Instance.new(&quot;Motor&quot;)
	Animate = char:findFirstChild(&quot;Animate&quot;)
	if (Animate ~= nil) then

		Animate:remove()
		A = bin.Types[Type]:clone()
		A.Disabled = false
		A.Name = &quot;Animate&quot;
		A.Parent = char

		Rshoulder = char.Torso:findFirstChild(&quot;Right Shoulder&quot;)
		Lshoulder = char.Torso:findFirstChild(&quot;Left Shoulder&quot;)
		Rhip = char.Torso:findFirstChild(&quot;Right Hip&quot;)
		Lhip = char.Torso:findFirstChild(&quot;Left Hip&quot;)
		if (Rshoulder ~= nil) then
			Rshoulder.MaxVelocity = 0.1
			Rshoulder.Parent = nil
			Rshoulder.Parent = char.Torso
		else
			MC = M:clone()
			MC.Parent = char.Torso
			MC.Name = &quot;Right Shoulder&quot;
		end
		if (Lshoulder ~= nil) then
			Lshoulder.MaxVelocity = 0.1
			Lshoulder.Parent = nil
			Lshoulder.Parent = char.Torso
		else
			MC = M:clone()
			MC.Parent = char.Torso
			MC.Name = &quot;Left Shoulder&quot;
		end
		if (Rhip ~= nil) then
			Rhip.MaxVelocity = 0.1
			Rhip.Parent = nil
			Rhip.Parent = char.Torso
		else
			MC = M:clone()
			MC.Parent = char.Torso
			MC.Name = &quot;Right Hip&quot;
		end
		if (Lhip ~= nil) then
			Lhip.MaxVelocity = 0.1
			Lhip.Parent = nil
			Lhip.Parent = char.Torso
		else
			MC = M:clone()
			MC.Parent = char.Torso
			MC.Name = &quot;Left Hip&quot;
		end
	end
end

function onButton1Down(mouse)
	local player = game.Players.LocalPlayer
	if (player == nil) then return end
	char = player.Character
	v = player:findFirstChild(&quot;RunRecord&quot;)
	animate = char:findFirstChild(&quot;Animate&quot;)
	if (animate ~= nil) and (v ~= nil) and (blah == false) then
		if (type == 1) and (blah == false) then
			type = 2
			v.Value = 2
			blah = true
			startAnimation(&quot;NoAnimation&quot;)
			showMessage(&quot;No Animation&quot;)
		end
		if (type == 2) and (blah == false) then
			type = 3
			v.Value = 3
			blah = true
			startAnimation(&quot;Fast&quot;)
			showMessage(&quot;Fast&quot;)
		end
		if (type == 3) and (blah == false) then
			type = 4
			v.Value = 4
			blah = true
			startAnimation(&quot;ArmsUp&quot;)
			showMessage(&quot;Arms Up&quot;)
		end
		if (type == 4) and (blah == false) then
			type = 5
			v.Value = 5
			blah = true
			startAnimation(&quot;Super&quot;)
			showMessage(&quot;Super&quot;)
		end
		if (type == 5) and (blah == false) then
			type = 6
			v.Value = 6
			blah = true
			startAnimation(&quot;OneFoot&quot;)
			showMessage(&quot;One-Foot&quot;)
		end
		if (type == 6) and (blah == false) then
			type = 7
			v.Value = 7
			blah = true
			startAnimation(&quot;Floating&quot;)
			showMessage(&quot;Floating&quot;)
		end
		if (type == 7) and (blah == false) then
			type = 1
			v.Value = 1
			blah = true
			startAnimation(&quot;Normal&quot;)
			showMessage(&quot;Normal&quot;)
		end
		blah = false
	end
end

function onSelected(mouse)
	local c = game.Players.LocalPlayer:GetChildren()
	for i = 1,#c do
		if c[i].className == &quot;Message&quot; or c[i].className == &quot;Hint&quot; then
			c[i]:Remove()
		end
	end
	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	local player = game.Players.LocalPlayer
	if (player == nil) then return end
	char = player.Character
	animate = char:findFirstChild(&quot;Animate&quot;)
	if (animate ~= nil) then
		if (type == 1) then
			showMessage(&quot;Normal&quot;)
		end
		if (type == 2) then
			showMessage(&quot;No Animation&quot;)
		end 
		if (type == 3) then
			showMessage(&quot;Fast&quot;)
		end 
		if (type == 4) then
			showMessage(&quot;Arms Up&quot;)
		end 
		if (type == 5) then
			showMessage(&quot;Super&quot;)
		end 
		if (type == 6) then
			showMessage(&quot;One-Foot&quot;)
		end 
		if (type == 7) then
			showMessage(&quot;Floating&quot;)
		end 
	end
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end 

bin.Selected:connect(onSelected)
bin.Deselected:connect(noMessage)
keepRecord()
returnRecord()
game.Players.LocalPlayer.Character.Humanoid.Died:connect(diedMessage)</ProtectedString>
