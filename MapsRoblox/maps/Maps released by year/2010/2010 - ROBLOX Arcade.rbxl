						<string name="Name">Script</string>
						<ProtectedString name="Source">crane = script.Parent
debounce = false

function onTouch(part)
	if not part.Parent then return end
	if part.Name == &quot;Handle&quot; and part:findFirstChild(&quot;BodyPosition&quot;) == nil and debounce == false then
		debounce = true
		part:breakJoints()
		bp = Instance.new(&quot;BodyPosition&quot;)
		bp.Parent = part
		bp.maxForce = Vector3.new(1000000000,1000000000,1000000000)
		timer = 5
		while timer &gt; 0 do
		bp.position = script.Parent.Position - Vector3.new(0,2,0)
		wait(.1)
		timer = timer - .1
		end
		bp:remove()
		debounce = false
		end
	end

script.Parent.Touched:connect(onTouch)</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
			<Item class="Script" referent="RBX1577">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">CraneScript</string>
					<ProtectedString name="Source">--xZeroKoolx go to the brick called Crane pix that

coinslot = script.Parent[&quot;Crane Game (1 Ticket per round)&quot;].Head
down = script.Parent.Down
up = script.Parent.Up
left = script.Parent.Left
right = script.Parent.Right
obtain = script.Parent.Obtain
crane = script.Parent.Crane
original = crane.Position

going = false
movedown = false
moveup = false
moveleft = false
moveright = false
obtaining = false

function resetReflectances()
	up.Reflectance = 0
	down.Reflectance = 0
	left.Reflectance = 0
	right.Reflectance = 0
	movedown = false
	moveup = false
	moveleft = false
	moveright = false
	end

function onSlotTouch(part)
	if part.Parent ~= nil then
		h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
		if h ~= nil then
			player = game.Players:findFirstChild(h.Parent.Name)
			coins = player.leaderstats.Tickets
			if coins.Value &gt; 0 then
			if player ~= nil and going == false then
				script.Parent.TheGuy.Value = player
				going = true
				coins.Value = coins.Value - 1
				coinslot.Reflectance = 1
				down.BrickColor = BrickColor.new(1)
				up.BrickColor = BrickColor.new(1)
				left.BrickColor = BrickColor.new(1)
				right.BrickColor = BrickColor.new(1)
				obtain.BrickColor = BrickColor.new(1)
				end
				end
			end
		end
	end

coinslot.Touched:connect(onSlotTouch)

function onTriggerTouch(part)
	local tool = part.Parent
	if tool ~= nil then
		if tool.className == &quot;Tool&quot; then
			tool.Parent = script.Parent.TheGuy.Value.Backpack
			end
		end
	end

script.Parent.Trigger.Touched:connect(onTriggerTouch)

function onDownClick()
	if going == true and obtaining == false then
		if movedown == false then
			resetReflectances()
			movedown = true
			down.Reflectance = 1
			crane.BV.velocity = Vector3.new(0,0,2)
			elseif movedown == true then
			movedown = false
			down.Reflectance = 0
			crane.BV.velocity = Vector3.new(0,0,0)
			end
		end
	end

function onUpClick()
	if going == true and obtaining == false  then
		if moveup == false then
			resetReflectances()
			moveup = true
			up.Reflectance = 1
			crane.BV.velocity = Vector3.new(0,0,-2)
			elseif moveup == true then
			moveup = false
			up.Reflectance = 0
			crane.BV.velocity = Vector3.new(0,0,0)
			end
		end
	end

function onLeftClick()
	if going == true and obtaining == false  then
		if moveleft == false then
			resetReflectances()
			moveleft = true
			left.Reflectance = 1
			crane.BV.velocity = Vector3.new(-2,0,0)
			elseif moveleft == true then
			moveleft = false
			left.Reflectance = 0
			crane.BV.velocity = Vector3.new(0,0,0)
			end
		end
	end

function onRightClick()
	if going == true and obtaining == false  then
		if moveright == false then
			resetReflectances()
			moveright = true
			right.Reflectance = 1
			crane.BV.velocity = Vector3.new(2,0,0)
			elseif moveright == true then
			moveright = false
			right.Reflectance = 0
			crane.BV.velocity = Vector3.new(0,0,0)
			end
		end
	end

down.ClickDetector.MouseClick:connect(onDownClick)
up.ClickDetector.MouseClick:connect(onUpClick)
left.ClickDetector.MouseClick:connect(onLeftClick)
right.ClickDetector.MouseClick:connect(onRightClick)


function onObtainClick()
	if going == true then
		resetReflectances()
		obtaining = true
		down.BrickColor = BrickColor.new(26)
		up.BrickColor = BrickColor.new(26)
		left.BrickColor = BrickColor.new(26)
		right.BrickColor = BrickColor.new(26)
		obtain.Reflectance = 1
		crane.BP.position = crane.Position
		crane.BP.maxForce = Vector3.new(100000,0,100000)
		crane.BV.maxForce = Vector3.new(0,0,0)
		crane.BV.velocity = Vector3.new(0,0,0)
		wait(1)
		crane.BP.position = original
		crane.BP.maxForce = Vector3.new(0, 4e+008, 0)
		wait(1)
		crane.BP.maxForce = Vector3.new(4e+008, 4e+008, 4e+008)
		wait(2)
		crane.BP.maxForce = Vector3.new(0, 4e+008, 0)
		crane.BV.velocity = Vector3.new(0,0,0)
		crane.BV.maxForce = Vector3.new(4e+007, 4e+007, 4e+007)
		obtain.BrickColor = BrickColor.new(26)
		obtain.Reflectance = 0
		coinslot.Reflectance = 0
		wait(3)
		going = false
		obtaining = false
		end
	end

script.Parent.Obtain.ClickDetector.MouseClick:connect(onObtainClick)</ProtectedString>
