					<Item class="Script" referent="RBX7990">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">box = script.Parent.Parent

local flipper = script.Parent
local ff = game.Workspace.BodyForce

local debounce = false
function onTouch(part)
	if debounce == true then return end

	debounce = true
	flipper.BrickColor = BrickColor.new(26)
	
	box.P14.BrickColor = BrickColor.new(26)

	if box.P22.BrickColor == BrickColor.new(106) then
	
	wait(0.1)
	box.P14.BrickColor = BrickColor.new(24)
	box.P22.BrickColor = BrickColor.new(104)
	box.Points.Value.Value = box.Points.Value.Value + 1
	wait(0.1)
	box.P22.BrickColor = BrickColor.new(194)

	debounce = false
	flipper.BrickColor = BrickColor.new(106)

	else

	wait(0.1)
	box.P14.BrickColor = BrickColor.new(24)
	box.P22.BrickColor = BrickColor.new(26)
	wait(0.1)
	box.P22.BrickColor = BrickColor.new(194)

	debounce = false
	flipper.BrickColor = BrickColor.new(106)
	end
end


