						<Y>0</Y>
						<Z>0</Z>
						<R00>0.0721285865</R00>
						<R01>0</R01>
						<R02>-0.997395337</R02>
						<R10>-0</R10>
						<R11>1</R11>
						<R12>-0</R12>
						<R20>0.997395337</R20>
						<R21>0</R21>
						<R22>0.0721285865</R22>
					</CoordinateFrame>
					<string name="Name">ColaKing</string>
					<Content name="TextureId"><url>http://www.roblox.com/asset/?id=10499581</url></Content>
					<bool name="archivable">true</bool>
				</Properties>
				<Item class="LocalScript" referent="RBX5785">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Local Gui</string>
						<ProtectedString name="Source">local Tool = script.Parent;

enabled = true

function onButton1Down(mouse)
	if not enabled  then
		return
	end

	enabled = false
	Tool.GripForward = Vector3.new(0,-.759,-.651)
	Tool.GripPos = Vector3.new(1.5,-.5,.3)
	Tool.GripRight = Vector3.new(1,0,0)
	Tool.GripUp = Vector3.new(0,.651,-.759)
	wait(3)
	
	local h = Tool.Parent.Humanoid
	local s = Tool.Sparkles:clone()
	local f = Instance.new(&quot;ForceField&quot;)
	if (h ~= nil) then
		if (h.MaxHealth &gt; h.Health + 25) then
			h.Health = h.Health + 25
		else	
			h.Health = h.MaxHealth
		end
	end

	Tool.Parent.Humanoid.Health = Tool.Parent.Humanoid.Health + 1
	Tool.GripForward = Vector3.new(0.997, 0, -0.0721)
	Tool.GripPos = Vector3.new(0.03,0,0)
	Tool.GripRight = Vector3.new(0.0721, -0, 0.997)
	Tool.GripUp = Vector3.new(0,1,0)

	if (h ~= nil) then
		s.Parent = Tool.Parent.Torso
		h.WalkSpeed = 20
		f.Parent = Tool.Parent
		wait(6)
		s.Parent = nil
		f.Parent = nil
		h.WalkSpeed = 12
		wait(6)
		h.WalkSpeed = 16
	end

	enabled = true

end

function onEquippedLocal(mouse)

	if mouse == nil then
		print(&quot;Mouse not found&quot;)
		return 
	end

	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end


Tool.Equipped:connect(onEquippedLocal)
--Gtyler55
--&quot;SHOW ME YER MOVES!&quot;</ProtectedString>
