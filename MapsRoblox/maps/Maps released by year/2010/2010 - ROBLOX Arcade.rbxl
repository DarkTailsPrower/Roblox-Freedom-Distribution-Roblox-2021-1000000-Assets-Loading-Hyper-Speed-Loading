						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">bin = script.Parent
box = game.Workspace.Space

local flipper = script.Parent
local ff = game.Workspace.BodyForce

local ballsource = game.Workspace.Space.Tixmaker

local ball = game.Workspace.Tix:clone()


function getBallSourcePos()
	return Vector3.new(ballsource.Position.x, ballsource.Position.y, ballsource.Position.z)
end

local debounce = false
function onClicked(mouse)
	if debounce == true then return end

	debounce = true
	flipper.BrickColor = BrickColor.new(21)
	
	box.P21.BrickColor = BrickColor.new(24)
	box.P29.BrickColor = BrickColor.new(24)
	box.P37.BrickColor = BrickColor.new(24)
	box.P45.BrickColor = BrickColor.new(24)

	if box.P53.BrickColor == BrickColor.new(21) then
	
	wait(0.5)
	box.P21.BrickColor = BrickColor.new(26)
	box.P29.BrickColor = BrickColor.new(26)
	box.P37.BrickColor = BrickColor.new(26)
	box.P45.BrickColor = BrickColor.new(26)
	wait(0.1)

	local b = ball:clone()
	b.Position = getBallSourcePos()
	b.Parent = game.Workspace

	debounce = false
	flipper.BrickColor = BrickColor.new(119)

	else

	wait(0.5)
	box.P21.BrickColor = BrickColor.new(26)
	box.P29.BrickColor = BrickColor.new(26)
	box.P37.BrickColor = BrickColor.new(26)
	box.P45.BrickColor = BrickColor.new(26)

	debounce = false
	flipper.BrickColor = BrickColor.new(119)
	end
end


bin.ClickDetector.MouseClick:connect(onClicked)</ProtectedString>
