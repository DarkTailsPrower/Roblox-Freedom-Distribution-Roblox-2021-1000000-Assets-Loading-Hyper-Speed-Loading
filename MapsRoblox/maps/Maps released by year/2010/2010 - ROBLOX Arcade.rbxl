				<Item class="Script" referent="RBX4486">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Banana</string>
						<ProtectedString name="Source">banana = script.Parent
debounce = true
wait(1)

function Slippy(hit)
	local human = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
	local torso = hit.Parent:findFirstChild(&quot;Torso&quot;)
	local player = game.Players:findFirstChild(hit.Parent.Name)
	if (human ~= nil) and (torso ~= nil) and (debounce == true) then
		debounce = false
		human.Health = human.Health -10
		torso.RotVelocity = torso.CFrame * Vector3.new(0,0,100)
		wait(0.1)
		torso.RotVelocity = Vector3.new(0,0,0)
		torso.Velocity = Vector3.new(0,0,0)
		wait(0.5)
		banana:remove()
	end
end

banana.Touched:connect(Slippy)
wait(10)
banana:remove()</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX4487">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">PlantBanana</string>
						<ProtectedString name="Source">BananaScript = script.Parent.Banana
bin = script.Parent
debounce = true

function plant(mouse)
	local vPlayer = game.Players.LocalPlayer
	if (vPlayer == nil) then return end
	if (debounce == true) then
		debounce = false
		mouse.Icon = &quot;rbxasset://textures\\GunWaitCursor.png&quot;
		vCharacter = vPlayer.Character
		spawnPos = vCharacter.PrimaryPart.Position
		local Banana = Instance.new(&quot;Part&quot;)
		Banana.Position = Vector3.new(spawnPos.x, spawnPos.y+3, spawnPos.z)
		Banana.Size = Vector3.new(1,4,1)	
		Banana.BrickColor = BrickColor.Yellow()
		Banana.BottomSurface = 0
		Banana.TopSurface = 0
		Banana.Reflectance = 0
		Banana.Name = &quot;Banana&quot;
		Banana.Locked = true
		Banana.Parent = game.Workspace
		local new_script = BananaScript:clone()
		new_script.Disabled = false
		new_script.Parent = Banana
		wait(3.5)
		debounce = true
		mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	end
end

function onSelected(mouse)
	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	mouse.Button1Down:connect(function() plant(mouse) end)
end


