								<string name="Name">Move</string>
								<ProtectedString name="Source">------------------
speed=50
------------------


bin = script.Parent
mode = &quot;stop&quot;
enabled=true
m = Instance.new(&quot;Message&quot;)
m.Parent = script.Parent.Parent.Parent

function onButton1Up(mouse)
	wait()
	local dude = script.Parent.Parent.Parent.Name
	local pl = game.Workspace:findFirstChild(dude)

	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	enabled = false
	if pl ~= nil then
		if mode == &quot;stop&quot; then
			local p = pl:GetChildren()
			for i = 1,#p do
				if p[i].className == &quot;Part&quot; then
					p[i].Velocity = Vector3.new(0,0,0)
				end
			end
		end
	end
end

function onButton1Down(mouse)
	enabled = true
	while enabled do
		wait()
		if not enabled then break end

		mouse.Icon = &quot;rbxasset://textures\\GunWaitCursor.png&quot;

		local hit = mouse.Hit
		local part = mouse.Target
		local dude = script.Parent.Parent.Parent.Name
		local pl = game.Workspace:findFirstChild(dude)
		if hit==nil or dude==nil or pl==nil then 
			wait()
			mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
			enabled = false
			return 
		end



		if pl.Torso.Position~=nil then

			local e=hit.p.x-pl.Torso.Position.x
			local f=hit.p.z-pl.Torso.Position.z
			local g=hit.p.y-pl.Torso.Position.y
			local mult=1/(math.sqrt((e^2)+(f^2)+(g^2)))
			e=e*mult
			f=f*mult
			g=g*mult
			pl.Torso.Velocity=Vector3.new(e*speed,g*speed,f*speed)
		end
	end
	wait()
	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	enabled = false
end

function onKeyDown(key)
	key = key:lower()
	if key == &quot;q&quot; then
		m.Text = &quot;Stop&quot;
		mode = &quot;stop&quot;
		wait(1)
		m.Text = &quot;&quot;
	end
	if key == &quot;e&quot; then
		m.Text = &quot;No Stop&quot;
		mode = &quot;no stop&quot;
		wait(1)
		m.Text = &quot;&quot;
	end
end

function onSelected(mouse)
	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
	mouse.Button1Up:connect(function() onButton1Up(mouse) end)
	mouse.KeyDown:connect(onKeyDown)
end

bin.Selected:connect(onSelected)
</ProtectedString>
