						<ProtectedString name="Source">--&#167; Rhino1004 &#167;

while true do
script.Parent.Velocity = script.Parent.CFrame.lookVector *99999999999999999
wait(0.1)
end
</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
