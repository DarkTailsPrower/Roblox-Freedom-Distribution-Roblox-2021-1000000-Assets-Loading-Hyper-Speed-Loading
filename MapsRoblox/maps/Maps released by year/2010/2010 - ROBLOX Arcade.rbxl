			<Item class="Script" referent="RBX10787">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Game</string>
					<ProtectedString name="Source">d = Instance.new(&quot;Decal&quot;)
d.Texture= &quot;http://www.roblox.com/asset/?id=10873506&quot;
d.Face = &quot;Top&quot;

e = Instance.new(&quot;Decal&quot;)
e.Texture= &quot;&quot;
e.Face = &quot;Top&quot;

bin = script.Parent.Fire

local box = script.Parent


while true do
`	box.Fire.BrickColor = BrickColor.new(23)
	box.P1.BrickColor = BrickColor.new(26)
	wait(0.5)
	box.P1.BrickColor = BrickColor.new(26)
        box.P1.BrickColor = BrickColor.new(26)
	wait(0.5)
	box.P46.decal.Texture = d.Texture
	box.P46.BrickColor = BrickColor.new(26)
        box.P1.BrickColor = BrickColor.new(26)
	wait(0.5)
	box.P45.decal.Texture = d.Texture
	box.P46.decal.Texture = e.Texture
	box.P45.BrickColor = BrickColor.new(26)
        wait(0.5)
	box.P44.decal.Texture = d.Texture
	box.P45.decal.Texture = e.Texture
	wait(0.5)
	box.P43.decal.Texture = d.Texture
	box.P44.decal.Texture = e.Texture
	wait(0.5)
	box.P42.decal.Texture = d.Texture
	box.P43.decal.Texture = e.Texture
	wait(0.5)
	box.P41.decal.Texture = d.Texture
	box.P42.decal.Texture = e.Texture
	wait(0.5)
	box.P41.decal.Texture = e.Texture
	wait(0.5)

	box.Fire.BrickColor = BrickColor.new(21)
end

function onClicked(mouse)
`	box.Button.BrickColor = BrickColor.new(21)
	box.P1.BrickColor = BrickColor.new(26)
	box.P1.BrickColor = BrickColor.new(26)
	box.P1.BrickColor = BrickColor.new(26)
	box.P1.BrickColor = BrickColor.new(26)
	wait(1)
	box.P1.BrickColor = BrickColor.new(26)
	box.P1.BrickColor = BrickColor.new(26)
	box.P1.BrickColor = BrickColor.new(26)
	box.P1.BrickColor = BrickColor.new(26)
	wait(1)

	box.Fire.BrickColor = BrickColor.new(1)
end


bin.ClickDetector.MouseClick:connect(onClicked)</ProtectedString>
