							<string name="Name">Script</string>
							<ProtectedString name="Source">bin = script.Parent
box = script.Parent.Parent

local flipper = script.Parent
local ff = game.Workspace.BodyForce

local debounce = false
function onClicked()
	if debounce == true then return end

	debounce = true
	flipper.BrickColor = BrickColor.new(26)
	
	box.P10.BrickColor = BrickColor.new(26)

	if box.P18.BrickColor == BrickColor.new(23) then
	
	wait(0.1)
	box.P10.BrickColor = BrickColor.new(26)
	box.P18.BrickColor = BrickColor.new(104)
	box.Points.Value.Value = box.Points.Value.Value + 1
	wait(0.1)
	box.P18.BrickColor = BrickColor.new(23)

	debounce = false
	flipper.BrickColor = BrickColor.new(23)

	else

	wait(0.1)
	box.P10.BrickColor = BrickColor.new(26)
	box.P18.BrickColor = BrickColor.new(26)
	wait(0.1)
	box.P18.BrickColor = BrickColor.new(23)

	debounce = false
	flipper.BrickColor = BrickColor.new(23)
	end
end


script.Parent.ClickDetector.MouseClick:connect(onClicked)</ProtectedString>
