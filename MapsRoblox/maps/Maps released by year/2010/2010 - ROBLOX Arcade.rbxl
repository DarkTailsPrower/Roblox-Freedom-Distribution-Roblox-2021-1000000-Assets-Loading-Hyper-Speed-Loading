				<Item class="Script" referent="RBX5006">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">-- Mario Arcade Scripts -- 
-- Info :
-- Part : Moving Thwomp Script
-- Used For : To make the game a little more challenging
-- Advantaged : So its more like the real Mario game
-- Disadvantaged : The game is a little harder with enemies
------------------------------------------------------------------------------------------------ Creator : shadowmario111159
while true do
brick = script.Parent 
brick.Position = Vector3.new(brick.Position.x+1,brick.Position.y+0,brick.Position.z+0) 
wait(0.5)
brick.Position = Vector3.new(brick.Position.x+1,brick.Position.y+0,brick.Position.z+0) 
wait(0.5)
brick.Position = Vector3.new(brick.Position.x+1,brick.Position.y+0,brick.Position.z+0)  
wait(1.5)
brick.Position = Vector3.new(brick.Position.x-1,brick.Position.y+0,brick.Position.z+0) 
wait(0.2)
brick.Position = Vector3.new(brick.Position.x-1,brick.Position.y+0,brick.Position.z+0) 
wait(0.2)
brick.Position = Vector3.new(brick.Position.x-1,brick.Position.y+0,brick.Position.z+0) 
wait(1.5)
end
</ProtectedString>
