							<ProtectedString name="Source">box = script.Parent.Parent

local flipper = script.Parent
local ff = game.Workspace.Pinball2.LeftFlipper.BodyForce

local debounce = false
function onTouch(part)
	if debounce == true then return end

	debounce = true
	flipper.BrickColor = BrickColor.new(26)
	
	box.P16.BrickColor = BrickColor.new(26)

	if box.P24.BrickColor == BrickColor.new(28) then
	
	wait(0.1)
	box.P16.BrickColor = BrickColor.new(24)
