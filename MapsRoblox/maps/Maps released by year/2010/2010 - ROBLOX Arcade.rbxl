				<Item class="Script" referent="RBX7267">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">local oldcolor = script.Parent.BrickColor

function onTouch(part)
	--if (part.Name == &quot;Ball&quot;) then
		
		part.Velocity = Vector3.new(0,10,0)

		script.Parent.BrickColor = BrickColor.new(21)
		game.Workspace.Pinball.TheScore.Value = game.Workspace.Pinball.TheScore.Value + 25
		wait(.5)
		script.Parent.BrickColor = oldcolor

	--end
end

script.Parent.Touched:connect(onTouch)</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX7268">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">local button = script.Parent
local off_color = script.Parent.BrickColor

local ballsource = game.Workspace.Pinball.Tixmaker

local ball = game.Workspace.Tix5:clone()


function getBallSourcePos()
	return Vector3.new(ballsource.Position.x, ballsource.Position.y, ballsource.Position.z)
end





local debounce = false
function onTouch(part)
	if debounce == true then return end

	debounce = true
	
	local b = ball:clone()
	b.Position = getBallSourcePos()
	b.Parent = game.Workspace
	wait(0.1)

	debounce = false


	wait(45)
	b:remove()
end


script.Parent.Touched:connect(onTouch)</ProtectedString>
