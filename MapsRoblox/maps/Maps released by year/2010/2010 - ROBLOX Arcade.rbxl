				<Item class="NumberValue" referent="RBX12110">
					<Properties>
						<string name="Name">FoodLeft</string>
						<double name="Value">6</double>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX12111">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">SandwichScript</string>
						<ProtectedString name="Source">local Tool = script.Parent;
enabled = true

function onActivated()
   if not enabled  then
      return
   end
   if script.Parent.FoodLeft.Value &gt; 0 then 
      enabled = false
      Tool.GripForward = Vector3.new(-0.976,0,-0.217)
      Tool.GripPos = Vector3.new(.95,-0.76,1.4)
      Tool.GripRight = Vector3.new(0.217,0, 0.976)
      Tool.GripUp = Vector3.new(0,1,0)
      local h = Tool.Parent:FindFirstChild(&quot;Humanoid&quot;)
      if (h ~= nil) then
         if (h.MaxHealth &gt; h.Health + 20) then
            h.Health = h.Health + 20
         else	
            h.Health = h.MaxHealth
         end
      end
      Tool.Handle.EatSound:Play()
      wait(.8)
      Tool.Handle.EatSound2:Play()
      wait(.8)
      Tool.GripForward = Vector3.new(-0.976,0,-0.217)
      Tool.GripPos = Vector3.new(0.3,0,0)
      Tool.GripRight = Vector3.new(0.217,0,-0.976)
      Tool.GripUp = Vector3.new(0,1,0)
      enabled = true
      script.Parent.FoodLeft.Value = script.Parent.FoodLeft.Value - 1
      if script.Parent.FoodLeft.Value == 0 then
         Tool.Handle.Transparency = 1
      end
   end
end

function onEquipped()
   Tool.Handle.OpenSound:play()
end

script.Parent.Activated:connect(onActivated)
script.Parent.Equipped:connect(onEquipped)</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX12112">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">local Tool = script.Parent;

enabled = true


function onActivated()
   if not enabled  then
      return
   end
   enabled = false
   if script.Parent.FoodLeft.Value== 0 then
      H = Instance.new(&quot;Hint&quot;)
      H.Parent = game.Players:playerFromCharacter(script.Parent.Parent) 
      H.Text = &quot;Whered it go? WHO ATE MAI SANDWICH&quot;
      wait(3)
      H:remove()    
      Tool:remove()
   end 
   enabled = true
end

script.Parent.Activated:connect(onActivated)</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
