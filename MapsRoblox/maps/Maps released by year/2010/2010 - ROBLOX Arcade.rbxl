				<Item class="Script" referent="RBX1672">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Movement</string>
						<ProtectedString name="Source">while true do
script.Parent.GripPos = Vector3.new(0, 0.5, 0)
wait(0.1)
script.Parent.GripPos = Vector3.new(0, 1, 0)
wait(0.05)
script.Parent.GripPos = Vector3.new(0, 1.5, 0)
wait(0.05)
script.Parent.GripPos = Vector3.new(0, 2, 0)
wait(0.05)
script.Parent.GripPos = Vector3.new(0, 2.5, 0)
wait(0.05)
script.Parent.GripPos = Vector3.new(0, 3, 0)
wait(0.1)
script.Parent.GripPos = Vector3.new(0, 2.5, 0)
wait(0.05)
script.Parent.GripPos = Vector3.new(0, 2, 0)
wait(0.05)
script.Parent.GripPos = Vector3.new(0, 1.5, 0)
wait(0.05)
script.Parent.GripPos = Vector3.new(0, 1, 0)
wait(0.05)
end
</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
				<Item class="LocalScript" referent="RBX1673">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Local Gui</string>
						<ProtectedString name="Source">local Tool = script.Parent;

enabled = true
function onButton1Down(mouse)
	if not enabled then
		return
	end

	enabled = false
	mouse.Icon = &quot;rbxasset://textures\\GunWaitCursor.png&quot;

	wait(.2)
	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	enabled = true

end

function onEquippedLocal(mouse)


	if mouse == nil then
		print(&quot;Mouse not found&quot;)
		return 
	end

	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end



Tool.Equipped:connect(onEquippedLocal)
</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX1674">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Steal</string>
						<ProtectedString name="Source">function onTouched(hit)
	local human = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
	if (human ~= nil) then
		ball.Parent = human.Parent
	end
end
connection = ball.Touched:connect(onTouched)</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
