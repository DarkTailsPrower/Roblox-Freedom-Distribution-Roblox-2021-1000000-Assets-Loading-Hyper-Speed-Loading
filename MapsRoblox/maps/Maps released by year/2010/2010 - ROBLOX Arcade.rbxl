				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">TicketLeaderboard</string>
				<ProtectedString name="Source">--Lord Dagon&apos;s Ticket Leaderboard
function onPlayerEntered(newPlayer)
	local stats = Instance.new(&quot;IntValue&quot;)
	stats.Name = &quot;leaderstats&quot;


	local c = Instance.new(&quot;IntValue&quot;)
	c.Name = &quot;Tickets&quot;
	c.Value = 1

	c.Parent = stats

	stats.Parent = newPlayer

	newPlayer.Changed:connect(function (property)
		if (property == &quot;Character&quot;) then
			onPlayerRespawned(newPlayer)
		end
	end)
end

game.Players.ChildAdded:connect(onPlayerEntered)

function checkToAwardKillCountBadges(player, kills, deaths)


	if (player == nil) then return end

	local b = game:GetService(&quot;BadgeService&quot;)

	if (Tickets &gt;= 100000) then
		b:AwardBadge(player.userId, 19222227)
	end

	end
</ProtectedString>
