						<ProtectedString name="Source">bin = script.Parent
box = game.Workspace.Space8

local flipper = script.Parent
local ff = game.Workspace.BodyForce

local debounce = false
function onClicked(mouse)
	if debounce == true then return end

	debounce = true
	flipper.BrickColor = BrickColor.new(106)
	
	box.P32.BrickColor = BrickColor.new(106)
	wait(0.5)
	box.P31.BrickColor = BrickColor.new(106)
	box.P32.BrickColor = BrickColor.new(26)
	wait(0.5)
	box.P30.BrickColor = BrickColor.new(106)
