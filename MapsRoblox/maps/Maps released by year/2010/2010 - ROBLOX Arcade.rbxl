						<string name="Name">Script</string>
						<ProtectedString name="Source">bin = script.Parent
box = script.Parent.Parent

local flipper = script.Parent

local ballsource = script.Parent.Parent.Tixmaker

local ball = game.Workspace.Tix:clone()


function getBallSourcePos()
	return Vector3.new(ballsource.Position.x, ballsource.Position.y, ballsource.Position.z)
end

local debounce = false
function onClicked(mouse)
	if debounce == true then return end

	debounce = true
	flipper.BrickColor = BrickColor.new(24)

	if bin.Transparency == 0 then
	
	wait(0.1)
	bin.BrickColor = BrickColor.new(28)
	wait(0.1)

	local b = ball:clone()
	b.Position = getBallSourcePos()
	b.Parent = game.Workspace

	debounce = false
	flipper.BrickColor = BrickColor.new(24)

	else

	wait(0.2)

	debounce = false
	flipper.BrickColor = BrickColor.new(24)
	end
end


bin.ClickDetector.MouseClick:connect(onClicked)</ProtectedString>
