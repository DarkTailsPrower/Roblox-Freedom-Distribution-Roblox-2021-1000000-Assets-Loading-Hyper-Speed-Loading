						<string name="Name">Script</string>
						<ProtectedString name="Source">bin = script.Parent
box = game.Workspace.Jump

local flipper = script.Parent
local ff = game.Workspace.BodyForce

local ballsource = game.Workspace.Jump.Tixmaker

local ball = game.Workspace.Tix5:clone()


function getBallSourcePos()
	return Vector3.new(ballsource.Position.x, ballsource.Position.y, ballsource.Position.z)
end

local debounce = false
function onClicked(mouse)
	if debounce == true then return end

	debounce = true
	flipper.BrickColor = BrickColor.new(21)
	
	box.P55.BrickColor = BrickColor.new(23)
	box.P47.BrickColor = BrickColor.new(141)
	box.P39.BrickColor = BrickColor.new(24)

	if box.P54.BrickColor == BrickColor.new(26) then

	wait(0.5)
	box.P39.BrickColor = BrickColor.new(1)
	box.P47.BrickColor = BrickColor.new(24)
	box.P55.BrickColor = BrickColor.new(141)
	wait(0.1)

	local b = ball:clone()
	b.Position = getBallSourcePos()
	b.Parent = game.Workspace

	debounce = false
	flipper.BrickColor = BrickColor.new(119)

	else

	wait(0.5)
	box.P39.BrickColor = BrickColor.new(1)
	box.P47.BrickColor = BrickColor.new(24)
	box.P55.BrickColor = BrickColor.new(141)
	wait(0.1)

	debounce = false
	flipper.BrickColor = BrickColor.new(119)
	end
end


bin.ClickDetector.MouseClick:connect(onClicked)</ProtectedString>
						<bool name="archivable">true</bool>
