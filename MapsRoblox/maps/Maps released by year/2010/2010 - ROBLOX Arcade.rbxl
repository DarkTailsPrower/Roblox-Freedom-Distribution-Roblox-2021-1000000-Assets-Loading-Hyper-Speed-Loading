		<Item class="Script" referent="RBX2617">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">WeldScriptinsert</string>
				<ProtectedString name="Source">function onPlayerRespawned(newPlayer)
	local bScript = script.Weld:clone()
		local name = newPlayer.Name
		local player = script.Parent:findFirstChild(name)
			bScript.Parent = player
end

script.Parent.ChildAdded:connect(onPlayerRespawned)
</ProtectedString>
				<bool name="archivable">true</bool>
			</Properties>
			<Item class="Script" referent="RBX2618">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Weld</string>
					<ProtectedString name="Source">--- Credit to fireflywater for the script help
local player = script.Parent
function onPlayerDied(died)
if player.Humanoid.Health == 0 then
if player.Head:findFirstChild(&quot;face&quot;) ~= nil then player.Head:findFirstChild(&quot;face&quot;):remove() end
if player.Torso:findFirstChild(&quot;Right Shoulder&quot;) ~= nil then player.Torso:findFirstChild(&quot;Right Shoulder&quot;):remove() end
if player.Torso:findFirstChild(&quot;Left Shoulder&quot;) ~= nil then player.Torso:findFirstChild(&quot;Left Shoulder&quot;):remove() end
if player.Torso:findFirstChild(&quot;Right Hip&quot;) ~= nil then player.Torso:findFirstChild(&quot;Right Hip&quot;):remove() end
if player.Torso:findFirstChild(&quot;Left Hip&quot;) ~= nil then player.Torso:findFirstChild(&quot;Left Hip&quot;):remove() end
local face = Instance.new(&quot;Decal&quot;)
local weld = Instance.new(&quot;Weld&quot;)
local weld2 = Instance.new(&quot;Weld&quot;)
local weld3 = Instance.new(&quot;Weld&quot;)
local weld4 = Instance.new(&quot;Weld&quot;)
local weld5 = Instance.new(&quot;Weld&quot;)
player.Humanoid.Parent = nil

face.Parent = player.Head
face.Texture = &quot;http://www.roblox.com/asset/?id=2298724&quot;

weld.Parent = player.Torso
weld.Part0 = player.Torso
weld.Part1 = player.Head
weld.C0 = CFrame.new(0,1.5,0)

weld2.Parent = player.Torso
weld2.Part0 = player.Torso
weld2.Part1 = player:findFirstChild(&quot;Right Arm&quot;)
weld2.C0 = CFrame.new(1.5,0,0)

weld3.Parent = player.Torso
weld3.Part0 = player.Torso
weld3.Part1 = player:findFirstChild(&quot;Left Arm&quot;)
weld3.C0 = CFrame.new(-1.5,0,0)

weld4.Parent = player.Torso
weld4.Part0 = player.Torso
weld4.Part1 = player:findFirstChild(&quot;Right Leg&quot;)
weld4.C0 = CFrame.new(0.5,-2,0)

weld5.Parent = player.Torso
weld5.Part0 = player.Torso
weld5.Part1 = player:findFirstChild(&quot;Left Leg&quot;)
weld5.C0 = CFrame.new(-0.5,-2,0)

random = math.random(1,9)
	if random == 2 then
		player.Head:BreakJoints()
	else if random == 4 then
		player:findFirstChild(&quot;Left Arm&quot;):BreakJoints()
	else if random == 9 then
		player:findFirstChild(&quot;Right Arm&quot;):BreakJoints()
	else if random == 7 then
		player:findFirstChild(&quot;Left Leg&quot;):BreakJoints()
	else if random == 8 then
		player:findFirstChild(&quot;Right Leg&quot;):BreakJoints()
	end	
	end
	end
	end
	end
end
end

player.Humanoid.Died:connect(onPlayerDied)</ProtectedString>
					<bool name="archivable">true</bool>
				</Properties>
				<Item class="Script" referent="RBX2619">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Weld</string>
						<ProtectedString name="Source">local prev
local parts = script.Parent.Parent:GetChildren()
for i = 1,#parts do
--remove any of the following parts that say &quot;(parts[i].className == [className])&quot; if you want to exclude that particular className type from the Weld
	if ((parts[i].className == &quot;Part&quot;) or (parts[i].className == &quot;SpawnLocation&quot;) or (parts[i].className == &quot;Seat&quot;) or (parts[i].className == &quot;TrussPart&quot;) or (parts[i].className == &quot;VehicleSeat&quot;)) or (parts[i].className == &quot;Hat&quot;)) then
		if (prev ~= nil) then
			local weld = Instance.new(&quot;Weld&quot;)
			weld.Part0 = prev
			weld.Part1 = parts[i]
			weld.C0 = prev.CFrame:inverse()
			weld.C1 = parts[i].CFrame:inverse()
			weld.Parent = prev
			parts[i].Anchored = false
		end
		prev = parts[i]
	end
end
wait(3)
</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
