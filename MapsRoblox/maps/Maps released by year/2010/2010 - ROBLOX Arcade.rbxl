					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Respawn</string>
					<ProtectedString name="Source">robo=script.Parent:clone()while true do
	wait(0)
	if script.Parent.Humanoid.Health&lt;1 then		wait(2)
		robot=robo:clone()
		robot.Parent=script.Parent.Parent
		robot:makeJoints()
		script.Parent:remove()
	end
end

--Made by eggnog22
		


