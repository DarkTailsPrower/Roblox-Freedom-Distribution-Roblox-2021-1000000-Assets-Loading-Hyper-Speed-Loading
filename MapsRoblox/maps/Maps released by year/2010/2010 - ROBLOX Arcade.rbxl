				<Item class="Script" referent="RBX12437">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">WottsScript</string>
						<ProtectedString name="Source">local Tool = script.Parent;

enabled = true

function onActivated()
   if not enabled  then
      return
   end
   if script.Parent.DrinkLeft.Value &gt; 0 then 
      enabled = false
      Tool.GripForward = Vector3.new(0,-.759,-.651)
      Tool.GripPos = Vector3.new(1.5,-.5,.3)
      Tool.GripRight = Vector3.new(1,0,0)
      Tool.GripUp = Vector3.new(0,.651,-.759)
      Tool.Handle.DrinkSound:Play()
      wait(3)
      local h = Tool.Parent:FindFirstChild(&quot;Humanoid&quot;)
      if (h ~= nil) then
         if (Tool.Parent:FindFirstChild(&quot;TssEffect&quot;) == nil) then
            print(&quot;do the Tss!&quot;)
            local s = script.Parent.TssEffect:Clone()
            s.Disabled = false
            s.Parent = Tool.Parent			
         end
      end
      Tool.GripForward = Vector3.new(-.976,0,-0.217)
      Tool.GripPos = Vector3.new(0.03,0,0)
      Tool.GripRight = Vector3.new(.217,0,-.976)
      Tool.GripUp = Vector3.new(0,1,0)
      script.Parent.DrinkLeft.Value = script.Parent.DrinkLeft.Value - 1
      enabled = true
   end
end

function onEquipped()
	Tool.Handle.OpenSound:play()
end

script.Parent.Activated:connect(onActivated)
script.Parent.Equipped:connect(onEquipped)
</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX12438">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">local Tool = script.Parent;

enabled = true


function onActivated()
   if not enabled  then
      return
   end
   enabled = false
   if script.Parent.DrinkLeft.Value== 0 then
      H = Instance.new(&quot;Hint&quot;)
      H.Parent = game.Players:playerFromCharacter(script.Parent.Parent) 
      H.Text = &quot;It seems to be hiding....&quot;
      wait(3)
      H:remove()   
      Tool:remove() 
   end 
   enabled = true
end

script.Parent.Activated:connect(onActivated)</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX12439">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">TssEffect</string>
						<ProtectedString name="Source">print(&quot;run brew&quot;)


-- assume we are in the character, let&apos;s check

function sepuku()
	script.Parent = nil
end
local h = script.Parent:FindFirstChild(&quot;Humanoid&quot;)
if (h == nil) then sepuku() end
local p= script.Parent:GetChildren()
for i=1, #p do
   if (p[i].className == &quot;Part&quot;) then
      p[i].Transparency = 1
      if (p[i].Name == &quot;Head&quot;) then
         p[i].face.Face = &quot;Bottom&quot;
      end
   elseif (p[i].className == &quot;Hat&quot; or p[i].className == &quot;Tool&quot;) then
      p[i].Handle.Transparency = 1
   end
end
wait(5)
for i=1, #p do
   if (p[i].className == &quot;Part&quot;) then
      p[i].Transparency = 0
      if (p[i].Name == &quot;Head&quot;) then
         p[i].face.Face = &quot;Front&quot;
      end
   elseif (p[i].className == &quot;Hat&quot; or p[i].className == &quot;Tool&quot;) then
      p[i].Handle.Transparency = 0
   end
end


script.Parent = nil</ProtectedString>
