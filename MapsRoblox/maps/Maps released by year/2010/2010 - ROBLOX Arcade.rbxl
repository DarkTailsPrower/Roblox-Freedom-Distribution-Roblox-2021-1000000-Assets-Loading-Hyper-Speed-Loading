						<string name="Name">Script</string>
						<ProtectedString name="Source">bin = script.Parent
box = game.Workspace.Tyson

local flipper = script.Parent
local ff = game.Workspace.BodyForce

local ballsource = game.Workspace.Tyson.Tixmaker

local ball = game.Workspace.Tix:clone()


function getBallSourcePos()
	return Vector3.new(ballsource.Position.x, ballsource.Position.y, ballsource.Position.z)
end

local debounce = false
function onClicked(mouse)
	if debounce == true then return end

	debounce = true
	flipper.BrickColor = BrickColor.new(26)
	
	box.P29.Transparency = false
	box.P60.BrickColor = BrickColor.new(28)
	box.P38.Transparency = false
	box.P60.BrickColor = BrickColor.new(28)

	if box.P63.BrickColor == BrickColor.new(1) then --change to platform
	
	wait(0.5)
	box.P29.Transparency = 9
	box.P60.BrickColor = BrickColor.new(28)
	box.P38.Transparency = 9
	box.P60.BrickColor = BrickColor.new(28)
	wait(0.1)

	local b = ball:clone()
	b.Position = getBallSourcePos()
	b.Parent = game.Workspace

	debounce = false
	flipper.BrickColor = BrickColor.new(21)

	else

	wait(0.5)
	box.P29.Transparency = 9
	box.P60.BrickColor = BrickColor.new(28)
	box.P38.Transparency = 9
	box.P60.BrickColor = BrickColor.new(28)

	debounce = false
	flipper.BrickColor = BrickColor.new(21)
	end
end


