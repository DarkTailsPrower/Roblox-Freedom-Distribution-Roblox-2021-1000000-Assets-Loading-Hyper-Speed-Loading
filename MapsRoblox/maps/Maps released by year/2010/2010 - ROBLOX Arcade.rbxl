					<string name="Name">Game</string>
					<ProtectedString name="Source">bin = script.Parent.Fire

local box = script.Parent


while true do
`	box.Fire.BrickColor = BrickColor.new(23)
	box.P35.BrickColor = BrickColor.new(37)
	wait(0.5)
	box.P27.BrickColor = BrickColor.new(37)
	box.P35.BrickColor = BrickColor.new(26)
	wait(0.5)
	box.P19.BrickColor = BrickColor.new(37)
	box.P27.BrickColor = BrickColor.new(26)
	wait(0.5)
	box.P11.BrickColor = BrickColor.new(37)
	box.P19.BrickColor = BrickColor.new(26)
	wait(0.5)
	box.P10.BrickColor = BrickColor.new(37)
	box.P11.BrickColor = BrickColor.new(226)
	wait(0.5)
	box.P9.BrickColor = BrickColor.new(37)
	box.P10.BrickColor = BrickColor.new(226)
	wait(0.5)
	box.P50.BrickColor = BrickColor.new(18)
	box.P9.BrickColor = BrickColor.new(226)
	wait(0.5)
	box.P49.BrickColor = BrickColor.new(18)
	box.P50.BrickColor = BrickColor.new(18)
	wait(0.5)
	box.P49.BrickColor = BrickColor.new(18)
	wait(0.5)

	box.Fire.BrickColor = BrickColor.new(1)
end

function onClicked(mouse)
`	box.Button.BrickColor = BrickColor.new(1)
	box.P12.BrickColor = BrickColor.new(9)
	box.P13.BrickColor = BrickColor.new(9)
	box.P37.BrickColor = BrickColor.new(18)
	box.P45.BrickColor = BrickColor.new(18)
	wait(1)
	box.P12.BrickColor = BrickColor.new(226)
	box.P13.BrickColor = BrickColor.new(226)
	box.P37.BrickColor = BrickColor.new(18)
	box.P45.BrickColor = BrickColor.new(18)
	wait(1)

	box.Fire.BrickColor = BrickColor.new(1)
end


bin.ClickDetector.MouseClick:connect(onClicked)</ProtectedString>
