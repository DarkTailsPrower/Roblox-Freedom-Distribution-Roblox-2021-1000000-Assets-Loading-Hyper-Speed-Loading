							<string name="Name">Script</string>
							<ProtectedString name="Source">function onTouched(hit)
if hit.Name == &quot;Ballie&quot; then
	C = script.Parent.Parent.Tix5:clone()
	C.Parent = game.Workspace
	C.Position = script.Parent.Parent.Exit.Position
	hit:Remove()
end
end

