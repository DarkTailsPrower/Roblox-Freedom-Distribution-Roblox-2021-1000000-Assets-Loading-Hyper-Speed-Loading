	box.P25.BrickColor = BrickColor.new(106)
	box.P26.BrickColor = BrickColor.new(26)
	wait(0.5)
	box.P25.BrickColor = BrickColor.new(26)
	wait(0.5)

	debounce = false
	flipper.BrickColor = BrickColor.new(119)
end


