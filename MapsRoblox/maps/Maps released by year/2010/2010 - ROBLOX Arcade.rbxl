			<Item class="Script" referent="RBX65">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">GameSystem</string>
					<ProtectedString name="Source">bm = script.Parent.Builderman
tm = script.Parent.Telamon
cbm = script.Parent.BuildermanController
ctm = script.Parent.TelamonController
sc = script.Parent.Screen

bmup = &quot;http://www.roblox.com/asset/?id=28583789&quot;
bmdown = &quot;http://www.roblox.com/asset/?id=28583797&quot;
bmdead = &quot;http://www.roblox.com/asset/?id=28610540&quot;
tmup = &quot;http://www.roblox.com/asset/?id=28583806&quot;
tmdown = &quot;http://www.roblox.com/asset/?id=28583811&quot;
tmdead = &quot;http://www.roblox.com/asset/?id=28610550&quot;

bmx = 0.5
bmz = 0
tmx = -0.5
tmz = 0
rb = 0
rt = 0
bmsword = false
tmsword = false
bmhealth = 100
tmhealth = 100
winner = &quot;&quot;

function reset()
bmx = 0.5
bmz = 0
tmx = -0.5
tmz = 0
rb = 0
rt = 0
bmsword = false
tmsword = false
bmhealth = 100
tmhealth = 100
winner = &quot;&quot;
end

function tsword()
tmsword = true
sc.Sword:play()
wait(0.3)
tmsword = false
end
script.Parent.TMsword.ClickDetector.MouseClick:connect(tsword)
function bsword()
bmsword = true
sc.Sword:play()
wait(0.3)
bmsword = false
end
script.Parent.BMsword.ClickDetector.MouseClick:connect(bsword)

while true do
wait(0.1)

wb = cbm:findFirstChild(&quot;SeatWeld&quot;)
wt = ctm:findFirstChild(&quot;SeatWeld&quot;)
if wb ~= nil then
cam = wb.Part1.Parent:findFirstChild(&quot;CamChanger&quot;)
if cam == nil then
cam = script.CamChanger:clone()
cam.Disabled = false
cam.Parent = wb.Part1.Parent
end
end
if wt ~= nil then
cam = wt.Part1.Parent:findFirstChild(&quot;CamChanger&quot;)
if cam == nil then
cam = script.CamChanger:clone()
cam.Parent = wt.Part1.Parent
end
end

--movement
bmx = bmx - (cbm.Steer * 0.1)
bmz = bmz + (cbm.Throttle * 0.1)
tmx = tmx - (ctm.Steer * 0.1)
tmz = tmz + (ctm.Throttle * 0.1)

--barrier
if bmx &gt; 0.9 then
bmx = 0.9
elseif bmx &lt; -0.9 then
bmx = -0.9
end
if bmz &gt; 0.9 then
bmz = 0.9
elseif bmz &lt; -0.9 then
bmz = -0.9
end
if tmx &gt; 0.9 then
tmx = 0.9
elseif tmx &lt; -0.9 then
tmx = -0.9
end
if tmz &gt; 0.9 then
tmz = 0.9
elseif tmz &lt; -0.9 then
tmz = -0.9
end

--rotation
if cbm.Throttle == 1 and cbm.Steer == 0 then
rb = 3.14
elseif cbm.Throttle == -1 and cbm.Steer == 0 then
rb = 0
elseif cbm.Throttle == 0 and cbm.Steer == 1 then
rb = 1.57
elseif cbm.Throttle == 0 and cbm.Steer == -1 then
rb = -1.57
elseif cbm.Throttle == 1 and cbm.Steer == 1 then
rb = 2.335
elseif cbm.Throttle == 1 and cbm.Steer == -1 then
rb = -2.335
elseif cbm.Throttle == -1 and cbm.Steer == 1 then
rb = 0.785
elseif cbm.Throttle == -1 and cbm.Steer == -1 then
rb = -0.785
end
if ctm.Throttle == 1 and ctm.Steer == 0 then
rt = 3.14
elseif ctm.Throttle == -1 and ctm.Steer == 0 then
rt = 0
elseif ctm.Throttle == 0 and ctm.Steer == 1 then
rt = 1.57
elseif ctm.Throttle == 0 and ctm.Steer == -1 then
rt = -1.57
elseif ctm.Throttle == 1 and ctm.Steer == 1 then
rt = 2.335
elseif ctm.Throttle == 1 and ctm.Steer == -1 then
rt = -2.335
elseif ctm.Throttle == -1 and ctm.Steer == 1 then
rt = 0.785
elseif ctm.Throttle == -1 and ctm.Steer == -1 then
rt = -0.785
end

--SwordPositioning
script.Parent.BuildermanSword.CFrame = bm.CFrame * CFrame.new(0,0,0.4)
script.Parent.TelamonSword.CFrame = tm.CFrame * CFrame.new(0,0,0.4)
bdist = bm.Position - script.Parent.TelamonSword.Position
tdist = tm.Position - script.Parent.BuildermanSword.Position

--Placement
bm.CFrame = sc.CFrame * CFrame.new(bmx,0.2,bmz) * CFrame.fromEulerAnglesXYZ(0,rb,0)
tm.CFrame = sc.CFrame * CFrame.new(tmx,0.2,tmz) * CFrame.fromEulerAnglesXYZ(0,rt,0)

--Decals
if bmsword == false then
bm.Decal.Texture = bmup
elseif bmsword == true then
bm.Decal.Texture = bmdown
end
if tmsword == false then
tm.Decal.Texture = tmup
elseif tmsword == true then
tm.Decal.Texture = tmdown
end

--Damage
if bdist.magnitude &lt; 0.4 and tmsword == true then
bmhealth = bmhealth - 25
end
if tdist.magnitude &lt; 0.4 and bmsword == true then
tmhealth = tmhealth - 25
end

--Death
if bmhealth &lt; 0 then
winner = &quot;Telamon&quot;
local bcc = game.Workspace.Tix:clone()
bcc.Position = script.Parent.TelamonController.Position
bcc.Parent = game.Workspace
bm.Decal.Texture = bmdead
sc.Oof:play()
wait(2)
reset()
elseif tmhealth &lt; 0 then
local bdd = game.Workspace.Tix:clone()
bdd.Position = script.Parent.BuildermanController.Position
bdd.Parent = game.Workspace
winner = &quot;Builderman&quot;
tm.Decal.Texture = tmdead
sc.Oof:play()
wait(2)
reset()
end
end
</ProtectedString>
					<bool name="archivable">true</bool>
				</Properties>
				<Item class="LocalScript" referent="RBX66">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">CamChanger</string>
						<ProtectedString name="Source">wait(0.2)
while true do
wait()
if script.Parent.Parent.Character.Humanoid.Sit == true then
game.Workspace.CurrentCamera.CameraSubject = script.Parent.Parent.Character.Humanoid
game.Workspace.CurrentCamera.CameraType = &quot;Custom&quot;
torso = script.Parent.Parent.Character.Torso
anim = script.Parent.Parent.Character:findFirstChild(&quot;Animation&quot;)
if anim ~= nil then
anim.Parent = script
end
torso[&quot;Left Shoulder&quot;].DesiredAngle = 0
torso[&quot;Right Shoulder&quot;].DesiredAngle = -0
torso[&quot;Left Hip&quot;].DesiredAngle = 0
torso[&quot;Right Hip&quot;].DesiredAngle = 0
elseif script.Parent.Parent.Character.Humanoid.Sit == false then
game.Workspace.CurrentCamera.CameraSubject = script.Parent.Parent.Character.Humanoid
game.Workspace.CurrentCamera.CameraType = &quot;Custom&quot;
anim = script:findFirstChild(&quot;Animation&quot;)
if anim ~= nil then
anim.Parent = script.Parent.Parent.Character
end
script:remove()
end
end
</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
		</Item>
