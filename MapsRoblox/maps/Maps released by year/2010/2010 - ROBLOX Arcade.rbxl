						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">d = Instance.new(&quot;Decal&quot;)
d.Texture= &quot;http://www.roblox.com/asset/?id=10393674&quot;
d.Face = &quot;Top&quot;

e = Instance.new(&quot;Decal&quot;)
e.Texture= &quot;&quot;
e.Face = &quot;Top&quot;

bin = script.Parent
box = game.Workspace.xZeroKoolx

local flipper = script.Parent
local ff = game.Workspace.BodyForce

local debounce = false
function onClicked(mouse)
	if debounce == true then return end

	debounce = true
	flipper.BrickColor = BrickColor.new(1)
	
	box.P49.decal.Texture = d.Texture
	wait(0.4)
	box.P49.decal.Texture = e.Texture
	box.P50.decal.Texture = d.Texture
	wait(0.4)
	box.P50.decal.Texture = e.Texture
	box.P51.decal.Texture = d.Texture
	wait(0.4)
	box.P51.decal.Texture = e.Texture
	box.P52.decal.Texture = d.Texture
	wait(0.4)
	box.P52.decal.Texture = e.Texture
	box.P53.decal.Texture = d.Texture
	wait(0.4)
	box.P53.decal.Texture = e.Texture
	box.P54.decal.Texture = d.Texture
	box.P54.BrickColor = BrickColor.new(1)
        wait(0.4)
	box.P54.BrickColor = BrickColor.new(106)
        box.P54.decal.Texture = e.Texture
	box.P55.decal.Texture = d.Texture
	wait(0.4)
	box.P55.decal.Texture = e.Texture
	box.P56.decal.Texture = d.Texture
	wait(0.4)
	box.P56.decal.Texture = e.Texture
	wait(0.4)

	debounce = false
	flipper.BrickColor = BrickColor.new(23)
end


bin.ClickDetector.MouseClick:connect(onClicked)</ProtectedString>
