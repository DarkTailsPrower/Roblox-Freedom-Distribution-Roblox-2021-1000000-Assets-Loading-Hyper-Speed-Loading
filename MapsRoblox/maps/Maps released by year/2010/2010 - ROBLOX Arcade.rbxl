						<ProtectedString name="Source">local drink = script.Parent.Parent.Chocolate
local spot = script.Parent.Parent.Holder
local db = false

function onClick()
	if db == false then
		db = true
		local d = drink:clone()
		d.Handle.Position = spot.Position
		d.Parent = game.Workspace
		wait(5)
		db = false
	end
end

script.Parent.ClickDetector.MouseClick:connect(onClick)
