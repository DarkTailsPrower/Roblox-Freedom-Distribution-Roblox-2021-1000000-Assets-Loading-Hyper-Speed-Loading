				<Item class="Script" referent="RBX6756">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Easy Regen Script</string>
						<ProtectedString name="Source">bin = script.Parent

model = game.Workspace.Plinko
messageText = &quot;Reseting Plinko...&quot;

message = Instance.new(&quot;Hint&quot;)
message.Text = messageText
backup = model:clone()
enabled = true

function regenerate()
	message.Parent = game.Workspace
	model:remove()

	wait(1) -- display regen message for 4 seconds

	model = backup:clone()
	model.Parent = game.Workspace
	model:makeJoints()
	message.Parent = nil

	enabled = false
	wait(300)
	enabled = true
end

function onClicked(mouse)
	if enabled then
		regenerate()
	end
end

bin.ClickDetector.MouseClick:connect(onClicked)
</ProtectedString>
