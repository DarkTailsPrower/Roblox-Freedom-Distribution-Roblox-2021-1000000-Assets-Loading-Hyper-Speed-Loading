						<ProtectedString name="Source">function onTouch(part)
	if (part.Name == &quot;SBall&quot;) then
		
		part.Parent = nil

	end
end

script.Parent.Touched:connect(onTouch)</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
					<Item class="Timer" referent="RBX6921">
						<Properties>
							<string name="Name">pcm3d6vzg</string>
							<bool name="archivable">true</bool>
						</Properties>
