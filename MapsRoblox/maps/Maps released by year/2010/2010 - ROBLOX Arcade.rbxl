	wait(0.1)
	box.P10.BrickColor = BrickColor.new(24)
	box.P18.BrickColor = BrickColor.new(26)
	wait(0.1)
	box.P18.BrickColor = BrickColor.new(194)

	debounce = false
	flipper.BrickColor = BrickColor.new(23)
	end
end


