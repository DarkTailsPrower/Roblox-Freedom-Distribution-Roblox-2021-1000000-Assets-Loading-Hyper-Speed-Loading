	box.P50.BrickColor = BrickColor.new(26)
	wait(0.5)
	box.P49.BrickColor = BrickColor.new(26)
	wait(0.5)

	box.Fire.BrickColor = BrickColor.new(28)
end

function onClicked(mouse)
`	box.Button.BrickColor = BrickColor.new(21)
	box.P21.BrickColor = BrickColor.new(24)
	box.P29.BrickColor = BrickColor.new(24)
	box.P37.BrickColor = BrickColor.new(24)
