				<Item class="Script" referent="RBX7258">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">local oldcolor = script.Parent.BrickColor

function onTouch(part)
	--if (part.Name == &quot;Ball&quot;) then
		
		local a = part.Position
		local b = script.Parent.Position

		local dir = (a - b).unit

		part.Velocity = dir * 50

		script.Parent.BrickColor = BrickColor.new(21)

		game.Workspace.Pinball.TheScore.Value = game.Workspace.Pinball.TheScore.Value + 1

		wait(.5)
		script.Parent.BrickColor = oldcolor



	--end
end

script.Parent.Touched:connect(onTouch)</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
