			<Item class="Script" referent="RBX10914">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Game</string>
					<ProtectedString name="Source">bin = script.Parent.Fire

local box = script.Parent


while true do
`	box.Fire.BrickColor = BrickColor.new(21)
	box.P56.BrickColor = BrickColor.new(21)
	wait(0.5)
	box.P55.BrickColor = BrickColor.new(21)
	box.P56.BrickColor = BrickColor.new(26)
	wait(0.5)
	box.P54.BrickColor = BrickColor.new(21)
	box.P55.BrickColor = BrickColor.new(26)
	wait(0.5)
	box.P53.BrickColor = BrickColor.new(21)
	box.P54.BrickColor = BrickColor.new(26)
	wait(0.5)
	box.P52.BrickColor = BrickColor.new(21)
	box.P53.BrickColor = BrickColor.new(26)
	wait(0.5)
	box.P51.BrickColor = BrickColor.new(21)
	box.P52.BrickColor = BrickColor.new(26)
	wait(0.5)
	box.P50.BrickColor = BrickColor.new(21)
	box.P51.BrickColor = BrickColor.new(26)
	wait(0.5)
	box.P49.BrickColor = BrickColor.new(21)
	box.P50.BrickColor = BrickColor.new(26)
	wait(0.5)
	box.P49.BrickColor = BrickColor.new(26)
	wait(0.5)

	box.Fire.BrickColor = BrickColor.new(21)
end

function onClicked(mouse)
`	box.Button.BrickColor = BrickColor.new(21)
	box.P21.BrickColor = BrickColor.new(9)
	box.P29.BrickColor = BrickColor.new(9)
	box.P37.BrickColor = BrickColor.new(9)
	box.P45.BrickColor = BrickColor.new(9)
	wait(1)
	box.P21.BrickColor = BrickColor.new(26)
	box.P29.BrickColor = BrickColor.new(26)
	box.P37.BrickColor = BrickColor.new(26)
	box.P45.BrickColor = BrickColor.new(26)
	wait(1)

	box.Fire.BrickColor = BrickColor.new(106)
end


bin.ClickDetector.MouseClick:connect(onClicked)</ProtectedString>
					<bool name="archivable">true</bool>
