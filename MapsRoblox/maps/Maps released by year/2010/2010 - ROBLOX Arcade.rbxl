							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">-- Mario Arcade Scripts -- 
-- Info :
-- Part : Moving Thwomp Script
-- Used For : To make the game a little more challenging
-- Advantaged : So its more like the real Mario game
-- Disadvantaged : The game is a little harder with enemies
------------------------------------------------------------------------------------------------ Creator : shadowmario111159
while true do
brick = script.Parent 
brick.Position = Vector3.new(brick.Position.x+0,brick.Position.y+1,brick.Position.z+0) 
wait(0.5)
brick.Position = Vector3.new(brick.Position.x+0,brick.Position.y+1,brick.Position.z+0) 
wait(0.5)
brick.Position = Vector3.new(brick.Position.x+0,brick.Position.y+1,brick.Position.z+0) 
wait(1.5)
brick.Position = Vector3.new(brick.Position.x-0,brick.Position.y-1,brick.Position.z-0)
wait(0.2)
brick.Position = Vector3.new(brick.Position.x-0,brick.Position.y-1,brick.Position.z-0)
wait(0.2)
brick.Position = Vector3.new(brick.Position.x-0,brick.Position.y-1,brick.Position.z-0)
wait(1.5)
end
</ProtectedString>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
					<Item class="Script" referent="RBX3191">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">local button = script.Parent
local off_color = script.Parent.BrickColor

local ballsource = game.Workspace.DuckHunt.Tixmaker

local ball = game.Workspace.Tix:clone()


function getBallSourcePos()
	return Vector3.new(ballsource.Position.x, ballsource.Position.y, ballsource.Position.z)
end





local debounce = false
function onTouch(part)
	if debounce == true then return end

	debounce = true
	button.BrickColor = BrickColor.new(21)
	
	local b = ball:clone()
	b.Position = getBallSourcePos()
	b.Parent = game.Workspace
	wait(0.1)

	debounce = false
	button.BrickColor = off_color


	wait(45)
	b:remove()
end


script.Parent.Touched:connect(onTouch)</ProtectedString>
