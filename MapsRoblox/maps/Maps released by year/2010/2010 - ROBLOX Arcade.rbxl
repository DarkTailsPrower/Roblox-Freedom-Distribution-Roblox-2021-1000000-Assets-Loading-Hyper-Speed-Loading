			<Item class="Script" referent="RBX3489">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">display</string>
					<ProtectedString name="Source">function frame()
local screen=script.Parent.screen

local c = screen:GetChildren()
for i = 1,#c do
	if c[i].className==&quot;Decal&quot; then c[i].Parent=nil end
end

local frame=script.Parent.frame
local pic = script.Parent.t1:FindFirstChild(&quot;a&quot;..tostring(frame.Value)):Clone()
pic.Parent=screen
end

script.Parent.frame.Changed:connect(frame)

while true do
	local frame = script.Parent.frame
	if frame.Value &gt;= 14 then
		frame.Value = 1
	else
		frame.Value = frame.Value+1
	end
	wait(1.0)
end
</ProtectedString>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
