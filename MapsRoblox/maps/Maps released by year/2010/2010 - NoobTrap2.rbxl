					<Item class="Script" referent="RBX3918">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">function onTouch(part) 
local human = part.Parent:findFirstChild(&quot;Humanoid&quot;) 
if human ~= nil then 
part.Parent:findFirstChild(&quot;Head&quot;).BrickColor = BrickColor.new(125)
part.Parent:findFirstChild(&quot;Torso&quot;).BrickColor = BrickColor.new(125)
part.Parent:findFirstChild(&quot;Left Arm&quot;).BrickColor = BrickColor.new(125)
part.Parent:findFirstChild(&quot;Right Arm&quot;).BrickColor = BrickColor.new(125)
part.Parent:findFirstChild(&quot;Left Leg&quot;).BrickColor = BrickColor.new(125)
part.Parent:findFirstChild(&quot;Right Leg&quot;).BrickColor = BrickColor.new(125)
if part.Parent:findFirstChild(&quot;Torso&quot;):findFirstChild(&quot;roblox&quot;) ~= nil then
part.Parent:findFirstChild(&quot;Torso&quot;):findFirstChild(&quot;roblox&quot;).Texture=&quot;&quot;
end
local shirt1 = part.Parent:FindFirstChild(&quot;Shirt Graphic&quot;)
if shirt1 ~= nil  then 
shirt1:remove()
end
local shirt = part.Parent:FindFirstChild(&quot;Shirt&quot;)
if shirt ~= nil  then 
shirt:remove()
end
local pants = part.Parent:FindFirstChild(&quot;Pants&quot;)
if pants ~= nil  then 
pants:remove()
end
end 
end
script.Parent.Touched:connect(onTouch) 
