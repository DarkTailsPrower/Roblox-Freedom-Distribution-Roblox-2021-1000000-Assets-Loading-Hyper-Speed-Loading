							<ProtectedString name="Source">print(&quot;Unanchor Loaded&quot;)

LandMine = script.Parent

function onTouched(hit)
wait(0.2)
  LandMine.CanCollide = false
  LandMine.Transparency = 1
  wait(2)
  LandMine.CanCollide = true
  LandMine.Transparency = 0 --this script was edited by bigronnie3, it is basicly the same as fireguys stairs...but theres no regen needed 
end

connection = LandMine.Touched:connect(onTouched)
