						<Item class="LocalScript" referent="RBX4416">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">LocalScript</string>
								<ProtectedString name="Source">player = game.Players.LocalPlayer
repeat wait() until player.Character

value = 0

function onMinusClicked()
&#9;value = math.max(value - 0.1, 0)
&#9;mygui.Frame.Frame.Progress.Size = UDim2.new(value, 0, 1, -1)
&#9;mygui.Frame.Frame.TextLabel.Text = &quot;Reflectance: &quot;..value
end

function onPlusClicked()
&#9;value = math.min(value + 0.1, 1)
&#9;mygui.Frame.Frame.Progress.Size = UDim2.new(value, 0, 1, -1)
&#9;mygui.Frame.Frame.TextLabel.Text = &quot;Reflectance: &quot;..value
end

function onMoved(target)
&#9;if target then
&#9;&#9;if not target.Locked then
&#9;&#9;&#9;selection.Adornee = target
&#9;&#9;else
&#9;&#9;&#9;selection.Adornee = nil
&#9;&#9;end
&#9;else
&#9;&#9;selection.Adornee = nil
&#9;end
end

function onClicked(target)
&#9;if target then
&#9;&#9;if not target.Locked then
&#9;&#9;&#9;selection.Adornee = target
&#9;&#9;&#9;target.Reflectance = value
&#9;&#9;else
&#9;&#9;&#9;selection.Adornee = nil
&#9;&#9;end
&#9;else
&#9;&#9;selection.Adornee = nil
&#9;end
end

function onSelected(mouse)
&#9;if mygui then
&#9;&#9;mygui.Parent = player.PlayerGui
&#9;elseif player.PlayerGui:findFirstChild(&quot;ToolGui&quot;) == nil then
&#9;&#9;mygui = script.Parent.ToolGui:clone()
&#9;&#9;mygui.Parent = player.PlayerGui
&#9;&#9;selection = Instance.new(&quot;SelectionBox&quot;)
&#9;&#9;selection.Parent = player.PlayerGui
&#9;end
&#9;mouse.Button1Down:connect(function() onClicked(mouse.Target) end)
&#9;mouse.Move:connect(function() onMoved(mouse.Target) end)
&#9;mygui.Frame.Minus.MouseButton1Click:connect(onMinusClicked)
&#9;mygui.Frame.Plus.MouseButton1Click:connect(onPlusClicked)
end

function onDeselected()
&#9;value = 0
&#9;selection:remove()
&#9;mygui:remove()
&#9;mygui = nil
end

script.Parent.Selected:connect(onSelected)
script.Parent.Deselected:connect(onDeselected)</ProtectedString>
