&#9;&#9;local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;&#9;&#9;if h~=nil then
&#9;&#9;&#9;&#9;
h.Parent.Torso.Velocity=Vector3.new(0,100,0)
