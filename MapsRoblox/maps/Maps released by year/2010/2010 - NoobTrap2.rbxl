							<ProtectedString name="Source">bin = script.Parent

function onTouched(part)
&#9;local ex = Instance.new(&quot;Explosion&quot;)
&#9;ex.Position = part.Position
&#9;ex.BlastRadius = bin.Blast_Radius.Value
