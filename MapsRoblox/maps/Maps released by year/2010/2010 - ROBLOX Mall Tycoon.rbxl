				<Item class="Script" referent="RBX4746">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Cash changer</string>
						<ProtectedString name="Source">function onPlayerEntered(player)
wait(5)
local set = player.Character:findFirstChild(&quot;Humanoid&quot;)
if (set ~= nil) then
if set.Parent.Torso.roblox.Texture == &quot;http://www.roblox.com/asset/?id=33313306&quot; then
player.leaderstats.Cash.Value = 300	
if set.Parent.Name == &quot;Nightcaller&quot; or set.Parent.Name == &quot;ZombieMan2121&quot; then
player.leaderstats.Cash.Value = 1000000
end
end
end
end
game.Players.ChildAdded:connect(onPlayerEntered)
</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX4747">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Leaderboard</string>
						<ProtectedString name="Source">function onPlayerEntered(newPlayer)

	local stats = Instance.new(&quot;IntValue&quot;)
	stats.Name = &quot;leaderstats&quot;
	local stats2 = Instance.new(&quot;IntValue&quot;) 
	stats2.Name = &quot;Tycoon&quot; 


	local Cash = Instance.new(&quot;IntValue&quot;)
	Cash.Name = &quot;Cash&quot; 
	Cash.Value = 0


	Cash.Parent = stats
	stats.Parent = newPlayer
	stats2.Parent = newPlayer
end



game.Players.ChildAdded:connect(onPlayerEntered) </ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
