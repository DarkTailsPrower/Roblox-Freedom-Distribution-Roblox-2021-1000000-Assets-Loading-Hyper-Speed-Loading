			<Item class="LocalScript" referent="RBX7220">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Local Gui</string>
					<ProtectedString name="Source">local Tool = script.Parent;

function stick(x, y)
	weld = Instance.new(&quot;Weld&quot;) 
	weld.Part0 = x
	weld.Part1 = y
	local HitPos = x.Position
	local CJ = CFrame.new(HitPos) 
	local C0 = x.CFrame:inverse() *CJ 
	local C1 = y.CFrame:inverse() * CJ 
	weld.C0 = C0 
	weld.C1 = C1 
	weld.Parent = x
end


enabled = true

function onButton1Down(mouse)
	if (not enabled) then return end
	enabled = false
	script.Parent.Fire.Value = true
	targ = mouse.Target
	if (targ == nil) then 
		script.Parent.Handle.Fail:play()
		enabled = true
		return 
	end
	hum = targ.Parent:findFirstChild(&quot;Humanoid&quot;)
	if (hum ~= nil) then
		script.Parent.Handle.Fail:play()
		c = Instance.new(&quot;ObjectValue&quot;)
		c.Name = &quot;creator&quot;
		c.Value = game.Players:findFirstChild(script.Parent.Parent.Name)
		c.Parent = hum
		hum.MaxHealth = 100
		hum.Health = hum.Health - 35
	end
	if (hum == nil) then
		script.Parent.Handle.Fail:play()
	end
	Hit = mouse.hit
	local P = Instance.new(&quot;Part&quot;) 
	P.Name = &quot;BulletTrail&quot; 
	local Place0 = script.Parent.Parent[&quot;Right Arm&quot;].CFrame 
	P.formFactor = 0 
	P.Size = Vector3.new(1,1,(Place0.p - Hit.p).magnitude) 
	P.CFrame = CFrame.new((Place0.p + Hit.p)/2,Place0.p) 
	P.Parent = script.Parent.Parent
	P.BrickColor = script.Parent.Part1.BrickColor
	P.Anchored = true 
	P.CanCollide = false
	m = Instance.new(&quot;BlockMesh&quot;)
	m.Scale = Vector3.new(0.1,0.1,1)
	m.Parent = P
	for count = 1, 10 do
		P.Transparency = count/10
		wait()
	end
	P:remove()
	enabled = true
end



function onEquippedLocal(mouse)



	if mouse == nil then

		print(&quot;Mouse not found&quot;)

		return 

	end



	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;

	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end





Tool.Equipped:connect(onEquippedLocal)
</ProtectedString>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX7221">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">WeldScript</string>
					<ProtectedString name="Source">t = script.Parent

function stick(x, y)
	weld = Instance.new(&quot;Weld&quot;) 
	weld.Part0 = x
	weld.Part1 = y
	local HitPos = x.Position
	local CJ = CFrame.new(HitPos) 
	local C0 = x.CFrame:inverse() *CJ 
	local C1 = y.CFrame:inverse() * CJ 
	weld.C0 = C0 
	weld.C1 = C1 
	weld.Parent = x
end

function Weldnow()
	c = t:children()
	for n = 1, #c do
		if (c[n].className == &quot;Part&quot;) then
			if (c[n].Name ~= &quot;Handle&quot;) then
				c[n].CFrame = t.Handle.CFrame
				stick(c[n], t.Handle)
			end
		end
	end
end

script.Parent.Equipped:connect(Weldnow)
script.Parent.Unequipped:connect(Weldnow)
Weldnow()</ProtectedString>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX7222">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">LaserFireAnimation</string>
					<ProtectedString name="Source">laser = script.Parent
while true do
	if (script.Parent.Fire.Value) then
		for a = 1, 4 do
			laser.Part1.Mesh.Offset = laser.Part1.Mesh.Offset + Vector3.new(0,0,0.2)
			laser.Part2.Mesh.Offset = laser.Part2.Mesh.Offset + Vector3.new(0,0,0.2)
			laser.Part3.Mesh.Offset = laser.Part3.Mesh.Offset + Vector3.new(0,0,0.2)
			laser.Part4.Mesh.Offset = laser.Part4.Mesh.Offset + Vector3.new(0,0,0.2)
			laser.Part5.Mesh.Offset = laser.Part5.Mesh.Offset + Vector3.new(0,0,0.2)
			laser.Part6.Mesh.Offset = laser.Part6.Mesh.Offset + Vector3.new(0,0,0.2)
			wait()
		end
		for a = 1, 4 do
			laser.Part1.Mesh.Offset = laser.Part1.Mesh.Offset - Vector3.new(0,0,0.2)
			laser.Part2.Mesh.Offset = laser.Part2.Mesh.Offset - Vector3.new(0,0,0.2)
			laser.Part3.Mesh.Offset = laser.Part3.Mesh.Offset - Vector3.new(0,0,0.2)
			laser.Part4.Mesh.Offset = laser.Part4.Mesh.Offset - Vector3.new(0,0,0.2)
			laser.Part5.Mesh.Offset = laser.Part5.Mesh.Offset - Vector3.new(0,0,0.2)
			laser.Part6.Mesh.Offset = laser.Part6.Mesh.Offset - Vector3.new(0,0,0.2)
			wait()
		end
		script.Parent.Fire.Value = false
	end
	wait()
end
		</ProtectedString>
