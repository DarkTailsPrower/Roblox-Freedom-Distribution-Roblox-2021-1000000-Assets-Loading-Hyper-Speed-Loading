										<ProtectedString name="Source">function clearlist()
l = script.Parent.plist:GetChildren()
for i = 1, #l do
if (l[i].className == &quot;TextButton&quot;) and (l[i].Name ~= &quot;close&quot;) then
l[i].Text = &quot;undefined&quot;
l[i].Visible = false
end
end
end
--Made by bubby4j
wait(1)
p = game.Players:GetChildren()
for i = 1, #p do
local find = script.Parent.plist:findFirstChild(i)
if find ~= nil then
find.Text = p[i].Name
find.TextColor = p[i].TeamColor
find.Visible = true
end
end

function opa(pa)
clearlist()
p = game.Players:GetChildren()
for i = 1, #p do
local find = script.Parent.plist:findFirstChild(i)
if find ~= nil then
find.Text = p[i].Name
find.TextColor = p[i].TeamColor
find.Visible = true
end
end
end

function opr(pr)
clearlist()
p = game.Players:GetChildren()
for i = 1, #p do
local find = script.Parent.plist:findFirstChild(i)
if find ~= nil then
find.Text = p[i].Name
find.TextColor = p[i].TeamColor
find.Visible = true
end
end
end
