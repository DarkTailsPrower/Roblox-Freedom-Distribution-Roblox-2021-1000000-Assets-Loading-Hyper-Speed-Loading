													<ProtectedString name="Source">function Click(mouse)
f = script.Parent.Parent.Parent:findFirstChild(&quot;Character&quot;)
c = script.Parent.Parent.Parent:findFirstChild(&quot;TitleBar&quot;)
if f ~= nil then
f.Visible = true
fc = f:FindFirstChild(&quot;Color&quot;)
if fc ~= nil then
fc.Visible = false
end
