										<Content name="LinkedSource"><null></null></Content>
										<string name="Name">Script</string>
										<ProtectedString name="Source">function onClicked()
	script.Parent.Parent.Door.CanCollide= false -- a walkthroughable door
	script.Parent.Parent.Door.Transparency= 0.1 -- an invisible door
	wait(0.01)
	script.Parent.Parent.Door.Transparency= 0.2 -- an invisible door
	wait(0.01)
	script.Parent.Parent.Door.Transparency= 0.3 -- an invisible door
	wait(0.01)
	script.Parent.Parent.Door.Transparency= 0.4 -- an invisible door
	wait(0.01)
	script.Parent.Parent.Door.Transparency= 0.5 -- an invisible door
	wait(0.01)
	script.Parent.Parent.Door.Transparency= 0.6 -- an invisible door
	wait(0.01)
	script.Parent.Parent.Door.Transparency= 0.7 -- an invisible door
	wait(0.01)
	script.Parent.Parent.Door.Transparency= 0.8 -- an invisible door
	wait(0.01)
	script.Parent.Parent.Door.Transparency= 0.9 -- an invisible door
	wait(0.01)
	script.Parent.Parent.Door.Transparency= 1 -- an invisible door
	wait(3)
	script.Parent.Parent.Door.Transparency= 0.9 -- an invisible door
	wait(0.01)
	script.Parent.Parent.Door.Transparency= 0.8 -- an invisible door
	wait(0.01)
	script.Parent.Parent.Door.Transparency= 0.7 -- an invisible door
	wait(0.01)
	script.Parent.Parent.Door.Transparency= 0.6 -- an invisible door
	wait(0.01)
	script.Parent.Parent.Door.Transparency= 0.5 -- an invisible door
	wait(0.01)
	script.Parent.Parent.Door.Transparency= 0.4 -- an invisible door
	wait(0.01)
	script.Parent.Parent.Door.Transparency= 0.3 -- an invisible door
	wait(0.01)
	script.Parent.Parent.Door.Transparency= 0.2 -- an invisible door
	wait(0.01)
	script.Parent.Parent.Door.Transparency= 0.1 -- an invisible door
	wait(0.01)
	script.Parent.Parent.Door.Transparency= 0 -- an invisible door
	script.Parent.Parent.Door.CanCollide= true -- a walkthroughable door
end
script.Parent.ClickDetector.MouseClick:connect(onClicked)</ProtectedString>
