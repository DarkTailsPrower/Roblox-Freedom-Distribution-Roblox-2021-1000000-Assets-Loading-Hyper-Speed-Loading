										<string name="Name">Script</string>
										<ProtectedString name="Source">local tycoon = script.Parent.Parent.Parent
local owner = tycoon.OwnerName
local speed = tycoon.Giver.Upgrade
local time = tycoon.Giver.Speed
local debounce = false
local cost = 0 -- change 150 to the price you want the upgrade income to start out at
local costAdd = 50 -- change 150 to the number you want the cost to add by each time upgraded
local incomeAdd = 1 -- change 5 to the number you want the income to upgrade by
local times = 50 -- change 5 to the number of times uo upgrade income
local timeNum = 0 --don&apos;t mess with this

script.Parent.Touched:connect(function(hit)
local player = game.Players:GetPlayerFromCharacter(hit.Parent)
if player ~= nil and debounce == false then
local alert = player.PlayerGui
debounce = true
if owner.Value ~= player.Name then
alert.TycoonGui.TextLable.Text = &quot;You are not the owner of this tycoon!&quot; 
for i = 1,10 do
alert.TycoonGui.TextLable.BackgroundTransparency = alert.TycoonGui.TextLable.BackgroundTransparency - 0.1
alert.TycoonGui.TextLable.TextTransparency = alert.TycoonGui.TextLable.TextTransparency - 0.1
wait(0.01)
end
wait(3)
for i = 1,10 do
alert.TycoonGui.TextLable.BackgroundTransparency = alert.TycoonGui.TextLable.BackgroundTransparency + 0.1
alert.TycoonGui.TextLable.TextTransparency = alert.TycoonGui.TextLable.TextTransparency + 0.1
wait(0.01)
end
wait(2) 
debounce = false
return end
if player.leaderstats.Cash.Value &lt; cost then
local mn = cost-player.leaderstats.Cash.Value
alert.TycoonGui.TextLable.Text = &quot;Not enough cash! You need &quot; ..mn.. &quot; more cash&quot;
for i = 1,10 do
alert.TycoonGui.TextLable.BackgroundTransparency = alert.TycoonGui.TextLable.BackgroundTransparency - 0.1
alert.TycoonGui.TextLable.TextTransparency = alert.TycoonGui.TextLable.TextTransparency - 0.1
wait(0.01)
end
wait(5)
for i = 1,10 do
alert.TycoonGui.TextLable.BackgroundTransparency = alert.TycoonGui.TextLable.BackgroundTransparency + 0.1
alert.TycoonGui.TextLable.TextTransparency = alert.TycoonGui.TextLable.TextTransparency + 0.1
wait(0.01)
end
wait(2) -- you can change the wait time to allow to be touched again
debounce = false
return end
player.leaderstats.Cash.Value = player.leaderstats.Cash.Value - cost
speed.Value = speed.Value + incomeAdd
cost = cost + costAdd
timeNum = timeNum + 1
alert.TycoonGui.TextLable.Text = &quot;Upgraded! Income is now +&quot; ..speed.Value.. &quot; cash every &quot; ..time.Value.. &quot; seconds.&quot;
for i = 1,10 do
alert.TycoonGui.TextLable.BackgroundTransparency = alert.TycoonGui.TextLable.BackgroundTransparency - 0.1
alert.TycoonGui.TextLable.TextTransparency = alert.TycoonGui.TextLable.TextTransparency - 0.1
wait(0.01)
end
wait(5)
for i = 1,10 do
alert.TycoonGui.TextLable.BackgroundTransparency = alert.TycoonGui.TextLable.BackgroundTransparency + 0.1
alert.TycoonGui.TextLable.TextTransparency = alert.TycoonGui.TextLable.TextTransparency + 0.1
wait(0.01)
end
script.Parent.Parent.Name = &quot;Upgrade income - &quot; ..cost.. &quot; cash&quot;
if timeNum == times then
for i = 1,10 do
wait(0.01)
script.Parent.Transparency = script.Parent.Transparency + 0.1
debounce = true
end
script.Parent.Parent:Remove()
end
wait(2) -- you can change the wait time to allow to be touched again
debounce = false
end
end)</ProtectedString>
