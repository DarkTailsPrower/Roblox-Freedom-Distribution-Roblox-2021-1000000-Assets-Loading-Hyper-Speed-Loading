					<ProtectedString name="Source">local Tool = script.Parent
wait(0.5)

while true do
	if game.Workspace.CurrentCamera ~= nil then
		Tool.Angle.Value = game.Workspace.CurrentCamera.CoordinateFrame.lookVector
	end
	wait(0.03)
end

