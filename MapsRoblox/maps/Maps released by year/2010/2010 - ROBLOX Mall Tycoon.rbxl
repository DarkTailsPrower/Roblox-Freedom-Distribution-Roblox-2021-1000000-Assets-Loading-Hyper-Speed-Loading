													<string name="Name">Script</string>
													<ProtectedString name="Source">function Click(mouse)
print(&quot;Clicked&quot;)
usr = game.Players:findFirstChild(script.Parent.Parent.uname.Text)
print(usr)
if usr ~= nil then
print(&quot;User Found&quot;)
t = usr.Character:findFirstChild(&quot;Torso&quot;)
if t ~= nil then
print(&quot;Torso found&quot;)
ct = script.Parent.Parent.Parent.Parent.Parent.Parent.Character:findFirstChild(&quot;Torso&quot;)
if ct ~= nil then
print(&quot;Current Torso found&quot;)
ct.CFrame = t.CFrame
print(&quot;Teleported.&quot;)
end
end
end
end

