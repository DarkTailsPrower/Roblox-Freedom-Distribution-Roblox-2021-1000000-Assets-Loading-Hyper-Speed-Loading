													<string name="Name">Script</string>
													<ProtectedString name="Source">function oc()
player = game.Players:findFirstChild(script.Parent.Parent.Parent.Parent.CU.Value)
script.Parent.Visible = false
script.Parent.Parent[&quot;pants&quot;].Visible = false
if player ~= nil then
p = player.Character:GetChildren()
for i = 1, #p do
if p[i].className == &quot;Pants&quot; then
p[i]:remove()
end
end
end
end

