if sc == nil then
s = Instance.new(&quot;Sparkles&quot;)
s.Parent = t
end
end
end
else 
script.Parent.Text = script.Parent.Parent.uname.Text ..&quot; was not found&quot;
wait(2)
script.Parent.Text = &quot;Sparkles On&quot;
end
end


