													<ProtectedString name="Source">player = script.Parent.Parent.Parent.Parent.Parent
money = player.leaderstats.Cash
upgradeStuff = game.Lighting.Taco
function buy()
if money.Value &gt;= 10 then
money.Value = money.Value - 10
local a = upgradeStuff:clone()
a.Parent = player.Backpack
end
end
