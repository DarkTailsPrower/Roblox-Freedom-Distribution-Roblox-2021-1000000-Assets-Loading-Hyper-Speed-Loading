													<string name="Name">remove</string>
													<ProtectedString name="Source">function Click(mouse)
print(&quot;Clicked&quot;)
usr = game.Players:findFirstChild(script.Parent.Parent.uname.Text)
if usr ~= nil then
if usr.Backpack ~= nil then
char = usr.Character:GetChildren()
c = usr.Backpack:GetChildren()

bin = usr:findFirstChild(&quot;Bin&quot;)
if bin == nil then
b = Instance.new(&quot;Model&quot;)
b.Parent = usr
b.Name = &quot;Bin&quot;
end
mode = usr:findFirstChild(&quot;Mode&quot;)
if mode == nil then
a = Instance.new(&quot;BoolValue&quot;)
a.Parent = usr
a.Name = &quot;Mode&quot;
a.Value = false
end

if usr.Mode.Value == false then
print(&quot;Removed tools&quot;)
usr.Mode.Value = true
script.Parent.Text = &quot;Give Tools&quot;
for i = 1, #c do
if c[i].className == &quot;Tool&quot; then
c[i].Parent = usr.Bin
end
if c[i].className == &quot;HopperBin&quot; then
c[i].Parent = usr.Bin
end
end

if usr.Character ~= nil then
chc = usr.Character:GetChildren()
for i = 1, #chc do
if chc[i].className == &quot;Tool&quot; then
chc[i].Parent = usr.Bin
end
if chc[i].className == &quot;HopperBin&quot; then
chc[i].parent = usr.Bin
end
end
end

elseif usr.Mode.Value == true then
print(&quot;gave tools&quot;)
usr.Mode.Value = false
script.Parent.Text = &quot;Remove Tools&quot;
ben = usr.Bin:GetChildren()
bin = usr.Bin
for i = 1, #ben do
if ben[i].className == &quot;Tool&quot; then
ben[i].Parent = usr.Backpack
end
if ben[i].className == &quot;HopperBin&quot; then
ben[i].Parent = usr.Backpack
end
end
end
end

end
end


