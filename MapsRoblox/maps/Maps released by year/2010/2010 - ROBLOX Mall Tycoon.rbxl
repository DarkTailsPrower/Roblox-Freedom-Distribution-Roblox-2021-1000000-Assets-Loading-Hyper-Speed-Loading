										<X>0</X>
										<Y>0</Y>
										<Z>0</Z>
									</Vector3>
									<bool name="archivable">true</bool>
									<token name="shape">1</token>
									<Vector3 name="size">
										<X>1.80000091</X>
										<Y>0.200000003</Y>
