								<Item class="Script" referent="RBX1184">
									<Properties>
										<bool name="Disabled">false</bool>
										<Content name="LinkedSource"><null></null></Content>
										<string name="Name">Script</string>
										<ProtectedString name="Source">local ting = 0 --debouncer
owner = script.Parent.Parent.Parent.OwnerName
function onTouched(hit)
	if ting == 0 then --debounce check
	ting = 1 --activate debounce
	local check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;) --Find the human that touched the button
		if check ~= nil then --If a human is found, then
			local thisplr = game.Players:findFirstChild(hit.Parent.Name)
			if (thisplr~=nil) then
				local ownstyc = thisplr:findFirstChild(&quot;Tycoon&quot;)
				if (ownstyc~=nil) then
					if ownstyc.Value == 0 then
						ownstyc.Value = 1
						owner.Value = thisplr.Name
						local Gui = thisplr:findFirstChild(&quot;PlayerGui&quot;)
						if (Gui~=nil) then
							Gui.TycoonGui.TextLable.Text = &quot;You now own TacoTime&quot;
							for i = 1,10 do
							Gui.TycoonGui.TextLable.BackgroundTransparency = Gui.TycoonGui.TextLable.BackgroundTransparency - 0.1
							Gui.TycoonGui.TextLable.TextTransparency = Gui.TycoonGui.TextLable.TextTransparency - 0.1
							wait(0.01)
							end
							wait(2)
							for i = 1,10 do
							Gui.TycoonGui.TextLable.BackgroundTransparency = Gui.TycoonGui.TextLable.BackgroundTransparency + 0.1
							Gui.TycoonGui.TextLable.TextTransparency = Gui.TycoonGui.TextLable.TextTransparency + 0.1
							wait(0.01)
							end
						end
						for i = 1,10 do
						script.Parent.Transparency = script.Parent.Transparency + 0.1
						wait(0.01)
						end
						script.Parent.Parent:remove()
					elseif ownstyc.Value == 1 then
						local Gui = thisplr:findFirstChild(&quot;PlayerGui&quot;)
						if (Gui~=nil) then
							Gui.TycoonGui.TextLable.Text = &quot;You already own a store&quot;
							for i = 1,10 do
							Gui.TycoonGui.TextLable.BackgroundTransparency = Gui.TycoonGui.TextLable.BackgroundTransparency - 0.1
							Gui.TycoonGui.TextLable.TextTransparency = Gui.TycoonGui.TextLable.TextTransparency - 0.1
							wait(0.01)
							end
							wait(2)
							for i = 1,10 do
							Gui.TycoonGui.TextLable.BackgroundTransparency = Gui.TycoonGui.TextLable.BackgroundTransparency + 0.1
							Gui.TycoonGui.TextLable.TextTransparency = Gui.TycoonGui.TextLable.TextTransparency + 0.1
							wait(0.01)
							end
						end
					end
				end
			end
		end
	ting = 0 --remove debounce
	end
end

script.Parent.Touched:connect(onTouched) --Start listening for button-touchers.
</ProtectedString>
										<bool name="archivable">true</bool>
									</Properties>
