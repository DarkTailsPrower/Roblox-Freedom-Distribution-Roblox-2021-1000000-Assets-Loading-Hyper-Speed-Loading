if usr ~= nil then
if usr.Character ~= nil then
c = usr.Character:findFirstChild(&quot;Humanoid&quot;)
if c ~= nil then
c.Health = script.Parent.Text
print(&quot;go ahead, doing it!&quot;)
script.Parent.Parent.health.Text = &quot;Health: &quot; ..string.sub(c.Health,1,3).. &quot;/&quot; .. c.MaxHealth
end
end
