													<ProtectedString name="Source">function Click(mouse)
usr = game.Players:findFirstChild(script.Parent.Parent.uname.Text)
if usr ~= nil then
usr = usr.Character
print(&quot;click&quot;)
humanoid = usr:findFirstChild(&quot;Humanoid&quot;)
print(&quot;Setting up humanoid&quot;)

if humanoid ~= nil then
print(&quot;humanoid isnt nil&quot;)
humanoid.WalkSpeed = 0
print(&quot;walkspeed&quot;)
end

local c = usr:GetChildren()
for i =1,#c do
if c[i].className == &quot;Part&quot; then

c[i].Anchored = true
c[i].Reflectance = 1

end
end
end
end


