		<Item class="Tool" referent="RBX7646">
			<Properties>
				<bool name="Enabled">true</bool>
				<CoordinateFrame name="Grip">
					<X>0</X>
					<Y>0</Y>
					<Z>0</Z>
					<R00>1</R00>
					<R01>0</R01>
					<R02>0</R02>
					<R10>0</R10>
					<R11>-4.37113883e-008</R11>
					<R12>-1</R12>
					<R20>0</R20>
					<R21>1</R21>
					<R22>-4.37113883e-008</R22>
				</CoordinateFrame>
				<string name="Name">FourInARow</string>
				<Content name="TextureId"><url>http://www.roblox.com/asset/?id=17119809</url></Content>
				<bool name="archivable">true</bool>
			</Properties>
