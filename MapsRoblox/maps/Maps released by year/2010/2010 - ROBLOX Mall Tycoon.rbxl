													<ProtectedString name="Source">function oc()
player = game.Players:findFirstChild(script.Parent.Parent.Parent.Parent.CU.Value)
if player ~= nil then
script.Parent.Visible = false
script.Parent.Parent[&quot;Head&quot;].Visible = false
if player.Character ~= nil then
