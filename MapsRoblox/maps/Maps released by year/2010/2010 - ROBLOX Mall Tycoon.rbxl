										<Content name="LinkedSource"><null></null></Content>
										<string name="Name">Script</string>
										<ProtectedString name="Source">-------------------------------------------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------------------------------------
model = script.Parent.Parent.Parent.Badge
Upgradecost = 1000
-------------------------------------------------------------------------------------------------------------------------
upgradeStuff = model:clone()

wait(1)

model:remove()
owner = script.Parent.Parent.Parent.OwnerName 
local ting = 0

function onTouched(hit)
	if ting == 0 then
	ting = 1
	check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)

	if check ~= nil then
	if hit.Parent.Name == owner.Value then
		local user = game.Players:GetPlayerFromCharacter(hit.Parent)
		local stats = user:findFirstChild(&quot;leaderstats&quot;)

		if stats ~= nil then
			local cash = stats:findFirstChild(&quot;Cash&quot;)
			local thisplr = game.Players:findFirstChild(hit.Parent.Name)
			if (thisplr~=nil) then
			local Gui = thisplr:findFirstChild(&quot;PlayerGui&quot;)
			if cash.Value &gt; (Upgradecost-1) then
				cash.Value = cash.Value - Upgradecost
				upgradeStuff.Parent = script.Parent.Parent.Parent
				script.Parent.Parent:remove()

						if (Gui~=nil) then
							Gui.TycoonGui.TextLable.Text = &quot;You have purchased a Badge for $&quot; ..Upgradecost
							for i = 1,10 do
							Gui.TycoonGui.TextLable.BackgroundTransparency = Gui.TycoonGui.TextLable.BackgroundTransparency - 0.1
							Gui.TycoonGui.TextLable.TextTransparency = Gui.TycoonGui.TextLable.TextTransparency - 0.1
							wait(0.01)
							end
							wait(2)
							for i = 1,10 do
							Gui.TycoonGui.TextLable.BackgroundTransparency = Gui.TycoonGui.TextLable.BackgroundTransparency + 0.1
							Gui.TycoonGui.TextLable.TextTransparency = Gui.TycoonGui.TextLable.TextTransparency + 0.1
							wait(0.01)
							end
						end
			else 
			Gui.TycoonGui.TextLable.Text = &quot;You need $&quot; ..Upgradecost - cash.Value.. &quot; more for this Badge&quot;
			for i = 1,10 do
			Gui.TycoonGui.TextLable.BackgroundTransparency = Gui.TycoonGui.TextLable.BackgroundTransparency - 0.1
			Gui.TycoonGui.TextLable.TextTransparency = Gui.TycoonGui.TextLable.TextTransparency - 0.1
			wait(0.01)
