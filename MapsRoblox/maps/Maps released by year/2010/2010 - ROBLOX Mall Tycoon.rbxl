											<string name="Name">GetTeams</string>
											<ProtectedString name="Source">t = game.Teams:GetChildren()
lpos = UDim2.new(0, 0, 0, 0) 
for i = 1, #t do
if i &lt;= 9 then
if t[i].className == &quot;Team&quot; then
local n = script.Parent.start:clone()
n.Script.Disabled = false
n.Position = lpos + UDim2.new(0, 0, 0.1, 0) 
lpos = n.Position
n.Text = t[i].Name
n.Visible = true
n.Name = t[i].Name
n.Parent = script.Parent
end
end
end </ProtectedString>
