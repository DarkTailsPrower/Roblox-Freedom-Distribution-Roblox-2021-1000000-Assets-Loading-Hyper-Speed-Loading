												<string name="Name">Move</string>
												<ProtectedString name="Source">bar=script.Parent.Parent
drag=false 

function oD(xpos,ypos) 
print(xpos,ypos) 
drag=true 
end 

function oU() 
drag=false 
end 

function mO(xpos,ypos) 
if (drag==true) then 
bar.Position=UDim2.new(0,(xpos - bar.Position.X),0,(ypos - bar.Position.Y))
end 
end 

function mL() 
drag=false 
end 

script.Parent.MouseButton1Down:connect(oD) 
script.Parent.MouseButton1Up:connect(oU) 
script.Parent.MouseMoved:connect(mO) 
script.Parent.MouseLeave:connect(mL)</ProtectedString>
