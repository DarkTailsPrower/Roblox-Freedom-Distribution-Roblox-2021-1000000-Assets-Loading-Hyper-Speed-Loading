					<string name="Name">Welder</string>
					<ProtectedString name="Source">local noob= script.Parent

noob.Torso.Anchored = true
noob.LeftArm.Anchored = true
noob.RightArm.Anchored = true
noob.LeftLeg.Anchored = true
