															<string name="Name">Color script</string>
															<ProtectedString name="Source">mouseover = false

function click()
print(&quot;clicked!!!!!&quot;)
script.Parent.Parent.Parent.Visible = false
--Made by bubby4j
c1 = game.Players:findFirstChild(script.Parent.Parent.Parent.Parent.Parent.Parent.CU.Value).Character

if c1 ~= nil then
print(&quot;passed character test&quot;)
c2 = c1:FindFirstChild(script.Parent.Parent.Parent.Value.Value)
if c2 ~= nil then
print(&quot;color changed&quot;)
c2.BrickColor = script.Parent.BrickColor.Value
c2.Transparency = 1
c2.Transparency = 0
end
end

end

