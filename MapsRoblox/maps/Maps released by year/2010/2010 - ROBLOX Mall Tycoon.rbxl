											<Item class="LocalScript" referent="RBX559">
												<Properties>
													<bool name="Disabled">false</bool>
													<Content name="LinkedSource"><null></null></Content>
													<string name="Name">Main</string>
													<ProtectedString name="Source">DayTab = {31,28,31,30,31,30,31,31,30,31,30,31}
Seconds = 0
D = {Month = 0, Day = 0, Year = 0}
Zone = &quot; PM&quot;

function Divisable(num, div)
return (math.floor(num/div) == num/div)
end

function formatDate(advance)
if advance == true then
D.Day = D.Day + 1
end
if Divisable(D.Year, 4) and (D.Month == 2) then -- Leap Year
	if D.Day &gt; 29 then
		D.Day = 1
		D.Month = D.Month + 1
	end
else
	if D.Day &gt; DayTab[D.Month] then
	D.Day = 1
	D.Month = D.Month + 1
		if D.Month &gt; 12 then
		D.Month = 1
		D.Year = D.Year + 1
		end
	end
end
local da = &quot;&quot;
if D.Month &lt; 10 then
	da = &quot;0&quot;..tostring(D.Month)
else
	da = tostring(D.Month)
end
if D.Day &lt; 10 then
	da = da..&quot;/0&quot;..tostring(D.Day)
else
	da = da..&quot;/&quot;..tostring(D.Day)
end
da = da..&quot;/&quot;..tostring(D.Year)
return da
end

function formatTime(secs)
local t = &quot;&quot;
local hours = math.floor(secs/3600)
secs = secs - (hours * 3600)
local mins = math.floor(secs/60)
secs = secs - (mins * 60)
if hours &lt; 10 then
t = &quot;0&quot;..tostring(hours)
else
t = tostring(hours)
end
if mins &lt; 10 then
t = t..&quot;:0&quot;..tostring(mins)
else
t = t..&quot;:&quot;..tostring(mins)
end
if secs &lt; 10 then
t = t..&quot;:0&quot;..tostring(secs)
else
t = t..&quot;:&quot;..tostring(secs)
end
return t
end

Info = game:GetService(&quot;NetworkClient&quot;).Ticket
local a = Info:find(&quot; &quot;)
local b = Info:find(&quot;;&quot;)
Time = Info:sub(a+1, b-4)
local c = Time:find(&quot;:&quot;)
local d = Time:find(&quot;:&quot;, c+1)
Date = Info:sub(1,a-1)
local e = Date:find(&quot;/&quot;)
local f = Date:find(&quot;/&quot;, e+1)
D = {Month = tonumber(Date:sub(1, e-1)), Day = tonumber(Date:sub(e+1, f-1)) - 1, Year = tonumber(Date:sub(f+1))}
Seconds = (tonumber(Time:sub(1,c-1)) * 3600) + (tonumber(Time:sub(c+1,d-1)) * 60) + tonumber(Time:sub(d+1) + math.ceil(time()))
Zone = Info:sub(b-3, b-1)
script.Parent.Date.Text = formatDate(true)

if Seconds &lt; 3600 then
script.Parent.StartedTime.Text = formatTime(((43200 + Seconds) - math.floor(game.Workspace.DistributedGameTime)))..Zone
else
script.Parent.StartedTime.Text = formatTime((Seconds - math.floor(game.Workspace.DistributedGameTime)))..Zone
end
script.Parent.StartedDate.Text = formatDate(false)
while true do
if Seconds &lt; 3600 then
script.Parent.Time.Text = formatTime(43200 + Seconds)..Zone
else
script.Parent.Time.Text = formatTime(Seconds)..Zone
end
Seconds = Seconds + 1
if Seconds &gt; 39600 then
Seconds = 0
	if Zone == &quot; PM&quot; then
	script.Parent.Date.Text = formatDate(true)
	Zone = &quot; AM&quot;
	else
	Zone = &quot; PM&quot;
	end
end
wait(1)
end </ProtectedString>
