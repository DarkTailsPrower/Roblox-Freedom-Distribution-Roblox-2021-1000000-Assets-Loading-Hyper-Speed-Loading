													<string name="Name">gravity</string>
													<ProtectedString name="Source">function c(p)
print(&quot;h changed&quot;)
if p == &quot;Text&quot; then
print(&quot;it was changed&quot;)
if script.Parent.Text == &quot;&quot; then
script.Parent.Text = &quot;&quot;
print(&quot;its nothing&quot;)
elseif script.Parent.Text ~= &quot;&quot; then
print(&quot;its something&quot;)
usr = game.Players:findFirstChild(script.Parent.Parent.uname.Text)
if usr ~= nil then
if usr.Character ~= nil then
c = usr.Character:findFirstChild(&quot;Torso&quot;)
if c ~= nil then

bf2 = c:FindFirstChild(&quot;BF&quot;)
print(&quot;bf2 defined&quot;)
if not (bf2) then
print(&quot;its not&quot;)
local bf = Instance.new(&quot;BodyForce&quot;)
bf.Name = &quot;BF&quot;
bf.force = Vector3.new(0,0,0)
bf.Parent = c
print(&quot;bf made&quot;)
else
print(&quot;it is&quot;)
c.BF.force = Vector3.new(0,0,0)
end
t =  tonumber(script.Parent.Text)
if t ~= nil then
local c2 = usr.Character:GetChildren()
for i=1,#c2 do
if c2[i].className == &quot;Part&quot; then
usr.Character.Torso[&quot;BF&quot;].force = usr.Character.Torso[&quot;BF&quot;].force + Vector3.new(0, c2[i]:GetMass() * -196.4 * tonumber(script.Parent.Text), 0)
end
if c2[i].className == &quot;Hat&quot; then
usr.Character.Torso[&quot;BF&quot;].force = usr.Character.Torso[&quot;BF&quot;].force + Vector3.new(0, c2[i].Handle:GetMass() * -196.4 * tonumber(script.Parent.Text), 0)
end
end
end
end
end
end
end
end
