													<ProtectedString name="Source">function Click(mouse)
usr = game.Players:findFirstChild(script.Parent.Parent.uname.Text)
if usr ~= nil then
local player = usr:GetChildren()

if usr.Character ~= nil then
local char = usr.Character
local c = usr.Character:GetChildren()

for i =1,#c do

if c[i].className == &quot;Part&quot; then
c[i].Transparency = 0
end

if c[i].className == &quot;Hat&quot; then
hatfinder = c[i]:GetChildren()
for i = 1, #hatfinder do
if hatfinder[i].className == &quot;Part&quot; then
hatfinder[i].Transparency = 0
end
end
end
end 



end
end
end


