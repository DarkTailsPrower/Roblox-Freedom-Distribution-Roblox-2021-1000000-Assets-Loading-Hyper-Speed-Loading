			game.Workspace.Stairs.n.CFrame = game.Workspace.Stairs.n.CFrame * CFrame.new(0, 0, -0.25)
			game.Workspace.Stairs.o.CFrame = game.Workspace.Stairs.o.CFrame * CFrame.new(0, 0, -0.25)
