	script.Parent.Parent.Door.Transparency= 0.2 -- an invisible door
	wait(0.01)
	script.Parent.Parent.Door.Transparency= 0.1 -- an invisible door
	wait(0.01)
	script.Parent.Parent.Door.Transparency= 0 -- an invisible door
	script.Parent.Parent.Door.CanCollide= true -- a walkthroughable door
end
