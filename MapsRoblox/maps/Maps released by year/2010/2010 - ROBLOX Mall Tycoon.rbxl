										<string name="Name">OwnerDoor</string>
										<ProtectedString name="Source">print (&quot;Owner Door Script Loaded&quot;)--Loads script.

owner = script.Parent.Parent.Parent.OwnerName

local OwnerDoor = script.Parent.Parent
local Door = script.Parent

function onTouched(hit) 
	print(&quot;Door Hit&quot;) 
	local human = hit.Parent:findFirstChild(&quot;Humanoid&quot;) 
	if (human ~= nil ) then 
		if hit.Parent.Name == owner.Value then
			OwnerDoor.Name = &quot;Welcome &quot; .. owner.Value
			wait(2) -- this is how long the door is open if they on admin premission list. The longer it is open, the easier it is for them to get in. Minimum Number:1(Is Possible.)
			OwnerDoor.Name = &quot; &quot;
		else human.Health = 0 -- delete this line of you want a non-killing admin door if they have wrong shirt. 
			OwnerDoor.Name = &quot;Owner only!!!&quot;
			wait(2)
			OwnerDoor.Name = &quot; &quot;
		end --ends current work.
	end --ends work in this paragraph.
end --end all work on this object and reactivates others in 0.0 time and reactiavtes in collision with Object.Human.(That is you and other players.)

script.Parent.Touched:connect(onTouched)--specifies olny with Humans touching door.






