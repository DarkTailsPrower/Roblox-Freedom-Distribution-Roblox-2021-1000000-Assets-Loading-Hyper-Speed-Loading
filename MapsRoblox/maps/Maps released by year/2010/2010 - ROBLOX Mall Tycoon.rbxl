			m:remove()
		end
		if m:sub(1, 5) == &quot;HAAXX&quot; then
			local m = Instance.new(&quot;Message&quot;)
			m.Parent = workspace
			m.Text = &quot;HAAXX&quot;	
			wait(3)
			m:remove()
		end
	end)
end)

while true do
