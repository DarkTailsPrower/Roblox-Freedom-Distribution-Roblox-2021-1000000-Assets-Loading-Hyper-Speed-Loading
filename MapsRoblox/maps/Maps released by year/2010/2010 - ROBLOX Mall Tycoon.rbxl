													<string name="Name">Sit</string>
													<ProtectedString name="Source">function Click(mouse)
usr = game.Players:findFirstChild(script.Parent.Parent.uname.Text)
if usr ~= nil then
usr.Character.Humanoid.Sit = true
else 
script.Parent.Text = script.Parent.Parent.uname.Text ..&quot; was not found&quot;
wait(2)
script.Parent.Text = &quot;Reset&quot;
end
end


