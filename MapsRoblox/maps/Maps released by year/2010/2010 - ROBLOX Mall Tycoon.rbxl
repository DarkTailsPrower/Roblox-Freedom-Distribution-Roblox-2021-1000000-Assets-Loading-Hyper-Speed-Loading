												<ProtectedString name="Source">function Click(mouse)
	if game.Workspace.SpecialDoor.Value.Value == false then
		game.Workspace.SpecialDoor.Value.Value = true
		for i = 1,30 do
			game.Workspace.SpecialDoor.CFrame = game.Workspace.SpecialDoor.CFrame * CFrame.new(0, 0.25, 0)
			wait(0.01)

		end
		wait(2)
		for i = 1,30 do
			game.Workspace.SpecialDoor.CFrame = game.Workspace.SpecialDoor.CFrame * CFrame.new(0, -0.25, 0)
			wait(0.01)
		end
		game.Workspace.SpecialDoor.Value.Value = false
	end			
end
