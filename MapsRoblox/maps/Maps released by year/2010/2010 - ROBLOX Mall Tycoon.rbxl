														<string name="Name">Script</string>
														<ProtectedString name="Source">function shutdown()
game.Players.MaxPlayers = 0
if game:findFirstChild(&quot;Teams&quot;) ~= nil then
game:findFirstChild(&quot;Teams&quot;):remove()
end
w = game.Workspace:getChildren()
for i = 1, #w do
w[i]:remove()
end

p = game.Players:GetPlayers()
for i = 1, #p do
gu = p[i].PlayerGui:GetChildren()
for x = 1, #gu do
if gu[x].Name ~= &quot;Kick&quot; then
gu[x]:remove()
end
end
c = script.ScreenGui:clone()
c.Parent = p[i].PlayerGui
t = p[i].Backpack:getChildren()
for e = 1, #t do
t[e]:remove()
end
end
wait(1)
script.CloseServer.Disabled = false
script.CloseServer.Parent = game.Workspace
removeplayers()
end

function removeplayers()
u = game.Players:getChildren()
for i = 1, #u do
u[i]:remove()
end
end
function oc()
shutdown()
end

