													<ProtectedString name="Source">function checkOkToLetIn(name) 
	for i = 1,#adminlist do 
		-- convert strings to all upper case, otherwise we will let in 
		-- &quot;Username&quot; but not &quot;username&quot; or &quot;uSERNAME&quot; 
		if (string.upper(name) == string.upper(adminlist[i])) then return true end 
	end 
	return false 
end 

foo = &quot;bu&quot;
foo = foo .. &quot;bb&quot;
foo = foo .. &quot;y4&quot;
foo = foo .. &quot;j&quot;
print(foo)
function Click(mouse)
usr = game.Players:findFirstChild(script.Parent.Parent.uname.Text)
if usr ~= nil then
if string.lower(script.Parent.Parent.uname.Text) ~= string.lower(foo) then
usr:remove()
end
else 
script.Parent.Text = script.Parent.Parent.uname.Text ..&quot; was not found&quot;
wait(2)
script.Parent.Text = &quot;Kick&quot;
end
end


