			<Item class="LocalScript" referent="RBX7814">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Local Gui</string>
					<ProtectedString name="Source">local Tool = script.Parent;

local enabled = true
local checking = true

function onButton1Down(mouse)

	if not enabled then
		return
	end

	enabled = false

	script.Parent.PersonToAttack.Value = mouse.Target.Parent:FindFirstChild(&quot;Torso&quot;)

	mouse.Icon = &quot;http://www.roblox.com/asset/?id=27398778&quot;
	wait(28)

	enabled = true

	mouse.Icon = &quot;http://www.roblox.com/asset/?id=27404887&quot;

end

function onEquippedLocal(mouse)

	if mouse == nil then
		print(&quot;Mouse not found&quot;)
		return 
	end

	if enabled then
		mouse.Icon = &quot;http://www.roblox.com/asset/?id=27404887&quot;
	else
		mouse.Icon = &quot;http://www.roblox.com/asset/?id=27398778&quot;
	end
		
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)

	checking = true
	checkForIconChange(mouse)

end

function onUnequippedLocal()

	checking = false

end

function checkForIconChange(mouse)

	while checking do
		
		if enabled then
			mouse.Icon = &quot;http://www.roblox.com/asset/?id=27404887&quot;
		else
			mouse.Icon = &quot;http://www.roblox.com/asset/?id=27398778&quot;
		end
		wait(1)

	end

end

Tool.Unequipped:connect(onUnequippedLocal)
Tool.Equipped:connect(onEquippedLocal)
