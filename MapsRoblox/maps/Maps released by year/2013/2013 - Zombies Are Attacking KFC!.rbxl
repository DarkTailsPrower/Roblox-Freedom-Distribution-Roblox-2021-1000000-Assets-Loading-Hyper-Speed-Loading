local range = 20

function CheckMaster()
&#9;if eng.BrickColor ~= script.Parent.Parent.Torso.BrickColor then
&#9;eng.BrickColor = script.Parent.Parent.Torso.BrickColor 
&#9;end
&#9;range = 20 + (script.Parent.Parent.Humanoid.MaxHealth - script.Parent.Parent.Humanoid.Health)
end

function onDie()
&#9;if connection ~= nil then
&#9;&#9;connection:disconnect()
&#9;end
&#9;local c = game.Players:GetChildren()
&#9;local humans = {}
&#9;for i = 1, #c do
&#9;&#9;if c[i].Character ~= nil and c[i].Character ~= target and c[i].Character.Humanoid.Health &gt; 0 and eng.Immune.Value ~= (c[i].Name) and c[i].TeamColor ~= script.Parent.Team.Value then
&#9;&#9;&#9;table.insert(humans, c[i].Character)
&#9;&#9;&#9;print(humans)
&#9;&#9;end
&#9;end
&#9;if #humans == 0 then
&#9;&#9;target = &quot;&quot;
&#9;&#9;return
&#9;end
&#9;for i = 1, #humans do
&#9;&#9;local mag = (humans[i].Head.Position - eng.Parent.Torso.Position).magnitude
&#9;&#9;if mag &lt; range then
&#9;&#9;&#9;range = mag
&#9;&#9;end
&#9;end
&#9;for i = 1, #humans do
&#9;&#9;if (humans[i].Head.Position - eng.Parent.Torso.Position).magnitude == range then
&#9;&#9;&#9;target = humans[i]&#9;
&#9;&#9;end
&#9;end
&#9;if target ~= &quot;&quot; then
&#9;connection = target.Humanoid.Died:connect(onDie)
&#9;end
end

function fire(eng)
local haed = target.Torso
if (haed ~= nil) then
eng.BodyGyro.cframe = CFrame.new(eng.Position, target.Torso.Position)
local beam = Instance.new(&quot;Part&quot;)
&#9;beam.formFactor = 0
&#9;beam.Transparency = 0.3
&#9;beam.CanCollide = false
&#9;beam.Anchored = true
&#9;beam.Name = &quot;Beam&quot;
&#9;beam.Size = Vector3.new(1,1,1)
&#9;beam.BrickColor = BrickColor.new(colors[math.random(1, #colors)])
&#9;beam.Parent = Workspace
&#9;beam.CFrame = CFrame.new((target.Torso.Position + eng.Position) / 2, target.Torso.Position) * CFrame.fromEulerAnglesXYZ(1.57,0,0)
&#9;local mesh = Instance.new(&quot;BlockMesh&quot;)
&#9;mesh.Parent = beam
&#9;mesh.Scale = (mesh.Scale - Vector3.new(0,mesh.Scale.y,0)) + Vector3.new(0,1,0)
&#9;mesh.Scale = mesh.Scale + Vector3.new(0,(target.Torso.Position - eng.Position).magnitude - 1,0)
&#9;local scrapt = eng.Clean:clone()
&#9;scrapt.Disabled = false
&#9;scrapt.Parent = beam
&#9;target.Humanoid:TakeDamage(20)
&#9;wait(0.5)
&#9;beam.Parent = nil
end
end

while true do
&#9;onDie()
&#9;CheckMaster()
&#9;if target ~= &quot;&quot; and eng.Parent.Active ~= nil and eng.Parent.Active.Value ~= false then
&#9;&#9;eng.BodyPosition.position = eng.Parent.Torso.Position + Vector3.new(math.random(-10,10),math.random(0,10),math.random(-10,10))
&#9;&#9;eng.BodyGyro.cframe = CFrame.new(eng.Position, target.Torso.Position)
&#9;&#9;wait(0.5)
&#9;&#9;if target.Humanoid.Health &gt; 0 then
&#9;&#9;fire(eng)
&#9;&#9;else
&#9;&#9;wait(0.5)
&#9;&#9;end
&#9;&#9;
&#9;else
&#9;eng.BodyPosition.position = eng.Parent.Torso.Position + Vector3.new(math.random(-10,10),math.random(0,10),math.random(-10,10))
&#9;eng.BodyGyro.cframe = CFrame.new(eng.Position, eng.Parent.Head.Position)
&#9;wait(0.5)
&#9;end
&#9;wait(0.9)
end

