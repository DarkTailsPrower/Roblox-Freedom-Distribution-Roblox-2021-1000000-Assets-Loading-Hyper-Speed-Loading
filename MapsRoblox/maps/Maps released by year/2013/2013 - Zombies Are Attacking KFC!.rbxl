						<string name="Name">Team Script</string>
						<ProtectedString name="Source">local Player = script.Parent.Parent.Parent.Parent

if Player.TeamColor == game.Teams.Survivors.TeamColor then
script.Parent.Visible = true
else
script.Parent.Visible = false
end 

function vis()
&#9;if (game.Workspace.ZombieScript.Running.Value == 1) then
&#9;&#9;if Player.TeamColor == game.Teams.Survivors.TeamColor then
&#9;&#9;&#9;script.Parent.Visible = true
&#9;&#9;else
&#9;&#9;&#9;script.Parent.Visible = false
&#9;&#9;end
&#9;else
&#9;&#9;script.Parent.Visible = false
&#9;end
end
vis()
game.Workspace.ZombieScript.Running.Changed:connect(vis)</ProtectedString>
