local adminList = {&quot;CloneTrooper1019&quot;,&quot;YourNameHere&quot;,&quot;Player&quot;} -- These players cannot be removed using unadmin/
local clearableAdmin = {} -- This is used for the admin/ command. Any player on this list can be removed using unadmin/
local banList = {&quot;Someoneyouhate&quot;,&quot;Noob&quot;} -- This list is used to ban anyone from your game. You can also use the ban/ and unban/ command to control it.
local GamePassId  = 124446538 -- Put the ID of a GamePass that you would like to allow 
