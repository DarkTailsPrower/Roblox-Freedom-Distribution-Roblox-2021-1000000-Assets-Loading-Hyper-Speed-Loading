				<Properties>
					<Ref name="CameraSubject">null</Ref>
					<token name="CameraType">0</token>
					<CoordinateFrame name="CoordinateFrame">
						<X>3.00843692</X>
						<Y>2.04299498</Y>
						<Z>0.38796404</Z>
						<R00>-0.0349010229</R00>
						<R01>-0.166666746</R01>
						<R02>0.985395551</R02>
