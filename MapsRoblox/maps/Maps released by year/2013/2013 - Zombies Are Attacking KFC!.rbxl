--&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;CURRENT COMMANDS:&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9; --
--&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9; --
--&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9; --
-- &#9;kill/CloneTroope1019 &#9;&#9;&#9;&#9;&#9;&#9;- kills CloneTrooper1019&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9; --
-- &#9;kick/CloneTrooper1019&#9;&#9;&#9;&#9;&#9;&#9;- kicks CloneTrooper1019&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9; --
-- &#9;ban/CloneTrooper1019&#9;&#9;&#9;&#9;&#9;&#9;&#9;- bans CloneTrooper1019&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9; --
-- &#9;unban/CloneTrooper1019&#9;&#9;&#9;&#9;&#9;&#9;- unbans CloneTrooper1019&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9; --
-- &#9;ff/CloneTrooper1019&#9;&#9;&#9;&#9;&#9;&#9;&#9;- Gives a forcefield to CloneTrooper1019&#9;&#9;&#9;&#9;&#9; --
-- &#9;unff/CloneTrooper1019&#9;&#9;&#9;&#9;&#9;&#9;- removes a ForceField from CloneTrooper1019&#9;&#9;&#9;&#9; --
--&#9; &#9;admin/CloneTrooper1019&#9;&#9;&#9;&#9;&#9;&#9;- admins CloneTrooper1019&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9; --
-- &#9;unadmin/CloneTrooper1019&#9;&#9;&#9;&#9;&#9;- unadmins CloneTrooper1019&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9; --
-- &#9;sparkles/CloneTrooper1019&#9;&#9;&#9;&#9;&#9;- Adds sparkles to CloneTrooper1019&apos;s Torso&#9;&#9;&#9;&#9; --
-- &#9;unsparkles/CloneTrooper1019&#9;&#9;&#9;&#9;- removes Sparkles from CloneTrooper1019&#9;&#9;&#9;&#9;&#9; --
-- &#9;fire/CloneTrooper1019&#9;&#9;&#9;&#9;&#9;&#9;- Adds a fire to CloneTrooper1019&apos;s Torso&#9;&#9;&#9;&#9;&#9; --
-- &#9;unfire/CloneTrooper1019 &#9;&#9;&#9;&#9;&#9;- Removes fire from CloneTrooper1019&apos;s Torso&#9;&#9;&#9;&#9; --
-- &#9;smoke/CloneTrooper1019&#9;&#9;&#9;&#9;&#9;&#9;- Adds smoke to CloneTrooper1019&apos;s Torso&#9;&#9;&#9;&#9;&#9; --
-- &#9;unsmoke/CloneTrooper1019&#9;&#9;&#9;&#9;&#9;- Removes smoke to CloneTrooper1019&apos;s Torso&#9;&#9;&#9;&#9; --
-- &#9;teleport/CloneTrooper1019/Legostuntman&#9;- Teleports CloneTrooper1019 to Legostuntman&#9;&#9;&#9;&#9; --
-- &#9;cs/(Script Source Here)&#9;&#9;&#9;&#9;&#9;&#9;- Creates a Script with the source after the &apos;/&apos;&#9;&#9; --
-- &#9;cls/(LocalScript Source Here)&#9;&#9;&#9;&#9;- Creates a LocalScript with the source after the &apos;/&apos;  --
-- &#9;import/ID&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;- Inserts anything approved and places it next to you&#9; --
--&#9;&#9;punish/CloneTrooper1019&#9;&#9;&#9;&#9;&#9;&#9;- Puts CloneTrooper1019 in the Lighting&#9;&#9;&#9;&#9;&#9; --
-- &#9;unpunish/CloneTrooper1019&#9;&#9;&#9;&#9;&#9;- removes CloneTrooper1019 from the Lighting&#9;&#9;&#9;&#9; --
-- &#9;jump/CloneTrooper1019&#9;&#9;&#9;&#9;&#9;&#9;- Makes CloneTrooper1019 Jump&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9; --
-- &#9;sit/CloneTrooper1019&#9;&#9;&#9;&#9;&#9;&#9;&#9;- Makes CloneTrooper1019 Sit&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9; --
-- &#9;explode/CloneTrooper1019&#9;&#9;&#9;&#9;&#9;- Makes CloneTrooper1019 Explode&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9; --
--&#9;&#9;respawn/CloneTrooper1019&#9;&#9;&#9;&#9;&#9;- Makes CloneTrooper1019 Respawn&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9; --
-- &#9;commands&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;- Shows the list of commands on the top of the screen. --
--&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9; --
--&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9;&#9; --
-------------------------------------------------------------------------------------------------------

------------------------------------------------------------------------------------------------------------------
-- Below is the scripting for the commands script. Please do not mess with it unless you know what you are doing--
------------------------------------------------------------------------------------------------------------------

function IsAdmin(player)
&#9;for i = 1,#adminList do
&#9;&#9;if adminList[i] == player then
&#9;&#9;&#9;return true
&#9;&#9;end
&#9;end
&#9;for i = 1,#clearableAdmin do
&#9;&#9;if clearableAdmin[i] == player then
&#9;&#9;&#9;return true
&#9;&#9;end
&#9;end
&#9;return false
end

function IsTechnicalAdmin(player)
&#9;for i = 1,#clearableAdmin do
&#9;&#9;if clearableAdmin[i] == player.Name then
&#9;&#9;&#9;return true
&#9;&#9;end
&#9;end
&#9;return false
end

function findOnTable(t,s)
&#9;for i = 1,#t do
&#9;&#9;if t[i] == s then
&#9;&#9;&#9;return true
&#9;&#9;end
&#9;end
&#9;return false
end

function shout(player,m,t)
&#9;repeat wait () until player:findFirstChild(&quot;PlayerGui&quot;) ~= nil
&#9;local hint = Instance.new(&quot;Hint&quot;,player.PlayerGui)
&#9;hint.Text = m
&#9;game:GetService(&quot;Debris&quot;):AddItem(hint,t)
end

function tableNumber(t,s)
&#9;for i = 1,#t do
&#9;&#9;if t[i] == s then
&#9;&#9;&#9;return i
&#9;&#9;end
&#9;end
&#9;return nil
end

function getSlashNumber(str,from,to)
&#9;stop = false
&#9;for i = from,to do
&#9;&#9;if stop == true then return end
&#9;&#9;if string.sub(str,i,i) == &quot;/&quot; then
&#9;&#9;&#9;stop = true
&#9;&#9;&#9;return i+1
&#9;&#9;end
&#9;end
&#9;return nil
end

function removeFromTable(t,rmv)
&#9;local newTable = {}
&#9;for i = 1,#t do
&#9;&#9;if not t[i] == rmv then
&#9;&#9;&#9;table.insert(newTable,t[i])
&#9;&#9;end
&#9;end
&#9;return newTable
end

function getTableNumberWithShortcut(t,s)
&#9;for i = 1,#t do
&#9;&#9;if string.sub(t[i],1,#s) == s then
&#9;&#9;&#9;return i 
&#9;&#9;end
&#9;end
end

function findTool(s)
&#9;local t = {}
&#9;s = string.lower(s)
&#9;if s == &quot;all&quot; then
&#9;&#9;local stuff = game.Lighting:GetChildren()
&#9;&#9;for i = 1,#stuff do
&#9;&#9;&#9;if stuff[i]:IsA(&quot;Tool&quot;) then
&#9;&#9;&#9;&#9;table.insert(t,stuff[i])
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;return t
&#9;elseif s == &quot;random&quot; then
&#9;&#9;local randomT = {}
&#9;&#9;local stuff = game.Lighting:GetChildren()
&#9;&#9;for i = 1,#stuff do
&#9;&#9;&#9;if stuff[i]:IsA(&quot;Tool&quot;) then
&#9;&#9;&#9;&#9;table.insert(randomT,stuff[i])
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;local tool = randomT[math.random(1,#randomT)]
&#9;&#9;table.insert(t,tool)
&#9;&#9;return t
&#9;else
&#9;&#9;local results = {}
&#9;&#9;local stuff = game.Lighting:GetChildren()
&#9;&#9;for i = 1,#stuff do
&#9;&#9;&#9;if stuff[i]:IsA(&quot;Tool&quot;) then
&#9;&#9;&#9;&#9;table.insert(results,stuff[i])
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;for i = 1,#results do
&#9;&#9;&#9;if string.lower(string.sub(results[i].Name,1,#s)) == s then
&#9;&#9;&#9;&#9;table.insert(t,results[i])
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;return t
&#9;end
end
&#9;&#9;
function findPlayer(sender,s)
&#9;local people = game.Players:GetPlayers()
&#9;local t = {}
&#9;s = string.lower(s)
&#9;if s == &quot;me&quot; then -- Yourself
&#9;&#9;table.insert(t,sender)
&#9;&#9;return t
&#9;elseif s == &quot;random&quot; then -- a random player
&#9;&#9;table.insert(t,people[math.random(1,#people)])
&#9;&#9;return t
&#9;elseif s == &quot;all&quot; then -- everyone
&#9;&#9;for i = 1,#people do
&#9;&#9;&#9;table.insert(t,people[i])
&#9;&#9;end
&#9;&#9;return t
&#9;elseif s == &quot;admins&quot; then -- the admins
&#9;&#9;for i = 1,#people do
&#9;&#9;&#9;if IsAdmin(people[i].Name) then
&#9;&#9;&#9;&#9;table.insert(t,people[i])
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;return t
&#9;elseif s == &quot;nonadmins&quot; then -- the non admins
&#9;&#9;for i = 1,#people do
&#9;&#9;&#9;if not IsAdmin(people[i].Name) then
&#9;&#9;&#9;&#9;table.insert(t,people[i])
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;return t
&#9;else -- A specific player
&#9;&#9;for i = 1,#people do
&#9;&#9;&#9;if string.lower(string.sub(people[i].Name,1,#s)) == s then
&#9;&#9;&#9;&#9;table.insert(t,people[i])
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;return t
&#9;end
end
&#9;&#9;&#9;
function onChatted(player,command)
&#9;if IsAdmin(player.Name) then
&#9;&#9;command = string.lower(command)
&#9;&#9;if string.sub(command,1,5) == &quot;kill/&quot; then
&#9;&#9;&#9;local list = findPlayer(player,string.sub(command,6))
&#9;&#9;&#9;for i = 1,#list do
&#9;&#9;&#9;&#9;if list[i].Character ~= nil then
&#9;&#9;&#9;&#9;&#9;if&#9;list[i].Character:findFirstChild(&quot;Humanoid&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;list[i].Character.Humanoid.Health = 0
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;elseif string.sub(command,1,5) == &quot;kick/&quot; then
&#9;&#9;&#9;if IsTechnicalAdmin(player) then -- We only want default admins for this command.
&#9;&#9;&#9;&#9;shout(player,&quot;You are not allowed to use this command.&quot;,3)
&#9;&#9;&#9;&#9;return 
&#9;&#9;&#9;end
&#9;&#9;&#9;local list = findPlayer(player,string.sub(command,6))
&#9;&#9;&#9;for i = 1,#list do
&#9;&#9;&#9;&#9;list[i]:Destroy()
&#9;&#9;&#9;end
&#9;&#9;elseif string.sub(command,1,3) == &quot;ff/&quot; then
&#9;&#9;&#9;local list = findPlayer(player,string.sub(command,4))
&#9;&#9;&#9;for i = 1,#list do
&#9;&#9;&#9;&#9;if list[i].Character ~= nil then
&#9;&#9;&#9;&#9;&#9;Instance.new(&quot;ForceField&quot;,list[i].Character)
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end&#9;
&#9;&#9;elseif string.sub(command,1,5) == &quot;unff/&quot; then
&#9;&#9;&#9;local list = findPlayer(player,string.sub(command,6))
&#9;&#9;&#9;for i = 1,#list do
&#9;&#9;&#9;&#9;if list[i].Character ~= nil then
&#9;&#9;&#9;&#9;&#9;if list[i].Character:findFirstChild(&quot;ForceField&quot;) then
&#9;&#9;&#9;&#9;&#9;&#9;list[i].Character.ForceField:Destroy()
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;elseif string.sub(command,1,6) == &quot;admin/&quot; then
&#9;&#9;&#9;if IsTechnicalAdmin(player) then 
&#9;&#9;&#9;&#9;local hint = Instance.new(&quot;Hint&quot;,player.PlayerGui)
&#9;&#9;&#9;&#9;shout(player,&quot;You are not allowed to use this command.&quot;,3)
&#9;&#9;&#9;&#9;return
&#9;&#9;&#9;end
&#9;&#9;&#9;local list = findPlayer(player,string.sub(command,7))
&#9;&#9;&#9;for i = 1,#list do
&#9;&#9;&#9;&#9;if not findOnTable(clearableAdmin,list[i].Name) then
&#9;&#9;&#9;&#9;&#9;table.insert(clearableAdmin,list[i].Name)
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;elseif string.sub(command,1,8) == &quot;unadmin/&quot; then
&#9;&#9;&#9;if IsTechnicalAdmin(player) then 
&#9;&#9;&#9;&#9;shout(player,&quot;You are not allowed to use this command.&quot;,3)
&#9;&#9;&#9;&#9;return 
&#9;&#9;&#9;end
&#9;&#9;&#9;local list = findPlayer(player,string.sub(command,9))
&#9;&#9;&#9;for i = 1,#list do
&#9;&#9;&#9;&#9;clearableAdmin = removeFromTable(clearableAdmin,list[i].Name)
&#9;&#9;&#9;end
&#9;&#9;elseif string.sub(command,1,4) == &quot;ban/&quot; then
&#9;&#9;&#9;if IsTechnicalAdmin(player) then 
&#9;&#9;&#9;&#9;shout(player,&quot;You are not allowed to use this command.&quot;,3)
&#9;&#9;&#9;&#9;return 
&#9;&#9;&#9;end
&#9;&#9;&#9;local list = findPlayer(player,string.sub(command,5))
&#9;&#9;&#9;for i = 1,#list do
&#9;&#9;&#9;&#9;table.insert(banList,list[i].Name)
&#9;&#9;&#9;&#9;list[i]:Destroy()
&#9;&#9;&#9;end
&#9;&#9;elseif string.sub(command,1,6) == &quot;unban/&quot; then
&#9;&#9;&#9;if IsTechnicalAdmin(player) then 
&#9;&#9;&#9;&#9;shout(player,&quot;You are not allowed to use this command.&quot;,3)
&#9;&#9;&#9;&#9;return 
&#9;&#9;&#9;end
&#9;&#9;&#9;local n = 0
&#9;&#9;&#9;local o = nil
&#9;&#9;&#9;if #string.sub(command,7) == 0 then return end
&#9;&#9;&#9;for i = 1,#banList do
&#9;&#9;&#9;&#9;if string.find(string.lower(banList[i]),string.sub(command,7)) == 1 then
&#9;&#9;&#9;&#9;&#9;n = n + 1
&#9;&#9;&#9;&#9;&#9;o = i
&#9;&#9;&#9;&#9;end 
&#9;&#9;&#9;end
&#9;&#9;&#9;if n == 1 then
&#9;&#9;&#9;&#9;print(banList[o])
&#9;&#9;&#9;&#9;table.remove(banList,o)
&#9;&#9;&#9;end
&#9;&#9;elseif string.sub(command,1,9) == &quot;sparkles/&quot; then
&#9;&#9;&#9;local list = findPlayer(player,string.sub(command,10))
&#9;&#9;&#9;for i = 1,#list do
&#9;&#9;&#9;&#9;if list[i].Character ~= nil then
&#9;&#9;&#9;&#9;&#9;if list[i].Character:findFirstChild(&quot;Torso&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;Instance.new(&quot;Sparkles&quot;,list[i].Character.Torso)
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;elseif string.sub(command,1,11) == &quot;unsparkles/&quot; then
&#9;&#9;&#9;local list = findPlayer(player,string.sub(command,12))
&#9;&#9;&#9;for i = 1,#list do
&#9;&#9;&#9;&#9;if list[i].Character ~= nil then
&#9;&#9;&#9;&#9;&#9;if list[i].Character:findFirstChild(&quot;Torso&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;if list[i].Character.Torso:findFirstChild(&quot;Sparkles&quot;) then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;list[i].Character.Torso.Sparkles:Destroy()
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;elseif string.sub(command,1,5) == &quot;fire/&quot; then
&#9;&#9;&#9;local list = findPlayer(player,string.sub(command,6))
&#9;&#9;&#9;for i = 1,#list do
&#9;&#9;&#9;&#9;if list[i].Character ~= nil then
&#9;&#9;&#9;&#9;&#9;if list[i].Character:findFirstChild(&quot;Torso&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;Instance.new(&quot;Fire&quot;,list[i].Character.Torso)
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;elseif string.sub(command,1,7) == &quot;unfire/&quot; then
&#9;&#9;&#9;local list = findPlayer(player,string.sub(command,8))
&#9;&#9;&#9;for i = 1,#list do
&#9;&#9;&#9;&#9;if list[i].Character ~= nil then
&#9;&#9;&#9;&#9;&#9;if list[i].Character:findFirstChild(&quot;Torso&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;if list[i].Character.Torso:findFirstChild(&quot;Fire&quot;) then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;list[i].Character.Torso.Fire:Destroy()
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;elseif string.sub(command,1,6) == &quot;smoke/&quot; then
&#9;&#9;&#9;local list = findPlayer(player,string.sub(command,7))
&#9;&#9;&#9;for i = 1,#list do
&#9;&#9;&#9;&#9;if list[i].Character ~= nil then
&#9;&#9;&#9;&#9;&#9;if list[i].Character:findFirstChild(&quot;Torso&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;Instance.new(&quot;Smoke&quot;,list[i].Character.Torso)
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;elseif string.sub(command,1,8) == &quot;unsmoke/&quot; then
&#9;&#9;&#9;local list = findPlayer(player,string.sub(command,9))
&#9;&#9;&#9;for i = 1,#list do
&#9;&#9;&#9;&#9;if list[i].Character ~= nil then
&#9;&#9;&#9;&#9;&#9;if list[i].Character:findFirstChild(&quot;Torso&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;if list[i].Character.Torso:findFirstChild(&quot;Smoke&quot;) then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;list[i].Character.Torso.Smoke:Destroy()
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;elseif string.sub(command,1,9) == &quot;teleport/&quot; then
&#9;&#9;&#9;local number = getSlashNumber(command,10)
&#9;&#9;&#9;if number then
&#9;&#9;&#9;&#9;local playerToTele = findPlayer(player,string.sub(command,10,number-2))[1]
&#9;&#9;&#9;&#9;local playerToGoTo = findPlayer(player,string.sub(command,number))[1]
&#9;&#9;&#9;&#9;if playerToTele == playerToGoTo then
&#9;&#9;&#9;&#9;&#9;shout(player,&quot;You cannot teleport to yourself.&quot;,3)
&#9;&#9;&#9;&#9;&#9;return
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;if playerToTele and playerToGoTo then
&#9;&#9;&#9;&#9;&#9;if playerToTele.Character and playerToGoTo.Character then
&#9;&#9;&#9;&#9;&#9;&#9;if playerToTele.Character:findFirstChild(&quot;Torso&quot;) and playerToGoTo.Character:findFirstChild(&quot;Torso&quot;) then
&#9;&#9;&#9;&#9;&#9;&#9;&#9;playerToTele.Character.Torso.CFrame = playerToGoTo.Character.Torso.CFrame + Vector3.new(math.random(-3,3),0,math.random(-3,3))
&#9;&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;elseif string.sub(command,1,3) == &quot;cs/&quot; then
&#9;&#9;&#9;local source = string.sub(msg,4,#msg)
&#9;&#9;&#9;local scriptLoader = script.ScriptLoader:clone()
&#9;&#9;&#9;scriptLoader.TheSource.Value = source
&#9;&#9;&#9;scriptLoader.Parent = game.Workspace
&#9;&#9;&#9;scriptLoader.Disabled = false
&#9;&#9;elseif string.sub(command,1,4) == &quot;cls/&quot; then
&#9;&#9;&#9;local source = string.sub(msg,5,#msg)
&#9;&#9;&#9;local scriptLoader = script.LocalScriptLoader:clone()
&#9;&#9;&#9;scriptLoader.TheSource.Value = source
&#9;&#9;&#9;scriptLoader.Parent = player.Character
&#9;&#9;&#9;scriptLoader.Disabled = false
&#9;&#9;elseif string.sub(command,1,7) == &quot;import/&quot; then
&#9;&#9;&#9;local ID = string.sub(command,8)
&#9;&#9;&#9;if ID then
&#9;&#9;&#9;&#9;if tonumber(ID) ~= nil then
&#9;&#9;&#9;&#9;&#9;local model = game:GetService(&quot;InsertService&quot;):LoadAsset(ID)
&#9;&#9;&#9;&#9;&#9;if model and (#model:GetChildren()) &gt; 0 then
&#9;&#9;&#9;&#9;&#9;&#9;model.Name = &quot;InsertedObject&quot;..ID
&#9;&#9;&#9;&#9;&#9;&#9;model.Parent = game.Workspace
&#9;&#9;&#9;&#9;&#9;&#9;model:MoveTo(player.Character.Torso.Position + Vector3.new(5,3,0))
&#9;&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;&#9;shout(player,&quot;ID is not approved by this game.&quot;,3)
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;shout(player,&quot;Invalid ID&quot;,3)
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;shout(player,&quot;No ID written.&quot;,3)
&#9;&#9;&#9;end
&#9;&#9;elseif string.sub(command,1,7) == &quot;punish/&quot; then
&#9;&#9;&#9;local list = findPlayer(player,string.sub(command,8))
&#9;&#9;&#9;for i = 1,#list do
&#9;&#9;&#9;&#9;list[i].Character.Parent = game.Lighting
&#9;&#9;&#9;end
&#9;&#9;elseif string.sub(command,1,9) == &quot;unpunish/&quot; then
&#9;&#9;&#9;local list = findPlayer(player,string.sub(command,10))
&#9;&#9;&#9;for i = 1,#list do
&#9;&#9;&#9;&#9;list[i].Character.Parent = game.Workspace
&#9;&#9;&#9;&#9;list[i].Character:MakeJoints()
&#9;&#9;&#9;end
&#9;&#9;elseif string.sub(command,1,5) == &quot;jump/&quot; then
&#9;&#9;&#9;local list = findPlayer(player,string.sub(command,6))
&#9;&#9;&#9;for i = 1,#list do
&#9;&#9;&#9;&#9;if list[i].Character ~= nil then
&#9;&#9;&#9;&#9;&#9;if list[i].Character:findFirstChild(&quot;Humanoid&quot;) then
&#9;&#9;&#9;&#9;&#9;&#9;list[i].Character.Humanoid.Jump = true
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;elseif string.sub(command,1,4) == &quot;sit/&quot; then
&#9;&#9;&#9;local list = findPlayer(player,string.sub(command,5))
&#9;&#9;&#9;for i = 1,#list do
&#9;&#9;&#9;&#9;if list[i].Character ~= nil then
&#9;&#9;&#9;&#9;&#9;if list[i].Character:findFirstChild(&quot;Humanoid&quot;) then
&#9;&#9;&#9;&#9;&#9;&#9;list[i].Character.Humanoid.Sit = true
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;elseif string.sub(command,1,8) == &quot;explode/&quot; then
&#9;&#9;&#9;local list = findPlayer(player,string.sub(command,9))
&#9;&#9;&#9;for i = 1,#list do
&#9;&#9;&#9;&#9;local e = Instance.new(&quot;Explosion&quot;,workspace)
&#9;&#9;&#9;&#9;e.Position = list[i].Character.Torso.Position
&#9;&#9;&#9;end
&#9;&#9;elseif string.sub(command,1,8) == &quot;respawn/&quot; then
&#9;&#9;&#9;local list = findPlayer(player,string.sub(command,9))
&#9;&#9;&#9;for i = 1,#list do
&#9;&#9;&#9;&#9;list[i]:LoadCharacter(true)
&#9;&#9;&#9;end
&#9;&#9;elseif string.sub(command,1,8) == &quot;commands&quot; then
&#9;&#9;&#9;if player.PlayerGui:findFirstChild(&quot;Hint&quot;) then return end
&#9;&#9;&#9;local hint = Instance.new(&quot;Hint&quot;,player.PlayerGui)
&#9;&#9;&#9;local commandsString = &quot;                                                Commands: kill/CloneTrooper1019, kick/CloneTrooper1019, ban/CloneTrooper1019, unban/CloneTrooper1019, ff/CloneTrooper1019, unff/CloneTrooper1019, admin/CloneTrooper1019, unadmin/CloneTrooper1019, sparkles/CloneTrooper1019, unsparkles/CloneTrooper1019, fire/CloneTrooper1019, unfire/CloneTrooper1019, smoke/CloneTrooper1019, unsmoke/CloneTrooper1019, teleport/CloneTrooper1019/Legostuntman, import/ID, punish/CloneTrooper1019, unpunish/CloneTrooper1019, jump/CloneTrooper1019, sit/CloneTrooper1019, explode/CloneTrooper1019, respawn/CloneTrooper1019                                                                &quot;
&#9;&#9;&#9;for i = 1,#commandsString-48 do
&#9;&#9;&#9;&#9;hint.Text = &quot;|&quot;..string.sub(commandsString,i,(i+48))..&quot;|&quot;
&#9;&#9;&#9;&#9;wait(0.1)
&#9;&#9;&#9;end
&#9;&#9;&#9;hint:Destroy()
&#9;&#9;end
&#9;end
end

function onPlayerEntered(player)
&#9;if findOnTable(banList,player.Name) then
&#9;&#9;player:Destroy()
&#9;end
&#9;if&#9;game:GetService(&quot;GamePassService&quot;):PlayerHasPass(player,GamePassId) then
&#9;&#9;table.insert(clearableAdmin,player.Name)
&#9;end
&#9;if IsAdmin(player.Name) or IsTechnicalAdmin(player.Name) then
&#9;&#9;wait(3)
&#9;&#9;shout(player,&quot;You have admin commands!&quot;,3)
&#9;&#9;wait(3)
&#9;&#9;shout(player,&quot;Say &apos;commands&apos; to see the list of commands&quot;,3)
&#9;&#9;player.Chatted:connect(function(s) onChatted(player,s) end)
&#9;end
end

game.Players.PlayerAdded:connect(onPlayerEntered)
